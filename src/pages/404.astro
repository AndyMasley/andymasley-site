---
import Base from '@/layouts/Base.astro';
import { getAllWritingPostMetas } from '@/lib/all-writing-posts';
import { formatPostDate } from '@/lib/format-date';

const recent = (await getAllWritingPostMetas())
  .filter((p) => p.date.getTime() !== 0)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);
---

<Base title="Page not found" description="The page you're looking for doesn't exist or has been moved.">
  <div class="container container--narrow">
    <div class="not-found">
      <span class="not-found__code">404</span>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__message">
        The page you’re looking for doesn’t exist or has been moved. Try the
        search in the header, or one of my recent posts.
      </p>
      <a href="/" class="not-found__link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to home
      </a>

      {recent.length > 0 && (
        <div class="not-found__recent">
          <p class="not-found__recent-label">Recent writing</p>
          <ul class="not-found__recent-list">
            {recent.map((p) => (
              <li>
                <time datetime={p.date.toISOString()}>{formatPostDate(p.date)}</time>
                <a href={`/writing/${p.slug}`}>{p.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .not-found {
    max-width: 34rem;
    padding: 4rem 0 5rem;
  }
  
  .not-found__code {
    display: block;
    font-family: var(--font-label);
    font-size: 4.25rem;
    font-weight: 600;
    color: var(--border);
    line-height: 1;
    margin-bottom: 1.25rem;
  }
  
  .not-found__title {
    font-family: var(--font-editorial);
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem 0;
  }
  
  .not-found__message {
    color: var(--text-secondary);
    font-family: var(--font-editorial);
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.5rem 0;
  }
  
  .not-found__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid transparent;
  }
  
  .not-found__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .not-found__recent {
    margin-top: 3rem;
  }

  .not-found__recent-label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 0.75rem;
  }

  .not-found__recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .not-found__recent-list li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.45rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .not-found__recent-list time {
    flex-shrink: 0;
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
</style>
