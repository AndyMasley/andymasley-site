---
import Base from '@/layouts/Base.astro';
import { getAllWritingPostMetas } from '@/lib/all-writing-posts';
import { formatPostDate } from '@/lib/format-date';

const recent = (await getAllWritingPostMetas())
  .filter((p) => p.date.getTime() !== 0)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);
---

<Base title="Page not found" description="The page you're looking for doesn't exist or has been moved.">
  <div class="container container--narrow">
    <div class="not-found">
      <span class="not-found__code">404</span>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__message">
        This page doesn’t exist, has moved, or is a post I unpublished after
        changing my mind — that happens. Try the search in the header, the
        <a href="/writing">writing archive</a>, or one of my recent posts.
      </p>
      <p class="back-link"><a href="/">&larr; back to home</a></p>

      {recent.length > 0 && (
        <div class="not-found__recent">
          <p class="not-found__recent-label">Recent writing</p>
          <ul class="not-found__recent-list">
            {recent.map((p) => (
              <li>
                <time datetime={p.date.toISOString()}>{formatPostDate(p.date)}</time>
                <a href={`/writing/${p.slug}`}>{p.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .not-found {
    max-width: 34rem;
    padding: 4rem 0 5rem;
  }
  
  .not-found__code {
    display: block;
    font-family: var(--font-label);
    font-size: var(--text-display);
    font-weight: 700;
    color: var(--border);
    line-height: 1;
    margin-bottom: 1.25rem;
  }
  
  .not-found__title {
    font-family: var(--font-editorial);
    font-size: var(--text-display);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem 0;
  }
  
  .not-found__message {
    color: var(--text-secondary);
    font-family: var(--font-editorial);
    font-size: var(--text-md);
    line-height: var(--leading-prose);
    margin: 0 0 1.5rem 0;
  }
  
  .not-found__recent {
    margin-top: 3rem;
  }

  .not-found__recent-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 0.75rem;
  }

  .not-found__recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .not-found__recent-list li {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.45rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .not-found__recent-list time {
    flex-shrink: 0;
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
</style>
