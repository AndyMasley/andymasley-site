---
import SectionPage from '@/layouts/SectionPage.astro';
import { appearanceGroups as groups } from '@/data/appearances';
---

<SectionPage
  title="Appearances"
  description="Podcasts and other appearances"
  ogImage="/og/page/appearances.png?v=2"
>
  {groups.map(group => (
    <section class="appearance-group">
      <h2 class="appearance-group__heading">{group.heading}</h2>
      <ul class="appearance-group__list">
        {group.items.map(item => (
          <li class="appearance-group__item">
            <a href={item.href} target="_blank" rel="noopener">{item.title}</a>
            <span class="appearance-group__date">{item.date}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</SectionPage>

<style>
  /* The bare-list mandate: every venue visible, nothing behind a click.
     Group headings in the house caps recipe; blue spent only on links. */
  .appearance-group {
    margin-bottom: var(--space-xl);
  }

  .appearance-group__heading {
    margin: 0 0 0.6rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .appearance-group__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .appearance-group__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    padding: 0.3rem 0;
  }

  .appearance-group__item a {
    font-size: var(--text-base);
    line-height: 1.4;
  }

  .appearance-group__date {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
</style>
