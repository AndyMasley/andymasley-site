---
import SectionPage from '@/layouts/SectionPage.astro';
import { appearanceGroups as groups } from '@/data/appearances';
---

<SectionPage
  title="Appearances"
  lede="Podcasts and other appearances, most recent first."
  description="Podcasts and other appearances"
  ogImage="/og/page/appearances.png?v=2"
>
  {groups.map(group => (
    <section class="appearance-group">
      <h2 class="appearance-group__heading">{group.heading}</h2>
      <ul class="appearance-group__list">
        {group.items.map(item => (
          <li class="appearance-row">
            <span class="appearance-row__date">{item.date}</span>
            <a href={item.href} target="_blank" rel="noopener" class="appearance-row__link">{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</SectionPage>

<style>
  /* The dated ledger grammar the site already speaks (bylines, recent
     writing): dates aligned in a fixed caps column, venue titles in ink
     with hairline underlines — links, not a wall of blue. */
  .appearance-group {
    margin-bottom: var(--space-xl);
  }

  .appearance-group__heading {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .appearance-group__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .appearance-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.32rem 0;
  }

  .appearance-row__date {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .appearance-row__link {
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-strong);
  }

  .appearance-row__link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Heard episodes turn purple, same as read posts. Literal hex:
     browsers ignore var() inside :visited. */
  .appearance-row__link:visited {
    color: #551a8b;
  }

  :global([data-theme="dark"]) .appearance-row__link:visited {
    color: #c58af9;
  }
</style>
