---
import SectionPage from '@/layouts/SectionPage.astro';
import { appearanceGroups, type Appearance } from '@/data/appearances';

// Ledger style: a month names itself once and holds every appearance from
// that month under it — no repeated dates down the column.
interface DateRun { date: string; items: Appearance[] }
function groupByDate(items: Appearance[]): DateRun[] {
  const runs: DateRun[] = [];
  for (const item of items) {
    const last = runs[runs.length - 1];
    if (last && last.date === item.date) last.items.push(item);
    else runs.push({ date: item.date, items: [item] });
  }
  return runs;
}

const groups = appearanceGroups.map(g => ({ heading: g.heading, runs: groupByDate(g.items) }));
---

<SectionPage
  title="Appearances"
  description="Podcasts and other appearances"
  ogImage="/og/page/appearances.png?v=4"
>
  {groups.map(group => (
    <details class="appearance-group" open>
      <summary class="appearance-group__summary">
        <h2 class="appearance-group__heading">{group.heading}</h2>
      </summary>
      <ul class="appearance-group__list">
        {group.runs.map(run => (
          <li class="appearance-row">
            <span class="appearance-row__date">{run.date}</span>
            <div class="appearance-row__titles">
              {run.items.map(item => (
                <a href={item.href} target="_blank" rel="noopener" class="appearance-row__link">{item.title}</a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </details>
  ))}
</SectionPage>

<style>
  /* The dated ledger grammar the site already speaks (bylines, recent
     writing): dates aligned in a fixed caps column, venue titles in ink
     with hairline underlines — links, not a wall of blue. */
  .appearance-group {
    margin-bottom: var(--space-md);
  }

  /* The global summary rules supply the house ▸ caret and its rotation;
     the label takes the same type as the entries on Lists and Visuals
     (.annotated-list__title), so the neighboring section pages read as
     one family when you click between them. */
  .appearance-group__summary {
    padding: 0.4rem 0;
  }

  .appearance-group__summary:hover .appearance-group__heading {
    color: var(--accent);
  }

  .appearance-group__heading {
    display: inline;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: normal;
    color: var(--text);
  }

  .appearance-group__list {
    list-style: none;
    margin: 0.45rem 0 0;
    padding: 0;
  }

  .appearance-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.32rem 0;
  }

  .appearance-row__date {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .appearance-row__titles {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .appearance-row__link {
    align-self: flex-start;
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-strong);
  }

  .appearance-row__link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Heard episodes turn purple, same as read posts. Literal hex:
     browsers ignore var() inside :visited. */
  .appearance-row__link:visited {
    color: #5b3a7a;
  }

  :global([data-theme="dark"]) .appearance-row__link:visited {
    color: #b9a3d9;
  }
</style>
