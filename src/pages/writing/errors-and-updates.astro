    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .entry-body {
    margin-bottom: 2rem;
  }

  .entry-body p {
    margin-bottom: 0.75rem;
  }

  .empty-state {
    color: var(--dim);
  }

  .back-link {
    margin-top: 2rem;
  }

