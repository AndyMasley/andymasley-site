---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts, fetchPostContent, processPostContent, type SubstackPost } from '@/lib/substack';
import { fetchEAForumPosts, fetchEAForumPostContent, processEAForumContent, type EAForumPost } from '@/lib/eaforum';
import { metaPosts, getMetaPostSlugs } from '@/lib/meta-posts';
import { CheatSheetExplorer, parseHtmlIntoSections } from '@/components/CheatSheetExplorer';
import { ArticleTOC } from '@/components/ArticleTOC';
import { extractHeadingsFromHtml, type TOCHeading } from '@/lib/extract-headings';
import { mapWithConcurrency } from '@/lib/map-with-concurrency';
import { getOptionalCollection } from '@/lib/optional-collection';
import { formatPostDate as formatDate } from '@/lib/format-date';
import substackKeywords from '@/data/substack-keywords.json';

const keywordsBySlug = substackKeywords as Record<string, string[]>;

// Union type for all post sources
type PostSource = 'local' | 'substack' | 'eaforum';

interface LocalPost {
  source: 'local';
  slug: string;
  title: string;
  date: Date;
  description: string;
  tags: string[];
  body: string;
  render: () => Promise<{ Content: any; headings: any[] }>;
}

interface ExternalPost {
  source: 'substack' | 'eaforum';
  slug: string;
  title: string;
  date: Date;
  description: string;
  url: string;
  htmlContent: string;
  sourceName: string;
}

type Post = LocalPost | ExternalPost;

interface AdjacentPost {
  slug: string;
  title: string;
  date: Date;
}

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { post: Post } }> = [];

  // 1. Get post lists from all sources
  const [localPosts, substackPosts, eaForumPosts] = await Promise.all([
    getOptionalCollection('writing'),
    fetchSubstackPosts(),
    fetchEAForumPosts()
  ]);

  const existingSlugs = new Set<string>();

  for (const post of localPosts) {
    paths.push({
      params: { slug: post.slug },
      props: {
        post: {
          source: 'local' as const,
          slug: post.slug,
          title: post.data.title,
          date: post.data.date,
          description: post.data.description || '',
          tags: post.data.tags || [],
          body: post.body,
          render: () => post.render(),
        }
      }
    });
    existingSlugs.add(post.slug);
  }

  // 2. Get Substack posts
  const metaSlugSet = new Set(getMetaPostSlugs());
  const substackCandidates = substackPosts.filter(
    post => !existingSlugs.has(post.slug)
  );
  const substackPaths = await mapWithConcurrency(substackCandidates, async post => {
    const rawContent = await fetchPostContent(post.slug);
    const htmlContent = processPostContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'substack' as const,
          slug: post.slug,
          title: post.title,
          date: post.date,
          description: post.description,
          url: post.url,
          htmlContent,
          sourceName: 'Substack',
        }
      }
    };
  });
  paths.push(...substackPaths);
  substackCandidates.forEach(post => existingSlugs.add(post.slug));

  const missingMetaPosts = metaPosts.filter(post => !existingSlugs.has(post.slug));
  const missingMetaPaths = await mapWithConcurrency(missingMetaPosts, async post => {
    const rawContent = await fetchPostContent(post.slug);
    const htmlContent = processPostContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'substack' as const,
          slug: post.slug,
          title: post.title,
          date: new Date(0),
          description: '',
          url: post.url,
          htmlContent,
          sourceName: 'Substack',
        }
      }
    };
  });
  paths.push(...missingMetaPaths);
  missingMetaPosts.forEach(post => existingSlugs.add(post.slug));

  // 3. Get EA Forum posts
  const eaForumCandidates = eaForumPosts.filter(post => !existingSlugs.has(post.slug));
  const eaForumPaths = await mapWithConcurrency(eaForumCandidates, async post => {
    const rawContent = await fetchEAForumPostContent(post.postId);
    const htmlContent = processEAForumContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'eaforum' as const,
          slug: post.slug,
          title: post.title,
          date: post.date,
          description: '',
          url: post.url,
          htmlContent,
          sourceName: 'EA Forum',
        }
      }
    };
  });
  paths.push(...eaForumPaths);

  const sortedPaths = [...paths].sort(
    (a, b) => b.props.post.date.getTime() - a.props.post.date.getTime()
  );

  const navigablePaths = sortedPaths.filter(path => !metaSlugSet.has(path.props.post.slug));

  return sortedPaths.map((path, index) => ({
    ...path,
    props: {
      ...path.props,
      newerPost: (() => {
        if (metaSlugSet.has(path.props.post.slug)) return undefined;
        const navIndex = navigablePaths.findIndex(item => item.props.post.slug === path.props.post.slug);
        return navIndex > 0
          ? {
              slug: navigablePaths[navIndex - 1].props.post.slug,
              title: navigablePaths[navIndex - 1].props.post.title,
              date: navigablePaths[navIndex - 1].props.post.date,
            }
          : undefined;
      })(),
      olderPost: (() => {
        if (metaSlugSet.has(path.props.post.slug)) return undefined;
        const navIndex = navigablePaths.findIndex(item => item.props.post.slug === path.props.post.slug);
        return navIndex >= 0 && navIndex < navigablePaths.length - 1
          ? {
              slug: navigablePaths[navIndex + 1].props.post.slug,
              title: navigablePaths[navIndex + 1].props.post.title,
              date: navigablePaths[navIndex + 1].props.post.date,
            }
          : undefined;
      })(),
    }
  }));
}

interface Props {
  post: Post;
  newerPost?: AdjacentPost;
  olderPost?: AdjacentPost;
}

const { post, newerPost, olderPost } = Astro.props;
const isMetaPost = new Set(getMetaPostSlugs()).has(post.slug);
// Post pages self-canonicalize (Base falls back to the current andymasley.com
// path). Substack declares its own canonical on the originals, so both copies
// deliberately claim themselves — don't "fix" this by pointing ours at Substack.
const permalink = new URL(`/writing/${post.slug}/`, Astro.site ?? 'https://andymasley.com').href;
// Describes the generated /og/<slug>.png card (og-card.ts), not the page.
const ogImageAlt = `Title card reading "${post.title}" on a plain white background, andymasley.com`;

const seoKeywords: string[] = post.source === 'local'
  ? (post.tags || [])
  : (keywordsBySlug[post.slug] || []);

// Estimate reading time
function getReadingTime(content: string): number {
  const text = content.replace(/<[^>]*>/g, ''); // Strip HTML
  const wordCount = text.split(/\s+/).length;
  return Math.ceil(wordCount / 200);
}

// Get content and metadata based on source
let Content: any = null;
let readingTime = 0;
let tocHeadings: TOCHeading[] = [];
let displayHtml = '';

if (post.source === 'local') {
  const rendered = await post.render();
  Content = rendered.Content;
  readingTime = Math.ceil(post.body.split(/\s+/).length / 200);
  // Map Astro headings to TOC format
  tocHeadings = (rendered.headings || [])
    .filter((h: any) => h.depth === 2 || h.depth === 3)
    .map((h: any) => ({ id: h.slug, text: h.text, level: h.depth === 2 ? 'section' as const : 'sub' as const }));
} else {
  readingTime = getReadingTime(post.htmlContent);
  const extracted = extractHeadingsFromHtml(post.htmlContent);
  tocHeadings = extracted.headings;
  displayHtml = extracted.cleanedHtml;
}

// Build-time guard: the explorer needs parseable sections. If the pipeline
// ever changes shape again, warn loudly and fall back to the standard essay
// layout for this post rather than shipping an empty Navigate rail — one
// drifted post must never block deploys of the other ninety.
let isCheatSheet = post.slug === 'a-cheat-sheet-for-conversations-about';
if (isCheatSheet && post.source !== 'local') {
  const parsedCheat = parseHtmlIntoSections(post.htmlContent);
  if (parsedCheat.sections.length < 2) {
    console.warn(
      `[cheatsheet] ${post.slug}: only ${parsedCheat.sections.length} section(s) parsed from processed HTML — falling back to the standard essay layout`
    );
    isCheatSheet = false;
  }
}
const wordCount = post.source === 'local'
  ? post.body.split(/\s+/).length
  : (post.htmlContent.replace(/<[^>]*>/g, '').split(/\s+/).length);
const standfirst = post.description?.trim() || '';

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "author": {
    "@type": "Person",
    "name": "Andy Masley",
    "url": "https://andymasley.com"
  },
  "datePublished": post.date.toISOString(),
  "description": post.description || '',
  "wordCount": wordCount,
  "url": `https://andymasley.com/writing/${post.slug}`,
  "publisher": {
    "@type": "Person",
    "name": "Andy Masley"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://andymasley.com/writing/${post.slug}`
  }
};
---

{isCheatSheet && post.source !== 'local' ? (
<Base
  title={post.title}
  description="Every environmental objection to using ChatGPT, answered with data and sources."
  ogType="article"
  ogImage={`/og/${post.slug}.png`}
  ogImageAlt={ogImageAlt}
  structuredData={articleStructuredData}
  keywords={seoKeywords}
>
  <meta slot="head" property="article:published_time" content={post.date.toISOString()} />
  <meta slot="head" property="article:author" content="Andy Masley" />
  <div class="cheat-sheet-page">
    <header class="article-header">
      <h1 class="article-header__title">{post.title}</h1>
      <div class="article-header__meta">
        <span><time datetime={post.date.toISOString()}>{formatDate(post.date)}</time></span>
        <span>{readingTime} min read</span>
        <span>{Math.round(wordCount / 1000)}k words</span>
      </div>
    </header>

    <CheatSheetExplorer client:load html={post.htmlContent} />

    <footer class="article-footer">
      <p class="article-bounty">Spot an error? <a href="/writing/errors-and-updates">There’s a bounty.</a></p>
      <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
    </footer>
  </div>
</Base>
) : (
<Base
  title={post.title}
  description={post.description}
  activeNav="/writing"
  ogType="article"
  ogImage={`/og/${post.slug}.png`}
  ogImageAlt={ogImageAlt}
  structuredData={articleStructuredData}
  keywords={seoKeywords}
>
  <meta slot="head" property="article:published_time" content={post.date.toISOString()} />
  <meta slot="head" property="article:author" content="Andy Masley" />
  <div class="article-page article-page--wide">
    <div class="article-grid article-grid--wide">
      <aside class="article-grid__toc">
        <ArticleTOC
          client:load
          headings={tocHeadings}
          meta={{
            date: isMetaPost ? undefined : formatDate(post.date),
            readingTime: `${readingTime} min read`,
            length: `${Math.round(wordCount / 100) / 10}k words`,
            sourceName: post.source !== 'local' ? post.sourceName : undefined,
            sourceUrl: post.source !== 'local' ? post.url : undefined,
          }}
        />
      </aside>
      <div class="article-main article-grid__main h-entry">
        <a class="u-url" href={permalink} hidden aria-hidden="true"></a>
        <header class="article-header">
          <div class="article-header__meta">
            {!isMetaPost && (
              <span class="article-header__meta-item">
                <time class="dt-published" datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
              </span>
            )}
            <span class="article-header__meta-item">{readingTime} min read</span>
            {post.source !== 'local' && (
              <span class="article-header__meta-item">
                Originally published on <a href={post.url} target="_blank" rel="noopener">{post.sourceName}</a>
              </span>
            )}
          </div>
          <h1 class="article-header__title p-name">{post.title}</h1>
          {standfirst && <p class="article-header__standfirst">{standfirst}</p>}
        </header>

        <article class="article-body">
          <div class="article-prose prose e-content">
            {post.source === 'local' ? (
              <Content />
            ) : (
              <Fragment set:html={displayHtml || post.htmlContent} />
            )}
          </div>
          <footer class="article-footer">
            <p class="article-footer__author p-author h-card">
              By <a class="p-name u-url" href="https://andymasley.com">Andy Masley</a>
            </p>
            <p class="article-bounty">Spot an error? <a href="/writing/errors-and-updates">There’s a bounty.</a></p>
            <div class="article-footer__back">
              <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
            </div>
            {(newerPost || olderPost) && (
              <nav class="article-pagination" aria-label="More writing">
                {olderPost ? (
                  <a href={`/writing/${olderPost.slug}`} class="article-pagination__link">
                    <span class="article-pagination__label">Older</span>
                    <span class="article-pagination__title">{olderPost.title}</span>
                    <span class="article-pagination__date">{formatDate(olderPost.date)}</span>
                  </a>
                ) : (
                  <span class="article-pagination__link article-pagination__link--empty" aria-hidden="true"></span>
                )}
                {newerPost && (
                  <a href={`/writing/${newerPost.slug}`} class="article-pagination__link article-pagination__link--align-end">
                    <span class="article-pagination__label">Newer</span>
                    <span class="article-pagination__title">{newerPost.title}</span>
                    <span class="article-pagination__date">{formatDate(newerPost.date)}</span>
                  </a>
                )}
              </nav>
            )}
          </footer>
        </article>
      </div>
    </div>
  </div>
</Base>
)}

<style>
  .article-page {
    width: 100%;
  }

  .article-page--standard {
    max-width: 720px;
    margin: 0 auto;
  }

  /* One measure, one axis: the essay column IS the standard centered
     640px column. At >=1280px the TOC hangs into the left margin — the
     explicit width plus negative margin keeps body text aligned with the
     header ink by construction, not by shell arithmetic. */
  @media (min-width: 1280px) {
    .article-grid--wide {
      display: grid;
      grid-template-columns: 220px var(--measure);
      column-gap: 3rem;
      width: calc(220px + 3rem + var(--measure));
      margin-left: calc(-220px - 3rem);
      align-items: start;
    }

    .article-grid__main {
      grid-column: 2;
    }

    .article-grid__toc {
      grid-column: 1;
      min-width: 0;
      align-self: start;
      position: sticky;
      top: 1.5rem;
    }
  }

  .article-main {
    min-width: 0;
  }

  .article-body {
    min-width: 0;
  }

  .article-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
  }

  .article-header__title {
    font-family: var(--font-editorial);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0;
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1rem;
    font-size: var(--text-xs);
    font-family: var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .article-header__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    line-height: 1.4;
  }

  .article-header__meta-item:not(:last-child)::after {
    content: '·';
    color: var(--border-strong);
  }

  .article-header__meta-item a {
    color: inherit;
    color: var(--accent);
  }

  .article-header__standfirst {
    margin: 1.5rem 0 0;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: var(--leading-note);
    color: var(--text-secondary);
    text-wrap: balance;
  }

  .article-footer {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .article-bounty {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--dim);
  }

  /* Visually hidden: kept in the DOM so the h-card microformat still parses */
  .article-footer__author {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .article-footer__back {
    display: flex;
  }

  .article-nav__link {
    font-size: var(--text-sm);
    color: var(--dim);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .article-nav__link:hover {
    color: var(--text);
  }

  .article-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-pagination__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .article-pagination__link:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }

  .article-pagination__link--align-end {
    text-align: right;
    align-items: flex-end;
  }

  .article-pagination__link--empty {
    visibility: hidden;
    pointer-events: none;
  }

  .article-pagination__label,
  .article-pagination__date {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .article-pagination__title {
    font-family: var(--font-editorial);
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .article-prose {
    font-family: var(--font-editorial);
    font-size: var(--text-md);
    line-height: var(--leading-prose);
    color: var(--text);
    text-align: left;
    hyphens: none;
  }

  /* Micro-typography: balanced headings, pretty body paragraphs */
  .article-prose :global(h1),
  .article-prose :global(h2),
  .article-prose :global(h3) { text-wrap: balance; }
  .article-prose :global(p) { text-wrap: pretty; }

  /* Section anchors (§): revealed on hover/focus, faint on touch. Scope
     covers the cheat-sheet explorer's injected prose too, so its headings
     stop rendering a permanently visible anchor. */
  .article-prose :global(.h-anchor),
  .cheat-sheet-page :global(.prose .h-anchor) {
    margin-left: 0.4em;
    color: var(--dim);
    text-decoration: none;
    opacity: 0;
  }
  .article-prose :global(h1:hover .h-anchor),
  .article-prose :global(h2:hover .h-anchor),
  .article-prose :global(h3:hover .h-anchor),
  .article-prose :global(.h-anchor:focus-visible),
  .cheat-sheet-page :global(.prose h2:hover .h-anchor),
  .cheat-sheet-page :global(.prose h3:hover .h-anchor),
  .cheat-sheet-page :global(.prose h4:hover .h-anchor),
  .cheat-sheet-page :global(.prose .h-anchor:focus-visible) { opacity: 1; }
  @media (hover: none) {
    .article-prose :global(.h-anchor),
    .cheat-sheet-page :global(.prose .h-anchor) { opacity: 0.35; }
  }

  /* Scene breaks */
  .article-prose :global(.asterism) {
    text-align: center;
    color: var(--dim);
    font-size: 1.1em;
    margin: 2.25rem 0;
  }

  .article-prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2.25rem 0 0;
    border-radius: 0;
    border: 1px solid var(--border);
    background: transparent;
    box-shadow: none;
  }

  .article-prose :global(figure) {
    margin: 2.5rem 0;
  }

  /* Captions: secondary ink, smaller than body, hanging indent so wrapped
     lines tuck under the leading "Source:" label. .image-caption is the
     class Substack puts on its figcaptions — same treatment. */
  .article-prose :global(figcaption),
  .article-prose :global(.image-caption) {
    margin-top: 0.85rem;
    max-width: 38rem;
    font-size: var(--text-sm);
    font-family: var(--font-body);
    line-height: var(--leading-ui);
    color: var(--dim);
    text-align: left;
    padding-left: 1.1em;
    text-indent: -1.1em;
  }

  .article-prose :global(blockquote) {
    margin: 2.25rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1.5px solid var(--border-strong);
    color: var(--text-secondary);
    font-style: normal;
  }

  /* Blockquote citations */
  .article-prose :global(blockquote > footer),
  .article-prose :global(blockquote cite) {
    color: var(--dim);
    font-style: normal;
    font-size: 0.9em;
  }
  .article-prose :global(blockquote > footer::before) { content: "\2014\00a0"; }

  /* Tables: ink rules top and bottom, hairline under the header, no zebra */
  .article-prose :global(table) {
    border-collapse: collapse;
    margin: 1.5rem 0;
    border-top: 1px solid var(--text);
    border-bottom: 1px solid var(--text);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .article-prose :global(th) {
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .article-prose :global(th),
  .article-prose :global(td) {
    padding: 0.4rem 1rem 0.4rem 0;
    border-left: 0;
    border-right: 0;
  }
  .article-prose :global(tbody tr) { background: none; }
  .article-prose :global(td.num),
  .article-prose :global(th.num) { text-align: right; }

  .article-prose :global(pre) {
    margin: 2rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-subtle);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--text-secondary);
  }

  .article-prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--bg-subtle);
    padding: 0.14em 0.36em;
    border: 1px solid var(--border);
    border-radius: 0;
  }

  .article-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  /* Visited purple (post prose). Literal colors: :visited ignores var(). */
