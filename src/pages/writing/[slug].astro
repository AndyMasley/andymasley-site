---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts, fetchPostContent, processPostContent, type SubstackPost } from '@/lib/substack';
import { fetchEAForumPosts, fetchEAForumPostContent, processEAForumContent, type EAForumPost } from '@/lib/eaforum';
import { metaPosts, getMetaPostSlugs } from '@/lib/meta-posts';
import { CheatSheetExplorer } from '@/components/CheatSheetExplorer';
import { ArticleTOC } from '@/components/ArticleTOC';
import { extractHeadingsFromHtml, type TOCHeading } from '@/lib/extract-headings';
import { mapWithConcurrency } from '@/lib/map-with-concurrency';
import { getOptionalCollection } from '@/lib/optional-collection';

// Union type for all post sources
type PostSource = 'local' | 'substack' | 'eaforum';

interface LocalPost {
  source: 'local';
  slug: string;
  title: string;
  date: Date;
  description: string;
  tags: string[];
  body: string;
  render: () => Promise<{ Content: any; headings: any[] }>;
}

interface ExternalPost {
  source: 'substack' | 'eaforum';
  slug: string;
  title: string;
  date: Date;
  description: string;
  url: string;
  htmlContent: string;
  sourceName: string;
}

type Post = LocalPost | ExternalPost;

interface AdjacentPost {
  slug: string;
  title: string;
  date: Date;
}

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { post: Post } }> = [];

  // 1. Get post lists from all sources
  const [localPosts, substackPosts, eaForumPosts] = await Promise.all([
    getOptionalCollection('writing'),
    fetchSubstackPosts(),
    fetchEAForumPosts()
  ]);

  const existingSlugs = new Set<string>();

  for (const post of localPosts) {
    paths.push({
      params: { slug: post.slug },
      props: {
        post: {
          source: 'local' as const,
          slug: post.slug,
          title: post.data.title,
          date: post.data.date,
          description: post.data.description || '',
          tags: post.data.tags || [],
          body: post.body,
          render: () => post.render(),
        }
      }
    });
    existingSlugs.add(post.slug);
  }

  // 2. Get Substack posts
  const metaSlugSet = new Set(getMetaPostSlugs());
  const substackCandidates = substackPosts.filter(
    post => !existingSlugs.has(post.slug)
  );
  const substackPaths = await mapWithConcurrency(substackCandidates, async post => {
    const rawContent = await fetchPostContent(post.slug);
    const htmlContent = processPostContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'substack' as const,
          slug: post.slug,
          title: post.title,
          date: post.date,
          description: post.description,
          url: post.url,
          htmlContent,
          sourceName: 'Substack',
        }
      }
    };
  });
  paths.push(...substackPaths);
  substackCandidates.forEach(post => existingSlugs.add(post.slug));

  const missingMetaPosts = metaPosts.filter(post => !existingSlugs.has(post.slug));
  const missingMetaPaths = await mapWithConcurrency(missingMetaPosts, async post => {
    const rawContent = await fetchPostContent(post.slug);
    const htmlContent = processPostContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'substack' as const,
          slug: post.slug,
          title: post.title,
          date: new Date(0),
          description: '',
          url: post.url,
          htmlContent,
          sourceName: 'Substack',
        }
      }
    };
  });
  paths.push(...missingMetaPaths);
  missingMetaPosts.forEach(post => existingSlugs.add(post.slug));

  // 3. Get EA Forum posts
  const eaForumCandidates = eaForumPosts.filter(post => !existingSlugs.has(post.slug));
  const eaForumPaths = await mapWithConcurrency(eaForumCandidates, async post => {
    const rawContent = await fetchEAForumPostContent(post.postId);
    const htmlContent = processEAForumContent(rawContent, post.slug);

    return {
      params: { slug: post.slug },
      props: {
        post: {
          source: 'eaforum' as const,
          slug: post.slug,
          title: post.title,
          date: post.date,
          description: '',
          url: post.url,
          htmlContent,
          sourceName: 'EA Forum',
        }
      }
    };
  });
  paths.push(...eaForumPaths);

  const sortedPaths = [...paths].sort(
    (a, b) => b.props.post.date.getTime() - a.props.post.date.getTime()
  );

  const navigablePaths = sortedPaths.filter(path => !metaSlugSet.has(path.props.post.slug));

  return sortedPaths.map((path, index) => ({
    ...path,
    props: {
      ...path.props,
      newerPost: (() => {
        if (metaSlugSet.has(path.props.post.slug)) return undefined;
        const navIndex = navigablePaths.findIndex(item => item.props.post.slug === path.props.post.slug);
        return navIndex > 0
          ? {
              slug: navigablePaths[navIndex - 1].props.post.slug,
              title: navigablePaths[navIndex - 1].props.post.title,
              date: navigablePaths[navIndex - 1].props.post.date,
            }
          : undefined;
      })(),
      olderPost: (() => {
        if (metaSlugSet.has(path.props.post.slug)) return undefined;
        const navIndex = navigablePaths.findIndex(item => item.props.post.slug === path.props.post.slug);
        return navIndex >= 0 && navIndex < navigablePaths.length - 1
          ? {
              slug: navigablePaths[navIndex + 1].props.post.slug,
              title: navigablePaths[navIndex + 1].props.post.title,
              date: navigablePaths[navIndex + 1].props.post.date,
            }
          : undefined;
      })(),
    }
  }));
}

interface Props {
  post: Post;
  newerPost?: AdjacentPost;
  olderPost?: AdjacentPost;
}

const { post, newerPost, olderPost } = Astro.props;
const isMetaPost = new Set(getMetaPostSlugs()).has(post.slug);

// Format date as MM.DD.YYYY
function formatDate(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const year = date.getFullYear();
  return `${month}.${day}.${year}`;
}

// Estimate reading time
function getReadingTime(content: string): number {
  const text = content.replace(/<[^>]*>/g, ''); // Strip HTML
  const wordCount = text.split(/\s+/).length;
  return Math.ceil(wordCount / 200);
}

// Get content and metadata based on source
let Content: any = null;
let readingTime = 0;
let tocHeadings: TOCHeading[] = [];
let displayHtml = '';

if (post.source === 'local') {
  const rendered = await post.render();
  Content = rendered.Content;
  readingTime = Math.ceil(post.body.split(/\s+/).length / 200);
  // Map Astro headings to TOC format
  tocHeadings = (rendered.headings || [])
    .filter((h: any) => h.depth === 2 || h.depth === 3)
    .map((h: any) => ({ id: h.slug, text: h.text, level: h.depth === 2 ? 'section' as const : 'sub' as const }));
} else {
  readingTime = getReadingTime(post.htmlContent);
  const extracted = extractHeadingsFromHtml(post.htmlContent);
  tocHeadings = extracted.headings;
  displayHtml = extracted.cleanedHtml;
}

const isCheatSheet = post.slug === 'a-cheat-sheet-for-conversations-about';
const hasTOC = !isCheatSheet;
const wordCount = post.source === 'local'
  ? post.body.split(/\s+/).length
  : (post.htmlContent.replace(/<[^>]*>/g, '').split(/\s+/).length);
const standfirst = post.description?.trim() || '';
---

{isCheatSheet && post.source !== 'local' ? (
<Base
  title={post.title}
  description="Every environmental objection to using ChatGPT, answered with data and sources."
>
  <div class="cheat-sheet-page">
    <header class="article-header">
      <h1 class="article-header__title">{post.title}</h1>
      <div class="article-header__meta">
        <span>{formatDate(post.date)}</span>
        <span>{readingTime} min read</span>
        <span>{Math.round(wordCount / 1000)}k words</span>
      </div>
    </header>

    <CheatSheetExplorer client:load html={post.htmlContent} />

    <footer class="article-footer">
      <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
    </footer>
  </div>
</Base>
) : hasTOC ? (
<Base
  title={post.title}
  description={post.description}
  activeNav="/writing"
>
  <div class="article-page article-page--wide">
    <div class="article-grid article-grid--wide">
      <aside class="article-grid__toc">
        <ArticleTOC
          client:load
          headings={tocHeadings}
          meta={{
            date: isMetaPost ? undefined : formatDate(post.date),
            readingTime: `${readingTime} min read`,
            length: `${Math.round(wordCount / 100) / 10}k words`,
            sourceName: post.source !== 'local' ? post.sourceName : undefined,
            sourceUrl: post.source !== 'local' ? post.url : undefined,
          }}
        />
      </aside>
      <div class="article-main article-grid__main">
        <header class="article-header">
          <div class="article-header__meta">
            {!isMetaPost && <span class="article-header__meta-item">{formatDate(post.date)}</span>}
            <span class="article-header__meta-item">{readingTime} min read</span>
            {post.source !== 'local' && (
              <span class="article-header__meta-item">
                Originally published on <a href={post.url} target="_blank" rel="noopener">{post.sourceName}</a>
              </span>
            )}
          </div>
          <h1 class="article-header__title">{post.title}</h1>
          {standfirst && <p class="article-header__standfirst">{standfirst}</p>}
        </header>

        <article class="article-body">
          <div class="article-prose prose">
            {post.source === 'local' ? (
              <Content />
            ) : (
              <Fragment set:html={displayHtml || post.htmlContent} />
            )}
          </div>
          <footer class="article-footer">
            <div class="article-footer__back">
              <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
            </div>
            {(newerPost || olderPost) && (
              <nav class="article-pagination" aria-label="More writing">
                {olderPost ? (
                  <a href={`/writing/${olderPost.slug}`} class="article-pagination__link">
                    <span class="article-pagination__label">Older</span>
                    <span class="article-pagination__title">{olderPost.title}</span>
                    <span class="article-pagination__date">{formatDate(olderPost.date)}</span>
                  </a>
                ) : (
                  <span class="article-pagination__link article-pagination__link--empty" aria-hidden="true"></span>
                )}
                {newerPost && (
                  <a href={`/writing/${newerPost.slug}`} class="article-pagination__link article-pagination__link--align-end">
                    <span class="article-pagination__label">Newer</span>
                    <span class="article-pagination__title">{newerPost.title}</span>
                    <span class="article-pagination__date">{formatDate(newerPost.date)}</span>
                  </a>
                )}
              </nav>
            )}
          </footer>
        </article>
      </div>
    </div>
  </div>
</Base>
) : (
<Base
  title={post.title}
  description={post.description}
  activeNav="/writing"
>
  <article class="article-page article-page--standard">
    <header class="article-header">
      <div class="article-header__meta">
        {!isMetaPost && <span class="article-header__meta-item">{formatDate(post.date)}</span>}
        <span class="article-header__meta-item">{readingTime} min read</span>
        {post.source !== 'local' && (
          <span class="article-header__meta-item">
            Originally published on <a href={post.url} target="_blank" rel="noopener">{post.sourceName}</a>
          </span>
        )}
      </div>
      <h1 class="article-header__title">{post.title}</h1>
      {standfirst && <p class="article-header__standfirst">{standfirst}</p>}
    </header>

    <div class="article-body">
      <div class="article-prose prose">
        {post.source === 'local' ? (
          <Content />
        ) : (
          <Fragment set:html={post.htmlContent} />
        )}
      </div>
    </div>

    <footer class="article-footer">
      <div class="article-footer__back">
        <a href="/writing" class="article-nav__link">
          ← Back to all writing
        </a>
      </div>
      {(newerPost || olderPost) && (
        <nav class="article-pagination" aria-label="More writing">
          {olderPost ? (
            <a href={`/writing/${olderPost.slug}`} class="article-pagination__link">
              <span class="article-pagination__label">Older</span>
              <span class="article-pagination__title">{olderPost.title}</span>
              <span class="article-pagination__date">{formatDate(olderPost.date)}</span>
            </a>
          ) : (
            <span class="article-pagination__link article-pagination__link--empty" aria-hidden="true"></span>
          )}
          {newerPost && (
            <a href={`/writing/${newerPost.slug}`} class="article-pagination__link article-pagination__link--align-end">
              <span class="article-pagination__label">Newer</span>
              <span class="article-pagination__title">{newerPost.title}</span>
              <span class="article-pagination__date">{formatDate(newerPost.date)}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>
</Base>
)}

<style>
  .article-page {
    width: 100%;
  }

  .article-page--standard {
    max-width: 720px;
    margin: 0 auto;
  }

  .article-page--wide {
    --article-shell-width: min(var(--max-width-wide), calc(100vw - 48px));
    width: var(--article-shell-width);
    margin-left: calc((var(--article-shell-width) - 100%) / -2);
  }

  .article-grid--wide {
    display: grid;
    grid-template-columns: minmax(200px, 220px) minmax(0, 760px);
    column-gap: clamp(2.5rem, 4vw, 4.5rem);
    align-items: start;
  }

  .article-grid__main {
    grid-column: 2;
  }

  .article-grid__toc {
    grid-column: 1;
    min-width: 0;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }

  .article-main {
    min-width: 0;
  }

  .article-body {
    min-width: 0;
  }

  .article-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border);
  }

  .article-header__title {
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 4vw, 4.25rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0;
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1rem;
    font-size: 0.76rem;
    font-family: var(--font-body);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .article-header__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    line-height: 1.4;
  }

  .article-header__meta-item:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 0.85em;
    background: var(--border-strong);
  }

  .article-header__meta-item a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .article-header__standfirst {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.2rem, 1.05rem + 0.4vw, 1.45rem);
    line-height: 1.58;
    color: var(--text-secondary);
  }

  .article-footer {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .article-footer__back {
    display: flex;
  }

  .article-nav__link {
    font-size: 0.9rem;
    color: var(--dim);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .article-nav__link:hover {
    color: var(--text);
  }

  .article-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-pagination__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .article-pagination__link:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }

  .article-pagination__link--align-end {
    text-align: right;
    align-items: flex-end;
  }

  .article-pagination__link--empty {
    visibility: hidden;
    pointer-events: none;
  }

  .article-pagination__label,
  .article-pagination__date {
    font-size: 0.75rem;
    font-family: var(--font-body);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .article-pagination__title {
    font-family: var(--font-editorial);
    font-size: 1.12rem;
    line-height: 1.3;
  }

  .article-prose {
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 0.98rem + 0.24vw, 1.12rem);
    line-height: 1.82;
    color: var(--text);
  }

  .article-prose > :global(p:first-child) {
    font-size: 1.18em;
    line-height: 1.68;
    color: var(--text);
    margin-bottom: 1.75rem;
  }

  .article-prose :global(p) {
    margin-bottom: 1.45rem;
  }

  .article-prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2.25rem 0 0;
    border-radius: 0;
    border: 1px solid var(--border);
    background: transparent;
    box-shadow: none;
  }

  .article-prose :global(figure) {
    margin: 2.5rem 0;
  }

  .article-prose :global(figcaption) {
    margin-top: 0.85rem;
    max-width: 38rem;
    font-size: 0.85rem;
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--dim);
    text-align: left;
  }

  .article-prose :global(blockquote) {
    margin: 2.25rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1.5px solid var(--border-strong);
    color: var(--text-secondary);
    font-style: normal;
  }

  .article-prose :global(pre) {
    margin: 2rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-subtle);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .article-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    background: var(--bg-subtle);
    padding: 0.14em 0.36em;
    border: 1px solid var(--border);
    border-radius: 0;
  }

  .article-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: var(--underline-offset);
  }

  .article-prose :global(a:hover) {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .article-prose :global(h1) {
    font-family: var(--font-editorial);
    font-size: clamp(2.05rem, 1.82rem + 0.62vw, 2.35rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
    color: var(--text);
    margin-top: 4rem;
    margin-bottom: 1rem;
  }

  .article-prose :global(h2) {
    font-family: var(--font-editorial);
    font-size: clamp(1.48rem, 1.34rem + 0.36vw, 1.7rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.022em;
    color: var(--text);
    margin-top: 3rem;
    margin-bottom: 0.85rem;
  }

  .article-prose :global(h1),
  .article-prose :global(h2),
  .article-prose :global(h3) {
    scroll-margin-top: 24px;
  }

  .article-prose :global(h3) {
    font-family: var(--font-editorial);
    font-size: clamp(1.08rem, 1rem + 0.16vw, 1.18rem);
    font-weight: 600;
    line-height: 1.38;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    margin-top: 2.2rem;
    margin-bottom: 0.7rem;
  }

  .article-prose :global(h4) {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 2rem;
    margin-bottom: 0.65rem;
  }

  .article-prose :global(h1:first-child),
  .article-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.35rem;
  }

  .article-prose :global(li) {
    margin-bottom: 0.45rem;
    padding-left: 0.2rem;
  }

  .article-prose :global(hr) {
    margin: 3rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }

  .article-prose :global(.image-link),
  .article-prose :global(.image2) {
    display: block;
    margin: 2.25rem 0;
  }

  .article-prose :global(.image-link img),
  .article-prose :global(.image2 img) {
    max-width: 100%;
    height: auto;
  }

  .article-prose :global(.captioned-image-container) {
    margin: 2.25rem 0;
  }

  .article-prose :global(.image-caption) {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--dim);
    text-align: left;
  }

  .article-prose :global(.subscription-widget-wrap),
  .article-prose :global(.subscribe-widget),
  .article-prose :global(.subscription-widget),
  .article-prose :global(.image-link-expand),
  .article-prose :global(.icon-container) {
    display: none !important;
  }

  .article-prose :global(sup) {
    font-size: 0.7em;
    line-height: 0;
    vertical-align: baseline;
    position: relative;
    top: -0.4em;
  }

  .article-prose :global(sup a) {
    font-size: inherit;
    text-decoration: none;
    color: var(--accent);
  }

  .article-prose :global(sup a:hover) {
    text-decoration: underline;
  }

  .article-prose :global(.footnote-anchor) {
    font-size: 0.7em;
    vertical-align: super;
