<script>
  // In-column footnote expansion below the sidenote gate (the same 1280px
  // matchMedia the sidenotes use, so the two mechanisms never overlap).
  // The anchor stays a true link to the bottom list — new-tab, no-JS, and
  // print all land there; a plain click expands the note in place instead
  // of teleporting a 39-minute essay to its end. Delegated once; survives
  // View Transitions without stacking listeners. Capture phase: Astro's
  // ClientRouter also delegates clicks and honors defaultPrevented, so our
  // preventDefault must run before its bubble-phase listener or the router
  // scrolls to the bottom list anyway.
  if (!(window as any).__footnoteExpandBound) {
    (window as any).__footnoteExpandBound = true;
    const wide = window.matchMedia('(min-width: 1280px)');

    document.addEventListener('click', (e) => {
      if (wide.matches) return;
      const anchor = (e.target as HTMLElement).closest?.('a.footnote-anchor');
      if (!anchor) return;
      if (anchor.closest('.cheat-sheet-page')) return;
      if (!anchor.closest('.article-prose')) return;

      const href = anchor.getAttribute('href') || '';
      const noteId = href.startsWith('#') ? href.slice(1) : '';
      if (!noteId) return;
      const numberEl = document.getElementById(noteId);
      const note = numberEl?.closest('.footnote');
      const content = note?.querySelector('.footnote-content');
      if (!content) return;

      e.preventDefault();

      // Nearest block-level ancestor — anchors live inside <li> and
      // <blockquote> too, not just paragraphs.
      let block: HTMLElement | null = anchor.parentElement;
      while (block && getComputedStyle(block).display === 'inline') {
        block = block.parentElement;
      }
      if (!block) return;

      const existing = block.nextElementSibling;
      if (existing && existing.getAttribute('data-footnote-inline') === noteId) {
        existing.remove();
        return;
      }
      // A different expanded note directly after this block gets replaced.
      if (existing && existing.hasAttribute('data-footnote-inline')) {
        existing.remove();
      }

      const clone = content.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('[id]').forEach(el => el.removeAttribute('id'));
      const wrap = document.createElement('aside');
      wrap.className = 'footnote-inline';
      wrap.setAttribute('data-footnote-inline', noteId);
      wrap.append(...Array.from(clone.childNodes));
      block.after(wrap);
    }, true);
  }
</script>
