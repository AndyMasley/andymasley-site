---
import Base from '@/layouts/Base.astro';
import { fetchPostContent, processPostContent } from '@/lib/substack';
import { ArticleSidebar } from '@/components/ArticleSidebar';

const slug = 'a-cheat-sheet-for-conversations-about';
const rawContent = await fetchPostContent(slug);
const htmlContent = processPostContent(rawContent, slug);

// Estimate reading time
const text = htmlContent.replace(/<[^>]*>/g, '');
const wordCount = text.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);
---

<Base
  title="A cheat sheet for conversations about ChatGPT's environmental impact"
  description="Every environmental objection to using ChatGPT, answered with data and sources."
>
  <ArticleSidebar client:load />

  <div class="article-with-toc">
    <article class="article-main">
      <p class="originally-on">
        Originally on <a href="https://andymasley.substack.com/p/a-cheat-sheet-for-conversations-about" target="_blank" rel="noopener">Substack</a>
      </p>

      <header class="article-header">
        <h1 class="article-header__title">A cheat sheet for conversations about ChatGPT's environmental impact</h1>
        <div class="article-header__meta">
          <span class="article-header__date">01.06.2025</span>
          <span class="article-header__reading-time">{readingTime} min read</span>
        </div>
      </header>

      <div class="prose" set:html={htmlContent} />

      <footer class="article-footer">
        <nav class="article-nav">
          <a href="/writing" class="article-nav__link">
            &larr; Back to all writing
          </a>
        </nav>
      </footer>
    </article>
  </div>
</Base>

<style>
  /* Layout with sidebar space */
  .article-with-toc {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
  }

  .article-main {
    min-width: 0; /* prevent overflow */
    max-width: 640px;
  }

  /* On smaller screens, single column, no sidebar space */
  @media (max-width: 1100px) {
    .article-with-toc {
      max-width: var(--max-width);
      grid-template-columns: 1fr;
      gap: 0;
    }
    .article-main {
      max-width: 100%;
    }
  }

  /* Mobile TOC toggle shows below 1100px */
  @media (max-width: 1100px) {
    :global(.toc-sidebar) {
      display: none;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-height: 100vh !important;
      background: var(--bg) !important;
      padding: 60px 24px 24px !important;
      z-index: 998 !important;
      overflow-y: auto !important;
    }
    :global(.toc-sidebar.toc-sidebar--open) {
      display: block;
    }
    :global(.toc-mobile-toggle) {
      display: flex !important;
    }
  }

  @media (min-width: 1101px) {
    :global(.toc-mobile-toggle) {
      display: none !important;
    }
    :global(.toc-sidebar) {
      display: block;
    }
  }

  .originally-on {
    font-size: var(--font-size-ui);
    color: var(--dim);
    margin-bottom: var(--space-lg);
  }
  .originally-on a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .article-header {
    margin-bottom: var(--space-xl);
  }
  .article-header__title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
  }
  @media (max-width: 600px) {
    .article-header__title { font-size: 1.75rem; }
  }
  .article-header__meta {
    display: flex;
    gap: var(--space-md);
    font-size: var(--font-size-mono);
    font-family: var(--font-mono);
    color: var(--dim);
  }

  .article-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
  .article-nav__link {
    font-size: var(--font-size-ui);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* Prose styles — same as [slug].astro */
  .prose :global(img) { max-width: 100%; height: auto; margin: var(--space-lg) 0; }
  .prose :global(figure) { margin: var(--space-lg) 0; }
  .prose :global(figcaption) { font-size: var(--font-size-ui); color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); padding-left: var(--space-md); margin: var(--space-lg) 0; color: var(--dim); font-style: italic; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: var(--underline-offset); }

  .prose :global(h1) {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 20px;
  }
  .prose :global(h1:first-child) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 20px;
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 20px;
  }

  .prose :global(p) { margin-bottom: var(--space-md); }
  .prose :global(ul), .prose :global(ol) { margin-bottom: var(--space-md); padding-left: var(--space-lg); }
  .prose :global(li) { margin-bottom: var(--space-sm); }

  /* Substack-specific */
  .prose :global(.image-link), .prose :global(.image2) { display: block; margin: var(--space-lg) 0; }
  .prose :global(.image-link img), .prose :global(.image2 img) { max-width: 100%; height: auto; }
  .prose :global(.captioned-image-container) { margin: var(--space-lg) 0; }
  .prose :global(.image-caption) { font-size: var(--font-size-ui); color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  .prose :global(.subscription-widget-wrap), .prose :global(.subscribe-widget), .prose :global(.subscription-widget), .prose :global(.image-link-expand), .prose :global(.icon-container) { display: none !important; }
  .prose :global(.footnote-anchor) { font-size: 0.7em; vertical-align: super; line-height: 0; text-decoration: none; color: var(--accent); }
  .prose :global(.footnote-anchor:hover) { text-decoration: underline; }
  .prose :global(.footnotes), .prose :global(.footnote) { font-size: var(--font-size-ui); color: var(--dim); margin-top: var(--space-xl); padding-top: var(--space-md); border-top: 1px solid var(--border); }
  .prose :global(.footnote .footnote-number) { font-size: 0.85em; margin-right: var(--space-sm); color: var(--accent); text-decoration: none; }

  .prose :global(pre) { background: var(--border); padding: var(--space-md); border-radius: 4px; overflow-x: auto; font-family: var(--font-mono); font-size: var(--font-size-mono); }
  .prose :global(code) { font-family: var(--font-mono); font-size: var(--font-size-mono); background: var(--border); padding: 0.1em 0.3em; border-radius: 2px; }
  .prose :global(pre code) { background: none; padding: 0; }

  /* Scrollbar styling for sidebar */
  :global(.toc-sidebar::-webkit-scrollbar) { width: 3px; }
  :global(.toc-sidebar::-webkit-scrollbar-thumb) { background: var(--border); border-radius: 3px; }
  :global(.toc-sidebar::-webkit-scrollbar-track) { background: transparent; }
</style>
