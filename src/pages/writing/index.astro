  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 60vh;
  }

  .year-group {
    border-top: 1px solid var(--border-subtle);
  }

  .year-group.hidden {
    display: none;
  }

  .year-summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 0;
    cursor: pointer;
    color: var(--text);
  }

  .year-summary:hover {
    color: var(--accent);
  }

  .year-label,
  .year-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .year-count {
    margin-left: auto;
    color: var(--dim);
  }

  .year-posts {
    margin: 0;
    padding: 0 0 0.35rem;
    list-style: none;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 0.5rem 1rem;
    align-items: start;
    padding: 0.62rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .timeline-row.hidden {
    display: none;
  }

  .timeline-date {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
    min-width: 0;
  }

  .timeline-month,
  .timeline-day {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--dim);
  }

  .timeline-main {
    min-width: 0;
  }

  .timeline-link {
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.34;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .timeline-link:hover {
    color: var(--accent);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    margin: 0.18rem 0 0;
    font-size: 0.72rem;
    color: var(--dim);
  }

  .timeline--topic-selected .timeline-cat,
  .timeline--topic-selected .timeline-separator {
    display: none;
  }

  .timeline-separator {
    color: var(--border-strong);
  }

  .guide-links {
    margin: 0 0 2.75rem;
  }

  .guide-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-list__item {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-link {
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.22;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
