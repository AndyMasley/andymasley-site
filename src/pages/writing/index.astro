---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts, fetchPostContent, categoryConfigs, parseSubcategoriesFromHTML } from '@/lib/substack';
import { metaPosts, getMetaPostSlugs } from '@/lib/meta-posts';
import { bylines } from '@/lib/bylines';
import { fetchEAForumPosts } from '@/lib/eaforum';
import { formatDateOnly, formatMonthAbbrev, formatDayOfMonth } from '@/lib/format-date';

interface TimelinePost {
  title: string;
  slug: string;
  date: Date;
  url: string;
  category: string;
  source: 'substack' | 'eaforum';
  cover?: string;
}

interface YearGroup {
  year: number;
  posts: TimelinePost[];
}

interface GuideCard {
  title: string;
  url: string;
}

const [allSubstackPosts, eaForumPosts] = await Promise.all([
  fetchSubstackPosts(),
  fetchEAForumPosts()
]);

const metaSlugs = getMetaPostSlugs();

const substackPosts: TimelinePost[] = allSubstackPosts
  .filter(post => !metaSlugs.includes(post.slug))
  .map(post => ({
    title: post.title,
    slug: post.slug,
    date: post.date,
    url: post.url,
    category: post.category,
    source: 'substack' as const,
    cover: post.cover_image,
  }));

const eaForumTimelinePosts: TimelinePost[] = eaForumPosts.map(post => ({
  title: post.title,
  slug: post.slug,
  date: post.date,
  url: post.url,
  category: 'Charity',
  source: 'eaforum' as const,
}));

const posts: TimelinePost[] = [...substackPosts, ...eaForumTimelinePosts].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

const RAW_COVER_PREFIX = 'https://substack-post-media.s3.amazonaws.com/public/images/';

// Substack serves resized covers through its CDN fetch proxy. Only raw S3
// URLs are safe to wrap: already-proxied URLs carry a $s_! signature that
// covers their transform set, so those are used exactly as given.
function sizedCover(cover: string, width: number): string {
  if (cover.startsWith(RAW_COVER_PREFIX)) {
    return `https://substackcdn.com/image/fetch/w_${width},c_limit,f_auto,q_auto:good/${encodeURIComponent(cover)}`;
  }
  return cover;
}

function coverSrcset(cover: string): string | undefined {
  if (!cover.startsWith(RAW_COVER_PREFIX)) return undefined;
  return [400, 600, 900].map(w => `${sizedCover(cover, w)} ${w}w`).join(', ');
}

const metaPostsWithContent = await Promise.all(
  metaPosts.map(async (meta) => {
    const content = await fetchPostContent(meta.slug);
    return { ...meta, content };
  })
);

const aiEnvMeta = metaPostsWithContent.find(meta => meta.slug === 'ai-and-the-environment');
const aiEnvSubcategories = aiEnvMeta ? parseSubcategoriesFromHTML(aiEnvMeta.content) : [];
const activeCategories = categoryConfigs.filter(config => posts.some(post => post.category === config.name));
const hasBylines = bylines.length > 0;
const bylinesPreviewCount = 5;
const archivePostsWithoutVisibleCategory = new Set<string>([]);

function getShortName(categoryName: string): string {
  const shortNames: Record<string, string> = {
    'AI & the Environment': 'AI & environment',
    'Artificial Intelligence': 'Artificial intelligence',
    'Animal Welfare': 'Animal welfare',
    'Charity': 'Effective altruism',
    'Politics': 'Politics',
    'Recs & Advice': 'Recs & advice',
    'Misc': 'Miscellaneous',
    'EA Forum': 'EA Forum',
  };
  return shortNames[categoryName] || categoryName;
}

function showArchiveCategory(post: TimelinePost): boolean {
  return !archivePostsWithoutVisibleCategory.has(post.slug);
}

function getFilterName(categoryName: string): string {
  const names: Record<string, string> = {
    'AI & the Environment': 'AI & environment',
    'Artificial Intelligence': 'Artificial intelligence',
    'Animal Welfare': 'Animal welfare',
    'Charity': 'Effective altruism',
    'Politics': 'Politics',
    'Recs & Advice': 'Recs & advice',
    'Misc': 'Miscellaneous',
  };
  return names[categoryName] || categoryName;
}

function getCategorySlug(categoryName: string): string {
  if (categoryName === 'EA Forum') return 'ea-forum';
  const config = categoryConfigs.find(category => category.name === categoryName);
  return config?.slug || categoryName.toLowerCase().replace(/\s+/g, '-');
}

function normalizeCapitalization(text: string): string {
  const words = text.split(' ');
  return words.map((word, index) => {
    if (index === 0) {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    }
    return word.toLowerCase();
  }).join(' ');
}

const guideCards: GuideCard[] = metaPostsWithContent.map(meta => ({
  title: meta.title,
  url: `/writing/${meta.slug}`,
}));

const yearMap = new Map<number, TimelinePost[]>();
for (const post of posts) {
  const year = post.date.getFullYear();
  if (!yearMap.has(year)) {
    yearMap.set(year, []);
  }
  yearMap.get(year)!.push(post);
}

const postsByYear: YearGroup[] = Array.from(yearMap.entries())
  .map(([year, yearPosts]) => ({
    year,
    posts: yearPosts.sort((a, b) => b.date.getTime() - a.date.getTime()),
  }))
  .sort((a, b) => b.year - a.year);

---

<Base title="Writing" description="Essays on AI and the environment, animal welfare, effective altruism, political liberalism, and more. Published on Substack and elsewhere." ogImage="/og/page/writing.png">
  <section class="writing-hero" aria-label="Writing">
    <p class="page-intro">
      I write on <a href="https://andymasley.substack.com/">Substack</a> and elsewhere about AI and the environment, AI more broadly, animal welfare, philosophy, and political liberalism. Since March 2026 I've been writing full-time on a grant from <a href="https://coefficientgiving.org/" target="_blank" rel="noopener">Coefficient Giving</a>.
    </p>
    <p class="error-bounty">
      I have a $300 bounty on errors. If you find a significant error I make in my writing, either misreading/misrepresenting a source or using a bad source where experts believe it's unreliable, and this undermines a core claim I'm making in the post, let me know at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a>. I have a log of errors and updates <a href="/writing/errors-and-updates">here</a>.
    </p>
    <details class="bounty-rules">
      <summary>Rules for claiming</summary>
      <ul>
        <li>A legitimate source for a statistic I cite where I get the number wrong, which invalidates a core argument I'm making.</li>
        <li>A source for a number I cite that's illegitimate, and that most legitimate sources disagree with, and this updated information invalidates a core argument I'm making.</li>
        <li>All claims need to be analyzed by when I said them. If I make a claim about ChatGPT in June, and a new model comes out in December that's 100x as energy intensive, my claim in June isn't wrong, just outdated.</li>
        <li>I'm vetoing very specific disagreements of what counts as "using" water. Whether to count rainfall on crops or into lakes dammed by hydroelectric power stations turns out to be very relevant for the water debates, and reasonable people land on both extremes.</li>
        <li>If I don't cite a source in a newer post but I had cited the source for it previously, and the source is legit, that doesn't count.</li>
        <li>If the error is trivial (e.g. 0.0000102% should be 0.0000103%), that doesn't count. But if a number is off by orders of magnitude and invalidates a core claim, it does.</li>
        <li>The correction can't be something I've already spotted and noted. For example, my very first post on AI and the environment, <em>Using ChatGPT is not bad for the environment</em>, has some back of the envelope calculations that I now note are both outdated and unreliable around how much energy other services use. I note that in the post.</li>
      </ul>
    </details>
  </section>

  {guideCards.length > 0 && (
    <section class="writing-section writing-section--guides" aria-label="Start here">
      <div class="label">Start here</div>
      <div class="guide-links">
        <ul class="guide-list">
          {guideCards.map(guide => (
            <li class="guide-list__item">
              <a href={guide.url} class="guide-link">{guide.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="divider"><div class="divider-diamond"></div></div>

  <section class="writing-section writing-section--archive" id="writing-archive" aria-label="Writing archive">
    <div class="archive-controls">
      <div class="archive-control archive-control--search">
        <div class="archive-search">
          <input
            id="archive-search"
            class="archive-search__input"
            type="search"
            placeholder="Search"
            aria-label="Search blog posts"
            autocomplete="off"
          />
          <button id="archive-search-clear" class="archive-inline-action" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="archive-control-grid">
        <div class="archive-control">
          <select id="archive-topic" class="archive-select" aria-label="Topic">
            <option value="all">All topics</option>
            {activeCategories.map(topic => (
              <option value={topic.slug}>{getFilterName(topic.name)}</option>
            ))}
          </select>
        </div>

        <div class="archive-control">
          <select id="archive-source" class="archive-select" aria-label="Source">
            <option value="all">All sources</option>
            <option value="substack">Substack</option>
            {eaForumTimelinePosts.length > 0 && (
              <option value="eaforum">EA Forum</option>
            )}
          </select>
        </div>

        <div class="archive-control" id="archive-theme-wrap" hidden>
          <select id="archive-theme" class="archive-select" aria-label="AI and environment theme">
            <option value="">All themes</option>
            {aiEnvSubcategories.map(theme => (
              <option value={theme.slug} data-posts={JSON.stringify(theme.postSlugs)}>
                {normalizeCapitalization(theme.name)}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="archive-toolbar">
        <button class="archive-inline-action" id="archive-clear" type="button" disabled>Clear filters</button>
      </div>
    </div>

    <p class="archive-empty" id="archive-empty" hidden>No posts match the current filters.</p>

    <div class="grid-breakout">
      <div class="post-grid" id="post-grid">
        {postsByYear.map(yearGroup => (
          <>
            <div class="grid-year" data-year={yearGroup.year}>
              <span>{yearGroup.year}</span>
            </div>
            {yearGroup.posts.map(post => (
              <article
                class="post-card"
                data-year={yearGroup.year}
                data-cat={getCategorySlug(post.category)}
                data-source={post.source}
                data-slug={post.slug}
                data-search-text={post.title.toLowerCase()}
              >
                <a
                  class="post-card__imglink"
                  href={`/writing/${post.slug}`}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <span class="post-card__frame">
                    {post.cover ? (
                      <img
                        src={sizedCover(post.cover, 600)}
                        srcset={coverSrcset(post.cover)}
                        sizes="(max-width: 600px) 92px, (max-width: 940px) 46vw, 356px"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        onerror={`this.onerror=null;this.src='/og/${post.slug}.png';this.removeAttribute('srcset');`}
                      />
                    ) : (
                      <span class="post-card__placeholder" aria-hidden="true">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                          <polygon points="12,2 20.66,7 20.66,17 12,22 3.34,17 3.34,7" fill="none" stroke="currentColor" stroke-width="0.8" />
                        </svg>
                      </span>
                    )}
                  </span>
                </a>
                <p class="post-card__meta">
                  <time datetime={post.date.toISOString()}>
                    {formatMonthAbbrev(post.date)} {formatDayOfMonth(post.date)}
                  </time>
                  {showArchiveCategory(post) && (
                    <>
                      <span class="post-card__separator post-card__separator--cat" aria-hidden="true">·</span>
                      <span class="post-card__cat">{getShortName(post.category)}</span>
                    </>
                  )}
                  {post.source === 'eaforum' && (
                    <>
                      <span class="post-card__separator" aria-hidden="true">·</span>
                      <span>EA Forum</span>
                    </>
                  )}
                </p>
                <h3 class="post-card__title">
                  <a href={`/writing/${post.slug}`} class="post-card__link">{post.title}</a>
                </h3>
              </article>
            ))}
          </>
        ))}
      </div>
    </div>
  </section>

  {hasBylines && (
    <section class="writing-section writing-section--elsewhere" aria-labelledby="elsewhere-heading">
      <header class="writing-section__header">
        <div>
          <h2 class="writing-section__title" id="elsewhere-heading">Elsewhere</h2>
          <p class="writing-section__description">Writing published outside the main blog archive.</p>
        </div>
      </header>

      <div class="bylines-list">
        {bylines.slice(0, bylinesPreviewCount).map(byline => (
          <article class="byline-row">
            <span class="byline-date">{formatDateOnly(byline.date)}</span>
            <a href={byline.url} target="_blank" rel="noopener" class="byline-link">
              {byline.title}
            </a>
            <span class="byline-pub">{byline.publication}</span>
          </article>
        ))}
      </div>

      {bylines.length > bylinesPreviewCount && (
        <details class="bylines-details">
          <summary class="bylines-details__summary">Show all bylines</summary>
          <div class="bylines-list bylines-list--extra">
            {bylines.slice(bylinesPreviewCount).map(byline => (
              <article class="byline-row">
                <span class="byline-date">{formatDateOnly(byline.date)}</span>
                <a href={byline.url} target="_blank" rel="noopener" class="byline-link">
                  {byline.title}
                </a>
                <span class="byline-pub">{byline.publication}</span>
              </article>
            ))}
          </div>
        </details>
      )}
    </section>
  )}
</Base>

<style>
  .writing-hero {
    margin-bottom: 2.4rem;
  }

  .page-intro {
    max-width: 42rem;
  }

  .error-bounty {
    max-width: 42rem;
    margin-top: 0.6rem;
    margin-bottom: 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .bounty-rules {
    max-width: 42rem;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .bounty-rules summary {
    cursor: pointer;
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .bounty-rules summary:hover {
    color: var(--accent);
  }

  .bounty-rules ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }

  .bounty-rules li {
    margin-bottom: 0.35rem;
  }

  .writing-section {
    margin-bottom: 2.75rem;
  }

  .writing-section__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 0.95rem;
  }

  .writing-section__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.24rem, 1.14rem + 0.28vw, 1.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .writing-section__description {
    max-width: 42rem;
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .writing-section--elsewhere {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .archive-controls {
    display: grid;
    gap: 0.95rem;
    margin-bottom: 1rem;
    padding: 0.2rem 0 0.1rem;
  }

  .archive-control {
    display: grid;
    gap: 0.35rem;
  }

  .archive-control-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .archive-control-grid.archive-control-grid--with-theme {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .archive-control__label {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .archive-search {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .archive-search__input,
  .archive-select {
    width: 100%;
    min-width: 0;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background-color: transparent;
    color: var(--text);
    font: inherit;
  }

  .archive-search__input {
    padding: 0.7rem 0.05rem 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.05rem;
  }

  .archive-search__input::placeholder {
    color: var(--dim);
  }

  .archive-control[hidden] {
    display: none !important;
  }

  .archive-select {
    appearance: none;
    padding: 0.65rem 1.35rem 0.45rem 0.05rem;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--dim) 50%),
      linear-gradient(135deg, var(--dim) 50%, transparent 50%);
    background-position:
      calc(100% - 0.65rem) calc(50% + 1px),
      calc(100% - 0.35rem) calc(50% + 1px);
    background-size: 0.32rem 0.32rem, 0.32rem 0.32rem;
    background-repeat: no-repeat;
  }

  .archive-search__input:focus,
  .archive-select:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .archive-toolbar {
    display: flex;
    justify-content: flex-start;
  }

  .archive-empty {
    margin: 0;
    font-size: 0.76rem;
    color: var(--dim);
  }

  .archive-empty {
    color: var(--text-secondary);
  }

  .archive-inline-action {
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    font-size: 0.72rem;
    font-family: var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .archive-inline-action:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .archive-inline-action[disabled] {
    color: var(--border-strong);
    border-color: transparent;
    cursor: default;
  }

  /* Cover grid archive. Breaks out of the 640px column to a centered
     1120px band, the same full-bleed technique the visuals pages use. */
  .grid-breakout {
    width: min(1120px, calc(100vw - 48px));
    margin-left: calc(50% - min(560px, 50vw - 24px));
    margin-top: 1.4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.1rem 1.6rem;
    min-height: 60vh;
  }

  .grid-year {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0.5rem 0 -0.6rem;
  }

  .grid-year span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .grid-year::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--border-subtle);
  }

  .grid-year:first-child {
    margin-top: 0;
  }

  .grid-year.hidden,
  .post-card.hidden {
    display: none;
  }

  .post-card {
    min-width: 0;
  }

  .post-card__imglink {
    display: block;
  }

  .post-card__frame {
    display: block;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .post-card__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: var(--border-strong);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    margin: 0.55rem 0 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--dim);
  }

  .post-card__separator {
    color: var(--border-strong);
  }

  .post-card__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.34;
  }

  .post-card__link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-strong);
  }

  .post-card:hover .post-card__link {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Visited purple (archive). Literal colors: :visited ignores var(). */
  .post-card__link:visited { color: #551a8b; }
  :global([data-theme="dark"]) .post-card__link:visited { color: #c58af9; }

  .post-grid--topic-selected .post-card__cat,
  .post-grid--topic-selected .post-card__separator--cat {
    display: none;
  }

  .guide-links {
    margin: 0 0 2.75rem;
  }

  .guide-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-list__item {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-link {
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.22;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .guide-link:hover {
    color: var(--accent);
  }

  .bylines-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .byline-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 0.85rem 1rem;
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .byline-date,
  .byline-pub {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--dim);
  }

  .byline-pub {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .byline-link {
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .byline-link:hover {
    color: var(--accent);
  }

  .bylines-details {
    margin-top: 0.9rem;
  }

  .bylines-details__summary {
    cursor: pointer;
    font-size: 0.72rem;
    font-family: var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .bylines-details__summary:hover {
    color: var(--accent);
  }

  .bylines-list--extra {
    margin-top: 0.9rem;
  }

  .guide-link:focus-visible,
  .byline-link:focus-visible,
  .archive-inline-action:focus-visible,
  .post-card__link:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 940px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.8rem 1.4rem;
    }
  }

  @media (max-width: 760px) {
    .writing-section__header {
      flex-direction: column;
      align-items: start;
    }

    .archive-control-grid {
      grid-template-columns: 1fr;
    }

    .archive-search {
      flex-direction: column;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .byline-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (max-width: 600px) {
    .post-grid {
      display: block;
    }

    .grid-year {
      margin: 1.3rem 0 0.4rem;
    }

    .grid-year:first-child {
      margin-top: 0.2rem;
    }

    .post-card {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 0.12rem 0.9rem;
      align-items: start;
      padding: 0.6rem 0;
      border-top: 1px solid var(--border-subtle);
    }

    .post-card__imglink {
      grid-row: 1 / 3;
    }

    .post-card__frame {
      aspect-ratio: 1 / 1;
    }

    .post-card__meta {
      margin: 0;
      gap: 0.25rem 0.4rem;
    }

    .post-card__title {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  function initWritingPage() {
    const previousCleanup = (window as any).__writingPageCleanup;
    if (typeof previousCleanup === 'function') {
      previousCleanup();
    }

    const cleanupFns: Array<() => void> = [];

    function on(
      target: EventTarget | null | undefined,
      type: string,
      handler: EventListenerOrEventListenerObject,
      options?: boolean | AddEventListenerOptions
    ) {
      if (!target) return;
      target.addEventListener(type, handler, options);
      cleanupFns.push(() => target.removeEventListener(type, handler, options));
    }

    const topicSelect = document.getElementById('archive-topic') as HTMLSelectElement | null;
    const controlGrid = document.querySelector('.archive-control-grid') as HTMLElement | null;
    const themeWrap = document.getElementById('archive-theme-wrap') as HTMLElement | null;
    const themeSelect = document.getElementById('archive-theme') as HTMLSelectElement | null;
    const sourceSelect = document.getElementById('archive-source') as HTMLSelectElement | null;
    const searchInput = document.getElementById('archive-search') as HTMLInputElement | null;
    const searchClear = document.getElementById('archive-search-clear') as HTMLButtonElement | null;
    const clearAll = document.getElementById('archive-clear') as HTMLButtonElement | null;
    const emptyState = document.getElementById('archive-empty') as HTMLElement | null;
    const grid = document.getElementById('post-grid') as HTMLElement | null;
    const yearRules = Array.from(document.querySelectorAll('.grid-year')) as HTMLElement[];
    const cards = Array.from(document.querySelectorAll('.post-card')) as HTMLElement[];

    const state = {
      topic: 'all',
      source: 'all',
      query: '',
      theme: '',
      themePosts: [] as string[],
    };

    let archiveSearchIndex: Map<string, string> | null = null;
    let archiveSearchIndexPromise: Promise<Map<string, string>> | null = null;
    let searchRequestId = 0;

    const validTopics = new Set(
      topicSelect ? Array.from(topicSelect.options).map(option => option.value) : []
    );
    const validSources = new Set(
      sourceSelect ? Array.from(sourceSelect.options).map(option => option.value) : []
    );
    const validThemes = new Set(
      themeSelect ? Array.from(themeSelect.options).map(option => option.value).filter(Boolean) : []
    );

    function getWritingSlug(url: string) {
      const match = url.match(/^\/writing\/([^/?#]+)/);
      return match ? decodeURIComponent(match[1]) : '';
    }

    async function loadArchiveSearchIndex() {
      if (archiveSearchIndex) {
        return archiveSearchIndex;
      }

      if (!archiveSearchIndexPromise) {
        archiveSearchIndexPromise = fetch('/search.json')
          .then(async response => {
            if (!response.ok) {
              throw new Error(`Search index request failed with ${response.status}`);
            }
            return response.json();
          })
          .then(entries => {
            const nextIndex = new Map<string, string>();

            if (Array.isArray(entries)) {
              entries.forEach(entry => {
                if (!entry || typeof entry.url !== 'string') return;

                const slug = getWritingSlug(entry.url);
                if (!slug) return;

                const searchableText = [
                  entry.description,
                  entry.headers,
                  entry.content,
                ]
                  .filter(value => typeof value === 'string' && value.length > 0)
                  .join(' ')
                  .toLowerCase();

                if (searchableText) {
                  nextIndex.set(slug, searchableText);
                }
              });
            }

            archiveSearchIndex = nextIndex;
            return nextIndex;
          })
          .catch(error => {
            console.error('Failed to load archive search index:', error);
            archiveSearchIndexPromise = null;
            throw error;
          });
      }

      return archiveSearchIndexPromise;
    }

    function hasActiveFilters() {
      return state.topic !== 'all' || state.source !== 'all' || state.query !== '' || state.theme !== '';
    }

    function updateThemeVisibility() {
      const show = state.topic === 'ai-environment' && Boolean(themeSelect) && themeSelect.options.length > 1;

      if (controlGrid) {
        controlGrid.classList.toggle('archive-control-grid--with-theme', show);
      }

      if (themeWrap) {
        themeWrap.hidden = !show;
      }

      if (!show) {
        state.theme = '';
        state.themePosts = [];
        if (themeSelect) {
          themeSelect.value = '';
        }
      }
    }

    function syncUrlState() {
      const params = new URLSearchParams(window.location.search);

      if (state.topic !== 'all') {
        params.set('topic', state.topic);
      } else {
        params.delete('topic');
      }

      if (state.source !== 'all') {
        params.set('source', state.source);
      } else {
        params.delete('source');
      }

      if (state.query !== '') {
        params.set('q', searchInput?.value.trim() || state.query);
      } else {
        params.delete('q');
      }

      if (state.theme !== '') {
        params.set('theme', state.theme);
      } else {
        params.delete('theme');
      }

      const nextUrl = params.toString()
        ? `${window.location.pathname}?${params.toString()}${window.location.hash}`
        : `${window.location.pathname}${window.location.hash}`;

      window.history.replaceState({}, '', nextUrl);
    }

    function renderArchive() {
      let visibleCount = 0;
      const visibleYears = new Set<string>();

      if (grid) {
        grid.classList.toggle('post-grid--topic-selected', state.topic !== 'all');
      }

      cards.forEach(card => {
        const cardTopic = card.getAttribute('data-cat') || '';
        const cardSource = card.getAttribute('data-source') || '';
        const cardSlug = card.getAttribute('data-slug') || '';
        const cardText = card.getAttribute('data-search-text') || '';
        const cardContent = archiveSearchIndex?.get(cardSlug) || '';

        const topicMatch = state.topic === 'all' || cardTopic === state.topic;
        const sourceMatch = state.source === 'all' || cardSource === state.source;
        const searchMatch = state.query === '' || cardText.includes(state.query) || cardContent.includes(state.query);
        const themeMatch = state.theme === '' || state.themePosts.includes(cardSlug);
        const visible = topicMatch && sourceMatch && searchMatch && themeMatch;

        card.classList.toggle('hidden', !visible);
        if (visible) {
          visibleCount += 1;
          visibleYears.add(card.getAttribute('data-year') || '');
        }
      });

      yearRules.forEach(rule => {
        rule.classList.toggle('hidden', !visibleYears.has(rule.getAttribute('data-year') || ''));
      });

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }

      if (searchClear) {
        searchClear.hidden = state.query === '';
      }

      if (clearAll) {
        clearAll.disabled = !hasActiveFilters();
      }

      syncUrlState();
    }

    function clearFilters() {
      state.topic = 'all';
      state.source = 'all';
      state.query = '';
      state.theme = '';
      state.themePosts = [];

      if (topicSelect) topicSelect.value = 'all';
      if (sourceSelect) sourceSelect.value = 'all';
      if (themeSelect) themeSelect.value = '';
      if (searchInput) searchInput.value = '';

      updateThemeVisibility();
      renderArchive();
    }

    on(topicSelect, 'change', () => {
      state.topic = topicSelect?.value || 'all';
      updateThemeVisibility();
      renderArchive();
    });

    on(sourceSelect, 'change', () => {
      state.source = sourceSelect?.value || 'all';
      renderArchive();
    });

    on(themeSelect, 'change', () => {
      const option = themeSelect?.selectedOptions[0];
      const theme = option?.value || '';
      const postsJson = option?.dataset.posts;
      state.theme = theme;
      state.themePosts = postsJson ? JSON.parse(postsJson) : [];
      renderArchive();
    });

    on(searchInput, 'input', () => {
      state.query = searchInput?.value.trim().toLowerCase() || '';
      const requestId = ++searchRequestId;
      renderArchive();

      if (state.query === '') {
        return;
      }

      void loadArchiveSearchIndex()
        .then(() => {
          if (requestId !== searchRequestId) return;
          renderArchive();
        })
        .catch(() => {});
    });

    on(searchClear, 'click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      state.query = '';
      renderArchive();
      searchInput.focus();
    });

    on(clearAll, 'click', () => {
      clearFilters();
      searchInput?.focus();
    });

    const params = new URLSearchParams(window.location.search);
    const topicParam = params.get('topic') || 'all';
    const sourceParam = params.get('source') || 'all';
    const queryParam = params.get('q') || '';
    const themeParam = params.get('theme') || '';

    if (validTopics.has(topicParam)) {
      state.topic = topicParam;
      if (topicSelect) topicSelect.value = topicParam;
    }

    if (validSources.has(sourceParam)) {
      state.source = sourceParam;
      if (sourceSelect) sourceSelect.value = sourceParam;
    }

    if (queryParam && searchInput) {
      searchInput.value = queryParam;
      state.query = queryParam.trim().toLowerCase();
    }

    updateThemeVisibility();

    if (state.topic === 'ai-environment' && validThemes.has(themeParam) && themeSelect) {
      themeSelect.value = themeParam;
      const option = themeSelect.selectedOptions[0];
      state.theme = themeParam;
      state.themePosts = option?.dataset.posts ? JSON.parse(option.dataset.posts) : [];
    }

    renderArchive();

    void loadArchiveSearchIndex()
      .then(() => {
        if (state.query !== '') {
          renderArchive();
        }
      })
      .catch(() => {});

    (window as any).__writingPageCleanup = () => {
      cleanupFns.forEach(cleanup => cleanup());
    };
  }

  initWritingPage();

  if (!(window as any).__writingPageLoadBound) {
    document.addEventListener('astro:page-load', initWritingPage);
    (window as any).__writingPageLoadBound = true;
  }
</script>
