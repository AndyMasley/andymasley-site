---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts, fetchPostContent, categoryConfigs, parseSubcategoriesFromHTML } from '@/lib/substack';
import { metaPosts, getMetaPostSlugs } from '@/lib/meta-posts';
import { bylines } from '@/lib/bylines';
import { fetchEAForumPosts } from '@/lib/eaforum';

interface TimelinePost {
  title: string;
  slug: string;
  date: Date;
  url: string;
  category: string;
  source: 'substack' | 'eaforum';
}

interface YearGroup {
  year: number;
  posts: TimelinePost[];
}

interface GuideCard {
  title: string;
  url: string;
}

const [allSubstackPosts, eaForumPosts] = await Promise.all([
  fetchSubstackPosts(),
  fetchEAForumPosts()
]);

const metaSlugs = getMetaPostSlugs();
const currentYear = new Date().getFullYear();

const substackPosts: TimelinePost[] = allSubstackPosts
  .filter(post => !metaSlugs.includes(post.slug))
  .map(post => ({
    title: post.title,
    slug: post.slug,
    date: post.date,
    url: post.url,
    category: post.category,
    source: 'substack' as const,
  }));

const eaForumTimelinePosts: TimelinePost[] = eaForumPosts.map(post => ({
  title: post.title,
  slug: post.slug,
  date: post.date,
  url: post.url,
  category: 'Charity',
  source: 'eaforum' as const,
}));

const posts: TimelinePost[] = [...substackPosts, ...eaForumTimelinePosts].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

const metaPostsWithContent = await Promise.all(
  metaPosts.map(async (meta) => {
    const content = await fetchPostContent(meta.slug);
    return { ...meta, content };
  })
);

const aiEnvMeta = metaPostsWithContent.find(meta => meta.slug === 'ai-and-the-environment');
const aiEnvSubcategories = aiEnvMeta ? parseSubcategoriesFromHTML(aiEnvMeta.content) : [];
const activeCategories = categoryConfigs.filter(config => posts.some(post => post.category === config.name));
const hasBylines = bylines.length > 0;
const bylinesPreviewCount = 5;
const archivePostsWithoutVisibleCategory = new Set<string>([]);

function getShortName(categoryName: string): string {
  const shortNames: Record<string, string> = {
    'AI & the Environment': 'AI & environment',
    'Artificial Intelligence': 'Artificial intelligence',
    'Animal Welfare': 'Animal welfare',
    'Charity': 'Effective altruism',
    'Politics': 'Politics',
    'Recs & Advice': 'Recs & advice',
    'Misc': 'Miscellaneous',
    'EA Forum': 'EA Forum',
  };
  return shortNames[categoryName] || categoryName;
}

function showArchiveCategory(post: TimelinePost): boolean {
  return !archivePostsWithoutVisibleCategory.has(post.slug);
}

function getFilterName(categoryName: string): string {
  const names: Record<string, string> = {
    'AI & the Environment': 'AI & environment',
    'Artificial Intelligence': 'Artificial intelligence',
    'Animal Welfare': 'Animal welfare',
    'Charity': 'Effective altruism',
    'Politics': 'Politics',
    'Recs & Advice': 'Recs & advice',
    'Misc': 'Miscellaneous',
  };
  return names[categoryName] || categoryName;
}

function getCategorySlug(categoryName: string): string {
  if (categoryName === 'EA Forum') return 'ea-forum';
  const config = categoryConfigs.find(category => category.name === categoryName);
  return config?.slug || categoryName.toLowerCase().replace(/\s+/g, '-');
}

function normalizeCapitalization(text: string): string {
  const words = text.split(' ');
  return words.map((word, index) => {
    if (index === 0) {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    }
    return word.toLowerCase();
  }).join(' ');
}

function formatArchiveMonth(date: Date): string {
  return date.toLocaleString('en-US', { month: 'short' });
}

function formatBylineDate(dateStr: string): string {
  const date = new Date(dateStr);
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const year = date.getFullYear();
  return `${month}.${day}.${year}`;
}

const guideCards: GuideCard[] = metaPostsWithContent.map(meta => ({
  title: meta.title,
  url: `/writing/${meta.slug}`,
}));

const yearMap = new Map<number, TimelinePost[]>();
for (const post of posts) {
  const year = post.date.getFullYear();
  if (!yearMap.has(year)) {
    yearMap.set(year, []);
  }
  yearMap.get(year)!.push(post);
}

const postsByYear: YearGroup[] = Array.from(yearMap.entries())
  .map(([year, yearPosts]) => ({
    year,
    posts: yearPosts.sort((a, b) => b.date.getTime() - a.date.getTime()),
  }))
  .sort((a, b) => b.year - a.year);

const defaultExpandedYear = postsByYear.some(group => group.year === currentYear)
  ? currentYear
  : postsByYear[0]?.year;
---

<Base title="Writing" description="Essays on AI and the environment, animal welfare, effective altruism, political liberalism, and more. Published on Substack and elsewhere." ogImage="/images/og/og-writing.png">
  <section class="writing-hero" aria-label="Writing">
    <p class="page-intro">
      I write on <a href="https://andymasley.substack.com/">Substack</a> and elsewhere about AI and the environment, AI more broadly, animal welfare, philosophy, and political liberalism. Since March 2026 I've been writing full-time on a grant from <a href="https://coefficientgiving.org/" target="_blank" rel="noopener">Coefficient Giving</a>.
    </p>
    <p class="error-bounty">
      I have a $300 bounty on errors. If you find a significant error I make in my writing, either misreading/misrepresenting a source or using a bad source where experts believe it's unreliable, and this undermines a core claim I'm making in the post, let me know at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a>.
    </p>
    <details class="bounty-rules">
      <summary>Rules for claiming</summary>
      <ul>
        <li>A legitimate source for a statistic I cite where I get the number wrong, which invalidates a core argument I'm making.</li>
        <li>A source for a number I cite that's illegitimate, and that most legitimate sources disagree with, and this updated information invalidates a core argument I'm making.</li>
        <li>All claims need to be analyzed by when I said them. If I make a claim about ChatGPT in June, and a new model comes out in December that's 100x as energy intensive, my claim in June isn't wrong, just outdated.</li>
        <li>I'm vetoing very specific disagreements of what counts as "using" water. Whether to count rainfall on crops or into lakes dammed by hydroelectric power stations turns out to be very relevant for the water debates, and reasonable people land on both extremes.</li>
        <li>If I don't cite a source in a newer post but I had cited the source for it previously, and the source is legit, that doesn't count.</li>
        <li>If the error is trivial (e.g. 0.0000102% should be 0.0000103%), that doesn't count. But if a number is off by orders of magnitude and invalidates a core claim, it does.</li>
        <li>The correction can't be something I've already spotted and noted. For example, my very first post on AI and the environment, <em>Using ChatGPT is not bad for the environment</em>, has some back of the envelope calculations that I now note are both outdated and unreliable around how much energy other services use. I note that in the post.</li>
      </ul>
    </details>
  </section>

  <div class="divider"><div class="divider-diamond"></div></div>

  <section class="writing-section writing-section--archive" id="writing-archive" aria-label="Writing archive">
    <div class="archive-controls">
      <div class="archive-control archive-control--search">
        <div class="archive-search">
          <input
            id="archive-search"
            class="archive-search__input"
            type="search"
            placeholder="Search"
            aria-label="Search blog posts"
            autocomplete="off"
          />
          <button id="archive-search-clear" class="archive-inline-action" type="button" hidden>Clear</button>
        </div>
      </div>

      <div class="archive-control-grid">
        <div class="archive-control">
          <select id="archive-topic" class="archive-select" aria-label="Topic">
            <option value="all">All topics</option>
            {activeCategories.map(topic => (
              <option value={topic.slug}>{getFilterName(topic.name)}</option>
            ))}
          </select>
        </div>

        <div class="archive-control">
          <select id="archive-source" class="archive-select" aria-label="Source">
            <option value="all">All sources</option>
            <option value="substack">Substack</option>
            {eaForumTimelinePosts.length > 0 && (
              <option value="eaforum">EA Forum</option>
            )}
          </select>
        </div>

        <div class="archive-control" id="archive-theme-wrap" hidden>
          <select id="archive-theme" class="archive-select" aria-label="AI and environment theme">
            <option value="">All themes</option>
            {aiEnvSubcategories.map(theme => (
              <option value={theme.slug} data-posts={JSON.stringify(theme.postSlugs)}>
                {normalizeCapitalization(theme.name)}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="archive-toolbar">
        <button class="archive-inline-action" id="archive-clear" type="button" disabled>Clear filters</button>
      </div>
    </div>

    <p class="archive-empty" id="archive-empty" hidden>No posts match the current filters.</p>

    <div class="timeline" data-default-year={defaultExpandedYear ?? ''}>
      {postsByYear.map(yearGroup => (
        <details
          class="year-group"
          data-year={yearGroup.year}
          data-total-count={yearGroup.posts.length}
          open={yearGroup.year === defaultExpandedYear}
        >
          <summary class="year-summary">
            <span class="year-label">{yearGroup.year}</span>
            <span class="year-count">{yearGroup.posts.length} {yearGroup.posts.length === 1 ? 'post' : 'posts'}</span>
          </summary>

          <ul class="year-posts">
            {yearGroup.posts.map(post => (
              <li
                class="timeline-row"
                data-cat={getCategorySlug(post.category)}
                data-source={post.source}
                data-slug={post.slug}
                data-search-text={post.title.toLowerCase()}
              >
                <time class="timeline-date" datetime={post.date.toISOString()}>
                  <span class="timeline-month">{formatArchiveMonth(post.date)}</span>
                  <span class="timeline-day">{post.date.getDate()}</span>
                </time>

                <div class="timeline-main">
                  <a href={`/writing/${post.slug}`} class="timeline-link">{post.title}</a>
                  <p class="timeline-meta">
                    {showArchiveCategory(post) && (
                      <>
                        <span class="timeline-cat">{getShortName(post.category)}</span>
                        <span class="timeline-separator" aria-hidden="true">·</span>
                      </>
                    )}
                    <span class="timeline-source">{post.source === 'substack' ? 'Substack' : 'EA Forum'}</span>
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  {guideCards.length > 0 && (
    <section class="writing-section writing-section--guides" aria-label="Guides">
      <div class="guide-links">
        <ul class="guide-list">
          {guideCards.map(guide => (
            <li class="guide-list__item">
              <a href={guide.url} class="guide-link">{guide.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hasBylines && (
    <section class="writing-section writing-section--elsewhere" aria-labelledby="elsewhere-heading">
      <header class="writing-section__header">
        <div>
          <h2 class="writing-section__title" id="elsewhere-heading">Elsewhere</h2>
          <p class="writing-section__description">Writing published outside the main blog archive.</p>
        </div>
      </header>

      <div class="bylines-list">
        {bylines.slice(0, bylinesPreviewCount).map(byline => (
          <article class="byline-row">
            <span class="byline-date">{formatBylineDate(byline.date)}</span>
            <a href={byline.url} target="_blank" rel="noopener" class="byline-link">
              {byline.title}
            </a>
            <span class="byline-pub">{byline.publication}</span>
          </article>
        ))}
      </div>

      {bylines.length > bylinesPreviewCount && (
        <details class="bylines-details">
          <summary class="bylines-details__summary">Show all bylines</summary>
          <div class="bylines-list bylines-list--extra">
            {bylines.slice(bylinesPreviewCount).map(byline => (
              <article class="byline-row">
                <span class="byline-date">{formatBylineDate(byline.date)}</span>
                <a href={byline.url} target="_blank" rel="noopener" class="byline-link">
                  {byline.title}
                </a>
                <span class="byline-pub">{byline.publication}</span>
              </article>
            ))}
          </div>
        </details>
      )}
    </section>
  )}
</Base>

<style>
  .writing-hero {
    margin-bottom: 2.4rem;
  }

  .page-intro {
    max-width: 42rem;
  }

  .error-bounty {
    max-width: 42rem;
    margin-top: 0.6rem;
    margin-bottom: 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .bounty-rules {
    max-width: 42rem;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .bounty-rules summary {
    cursor: pointer;
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .bounty-rules summary:hover {
    color: var(--accent);
  }

  .bounty-rules ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }

  .bounty-rules li {
    margin-bottom: 0.35rem;
  }

  .writing-section {
    margin-bottom: 2.75rem;
  }

  .writing-section__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 0.95rem;
  }

  .writing-section__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.24rem, 1.14rem + 0.28vw, 1.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .writing-section__description {
    max-width: 42rem;
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .writing-section--elsewhere {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .archive-controls {
    display: grid;
    gap: 0.95rem;
    margin-bottom: 1rem;
    padding: 0.2rem 0 0.1rem;
  }

  .archive-control {
    display: grid;
    gap: 0.35rem;
  }

  .archive-control-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .archive-control-grid.archive-control-grid--with-theme {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .archive-control__label {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .archive-search {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .archive-search__input,
  .archive-select {
    width: 100%;
    min-width: 0;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background-color: transparent;
    color: var(--text);
    font: inherit;
  }

  .archive-search__input {
    padding: 0.7rem 0.05rem 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.05rem;
  }

  .archive-search__input::placeholder {
    color: var(--dim);
  }

  .archive-control[hidden] {
    display: none !important;
  }

