  .guide-link:focus-visible,
  .byline-link:focus-visible,
  .archive-inline-action:focus-visible,
  .timeline-link:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .writing-section__header {
      flex-direction: column;
      align-items: start;
    }

    .archive-control-grid {
      grid-template-columns: 1fr;
    }

    .archive-search {
      flex-direction: column;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .byline-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .timeline-row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 0.45rem 0.9rem;
    }

    .timeline-meta {
      gap: 0.25rem 0.4rem;
    }
  }
</style>

<script>
  function initWritingPage() {
    const previousCleanup = (window as any).__writingPageCleanup;
    if (typeof previousCleanup === 'function') {
      previousCleanup();
    }

    const cleanupFns: Array<() => void> = [];

    function on(
      target: EventTarget | null | undefined,
      type: string,
      handler: EventListenerOrEventListenerObject,
      options?: boolean | AddEventListenerOptions
    ) {
      if (!target) return;
      target.addEventListener(type, handler, options);
      cleanupFns.push(() => target.removeEventListener(type, handler, options));
    }

    const topicSelect = document.getElementById('archive-topic') as HTMLSelectElement | null;
    const controlGrid = document.querySelector('.archive-control-grid') as HTMLElement | null;
    const themeWrap = document.getElementById('archive-theme-wrap') as HTMLElement | null;
    const themeSelect = document.getElementById('archive-theme') as HTMLSelectElement | null;
    const sourceSelect = document.getElementById('archive-source') as HTMLSelectElement | null;
    const searchInput = document.getElementById('archive-search') as HTMLInputElement | null;
    const searchClear = document.getElementById('archive-search-clear') as HTMLButtonElement | null;
    const clearAll = document.getElementById('archive-clear') as HTMLButtonElement | null;
    const emptyState = document.getElementById('archive-empty') as HTMLElement | null;
    const timeline = document.querySelector('.timeline') as HTMLElement | null;
    const yearGroups = Array.from(document.querySelectorAll('.year-group')) as HTMLDetailsElement[];
    const timelineRows = Array.from(document.querySelectorAll('.timeline-row')) as HTMLElement[];

    const defaultYear = timeline?.getAttribute('data-default-year') || '';

    const state = {
      topic: 'all',
      source: 'all',
      query: '',
      theme: '',
      themePosts: [] as string[],
    };

    let archiveSearchIndex: Map<string, string> | null = null;
    let archiveSearchIndexPromise: Promise<Map<string, string>> | null = null;
    let searchRequestId = 0;

    const validTopics = new Set(
      topicSelect ? Array.from(topicSelect.options).map(option => option.value) : []
    );
    const validSources = new Set(
      sourceSelect ? Array.from(sourceSelect.options).map(option => option.value) : []
    );
    const validThemes = new Set(
      themeSelect ? Array.from(themeSelect.options).map(option => option.value).filter(Boolean) : []
    );

    function countLabel(count: number, noun: string) {
      return `${count} ${noun}${count === 1 ? '' : 's'}`;
    }

    function getWritingSlug(url: string) {
      const match = url.match(/^\/writing\/([^/?#]+)/);
      return match ? decodeURIComponent(match[1]) : '';
    }

    async function loadArchiveSearchIndex() {
      if (archiveSearchIndex) {
        return archiveSearchIndex;
      }

      if (!archiveSearchIndexPromise) {
        archiveSearchIndexPromise = fetch('/search.json')
          .then(async response => {
            if (!response.ok) {
              throw new Error(`Search index request failed with ${response.status}`);
            }
            return response.json();
          })
          .then(entries => {
            const nextIndex = new Map<string, string>();

            if (Array.isArray(entries)) {
              entries.forEach(entry => {
                if (!entry || typeof entry.url !== 'string') return;

                const slug = getWritingSlug(entry.url);
                if (!slug) return;

                const searchableText = [
                  entry.description,
                  entry.headers,
                  entry.content,
                ]
                  .filter(value => typeof value === 'string' && value.length > 0)
                  .join(' ')
                  .toLowerCase();

                if (searchableText) {
                  nextIndex.set(slug, searchableText);
                }
              });
            }

            archiveSearchIndex = nextIndex;
            return nextIndex;
          })
          .catch(error => {
            console.error('Failed to load archive search index:', error);
            archiveSearchIndexPromise = null;
            throw error;
          });
      }

      return archiveSearchIndexPromise;
    }

    function hasActiveFilters() {
      return state.topic !== 'all' || state.source !== 'all' || state.query !== '' || state.theme !== '';
    }

    function restoreDefaultYears() {
      yearGroups.forEach(group => {
        group.open = group.getAttribute('data-year') === defaultYear;
      });
    }

    function expandVisibleYears() {
      yearGroups.forEach(group => {
        if (!group.classList.contains('hidden')) {
          group.open = true;
        }
      });
    }

    function collapseVisibleYears() {
      yearGroups.forEach(group => {
        if (!group.classList.contains('hidden')) {
          group.open = false;
        }
      });
    }

    function updateThemeVisibility() {
      const show = state.topic === 'ai-environment' && Boolean(themeSelect) && themeSelect.options.length > 1;

      if (controlGrid) {
        controlGrid.classList.toggle('archive-control-grid--with-theme', show);
      }

      if (themeWrap) {
        themeWrap.hidden = !show;
      }

      if (!show) {
        state.theme = '';
        state.themePosts = [];
        if (themeSelect) {
          themeSelect.value = '';
        }
      }
    }

    function syncUrlState() {
      const params = new URLSearchParams(window.location.search);

      if (state.topic !== 'all') {
        params.set('topic', state.topic);
      } else {
        params.delete('topic');
      }

      if (state.source !== 'all') {
        params.set('source', state.source);
      } else {
        params.delete('source');
      }

      if (state.query !== '') {
        params.set('q', searchInput?.value.trim() || state.query);
      } else {
        params.delete('q');
      }

      if (state.theme !== '') {
        params.set('theme', state.theme);
      } else {
        params.delete('theme');
      }

      const nextUrl = params.toString()
        ? `${window.location.pathname}?${params.toString()}${window.location.hash}`
        : `${window.location.pathname}${window.location.hash}`;

      window.history.replaceState({}, '', nextUrl);
    }

    function updateYearCount(group: HTMLDetailsElement, visibleCount: number) {
      const countEl = group.querySelector('.year-count') as HTMLElement | null;
      const totalCount = Number(group.getAttribute('data-total-count') || '0');
      if (!countEl) return;

      if (visibleCount === totalCount || !hasActiveFilters()) {
        countEl.textContent = countLabel(totalCount, 'post');
        return;
      }

      countEl.textContent = countLabel(visibleCount, 'matching post');
    }

    function renderArchive() {
      let visibleCount = 0;

      if (timeline) {
        timeline.classList.toggle('timeline--topic-selected', state.topic !== 'all');
      }

      timelineRows.forEach(row => {
        const rowTopic = row.getAttribute('data-cat') || '';
        const rowSource = row.getAttribute('data-source') || '';
        const rowSlug = row.getAttribute('data-slug') || '';
        const rowText = row.getAttribute('data-search-text') || '';
        const rowContent = archiveSearchIndex?.get(rowSlug) || '';

        const topicMatch = state.topic === 'all' || rowTopic === state.topic;
        const sourceMatch = state.source === 'all' || rowSource === state.source;
        const searchMatch = state.query === '' || rowText.includes(state.query) || rowContent.includes(state.query);
        const themeMatch = state.theme === '' || state.themePosts.includes(rowSlug);
        const visible = topicMatch && sourceMatch && searchMatch && themeMatch;

        row.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      yearGroups.forEach(group => {
        const visibleRows = group.querySelectorAll('.timeline-row:not(.hidden)').length;
        group.classList.toggle('hidden', visibleRows === 0);
        updateYearCount(group, visibleRows);
      });

      if (hasActiveFilters()) {
        expandVisibleYears();
      } else {
        restoreDefaultYears();
      }

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }

      if (searchClear) {
        searchClear.hidden = state.query === '';
      }

      if (clearAll) {
        clearAll.disabled = !hasActiveFilters();
      }

      syncUrlState();
    }

    function clearFilters() {
      state.topic = 'all';
      state.source = 'all';
      state.query = '';
      state.theme = '';
      state.themePosts = [];

      if (topicSelect) topicSelect.value = 'all';
      if (sourceSelect) sourceSelect.value = 'all';
      if (themeSelect) themeSelect.value = '';
      if (searchInput) searchInput.value = '';

      updateThemeVisibility();
      renderArchive();
    }

    on(topicSelect, 'change', () => {
      state.topic = topicSelect?.value || 'all';
      updateThemeVisibility();
      renderArchive();
    });

    on(sourceSelect, 'change', () => {
      state.source = sourceSelect?.value || 'all';
      renderArchive();
    });

    on(themeSelect, 'change', () => {
      const option = themeSelect?.selectedOptions[0];
      const theme = option?.value || '';
      const postsJson = option?.dataset.posts;
      state.theme = theme;
      state.themePosts = postsJson ? JSON.parse(postsJson) : [];
      renderArchive();
    });

    on(searchInput, 'input', () => {
      state.query = searchInput?.value.trim().toLowerCase() || '';
      const requestId = ++searchRequestId;
      renderArchive();

      if (state.query === '') {
        return;
      }

      void loadArchiveSearchIndex()
        .then(() => {
          if (requestId !== searchRequestId) return;
          renderArchive();
        })
        .catch(() => {});
    });

    on(searchClear, 'click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      state.query = '';
      renderArchive();
      searchInput.focus();
    });

    on(clearAll, 'click', () => {
      clearFilters();
      searchInput?.focus();
    });

    const params = new URLSearchParams(window.location.search);
    const topicParam = params.get('topic') || 'all';
    const sourceParam = params.get('source') || 'all';
    const queryParam = params.get('q') || '';
    const themeParam = params.get('theme') || '';

    if (validTopics.has(topicParam)) {
      state.topic = topicParam;
      if (topicSelect) topicSelect.value = topicParam;
    }

    if (validSources.has(sourceParam)) {
      state.source = sourceParam;
      if (sourceSelect) sourceSelect.value = sourceParam;
    }

    if (queryParam && searchInput) {
      searchInput.value = queryParam;
      state.query = queryParam.trim().toLowerCase();
    }

    updateThemeVisibility();

    if (state.topic === 'ai-environment' && validThemes.has(themeParam) && themeSelect) {
      themeSelect.value = themeParam;
      const option = themeSelect.selectedOptions[0];
      state.theme = themeParam;
      state.themePosts = option?.dataset.posts ? JSON.parse(option.dataset.posts) : [];
    }

    restoreDefaultYears();
    renderArchive();

    void loadArchiveSearchIndex()
      .then(() => {
        if (state.query !== '') {
          renderArchive();
        }
      })
      .catch(() => {});

    (window as any).__writingPageCleanup = () => {
      cleanupFns.forEach(cleanup => cleanup());
    };
  }

  initWritingPage();

  if (!(window as any).__writingPageLoadBound) {
    document.addEventListener('astro:page-load', initWritingPage);
    (window as any).__writingPageLoadBound = true;
  }
</script>
