    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .byline-date,
  .byline-pub {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--dim);
  }

  .byline-pub {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .byline-link {
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: 1rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .byline-link:hover {
    color: var(--accent);
  }

  .bylines-details {
    margin-top: 0.9rem;
  }

  .bylines-details__summary {
    cursor: pointer;
    font-size: 0.72rem;
