---
import Base from '@/layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatPostDate as formatDate } from '@/lib/format-date';

export async function getStaticPaths() {
  const items = await getCollection('notes');
  return items.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'notes'>;
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<Base
  title={item.data.title}
  description={item.data.description}
  ogType="article"
>
  <meta slot="head" property="article:published_time" content={item.data.date.toISOString()} />
  <meta slot="head" property="article:author" content="Andy Masley" />
  <article class="container container--narrow">

    <header class="note-header animate-in">
      <div class="note-header__top">
        {item.data.category && (
          <span class="note-header__category">{item.data.category}</span>
        )}
        <span class="note-header__date">{formatDate(item.data.date)}</span>
      </div>
      <h1 class="note-header__title">{item.data.title}</h1>
    </header>

    <div class="prose animate-in">
      <Content />
    </div>
    
    <footer class="article-footer">
      {item.data.updated && (
        <p class="meta-note">Last updated {formatDate(item.data.updated)}</p>
      )}
      
      <nav class="article-nav">
        <a href="/notes" class="article-nav__link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Back to notes
        </a>
      </nav>
    </footer>
  </article>
</Base>

<style>
  .note-header {
    margin-bottom: var(--space-3xl);
  }
  
  .note-header__top {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  
  .note-header__category {
    font-size: var(--font-size-mono);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--accent);
    background: none;
    padding: 0 0 2px;
    border-bottom: 1px solid var(--accent);
    border-radius: 0;
  }

  .note-header__date {
    font-size: var(--font-size-mono);
    font-family: var(--font-label);
    color: var(--dim);
  }

  .note-header__title {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 var(--space-lg) 0;
  }

  .article-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border);
  }

  .meta-note {
    font-size: var(--font-size-mono);
    font-family: var(--font-label);
    color: var(--dim);
    margin-bottom: var(--space-xl);
  }

  .article-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-small);
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0;
    margin-left: 0;
    border-radius: 0;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  
  .article-nav__link:hover {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
