---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatPostDate } from '@/lib/format-date';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const items = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Notes" description="Shorter notes, ideas, and references" ogImage="/og/page/notes.png?v=4">
  <p class="page-intro">
    Fragments, references, things I'm thinking about.
  </p>

  <ul class="notes-list">
    {items.map(item => (
      <li class="notes-item">
        <a href={`/notes/${item.slug}`} class="notes-item__link">{item.data.title}</a>
        <span class="notes-item__date">{formatPostDate(item.data.date)}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .notes-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .notes-item {
    margin: 0 0 0.75rem;
  }

  .notes-item__link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-strong);
  }

  .notes-item__link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .notes-item__link:visited { color: #5b3a7a; }
  :global([data-theme="dark"]) .notes-item__link:visited { color: #b9a3d9; }

  .notes-item__date {
    margin-left: 0.6rem;
    font-size: var(--text-sm);
    color: var(--dim);
  }
</style>
