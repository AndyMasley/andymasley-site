  <script type="module">
    try {
    const { THREE, EffectComposer, RenderPass, UnrealBloomPass, ShaderPass, OutputPass, Reflector,
      enrichLibrary, loadLibraryMaterials, buildLibraryDepth, BookMotion, canStand, slideMove, damp, qualityStep, localMovement } = await window.libraryReady;

    // ==================================================================
    //  AUDIO  — everything synthesized, no external files
    // ==================================================================
    let audioCtx = null;
    let masterGain = null, dryGain = null, reverbSend = null, ambientBus = null;
    let ambientStarted = false;
    let currentReverbWet = 0.22, targetReverbWet = 0.22;

    function getAudioContext() {
      if (!audioCtx) initAudioGraph();
      return audioCtx;
    }

    function initAudioGraph() {
      if (audioCtx) return;
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();

      masterGain = audioCtx.createGain();
      masterGain.gain.value = document.getElementById('room-sound').checked ? 0.65 : 0;
      masterGain.connect(audioCtx.destination);

      dryGain = audioCtx.createGain();
      dryGain.gain.value = 1.0;
      dryGain.connect(masterGain);

      // Convolution reverb — procedurally generated stone-hall impulse
      const convolver = audioCtx.createConvolver();
      const len = Math.floor(audioCtx.sampleRate * 2.6);
      const ir = audioCtx.createBuffer(2, len, audioCtx.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        const d = ir.getChannelData(ch);
        for (let i = 0; i < len; i++) {
          const t = i / len;
          // exponential decay + progressive HF rolloff via smoothing
          const env = Math.pow(1 - t, 2.6);
          let s = (Math.random() * 2 - 1) * env;
          if (i > 0) s = s * 0.6 + d[i - 1] * 0.4 * (0.3 + 0.7 * t); // darker tail
          d[i] = s;
        }
      }
      convolver.buffer = ir;

      const wetGain = audioCtx.createGain();
      wetGain.gain.value = 0.9;
      reverbSend = audioCtx.createGain();
      reverbSend.gain.value = currentReverbWet;
      reverbSend.connect(convolver);
      convolver.connect(wetGain);
      wetGain.connect(masterGain);

      ambientBus = audioCtx.createGain();
      ambientBus.gain.value = 0.0; // fade in later
      ambientBus.connect(dryGain);
      ambientBus.connect(reverbSend);
    }

    // route a node to dry + reverb send
    function routeWet(node, wetAmount = 1.0) {
      node.connect(dryGain);
      if (reverbSend) {
        const s = audioCtx.createGain();
        s.gain.value = wetAmount;
        node.connect(s);
        s.connect(reverbSend);
      }
    }

    function startAmbient() {
      if (ambientStarted) return;
      ambientStarted = true;
      initAudioGraph();
      const ctx = audioCtx, now = ctx.currentTime;

      // fade the ambient bus in over 4s
      ambientBus.gain.setValueAtTime(0.0001, now);
      ambientBus.gain.exponentialRampToValueAtTime(1.0, now + 4);

      // (a) air — brown noise through a low lowpass
      const airBuf = ctx.createBuffer(1, ctx.sampleRate * 4, ctx.sampleRate);
      const ad = airBuf.getChannelData(0);
      let last = 0;
      for (let i = 0; i < ad.length; i++) {
        const white = Math.random() * 2 - 1;
        last = (last + 0.02 * white) / 1.02;
        ad[i] = last * 3.0;
      }
      const air = ctx.createBufferSource();
      air.buffer = airBuf; air.loop = true;
      const airFilt = ctx.createBiquadFilter();
      airFilt.type = 'lowpass'; airFilt.frequency.value = 220;
      const airGain = ctx.createGain(); airGain.gain.value = 0.05;
      const shaftAir = ctx.createPanner();
      shaftAir.panningModel = 'HRTF'; shaftAir.distanceModel = 'inverse';
      shaftAir.refDistance = 2; shaftAir.rolloffFactor = 0.45;
      shaftAir.positionX.value = 0; shaftAir.positionY.value = -3; shaftAir.positionZ.value = 0;
      air.connect(airFilt); airFilt.connect(airGain); airGain.connect(shaftAir); shaftAir.connect(ambientBus);
      air.start();

      // (b) drone — two detuned sines with a slow gain LFO
      [55, 82.5].forEach((f, i) => {
        const osc = ctx.createOscillator();
        osc.type = i === 0 ? 'sine' : 'triangle';
        osc.frequency.value = f;
        const dg = ctx.createGain(); dg.gain.value = 0.028;
        const lfo = ctx.createOscillator(); lfo.frequency.value = 0.05 + i * 0.017;
        const lfoGain = ctx.createGain(); lfoGain.gain.value = 0.014;
        lfo.connect(lfoGain); lfoGain.connect(dg.gain);
        const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 300;
        osc.connect(lp); lp.connect(dg); dg.connect(ambientBus);
        osc.start(); lfo.start();
      });

      scheduleDistantEvent();
    }

    function scheduleDistantEvent() {
      if (!audioCtx) return;
      const delay = 20000 + Math.random() * 25000;
      setTimeout(() => {
        if (ambientStarted && !document.hidden && audioCtx.state === "running") playDistantEvent();
        scheduleDistantEvent();
      }, delay);
    }

    // a far-off creak / closing book, sent mostly through reverb
    function playDistantEvent() {
      const ctx = audioCtx, now = ctx.currentTime;
      if (Math.random() < 0.5) {
        // wooden creak — sawtooth pitch bend
        const osc = ctx.createOscillator();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(95, now);
        osc.frequency.exponentialRampToValueAtTime(68, now + 0.45);
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.0001, now);
        g.gain.linearRampToValueAtTime(0.05, now + 0.06);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.5);
        const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 500;
        osc.connect(lp); lp.connect(g);
        routeWet(g, 1.4);
        osc.start(now); osc.stop(now + 0.55);
      } else {
        // distant page rustle / closing book — filtered noise burst
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.35, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 2);
        const src = ctx.createBufferSource(); src.buffer = buf;
        const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1800; bp.Q.value = 0.6;
        const g = ctx.createGain(); g.gain.value = 0.06;
        src.connect(bp); bp.connect(g);
        routeWet(g, 1.6);
        src.start();
      }
    }

    function setReverbTarget(v) { targetReverbWet = v; }
    function updateReverb(dt) {
      if (!reverbSend) return;
      currentReverbWet = damp(currentReverbWet, targetReverbWet, 3, dt);
      reverbSend.gain.value = currentReverbWet;
    }

    function duckAmbient(amount) {
      if (!ambientBus || !audioCtx) return;
      ambientBus.gain.cancelScheduledValues(audioCtx.currentTime);
      ambientBus.gain.setTargetAtTime(amount, audioCtx.currentTime, 0.15);
    }

    // Footsteps — two-layer heel/toe on stone
    let footstepPan = 1;
    function playFootstep() {
      const ctx = getAudioContext();
      const now = ctx.currentTime;
      footstepPan *= -1;
      const panner = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
      if (panner) panner.pan.value = 0.15 * footstepPan;

      // heel thump
      const osc = ctx.createOscillator();
      osc.type = 'sine';
      const pitch = 55 * (1 + (Math.random() - 0.5) * 0.16);
      osc.frequency.setValueAtTime(pitch * 1.6, now);
      osc.frequency.exponentialRampToValueAtTime(pitch, now + 0.06);
      const og = ctx.createGain();
      og.gain.setValueAtTime(0.16, now);
      og.gain.exponentialRampToValueAtTime(0.001, now + 0.11);

      // toe scuff — bandpassed noise
      const nb = ctx.createBuffer(1, ctx.sampleRate * 0.09, ctx.sampleRate);
      const nd = nb.getChannelData(0);
      for (let i = 0; i < nd.length; i++) nd[i] = (Math.random() * 2 - 1) * (1 - i / nd.length);
      const nsrc = ctx.createBufferSource(); nsrc.buffer = nb;
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass'; bp.frequency.value = 700 * (1 + (Math.random() - 0.5) * 0.3); bp.Q.value = 1.4;
      const ng = ctx.createGain(); ng.gain.value = 0.09;

      const out = ctx.createGain(); out.gain.value = 1;
      osc.connect(og); og.connect(out);
      nsrc.connect(bp); bp.connect(ng); ng.connect(out);
      if (panner) { out.connect(panner); routeWet(panner, 0.25); } else { routeWet(out, 0.25); }

      osc.start(now); osc.stop(now + 0.12);
      nsrc.start(now + 0.012);
    }

    // Page turn — papery swoosh
    function playPageTurn() {
      const ctx = getAudioContext();
      const bufferSize = ctx.sampleRate * 0.4;
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        const t = i / bufferSize;
        data[i] = (Math.random() * 2 - 1) * Math.sin(t * Math.PI) * 0.3 * (1 - t * 0.5);
      }
      const source = ctx.createBufferSource(); source.buffer = buffer;
      const filter = ctx.createBiquadFilter(); filter.type = 'bandpass'; filter.frequency.value = 3000; filter.Q.value = 0.5;
      const gain = ctx.createGain(); gain.gain.value = 0.09;
      source.connect(filter); filter.connect(gain);
      routeWet(gain, 0.5);
      source.start();
    }

    // Book close — soft thud
    function playBookClose() {
      const ctx = getAudioContext();
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(80, now);
      osc.frequency.linearRampToValueAtTime(40, now + 0.15);
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0.3, now);
      gain.gain.linearRampToValueAtTime(0.001, now + 0.15);
      osc.connect(gain);
      routeWet(gain, 0.4);
      osc.start(now); osc.stop(now + 0.15);

      const bufferSize = ctx.sampleRate * 0.1;
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize) * 0.15;
      const ns = ctx.createBufferSource(); ns.buffer = buffer;
      const nf = ctx.createBiquadFilter(); nf.type = 'lowpass'; nf.frequency.value = 500;
      const ng = ctx.createGain(); ng.gain.value = 0.2;
      ns.connect(nf); nf.connect(ng);
      routeWet(ng, 0.4);
      ns.start();
    }

    // Book pull-out — friction + soft wood tap
    function playBookPull() {
      const ctx = getAudioContext();
      const now = ctx.currentTime;
      const nb = ctx.createBuffer(1, ctx.sampleRate * 0.2, ctx.sampleRate);
      const nd = nb.getChannelData(0);
      for (let i = 0; i < nd.length; i++) nd[i] = (Math.random() * 2 - 1) * Math.sin((i / nd.length) * Math.PI) * 0.5;
      const src = ctx.createBufferSource(); src.buffer = nb;
      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1200; bp.Q.value = 0.8;
      const g = ctx.createGain(); g.gain.value = 0.05;
      src.connect(bp); bp.connect(g);
      routeWet(g, 0.3);
      src.start();
    }

    // Hover tick — near-silent tactility
    function playHoverTick() {
      const ctx = getAudioContext();
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      osc.type = 'square'; osc.frequency.value = 2000;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.02, now);
      g.gain.exponentialRampToValueAtTime(0.0005, now + 0.02);
      const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1500;
      osc.connect(hp); hp.connect(g); g.connect(dryGain || ctx.destination);
      osc.start(now); osc.stop(now + 0.03);
    }

    // Shrine open — deep page + pad swell
    function playShrineOpen() {
      const ctx = getAudioContext();
      const now = ctx.currentTime;
      playPageTurn();
      [110, 165, 220].forEach((f) => {
        const osc = ctx.createOscillator();
        osc.type = 'sine'; osc.frequency.value = f;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.0001, now);
        g.gain.linearRampToValueAtTime(0.04, now + 1.2);
        g.gain.linearRampToValueAtTime(0.0001, now + 2.6);
        osc.connect(g);
        routeWet(g, 0.8);
        osc.start(now); osc.stop(now + 2.7);
      });
    }

    // --- SEEDED RANDOM (for consistent book generation) ---
    let seed = 42;
    function seededRandom() {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      return seed / 0x7fffffff;
    }
    function resetSeed(s) { seed = s; }

    // --- BORGES QUOTES (242 total) ---
    const borgesQuotes = [
      // Original Library-themed quotes
