---
import '@/styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="The Hexagon Archive">
  <title>room</title>
  <!-- Immediate dark background to prevent flash -->
  <style>html, body { background: #0a0806; }</style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      overflow: hidden;
      background-color: #0a0806;
      font-family: 'Source Serif 4', Georgia, serif;
      cursor: none;
    }

    canvas { display: block; }

    #crosshair {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 50;
    }

    #crosshair::before {
      content: '';
      display: block;
      width: 4px;
      height: 4px;
      background: #c9a87c;
      transition: all 0.15s ease;
    }

    #crosshair.hovering::before {
      width: 8px;
      height: 8px;
      background: #e8d5b5;
    }

    #object-label {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, 24px);
      color: #c9a87c;
      font-size: 0.8rem;
      font-style: italic;
      pointer-events: none;
      z-index: 50;
      opacity: 0;
      transition: opacity 0.2s ease;
      text-align: center;
      white-space: nowrap;
    }

    #object-label.visible {
      opacity: 1;
    }

    #controls-hint {
      position: fixed;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      color: #c9a87c;
      font-family: 'SF Mono', SFMono-Regular, Menlo, monospace;
      font-size: 0.65rem;
      pointer-events: none;
      text-align: center;
      letter-spacing: 0.05em;
      opacity: 0.6;
    }

    #start-prompt {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(10, 8, 6, 0.95);
      z-index: 250;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      cursor: auto;
    }

    #start-prompt.visible {
      opacity: 1;
      visibility: visible;
    }

    #start-prompt .prompt-text {
      color: #c9a87c;
      font-size: 1rem;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    #start-prompt .prompt-text:hover {
      color: #e8d5b5;
    }

    #start-prompt .prompt-instructions {
      color: #c9a87c;
      font-family: 'SF Mono', SFMono-Regular, Menlo, monospace;
      font-size: 0.65rem;
      text-align: center;
      opacity: 0.6;
      margin-bottom: 2rem;
    }

    #start-prompt .prompt-home {
      color: #c9a87c;
      font-family: 'SF Mono', SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #start-prompt .prompt-home:hover {
      color: #e8d5b5;
    }

    #reading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: #0a0806;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      cursor: auto;
    }

    #reading-overlay.visible {
      opacity: 1;
      visibility: visible;
    }

    #reading-content {
      max-width: 520px;
      max-height: 75vh;
      padding: 2.5rem;
      color: #c9a87c;
      overflow-y: auto;
      position: relative;
      border: 1px solid #c9a87c;
    }

    #reading-content .quote-text {
      font-size: 1.15rem;
      line-height: 1.85;
      color: #c9a87c;
      margin-bottom: 1.5rem;
      font-style: italic;
    }

    #reading-content .quote-source {
      font-size: 0.85rem;
      color: #c9a87c;
      opacity: 0.7;
      text-align: right;
    }

    #reading-content .close-hint {
      display: block;
      margin-top: 2rem;
      color: #c9a87c;
      font-family: 'SF Mono', SFMono-Regular, Menlo, monospace;
      font-size: 0.65rem;
      text-align: center;
      opacity: 0.6;
    }

    #eye-opening {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 300;
      pointer-events: none;
    }

    #eye-opening.hidden {
      display: none;
    }

    #eyelid-top, #eyelid-bottom {
      position: absolute;
      left: 0;
      right: 0;
      height: 50%;
      background: #0a0806;
    }

    #eyelid-top {
      top: 0;
      transform-origin: top center;
      animation: eyelidOpenTop 1.8s ease-out forwards;
    }

    #eyelid-bottom {
      bottom: 0;
      transform-origin: bottom center;
      animation: eyelidOpenBottom 1.8s ease-out forwards;
    }

    @keyframes eyelidOpenTop {
      0% { transform: scaleY(1); }
      100% { transform: scaleY(0); }
    }

    @keyframes eyelidOpenBottom {
      0% { transform: scaleY(1); }
      100% { transform: scaleY(0); }
    }
  </style>
</head>
<body>
  <div id="eye-opening">
    <div id="eyelid-top"></div>
    <div id="eyelid-bottom"></div>
  </div>


  <div id="crosshair"></div>
  <div id="object-label"></div>
  <div id="controls-hint">WASD/arrows move · mouse look · click to read · ESC menu</div>

  <div id="start-prompt">
    <div class="prompt-text" id="start-button">Click to continue</div>
    <div class="prompt-instructions">WASD/arrows move · mouse look · click to read</div>
    <a href="/" class="prompt-home">← Return to main website</a>
  </div>

  <div id="reading-overlay">
    <div id="reading-content">
      <div id="reading-text"></div>
      <span class="close-hint">click anywhere or press ESC to close</span>
    </div>
  </div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';

    // --- COLORS ---
    const DARK = 0x0a0806;
    const LIGHT = 0xc9a87c;

    // --- AUDIO ---
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      return audioCtx;
    }

    // Footstep sound - soft tap
    let lastFootstep = 0;
    function playFootstep() {
      const now = Date.now();
      if (now - lastFootstep < 350) return; // limit frequency
      lastFootstep = now;

      const ctx = getAudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const filter = ctx.createBiquadFilter();

      filter.type = 'lowpass';
      filter.frequency.value = 150 + Math.random() * 100;

      osc.type = 'sine';
      osc.frequency.value = 60 + Math.random() * 40;

      gain.gain.setValueAtTime(0.15, ctx.currentTime);
      gain.gain.exponentialDecayTo && gain.gain.exponentialDecayTo(0.01, ctx.currentTime + 0.1);
      gain.gain.setValueAtTime(0.15, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.08);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);

      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.1);
    }

    // Page turn sound - papery swoosh
    function playPageTurn() {
      const ctx = getAudioContext();
      const bufferSize = ctx.sampleRate * 0.4;
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);

      for (let i = 0; i < bufferSize; i++) {
        const t = i / bufferSize;
        // Noise with envelope
        data[i] = (Math.random() * 2 - 1) * Math.sin(t * Math.PI) * 0.3 * (1 - t * 0.5);
      }

      const source = ctx.createBufferSource();
      source.buffer = buffer;

      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = 3000;
      filter.Q.value = 0.5;

      const gain = ctx.createGain();
      gain.gain.value = 0.08;

      source.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      source.start();
    }

    // Book close sound - soft thud
    function playBookClose() {
      const ctx = getAudioContext();

      // Low thump
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(80, ctx.currentTime);
      osc.frequency.linearRampToValueAtTime(40, ctx.currentTime + 0.15);

      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.15);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.15);

      // Add noise component
      const bufferSize = ctx.sampleRate * 0.1;
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        const t = i / bufferSize;
        data[i] = (Math.random() * 2 - 1) * (1 - t) * 0.15;
      }

      const noiseSource = ctx.createBufferSource();
      noiseSource.buffer = buffer;
      const noiseFilter = ctx.createBiquadFilter();
      noiseFilter.type = 'lowpass';
      noiseFilter.frequency.value = 500;
      const noiseGain = ctx.createGain();
      noiseGain.gain.value = 0.2;

      noiseSource.connect(noiseFilter);
      noiseFilter.connect(noiseGain);
      noiseGain.connect(ctx.destination);
      noiseSource.start();
    }

    // --- SEEDED RANDOM (for consistent book generation) ---
    let seed = 42;
    function seededRandom() {
      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
      return seed / 0x7fffffff;
    }

