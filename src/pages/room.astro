        x.strokeStyle = `rgba(20,15,10,${0.03 + Math.random() * 0.05})`;
        x.lineWidth = 1 + Math.random() * 3;
        x.beginPath(); x.moveTo(px, 0);
        for (let y = 0; y < 512; y += 20) x.lineTo(px + (Math.random() - 0.5) * 8, y);
        x.stroke();
      }
      return c;
    }

    // Walnut wood grain
    function woodTexture() {
      const c = makeCanvas(512), x = c.getContext('2d');
      x.fillStyle = '#4a2e1c'; x.fillRect(0, 0, 512, 512);
      for (let y = 0; y < 512; y += 2) {
        const warp = Math.sin(y * 0.04) * 10 + Math.sin(y * 0.11) * 4;
        const l = (Math.random() - 0.5) * 18;
        x.strokeStyle = `rgba(${92 + l},${58 + l},${34 + l},0.6)`;
        x.lineWidth = 1 + Math.random();
        x.beginPath(); x.moveTo(-20 + warp, y); x.lineTo(532 + warp, y + 2); x.stroke();
      }
      // knots
      for (let i = 0; i < 6; i++) {
        const px = Math.random() * 512, py = Math.random() * 512, r = 8 + Math.random() * 22;
        const g = x.createRadialGradient(px, py, 0, px, py, r);
        g.addColorStop(0, 'rgba(30,18,10,0.8)'); g.addColorStop(0.6, 'rgba(50,30,16,0.3)'); g.addColorStop(1, 'rgba(0,0,0,0)');
        x.fillStyle = g; x.beginPath(); x.arc(px, py, r, 0, 7); x.fill();
      }
      return c;
    }

    // Bookcase interior back panel (dark AO gradient)
    function backPanelTexture() {
      const c = makeCanvas(256), x = c.getContext('2d');
      const g = x.createLinearGradient(0, 0, 0, 256);
      g.addColorStop(0, '#1a120a'); g.addColorStop(1, '#0d0906');
      x.fillStyle = g; x.fillRect(0, 0, 256, 256);
      for (let i = 0; i < 1500; i++) {
        const l = Math.random() * 14;
        x.fillStyle = `rgba(${30 + l},${20 + l},${12 + l},0.4)`;
        x.fillRect(Math.random() * 256, Math.random() * 256, 1, 1);
      }
      return c;
    }

    // Grayscale book spine (multiplied by instanceColor)
    function spineTexture() {
      const c = makeCanvas(128), x = c.getContext('2d');
      x.fillStyle = '#b8b8b8'; x.fillRect(0, 0, 128, 128);
      // cloth noise
      for (let i = 0; i < 2500; i++) {
        const l = (Math.random() - 0.5) * 40;
        x.fillStyle = `rgba(${184 + l},${184 + l},${184 + l},0.5)`;
        x.fillRect(Math.random() * 128, Math.random() * 128, 1, 2);
      }
      // raised bands
      x.strokeStyle = 'rgba(255,255,255,0.5)'; x.lineWidth = 3;
      [22, 44, 84, 106].forEach(y => { x.beginPath(); x.moveTo(0, y); x.lineTo(128, y); x.stroke(); });
      x.strokeStyle = 'rgba(60,60,60,0.5)'; x.lineWidth = 1;
      [25, 47, 87, 109].forEach(y => { x.beginPath(); x.moveTo(0, y); x.lineTo(128, y); x.stroke(); });
      // gilt title panel
      x.fillStyle = 'rgba(235,225,190,0.85)'; x.fillRect(24, 55, 80, 22);
      x.fillStyle = 'rgba(120,110,80,0.7)';
      for (let i = 0; i < 4; i++) x.fillRect(30, 60 + i * 4, 60 - Math.random() * 30, 1.4);
      return c;
    }

    // Sacred book leather + emissive title
    function leatherTexture() {
      const c = makeCanvas(512), x = c.getContext('2d');
      x.fillStyle = '#5f1a17'; x.fillRect(0, 0, 512, 512);
      for (let i = 0; i < 8000; i++) {
        const l = (Math.random() - 0.5) * 34;
        x.fillStyle = `rgba(${110 + l},${34 + l},${30 + l},0.5)`;
        x.fillRect(Math.random() * 512, Math.random() * 512, 2, 2);
      }
      // tooled double border
      x.strokeStyle = 'rgba(180,140,90,0.5)'; x.lineWidth = 4;
      x.strokeRect(48, 48, 416, 416);
      x.lineWidth = 2; x.strokeRect(64, 64, 384, 384);
      return c;
    }
    function leatherEmissive() {
      const c = makeCanvas(512), x = c.getContext('2d');
      x.fillStyle = '#000'; x.fillRect(0, 0, 512, 512);
      x.fillStyle = '#d8b978';
      x.textAlign = 'center';
      x.font = '700 54px "Source Serif 4", Georgia, serif';
      x.fillText('PLUNKITT', 256, 210);
      x.font = '400 26px "Source Serif 4", Georgia, serif';
      x.fillText('OF', 256, 258);
      x.font = '700 40px "Source Serif 4", Georgia, serif';
      x.fillText('TAMMANY', 256, 306);
      x.fillText('HALL', 256, 350);
      // diamond
      x.save(); x.translate(256, 410); x.rotate(Math.PI / 4);
      x.strokeStyle = '#d8b978'; x.lineWidth = 3; x.strokeRect(-14, -14, 28, 28); x.restore();
      return c;
    }

    // radial sprite (dust, halo)
    function radialSprite(inner) {
      const c = makeCanvas(64), x = c.getContext('2d');
      const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, inner); g.addColorStop(1, 'rgba(255,255,255,0)');
      x.fillStyle = g; x.fillRect(0, 0, 64, 64);
      return c;
    }

    // vertical alpha gradient for beam cone
    function beamTexture() {
      const c = makeCanvas(64), x = c.getContext('2d');
      const g = x.createLinearGradient(0, 0, 0, 64);
      g.addColorStop(0, 'rgba(255,240,210,0.9)');
      g.addColorStop(1, 'rgba(255,240,210,0)');
      x.fillStyle = g; x.fillRect(0, 0, 64, 64);
      return c;
    }

    // terminus cap for shaft ends
    function terminusTexture(colorHex) {
      const c = makeCanvas(256), x = c.getContext('2d');
      const g = x.createRadialGradient(128, 128, 0, 128, 128, 128);
      g.addColorStop(0, rgba(colorHex, 0.85));
      g.addColorStop(0.5, rgba(colorHex, 0.4));
      g.addColorStop(1, rgba(0x0a0806, 0));
      x.fillStyle = g; x.fillRect(0, 0, 256, 256);
      return c;
    }

    // Build shared textures
    const texStone = texFromCanvas(stoneTexture());
    const texStoneTrim = texFromCanvas(stoneTexture(), 2);
    const texPlaster = texFromCanvas(plasterTexture());
    const texWood = texFromCanvas(woodTexture());
    const texBack = texFromCanvas(backPanelTexture());
    const texSpine = new THREE.CanvasTexture(spineTexture());
    texSpine.colorSpace = THREE.SRGBColorSpace;
    const dustSprite = new THREE.CanvasTexture(radialSprite('rgba(232,217,176,0.9)'));
    const haloSprite = new THREE.CanvasTexture(radialSprite('rgba(255,224,170,0.8)'));

    // ==================================================================
    //  SCENE / CAMERA / RENDERER
    // ==================================================================
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(COL.void);
    scene.fog = new THREE.FogExp2(COL.void, 0.07);

    const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.05, 120);
    const CAM_EYE = 1.7;
    camera.position.set(3.35, CAM_EYE, 0); // spawn on the bridge axis — first view crosses the chasm to the book

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(innerWidth, innerHeight);
    let curPixelRatio = Math.min(devicePixelRatio, matchMedia("(pointer: coarse)").matches ? 1.25 : 1.75);
    renderer.setPixelRatio(curPixelRatio);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.0; // ramped up during intro
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.shadowMap.autoUpdate = false; // static scene → freeze
    renderer.domElement.id = 'library-canvas';
    renderer.domElement.tabIndex = 0;
    renderer.domElement.setAttribute('aria-label', 'Explore the library using the movement controls.');
    document.body.appendChild(renderer.domElement);
    renderer.domElement.addEventListener('webglcontextlost', event => {
      event.preventDefault(); showMenu();
      document.getElementById('loading-note').textContent = 'The gallery paused because its graphics connection was lost. Reload to return.';
      startButton.disabled = true;
    });

    // ==================================================================
    //  PROCEDURAL ENVIRONMENT (PMREM) — warm equirect with lamp blobs
    // ==================================================================
    (function buildEnvironment() {
      const c = makeCanvas(256); c.height = 128;
      const x = c.getContext('2d');
      const g = x.createLinearGradient(0, 0, 0, 128);
      g.addColorStop(0, '#3a2c1a'); g.addColorStop(0.5, '#20180f'); g.addColorStop(1, '#0a0806');
      x.fillStyle = g; x.fillRect(0, 0, 256, 128);
      // two lamp blobs
      [64, 192].forEach(px => {
        const rg = x.createRadialGradient(px, 54, 0, px, 54, 40);
        rg.addColorStop(0, 'rgba(255,225,170,0.9)'); rg.addColorStop(1, 'rgba(255,225,170,0)');
        x.fillStyle = rg; x.fillRect(px - 40, 14, 80, 80);
      });
      const tex = new THREE.CanvasTexture(c);
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.mapping = THREE.EquirectangularReflectionMapping;
      const pmrem = new THREE.PMREMGenerator(renderer);
      pmrem.compileEquirectangularShader();
      const envRT = pmrem.fromEquirectangular(tex);
      scene.environment = envRT.texture;
      tex.dispose(); pmrem.dispose();
    })();

    // ==================================================================
    //  POST PROCESSING
    // ==================================================================
    const composer = new EffectComposer(renderer);
    composer.setPixelRatio(curPixelRatio);
    composer.setSize(innerWidth, innerHeight);
    composer.addPass(new RenderPass(scene, camera));

    const bloom = new UnrealBloomPass(new THREE.Vector2(innerWidth / 2, innerHeight / 2), 1.2, 0.6, 0.82);
    composer.addPass(bloom);

    // combined grade: vignette + split-tone + grain + chromatic aberration
    const GradeShader = {
      uniforms: {
        tDiffuse: { value: null },
        uTime: { value: 0 },
        uVignette: { value: 0.4 },
        uGrain: { value: 0.009 },
        uChroma: { value: 0.0 },
      },
      vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0);}`,
      fragmentShader: `
        varying vec2 vUv;
        uniform sampler2D tDiffuse;
        uniform float uTime, uVignette, uGrain, uChroma;
        float rand(vec2 co){ return fract(sin(dot(co.xy, vec2(12.9898,78.233))) * 43758.5453); }
        void main(){
          vec2 uv = vUv;
          vec2 d = uv - 0.5;
          float dist = length(d);
          // chromatic aberration, stronger at edges
          float ca = uChroma * dist * 2.0;
          vec3 col;
          col.r = texture2D(tDiffuse, uv + d * ca).r;
          col.g = texture2D(tDiffuse, uv).g;
          col.b = texture2D(tDiffuse, uv - d * ca).b;
          // split-tone: lift shadows cool, warm mids
          float lum = dot(col, vec3(0.299,0.587,0.114));
          vec3 shadowTint = vec3(0.047,0.039,0.070);
          vec3 warm = vec3(1.04,1.0,0.94);
          col = mix(col + shadowTint * (1.0 - smoothstep(0.0,0.35,lum)) * 0.6, col, 0.5) ;
          col *= mix(vec3(1.0), warm, smoothstep(0.1,0.6,lum));
          // vignette
          float vig = 1.0 - smoothstep(0.2, 0.8, dist);
          col *= mix(1.0 - uVignette, 1.0, vig);
          // film grain
          float g = (rand(uv * vec2(1920.0,1080.0) + uTime) - 0.5) * uGrain;
          col += g * (0.4 + 0.6 * (1.0 - lum));
          gl_FragColor = vec4(col, 1.0);
        }`,
    };
    const gradePass = new ShaderPass(GradeShader);
    composer.addPass(gradePass);
    composer.addPass(new OutputPass());
    bloom.setSize(innerWidth / 2, innerHeight / 2);

    // ==================================================================
    //  LIGHTS
    // ==================================================================
    scene.add(new THREE.HemisphereLight(0x2a2016, 0x0a0806, 0.5));

    const R = 5, H = 6.0;
    const apothem = R * Math.cos(Math.PI / 6);

    function wallNormal(w) { const a = (w / 6) * Math.PI * 2; return new THREE.Vector3(Math.cos(a), 0, Math.sin(a)); }

    // two gallery bulbs, crosswise (walls 1 & 4)
    const bulbWalls = [1, 4];
    const bulbLights = [];
    bulbWalls.forEach(w => {
      const n = wallNormal(w);
      const p = new THREE.Vector3(n.x * (apothem - 0.5), 3.2, n.z * (apothem - 0.5));
      const light = new THREE.PointLight(COL.lampAmber, 30, 15, 2);
      light.position.copy(p);
      scene.add(light);
      bulbLights.push({ light, pos: p });
    });

    // spotlight from ceiling shaft onto the pedestal — the ONLY shadow caster
    const spot = new THREE.SpotLight(0xfff2d6, 68, 18, 0.42, 0.6, 2);
    spot.position.set(0, H - 0.2, 0);
    spot.target.position.set(0, 1.2, 0);
    spot.castShadow = true;
    spot.shadow.mapSize.set(1024, 1024);
    spot.shadow.bias = -0.0006;
    spot.shadow.camera.near = 1; spot.shadow.camera.far = 12;
    scene.add(spot); scene.add(spot.target);

    // abyss glow — warm light rising from the floors below, and echoing above
    const abyss = new THREE.PointLight(0x9a6a2e, 16, 14, 2);
    abyss.position.set(0, -4.0, 0);
    scene.add(abyss);
    const abyssUp = new THREE.PointLight(0x8a6030, 10, 14, 2);
    abyssUp.position.set(0, H + 4.0, 0);
    scene.add(abyssUp);

    // ==================================================================
    //  MATERIALS
    // ==================================================================
    const matFloor = new THREE.MeshStandardMaterial({ map: texStone, roughness: 0.9, metalness: 0.0, envMapIntensity: 0.15 });
    matFloor.map.repeat.set(2, 2);
    const matWall = new THREE.MeshStandardMaterial({ map: texPlaster, roughness: 0.95, metalness: 0.0, envMapIntensity: 0.12 });
    const matWood = new THREE.MeshStandardMaterial({ map: texWood, roughness: 0.65, metalness: 0.0, envMapIntensity: 0.2 });
    const matBack = new THREE.MeshStandardMaterial({ map: texBack, roughness: 0.95, metalness: 0.0, envMapIntensity: 0.05 });
    const matStone = new THREE.MeshStandardMaterial({ map: texStoneTrim, color: 0x9a8a70, roughness: 0.85, metalness: 0.0, envMapIntensity: 0.15 });
    const matBrass = new THREE.MeshStandardMaterial({ color: COL.brass, roughness: 0.35, metalness: 0.85, envMapIntensity: 0.5 });
    const matBulb = new THREE.MeshBasicMaterial({ color: COL.bulbGlow, toneMapped: true });

    // ==================================================================
    //  GEOMETRY HELPERS
    // ==================================================================
    // Hexagon vertices offset +30° so FACE normals land at k·60° — matching wallNormal(w),
    // the hex CylinderGeometry shaft walls, and the bridge axis (+X crosses a flat face).
    function hexVtx(i, r, y) {
      const a = (i / 6) * Math.PI * 2 + Math.PI / 6;
      return new THREE.Vector3(Math.cos(a) * r, y, Math.sin(a) * r);
    }

    // ---- FLOOR: hexagon ring with central hole (ShapeGeometry) ----
    const moatOuter = 2.15, islandOuter = 1.05, railingR = 2.15;
    const matShaftWall = new THREE.MeshStandardMaterial({ color: 0x332c22, roughness: 0.95, metalness: 0, envMapIntensity: 0.05, side: THREE.BackSide });
    const matPillar = new THREE.MeshStandardMaterial({ color: 0x4a4033, roughness: 0.9, metalness: 0, envMapIntensity: 0.08 });
    (function buildFloorCeiling() {
      // outer floor: hexagon with a central shaft hole
      const outer = new THREE.Shape();
      for (let i = 0; i <= 6; i++) { const v = hexVtx(i, R, 0); i === 0 ? outer.moveTo(v.x, v.z) : outer.lineTo(v.x, v.z); }
      const hole = new THREE.Path();
      for (let i = 0; i <= 6; i++) { const v = hexVtx(i, moatOuter, 0); i === 0 ? hole.moveTo(v.x, v.z) : hole.lineTo(v.x, v.z); }
      outer.holes.push(hole);
      const geo = new THREE.ShapeGeometry(outer);
      geo.rotateX(-Math.PI / 2);
      const floorUV = geo.getAttribute('uv');
      for (let i = 0; i < floorUV.count; i++) floorUV.setXY(i, floorUV.getX(i) / 5, floorUV.getY(i) / 5);
      const floor = new THREE.Mesh(geo, matFloor);
      floor.receiveShadow = true; scene.add(floor);
      // ceiling with a matching hole → the shaft opens upward too
      const ceil = new THREE.Mesh(geo.clone(), matWall);
      ceil.position.y = H; ceil.rotation.x = Math.PI; scene.add(ceil);

      // central island disk — solid ground the sacred book stands on
      const island = new THREE.Mesh(new THREE.CylinderGeometry(islandOuter, islandOuter, 0.16, 6), matStone);
      island.position.y = -0.02; island.receiveShadow = true; scene.add(island);

      // the infinite chasm: outer shaft wall + central pillar, plunging up & down
      const shaftH = 64;
      const pillarDown = new THREE.Mesh(new THREE.CylinderGeometry(islandOuter, islandOuter, shaftH, 6, 1, true), matPillar);
      pillarDown.position.y = -shaftH / 2; scene.add(pillarDown);
    })();

    // ---- WALLS ---- (walls 0 & 3 are the free/vestibule walls; 1,2,4,5 carry bookcases)
    const bookWalls = [1, 2, 4, 5];
    for (let w = 0; w < 6; w++) {
      const n = wallNormal(w);
      const side = R; // hexagon side length equals the circumradius R
      if (bookWalls.includes(w)) {
        const wall = new THREE.Mesh(new THREE.PlaneGeometry(side, H), matWall);
        wall.position.set(n.x * apothem, H / 2, n.z * apothem);
        wall.lookAt(0, H / 2, 0);
        wall.receiveShadow = true;
        scene.add(wall);
      } else {
        // vestibule wall: two jambs + lintel + spandrel, opening in the middle
        const openW = 1.7, openH = 2.7;
        const jw = (side - openW) / 2;
        // left jamb
        const lj = new THREE.Mesh(new THREE.BoxGeometry(jw, H, 0.15), matWall);
        // right jamb
        const rj = new THREE.Mesh(new THREE.BoxGeometry(jw, H, 0.15), matWall);
        // spandrel above opening
        const sp = new THREE.Mesh(new THREE.BoxGeometry(openW, H - openH, 0.15), matWall);
        const tan = new THREE.Vector3(-n.z, 0, n.x);
        const base = new THREE.Vector3(n.x * apothem, 0, n.z * apothem);
        function place(m, offX, cy, receive = true) {
          m.position.set(base.x + tan.x * offX, cy, base.z + tan.z * offX);
          m.lookAt(m.position.x - n.x, cy, m.position.z - n.z);
          m.name = `Doorway wall ${w}`;
          m.receiveShadow = receive; scene.add(m);
        }
        place(lj, -(openW / 2 + jw / 2), H / 2);
        place(rj, (openW / 2 + jw / 2), H / 2);
        place(sp, 0, openH + (H - openH) / 2);
        // arch trim (stone) around opening
        const trimMat = matStone;
        const t1 = new THREE.Mesh(new THREE.BoxGeometry(0.12, openH, 0.18), trimMat);
        const t2 = new THREE.Mesh(new THREE.BoxGeometry(0.12, openH, 0.18), trimMat);
        const t3 = new THREE.Mesh(new THREE.BoxGeometry(openW + 0.24, 0.14, 0.18), trimMat);
        function placeTrim(m, offX, cy) {
          m.position.set(base.x + tan.x * offX, cy, base.z + tan.z * offX);
          m.lookAt(m.position.x - n.x, cy, m.position.z - n.z);
          m.name = `Doorway trim ${w}`;
          scene.add(m);
        }
        placeTrim(t1, -openW / 2, openH / 2);
        placeTrim(t2, openW / 2, openH / 2);
        placeTrim(t3, 0, openH);
      }
    }

    // ---- VESTIBULE ROOMS (behind walls 0 & 3) ----
    function buildVestibule(w, withMirror, openBack) {
      const n = wallNormal(w), tan = new THREE.Vector3(-n.z, 0, n.x);
      const depth = 2.6, halfW = 1.1, vh = 3.2;
      const outCenter = new THREE.Vector3(n.x * (apothem + depth / 2), 0, n.z * (apothem + depth / 2));
      const backBase = new THREE.Vector3(n.x * (apothem + depth), 0, n.z * (apothem + depth));
      if (openBack) {
        // arched opening in the back wall — the corridor to the next gallery
        const ow = 1.5, oh = 2.5;
        const bj = (halfW * 2 - ow) / 2;
        function placeB(m, offX, cy) {
          m.position.set(backBase.x + tan.x * offX, cy, backBase.z + tan.z * offX);
          m.lookAt(m.position.x - n.x, cy, m.position.z - n.z); // face into the vestibule
          scene.add(m);
        }
        placeB(new THREE.Mesh(new THREE.PlaneGeometry(bj, vh), matWall), -(ow / 2 + bj / 2), vh / 2);
        placeB(new THREE.Mesh(new THREE.PlaneGeometry(bj, vh), matWall), (ow / 2 + bj / 2), vh / 2);
        placeB(new THREE.Mesh(new THREE.PlaneGeometry(ow, vh - oh), matWall), 0, oh + (vh - oh) / 2);
        placeB(new THREE.Mesh(new THREE.BoxGeometry(0.1, oh, 0.14), matStone), -ow / 2, oh / 2);
        placeB(new THREE.Mesh(new THREE.BoxGeometry(0.1, oh, 0.14), matStone), ow / 2, oh / 2);
        placeB(new THREE.Mesh(new THREE.BoxGeometry(ow + 0.2, 0.12, 0.14), matStone), 0, oh);
      } else {
        const back = new THREE.Mesh(new THREE.PlaneGeometry(halfW * 2, vh), matWall);
        back.position.copy(backBase).setY(vh / 2);
        back.lookAt(outCenter.x - n.x, vh / 2, outCenter.z - n.z);
        scene.add(back);
      }
      // side walls
      [-1, 1].forEach(s => {
        const sw = new THREE.Mesh(new THREE.PlaneGeometry(depth, vh), matWall);
        sw.position.set(outCenter.x + tan.x * halfW * s, vh / 2, outCenter.z + tan.z * halfW * s);
        sw.lookAt(outCenter.x, vh / 2, outCenter.z);
        scene.add(sw);
      });
      // floor + ceiling
      const vf = new THREE.Mesh(new THREE.PlaneGeometry(depth, halfW * 2), matFloor);
      vf.rotation.x = -Math.PI / 2; vf.position.set(outCenter.x, 0.01, outCenter.z); vf.receiveShadow = true; scene.add(vf);
      const vc = new THREE.Mesh(new THREE.PlaneGeometry(depth, halfW * 2), matWall);
      vc.rotation.x = Math.PI / 2; vc.position.set(outCenter.x, vh, outCenter.z); scene.add(vc);
      // small vestibule bulb
      const vbLight = new THREE.PointLight(0xffcf90, 7, 7, 2);
      vbLight.position.set(outCenter.x, 2.5, outCenter.z);
      scene.add(vbLight);
      const vb = new THREE.Mesh(new THREE.SphereGeometry(0.09, 12, 12), matBulb);
      vb.position.copy(vbLight.position); scene.add(vb);
      const vhalo = new THREE.Sprite(new THREE.SpriteMaterial({ map: haloSprite, color: 0xffcf90, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.3, depthWrite: false }));
      vhalo.scale.set(1.0, 1.0, 1); vhalo.position.copy(vbLight.position); scene.add(vhalo);

      // brass chain across the archway threshold (diegetic barrier)
      const chainY = 1.0;
      const chainMat = matBrass;
      const ccount = openBack ? 0 : 25; // the completed west passage is open
      for (let i = 0; i < ccount; i++) {
        const link = new THREE.Mesh(new THREE.TorusGeometry(0.045, 0.014, 6, 10), chainMat);
        const off = (i / (ccount - 1) - 0.5) * (halfW * 2 - 0.1);
        const sag = Math.sin((i / (ccount - 1)) * Math.PI) * 0.12;
        link.position.set(n.x * apothem + tan.x * off, chainY - sag, n.z * apothem + tan.z * off);
        link.rotation.y = Math.atan2(tan.z, tan.x); // ring plane faces along the archway
        if (i % 2) link.rotateOnAxis(new THREE.Vector3(1, 0, 0), Math.PI / 2); // alternate links twist 90° around the chain
        scene.add(link);
      }

      if (withMirror) {
        // a true mirror on the BACK wall, facing the archway — reflects the gallery beyond
        // ("faithfully duplicates appearances"). Gated to render only when looked at.
        const mirror = new Reflector(new THREE.PlaneGeometry(1.4, 2.3), {
          color: 0x9a9184, textureWidth: 1024, textureHeight: 1024, clipBias: 0.003,
        });
        const mpos = new THREE.Vector3(n.x * (apothem + depth - 0.06), 1.55, n.z * (apothem + depth - 0.06));
        mirror.position.copy(mpos);
        mirror.lookAt(0, 1.55, 0); // glass normal points back toward the gallery/archway
        scene.add(mirror);
        mirrorObj = mirror;
        mirrorCenter = mpos.clone();
        // walnut frame just behind the glass
        const frame = new THREE.Mesh(new THREE.BoxGeometry(1.6, 2.5, 0.06), matWood);
        frame.position.copy(mpos).addScaledVector(n, 0.04);
        frame.quaternion.copy(mirror.quaternion);
        scene.add(frame);
      }
    }
    let mirrorObj = null, mirrorCenter = null;
    buildVestibule(0, true, false);  // vestibule A — the mirror
    buildVestibule(3, false, true);  // vestibule B — open corridor to the neighbor gallery

    // ---- CENTRAL SHAFT: rim, railing, bridge, pedestal island ----
    const bridgeHalfZ = 0.55;
    (function buildShaft() {
      // stone curbs along the hex chasm edge and around the island —
      // built as straight box segments per hex face, skipping the +X face the bridge crosses
      function hexCurb(circumR, extra, h, d, skipBridgeFace) {
        const faceApothem = circumR * Math.cos(Math.PI / 6) + extra;
        const len = circumR + 0.18; // face length ≈ circumradius, small miter overlap
        for (let f = 0; f < 6; f++) {
          if (skipBridgeFace && f === 0) continue; // +X face — the bridge lands here
          const a = f * Math.PI / 3;
          const curb = new THREE.Mesh(new THREE.BoxGeometry(len, h, d), matStone);
          curb.position.set(Math.cos(a) * faceApothem, 0.06, Math.sin(a) * faceApothem);
          curb.lookAt(0, 0.06, 0); // +Z (depth) toward center → length runs along the edge
          curb.receiveShadow = true;
          scene.add(curb);
        }
      }
      hexCurb(moatOuter, 0.09, 0.12, 0.16, true);   // chasm edge
      hexCurb(islandOuter, 0.06, 0.1, 0.12, true);  // island edge

      // brass railing at the chasm edge, with a GAP centered on +X for the bridge.
      // The gap is baked into the geometry (rotateZ before rotateX) so it truly sits at +X.
      for (let face = 0; face < 6; face++) {
        const a = face * Math.PI / 3, nx = Math.cos(a), nz = Math.sin(a);
        const radius = moatOuter * Math.cos(Math.PI / 6) + 0.10;
        const halfSide = radius * Math.tan(Math.PI / 6);
        const spans = face === 0 ? [[-halfSide, -0.57], [0.57, halfSide]] : [[-halfSide, halfSide]];
        for (const [start, end] of spans) {
          const off = (start + end) / 2;
          for (const y of [0.5, 0.98]) {
            const rail = new THREE.Mesh(new THREE.BoxGeometry(end - start, 0.032, 0.032), matBrass);
            rail.position.set(nx * radius - nz * off, y, nz * radius + nx * off);
            rail.rotation.y = Math.atan2(nx, nz); scene.add(rail);
          }
          const count = Math.ceil((end - start) / 0.38);
          for (let postIndex = 0; postIndex <= count; postIndex++) {
            const off = start + (end - start) * postIndex / count;
            const post = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.03, 0.96, 8), matBrass);
            post.position.set(nx * radius - nz * off, 0.48, nz * radius + nx * off); scene.add(post);
          }
        }
      }

      // stone bridge spanning the chasm from outer floor (+X) to the island
      const bLen = moatOuter - islandOuter + 0.7;
      const bridge = new THREE.Mesh(new THREE.BoxGeometry(bLen, 0.14, bridgeHalfZ * 2), matStone);
      bridge.position.set(islandOuter + (moatOuter - islandOuter) / 2 + 0.05, 0.0, 0);
      bridge.receiveShadow = true; scene.add(bridge);
      // little side kerbs on the bridge
      [-1, 1].forEach(s => {
        const k = new THREE.Mesh(new THREE.BoxGeometry(bLen, 0.1, 0.06), matStone);
        k.position.set(bridge.position.x, 0.09, s * bridgeHalfZ);
        scene.add(k);
      });

      // pedestal on the island
      const ped = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.32, 1.0, 6), matStone);
      ped.position.y = 0.57; ped.receiveShadow = true; ped.castShadow = true; scene.add(ped);
      const pedTop = new THREE.Mesh(new THREE.CylinderGeometry(0.46, 0.46, 0.06, 6), matWood);
      pedTop.position.y = 1.09; pedTop.receiveShadow = true; pedTop.castShadow = true; scene.add(pedTop);
    })();

    // ---- LAMP GLOBES + ARMS + HALOS (main gallery bulbs) ----
    bulbLights.forEach(({ pos }) => {
      const globe = new THREE.Mesh(new THREE.SphereGeometry(0.16, 16, 16), matBulb);
      globe.position.copy(pos); scene.add(globe);
      // brass arm — cylinder axis (local Y) rotated to run horizontally from wall to bulb
      const n = pos.clone().setY(0).normalize();
      const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.55, 6), matBrass);
      arm.position.copy(pos).addScaledVector(n, 0.27);
      arm.position.y += 0.22;
      arm.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), n);
      scene.add(arm);
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.08, 8), matBrass);
      stem.position.copy(pos); stem.position.y += 0.18; scene.add(stem);
      const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: haloSprite, color: 0xffe0aa, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.35, depthWrite: false }));
      halo.scale.set(1.6, 1.6, 1); halo.position.copy(pos); scene.add(halo);
    });

    // ==================================================================
    //  BOOKCASES + BOOKS (single InstancedMesh)
    // ==================================================================
    resetSeed(1337);
    const bookSlots = []; // {pos, scale, rotY, normal}
    // build bookcases on the 4 book walls
    bookWalls.forEach(w => {
      const n = wallNormal(w), tan = new THREE.Vector3(-n.z, 0, n.x);
      const wallDist = apothem - 0.05;
      const caseW = R * 0.82, caseD = 0.4;
      const base = new THREE.Vector3(n.x * wallDist, 0, n.z * wallDist);
      // case frame: side stiles, plinth, cornice, back panel
      function box(wd, ht, dp, offX, cy, mat) {
        const m = new THREE.Mesh(new THREE.BoxGeometry(wd, ht, dp), mat);
        m.position.set(base.x + tan.x * offX - n.x * dp / 2, cy, base.z + tan.z * offX - n.z * dp / 2);
        // depth (+Z) along the wall normal: R(+Z) = (sinθ, cosθ) = (n.x, n.z) → θ = atan2(n.x, n.z)
        m.rotation.y = Math.atan2(n.x, n.z);
        m.receiveShadow = true; scene.add(m); return m;
      }
      box(0.12, 5.3, caseD, -caseW / 2, 2.85, matWood);      // left stile
      box(0.12, 5.3, caseD, caseW / 2, 2.85, matWood);       // right stile
      box(caseW, 0.35, caseD, 0, 0.18, matWood);             // plinth
      box(caseW, 0.2, caseD + 0.06, 0, 5.55, matWood);       // cornice
      // back panel (dark)
      const backP = new THREE.Mesh(new THREE.PlaneGeometry(caseW, 5.3), matBack);
      backP.position.set(base.x, 2.85, base.z); backP.lookAt(0, 2.85, 0); scene.add(backP);

      const shelfYs = [0.55, 1.57, 2.59, 3.61, 4.63];
      shelfYs.forEach(sy => {
        // shelf board
        box(caseW, 0.06, caseD, 0, sy - 0.03, matWood);
        // books on this shelf
        const usableW = caseW - 0.2;
        let bx = -usableW / 2;
        const gap = 0.01;
        while (bx < usableW / 2 - 0.06) {
          const bw = 0.045 + seededRandom() * 0.05;
          if (bx + bw > usableW / 2) break;
          const bh = 0.46 + seededRandom() * 0.25;
          const bd = 0.25 + seededRandom() * 0.07;
          const lean = seededRandom() < 0.12 ? (seededRandom() - 0.5) * 0.14 : 0;
          const cx = bx + bw / 2;
          // seat spines ~8cm behind the case front, clear of the back panel
          const inward = caseD - 0.08 - bd / 2;
          const px = base.x + tan.x * cx - n.x * inward;
          const pz = base.z + tan.z * cx - n.z * inward;
          bookSlots.push({
            x: px, y: sy + bh / 2, z: pz,
            sx: bw, sy2: bh, sz: bd,
            // spine (+X face after scaling) must face the room: R(+X) = −n → θ = atan2(n.z, −n.x)
            rotY: Math.atan2(n.z, -n.x), lean,
            nx: -n.x, nz: -n.z, // pull-out direction: OUT of the shelf, toward the room
          });
          bx += bw + gap;
        }
      });
    });

    // every single book opens a Borges quote — quotes cycle across the shelves
    const nSlots = bookSlots.length;
    const nQuotes = borgesQuotes.length;
    resetSeed(99);
    const bookGeo = new THREE.BoxGeometry(1, 1, 1);
    const bookMat = new THREE.MeshStandardMaterial({ map: texSpine, roughness: 0.72, metalness: 0.0, envMapIntensity: 0.12 });
    const books = new THREE.InstancedMesh(bookGeo, bookMat, nSlots);
    books.instanceColor = new THREE.InstancedBufferAttribute(new Float32Array(nSlots * 3), 3);
    const dummy = new THREE.Object3D();
    dummy.rotation.order = 'YXZ'; // yaw to the wall, then lean sideways around the (local X) depth axis
    const bookMeta = new Array(nSlots);
    const color = new THREE.Color();
    for (let i = 0; i < nSlots; i++) {
      const s = bookSlots[i];
      dummy.position.set(s.x, s.y, s.z);
      dummy.rotation.set(s.lean, s.rotY, 0);
      dummy.scale.set(s.sz, s.sy2, s.sx); // box: x=depth into shelf, y=height, z=spine width
      dummy.updateMatrix();
      books.setMatrixAt(i, dummy.matrix);
      const ci = Math.floor(seededRandom() * BOOK_COLORS.length);
      color.setHex(BOOK_COLORS[ci]);
      const jit = 0.9 + seededRandom() * 0.2;
      color.multiplyScalar(jit);
      books.setColorAt(i, color);
      bookMeta[i] = {
        content: borgesQuotes[i % nQuotes],
        pos: new THREE.Vector3(s.x, s.y, s.z),
        normal: new THREE.Vector3(s.nx, 0, s.nz),
        rotY: s.rotY, lean: s.lean,
        scale: new THREE.Vector3(s.sz, s.sy2, s.sx),
      };
    }
    books.instanceMatrix.needsUpdate = true;
    books.instanceColor.needsUpdate = true;
    scene.add(books);

    // hover proxy (a single pulled-out book) + highlight shell
    const proxyMat = bookMat.clone(); proxyMat.emissive = new THREE.Color(0xffd9a0); proxyMat.emissiveIntensity = 0.0;
    const proxy = new THREE.Mesh(bookGeo, proxyMat); proxy.visible = false; proxy.rotation.order = 'YXZ'; scene.add(proxy);
    const shellMat = new THREE.MeshBasicMaterial({ color: 0xffd9a0, transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending, depthWrite: false });
    const shell = new THREE.Mesh(bookGeo, shellMat); shell.visible = false; shell.rotation.order = 'YXZ'; scene.add(shell);

    // ==================================================================
    //  SACRED BOOK on pedestal
    // ==================================================================
    const shrineGroup = new THREE.Group();
    const shrineLeatherMap = new THREE.CanvasTexture(leatherTexture());
    shrineLeatherMap.colorSpace = THREE.SRGBColorSpace;
    const shrineEmissiveMap = new THREE.CanvasTexture(leatherEmissive());
    shrineEmissiveMap.colorSpace = THREE.SRGBColorSpace;
    const shrineMat = new THREE.MeshStandardMaterial({
      map: shrineLeatherMap,
      emissiveMap: shrineEmissiveMap,
      emissive: new THREE.Color(COL.gold), emissiveIntensity: 0.6,
      roughness: 0.5, metalness: 0.05, envMapIntensity: 0.25,
    });
    // plain tooled leather for spine/edges/back — the gold title lives only on the front cover
    const shrinePlainMat = new THREE.MeshStandardMaterial({
      map: shrineLeatherMap, roughness: 0.5, metalness: 0.05, envMapIntensity: 0.25,
    });
    // box material order: +X, −X, +Y, −Y, +Z (front cover), −Z (back cover)
    const shrineBook = new THREE.Mesh(
      new THREE.BoxGeometry(0.34, 0.44, 0.08),
      [shrinePlainMat, shrinePlainMat, shrinePlainMat, shrinePlainMat, shrineMat, shrinePlainMat]
    );
    shrineBook.position.y = 1.09 + 0.22;
    shrineBook.rotation.x = -0.15;
    shrineBook.castShadow = true;
    shrineGroup.add(shrineBook);
    shrineGroup.rotation.y = Math.PI / 2; // cover (+Z face) turns to face the bridge on +X
    scene.add(shrineGroup);

    // ==================================================================
    //  VOLUMETRIC BEAM + DUST
    // ==================================================================
    const beamGeo = new THREE.ConeGeometry(1.15, H - 1.2, 24, 1, true);
    const beamTex = new THREE.CanvasTexture(beamTexture());
    beamTex.colorSpace = THREE.SRGBColorSpace;
    const beamMat = new THREE.MeshBasicMaterial({
      map: beamTex, color: 0xfff0d2,
      transparent: true, opacity: 0.16, blending: THREE.AdditiveBlending,
      side: THREE.BackSide, depthWrite: false,
    });
    const beam = new THREE.Mesh(beamGeo, beamMat);
    beam.position.set(0, 1.3 + (H - 1.2) / 2, 0);
    beam.rotation.x = 0; // ConeGeometry already has its narrow apex at +Y.
    beamMat.onBeforeCompile = shader => {
      shader.vertexShader = 'varying vec3 beamNormal; varying vec3 beamView; varying vec2 beamUV;\n' + shader.vertexShader;
      shader.vertexShader = shader.vertexShader.replace('#include <project_vertex>', '#include <project_vertex>\nbeamNormal = normalize(normalMatrix * normal); beamView = normalize(-mvPosition.xyz); beamUV = uv;');
      shader.fragmentShader = 'varying vec3 beamNormal; varying vec3 beamView; varying vec2 beamUV;\n' + shader.fragmentShader;
      shader.fragmentShader = shader.fragmentShader.replace('#include <dithering_fragment>', 'gl_FragColor.a *= pow(abs(dot(normalize(beamNormal), normalize(beamView))), 1.6) * smoothstep(0.0, 0.28, beamUV.y);\n#include <dithering_fragment>');
    };
    scene.add(beam);

    // dust motes with vertex-shader motion
    const DUST = 420;
    const dustGeo = new THREE.BufferGeometry();
    const dpos = new Float32Array(DUST * 3), dseed = new Float32Array(DUST);
    for (let i = 0; i < DUST; i++) {
      if (i < DUST * 0.55) {
        // in the beam cone
        const r = Math.random() * 1.0, a = Math.random() * 7;
        dpos[i * 3] = Math.cos(a) * r; dpos[i * 3 + 1] = 0.6 + Math.random() * (H - 1.4); dpos[i * 3 + 2] = Math.sin(a) * r;
      } else {
        const a = Math.random() * 7, r = 1.8 + Math.random() * (apothem - 2);
        dpos[i * 3] = Math.cos(a) * r; dpos[i * 3 + 1] = 0.3 + Math.random() * (H - 0.6); dpos[i * 3 + 2] = Math.sin(a) * r;
      }
      dseed[i] = Math.random() * 6.28;
    }
    dustGeo.setAttribute('position', new THREE.BufferAttribute(dpos, 3));
    dustGeo.setAttribute('aseed', new THREE.BufferAttribute(dseed, 1));
    const dustMat = new THREE.PointsMaterial({ size: 0.018, map: dustSprite, transparent: true, opacity: 0.4, color: 0xe8d9b0, depthWrite: false, blending: THREE.AdditiveBlending, sizeAttenuation: true });
    dustMat.onBeforeCompile = (sh) => {
      sh.uniforms.uTime = { value: 0 };
      dustMat.userData.shader = sh;
      sh.vertexShader = 'uniform float uTime;\nattribute float aseed;\n' + sh.vertexShader.replace(
        '#include <begin_vertex>',
        `#include <begin_vertex>
         transformed.x += sin(uTime*(0.2+aseed*0.05)+aseed)*0.08;
         transformed.y += sin(uTime*0.15+aseed*1.7)*0.06;
         transformed.z += cos(uTime*(0.18+aseed*0.04)+aseed*2.0)*0.08;`
      );
    };
    const dust = new THREE.Points(dustGeo, dustMat);
    scene.add(dust);

    const details = enrichLibrary({ scene, books, bookMeta, matWood, matStone, matBrass, matWall, shrineBook, shrineGroup });
    loadLibraryMaterials(matFloor, matWood, matStone);
    const adjacent = buildLibraryDepth(scene, { floor: matFloor, stone: matStone, wood: matWood, brass: matBrass, wall: matWall, back: matBack, bulb: matBulb }, books, details.pageEdges, bookMeta);
    const bookMotion = new BookMotion(scene, camera);
    const architecture = [];
    const solidMaterials = new Set([matWall, matWood, matBack, matStone]);
    scene.traverse(object => {
      if (object.isMesh && !Array.isArray(object.material) && solidMaterials.has(object.material)) architecture.push(object);
    });
    const selectedBinding = details.atlasMap.clone();
    selectedBinding.repeat.set(1 / 16, 1 / 16);
    selectedBinding.needsUpdate = true;
    const selectedSpine = proxyMat.clone();
    selectedSpine.map = selectedBinding;
    proxy.material = [selectedSpine, proxyMat, proxyMat, proxyMat, proxyMat, proxyMat];

    // ==================================================================
    //  FREEZE SHADOWS (static scene) — one manual update
    // ==================================================================
    renderer.shadowMap.needsUpdate = true;

    // ==================================================================
    //  CONTROLS
    // ==================================================================
    let locked = false, reading = false, menuOpen = false;
    let yaw = Math.PI / 2, pitch = 0; // face −X: straight down the bridge to the sacred book
    const euler = new THREE.Euler(0, 0, 0, 'YXZ');
    euler.set(0, yaw, 0);
    camera.quaternion.setFromEuler(euler); // orient the pre-lock view too
    const keys = {};
    const vel = new THREE.Vector3();
    const _wish = new THREE.Vector3(), _forward = new THREE.Vector3(), _right = new THREE.Vector3(), _wishWorld = new THREE.Vector3();
    let bobPhase = 0, curFov = 70;

    let exploring = false, dragLook = matchMedia('(pointer: coarse)').matches;
    let lookPointer = null, lookX = 0, lookY = 0, lookStartX = 0, lookStartY = 0;
    let lookDragged = false;
    const eyeOpening = document.getElementById('eye-opening');
    const startPrompt = document.getElementById('start-prompt');
    const startButton = document.getElementById('start-button');
    const controlsHint = document.getElementById('controls-hint');
    const titleCard = document.getElementById('title-card');
    const touchControls = document.getElementById('touch-controls');
    const soundControl = document.getElementById('room-sound');
    const motionControl = document.getElementById('room-motion');
    const brightnessControl = document.getElementById('room-brightness');
    let exposureTarget = 1.35;
    let reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    motionControl.checked = reduceMotion;
    let introDone = false, titleShown = false;
    function resetInput() {
      Object.keys(keys).forEach(key => delete keys[key]);
      vel.set(0, 0, 0); lookPointer = null; lookDragged = false;
    }
    function runTitleCard() {
      if (titleShown) return; titleShown = true;
      setTimeout(() => titleCard.classList.add('visible'), 400);
      setTimeout(() => titleCard.classList.remove('visible'), 4600);
    }
    function syncControls() {
      touchControls.hidden = !dragLook || !exploring || reading || menuOpen;
      document.body.classList.toggle('exploring', exploring && !reading && !menuOpen);
      document.body.classList.toggle('pointer-locked', locked && exploring && !reading && !menuOpen);
      controlsHint.textContent = dragLook ? 'Drag to look · center a book and tap Read · E to open with a keyboard' : 'Mouse to look · WASD / arrows to move · E to open the highlighted book · ESC pause';
      document.querySelector('#object-label .label-action').textContent = dragLook ? 'Tap Read to open · E on a keyboard' : 'E to open';
    }
    function showMenu() {
      resetInput(); menuOpen = true; exploring = false;
      document.exitPointerLock?.(); startPrompt.classList.add('visible'); clearHover(); syncControls();
      if (titleShown) startButton.textContent = 'Return to the gallery';
      startButton.focus({ preventScroll: true });
    }
    function startExploring() {
      resetInput(); menuOpen = false; exploring = true;
      startPrompt.classList.remove('visible'); syncControls(); runTitleCard();
      renderer.domElement.focus({ preventScroll: true });
      try { initAudioGraph(); audioCtx.resume().catch(() => {}); startAmbient(); } catch (error) { soundControl.checked = false; }
    }
    function useDragLook() {
      dragLook = true; startExploring();
    }
    async function hideMenu() {
      if (matchMedia('(pointer: coarse)').matches || !document.body.requestPointerLock) { useDragLook(); return; }
      try {
        await document.body.requestPointerLock();
        if (document.pointerLockElement === document.body) startExploring();
      } catch { useDragLook(); }
    }
    startButton.addEventListener('click', event => { event.stopPropagation(); hideMenu(); });
    document.addEventListener('pointerlockerror', () => { if (!reading) useDragLook(); });
    document.addEventListener('pointerlockchange', () => {
      const was = locked;
      locked = document.pointerLockElement === document.body;
      if (locked) { dragLook = false; startExploring(); }
      else if (was && !reading) showMenu();
      resetInput(); syncControls();
    });
    document.addEventListener('mousemove', event => {
      if (!locked || !exploring || reading) return;
      yaw -= event.movementX * 0.0022;
      pitch = Math.max(-1.3, Math.min(1.3, pitch - event.movementY * 0.0022));
    });
    renderer.domElement.addEventListener('pointerdown', event => {
      if (!dragLook || !exploring || reading || event.button !== 0 || lookPointer !== null) return;
      lookDragged = false;
      lookPointer = event.pointerId;
      lookX = lookStartX = event.clientX; lookY = lookStartY = event.clientY;
      renderer.domElement.focus({ preventScroll: true });
      renderer.domElement.setPointerCapture(event.pointerId);
    });
    renderer.domElement.addEventListener('pointermove', event => {
      if (!dragLook || !exploring || reading) return;
      if (lookPointer !== event.pointerId) return;
      if (lookPointer === event.pointerId) {
        const threshold = event.pointerType === 'touch' ? 10 : 6;
        if (Math.hypot(event.clientX - lookStartX, event.clientY - lookStartY) > threshold) lookDragged = true;
        if (lookDragged) {
          yaw -= (event.clientX - lookX) * 0.004;
          pitch = Math.max(-1.3, Math.min(1.3, pitch - (event.clientY - lookY) * 0.004));
          clearHover();
        }
        lookX = event.clientX; lookY = event.clientY;
      }
    });
    renderer.domElement.addEventListener('pointerup', event => {
      if (lookPointer !== event.pointerId) return;
      lookPointer = null; lookDragged = false;
      if (renderer.domElement.hasPointerCapture?.(event.pointerId)) renderer.domElement.releasePointerCapture(event.pointerId);
    });
    for (const name of ['pointercancel', 'lostpointercapture']) renderer.domElement.addEventListener(name, event => {
      if (lookPointer !== event.pointerId) return;
      lookPointer = null; lookDragged = false; clearHover();
    });
    document.querySelectorAll('[data-move]').forEach(button => {
      button.addEventListener('pointerdown', event => {
        event.preventDefault(); button.setPointerCapture(event.pointerId); keys[button.dataset.move] = true;
      });
      for (const name of ['pointerup', 'pointercancel', 'lostpointercapture']) button.addEventListener(name, () => { keys[button.dataset.move] = false; });
    });
    addEventListener('keydown', event => {
      if (!exploring || reading || menuOpen || event.target.closest('button, input, select, a')) return;
      keys[event.code] = true;
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].includes(event.code)) event.preventDefault();
      if (event.code === 'Escape' && !event.repeat) showMenu();
      if (['KeyE', 'Enter', 'NumpadEnter'].includes(event.code) && !event.repeat) { event.preventDefault(); interact(); }
    });
    addEventListener('keyup', event => { keys[event.code] = false; });
    addEventListener('blur', () => { if (!reading) showMenu(); else resetInput(); });
    document.addEventListener('visibilitychange', () => {
      resetInput(); frameTimes.length = 0; lastMs = 0;
      if (document.hidden) { if (bookMotion.active) bookMotion.update(1); audioCtx?.suspend(); if (!reading) showMenu(); }
      else if (audioCtx && soundControl.checked) audioCtx.resume().catch(() => {});
    });
    document.getElementById('pause-room').addEventListener('click', event => { event.stopPropagation(); showMenu(); });
    soundControl.addEventListener('change', () => {
      if (masterGain) masterGain.gain.setTargetAtTime(soundControl.checked ? 0.65 : 0, audioCtx.currentTime, 0.1);
    });
    motionControl.addEventListener('change', () => { reduceMotion = motionControl.checked; });
    brightnessControl.addEventListener('input', () => { exposureTarget = Number(brightnessControl.value); renderer.toneMappingExposure = exposureTarget; });
    setTimeout(() => { eyeOpening.classList.add('hidden'); if (!exploring && !reading) showMenu(); }, reduceMotion ? 0 : 1500);

    // ==================================================================
    //  INTERACTION
    // ==================================================================
    const ray = new THREE.Raycaster();
    const centerV = new THREE.Vector2(0, 0);
    let hovered = null; // {type, id/mesh, content, meta}
    const crosshair = document.getElementById('crosshair');
    const label = document.getElementById('object-label');
    const labelInner = label.querySelector('.label-inner');
    const overlay = document.getElementById('reading-overlay');
    const readingContent = document.getElementById('reading-content');
    let movedOnce = false;

    let rayFrame = 0, proxyPull = 0;
    const hoverColor = new THREE.Color();
    function clearHover() {
      crosshair.classList.remove('hovering');
      label.classList.remove('visible');
      proxy.visible = false;
      shell.visible = false;
      hovered = null;
      document.getElementById('touch-read').disabled = true;
      proxyPull = 0;
    }
    function checkHover() {
      if ((lookPointer !== null && lookDragged) || bookMotion.active) { clearHover(); return; }
      camera.updateMatrixWorld();
      ray.setFromCamera(centerV, camera);
      ray.far = 6;
      const bh = ray.intersectObjects([books, adjacent.books]);
      const sh = details.shrineVolume.visible ? ray.intersectObject(details.shrineVolume, true) : [];
      const nearest = Math.min(bh[0]?.distance ?? Infinity, sh[0]?.distance ?? Infinity);
      if (Number.isFinite(nearest)) {
        ray.far = Math.max(0, nearest - 0.025);
        if (ray.intersectObjects(architecture, false).length) { clearHover(); return; }
      }
      let newHover = null;
      if (sh.length && (!bh.length || sh[0].distance <= bh[0].distance)) {
        newHover = { type: 'shrine' };
      } else if (bh.length) {
        newHover = { type: 'book', mesh: bh[0].object, id: bh[0].instanceId, meta: (bh[0].object === books ? bookMeta : adjacent.meta)[bh[0].instanceId] };
      }

      const sameAsBefore = hovered && newHover &&
        ((hovered.type === 'shrine' && newHover.type === 'shrine') ||
         (hovered.type === 'book' && newHover.type === 'book' && hovered.id === newHover.id && hovered.mesh === newHover.mesh));
      if (sameAsBefore) return;

      proxy.visible = false; shell.visible = false;
      if (newHover) {
        if (newHover.type === 'shrine') {
          crosshair.classList.add('hovering');
          labelInner.textContent = 'the book · Plunkitt of Tammany Hall';
        } else {
          const meta = newHover.meta;
          crosshair.classList.add('hovering');
          proxy.position.copy(meta.pos); proxy.rotation.set(meta.lean, meta.rotY, 0); proxy.scale.copy(meta.scale);
          proxyMat.color.copy(hoverColor.fromBufferAttribute(newHover.mesh.instanceColor, newHover.id));
          selectedSpine.color.copy(proxyMat.color);
          const bindingIndex = newHover.id % nQuotes;
          selectedBinding.offset.set((bindingIndex % 16) / 16, (15 - Math.floor(bindingIndex / 16)) / 16);
          proxy.visible = true;
          shell.position.copy(meta.pos); shell.rotation.set(meta.lean, meta.rotY, 0); shell.scale.copy(meta.scale).multiplyScalar(1.06); shell.visible = true;
          labelInner.textContent = meta.content.source;
        }
        label.classList.add('visible');
        playHoverTick();
      } else {
        crosshair.classList.remove('hovering');
        label.classList.remove('visible');
      }
      hovered = newHover;
      document.getElementById('touch-read').disabled = !hovered;
      proxyPull = 0;
    }

    // ---- OPEN / CLOSE BOOK (preserves original overlay logic) ----
    // Paginated page-turning codex state (see the codex functions below)
    let isFullBook = false;
    let bookPages = [], chapterStartPage = [], chapterTitles = [];
    let N = 0, leafCount = 0, PAGE_STEP = 2;
    let curPage = 0, targetPage = 0;
    let bookDims = null;
    let flipping = false, animating = false, openToken = 0;
    let bookEls = null;
    let resizeObs = null, rebuildTimer = null;
    let ribbonMove = null, ribbonUp = null, lastRibbonUp = 0;
    let onBookKey = null;
    let lastTurnSound = 0;
    let _meas = null;
    let readRequest = 0;
    async function openBook(c, selection = null) {
      if (reading) return;
      const request = ++readRequest;
      reading = true;
      resetInput(); syncControls();
      document.getElementById('reader-contents').hidden = !c.isFullBook;
      overlay.setAttribute('aria-label', c.source);
      clearHover();
      document.exitPointerLock?.();
      if (selection?.type === 'book') {
        const meta = selection.meta;
        await bookMotion.borrow({ mesh: selection.mesh, pages: selection.mesh === books ? details.pageEdges : adjacent.pageEdges,
          index: selection.id, position: meta.pos, scale: meta.scale,
          rotation: new THREE.Quaternion().setFromEuler(new THREE.Euler(meta.lean, meta.rotY, 0, 'YXZ')),
          source: c.source, color: new THREE.Color().fromBufferAttribute(selection.mesh.instanceColor, selection.id) }, reduceMotion);
      } else if (selection?.type === 'shrine') await bookMotion.borrowVolume(details.shrineVolume, reduceMotion);
      if (request !== readRequest || !reading) return;
      overlay.classList.add('visible');
      document.getElementById('reader-close').focus({ preventScroll: true });
      duckAmbient(0.5);
      if (c.isFullBook) {
        isFullBook = true;
        document.getElementById('reader-pagination').hidden = false;
        document.getElementById('reader-position').textContent = 'Opening…';
        document.getElementById('reader-prev').disabled = true;
        document.getElementById('reader-next').disabled = true;
        readingContent.classList.add('full-book-view');
        readingContent.innerHTML = `
          <aside class="book-rail">
            <div class="rail-title">Contents</div>
            <div class="rail-chapters" id="rail-chapters"></div>
            <div class="rail-scrub" id="rail-scrub"><div class="rail-scrub-track"></div><div class="rail-ribbon" id="rail-ribbon"></div></div>
            <div class="rail-folio" id="rail-folio"></div>
            <div class="rail-nav"><button class="rail-arrow" id="rail-prev" aria-label="Previous page">‹</button><button class="rail-arrow" id="rail-next" aria-label="Next page">›</button></div>
          </aside>
          <div class="book-stage" id="book-stage" aria-hidden="true">
            <div class="book-spread" id="book-spread">
              <div class="leaf-well leaf-well--left"  id="well-left"></div>
              <div class="leaf-well leaf-well--right" id="well-right"></div>
              <div class="leaf" id="the-leaf"><div class="leaf-face leaf-face--front"></div><div class="leaf-face leaf-face--back"></div><div class="leaf-shade"></div></div>
            </div>
          </div>
          <div class="book-sr-fulltext"><h2>Plunkitt of Tammany Hall — full text</h2>${window.plunkittText}</div>`;
        playShrineOpen();
        const myOpen = ++openToken;
        // let the flex layout settle (two frames) before measuring for pagination
        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
        if (myOpen !== openToken) return;
        await initPaginatedBook(myOpen);
      } else {
        isFullBook = false;
        readingContent.classList.remove('full-book-view');
        readingContent.innerHTML = `
          <div id="reading-text">
            <p class="quote-text">${c.quote}</p>
            <p class="quote-source">— ${c.source}</p>
          </div>
          <span class="close-hint">Press Esc or use Return to the gallery to close</span>`;
        playPageTurn();
      }
    }
    function closeBook() {
      if (!reading) return;
      readRequest++;
      if (isFullBook && N > 1) {
        try { localStorage.setItem('library-plunkitt-position', String(curPage / (N - 1))); } catch {}
      }
      isFullBook = false;
      overlay.classList.remove('visible');
      readingContent.classList.remove('full-book-view', 'contents-open');
      document.getElementById('reader-pagination').hidden = true;
      document.getElementById('reader-contents').setAttribute('aria-expanded', 'false');
      teardownBook();
      // drop any arrow/space still physically held from page-turning, so it doesn't drive
      // the camera once pointer lock is re-acquired
      resetInput();
      duckAmbient(1.0);
      playBookClose();
      bookMotion.returnBook(reduceMotion);
      reading = false;
      hideMenu();
    }

    // =====================================================================
    //  PAGINATED PAGE-TURNING CODEX
    // =====================================================================
    const SPINE_GUTTER = 30, PAGE_PAD_X = 42, PAGE_PAD_TOP = 48, PAGE_PAD_BOT = 52, MAX_SPREAD_H = 760;
    const FLIP_FULL = 480, FLIP_MIN = 90, RIFFLE_CAP = 2400;
    const FLIP_EASING = 'cubic-bezier(0.42,0,0.35,1)';

    const snapToLeaf = p => { p = Math.max(0, Math.min(p, N - 1)); return p - (p % PAGE_STEP); };

    function getMeasureBox(innerW) {
      if (!_meas) { _meas = document.createElement('div'); _meas.className = 'book-measure'; document.body.appendChild(_meas); }
      _meas.style.width = innerW + 'px'; _meas.innerHTML = '';
      return _meas;
    }
    function fontsReady() { return (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve(); }

    async function paginate(rawHTML, innerW, contentH) {
      await fontsReady();
      const parse = document.createElement('div'); parse.innerHTML = rawHTML;
      const nodes = Array.from(parse.children);
      const meas = getMeasureBox(innerW);
      const pages = [], starts = [], titles = [];
      let cur = document.createElement('div');
      const fits = () => meas.scrollHeight <= contentH + 0.5;
      const remeasure = () => { meas.innerHTML = ''; meas.appendChild(cur.cloneNode(true)); };
      const flush = () => { if (cur.childNodes.length) { pages.push(cur.innerHTML); cur = document.createElement('div'); } };
      for (const node of nodes) {
        if (node.tagName === 'H2') {
          flush();
          const raw = node.textContent;
          const disp = raw.match(/^Chapter \d+\./) ? raw.replace(/^Chapter \d+\.\s*/, '') : raw;
          starts.push(pages.length);
          titles.push({ text: raw, disp, section: !raw.startsWith('Chapter') });
          cur.appendChild(node.cloneNode(true));
          continue;
        }
        cur.appendChild(node.cloneNode(true)); remeasure();
        if (fits()) continue;
        cur.removeChild(cur.lastChild);
        splitParagraphAcrossPages(node, meas, contentH, pages, flush, () => cur);
      }
      flush();
      return { pages, chapterStartPage: starts, titles };
    }

    // Fill the current page to the line, then continue the paragraph remainder onto fresh pages.
    function splitParagraphAcrossPages(pNode, meas, contentH, pages, flush, getCur) {
      const words = pNode.textContent.split(/(\s+)/);
      let i = 0, firstFrag = true;
      const fitsWith = frag => { const cur = getCur(); meas.innerHTML = ''; meas.appendChild(cur.cloneNode(true)); meas.appendChild(frag); return meas.scrollHeight <= contentH + 0.5; };
      while (i < words.length) {
        const cur = getCur();
        const frag = document.createElement('p');
        if (!firstFrag) frag.className = 'cont';
        let lo = i + 1, hi = words.length, best = 0;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          frag.textContent = words.slice(i, mid).join('');
          if (fitsWith(frag.cloneNode(true))) { best = mid; lo = mid + 1; } else hi = mid - 1;
        }
        if (best === 0) {
          if (cur.childNodes.length) { flush(); continue; }
          best = i + 1;
        }
        frag.textContent = words.slice(i, best).join('').replace(/^\s+/, '').replace(/\s+$/, '');
        cur.appendChild(frag);
        firstFrag = false;
        i = best;
        if (i < words.length) flush();
      }
    }

    function computeBookDims() {
      const stage = bookEls ? bookEls.stage : document.getElementById('book-stage');
      const cs = getComputedStyle(stage);
      const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
      const padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
      const stageW = stage.clientWidth - padX;
      const stageH = stage.clientHeight - padY;
      const single = PAGE_STEP === 1;
      const spreadH = Math.min(stageH, MAX_SPREAD_H);
      let pageW, spreadW;
      if (single) { pageW = Math.floor(Math.min(stageW, Math.max(280, spreadH * 0.72))); spreadW = pageW; }
      else { pageW = Math.floor(Math.min(stageW / 2, Math.max(280, spreadH * 0.75))); spreadW = pageW * 2; }
      const pageH = Math.floor(spreadH);
      const padInsideX = Math.min(PAGE_PAD_X, Math.max(22, pageW * 0.11));
      const padInsideTop = Math.min(PAGE_PAD_TOP, Math.max(16, pageH * 0.075));
      const padInsideBottom = Math.min(PAGE_PAD_BOT, Math.max(28, pageH * 0.08));
      const innerW = pageW - 2 * padInsideX;
      const contentH = pageH - padInsideTop - padInsideBottom;
      bookDims = { spreadW, spreadH: pageH, pageW, pageH, innerW, contentH };
      const spread = document.getElementById('book-spread');
      spread.style.width = spreadW + 'px'; spread.style.height = pageH + 'px';
      spread.style.setProperty('--page-pad-x', padInsideX + 'px');
      spread.style.setProperty('--page-pad-top', padInsideTop + 'px');
      spread.style.setProperty('--page-pad-bottom', padInsideBottom + 'px');
      spread.style.setProperty('--page-height', pageH + 'px');
      document.querySelectorAll('.leaf-well').forEach(w => { w.style.width = pageW + 'px'; w.style.height = pageH + 'px'; });
      const leaf = document.getElementById('the-leaf');
      leaf.style.width = pageW + 'px'; leaf.style.height = pageH + 'px';
      return innerW > 40 && contentH > 40;
    }

    function pageHTML(i) {
      const body = (i >= 0 && i < N) ? bookPages[i] : '';
      const folio = (i > 0 && i < N && body !== '') ? `<div class="page-folio">${i}</div>` : '';
      return `<div class="page-text">${body}</div>${folio}`;
    }
    function renderSpread(p) {
      if (PAGE_STEP === 2) { bookEls.wellL.innerHTML = pageHTML(p); bookEls.wellR.innerHTML = pageHTML(p + 1); }
      else { bookEls.wellR.innerHTML = pageHTML(p); }
    }

    function turnSound() {
      const now = performance.now();
      if (now - lastTurnSound < 45) return;
      lastTurnSound = now; playPageTurn();
    }

    function animateLeaf(leaf, shade, forward, dur) {
      const kf = forward ? [{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(-180deg)' }]
                         : [{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(180deg)' }];
      const a = leaf.animate(kf, { duration: dur, easing: FLIP_EASING, fill: 'forwards' });
      shade.animate([{ opacity: 0 }, { opacity: 0.5 }, { opacity: 0 }], { duration: dur, easing: 'linear' });
      return a;
    }

    function flipOne(fromPage, dir, dur) {
      return new Promise(resolve => {
        const forward = dir > 0;
        const toPage = fromPage + dir;
        const { leaf, front, back, shade, wellL, wellR } = bookEls;
        if (PAGE_STEP === 2) {
          if (forward) {
            front.innerHTML = pageHTML(fromPage + 1);   // old recto (leaf front, on right)
            back.innerHTML  = pageHTML(toPage);          // new verso (leaf back, lands left)
            wellR.innerHTML = pageHTML(toPage + 1);      // reveal new recto under the lifting leaf
          } else {
            front.innerHTML = pageHTML(fromPage);        // old verso (leaf front, on left)
            back.innerHTML  = pageHTML(toPage + 1);      // new recto (leaf back, lands right)
            wellL.innerHTML = pageHTML(toPage);          // reveal new verso under the lifting leaf
          }
        } else {
          front.innerHTML = pageHTML(fromPage);
          back.innerHTML  = pageHTML(toPage);
        }
        leaf.className = 'leaf ' + (forward ? 'leaf--right' : 'leaf--left');
        leaf.style.display = 'block';
        void leaf.offsetWidth;
        const commitRest = () => {
          if (PAGE_STEP === 2) { if (forward) wellL.innerHTML = pageHTML(toPage); else wellR.innerHTML = pageHTML(toPage + 1); }
          else { wellR.innerHTML = pageHTML(toPage); }
          leaf.style.display = 'none';
        };
        if (dur <= 0) { commitRest(); resolve(); return; }
        const a = animateLeaf(leaf, shade, forward, dur);
        bookEls.currentAnim = a;
        const done = () => { if (bookEls) bookEls.currentAnim = null; commitRest(); resolve(); };
        a.finished.then(done).catch(done);
      });
    }

    // Target-chasing animator: exactly ONE loop ever runs (guarded by `animating`), so no two
    // triggers can ever drive the single shared leaf at once. requestPage only moves the target;
    // the animator turns leaves one at a time toward it, re-planning if the target moves mid-riffle.
    // The exact leaf count between where you are and where you're going is always turned (and sounded).
    function requestPage(p) {
      if (!bookEls || !N) return;
      p = snapToLeaf(p | 0);
      targetPage = p;
      if (reduceMotion) { const changed = p !== curPage; curPage = p; if (changed) turnSound(); renderSpread(curPage); updateRail(); return; }
      updateRailTarget(targetPage);
      if (!animating) runAnimator();
    }
    async function runAnimator() {
      if (animating) return;
      animating = true; flipping = true;
      const myOpen = openToken;                                // a teardown/reopen bumps this → stale loop bails
      const live = () => bookEls && isFullBook && openToken === myOpen;
      try {
        while (live() && curPage !== targetPage) {
          const legTarget = targetPage;                        // plan a leg toward the current target
          const dir = legTarget > curPage ? PAGE_STEP : -PAGE_STEP;
          const n = Math.abs(legTarget - curPage) / PAGE_STEP;
          const budget = Math.floor(RIFFLE_CAP / FLIP_MIN);    // ~26 visible flips affordable
          const stride = n <= 1 ? 1 : Math.max(1, Math.ceil(n / budget));
          const visible = Math.ceil(n / stride);
          const per = n === 1 ? FLIP_FULL : Math.max(FLIP_MIN, Math.min(FLIP_FULL, RIFFLE_CAP / visible));
          for (let i = 0; i < n; i++) {
            if (!live()) return;
            if (targetPage !== legTarget) break;                // re-targeted → re-plan in outer loop
            turnSound();
            const doAnim = (i % stride === 0) || (i === n - 1);
            await flipOne(curPage, dir, doAnim ? per : 0);
            if (!live()) return;
            curPage += dir;
            updateRail(true);
          }
        }
      } finally {
        if (openToken === myOpen) {                             // only reset flags if we still own this book
          animating = false; flipping = false;
          if (bookEls && isFullBook) { renderSpread(curPage); updateRail(); }
        }
      }
    }
    function nextLeaf() { requestPage((animating ? targetPage : curPage) + PAGE_STEP); }
    function prevLeaf() { requestPage((animating ? targetPage : curPage) - PAGE_STEP); }

    function buildRail() {
      const list = document.getElementById('rail-chapters');
      const scrub = document.getElementById('rail-scrub');
      list.innerHTML = '';
      scrub.querySelectorAll('.rail-tick').forEach(t => t.remove());
      chapterTitles.forEach((t, i) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'chapter-nav-item' + (t.section ? ' section' : '');
        item.textContent = t.disp.length > 28 ? t.disp.slice(0, 28) + '…' : t.disp;
        item.title = t.text; item.dataset.i = i;
        item.addEventListener('click', () => {
          requestPage(chapterStartPage[i]);
          if (readingContent.classList.contains('contents-open')) {
            readingContent.classList.remove('contents-open');
            document.getElementById('reader-contents').setAttribute('aria-expanded', 'false');
            document.getElementById('reader-contents').focus({ preventScroll: true });
          }
        });
        list.appendChild(item);
        const tick = document.createElement('div'); tick.className = 'rail-tick'; tick.dataset.i = i;
        tick.style.top = (N > 1 ? chapterStartPage[i] / (N - 1) : 0) * 100 + '%';
        tick.innerHTML = `<span class="rail-tick-label">${t.disp}</span>`;
        tick.addEventListener('click', ev => { ev.stopPropagation(); requestPage(chapterStartPage[i]); });
        scrub.appendChild(tick);
      });
    }
    function fracFromEvent(scrub, ev) { const r = scrub.getBoundingClientRect(); return Math.min(1, Math.max(0, (ev.clientY - r.top) / r.height)); }
    function wireRibbon() {
      const scrub = document.getElementById('rail-scrub');
      const ribbon = document.getElementById('rail-ribbon');
      let dragging = false;
      ribbon.addEventListener('pointerdown', ev => { dragging = true; ribbon.classList.add('dragging'); ev.preventDefault(); ev.stopPropagation(); });
      scrub.addEventListener('pointerdown', ev => { if (ev.target === ribbon || ev.target.classList.contains('rail-tick')) return; requestPage(Math.round(fracFromEvent(scrub, ev) * (N - 1))); });
      // idempotent: drop any prior document listeners before re-adding (defends against a double-wire)
      if (ribbonMove) document.removeEventListener('pointermove', ribbonMove);
      if (ribbonUp) document.removeEventListener('pointerup', ribbonUp);
      ribbonMove = ev => { if (!dragging) return; const f = fracFromEvent(scrub, ev); ribbon.style.top = (f * 100) + '%'; previewFolio(Math.round(f * (N - 1))); };
      ribbonUp = ev => { if (!dragging) return; dragging = false; ribbon.classList.remove('dragging'); lastRibbonUp = performance.now(); ev.stopPropagation(); requestPage(Math.round(fracFromEvent(scrub, ev) * (N - 1))); };
      document.addEventListener('pointermove', ribbonMove);
      document.addEventListener('pointerup', ribbonUp);
    }
    function updateRail() {
      const ribbon = document.getElementById('rail-ribbon');
      const folio = document.getElementById('rail-folio');
      const f = N > 1 ? curPage / (N - 1) : 0;
      if (ribbon && !ribbon.classList.contains('dragging')) ribbon.style.top = (f * 100) + '%';
      if (folio) folio.innerHTML = `Page <b>${curPage + 1}</b> of <b>${N}</b>`;
      let active = 0; for (let i = 0; i < chapterStartPage.length; i++) { if (chapterStartPage[i] <= curPage + PAGE_STEP - 1) active = i; }
      document.querySelectorAll('#rail-chapters .chapter-nav-item').forEach((el, i) => {
        el.classList.toggle('active', i === active);
        if (i === active) el.setAttribute('aria-current', 'location'); else el.removeAttribute('aria-current');
      });
      document.querySelectorAll('#rail-scrub .rail-tick').forEach((el, i) => el.classList.toggle('active', i === active));
      const prev = document.getElementById('rail-prev'), next = document.getElementById('rail-next');
      if (prev) prev.disabled = curPage <= 0;
      if (next) next.disabled = curPage >= N - PAGE_STEP;
      document.getElementById('reader-prev').disabled = curPage <= 0;
      document.getElementById('reader-next').disabled = curPage >= N - PAGE_STEP;
      document.getElementById('reader-position').textContent = PAGE_STEP === 2
        ? `Pages ${curPage + 1}–${Math.min(curPage + 2, N)} of ${N}`
        : `Page ${curPage + 1} of ${N}`;
    }
    function updateRailTarget(p) { const ribbon = document.getElementById('rail-ribbon'); if (ribbon && N > 1) ribbon.style.top = (p / (N - 1) * 100) + '%'; }
    function previewFolio(p) { const folio = document.getElementById('rail-folio'); if (folio) folio.innerHTML = `Page <b>${p + 1}</b> of <b>${N}</b>`; }

    async function paginateAndPlace() {
      if (!computeBookDims()) return null;
      const r = await paginate(window.plunkittText, bookDims.innerW, bookDims.contentH);
      const titlePage = `<h1 class="book-title">Plunkitt of Tammany Hall</h1><p class="book-author">By George Washington Plunkitt</p><p class="book-subtitle">A Series of Very Plain Talks on Very Practical Politics</p>`;
      const pages = [titlePage, ...(PAGE_STEP === 2 ? [''] : []), ...r.pages];
      const starts = r.chapterStartPage.map(p => p + (PAGE_STEP === 2 ? 2 : 1));
      if (pages.length % PAGE_STEP) pages.push('');
      return { pages, starts, titles: r.titles };
    }
    // commit paginated data into module state (only the current open/rebuild ever calls this)
    function applyBookData(d) {
      bookPages = d.pages; chapterStartPage = d.starts; chapterTitles = d.titles;
      N = bookPages.length; leafCount = N / PAGE_STEP;
    }

    function wireBook() {
      const stage = bookEls.stage;
      stage.addEventListener('click', ev => {
        // a page turn replaces the well's innerHTML, detaching ev.target — if this click were
        // allowed to bubble, the document close-handler's e.target.closest('#reading-content')
        // would then be null and it would close the book. Keep book clicks inside the book.
        ev.stopPropagation();
        if (flipping) return;
        const r = stage.getBoundingClientRect();
        const x = ev.clientX - r.left;
        if (x > r.width * 0.62) nextLeaf();
        else if (x < r.width * 0.38) prevLeaf();
      });
      document.getElementById('rail-prev').addEventListener('click', ev => { ev.stopPropagation(); prevLeaf(); });
      document.getElementById('rail-next').addEventListener('click', ev => { ev.stopPropagation(); nextLeaf(); });
      wireRibbon();
      window.addEventListener('keydown', onBookKey);
      // only re-paginate on a genuine size change (ResizeObserver fires once on observe())
      let roW = stage.clientWidth, roH = stage.clientHeight;
      resizeObs = new ResizeObserver(() => {
        const w = stage.clientWidth, h = stage.clientHeight;
        if (w === roW && h === roH) return;
        roW = w; roH = h;
        if (rebuildTimer) clearTimeout(rebuildTimer);
        rebuildTimer = setTimeout(rebuildBook, 250);
      });
      resizeObs.observe(stage);
    }
    function rebuildBook() {
      if (!isFullBook || !bookEls) return;
      // never reflow while a riffle is running — the animator owns curPage/targetPage; defer until idle
      if (animating) { rebuildTimer = setTimeout(rebuildBook, 250); return; }
      const myOpen = openToken;
      const frac = N > 1 ? curPage / (N - 1) : 0;
      const stage = bookEls.stage;
      const single = stage.clientWidth < 620 || (window.matchMedia && window.matchMedia('(max-width:680px)').matches);
      stage.classList.toggle('single', single);
      PAGE_STEP = single ? 1 : 2;
      paginateAndPlace().then(d => {
        if (myOpen !== openToken || !isFullBook || !bookEls || !d) return;
        applyBookData(d);
        curPage = targetPage = snapToLeaf(Math.round(frac * (N - 1)));
        buildRail(); renderSpread(curPage); updateRail();
      });
    }

    const NAV_KEYS = ['ArrowRight', 'ArrowLeft', 'Space', 'PageDown', 'PageUp', 'Home', 'End'];
    onBookKey = e => {
      if (!reading || !isFullBook || !N) return;
      if (!NAV_KEYS.includes(e.code) || e.target.closest('input, select, textarea')) return;
      if (e.code === 'Space' && e.target.closest('button, a')) return;
      e.preventDefault();
      if (e.repeat) return;                       // discrete turns; tap repeatedly to riffle further
      const base = animating ? targetPage : curPage;
      if (e.code === 'ArrowRight') nextLeaf();
      else if (e.code === 'ArrowLeft') prevLeaf();
      else if (e.code === 'Space' || e.code === 'PageDown') requestPage(base + 10 * PAGE_STEP);
      else if (e.code === 'PageUp') requestPage(base - 10 * PAGE_STEP);
      else if (e.code === 'Home') requestPage(0);
      else if (e.code === 'End') requestPage((leafCount - 1) * PAGE_STEP);
    };

    async function initPaginatedBook(myOpen) {
      const stage = document.getElementById('book-stage');
      const single = stage.clientWidth < 620 || (window.matchMedia && window.matchMedia('(max-width:680px)').matches);
      stage.classList.toggle('single', single);
      PAGE_STEP = single ? 1 : 2;
      bookEls = {
        stage,
        spread: document.getElementById('book-spread'),
        wellL: document.getElementById('well-left'),
        wellR: document.getElementById('well-right'),
        leaf: document.getElementById('the-leaf'),
        front: document.querySelector('#the-leaf .leaf-face--front'),
        back: document.querySelector('#the-leaf .leaf-face--back'),
        shade: document.querySelector('#the-leaf .leaf-shade'),
        currentAnim: null
      };
      curPage = 0; targetPage = 0;
      wireBook();   // attach listeners + ResizeObserver first, so a later widen/rotate can recover
                    // even if this initial measure is too narrow to paginate
      let d = await paginateAndPlace();
      if (myOpen !== openToken || !bookEls || !isFullBook) return;   // superseded/closed while paginating
      if (!d) { await new Promise(r => requestAnimationFrame(r)); d = await paginateAndPlace(); if (myOpen !== openToken || !bookEls || !isFullBook || !d) return; }
      applyBookData(d);
      let bookmark = 0;
      try { bookmark = Number(localStorage.getItem('library-plunkitt-position')) || 0; } catch {}
      curPage = snapToLeaf(Math.round(Math.max(0, Math.min(1, bookmark)) * (N - 1)));
      targetPage = curPage;
      buildRail(); renderSpread(curPage); updateRail();
    }

    function teardownBook() {
      openToken++; flipping = false; animating = false;
      if (bookEls && bookEls.currentAnim) { try { bookEls.currentAnim.cancel(); } catch (e) {} }
      if (resizeObs) { resizeObs.disconnect(); resizeObs = null; }
      if (rebuildTimer) { clearTimeout(rebuildTimer); rebuildTimer = null; }
      if (onBookKey) { window.removeEventListener('keydown', onBookKey); }
      if (ribbonMove) { document.removeEventListener('pointermove', ribbonMove); ribbonMove = null; }
      if (ribbonUp) { document.removeEventListener('pointerup', ribbonUp); ribbonUp = null; }
      if (_meas) { _meas.remove(); _meas = null; }
      bookPages = []; chapterStartPage = []; chapterTitles = []; N = 0; leafCount = 0;
      curPage = 0; targetPage = 0; bookDims = null; bookEls = null;
    }

    window.addEventListener('library:read-direct', event => {
      event.preventDefault(); startPrompt.classList.remove('visible');
      openBook({ source: 'Plunkitt of Tammany Hall', isFullBook: true });
    });
    function interact() {
      if (!exploring || reading || menuOpen || bookMotion.active || lookDragged) return;
      euler.set(pitch, yaw, 0); camera.quaternion.setFromEuler(euler);
      camera.updateMatrixWorld(); scene.updateMatrixWorld(); checkHover();
      if (!hovered) return;
      if (hovered.type === 'shrine') openBook({ source: 'Plunkitt of Tammany Hall', isFullBook: true }, hovered);
      else { playBookPull(); openBook(hovered.meta.content, hovered); }
    }
    document.addEventListener('click', event => {
      if (locked && event.button === 0 && (event.target === document.body || event.target === renderer.domElement)) interact();
    });
    document.getElementById('touch-read').addEventListener('click', () => interact());
    document.getElementById('reader-close').addEventListener('click', closeBook);
    document.getElementById('reader-prev').addEventListener('click', prevLeaf);
    document.getElementById('reader-next').addEventListener('click', nextLeaf);
    document.getElementById('reader-contents').addEventListener('click', event => {
      const expanded = readingContent.classList.toggle('contents-open');
      event.currentTarget.setAttribute('aria-expanded', String(expanded));
    });
    overlay.addEventListener('click', event => { if (event.target === overlay) closeBook(); });
    document.addEventListener('keydown', event => {
      if (reading && event.code === 'Escape') { event.preventDefault(); event.stopPropagation(); closeBook(); return; }
      const activeDialog = reading && overlay.classList.contains('visible') ? overlay
        : startPrompt.classList.contains('visible') ? startPrompt : null;
      if (event.code === 'Tab' && activeDialog) {
        const focusable = [...activeDialog.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), [tabindex="0"]')]
          .filter(el => !el.closest('[hidden]') && el.getClientRects().length);
        const first = focusable[0], last = focusable[focusable.length - 1];
        if (!first) return;
        if (event.shiftKey && (document.activeElement === first || !activeDialog.contains(document.activeElement))) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && (document.activeElement === last || !activeDialog.contains(document.activeElement))) { event.preventDefault(); first.focus(); }
      }
    });

    // ==================================================================
    //  COLLISION
    // ==================================================================

    // ==================================================================
    //  MAIN LOOP
    // ==================================================================
    const clock = new THREE.Clock();
    let frameTimes = [], lastMs = 0;
    let lastRender = 0;
    let walked = 0;

    function loop() {
      requestAnimationFrame(loop);
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;
      if (document.hidden) { lastMs = 0; return; }
      const bookWasMoving = bookMotion.active;
      bookMotion.update(dt);
      if (bookWasMoving) renderer.shadowMap.needsUpdate = true;
      if (reading && !bookMotion.active) { lastMs = 0; return; }
      if (menuOpen && !bookMotion.active && introDone && performance.now() - lastRender < 100) return;
      lastRender = performance.now();

      // intro exposure ramp + bloom settle
      if (!introDone) {
        renderer.toneMappingExposure = Math.min(exposureTarget, renderer.toneMappingExposure + dt * 0.8);
        bloom.strength = Math.max(0.55, bloom.strength - dt * 0.32);
        if (renderer.toneMappingExposure >= exposureTarget && bloom.strength <= 0.56) introDone = true;
      }

      if (exploring && !menuOpen && !reading) {
        yaw += ((keys['KeyQ'] ? 1 : 0) - (keys['KeyR'] ? 1 : 0)) * dt * 1.4;
        pitch = Math.max(-1.3, Math.min(1.3, pitch + ((keys['KeyT'] ? 1 : 0) - (keys['KeyG'] ? 1 : 0)) * dt));
        // movement (reuse hoisted scratch vectors — no per-frame allocation)
        const wish = _wish.set(0, 0, 0);
        if (keys['KeyW'] || keys['ArrowUp']) wish.z -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) wish.z += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) wish.x -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) wish.x += 1;
        const moving = wish.lengthSq() > 0;
        wish.normalize();
        // to world using yaw
        const movement = localMovement(wish.x, wish.z, yaw);
        const wishWorld = _wishWorld.set(movement.x, 0, movement.z);
        const maxSpd = keys['ShiftLeft'] || keys['ShiftRight'] ? 3.0 : 2.15;
        vel.x = damp(vel.x, wishWorld.x * maxSpd, moving ? 12 : 18, dt);
        vel.z = damp(vel.z, wishWorld.z * maxSpd, moving ? 12 : 18, dt);
        const previousX = camera.position.x, previousZ = camera.position.z;
        const next = slideMove(camera.position, { x: vel.x * dt, z: vel.z * dt });
        camera.position.x = next.x; camera.position.z = next.z;
        const distance = Math.hypot(next.x - previousX, next.z - previousZ);
        const speedFactor = Math.min(distance / Math.max(dt * maxSpd, 0.001), 1);
        walked += distance;
        bobPhase += distance * 8;
        if (walked > 0.72) { playFootstep(); walked %= 0.72; }
        const bobY = reduceMotion ? 0 : Math.sin(bobPhase) * 0.019 * speedFactor;
        const roll = reduceMotion ? 0 : Math.cos(bobPhase * 0.5) * 0.0015 * speedFactor;
        camera.position.y = damp(camera.position.y, CAM_EYE + bobY, 16, dt);

        // FOV drift while moving forward
        const targetFov = 70 + (!reduceMotion && maxSpd > 2.5 && moving && wish.z < 0 ? 2 : 0) * speedFactor;
        curFov = damp(curFov, targetFov, 6, dt);
        if (Math.abs(camera.fov - curFov) > 0.01) { camera.fov = curFov; camera.updateProjectionMatrix(); }

        euler.set(pitch, yaw, roll);
        camera.quaternion.setFromEuler(euler);

        // reverb swell near railing / in vestibule recesses
        const distCenter = Math.min(Math.hypot(camera.position.x, camera.position.z), Math.hypot(camera.position.x - adjacent.annex.position.x, camera.position.z));
        const nearRail = distCenter < railingR + 0.8;
        const inVest = distCenter > apothem - 0.6;
        setReverbTarget(nearRail || inVest ? 0.36 : 0.22);

        if (moving && !movedOnce) { movedOnce = true; setTimeout(() => { controlsHint.classList.add('faded'); }, 2500); }

        rayFrame++;
        if (rayFrame % 3 === 0) checkHover();
      }

      // proxy pull-out easing (only while actually exploring)
      if (!reading && !menuOpen && hovered && hovered.type === 'book') {
        proxyPull = damp(proxyPull, 1, 12, dt);
        const meta = hovered.meta;
        const off = 0.04 * proxyPull;
        proxy.position.set(meta.pos.x + meta.normal.x * off, meta.pos.y, meta.pos.z + meta.normal.z * off);
        proxyMat.emissiveIntensity = selectedSpine.emissiveIntensity = 0.10 * proxyPull;
      }

      // shrine title glint + spotlight breathe + beam breathe
      const breathe = reduceMotion ? 0.5 : Math.sin(t * 0.6) * 0.5 + 0.5;
      shrineMat.emissiveIntensity = 0.5 + breathe * 0.3;
      spot.intensity = 68 * (1 + Math.sin(t * 0.6) * 0.04);
      beamMat.opacity = 0.16 + Math.sin(t * 0.6) * 0.025;

      // dust animation
      if (dustMat.userData.shader) dustMat.userData.shader.uniforms.uTime.value = reduceMotion ? 0 : t;
      gradePass.uniforms.uTime.value = t;

      // gate the mirror's render pass: only when the player is close AND looking toward it
      if (mirrorObj) {
        const toM = mirrorCenter.clone().sub(camera.position);
        const near = toM.lengthSq() < 49; // within 7m of the glass
        let facing = false;
        if (near) {
          const fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
          facing = fwd.dot(toM.normalize()) > -0.25; // anything but looking hard away
        }
        mirrorObj.visible = near && facing;
      }

      updateReverb(dt);
      if (audioCtx && exploring) {
        const listener = audioCtx.listener;
        const look = _forward.set(0, 0, -1).applyQuaternion(camera.quaternion);
        if (listener.positionX) {
          listener.positionX.value = camera.position.x; listener.positionY.value = camera.position.y; listener.positionZ.value = camera.position.z;
          listener.forwardX.value = look.x; listener.forwardY.value = look.y; listener.forwardZ.value = look.z;
          listener.upX.value = 0; listener.upY.value = 1; listener.upZ.value = 0;
        } else {
          listener.setPosition(camera.position.x, camera.position.y, camera.position.z);
          listener.setOrientation(look.x, look.y, look.z, 0, 1, 0);
        }
      }

      // adaptive DPR guard — measured against real wall-clock frame time (not clamped dt)
      const nowMs = performance.now();
      if (!menuOpen && introDone) {
        if (lastMs) frameTimes.push(nowMs - lastMs);
        lastMs = nowMs;
        if (frameTimes.length >= 180) {
          const maximum = Math.min(devicePixelRatio, matchMedia('(pointer: coarse)').matches ? 1.25 : 1.75);
          const nextRatio = qualityStep(curPixelRatio, maximum, frameTimes);
          frameTimes.length = 0;
          if (nextRatio !== curPixelRatio) { curPixelRatio = nextRatio; applyPixelRatio(curPixelRatio); }
        }
      } else { lastMs = 0; frameTimes.length = 0; }

      composer.render();
    }

    // composer.setPixelRatio()/setSize() resets every pass to full effective resolution,
    // so the intentionally half-res bloom target must be re-asserted afterward.
    function applyPixelRatio(pr) {
      renderer.setPixelRatio(pr);
      composer.setPixelRatio(pr);
      bloom.setSize(innerWidth / 2, innerHeight / 2);
    }

    addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
      composer.setSize(innerWidth, innerHeight);
      bloom.setSize(innerWidth / 2, innerHeight / 2);
    });

    // Local-only inspection hooks — inert on the live site (this script is served inline, so it
    // isn't tree-shaken at build time; a hostname gate keeps it off production).
    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      window.__dbg = {
        look: (y, p) => { yaw = y; pitch = p == null ? 0 : p; locked = true; euler.set(pitch, yaw, 0); camera.quaternion.setFromEuler(euler); },
        pos: (x, z, ay) => { camera.position.set(x, ay == null ? CAM_EYE : ay, z); },
        lock: () => { locked = true; },
        hover: () => checkHover(),
        quote: () => openBook(borgesQuotes[0]),
        full: () => openBook({ source: 'Plunkitt of Tammany Hall', isFullBook: true }),
        close: () => closeBook(),
        finishIntro: () => { renderer.toneMappingExposure = 1.35; bloom.strength = 0.55; introDone = true; composer.render(); },
        exp: (v) => { renderer.toneMappingExposure = v; composer.render(); return v; },
        render: () => composer.render(),
        state: () => ({ hovered: hovered && (hovered.type + (hovered.meta ? ':' + hovered.meta.content.source : '')), exposure: renderer.toneMappingExposure, bloom: bloom.strength, books: books.count }),
      };
    }

    loop();
    document.getElementById('loading-note').textContent = 'A hexagonal gallery. An inexhaustible library.';
    startButton.disabled = false;
    } catch (error) {
      console.error('Library initialization failed', error);
      document.getElementById('eye-opening').classList.add('hidden');
      document.getElementById('start-prompt').classList.add('visible');
      document.getElementById('loading-note').textContent = 'The gallery could not open. You can still read the book below.';
      document.getElementById('start-button').hidden = true;
    }
  </script>
</body>
</html>
