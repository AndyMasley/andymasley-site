      // AO vignette at edges
      const vg = x.createRadialGradient(512, 512, 300, 512, 512, 720);
      vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,0.5)');
      x.fillStyle = vg; x.fillRect(0, 0, 1024, 1024);
      return c;
    }

