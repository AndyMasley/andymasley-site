    // Stone floor / trim
    function stoneTexture() {
      const c = makeCanvas(1024), x = c.getContext('2d');
      x.fillStyle = '#4a4033'; x.fillRect(0, 0, 1024, 1024);
      // mottling
      for (let i = 0; i < 500; i++) {
        const px = Math.random() * 1024, py = Math.random() * 1024, r = 20 + Math.random() * 120;
        const g = x.createRadialGradient(px, py, 0, px, py, r);
        const lite = Math.random() > 0.5;
        g.addColorStop(0, lite ? 'rgba(138,122,99,0.10)' : 'rgba(45,38,30,0.14)');
        g.addColorStop(1, 'rgba(0,0,0,0)');
        x.fillStyle = g; x.beginPath(); x.arc(px, py, r, 0, 7); x.fill();
      }
      // hex tiling grid
      x.strokeStyle = 'rgba(20,16,10,0.55)'; x.lineWidth = 2.5;
      const s = 128, h = s * Math.sqrt(3) / 2;
      for (let row = -1; row < 1024 / h + 1; row++) {
        for (let col = -1; col < 1024 / (s * 1.5) + 1; col++) {
          const cx = col * s * 1.5;
          const cy = row * h * 2 + (col % 2) * h;
          x.beginPath();
          for (let k = 0; k <= 6; k++) {
            const a = (k / 6) * Math.PI * 2;
            const vx = cx + Math.cos(a) * s * 0.5, vy = cy + Math.sin(a) * s * 0.5;
            k === 0 ? x.moveTo(vx, vy) : x.lineTo(vx, vy);
          }
          x.stroke();
