  <div id="crosshair"></div>
  <div id="object-label"><span class="label-inner"></span><span class="label-action">E to open</span></div>
  <div id="controls-hint">Mouse to look · WASD / arrows to move · E to open the highlighted book · ESC menu</div>

  <div id="title-card">
    <div class="tc-over">La Biblioteca de Babel</div>
    <div class="tc-main">The Library</div>
    <div class="tc-rule"></div>
  </div>

  <div id="start-prompt" class="visible" role="dialog" aria-modal="true" aria-label="The library">
    <div class="menu-panel">
      <div class="menu-eyebrow">The Library of Babel</div>
      <button class="prompt-text" id="start-button" disabled>Enter the gallery</button>
      <p id="loading-note" role="status">Opening the library…</p>
      <div class="prompt-instructions">Move the mouse to look · WASD / arrows to move<br>Aim the center dot at a book and press E to open it<br>Q / R look left / right · T / G look up / down</div>
      <div class="room-settings">
        <label><input type="checkbox" id="room-sound" checked> Sound</label>
        <label><input type="checkbox" id="room-motion"> Still camera</label>
        <label for="room-brightness">Lamplight <input id="room-brightness" type="range" min="0.8" max="2" step="0.05" value="1.35"></label>
      </div>
      <button id="read-without-3d" class="room-text-button">Read Plunkitt</button>
      <a href="/" class="prompt-home">← return to the main website</a>
    </div>
  </div>

  <div id="room-toolbar"><button id="pause-room" aria-label="Pause and open settings">Pause</button></div>
