      { source: "About the Classics", quote: "A classic is a book that a nation or a group of people has decided to read as if everything in it were deliberate, fatal, profound." },
    ];

    // --- SCENE ---
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(DARK);

    const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(0, 1.7, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    document.body.appendChild(renderer.domElement);

    // --- MATERIALS ---
    const lineMat = new THREE.LineBasicMaterial({ color: LIGHT });
    const dimMat = new THREE.LineBasicMaterial({ color: LIGHT, transparent: true, opacity: 0.3 });

    const interactiveObjects = [];
    let quoteIdx = 0;

    function addLine(pts, dim = false) {
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), dim ? dimMat : lineMat));
    }

    // --- ROOM ---
    const R = 5, H = 8;
    const apothem = R * Math.cos(Math.PI / 6);

    function vtx(i, r = R, y = 0) {
      const a = (i / 6) * Math.PI * 2 - Math.PI / 6;
      return new THREE.Vector3(Math.cos(a) * r, y, Math.sin(a) * r);
    }

    // Floor & ceiling outlines
    const floor = [], ceil = [];
    for (let i = 0; i <= 6; i++) { floor.push(vtx(i, R, 0)); ceil.push(vtx(i, R, H)); }
    addLine(floor); addLine(ceil);

    // Vertical edges
    for (let i = 0; i < 6; i++) { const v = vtx(i); addLine([v, new THREE.Vector3(v.x, H, v.z)]); }

    // Floor pattern
    for (let i = 0; i < 6; i++) addLine([new THREE.Vector3(0,0,0), vtx(i)], true);
    addLine([...Array(7)].map((_,i) => vtx(i, R*0.5, 0)), true);

    // Ceiling beams
    for (let i = 0; i < 6; i++) addLine([new THREE.Vector3(0,H,0), vtx(i,R,H)]);

    // Column
    const colR = 0.3;
    for (let y = 0; y <= H; y += 1) {
      const ring = [];
      for (let i = 0; i <= 6; i++) {
        const a = (i/6) * Math.PI * 2;
        ring.push(new THREE.Vector3(Math.cos(a)*colR, y, Math.sin(a)*colR));
      }
      addLine(ring);
    }
    for (let i = 0; i < 6; i++) {
      const a = (i/6) * Math.PI * 2;
      addLine([
        new THREE.Vector3(Math.cos(a)*colR, 0, Math.sin(a)*colR),
        new THREE.Vector3(Math.cos(a)*colR, H, Math.sin(a)*colR)
      ]);
    }

    // --- BOOKSHELVES WITH EXACTLY 242 BOOKS ---
    // 6 walls * 5 shelves = 30 shelves
    // We need to distribute 242 books across these shelves
    // Target: ~8 books per shelf

    const totalBooks = 242;
    const totalShelves = 30;
    const booksPerShelf = [];

    // Calculate how many books per shelf to hit exactly 242
    let remaining = totalBooks;
    for (let i = 0; i < totalShelves; i++) {
      const avgRemaining = remaining / (totalShelves - i);
      // Add some variation but keep it reasonable
      const variation = Math.floor(seededRandom() * 3) - 1; // -1, 0, or 1
      const count = Math.max(6, Math.min(10, Math.round(avgRemaining) + variation));
      const actualCount = Math.min(count, remaining);
      booksPerShelf.push(actualCount);
      remaining -= actualCount;
    }

    // Distribute any remaining books
    while (remaining > 0) {
      for (let i = 0; i < totalShelves && remaining > 0; i++) {
        if (booksPerShelf[i] < 10) {
          booksPerShelf[i]++;
          remaining--;
        }
      }
    }

    let shelfIndex = 0;

    for (let w = 0; w < 6; w++) {
      const wallAng = (w / 6) * Math.PI * 2;
      const outX = Math.cos(wallAng), outZ = Math.sin(wallAng);
      const tanX = -Math.sin(wallAng), tanZ = Math.cos(wallAng);

      const shelfW = R * 0.7;
      const shelfD = 0.25;
      const wallDist = apothem - 0.1;

      for (let s = 0; s < 5; s++) {
        const shelfY = 0.8 + s * 1.2;

        // Shelf corners
        const bl = new THREE.Vector3(
          outX * wallDist + tanX * (-shelfW/2),
          shelfY,
          outZ * wallDist + tanZ * (-shelfW/2)
        );
        const br = new THREE.Vector3(
          outX * wallDist + tanX * (shelfW/2),
          shelfY,
          outZ * wallDist + tanZ * (shelfW/2)
        );
        const fl = new THREE.Vector3(
          bl.x - outX * shelfD, shelfY, bl.z - outZ * shelfD
        );
        const fr = new THREE.Vector3(
          br.x - outX * shelfD, shelfY, br.z - outZ * shelfD
        );

        // Shelf outline
        addLine([bl, br]); addLine([fl, fr]); addLine([bl, fl], true); addLine([br, fr], true);

        // Books for this shelf
        const numBooks = booksPerShelf[shelfIndex];
        shelfIndex++;

        if (numBooks === 0) continue;

        // Books with realistic varying widths, bunched in middle
        const gap = 0.012;

        // Pre-calculate book widths for centering
        const bookWidths = [];
        for (let b = 0; b < numBooks; b++) {
          // Varying widths: thin (0.05) to thick (0.12)
          bookWidths.push(0.05 + seededRandom() * 0.07);
        }
        const totalBooksWidth = bookWidths.reduce((a, b) => a + b, 0) + (numBooks - 1) * gap;

        // Start position to center books on shelf
        let bx = -totalBooksWidth / 2;

        for (let b = 0; b < numBooks && quoteIdx < borgesQuotes.length; b++) {
          const bw = bookWidths[b];
          const bh = 0.28 + seededRandom() * 0.35; // varying heights too

          const bc = bx + bw/2;
          const bookX = outX * (wallDist - shelfD/2) + tanX * bc;
          const bookZ = outZ * (wallDist - shelfD/2) + tanZ * bc;
          const bookY = shelfY + 0.01;

          const hw = bw / 2;
          const c1 = new THREE.Vector3(bookX + tanX*(-hw), bookY, bookZ + tanZ*(-hw));
          const c2 = new THREE.Vector3(bookX + tanX*(hw), bookY, bookZ + tanZ*(hw));
          const c3 = new THREE.Vector3(bookX + tanX*(hw), bookY + bh, bookZ + tanZ*(hw));
          const c4 = new THREE.Vector3(bookX + tanX*(-hw), bookY + bh, bookZ + tanZ*(-hw));

          const spineGeo = new THREE.BufferGeometry().setFromPoints([c1, c2, c3, c4, c1]);
          const spineLine = new THREE.Line(spineGeo, lineMat.clone());
          scene.add(spineLine);

          const hitGeo = new THREE.PlaneGeometry(bw, bh);
          const hitMat = new THREE.MeshBasicMaterial({ visible: false, side: THREE.DoubleSide });
          const hitMesh = new THREE.Mesh(hitGeo, hitMat);
          hitMesh.position.set(bookX, bookY + bh/2, bookZ);
          hitMesh.rotation.y = wallAng;

          hitMesh.userData = {
            isInteractive: true,
            content: borgesQuotes[quoteIdx],
            line: spineLine
          };
          quoteIdx++;
          interactiveObjects.push(hitMesh);
          scene.add(hitMesh);

          bx += bw + gap;
        }
      }
    }

    // --- CONTROLS ---
    let locked = false, reading = false, menuOpen = false;
    let yaw = 0, pitch = 0;
    const euler = new THREE.Euler(0, 0, 0, 'YXZ');
    const keys = {};

    document.addEventListener('keydown', e => {
      keys[e.code] = true;
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) {
        e.preventDefault();
      }
    });
    document.addEventListener('keyup', e => keys[e.code] = false);

    const eyeOpening = document.getElementById('eye-opening');
    const startPrompt = document.getElementById('start-prompt');
    const startButton = document.getElementById('start-button');

    setTimeout(() => {
      eyeOpening.classList.add('hidden');
      document.body.requestPointerLock();
    }, 1900);

    function showMenu() {
      menuOpen = true;
      document.exitPointerLock();
      startPrompt.classList.add('visible');
    }

    function hideMenu() {
      menuOpen = false;
      startPrompt.classList.remove('visible');
      document.body.requestPointerLock();
    }

    startButton.addEventListener('click', hideMenu);

    document.addEventListener('pointerlockchange', () => {
      const wasLocked = locked;
      locked = document.pointerLockElement === document.body;
      if (wasLocked && !locked && !reading) {
        menuOpen = true;
        startPrompt.classList.add('visible');
      }
    });

    document.addEventListener('mousemove', e => {
      if (!locked || reading) return;
      yaw -= e.movementX * 0.002;
      pitch -= e.movementY * 0.002;
      pitch = Math.max(-1.2, Math.min(1.2, pitch));
      euler.set(pitch, yaw, 0);
      camera.quaternion.setFromEuler(euler);
    });

    // --- INTERACTION ---
    const ray = new THREE.Raycaster();
    const center = new THREE.Vector2(0, 0);
    let hovered = null;

    const crosshair = document.getElementById('crosshair');
    const label = document.getElementById('object-label');
    const overlay = document.getElementById('reading-overlay');
    const rText = document.getElementById('reading-text');

    function checkHover() {
      ray.setFromCamera(center, camera);
      const hits = ray.intersectObjects(interactiveObjects);

      if (hovered?.userData.line) hovered.userData.line.material.color.setHex(LIGHT);

      if (hits.length && hits[0].distance < 6) {
        hovered = hits[0].object;
        hovered.userData.line.material.color.setHex(0xffffff);
        crosshair.classList.add('hovering');
        // Show truncated quote as label
        const q = hovered.userData.content.quote;
        label.textContent = q.length > 40 ? q.substring(0, 40) + '...' : q;
        label.classList.add('visible');
      } else {
        hovered = null;
        crosshair.classList.remove('hovering');
        label.classList.remove('visible');
      }
    }

    function openBook(c) {
      reading = true;
      overlay.classList.add('visible');
      document.exitPointerLock();
      rText.innerHTML = `<p class="quote-text">"${c.quote}"</p><p class="quote-source">— ${c.source}</p>`;
      playPageTurn();
    }

    function closeBook() {
      reading = false;
      overlay.classList.remove('visible');
      document.body.requestPointerLock();
      playBookClose();
    }

    document.addEventListener('click', e => {
      if (e.target.closest('#start-prompt a')) return;

      if (reading) {
        closeBook();
      } else if (hovered && locked) {
        openBook(hovered.userData.content);
      } else if (!locked && !menuOpen) {
        document.body.requestPointerLock();
      }
    });

    document.addEventListener('keydown', e => {
      if (e.code === 'Escape' && reading) {
        closeBook();
      }
    });

    // --- LOOP ---
    const clock = new THREE.Clock();

    function loop() {
      requestAnimationFrame(loop);
      const dt = clock.getDelta();

      if (locked && !reading) {
        const dir = new THREE.Vector3();
        if (keys['KeyW'] || keys['ArrowUp']) dir.z = -1;
        if (keys['KeyS'] || keys['ArrowDown']) dir.z = 1;
        if (keys['KeyA'] || keys['ArrowLeft']) dir.x = -1;
        if (keys['KeyD'] || keys['ArrowRight']) dir.x = 1;
        dir.normalize();

        const move = new THREE.Vector3(dir.x * 3 * dt, 0, dir.z * 3 * dt);
        move.applyQuaternion(camera.quaternion);
        move.y = 0;
        camera.position.add(move);

        // Play footstep if moving
        if (dir.length() > 0) {
          playFootstep();
        }

        const d = Math.hypot(camera.position.x, camera.position.z);
        if (d > apothem - 0.5) {
          const a = Math.atan2(camera.position.z, camera.position.x);
          camera.position.x = Math.cos(a) * (apothem - 0.5);
          camera.position.z = Math.sin(a) * (apothem - 0.5);
        }
        if (d < 0.5) {
          const a = Math.atan2(camera.position.z, camera.position.x);
          camera.position.x = Math.cos(a) * 0.5;
          camera.position.z = Math.sin(a) * 0.5;
        }

        checkHover();
      }

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    loop();
  </script>
