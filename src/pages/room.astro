---
import '@/styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="The Library of Babel">
  <title>The library</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- Immediate dark background to prevent flash / blend with the portal transition -->
  <style>html, body { background: #0a0806; }</style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap" rel="stylesheet">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --gold: #d8b978;
      --gold-dim: #b08d57;
      --ink: #e8d5b0;
      --paper: #efe3c8;
      --paper-shadow: #d8c49b;
      --paper-ink: #2a2016;
      --void: #0a0806;
      --oxblood: #6e2b25;
    }

    body {
      overflow: hidden;
      background-color: #0a0806;
      font-family: 'Source Serif 4', Georgia, serif;
      cursor: auto;
      color: var(--ink);
    }

    canvas { display: block; }

    /* ---------- CROSSHAIR ---------- */
    #crosshair {
      position: fixed;
      top: 50%;
      left: 50%;
      width: 22px;
      height: 22px;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 50;
    }
    #crosshair::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      background: rgba(232, 213, 176, 0.55);
      transition: background 0.18s ease, width 0.18s ease, height 0.18s ease;
    }
    /* the expanding ring */
    #crosshair::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      border: 1px solid rgba(216, 185, 120, 0);
      transform: translate(-50%, -50%) scale(0.4);
      transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), border-color 0.2s ease;
    }
    #crosshair.hovering::before {
      width: 4px;
      height: 4px;
      background: rgba(240, 224, 190, 0.9);
    }
    #crosshair.hovering::after {
      width: 20px;
      height: 20px;
      border-color: rgba(216, 185, 120, 0.9);
      transform: translate(-50%, -50%) scale(1);
    }

    /* ---------- HOVER LABEL ---------- */
    #object-label {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, 30px);
      pointer-events: none;
      z-index: 50;
      opacity: 0;
      transition: opacity 0.18s ease, transform 0.18s ease;
      text-align: center;
      max-width: min(340px, calc(100vw - 32px));
      white-space: normal;
    }
    #object-label.visible {
      opacity: 1;
      transform: translate(-50%, 26px);
    }
    #object-label .label-inner {
      display: inline-block;
      padding: 5px 14px;
      background: rgba(6, 4, 3, 0.72);
      border: 1px solid rgba(216, 185, 120, 0.32);
      border-radius: 2px;
      color: var(--gold);
      font-size: 0.875rem;
      font-variant: small-caps;
      letter-spacing: 0.035em;
      text-transform: lowercase;
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
    }
    #object-label .label-action {
      display: block;
      margin-top: .45rem;
      color: #f5e6c6;
      font-size: .875rem;
      font-weight: 600;
      letter-spacing: .025em;
      text-shadow: 0 1px 4px #000;
    }
    #object-label.filler .label-inner {
      color: rgba(176, 141, 87, 0.55);
      font-variant: normal;
      font-style: italic;
      letter-spacing: 0.3em;
    }

    /* ---------- CONTROLS HINT ---------- */
    #controls-hint {
      position: fixed;
      bottom: 1.4rem;
      left: 50%;
      transform: translateX(-50%);
      color: #e8d5b0;
      font-family: inherit;
      font-size: 0.875rem;
      pointer-events: none;
      text-align: center;
      letter-spacing: 0.025em;
      width: max-content;
      max-width: calc(100vw - 2rem);
      padding: .55rem 1rem;
      background: rgba(10, 8, 6, .72);
      border: 1px solid rgba(216,185,120,.18);
      z-index: 40;
      transition: opacity 0.6s ease;
    }
    #controls-hint.faded { opacity: 0; }

    /* ---------- TITLE CARD ---------- */
    #title-card {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      pointer-events: none;
      z-index: 45;
      opacity: 0;
      transition: opacity 1.1s ease;
    }
    #title-card.visible { opacity: 1; }
    #title-card .tc-over {
      font-size: 0.7rem;
      letter-spacing: 0.44em;
      text-transform: uppercase;
      color: rgba(216, 185, 120, 0.6);
      margin-bottom: 0.9rem;
    }
    #title-card .tc-main {
      font-size: 2.5rem;
      font-weight: 400;
      font-variant: small-caps;
      letter-spacing: 0.34em;
      color: var(--gold);
      text-shadow: 0 0 24px rgba(216, 185, 120, 0.35);
      padding-right: 0.34em; /* balance the letter-spacing */
    }
    #title-card .tc-rule {
      width: 0;
      height: 1px;
      margin: 1.1rem auto 0;
      background: linear-gradient(90deg, transparent, rgba(216,185,120,0.5), transparent);
      transition: width 1.4s ease 0.3s;
    }
    #title-card.visible .tc-rule { width: 260px; }

    /* ---------- START / ESC MENU ---------- */
    #start-prompt {
      position: fixed;
      inset: 0;
      background: rgba(8, 6, 4, 0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 250;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.45s ease, visibility 0.45s ease;
      cursor: auto;
      padding: max(1rem, env(safe-area-inset-top)) 1rem max(1rem, env(safe-area-inset-bottom));
      overflow-y: auto;
    }
    #start-prompt.visible { opacity: 1; visibility: visible; }
    #start-prompt .menu-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 3rem 4rem;
      max-width: 680px;
      max-height: 100%;
      overflow-y: auto;
      flex-shrink: 0;
      border: 1px solid rgba(216, 185, 120, 0.2);
      background: linear-gradient(180deg, rgba(24,18,12,0.6), rgba(12,9,6,0.6));
      box-shadow: 0 30px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(216,185,120,0.08);
    }
    #start-prompt .menu-eyebrow {
      font-size: 0.64rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: rgba(216, 185, 120, 0.55);
      margin-bottom: 1.6rem;
    }
    #start-prompt .prompt-text {
      color: var(--gold);
      font-size: 1.35rem;
      font-variant: small-caps;
      letter-spacing: 0.14em;
      margin-bottom: 1.8rem;
      cursor: pointer;
      transition: color 0.2s ease, text-shadow 0.2s ease;
    }
    #start-prompt .prompt-text:hover {
      color: #f4e4bd;
      text-shadow: 0 0 18px rgba(216, 185, 120, 0.45);
    }
    #start-prompt .prompt-instructions {
      color: #d7c5a1;
      font-family: inherit;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
      text-align: center;
      margin-bottom: 2rem;
    }
    #start-prompt .prompt-home {
      color: rgba(216, 185, 120, 0.7);
      font-size: 0.82rem;
      font-variant: small-caps;
      letter-spacing: 0.12em;
      text-decoration: none;
      border-bottom: 1px solid rgba(216, 185, 120, 0);
      padding-bottom: 2px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    #start-prompt .prompt-home:hover {
      color: #f4e4bd;
      border-color: rgba(216, 185, 120, 0.6);
    }

    /* ---------- READING OVERLAY ---------- */
    #reading-overlay {
      position: fixed;
      inset: 0;
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
      background: rgba(6, 4, 3, 0.62);
      backdrop-filter: blur(7px);
      -webkit-backdrop-filter: blur(7px);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
      cursor: auto;
    }
    #reading-overlay.visible { opacity: 1; visibility: visible; }

    /* aged-paper quote card */
    #reading-content {
      position: relative;
      max-width: 560px;
      max-height: 85vh;
      padding: 3rem 3.2rem 2.4rem;
      overflow-y: auto;
      color: var(--paper-ink);
      background:
        radial-gradient(120% 80% at 15% 10%, rgba(255,250,235,0.55), transparent 60%),
        radial-gradient(130% 90% at 85% 90%, rgba(150,120,80,0.22), transparent 55%),
        radial-gradient(100% 120% at 50% 50%, #f3e8cd 0%, #e7d8b4 70%, #d8c49b 100%);
      border: 1px solid #b6a279;
      box-shadow:
        0 40px 90px rgba(0,0,0,0.55),
        inset 0 0 0 1px rgba(70,52,30,0.35),
        inset 0 0 60px rgba(120,90,55,0.15);
      transform: translateY(10px) scale(0.985) rotate(-0.4deg);
      transition: transform 0.35s cubic-bezier(0.2,0.9,0.3,1);
    }
    #reading-overlay.visible #reading-content {
      transform: translateY(0) scale(1) rotate(-0.4deg);
    }
    /* double keyline frame */
    #reading-content::before {
      content: '';
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(70, 52, 30, 0.4);
      pointer-events: none;
    }
    #reading-content.full-book-view {
      max-width: 1000px;
      width: 92vw;
      max-height: 90vh;
      display: flex;
      padding: 0;
      transform: translateY(0) scale(1) rotate(0deg);
      background:
        radial-gradient(100% 120% at 50% 0%, #f3e8cd 0%, #e7d8b4 72%, #d3bf95 100%);
    }
    #reading-content.full-book-view::before { display: none; }

    #reading-content::-webkit-scrollbar { width: 7px; }
    #reading-content::-webkit-scrollbar-track { background: rgba(70,52,30,0.06); }
    #reading-content::-webkit-scrollbar-thumb { background: rgba(120,90,55,0.4); border-radius: 4px; }

    #reading-content .quote-text {
      font-size: 1.4rem;
      line-height: 1.7;
      color: #2a2016;
      margin-bottom: 1.6rem;
      font-style: italic;
      font-weight: 400;
    }
    #reading-content .quote-text::first-letter {
      float: left;
      font-size: 3.6rem;
      line-height: 0.82;
      padding: 0.05em 0.12em 0 0;
      font-style: normal;
      font-weight: 600;
      color: var(--oxblood);
    }
    #reading-content .quote-source {
      font-size: 0.78rem;
      color: #5c4a2e;
      text-align: right;
      font-variant: small-caps;
      letter-spacing: 0.14em;
      padding-top: 0.9rem;
      border-top: 1px solid rgba(70,52,30,0.25);
      margin-top: 0.4rem;
    }
    #reading-content .close-hint {
      display: block;
      margin-top: 2.2rem;
      color: rgba(70, 52, 30, 0.6);
      font-family: 'SF Mono', SFMono-Regular, Menlo, monospace;
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      text-align: center;
    }

    /* ---------- FULL BOOK (codex) ---------- */
    .chapter-nav {
      width: 250px;
      min-width: 250px;
      background: linear-gradient(180deg, #241a10, #17100a);
      border-right: 1px solid rgba(216, 185, 120, 0.25);
      padding: 1.5rem 0;
      overflow-y: auto;
      max-height: 90vh;
    }
    .chapter-nav::-webkit-scrollbar { width: 5px; }
    .chapter-nav::-webkit-scrollbar-track { background: rgba(216,185,120,0.05); }
    .chapter-nav::-webkit-scrollbar-thumb { background: rgba(216,185,120,0.35); border-radius: 3px; }

    .chapter-nav-title {
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.24em;
      color: var(--gold);
      padding: 0.5rem 1.5rem 1.1rem;
      font-weight: 600;
    }
    .chapter-nav-item {
      display: block;
      padding: 0.55rem 1.5rem;
      font-size: 0.8rem;
      line-height: 1.35;
      color: rgba(216, 185, 120, 0.62);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.12s ease;
      border-left: 2px solid transparent;
    }
    .chapter-nav-item:hover {
      color: #f4e4bd;
      background: rgba(216, 185, 120, 0.08);
      border-left-color: rgba(216, 185, 120, 0.4);
    }
    .chapter-nav-item.active {
      color: #f6e8c6;
      background: rgba(216, 185, 120, 0.13);
      border-left-color: var(--gold);
      font-weight: 500;
    }
    .chapter-nav-item.section { font-style: italic; color: rgba(216,185,120,0.42); }
    .chapter-nav-item.section.active { color: #e0cfa4; }

    .book-main {
      flex: 1;
      padding: 3rem 3.5rem;
      overflow-y: auto;
      max-height: 90vh;
      color: #2a2016;
      background:
        radial-gradient(120% 60% at 50% 0%, rgba(255,250,235,0.5), transparent 55%),
        linear-gradient(180deg, #efe3c8, #e3d3ac);
    }
    .book-main::-webkit-scrollbar { width: 9px; }
    .book-main::-webkit-scrollbar-track { background: rgba(70,52,30,0.06); }
    .book-main::-webkit-scrollbar-thumb { background: rgba(120,90,55,0.4); border-radius: 4px; }

    .full-book { text-align: left; }
    .full-book .book-title {
      font-size: 1.9rem;
      font-weight: 700;
      font-variant: small-caps;
      text-align: center;
      margin-bottom: 0.6rem;
      letter-spacing: 0.1em;
      color: #3a1512;
    }
    .full-book .book-author {
      font-size: 1rem;
      text-align: center;
      color: #5c4a2e;
      margin-bottom: 0.25rem;
    }
    .full-book .book-subtitle {
      font-size: 0.85rem;
      text-align: center;
      font-style: italic;
      color: #6b5838;
      margin-bottom: 2.2rem;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid rgba(70,52,30,0.28);
    }
    .full-book .book-content { font-size: 0.98rem; line-height: 1.85; color: #2a2016; }
    .full-book .book-content p { margin-bottom: 1.2em; text-align: justify; }
    .full-book .book-content h2.chapter-title {
      display: block;
      font-size: 0.9rem;
      font-weight: 700;
      font-variant: small-caps;
      margin: 3rem 0 1.6rem 0;
      padding: 1rem 1.5rem;
      text-align: center;
      color: #3a1512;
      background: linear-gradient(180deg, rgba(120,90,55,0.16), rgba(120,90,55,0.06));
      border-top: 1px solid rgba(70,52,30,0.35);
      border-bottom: 1px solid rgba(70,52,30,0.35);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      scroll-margin-top: 1rem;
      white-space: normal;
    }
    .full-book .book-content h2.chapter-title:first-of-type { margin-top: 0; }

    /* ---------- PAGINATED CODEX (page-turning reader) ---------- */
    #reading-content.full-book-view { padding: 0; gap: 0; height: 90vh; }

    .book-stage {
      flex: 1; position: relative; display: flex; align-items: center; justify-content: center;
      padding: 34px 30px; overflow: hidden;
      perspective: 2400px; perspective-origin: 50% 42%;
      background:
        radial-gradient(120% 60% at 50% 0%, rgba(255,250,235,0.45), transparent 55%),
        linear-gradient(180deg, #2a1e12, #1c130b);
    }
    .book-spread { position: relative; display: flex; transform-style: preserve-3d;
      box-shadow: 0 30px 70px rgba(0,0,0,0.55), 0 6px 18px rgba(0,0,0,0.4); }
    .book-spread::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 30px; transform: translateX(-50%);
      background: linear-gradient(90deg, rgba(40,26,14,0) 0%, rgba(40,26,14,0.38) 42%, rgba(40,26,14,0.5) 50%, rgba(40,26,14,0.38) 58%, rgba(40,26,14,0) 100%);
      pointer-events: none; z-index: 5; }
    .book-stage.single .book-spread::after { display: none; }
    .book-stage.single #well-left { display: none; }

    .leaf-well { position: relative; overflow: hidden;
      background: radial-gradient(120% 90% at 50% 0%, rgba(255,250,235,0.5), transparent 55%), linear-gradient(180deg, #efe3c8, #e3d3ac);
      box-shadow: inset 0 0 60px rgba(120,90,55,0.14); }
    .leaf-well--left  { border-radius: 3px 0 0 3px; box-shadow: inset 0 0 60px rgba(120,90,55,0.14), inset -22px 0 34px -18px rgba(40,26,14,0.55); }
    .leaf-well--right { border-radius: 0 3px 3px 0; box-shadow: inset 0 0 60px rgba(120,90,55,0.14), inset  22px 0 34px -18px rgba(40,26,14,0.55); }

    /* shared typography for live pages + offscreen measure box (identical metrics) */
    .page-text, .book-measure { font-size: 0.98rem; line-height: 1.85; color: #2a2016;
      text-align: justify; font-family: inherit; box-sizing: border-box; }
    .page-text p, .book-measure p { margin: 0 0 1.2em 0; }
    .page-text p.cont:first-child, .book-measure p.cont:first-child { margin-top: 0; }
    .page-text h2.chapter-title, .book-measure h2.chapter-title {
      display: block; font-size: 0.9rem; font-weight: 700; font-variant: small-caps;
      margin: 0 0 1.4rem 0; padding: 0.8rem 1rem; text-align: center; color: #3a1512;
      background: linear-gradient(180deg, rgba(120,90,55,0.16), rgba(120,90,55,0.06));
      border-top: 1px solid rgba(70,52,30,0.35); border-bottom: 1px solid rgba(70,52,30,0.35);
      letter-spacing: 0.14em; text-transform: uppercase; }
    .book-measure { position: fixed; left: -99999px; top: 0; visibility: hidden; padding: 0; height: auto; }

    .page-text { position: absolute; inset: var(--page-pad-top, 48px) var(--page-pad-x, 42px) var(--page-pad-bottom, 52px); overflow-y: auto; scrollbar-width: thin; }
    .page-text .book-title { font-size: 1.5rem; font-weight: 700; font-variant: small-caps; text-align: center;
      letter-spacing: 0.1em; color: #3a1512; margin-top: max(0px, calc((var(--page-height, 600px) - 420px) / 2)); }
    .page-text .book-author { text-align: center; color: #5c4a2e; margin: 0.9rem 0 0.3rem; }
    .page-text .book-subtitle { text-align: center; font-style: italic; color: #6b5838; font-size: 0.85rem;
      padding-top: 1rem; margin-top: 0.6rem; border-top: 1px solid rgba(70,52,30,0.28); }
    .page-folio { position: absolute; bottom: 16px; left: 0; right: 0; text-align: center;
      font-variant: small-caps; letter-spacing: 0.18em; font-size: 0.62rem; color: rgba(70,52,30,0.55); }

    /* the ONE reused animating leaf */
    .leaf { position: absolute; top: 0; height: 100%; width: 50%; transform-style: preserve-3d; z-index: 20;
      will-change: transform; display: none; contain: layout paint; }
    .book-stage.single .leaf { width: 100%; }
    .leaf.leaf--right { right: 0; left: auto; transform-origin: left center; }
    .leaf.leaf--left  { left: 0;  right: auto; transform-origin: right center; }
    .book-stage.single .leaf.leaf--right, .book-stage.single .leaf.leaf--left { left: 0; right: 0; transform-origin: left center; }

    .leaf-face { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden;
      background: radial-gradient(120% 90% at 50% 0%, rgba(255,250,235,0.5), transparent 55%), linear-gradient(180deg, #efe3c8, #e3d3ac); }
    .leaf-face--front { transform: rotateY(0deg);   border-radius: 0 3px 3px 0; }
    .leaf-face--back  { transform: rotateY(180deg); border-radius: 3px 0 0 3px; filter: brightness(0.985); }
    .leaf-shade { position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, rgba(30,18,8,0) 0%, rgba(30,18,8,0.35) 100%); opacity: 0; }
    @media (prefers-reduced-motion: reduce) { .leaf-shade { display: none; } }

    /* left tracker rail */
    .book-rail { width: 232px; min-width: 232px; display: flex; flex-direction: column; padding: 1.4rem 0 1.1rem;
      position: relative; background: linear-gradient(180deg, #241a10, #17100a);
      border-right: 1px solid rgba(216,185,120,0.28); box-shadow: inset -14px 0 26px -18px rgba(0,0,0,0.7); }
    .rail-title { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.24em; color: var(--gold);
      font-weight: 600; text-align: center; padding: 0 1.2rem 1rem; }
    .rail-chapters { overflow-y: auto; flex: 1 1 auto; min-height: 0; }
    .rail-chapters::-webkit-scrollbar { width: 5px; }
    .rail-chapters::-webkit-scrollbar-thumb { background: rgba(216,185,120,0.35); border-radius: 3px; }

    .rail-scrub { position: relative; flex: 0 0 auto; height: 170px; margin: 1.1rem 1.4rem 0.4rem; cursor: pointer; }
    .rail-scrub-track { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%);
      background: repeating-linear-gradient(180deg, rgba(216,185,120,0.16) 0 1px, transparent 1px 3px);
      box-shadow: 0 0 0 1px rgba(216,185,120,0.10); border-radius: 2px; }
    .rail-tick { position: absolute; left: calc(50% - 8px); width: 16px; height: 1px; background: rgba(176,141,87,0.6);
      pointer-events: auto; cursor: pointer; }
    .rail-tick:hover { background: var(--gold); box-shadow: 0 0 6px rgba(216,185,120,0.6); }
    .rail-tick.active { background: var(--gold); width: 20px; height: 2px; }
    .rail-tick-label { position: absolute; left: 16px; top: -0.6em; white-space: nowrap; font-size: 0.6rem; color: #f4e4bd;
      background: rgba(20,14,8,0.94); border: 1px solid rgba(216,185,120,0.3); padding: 2px 7px; border-radius: 3px;
      opacity: 0; transform: translateX(-4px); transition: opacity .12s, transform .12s; pointer-events: none; z-index: 6; }
    .rail-tick:hover .rail-tick-label { opacity: 1; transform: translateX(0); }
    .rail-ribbon { position: absolute; left: 50%; width: 18px; height: 18px; margin-left: -9px; transform: translateY(-50%);
      z-index: 8; cursor: grab; border-radius: 50%;
