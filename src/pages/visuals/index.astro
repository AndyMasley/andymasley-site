---
import SectionPage from '@/layouts/SectionPage.astro';

const visuals = [
  { title: 'Factory-farmed chickens', href: '/visuals/factory-farmed-chickens' },
  { title: 'Carbon footprint calculator', href: '/visuals/carbon-footprint' },
  { title: 'How thirsty is AI?', href: '/visuals/water' },
  { title: 'What does your AI use cost?', href: '/visuals/ai-prompt-footprint' },
  { title: 'PM2.5 exposure by county', href: '/visuals/pm25-county-exposure' },
];
---

<SectionPage
  title="Visuals"
  description="Interactive data visualizations on factory farming, carbon footprints, and AI water usage."
  ogImage="/og/page/visuals.png"
>
  <ul class="annotated-list">
    {visuals.map(v => (
      <li class="annotated-list__item">
        <div class="annotated-list__row">
          <a href={v.href} class="annotated-list__title">{v.title}</a>
        </div>
      </li>
    ))}
  </ul>
</SectionPage>
