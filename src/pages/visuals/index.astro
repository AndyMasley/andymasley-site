---
import Base from '@/layouts/Base.astro';
---

<Base title="Visuals" description="Interactive data visualizations">
  <ul class="viz-index">
    <li>
      <a href="/visuals/factory-farmed-chickens">Factory-farmed chickens</a>
    </li>
    <li>
      <a href="/visuals/carbon-footprint">Carbon footprint</a>
    </li>
    <li>
      <a href="/visuals/water">How thirsty is AI?</a>
    </li>
  </ul>

</Base>

<style>
  .viz-index {
    list-style: disc;
    padding-left: var(--space-lg);
  }

  .viz-index li {
    margin-bottom: var(--space-sm);
  }

  .viz-index a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>
