---
import SectionPage from '@/layouts/SectionPage.astro';

const visuals = [
  { title: 'Factory-farmed chickens', href: '/visuals/factory-farmed-chickens', date: 'Mar 2026', interactive: true },
  { title: 'Carbon footprint calculator', href: '/visuals/carbon-footprint', date: 'Mar 2026', interactive: true },
  { title: 'How thirsty is AI?', href: '/visuals/water', date: 'Mar 2026', interactive: true },
  { title: 'What does your AI use cost?', href: '/visuals/ai-prompt-footprint', date: 'Jun 2026', interactive: true },
  { title: 'PM2.5 exposure by county', href: '/visuals/pm25-county-exposure', date: 'May 2026', interactive: true },
];
---

<SectionPage
  title="Visuals"
  description="Interactive data visualizations on factory farming, carbon footprints, and AI water usage."
  ogImage="/images/og/og-visuals.png"
>
  <ul class="annotated-list">
    {visuals.map(v => (
      <li class="annotated-list__item">
        <div class="annotated-list__row">
          <a href={v.href} class="annotated-list__title">{v.title}</a>
          <span class="annotated-list__meta">{v.date}{v.interactive && ' · interactive'}</span>
        </div>
      </li>
    ))}
  </ul>
</SectionPage>
