---
import Base from '@/layouts/Base.astro';

const targetPath = '/visuals/carbon-footprint';
const targetUrl = 'https://andymasley.com/visuals/carbon-footprint';
---

<Base
  title="Carbon Footprint Calculator (Moved)"
  description="This page has moved to the current carbon footprint calculator."
  canonicalUrl={targetUrl}
  noindex={true}
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${targetPath}`} />

  <section class="redirect-page">
    <h1>Carbon Footprint Calculator</h1>
    <p>This page has moved to the <a href={targetPath}>current carbon footprint calculator</a>.</p>
  </section>
</Base>

<style>
  .redirect-page {
    max-width: 42rem;
  }
</style>
