---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Air pollution sources by county"
  description="Look up the sources of fine particulate (PM2.5) and ozone-forming pollutants (NOx, VOCs) in any U.S. county. Built from the EPA's 2020 National Emissions Inventory."
>
  <header class="aps-hero">
    <h1 class="aps-hero-title">Air pollution sources in your county</h1>
    <p class="aps-hero-sub">See where PM<sub>2.5</sub>, NO<sub>x</sub>, and VOC emissions come from, how your county compares with health guidelines, and which sources cause the most estimated harm.</p>
    <p class="aps-hero-source">Data from the EPA's 2020 National Emissions Inventory and 2025 EPA monitor readings. Your county is estimated from your location — you can change it below.</p>
  </header>

  <article class="aps" id="aps">

    <!-- County picker card -->
    <section class="aps-card aps-picker" aria-labelledby="aps-picker-title">
      <div class="aps-picker-head">
        <h2 class="aps-card-title" id="aps-picker-title">Choose a county</h2>
        <div class="aps-picker-current" id="aps-picker-current" aria-live="polite"></div>
      </div>
      <div class="aps-picker-controls">
        <label class="aps-field">
          <span class="aps-field-label">State</span>
          <select id="aps-state" aria-label="Select state"></select>
        </label>
        <label class="aps-field">
          <span class="aps-field-label">County</span>
          <select id="aps-county" aria-label="Select county" disabled></select>
        </label>
        <div class="aps-picker-actions">
          <button class="aps-btn" type="button" id="aps-locate" title="Use my location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
            <span>Use my location</span>
          </button>
          <button class="aps-btn aps-btn-ghost" type="button" id="aps-share" title="Copy link to this county">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            <span id="aps-share-label">Copy link</span>
          </button>
        </div>
      </div>
    </section>

    <!-- County summary strip -->
    <section class="aps-summary" id="aps-summary" aria-live="polite">
      <div class="aps-summary-loading">Loading county data…</div>
    </section>

    <!-- Air quality metric cards -->
    <section class="aps-section" aria-labelledby="aps-aq-title">
      <div class="aps-section-head">
        <div>
          <h2 class="aps-section-title" id="aps-aq-title">What you're breathing</h2>
          <p class="aps-section-desc">2025 EPA monitor readings, compared with the EPA's NAAQS limits and the stricter WHO guidelines.</p>
        </div>
      </div>
      <div class="aps-aq-grid" id="aps-aq-grid"></div>
      <p class="aps-aq-note" id="aps-aq-note"></p>
    </section>

    <!-- Explainer: emissions vs concentration -->
    <aside class="aps-explainer" aria-label="Emissions are not the same as what you breathe">
      <h3>Emissions are not the same as what you breathe</h3>
      <p>Emissions show what local sources release. Air monitor readings above show what was actually measured. Smoke and ozone drift across county lines — and ozone isn't directly emitted at all. It forms when NO<sub>x</sub> and VOCs react in sunlight, so the ozone chart below shows precursor emissions.</p>
    </aside>

    <!-- Emissions section -->
    <section class="aps-section" aria-labelledby="aps-em-title">
      <div class="aps-section-head aps-section-head-row">
        <div>
          <h2 class="aps-section-title" id="aps-em-title">Where emissions come from</h2>
          <p class="aps-section-desc" id="aps-em-desc">Top source categories for the selected county. Switch the metric to compare total emissions, emissions per person, or estimated dollars of health harm.</p>
        </div>
        <div class="aps-mode" role="tablist" aria-label="Emissions metric">
          <button class="aps-mode-btn" role="tab" aria-selected="true" data-mode="raw" data-active="true">Total emissions</button>
          <button class="aps-mode-btn" role="tab" aria-selected="false" data-mode="percap" data-active="false">Per person</button>
          <button class="aps-mode-btn" role="tab" aria-selected="false" data-mode="damage" data-active="false">Health cost</button>
        </div>
      </div>

      <p class="aps-mode-note" id="aps-mode-note"></p>

      <div class="aps-charts" id="aps-charts"></div>

      <!-- Sortable source table -->
      <div class="aps-table-wrap">
        <div class="aps-table-head">
          <h3 class="aps-table-title">All sources by pollutant</h3>
          <span class="aps-table-hint">Click a column header to sort. Hover a row to highlight matching bars.</span>
        </div>
        <div class="aps-table-scroll">
          <table class="aps-table" id="aps-table">
            <thead>
              <tr>
                <th scope="col" data-col="source" class="aps-th-source">Source</th>
                <th scope="col" data-col="pm25" class="aps-th-num">PM<sub>2.5</sub><span class="aps-th-unit" id="aps-unit-pm25">t/yr</span></th>
                <th scope="col" data-col="nox" class="aps-th-num">NO<sub>x</sub><span class="aps-th-unit" id="aps-unit-nox">t/yr</span></th>
                <th scope="col" data-col="voc" class="aps-th-num">VOC<span class="aps-th-unit" id="aps-unit-voc">t/yr</span></th>
              </tr>
            </thead>
            <tbody id="aps-table-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Caveats -->
    <aside class="aps-caveats" aria-labelledby="aps-cav-title">
      <h3 id="aps-cav-title">Important caveats</h3>
      <ul>
        <li>Emissions inventories estimate what sources <em>release</em>, not exactly what residents breathe.</li>
        <li>Ozone is not directly emitted — NO<sub>x</sub> and VOCs are shown as its precursors.</li>
        <li>Health-cost values are approximate national averages by source category, not exact medical predictions.</li>
        <li>"Per person" divides local emissions by the county population — it doesn't mean each person personally caused that amount.</li>
      </ul>
    </aside>

    <!-- Tooltip -->
    <div class="aps-tip" id="aps-tip" style="display:none" role="tooltip" aria-hidden="true">
      <div class="aps-tip-header">
        <span class="aps-tip-swatch" id="aps-tip-swatch"></span>
        <span class="aps-tip-name" id="aps-tip-name"></span>
      </div>
      <div class="aps-tip-stats" id="aps-tip-stats"></div>
      <div class="aps-tip-cmp" id="aps-tip-cmp"></div>
      <div class="aps-tip-desc" id="aps-tip-desc"></div>
    </div>

    <!-- Methodology accordion -->
    <details class="aps-meth">
      <summary>
        <span class="aps-meth-title">Methodology and caveats</span>
        <svg class="aps-meth-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </summary>
      <div class="aps-meth-body">
        <h4>Data sources</h4>
        <p>EPA 2020 National Emissions Inventory (NEI), released March 2023. The 2023 NEI has not yet been published. Population estimates: U.S. Census Bureau's 2024 county population estimates. Air-quality measurements: EPA Air Quality System (AQS) 2025 annual concentration summaries (released November 2025).</p>

        <h4>Pollutants and monitor coverage</h4>
        <p>For each pollutant, the value shown is the maximum across all monitors in the county — this matches how the EPA evaluates NAAQS compliance. About 640 counties have a PM<sub>2.5</sub> monitor, 740 have ozone, and 240 have NO<sub>2</sub>; the rest are listed as "Not monitored." NAAQS thresholds: PM<sub>2.5</sub> 9 µg/m³ annual (2024 revision), ozone 70 ppb 8-hr (2015), NO<sub>2</sub> 53 ppb annual (1971).</p>

        <h4>Emissions vs. concentration</h4>
        <p>The bar charts show what's emitted from sources <em>inside</em> your county. The "What you're breathing" cards show what's actually measured in the air. These can differ substantially: distant wildfire smoke, ozone formed downwind from upwind NO<sub>x</sub> sources, and PM<sub>2.5</sub> that drifted in from neighboring counties show up at the monitors without appearing in local emissions.</p>

        <h4>Source categories</h4>
        <p>The EPA's 59 published source sectors are rolled up here into 13 readable buckets: on-road vehicles; off-road equipment; aircraft, ships, trains; power plants; industrial fuel combustion; residential heating; industrial processes; oil &amp; gas production; wildfires and prescribed burns; dust; agriculture; solvents and coatings; other; plus natural background (biogenic VOCs).</p>

        <h4>How "per person" is calculated</h4>
        <p>Total county emissions divided by 2024 population. This is a normalization, not an exposure metric — pollution disperses across regions, and a rural county with one refinery or a major wildfire can look catastrophically high per resident even though most people don't breathe those emissions directly.</p>

        <h4>How health cost is estimated</h4>
        <p>Each ton is multiplied by a source-specific marginal damage value (2019 USD, mortality at 3% discount). Not all tons are equal — a ton of urban diesel exhaust causes roughly 50× the health damage of a ton of road dust. Per-ton damage factors used (national averages):</p>
        <ul>
          <li>PM<sub>2.5</sub>: on-road ~$2.2M/ton, off-road ~$1.7M, residential heating ~$1.4M, industrial fuel combustion ~$900K, industrial processes ~$700K, solvents ~$400K, aircraft/ships/trains ~$400K, oil &amp; gas ~$150K, wildfires ~$130K, power plants ~$110K, agriculture ~$100K, dust ~$40K.</li>
          <li>NO<sub>x</sub>: ~$10K–$20K/ton depending on source (forms secondary PM<sub>2.5</sub> and ozone).</li>
          <li>VOC: ~$1.5K–$4.5K/ton depending on source (ozone precursor; small contribution to secondary PM<sub>2.5</sub>).</li>
        </ul>
        <p>Derived from EPA OAQPS Benefit-per-Ton memos and <a href="https://www.pnas.org/doi/10.1073/pnas.1816102116" target="_blank" rel="noopener">Goodkind et al. 2019 (PNAS)</a>. Real marginal damage depends on stack height, season, prevailing winds, and proximity to population. Treat dollar figures as order-of-magnitude rankings.</p>

        <h4>Health-impact framing in air-quality cards</h4>
        <ul>
          <li><em>PM<sub>2.5</sub> → cigarettes/day equivalent.</em> Berkeley Earth: ~22 µg/m³ continuous PM<sub>2.5</sub> ≈ one cigarette/day mortality-risk equivalent (<a href="https://berkeleyearth.org/air-pollution-and-cigarette-equivalence/" target="_blank" rel="noopener">link</a>).</li>
          <li><em>PM<sub>2.5</sub> → life expectancy.</em> Air Quality Life Index (Greenstone &amp; Pande, EPIC): each 1 µg/m³ above the WHO 5 µg/m³ guideline ≈ 0.098 years (≈36 days) lost (<a href="https://aqli.epic.uchicago.edu/" target="_blank" rel="noopener">aqli.epic.uchicago.edu</a>).</li>
          <li><em>Ozone → respiratory mortality risk.</em> Jerrett et al. 2009 (<em>NEJM</em>): each 10 ppb increase ≈ +4% respiratory mortality. Baseline: WHO 60 ppb.</li>
          <li><em>NO<sub>2</sub> → pediatric asthma risk.</em> Khreis et al. 2017 (<em>Environment International</em>) meta-analysis: each 4 µg/m³ (~2 ppb) ≈ +5% pediatric asthma incidence. Baseline: WHO 10 µg/m³ (~5 ppb).</li>
        </ul>

        <h4>Known limitations</h4>
        <ul>
          <li>Tribal-area rows are excluded from county totals.</li>
          <li>2020 was an extreme wildfire year on the West Coast; bars vary substantially year to year.</li>
          <li>Biogenic VOCs from vegetation and soils are shown as "natural background" — not actionable through policy.</li>
          <li>Health impact metrics use the maximum monitor in the county, which is consistent with NAAQS evaluation but biases toward the most-polluted area.</li>
        </ul>

        <p class="aps-meth-foot">Source code: <a href="https://github.com/AndyMasley/andymasley-site" target="_blank" rel="noopener">on GitHub</a>. Preprocessing script: <code>scripts/build-air-pollution-data.py</code>.</p>
      </div>
    </details>

    <!-- Hidden a11y summary, updated by JS -->
    <div class="aps-sr-only" id="aps-sr-summary" aria-live="polite"></div>
  </article>
</Base>

<style>
  /* Break out of the 640px main-content width */
  .aps-hero,
  .aps {
    width: calc(100vw - 48px);
    max-width: 1120px;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 720px) {
    .aps-hero,
    .aps {
      width: calc(100vw - 32px);
    }
  }

  /* ---------------- Hero ---------------- */
  .aps-hero {
    margin-bottom: var(--space-lg);
  }

  .aps-hero-title {
    font-size: clamp(1.875rem, 1.45rem + 1.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 0.6rem;
    color: var(--text);
    text-wrap: balance;
  }

  .aps-hero-sub {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 56rem;
    margin: 0 0 0.5rem;
  }

  .aps-hero-source {
    font-size: var(--font-size-small);
    color: var(--dim);
    margin: 0;
    max-width: 56rem;
  }

  /* ---------------- Cards ---------------- */
  .aps-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem 1.25rem 1.1rem;
    box-shadow: var(--shadow-sm);
  }

  .aps-card-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text);
  }

  /* ---------------- Picker ---------------- */
  .aps-picker {
    margin-bottom: 1rem;
  }

  .aps-picker-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .aps-picker-current {
    font-size: var(--font-size-small);
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .aps-picker-current strong {
    color: var(--text);
    font-weight: 600;
  }

  .aps-picker-controls {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    gap: 0.75rem;
    align-items: end;
  }

  .aps-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .aps-field-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aps-field select {
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 10px 12px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%236b6560' stroke-width='1.6'%3e%3cpolyline points='3 5 6 8 9 5'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 10px center;
    background-size: 12px;
    padding-right: 28px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .aps-field select:hover:not(:disabled) {
    border-color: var(--accent);
  }

  .aps-field select:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .aps-field select:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .aps-picker-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .aps-btn {
    font-family: inherit;
    font-size: var(--font-size-small);
    font-weight: 500;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 9px 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .aps-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .aps-btn:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .aps-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--dim);
  }

  .aps-btn[data-copied="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---------------- Summary strip ---------------- */
  .aps-summary {
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    padding: 0.85rem 1.1rem;
    border-radius: 10px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    font-size: var(--font-size-small);
  }

  .aps-summary-loading {
    color: var(--dim);
    font-style: italic;
  }

  .aps-summary-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
  }

  .aps-summary-fact {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .aps-summary-fact strong {
    color: var(--text);
    font-weight: 600;
  }

  .aps-summary-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-left: auto;
  }

  .aps-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid transparent;
    background: var(--bg);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .aps-badge[data-status="exceeds"] {
    color: #8a3a2a;
    background: rgba(185, 89, 69, 0.08);
    border-color: rgba(185, 89, 69, 0.35);
  }

  .aps-badge[data-status="elevated"] {
    color: #7a5826;
    background: rgba(214, 174, 130, 0.18);
    border-color: rgba(214, 174, 130, 0.55);
  }

  .aps-badge[data-status="below"] {
    color: #4a6235;
    background: rgba(139, 153, 104, 0.15);
    border-color: rgba(139, 153, 104, 0.45);
  }

  .aps-badge[data-status="none"] {
    color: var(--dim);
    background: var(--bg-subtle);
    border-color: var(--border);
  }

  [data-theme="dark"] .aps-badge[data-status="exceeds"] { color: #e8a690; }
  [data-theme="dark"] .aps-badge[data-status="elevated"] { color: #e2c895; }
  [data-theme="dark"] .aps-badge[data-status="below"] { color: #b3c490; }

  .aps-badge-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .aps-badge[data-status="exceeds"] .aps-badge-dot { background: #b95945; }
  .aps-badge[data-status="elevated"] .aps-badge-dot { background: #d6ae82; }
  .aps-badge[data-status="below"] .aps-badge-dot { background: #8b9968; }
  .aps-badge[data-status="none"] .aps-badge-dot { background: #b8b3ad; }

  /* ---------------- Sections ---------------- */
  .aps-section {
    margin: 0 0 2.25rem;
  }

  .aps-section-head {
    margin-bottom: 1.1rem;
  }

  .aps-section-head-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .aps-section-title {
    font-size: 1.4rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
    color: var(--text);
    line-height: 1.2;
  }

  .aps-section-desc {
    font-size: var(--font-size-small);
    color: var(--dim);
    margin: 0;
    max-width: 52rem;
    line-height: 1.5;
  }

  /* ---------------- Air-quality metric cards ---------------- */
  .aps-aq-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .aps-aq-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.1rem 1.15rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .aps-aq-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--border-strong);
  }

  .aps-aq-card[data-status="exceeds"]::before { background: #b95945; }
  .aps-aq-card[data-status="elevated"]::before { background: #d6ae82; }
  .aps-aq-card[data-status="below"]::before { background: #8b9968; }

  .aps-aq-card-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .aps-aq-card-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .aps-aq-card-plain {
    font-size: 0.78rem;
    color: var(--dim);
    line-height: 1.3;
    margin: -2px 0 0;
  }

  .aps-aq-card-value {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-top: 0.15rem;
  }

  .aps-aq-card-value sup {
    font-size: 0.46em;
    font-weight: 500;
    color: var(--dim);
    margin-left: 4px;
    vertical-align: 0.4em;
  }

  .aps-aq-card-status {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .aps-aq-card-status strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Mini benchmark bar */
  .aps-aq-bench {
    margin-top: 0.25rem;
  }

  .aps-aq-bench-track {
    position: relative;
    height: 6px;
    background: var(--bg-subtle);
    border-radius: 3px;
    overflow: visible;
  }

  .aps-aq-bench-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background: linear-gradient(90deg, #8b9968 0%, #d6ae82 65%, #b95945 100%);
    border-radius: 3px;
    transition: width 0.4s ease;
  }

  .aps-aq-bench-marker {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: var(--text);
  }

  .aps-aq-bench-marker[data-kind="who"] {
    background: rgba(74, 98, 53, 0.85);
  }
  .aps-aq-bench-marker[data-kind="naaqs"] {
    background: rgba(185, 89, 69, 0.85);
  }

