      if (v >= 1_000_000_000) return `$${(v / 1_000_000_000).toFixed(1)}B`;
      if (v >= 100_000_000)   return `$${Math.round(v / 1_000_000)}M`;
      if (v >= 1_000_000)     return `$${(v / 1_000_000).toFixed(1)}M`;
      if (v >= 100_000)       return `$${Math.round(v / 1_000)}K`;
      if (v >= 1_000)         return `$${(v / 1_000).toFixed(0)}K`;
      return `$${Math.round(v)}`;
    }
    function fmtPop(n) {
      if (!n) return "—";
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2)} million`;
      if (n >= 100_000)   return `${Math.round(n / 1_000)}K`;
      return n.toLocaleString("en-US");
    }
    function fmtAq(v, unit) {
      if (v == null) return "—";
      const digits = unit === "µg/m³" ? 1 : 0;
      return v.toFixed(digits);
    }

    // Per-person formatting: emissions in tons/yr per county may be tiny per person.
    // Convert to lbs/yr per person (1 ton ≈ 2000 lb) for legibility.
    function transformValue(v, mode, pop, pollutant, bucket) {
      if (mode === "damage") return v * damageFactor(pollutant, bucket);
      if (mode === "percap" && pop > 0) return (v * 2000) / pop; // lbs / person / yr
      return v;
    }

    function fmtByMode(v, mode) {
      if (v === 0) return "0";
      if (mode === "damage") return fmtDollars(v);
      if (mode === "percap") {
        if (v < 0.01) return v.toFixed(3);
        if (v < 1) return v.toFixed(2);
        if (v < 100) return v.toFixed(1);
        return Math.round(v).toLocaleString("en-US");
      }
      return fmtNum(v);
    }

    function fmtTotal(v, mode) {
      if (mode === "damage") return fmtDollars(v);
      if (mode === "percap") {
        if (v < 1) return v.toFixed(2);
        if (v < 100) return v.toFixed(1);
        return Math.round(v).toLocaleString("en-US");
      }
      // Total emissions: compact for readability
      return fmtCompact(v);
    }

    function unitFor(mode) {
      if (mode === "damage") return "/yr in health cost";
      if (mode === "percap") return "lbs/person/yr";
      return "tons/yr";
    }

    function shortUnitFor(mode) {
      if (mode === "damage") return "$";
      if (mode === "percap") return "lb/person/yr";
      return "t/yr";
    }

    // ---------- State ----------
    const state = {
      counties: null,
      currentState: null,
      currentCounty: null,
      stateEmissions: {},
      mode: "raw",
      airQuality: null,
      currentCountyData: null,
      currentPop: 0,
      sortCol: "default",  // default = pm25 descending; otherwise the col key
      sortDir: "desc",
      loaded: false,
    };

    // ---------- Data loading ----------
    async function loadCounties() {
      const r = await fetch("/data/air-pollution/counties.json");
      state.counties = await r.json();
    }
    async function loadStaticExtras() {
      try {
        const aq = await fetch("/data/air-pollution/air_quality.json").then(r => r.json());
        state.airQuality = aq;
      } catch (e) {
        state.airQuality = null;
      }
    }
    async function loadStateEmissions(ss) {
      if (state.stateEmissions[ss]) return state.stateEmissions[ss];
      const r = await fetch(`/data/air-pollution/emissions/${ss}.json`);
      const data = await r.json();
      state.stateEmissions[ss] = data;
      return data;
    }

    function findCountyMeta(fips5) {
      const ss = fips5.slice(0, 2);
      const list = state.counties.counties[ss] || [];
      return list.find(c => c.fips === fips5) || null;
    }
    function findStateMeta(ss) {
      return state.counties.states.find(s => s.fips === ss) || null;
    }

    // ---------- Selector ----------
    function populateStates() {
      const sel = document.getElementById("aps-state");
      sel.innerHTML = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "Select a state…";
      placeholder.disabled = true;
      placeholder.selected = true;
      sel.appendChild(placeholder);
      for (const s of state.counties.states) {
        const o = document.createElement("option");
        o.value = s.fips;
        o.textContent = s.name;
        sel.appendChild(o);
      }
    }

    function populateCounties(ss, preferFips) {
      const sel = document.getElementById("aps-county");
      sel.innerHTML = "";
      const list = state.counties.counties[ss] || [];
      if (!list.length) {
        sel.disabled = true;
        return;
      }
      sel.disabled = false;
      for (const c of list) {
        const o = document.createElement("option");
        o.value = c.fips;
        o.textContent = c.name;
        sel.appendChild(o);
      }
      if (preferFips && list.some(c => c.fips === preferFips)) {
        sel.value = preferFips;
      } else if (list[0]) {
        sel.value = list[0].fips;
      }
    }

    // ---------- Air quality cards ----------
    function aqStatus(v, naaqs) {
      if (v == null || naaqs == null) return "none";
      if (v >= naaqs) return "exceeds";
      if (v >= 0.75 * naaqs) return "elevated";
      return "below";
    }

    function statusBadge(metric, status) {
      if (status === "none") return { text: "Not monitored", status: "none" };
      if (status === "exceeds") return { text: `${metric}: above NAAQS`, status: "exceeds" };
      if (status === "elevated") return { text: `${metric}: near NAAQS`, status: "elevated" };
      return { text: `${metric}: below NAAQS`, status: "below" };
    }

    function healthImpact(metricKey, value) {
      if (value == null || !isFinite(value)) return null;
      if (metricKey === "pm25_annual") {
        const cig = value / 22;
        const aboveWho = Math.max(0, value - 5);
        const monthsLost = aboveWho * 0.098 * 12;
        const cigStr = cig >= 1
          ? `≈ ${cig.toFixed(1)} cig/day equivalent`
          : `≈ ${cig.toFixed(2)} cig/day equivalent`;
        const lifeStr = monthsLost < 0.5
          ? "below the WHO guideline (5 µg/m³)"
          : monthsLost >= 24
            ? `~${(monthsLost / 12).toFixed(1)} years of life expectancy lost vs WHO`
            : `~${Math.round(monthsLost)} months of life expectancy lost vs WHO`;
        return `${cigStr} · ${lifeStr}`;
      }
      if (metricKey === "ozone_8hr") {
        const above = value - 60;
        if (above <= 0) return "below the WHO guideline (60 ppb)";
        const pct = (above / 10) * 4;
        return `+${pct.toFixed(0)}% respiratory mortality risk vs WHO (60 ppb)`;
      }
      if (metricKey === "no2_annual") {
        const above = value - 5;
        if (above <= 0) return "below the WHO guideline (10 µg/m³ ≈ 5 ppb)";
        const pct = (above / 2) * 5;
        return `+${pct.toFixed(0)}% pediatric asthma risk vs WHO (10 µg/m³)`;
      }
      return null;
    }

    function renderAirQuality(fips5) {
      const grid = document.getElementById("aps-aq-grid");
      const note = document.getElementById("aps-aq-note");
      grid.innerHTML = "";
      note.textContent = "";
      const aq = state.airQuality;
      if (!aq) {
        note.textContent = "Monitor data unavailable.";
        return [];
      }
      const countyMetrics = aq.counties[fips5] || {};
      const out = [];
      let anyMonitor = false;

      for (const m of AQ_METRICS) {
        const v = countyMetrics[m.key];
        const naaqs = aq.naaqs[m.key]?.value;
        const natAvg = aq.national_avg[m.key];
        const status = aqStatus(v, naaqs);
        if (v != null) anyMonitor = true;

        const card = document.createElement("article");
        card.className = "aps-aq-card";
        card.dataset.status = status;

        // Title row
        const title = document.createElement("div");
        title.className = "aps-aq-card-title";
        const name = document.createElement("span");
        name.className = "aps-aq-card-name";
        name.innerHTML = m.long;
        title.appendChild(name);
        card.appendChild(title);

        const plain = document.createElement("div");
        plain.className = "aps-aq-card-plain";
        plain.textContent = m.plain;
        card.appendChild(plain);

        // Main value
        const value = document.createElement("div");
        value.className = "aps-aq-card-value";
        if (v == null) {
          value.textContent = "Not monitored";
        } else {
          value.innerHTML = `${fmtAq(v, m.unit)}<sup>${m.unit}</sup>`;
        }
        card.appendChild(value);

        // Status / comparison line
        const statusLine = document.createElement("div");
        statusLine.className = "aps-aq-card-status";
        if (v != null) {
          const cmp = v >= naaqs ? "above" : v >= 0.75 * naaqs ? "near" : "below";
          statusLine.innerHTML = `<strong>${cmp.charAt(0).toUpperCase() + cmp.slice(1)} NAAQS</strong> (${naaqs} ${m.unit}) · national avg ${fmtAq(natAvg, m.unit)} ${m.unit}`;
        } else {
          statusLine.innerHTML = `No monitor in this county · NAAQS ${naaqs} ${m.unit} · national avg ${fmtAq(natAvg, m.unit)}`;
        }
        card.appendChild(statusLine);

        // Mini benchmark bar
        if (v != null) {
          const bench = document.createElement("div");
          bench.className = "aps-aq-bench";

          const track = document.createElement("div");
          track.className = "aps-aq-bench-track";

          // Scale: 0 to max(naaqs * 1.5, value * 1.1, naaqs * 1.05)
          const scaleMax = Math.max(naaqs * 1.5, v * 1.1, naaqs * 1.05);
          const fill = document.createElement("div");
          fill.className = "aps-aq-bench-fill";
          fill.style.width = `${Math.min(100, (v / scaleMax) * 100).toFixed(1)}%`;
          track.appendChild(fill);

          // WHO marker
          const whoPct = (m.whoLimit / scaleMax) * 100;
          if (whoPct > 0 && whoPct < 100) {
            const whoMk = document.createElement("div");
            whoMk.className = "aps-aq-bench-marker";
            whoMk.dataset.kind = "who";
            whoMk.style.left = `${whoPct.toFixed(1)}%`;
            whoMk.title = `WHO guideline: ${m.whoLimit} ${m.whoUnit}`;
            track.appendChild(whoMk);
          }
          // NAAQS marker
          const naaqsPct = (naaqs / scaleMax) * 100;
          if (naaqsPct > 0 && naaqsPct < 100) {
            const naMk = document.createElement("div");
            naMk.className = "aps-aq-bench-marker";
            naMk.dataset.kind = "naaqs";
            naMk.style.left = `${naaqsPct.toFixed(1)}%`;
            naMk.title = `NAAQS limit: ${naaqs} ${m.unit}`;
            track.appendChild(naMk);
          }

          bench.appendChild(track);

          const labels = document.createElement("div");
          labels.className = "aps-aq-bench-labels";
          labels.innerHTML = `<span>WHO ${m.whoLimit}</span><span>NAAQS ${naaqs}</span>`;
          bench.appendChild(labels);

          card.appendChild(bench);
        }

        // Health interpretation
        const harmText = healthImpact(m.key, v);
        if (harmText) {
          const harm = document.createElement("div");
          harm.className = "aps-aq-card-harm";
          harm.textContent = harmText;
          card.appendChild(harm);
        }

        grid.appendChild(card);
        out.push({ metric: m, status, value: v });
      }

      if (!anyMonitor) {
        const monStr = AQ_METRICS
          .map(m => `${m.short} ${aq.n_monitored[m.key]}`)
          .join(" · ");
        note.textContent = `No EPA air-quality monitors in this county. Nationally, only ${monStr} counties have monitors (of 3,245).`;
      }
      return out;
    }

    // ---------- Summary strip ----------
    function renderSummary(fips5, aqResults) {
      const el = document.getElementById("aps-summary");
      el.innerHTML = "";

      const meta = findCountyMeta(fips5);
      const stateMeta = findStateMeta(fips5.slice(0, 2));

      const name = document.createElement("div");
      name.className = "aps-summary-name";
      name.textContent = `${meta ? meta.name : fips5} County, ${stateMeta ? stateMeta.name : ""}`;
      el.appendChild(name);

      if (meta && meta.pop) {
        const pop = document.createElement("div");
        pop.className = "aps-summary-fact";
        pop.innerHTML = `<strong>${fmtPop(meta.pop)}</strong> residents`;
        el.appendChild(pop);
      }

      const src = document.createElement("div");
      src.className = "aps-summary-fact";
      src.innerHTML = `EPA NEI 2020 emissions · AQS 2025 monitors`;
      el.appendChild(src);

      const badges = document.createElement("div");
      badges.className = "aps-summary-badges";
      for (const r of aqResults) {
        const b = document.createElement("span");
        b.className = "aps-badge";
        b.dataset.status = r.status;
        const dot = document.createElement("span");
        dot.className = "aps-badge-dot";
        b.appendChild(dot);
        const txt = document.createElement("span");
        if (r.status === "none") {
          txt.textContent = `${r.metric.short}: not monitored`;
        } else if (r.status === "exceeds") {
          txt.textContent = `${r.metric.short}: above NAAQS`;
        } else if (r.status === "elevated") {
          txt.textContent = `${r.metric.short}: near NAAQS`;
        } else {
          txt.textContent = `${r.metric.short}: below NAAQS`;
        }
        b.appendChild(txt);
        badges.appendChild(b);
      }
      el.appendChild(badges);
    }

    // ---------- Ranked bar charts ----------
    function segsForPollutant(p, valuesByBucket, mode, pop) {
      const segs = BUCKETS
        .filter(b => valuesByBucket[b.name] !== undefined && valuesByBucket[b.name] > 0)
        .map(b => ({
          name: b.name, display: b.display, color: b.color, natural: !!b.natural,
          value: transformValue(valuesByBucket[b.name], mode, pop, p, b.name),
        }))
        .filter(s => s.value > 0);
      segs.sort((a, b) => b.value - a.value);
      return segs;
    }

    function topSegments(segs) {
      if (segs.length <= TOP_N) return { rows: segs, hasOther: false };
      const top = segs.slice(0, TOP_N);
      const rest = segs.slice(TOP_N);
      const otherTotal = rest.reduce((s, x) => s + x.value, 0);
      const rows = [...top, {
        name: "_other_aggregate",
        display: `Other (${rest.length} sources)`,
        color: "#a8a39b",
        natural: false,
        value: otherTotal,
        aggregate: true,
      }];
      return { rows, hasOther: true };
    }

    function renderCharts(county, pop) {
      const wrap = document.getElementById("aps-charts");
      wrap.innerHTML = "";

      const summaries = [];

      for (const p of POLLUTANTS) {
        const segs = segsForPollutant(p, county[p] || {}, state.mode, pop);
        const total = segs.reduce((s, x) => s + x.value, 0);

        const card = document.createElement("article");
        card.className = "aps-chart-card";
        card.dataset.poll = p;

        const head = document.createElement("div");
        head.className = "aps-chart-head";

        const namEl = document.createElement("div");
        namEl.className = "aps-chart-name";
        namEl.innerHTML = `${POLL_LABEL[p]} <span style="color:var(--dim);font-weight:500;font-size:0.78rem;margin-left:4px;">${POLL_LONG[p]}</span>`;
        head.appendChild(namEl);

        const totEl = document.createElement("div");
        totEl.className = "aps-chart-total";
        if (total > 0) {
          totEl.innerHTML = `${fmtTotal(total, state.mode)}<span class="aps-chart-total-unit">${unitFor(state.mode)}</span>`;
        } else {
          totEl.innerHTML = `<span style="color:var(--dim);font-size:1rem;font-weight:500;">No reported emissions</span>`;
        }
        head.appendChild(totEl);

        const blurb = document.createElement("div");
        blurb.className = "aps-chart-top";
        if (segs.length) {
          const top = segs[0];
          const topPct = ((top.value / total) * 100).toFixed(0);
          blurb.innerHTML = `Top source: <strong>${top.display}</strong> · ${topPct}%`;
        } else {
          blurb.innerHTML = POLL_BLURB[p];
        }
        head.appendChild(blurb);

        card.appendChild(head);

        // Bars
        if (segs.length === 0) {
          const empty = document.createElement("div");
          empty.className = "aps-chart-empty";
          empty.textContent = "No reported emissions for this pollutant.";
          card.appendChild(empty);
        } else {
          const bars = document.createElement("div");
          bars.className = "aps-bars";

          const { rows } = topSegments(segs);
          const maxVal = rows.reduce((m, r) => Math.max(m, r.value), 0);

          for (const r of rows) {
            const row = document.createElement("div");
            row.className = "aps-bar-row";
            if (!r.aggregate) row.dataset.bucket = r.name;
            if (r.natural) row.dataset.natural = "true";
            row.setAttribute("tabindex", "0");
            row.setAttribute("role", "button");
            const pct = total > 0 ? ((r.value / total) * 100) : 0;
            const ariaTxt = `${r.display}: ${fmtByMode(r.value, state.mode)} ${shortUnitFor(state.mode)}, ${pct.toFixed(0)} percent`;
            row.setAttribute("aria-label", ariaTxt);

            const label = document.createElement("div");
            label.className = "aps-bar-label";
            const nm = document.createElement("span");
            nm.className = "aps-bar-name";
            nm.textContent = r.display;
            const vv = document.createElement("span");
            vv.className = "aps-bar-value";
            vv.innerHTML = `${fmtByMode(r.value, state.mode)}<span class="aps-bar-pct">${pct.toFixed(0)}%</span>`;
            label.appendChild(nm);
            label.appendChild(vv);

            const track = document.createElement("div");
            track.className = "aps-bar-track";
            const fill = document.createElement("div");
            fill.className = "aps-bar-fill";
            fill.style.width = `${maxVal > 0 ? (r.value / maxVal) * 100 : 0}%`;
            fill.style.background = r.color;
            track.appendChild(fill);

            row.appendChild(label);
            row.appendChild(track);
            bars.appendChild(row);
          }

          card.appendChild(bars);
        }

        wrap.appendChild(card);

        // Build a11y summary for this chart
        if (segs.length) {
          const top3 = segs.slice(0, 3).map(s => `${s.display} at ${fmtByMode(s.value, state.mode)} ${shortUnitFor(state.mode)}`).join(", ");
          summaries.push(`${POLL_LABEL[p]} emissions total ${fmtTotal(total, state.mode)} ${unitFor(state.mode)}. Largest sources: ${top3}.`);
        } else {
          summaries.push(`${POLL_LABEL[p]}: no reported emissions for this county.`);
        }
      }

      const sr = document.getElementById("aps-sr-summary");
      if (sr) sr.textContent = summaries.join(" ");
    }

    // ---------- Source table ----------
    function buildTableRows(county, mode, pop) {
      const totals = {};
      for (const p of POLLUTANTS) {
        let t = 0;
        for (const b of BUCKETS) {
          const raw = county[p] ? county[p][b.name] : undefined;
          if (raw !== undefined) t += transformValue(raw, mode, pop, p, b.name);
        }
        totals[p] = t;
      }
      const tops = {};
      for (const p of POLLUTANTS) {
        let bestName = null, bestV = 0;
        for (const b of BUCKETS) {
          const raw = county[p] ? county[p][b.name] : undefined;
          if (raw === undefined) continue;
          const v = transformValue(raw, mode, pop, p, b.name);
          if (v > bestV) { bestV = v; bestName = b.name; }
        }
        tops[p] = bestName;
      }
      const rows = BUCKETS.map(b => {
        const values = {};
        const shares = {};
        let anyPresent = false;
        for (const p of POLLUTANTS) {
          const raw = county[p] ? county[p][b.name] : undefined;
          if (raw === undefined) { values[p] = null; shares[p] = null; continue; }
          const v = transformValue(raw, mode, pop, p, b.name);
          values[p] = v;
          shares[p] = totals[p] > 0 ? v / totals[p] : 0;
          if (v > 0) anyPresent = true;
        }
        return { bucket: b, values, shares, anyPresent };
      }).filter(r => r.anyPresent);

      return { rows, totals, tops };
    }

    function sortRows(rows) {
      const col = state.sortCol;
      const dir = state.sortDir === "asc" ? 1 : -1;
      if (col === "source") {
        rows.sort((a, b) => a.bucket.display.localeCompare(b.bucket.display) * dir);
      } else if (col === "default") {
        // Default: natural background last, otherwise by combined share desc
        rows.sort((a, b) => {
          if (a.bucket.natural && !b.bucket.natural) return 1;
          if (!a.bucket.natural && b.bucket.natural) return -1;
          const aShare = POLLUTANTS.reduce((s, p) => s + (a.shares[p] ?? 0), 0);
          const bShare = POLLUTANTS.reduce((s, p) => s + (b.shares[p] ?? 0), 0);
          return bShare - aShare;
        });
      } else {
        // Sort by pollutant value
        rows.sort((a, b) => {
          const av = a.values[col] ?? -1;
          const bv = b.values[col] ?? -1;
          return (av - bv) * dir;
        });
      }
      return rows;
    }

    function renderTable(county, mode, pop) {
      const { rows, tops } = buildTableRows(county, mode, pop);
      sortRows(rows);

      const tbody = document.getElementById("aps-table-body");
      tbody.innerHTML = "";

      for (const r of rows) {
        const tr = document.createElement("tr");
        tr.dataset.bucket = r.bucket.name;
        if (r.bucket.natural) tr.dataset.natural = "true";

        const tdSrc = document.createElement("td");
        tdSrc.className = "aps-td-source";
        const inner = document.createElement("span");
        inner.className = "aps-td-source-inner";
        inner.style.display = "inline-flex";
        inner.style.alignItems = "center";
        inner.style.gap = "9px";
        const sw = document.createElement("span");
        sw.className = "aps-swatch";
        sw.style.background = r.bucket.color;
        const nm = document.createElement("span");
        nm.textContent = r.bucket.display;
        inner.appendChild(sw);
        inner.appendChild(nm);
        tdSrc.appendChild(inner);
        tr.appendChild(tdSrc);

        for (const p of POLLUTANTS) {
          const td = document.createElement("td");
          td.className = "aps-td-num";
          const v = r.values[p];
          const isTop = tops[p] === r.bucket.name && v != null && v > 0;
          if (isTop) td.dataset.topHere = "true";
          if (v === null) {
            td.textContent = "—";
            td.classList.add("aps-td-zero");
          } else if (v === 0) {
            td.textContent = "0";
            td.classList.add("aps-td-zero");
          } else {
            const share = r.shares[p];
            const sharePct = share != null && share > 0 ? `${(share * 100).toFixed(0)}%` : null;
            td.innerHTML = `${fmtByMode(v, mode)}${sharePct ? `<span class="aps-td-share">${sharePct}</span>` : ""}`;
          }
          tr.appendChild(td);
        }
        // Mark any row that's the top for any pollutant
        if (POLLUTANTS.some(p => tops[p] === r.bucket.name)) {
          tr.dataset.top = "true";
        }
        tbody.appendChild(tr);
      }

      // Sort indicators on headers
      document.querySelectorAll("#aps-table thead th").forEach(th => {
        const col = th.dataset.col;
        if (col === state.sortCol) {
          th.dataset.sort = state.sortDir;
        } else {
          delete th.dataset.sort;
        }
      });

      // Update unit labels
      const u = shortUnitFor(state.mode);
      const display = state.mode === "damage" ? "$/yr" : (state.mode === "percap" ? "lb/person/yr" : "t/yr");
      const pmU = document.getElementById("aps-unit-pm25");
      const noU = document.getElementById("aps-unit-nox");
      const vU = document.getElementById("aps-unit-voc");
      if (pmU) pmU.textContent = display;
      if (noU) noU.textContent = display;
      if (vU) vU.textContent = display;
    }

    // ---------- Hover/highlight ----------
    function setHover(bucketName) {
      document.querySelectorAll(".aps-chart-card").forEach(card => {
        if (bucketName) card.dataset.hover = "true";
        else delete card.dataset.hover;
      });
      document.querySelectorAll(".aps-bar-row").forEach(el => {
        el.dataset.active = el.dataset.bucket === bucketName ? "true" : "false";
      });
      document.querySelectorAll("#aps-table-body tr").forEach(el => {
        el.dataset.active = el.dataset.bucket === bucketName ? "true" : "false";
      });
    }

    function statsForBar(row) {
      const bucketName = row.dataset.bucket;
      if (!bucketName) return "";
      const card = row.closest(".aps-chart-card");
      const poll = card && card.dataset.poll;
      const pollLabel = POLL_LABEL[poll] || "";
      const aria = row.getAttribute("aria-label") || "";
      // aria has "Name: value unit, X percent"
      const m = aria.match(/: (.+?), (\d+)/);
      if (!m) return aria;
      return `${pollLabel}: ${m[1]} (${m[2]}% of bar)`;
    }

    function showTip(bucketName, statsText, x, y) {
      const tip = document.getElementById("aps-tip");
      const bucket = BUCKET_BY_NAME[bucketName];
      if (!bucket) return;
      document.getElementById("aps-tip-name").textContent = bucket.display;
      document.getElementById("aps-tip-swatch").style.background = bucket.color;
      document.getElementById("aps-tip-stats").textContent = statsText || "";
      document.getElementById("aps-tip-cmp").textContent = "";
      document.getElementById("aps-tip-desc").textContent = bucket.desc || "";
      tip.style.display = "block";
      tip.setAttribute("aria-hidden", "false");
      positionTip(x, y);
    }
    function hideTip() {
      const tip = document.getElementById("aps-tip");
      tip.style.display = "none";
      tip.setAttribute("aria-hidden", "true");
    }
    function positionTip(x, y) {
      const tip = document.getElementById("aps-tip");
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      const pad = 12;
      let left = x + 14;
      let top = y + 14;
      if (left + w + pad > window.innerWidth) left = x - w - 14;
      if (top + h + pad > window.innerHeight) top = y - h - 14;
      if (left < pad) left = pad;
      if (top < pad) top = pad;
      tip.style.left = left + "px";
      tip.style.top = top + "px";
    }

    function bindHover() {
      const charts = document.getElementById("aps-charts");
      const table = document.getElementById("aps-table");

      charts.addEventListener("mouseover", (e) => {
        const row = e.target.closest(".aps-bar-row[data-bucket]");
        if (row) {
          setHover(row.dataset.bucket);
          showTip(row.dataset.bucket, statsForBar(row), e.clientX, e.clientY);
        }
      });
      charts.addEventListener("mousemove", (e) => {
        const row = e.target.closest(".aps-bar-row[data-bucket]");
        if (row) showTip(row.dataset.bucket, statsForBar(row), e.clientX, e.clientY);
      });
      charts.addEventListener("mouseleave", () => { setHover(null); hideTip(); });
      charts.addEventListener("focusin", (e) => {
        const row = e.target.closest(".aps-bar-row[data-bucket]");
        if (row) {
          setHover(row.dataset.bucket);
          const rect = row.getBoundingClientRect();
          showTip(row.dataset.bucket, statsForBar(row), rect.left + rect.width / 2, rect.bottom);
        }
      });
      charts.addEventListener("focusout", () => { setHover(null); hideTip(); });

      table.addEventListener("mouseover", (e) => {
        const tr = e.target.closest("tr[data-bucket]");
        if (tr) {
          setHover(tr.dataset.bucket);
          showTip(tr.dataset.bucket, "", e.clientX, e.clientY);
        }
      });
      table.addEventListener("mousemove", (e) => {
        const tr = e.target.closest("tr[data-bucket]");
        if (tr) showTip(tr.dataset.bucket, "", e.clientX, e.clientY);
      });
      table.addEventListener("mouseleave", () => { setHover(null); hideTip(); });

      // Header sort
      table.querySelectorAll("thead th").forEach(th => {
        th.addEventListener("click", () => {
          const col = th.dataset.col;
          if (state.sortCol === col) {
            state.sortDir = state.sortDir === "desc" ? "asc" : "desc";
          } else {
            state.sortCol = col;
            state.sortDir = col === "source" ? "asc" : "desc";
          }
          if (state.currentCountyData) {
            renderTable(state.currentCountyData, state.mode, state.currentPop);
          }
        });
      });
    }

    // ---------- URL ----------
    function updateUrl() {
      if (!state.currentCounty) return;
      const params = new URLSearchParams(window.location.search);
      params.set("fips", state.currentCounty);
      if (state.mode !== "raw") params.set("mode", state.mode);
      else params.delete("mode");
      const newUrl = `${window.location.pathname}?${params.toString()}`;
      window.history.replaceState({}, "", newUrl);
    }

    function parseUrlParams() {
      const params = new URLSearchParams(window.location.search);
      const fips = params.get("fips");
      const mode = params.get("mode");
      return {
        fips: fips && /^\d{5}$/.test(fips) ? fips : null,
        mode: ["raw", "percap", "damage"].includes(mode) ? mode : null,
      };
    }

    // ---------- Main render ----------
    async function render(fips5) {
      const ss = fips5.slice(0, 2);
      let data;
      try {
        data = await loadStateEmissions(ss);
      } catch (e) {
        showError("Couldn't load emissions data for this state.");
        return;
      }
      const county = data[fips5];
      if (!county) {
        showError("No emissions data for the selected county.");
        return;
      }

      const meta = findCountyMeta(fips5);
      const pop = meta ? meta.pop : 0;
      state.currentCountyData = county;
      state.currentPop = pop;

      const aqResults = renderAirQuality(fips5);
      renderSummary(fips5, aqResults);
      renderCharts(county, pop);
      renderTable(county, state.mode, pop);
      updateModeNote();
      updateUrl();

      // Picker current
      const stateMeta = findStateMeta(ss);
      const cur = document.getElementById("aps-picker-current");
      if (cur && meta) {
        cur.innerHTML = `Showing <strong>${meta.name} County, ${stateMeta ? stateMeta.name : ""}</strong>`;
      }
    }

    function showError(msg) {
      const el = document.getElementById("aps-summary");
      if (el) el.innerHTML = `<div class="aps-summary-loading" style="color:#b95945;">${msg}</div>`;
    }

    async function selectCounty(fips5) {
      state.currentCounty = fips5;
      state.currentState = fips5.slice(0, 2);
      await render(fips5);
    }

    // ---------- Geolocation ----------
    async function geolocate() {
      try {
        const r = await fetch("/api/geolocate", { cache: "no-store" });
        if (!r.ok) return null;
        return await r.json();
      } catch { return null; }
    }
    async function reverseGeocodeCounty(lat, lng) {
      try {
        const url = `https://geocoding.geo.census.gov/geocoder/geographies/coordinates?x=${lng}&y=${lat}&benchmark=Public_AR_Current&vintage=Current_Current&format=json&layers=Counties`;
        const r = await fetch(url);
        if (!r.ok) return null;
        const j = await r.json();
        const co = j?.result?.geographies?.["Counties"]?.[0];
        if (!co) return null;
        const ss = String(co.STATE).padStart(2, "0");
        const ccc = String(co.COUNTY).padStart(3, "0");
        return ss + ccc;
      } catch { return null; }
    }

    // ---------- Mode + controls ----------
    function updateModeNote() {
      const note = document.getElementById("aps-mode-note");
      if (!note) return;
      if (state.mode === "damage") {
        note.textContent = "Health-cost mode multiplies each ton by a source-specific marginal damage value. Dollars are directly comparable across pollutants and source types — a useful single-axis way to compare what actually causes harm.";
      } else if (state.mode === "percap") {
        note.textContent = "Per-person mode divides local emissions by the county population (shown in pounds per resident per year). This is a normalization for comparison — it doesn't mean each person personally caused that amount.";
      } else {
        note.textContent = "Total emissions show tons per year released by sources in this county. PM₂.₅ and NOₓ and VOC tons aren't directly comparable — switch to Health cost for a single common scale.";
      }
    }

    function bindControls() {
      document.getElementById("aps-state").addEventListener("change", async (e) => {
        const ss = e.target.value;
        if (!ss) return;
        populateCounties(ss);
        const firstFips = (state.counties.counties[ss] || [])[0]?.fips;
        if (firstFips) await selectCounty(firstFips);
      });
      document.getElementById("aps-county").addEventListener("change", async (e) => {
        if (e.target.value) await selectCounty(e.target.value);
      });
      document.querySelectorAll(".aps-mode-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          const mode = btn.dataset.mode;
          if (mode === state.mode) return;
          state.mode = mode;
          document.querySelectorAll(".aps-mode-btn").forEach(b => {
            const active = b.dataset.mode === mode;
            b.dataset.active = active ? "true" : "false";
            b.setAttribute("aria-selected", active ? "true" : "false");
          });
          if (state.currentCounty) await render(state.currentCounty);
        });
      });

      // Use my location
      const locBtn = document.getElementById("aps-locate");
      if (locBtn) {
        locBtn.addEventListener("click", async () => {
          locBtn.disabled = true;
          locBtn.textContent = "Locating…";
          const geo = await geolocate();
          let fips = null;
          if (geo && geo.lat != null && geo.lng != null) {
            fips = await reverseGeocodeCounty(geo.lat, geo.lng);
          }
          if (fips) {
            const ss = fips.slice(0, 2);
            document.getElementById("aps-state").value = ss;
            populateCounties(ss, fips);
            await selectCounty(fips);
          }
          locBtn.disabled = false;
          locBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg><span>Use my location</span>`;
        });
      }

      // Share link
      const shareBtn = document.getElementById("aps-share");
      const shareLabel = document.getElementById("aps-share-label");
      if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
          updateUrl();
          try {
            await navigator.clipboard.writeText(window.location.href);
            shareLabel.textContent = "Copied!";
            shareBtn.dataset.copied = "true";
            setTimeout(() => {
              shareLabel.textContent = "Copy link";
              delete shareBtn.dataset.copied;
            }, 1800);
          } catch {
            shareLabel.textContent = window.location.href;
          }
        });
      }
    }

    // ---------- Init ----------
    async function init() {
      if (!document.getElementById("aps-state")) return;
      try {
        await Promise.all([loadCounties(), loadStaticExtras()]);
      } catch (e) {
        showError("Couldn't load county data. Please refresh the page.");
        return;
      }

      populateStates();
      bindControls();
      bindHover();

      // URL params take priority
      const urlParams = parseUrlParams();
      if (urlParams.mode) {
        state.mode = urlParams.mode;
        document.querySelectorAll(".aps-mode-btn").forEach(b => {
          const active = b.dataset.mode === state.mode;
          b.dataset.active = active ? "true" : "false";
          b.setAttribute("aria-selected", active ? "true" : "false");
        });
      }
      updateModeNote();

      let targetFips = urlParams.fips;
      if (!targetFips) {
        const geo = await geolocate();
        if (geo && geo.lat != null && geo.lng != null) {
          targetFips = await reverseGeocodeCounty(geo.lat, geo.lng);
        }
        if (!targetFips) targetFips = FALLBACK_FIPS;
      }

      const ss = targetFips.slice(0, 2);
      const stateExists = state.counties.states.some(s => s.fips === ss);
      const useFips = stateExists ? targetFips : FALLBACK_FIPS;
      const useSS = useFips.slice(0, 2);

      document.getElementById("aps-state").value = useSS;
      populateCounties(useSS, useFips);
      await selectCounty(document.getElementById("aps-county").value);
      state.loaded = true;
    }

    document.addEventListener("astro:page-load", init);
  })();
</script>
