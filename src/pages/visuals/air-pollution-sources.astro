---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Air pollution sources by county"
  description="Look up the sources of fine particulate (PM2.5) and ozone-forming pollutants (NOx, VOCs) in any U.S. county. Built from the EPA's 2020 National Emissions Inventory."
>
  <article class="aps">
    <h1>Air pollution sources in your county</h1>

    <div class="prose aps-intro">
      <p>This is every reported source of <strong>PM2.5</strong> (fine particulate matter that lodges in your lungs) and the two main <strong>ozone precursors</strong> — <strong>nitrogen oxides (NOx)</strong> and <strong>volatile organic compounds (VOCs)</strong> — in any U.S. county, drawn from the EPA's <a href="https://www.epa.gov/air-emissions-inventories/2020-national-emissions-inventory-nei-data" target="_blank" rel="noopener">2020 National Emissions Inventory</a>.</p>

      <p>The EPA's 59 source sectors are rolled up into 13 readable buckets. Ozone itself isn't directly emitted — it forms in the atmosphere when NOx and VOCs react in sunlight, so the ozone panels show what's emitted, not the ozone you breathe. <strong>Biogenic VOCs</strong> from trees and soils are shown as a separate "natural background" bar — they often dwarf human sources, which is itself worth knowing.</p>

      <p>The "What's in the air" panel also translates each measured concentration into something more tangible: a passive-smoking equivalent for PM2.5, plus the WHO-guideline-baseline excess mortality and asthma risks for ozone and NO₂. These are coarse calibrations from peer-reviewed studies, not personal predictions — see the methodology section for the formulas and citations.</p>

      <p>Pick a state and county below. The chart loads with your county based on your IP location.</p>
    </div>

    <div class="aps-controls">
      <div class="aps-selects">
        <label class="aps-label">
          <span>State</span>
          <select id="aps-state"></select>
        </label>
        <label class="aps-label">
          <span>County</span>
          <select id="aps-county"></select>
        </label>
      </div>
      <div class="aps-mode">
        <button class="aps-mode-btn" data-mode="raw" data-active="true">Tons / year</button>
        <button class="aps-mode-btn" data-mode="percap" data-active="false">Per 100K residents</button>
      </div>
    </div>

    <div class="aps-county-info" id="aps-county-info"></div>

    <section class="aps-aq" id="aps-aq">
      <div class="aps-aq-header">
        <h2 class="aps-aq-title">What's actually in the air <span class="aps-aq-sub">— 2025 EPA monitor readings</span></h2>
      </div>
      <div class="aps-aq-grid" id="aps-aq-grid"></div>
      <p class="aps-aq-note" id="aps-aq-note"></p>
    </section>

    <h2 class="aps-section-title">Emissions by source <span class="aps-aq-sub">— EPA 2020 NEI, tick marks show the national county average</span></h2>

    <div class="aps-stacked">
      <div class="aps-stack-row" data-poll="pm25">
        <div class="aps-stack-label">
          <span class="aps-stack-name">PM<sub>2.5</sub></span>
          <span class="aps-stack-total" id="aps-total-pm25"></span>
        </div>
        <div class="aps-stack-bar" id="aps-bar-pm25"></div>
      </div>
      <div class="aps-stack-row" data-poll="nox">
        <div class="aps-stack-label">
          <span class="aps-stack-name">NOx</span>
          <span class="aps-stack-total" id="aps-total-nox"></span>
        </div>
        <div class="aps-stack-bar" id="aps-bar-nox"></div>
      </div>
      <div class="aps-stack-row" data-poll="voc">
        <div class="aps-stack-label">
          <span class="aps-stack-name">VOC</span>
          <span class="aps-stack-total" id="aps-total-voc"></span>
        </div>
        <div class="aps-stack-bar" id="aps-bar-voc"></div>
      </div>
    </div>

    <p class="aps-stack-note">NOx and VOCs combine in sunlight to form ground-level ozone. Hover any segment or legend row for details.</p>

    <div class="aps-tip" id="aps-tip" style="display:none" role="tooltip" aria-hidden="true">
      <div class="aps-tip-header">
        <span class="aps-tip-swatch" id="aps-tip-swatch"></span>
        <span class="aps-tip-name" id="aps-tip-name"></span>
      </div>
      <div class="aps-tip-stats" id="aps-tip-stats"></div>
      <div class="aps-tip-cmp" id="aps-tip-cmp"></div>
      <div class="aps-tip-desc" id="aps-tip-desc"></div>
    </div>

    <table class="aps-legend" id="aps-legend">
      <thead>
        <tr>
          <th class="aps-legend-source">Source</th>
          <th class="aps-legend-num">PM<sub>2.5</sub></th>
          <th class="aps-legend-num">NOx</th>
          <th class="aps-legend-num">VOC</th>
        </tr>
      </thead>
      <tbody id="aps-legend-body"></tbody>
    </table>

    <details class="aps-meth">
      <summary>Methodology &amp; caveats</summary>
      <div class="aps-meth-body">
        <p><strong>Emissions data.</strong> EPA 2020 National Emissions Inventory (NEI), released March 2023. The 2023 NEI has not yet been published. Population estimates: U.S. Census Bureau's 2024 county population estimates.</p>
        <p><strong>Air-quality measurements.</strong> EPA Air Quality System (AQS) 2025 annual concentration summaries (released November 2025). For each pollutant, the value shown is the maximum across all monitors in the county — this matches how the EPA evaluates NAAQS compliance (the standard applies to the most-polluted monitor). About 640 counties have a PM2.5 monitor, 740 have ozone, and 240 have NO2; the rest are "Not monitored." NAAQS thresholds: PM2.5 9 µg/m³ annual (2024 revision), ozone 70 ppb 8-hr (2015), NO2 53 ppb annual (1971).</p>
        <p><strong>Emissions vs. concentration.</strong> The stacked bars show what's <em>emitted</em> from sources inside your county. The "What's in the air" cards show what's actually <em>measured</em> in the air. These can differ a lot: smoke from distant wildfires, ozone formed downwind from upwind NOx sources, and PM2.5 that drifted in from neighboring counties all show up in the monitors without appearing in local emissions. EPA's National Emissions Inventory is the best public picture of where pollutants come from; the monitors are the best picture of what you actually breathe.</p>
        <p><strong>Health-impact framing.</strong> The italicized line under each air-quality card converts the measured concentration into a tangible harm metric. These are coarse population-level calibrations, not predictions for any individual:</p>
        <ul style="font-size:var(--font-size-small);color:var(--text-secondary);margin:0 0 0.75em 1.25em;padding:0;">
          <li><em>PM₂.₅ → cigarettes/day equivalent.</em> Berkeley Earth's calibration: ~22 µg/m³ of sustained outdoor PM₂.₅ produces roughly the same all-cause mortality risk as smoking one cigarette per day, based on Pope, Burnett, &amp; Krewski's pooled exposure-response curves (<a href="https://berkeleyearth.org/air-pollution-and-cigarette-equivalence/" target="_blank" rel="noopener">link</a>). The cigarette equivalent shown is concentration ÷ 22.</li>
          <li><em>PM₂.₅ → life expectancy.</em> Air Quality Life Index (Greenstone &amp; Pande, EPIC at U Chicago): each 1 µg/m³ above the WHO 5 µg/m³ guideline corresponds to ~0.098 years (≈36 days) of lost life expectancy if sustained over a lifetime (<a href="https://aqli.epic.uchicago.edu/" target="_blank" rel="noopener">aqli.epic.uchicago.edu</a>).</li>
          <li><em>Ozone → respiratory mortality risk.</em> Jerrett et al. 2009 (<em>NEJM</em>): each 10 ppb increase in long-term 8-hr ozone is associated with roughly a 4% increase in respiratory mortality. Baseline is the WHO 60 ppb peak-season guideline.</li>
          <li><em>NO₂ → pediatric asthma risk.</em> Khreis et al. 2017 (<em>Environment International</em>) meta-analysis: each 4 µg/m³ (≈2 ppb) of NO₂ is associated with roughly a 5% increase in pediatric asthma incidence. Baseline is the WHO 10 µg/m³ annual guideline (≈5 ppb).</li>
        </ul>
        <p style="font-size:var(--font-size-small);color:var(--text-secondary);">These metrics use the maximum monitor value in the county, which is consistent with NAAQS evaluation but biases toward the most-polluted area. Real exposure varies by neighborhood, time spent indoors, and indoor air quality (cooking, smoking, ventilation) — often more than the outdoor reading itself.</p>
        <p><strong>Reference ticks.</strong> The dashed tick on each bar segment marks where the segment would end if that source emitted at the national county average. A tick near the left edge means your county emits many times the national average for that source. A tick at the right edge with a dotted indicator means your county is below the national average for that source.</p>
        <p><strong>What's a "source sector"?</strong> The EPA classifies every emission down to a specific equipment/activity code (SCC). The NEI's 59 published sectors aggregate those codes into recognizable categories like "On-Road Diesel Heavy Duty Vehicles" or "Industrial Processes - Petroleum Refineries." This page rolls those 59 sectors up into 13 buckets for readability.</p>
        <p><strong>Why split out oil &amp; gas production?</strong> It's politically distinct from other industrial processes and disproportionately concentrated in a few counties.</p>
        <p><strong>Per-capita caveat.</strong> Per-capita figures use 2024 county population. A rural county with one refinery or a large wildfire will look catastrophically high per resident — that's accurate, but it's not the same as exposure. PM2.5 and ozone disperse across regions; emitted-here doesn't mean breathed-here.</p>
        <p><strong>Tribal lands.</strong> The NEI reports some emissions against tribal areas separately from the surrounding county. Those tribal-area rows are excluded here; the county totals you see are the non-tribal portion only.</p>
        <p><strong>Wildfires.</strong> 2020 was an extreme fire year on the West Coast. Wildfire emissions vary enormously year to year — a county's wildfire bar in 2020 may look very different in 2023 or 2024.</p>
        <p><strong>Biogenic VOCs.</strong> Vegetation and soils emit isoprene, terpenes, and other VOCs. These are shown as "natural background" because they aren't actionable through policy and would dominate any anthropogenic comparison if mixed in.</p>
        <p><strong>Source code:</strong> <a href="https://github.com/AndyMasley/andymasley-site" target="_blank" rel="noopener">on GitHub</a>. The preprocessing script lives at <code>scripts/build-air-pollution-data.py</code>.</p>
      </div>
    </details>
  </article>
</Base>

<style>
  .aps h1 {
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin-bottom: var(--space-lg);
  }

  .aps-intro { margin-bottom: var(--space-lg); }
  .aps-intro p { margin-bottom: 0.75em; }

  .aps-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--space-md);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: var(--space-md);
  }

  .aps-selects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    flex: 1;
  }

  .aps-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--font-size-small);
    color: var(--dim);
    flex: 1;
    min-width: 160px;
  }

  .aps-label select {
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 10px;
    cursor: pointer;
  }

  .aps-label select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--shadow-glow);
  }

  .aps-mode {
    display: flex;
    gap: 2px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px;
  }

  .aps-mode-btn {
    font-family: inherit;
    font-size: var(--font-size-small);
    font-weight: 500;
    padding: 6px 14px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    background: transparent;
    color: var(--dim);
    transition: all var(--transition-fast);
  }

  .aps-mode-btn[data-active="true"] {
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .aps-mode-btn:hover:not([data-active="true"]) {
    color: var(--text);
  }

  .aps-county-info {
    font-size: var(--font-size-small);
    color: var(--dim);
    margin-bottom: var(--space-lg);
    min-height: 1.4em;
  }

  .aps-aq {
    margin-bottom: var(--space-xl);
  }

  .aps-aq-header { margin-bottom: var(--space-sm); }

  .aps-aq-title,
  .aps-section-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
    color: var(--text);
  }

  .aps-section-title {
    margin-top: var(--space-lg);
  }

  .aps-aq-sub {
    font-size: var(--font-size-small);
    font-weight: 400;
    color: var(--dim);
  }

  .aps-aq-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .aps-aq-card {
    padding: 10px 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .aps-aq-card[data-status="exceeds"] {
    border-color: #B95945;
    background: rgba(185, 89, 69, 0.06);
  }

  .aps-aq-card-label {
    font-size: var(--font-size-small);
    color: var(--dim);
    line-height: 1.2;
  }

  .aps-aq-card-value {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .aps-aq-card-value sup {
    font-size: 0.7em;
    font-weight: 400;
    color: var(--dim);
    margin-left: 2px;
  }

  .aps-aq-card-cmp {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .aps-aq-card-harm {
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .aps-aq-card[data-status="below"] .aps-aq-card-harm,
  .aps-aq-card[data-status="none"] .aps-aq-card-harm {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .aps-aq-card[data-status="none"] .aps-aq-card-value {
    color: var(--dim);
    font-size: 1rem;
    font-weight: 500;
  }

  .aps-aq-note {
    font-size: var(--font-size-small);
    color: var(--dim);
    margin: var(--space-sm) 0 0;
  }

  .aps-aq-flag {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    border-radius: 1px;
    margin-right: 4px;
    vertical-align: 0.05em;
  }

  .aps-aq-flag[data-status="exceeds"]   { background: #B95945; }
  .aps-aq-flag[data-status="elevated"]  { background: #D6AE82; }
  .aps-aq-flag[data-status="below"]     { background: #8B9968; }

  .aps-stacked {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .aps-stack-row {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: var(--space-md);
    align-items: center;
  }

  .aps-stack-label {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    line-height: 1.1;
  }

  .aps-stack-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .aps-stack-total {
    font-size: var(--font-size-small);
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .aps-stack-bar {
    height: 28px;
    display: flex;
    background: var(--bg-subtle);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--border-subtle);
  }

  .aps-seg {
    height: 100%;
    transition: width 0.45s cubic-bezier(.4,0,.2,1), filter 0.15s ease;
    border-right: 1px solid rgba(255, 255, 255, 0.55);
    cursor: default;
  }

  [data-theme="dark"] .aps-seg {
    border-right-color: rgba(0, 0, 0, 0.35);
  }

  .aps-seg:last-child { border-right: none; }

  .aps-seg-tick {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 0;
    border-left: 2px dashed rgba(26, 25, 24, 0.55);
    pointer-events: none;
  }

  [data-theme="dark"] .aps-seg-tick {
    border-left-color: rgba(255, 250, 240, 0.7);
  }

  .aps-seg {
    position: relative;
  }

  .aps-seg-tick[data-overflow="true"] {
    border-left-style: solid;
    border-left-width: 0;
    border-right: 2px dotted rgba(26, 25, 24, 0.5);
  }

  .aps-stacked[data-hover] .aps-seg:not([data-active="true"]) {
    filter: saturate(0.25) brightness(0.95);
    opacity: 0.45;
  }

  .aps-stack-note {
    font-size: var(--font-size-small);
    color: var(--dim);
    margin: 0 0 var(--space-lg);
  }

  .aps-legend {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-small);
    margin-bottom: var(--space-lg);
  }

  .aps-legend thead th {
    text-align: right;
    font-weight: 500;
    color: var(--dim);
    padding: 6px 8px;
    border-bottom: 1px solid var(--border);
  }

  .aps-legend th.aps-legend-source {
    text-align: left;
  }

  .aps-legend tbody tr {
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.15s ease;
  }

  .aps-legend tbody tr:hover,
  .aps-legend tbody tr[data-active="true"] {
    background: var(--bg-subtle);
  }

  .aps-legend td {
    padding: 6px 8px;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .aps-legend td.aps-legend-source {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
  }

  .aps-legend td.aps-legend-num {
    text-align: right;
    color: var(--text);
  }

  .aps-legend td.aps-legend-num[data-zero="true"] {
    color: var(--dim);
    opacity: 0.5;
  }

  .aps-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .aps-tip {
    position: fixed;
    z-index: 50;
    max-width: 320px;
    padding: 10px 12px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    box-shadow: var(--shadow-md);
    pointer-events: none;
    font-size: var(--font-size-small);
    line-height: 1.4;
    color: var(--text);
  }

  .aps-tip-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .aps-tip-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .aps-tip-stats {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: 4px;
    font-weight: 500;
  }

  .aps-tip-stats:empty {
    display: none;
  }

  .aps-tip-cmp {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
  }

  .aps-tip-cmp:empty {
    display: none;
  }

  .aps-tip-desc {
    color: var(--text-secondary);
  }

  .aps-legend tbody tr[data-natural="true"] td.aps-legend-source {
    font-style: italic;
  }

  .aps-meth {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .aps-meth summary {
    cursor: pointer;
    font-weight: 600;
    user-select: none;
  }

  .aps-meth-body {
    margin-top: var(--space-md);
    font-size: var(--font-size-small);
    color: var(--text-secondary);
  }

  .aps-meth-body p { margin-bottom: 0.75em; }

  @media (max-width: 600px) {
    .aps-stack-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .aps-stack-label {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      width: 100%;
    }
    .aps-legend {
      font-size: 0.75rem;
    }
    .aps-legend th, .aps-legend td {
      padding: 4px 4px;
    }
  }
</style>

<script is:inline>
  (function () {
    const BUCKETS = [
      { name: "On-road vehicles",                  color: "#B95945",
        desc: "Cars, pickups, vans, SUVs, motorcycles, and heavy-duty trucks driving on public roads. Combines diesel and gasoline, light- and heavy-duty." },
      { name: "Off-road equipment",                color: "#D27A52",
        desc: "Construction equipment, lawn and garden tools, forklifts, agricultural tractors, ATVs, and other engines that don't drive on highways." },
      { name: "Aircraft, ships, trains",           color: "#E5A776",
        desc: "Commercial and general aviation aircraft (including airport ground operations), freight and passenger locomotives, and commercial marine vessels in port and offshore." },
      { name: "Power plants",                      color: "#8B5A3A",
        desc: "Utility-scale electricity generation from coal, natural gas, oil, biomass, and other fuels. Doesn't include backup generators or rooftop solar." },
      { name: "Industrial fuel combustion",        color: "#B68250",
        desc: "Boilers, internal combustion engines, and process heaters burning fuel at industrial, commercial, and institutional facilities — factories, hospitals, universities, office buildings — for heat, process steam, or backup power." },
      { name: "Residential heating",               color: "#D6AE82",
        desc: "Home furnaces, water heaters, fireplaces, and wood stoves burning natural gas, oil, wood, or other fuels. Wood-burning is a major PM2.5 source in cold regions." },
      { name: "Industrial processes",              color: "#7E5567",
        desc: "Emissions from the chemistry of industrial processes themselves (not from burning fuel for heat): cement, chemicals, metals, mining, pulp & paper, petroleum refining, and bulk material storage and transfer." },
      { name: "Oil & gas production",              color: "#4F3743",
        desc: "Upstream oil and gas: wellheads, gathering lines, processing plants, and storage. Mostly fugitive leaks of VOCs and methane, plus combustion at pumps and compressors." },
      { name: "Wildfires & prescribed burns",      color: "#6E4F40",
        desc: "Wildfires, prescribed forest burns, and agricultural field burning. Highly variable year to year — 2020 was an extreme fire year, especially on the West Coast." },
      { name: "Dust",                              color: "#C5B498",
        desc: "Dust kicked up from paved and unpaved roads and from construction sites. A major PM2.5 source in arid regions and along unpaved rural roads." },
      { name: "Agriculture",                       color: "#8B9968",
        desc: "Crop and livestock dust, manure handling, and fertilizer application. Excludes farm equipment (counted under 'Off-road equipment') and field burning (under 'Wildfires & prescribed burns')." },
      { name: "Solvents & coatings",               color: "#5F7B5C",
        desc: "Paints, varnishes, adhesives, dry cleaning, degreasing, printing inks, and consumer products like hairspray and cleaning sprays. The largest VOC source in many cities." },
      { name: "Other",                             color: "#A0958A",
        desc: "Smaller anthropogenic sources grouped together: gas stations and gasoline terminals, commercial cooking, waste disposal (including landfills), and miscellaneous non-industrial activity." },
      { name: "Natural background (trees & soil)", color: "#4C7150", natural: true,
        desc: "Biogenic VOCs — isoprene, terpenes, and others — released by trees, plants, and soils. Often dwarfs human VOC emissions in forested counties. Not directly actionable through policy, shown for context." },
    ];
    const BUCKET_BY_NAME = Object.fromEntries(BUCKETS.map(b => [b.name, b]));
    const POLLUTANTS = ["pm25", "nox", "voc"];

    const FALLBACK_FIPS = "06037"; // LA County

    const AQ_METRICS = [
      { key: "pm25_annual", label: "PM2.5",  long: "PM₂.₅ (annual mean)",       unit: "µg/m³" },
      { key: "ozone_8hr",   label: "Ozone",  long: "Ozone (4⁺th-max 8-hr daily)",     unit: "ppb" },
      { key: "no2_annual",  label: "NO₂", long: "NO₂ (annual mean)",              unit: "ppb" },
    ];

    function healthImpact(metricKey, value) {
      if (value == null || !isFinite(value)) return null;
      if (metricKey === "pm25_annual") {
        // Berkeley Earth: ~22 µg/m³ continuous exposure ≈ 1 cig/day mortality-risk equivalent.
        // AQLI (Greenstone & Pande, EPIC at U Chicago): each 1 µg/m³ above 5 µg/m³ WHO
        // guideline ≈ 0.098 years (~36 days) of lost life expectancy if sustained.
        const cig = value / 22;
        const aboveWho = Math.max(0, value - 5);
        const monthsLost = aboveWho * 0.098 * 12;
        const cigStr = cig >= 1
          ? `≈ ${cig.toFixed(1)} cig/day equivalent`
          : `≈ ${cig.toFixed(2)} cig/day equivalent`;
        const lifeStr = monthsLost < 0.5
          ? "below the WHO guideline (5 µg/m³)"
          : monthsLost >= 24
            ? `~${(monthsLost / 12).toFixed(1)} years of life expectancy lost vs WHO`
            : `~${Math.round(monthsLost)} months of life expectancy lost vs WHO`;
        return `${cigStr} · ${lifeStr}`;
      }
      if (metricKey === "ozone_8hr") {
        // Jerrett et al. 2009 NEJM: each 10 ppb increase in long-term 8-hr ozone ≈
        // ~4% increase in respiratory mortality risk. Referenced against the WHO
        // peak-season guideline of 60 ppb.
        const above = value - 60;
        if (above <= 0) return "below the WHO guideline (60 ppb)";
        const pct = (above / 10) * 4;
        return `+${pct.toFixed(0)}% respiratory mortality risk vs WHO guideline (60 ppb)`;
      }
      if (metricKey === "no2_annual") {
        // Khreis et al. 2017 Environment International meta-analysis: each 4 µg/m³
        // (~2 ppb) of NO2 ≈ 5% increase in pediatric asthma incidence. WHO annual
        // guideline: 10 µg/m³ ≈ 5 ppb.
        const above = value - 5;
        if (above <= 0) return "below the WHO guideline (10 µg/m³ ≈ 5 ppb)";
        const pct = (above / 2) * 5;
        return `+${pct.toFixed(0)}% pediatric asthma risk vs WHO guideline (10 µg/m³)`;
      }
      return null;
    }

    const state = {
      counties: null,
      currentState: null,
      currentCounty: null,
      stateEmissions: {},
      mode: "raw",
      nationalAvg: null,
      airQuality: null,
    };

    function fmt(n) {
      if (n === 0) return "0";
      if (n < 0.1) return n.toFixed(2);
      if (n < 10) return n.toFixed(1);
      return Math.round(n).toLocaleString("en-US");
    }

    function compactPop(n) {
      if (n >= 1_000_000) return (n / 1_000_000).toFixed(2) + "M";
      if (n >= 1_000) return (n / 1_000).toFixed(0) + "K";
      return String(n);
    }

    async function loadCounties() {
      const r = await fetch("/data/air-pollution/counties.json");
      state.counties = await r.json();
    }

    async function loadStaticExtras() {
      try {
        const [na, aq] = await Promise.all([
          fetch("/data/air-pollution/national_avg.json").then(r => r.json()),
          fetch("/data/air-pollution/air_quality.json").then(r => r.json()),
        ]);
        state.nationalAvg = na;
        state.airQuality = aq;
      } catch (e) {
        state.nationalAvg = null;
        state.airQuality = null;
      }
    }

    function fmtAqValue(v, unit) {
      if (v == null) return "—";
      const digits = unit === "µg/m³" ? 1 : 0;
      return v.toFixed(digits);
    }

    function aqStatus(v, naaqs) {
      if (v == null || naaqs == null) return "none";
      if (v >= naaqs) return "exceeds";
      if (v >= 0.75 * naaqs) return "elevated";
      return "below";
    }

    function aqStatusLabel(status) {
      if (status === "exceeds") return "above NAAQS";
      if (status === "elevated") return "near NAAQS";
      if (status === "below") return "below NAAQS";
      return "";
    }

    function renderAirQuality(fips5) {
      const grid = document.getElementById("aps-aq-grid");
      const note = document.getElementById("aps-aq-note");
      grid.innerHTML = "";
      note.textContent = "";

      const aq = state.airQuality;
      if (!aq) {
        note.textContent = "Monitor data unavailable.";
        return;
      }

      const countyMetrics = aq.counties[fips5] || {};
      let anyMonitor = false;

      for (const m of AQ_METRICS) {
        const v = countyMetrics[m.key];
        const naaqs = aq.naaqs[m.key]?.value;
        const natAvg = aq.national_avg[m.key];
        const status = aqStatus(v, naaqs);
        if (v != null) anyMonitor = true;

        const card = document.createElement("div");
        card.className = "aps-aq-card";
        card.dataset.status = status;

        const label = document.createElement("div");
        label.className = "aps-aq-card-label";
        label.innerHTML = m.long;

        const value = document.createElement("div");
        value.className = "aps-aq-card-value";
        if (v == null) {
          value.textContent = "Not monitored";
        } else {
          value.innerHTML = `${fmtAqValue(v, m.unit)}<sup>${m.unit}</sup>`;
        }

        const cmp = document.createElement("div");
        cmp.className = "aps-aq-card-cmp";
        if (v != null) {
          const flag = document.createElement("span");
          flag.className = "aps-aq-flag";
          flag.dataset.status = status;
          cmp.appendChild(flag);
          const txt = document.createElement("span");
          txt.textContent = `${aqStatusLabel(status)} (${naaqs} ${m.unit}) · nat. avg ${fmtAqValue(natAvg, m.unit)}`;
          cmp.appendChild(txt);
        } else {
          const txt = document.createElement("span");
          txt.textContent = `Nat. avg ${fmtAqValue(natAvg, m.unit)}, NAAQS ${naaqs} ${m.unit}`;
          cmp.appendChild(txt);
        }

        card.appendChild(label);
        card.appendChild(value);
        card.appendChild(cmp);

        const harmText = healthImpact(m.key, v);
        if (harmText) {
          const harm = document.createElement("div");
          harm.className = "aps-aq-card-harm";
          harm.textContent = harmText;
          card.appendChild(harm);
        }

        grid.appendChild(card);
      }

      if (!anyMonitor) {
        const monStr = AQ_METRICS
          .map(m => `${m.label} ${aq.n_monitored[m.key]}`)
          .join(" · ");
        note.textContent = `No EPA air-quality monitors in this county. Nationally, only ${monStr} counties have monitors (of 3,245).`;
      }
    }

    function nationalAvgForBucket(bucket, pollutant) {
      const na = state.nationalAvg;
      if (!na) return null;
      const table = state.mode === "percap" ? na.percap : na.raw;
      const v = table?.[pollutant]?.[bucket];
      return v == null ? null : v;
    }

    async function loadStateEmissions(ss) {
      if (state.stateEmissions[ss]) return state.stateEmissions[ss];
      const r = await fetch(`/data/air-pollution/emissions/${ss}.json`);
      const data = await r.json();
      state.stateEmissions[ss] = data;
      return data;
    }

    function populateStates() {
      const sel = document.getElementById("aps-state");
      sel.innerHTML = "";
      for (const s of state.counties.states) {
        const o = document.createElement("option");
        o.value = s.fips;
        o.textContent = s.name;
        sel.appendChild(o);
      }
    }

    function populateCounties(ss, preferFips) {
      const sel = document.getElementById("aps-county");
      sel.innerHTML = "";
      const list = state.counties.counties[ss] || [];
      for (const c of list) {
        const o = document.createElement("option");
        o.value = c.fips;
        o.textContent = c.name;
        sel.appendChild(o);
      }
      if (preferFips && list.some(c => c.fips === preferFips)) {
        sel.value = preferFips;
      } else if (list[0]) {
        sel.value = list[0].fips;
      }
    }

    function findCountyMeta(fips5) {
      const ss = fips5.slice(0, 2);
      const list = state.counties.counties[ss] || [];
      return list.find(c => c.fips === fips5) || null;
    }

    function findStateMeta(ss) {
      return state.counties.states.find(s => s.fips === ss) || null;
    }

    function transformValue(v, mode, pop) {
      return mode === "percap" && pop > 0 ? (v / pop) * 100000 : v;
    }

    function renderStackedBar(barId, totalId, pollutant, valuesByBucket, mode, pop) {
      const bar = document.getElementById(barId);
      const totalEl = document.getElementById(totalId);
      bar.innerHTML = "";

      const segs = BUCKETS
        .filter(b => valuesByBucket[b.name] !== undefined && valuesByBucket[b.name] > 0)
        .map(b => ({ ...b, value: transformValue(valuesByBucket[b.name], mode, pop) }));

      const total = segs.reduce((s, x) => s + x.value, 0);
      totalEl.textContent = total > 0
        ? `${fmt(total)} ${mode === "percap" ? "/100K" : "tons"}`
        : "—";

      if (total === 0) return;

      segs.sort((a, b) => b.value - a.value);

      for (const s of segs) {
        const seg = document.createElement("div");
        seg.className = "aps-seg";
        seg.dataset.bucket = s.name;
        seg.dataset.value = String(s.value);
        seg.dataset.pct = ((s.value / total) * 100).toFixed(1);
        seg.style.width = ((s.value / total) * 100).toFixed(3) + "%";
        seg.style.background = s.color;

        const natAvg = nationalAvgForBucket(s.name, pollutant);
        if (natAvg != null && natAvg > 0 && s.value > 0) {
          const ratio = natAvg / s.value;
          const tick = document.createElement("div");
          tick.className = "aps-seg-tick";
          if (ratio <= 1) {
            tick.style.left = (ratio * 100).toFixed(2) + "%";
          } else {
            tick.style.left = "calc(100% - 2px)";
            tick.dataset.overflow = "true";
          }
          seg.dataset.natavg = String(natAvg);
          seg.appendChild(tick);
        }

        bar.appendChild(seg);
      }
    }

    function renderLegend(county, mode, pop) {
      const tbody = document.getElementById("aps-legend-body");
      tbody.innerHTML = "";

      for (const b of BUCKETS) {
        const values = POLLUTANTS.map(p => {
          const raw = county[p] ? county[p][b.name] : undefined;
          return raw !== undefined ? transformValue(raw, mode, pop) : null;
        });
        const anyPresent = values.some(v => v !== null && v > 0);
        if (!anyPresent) continue;

        const tr = document.createElement("tr");
        tr.dataset.bucket = b.name;
        if (b.natural) tr.dataset.natural = "true";

        const tdSrc = document.createElement("td");
        tdSrc.className = "aps-legend-source";
        const sw = document.createElement("span");
        sw.className = "aps-swatch";
        sw.style.background = b.color;
        const label = document.createElement("span");
        label.textContent = b.name;
        tdSrc.appendChild(sw);
        tdSrc.appendChild(label);
        tr.appendChild(tdSrc);

        for (const v of values) {
          const td = document.createElement("td");
          td.className = "aps-legend-num";
          if (v === null || v === 0) {
            td.dataset.zero = "true";
            td.textContent = v === null ? "—" : "0";
          } else {
            td.textContent = fmt(v);
          }
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
    }

    function setHover(bucketName) {
      const stacked = document.querySelector(".aps-stacked");
      if (bucketName) stacked.dataset.hover = "true";
      else delete stacked.dataset.hover;

      document.querySelectorAll(".aps-seg").forEach(el => {
        el.dataset.active = el.dataset.bucket === bucketName ? "true" : "false";
      });
      document.querySelectorAll("#aps-legend-body tr").forEach(el => {
        el.dataset.active = el.dataset.bucket === bucketName ? "true" : "false";
      });
    }

    function showTip(bucketName, statsText, cmpText, x, y) {
      const tip = document.getElementById("aps-tip");
      const bucket = BUCKET_BY_NAME[bucketName];
      if (!bucket) return;
      document.getElementById("aps-tip-name").textContent = bucket.name;
      document.getElementById("aps-tip-swatch").style.background = bucket.color;
      document.getElementById("aps-tip-stats").textContent = statsText || "";
      document.getElementById("aps-tip-cmp").textContent = cmpText || "";
      document.getElementById("aps-tip-desc").textContent = bucket.desc || "";
      tip.style.display = "block";
      tip.setAttribute("aria-hidden", "false");
      positionTip(x, y);
    }

    function hideTip() {
      const tip = document.getElementById("aps-tip");
      tip.style.display = "none";
      tip.setAttribute("aria-hidden", "true");
    }

    function positionTip(x, y) {
      const tip = document.getElementById("aps-tip");
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      const pad = 12;
      let left = x + 14;
      let top = y + 14;
      if (left + w + pad > window.innerWidth) left = x - w - 14;
      if (top + h + pad > window.innerHeight) top = y - h - 14;
      if (left < pad) left = pad;
      if (top < pad) top = pad;
      tip.style.left = left + "px";
      tip.style.top = top + "px";
    }

    function statsForSeg(seg) {
      const value = parseFloat(seg.dataset.value);
      const pct = seg.dataset.pct;
      const row = seg.closest(".aps-stack-row");
      const poll = row && row.dataset.poll;
      const pollLabel = poll === "pm25" ? "PM2.5" : poll === "nox" ? "NOx" : "VOC";
      const unit = state.mode === "percap" ? "tons / yr per 100K residents" : "tons / yr";
      return `${pollLabel}: ${fmt(value)} ${unit} (${pct}% of bar)`;
    }

    function cmpForSeg(seg) {
      const natAvg = seg.dataset.natavg ? parseFloat(seg.dataset.natavg) : null;
      const value = parseFloat(seg.dataset.value);
      if (natAvg == null || !isFinite(natAvg)) return "";
      const unit = state.mode === "percap" ? "tons/yr per 100K" : "tons/yr";
      if (natAvg === 0) {
        return value === 0
          ? `Avg county: 0 ${unit} (no emissions nationally)`
          : `Avg county: 0 ${unit} — your county has reported emissions`;
      }
      const ratio = value / natAvg;
      const ratioStr = ratio >= 10
        ? `${ratio.toFixed(0)}×`
        : ratio >= 1
          ? `${ratio.toFixed(1)}×`
          : `${(ratio * 100).toFixed(0)}% of`;
      const direction = ratio >= 1 ? "above" : "below";
      return `${ratioStr} the national county avg (${fmt(natAvg)} ${unit}) — ${direction} average`;
    }

    function bindHover() {
      const stacked = document.querySelector(".aps-stacked");
      const legend = document.getElementById("aps-legend");

      stacked.addEventListener("mouseover", (e) => {
        const seg = e.target.closest(".aps-seg");
        if (seg) {
          setHover(seg.dataset.bucket);
          showTip(seg.dataset.bucket, statsForSeg(seg), cmpForSeg(seg), e.clientX, e.clientY);
        }
      });
      stacked.addEventListener("mousemove", (e) => {
        const seg = e.target.closest(".aps-seg");
        if (seg) {
          showTip(seg.dataset.bucket, statsForSeg(seg), cmpForSeg(seg), e.clientX, e.clientY);
        }
      });
      stacked.addEventListener("mouseleave", () => {
        setHover(null);
        hideTip();
      });

      legend.addEventListener("mouseover", (e) => {
        const tr = e.target.closest("tr[data-bucket]");
        if (tr) {
          setHover(tr.dataset.bucket);
          showTip(tr.dataset.bucket, "", "", e.clientX, e.clientY);
        }
      });
      legend.addEventListener("mousemove", (e) => {
        const tr = e.target.closest("tr[data-bucket]");
        if (tr) {
          showTip(tr.dataset.bucket, "", "", e.clientX, e.clientY);
        }
      });
      legend.addEventListener("mouseleave", () => {
        setHover(null);
        hideTip();
      });
    }

    async function render(fips5) {
      const ss = fips5.slice(0, 2);
      const data = await loadStateEmissions(ss);
      const county = data[fips5];
      if (!county) return;

      const meta = findCountyMeta(fips5);
      const stateMeta = findStateMeta(ss);
      const info = document.getElementById("aps-county-info");
      const popText = meta && meta.pop ? ` · population ${compactPop(meta.pop)}` : "";
      info.textContent = `${meta ? meta.name : fips5} County, ${stateMeta ? stateMeta.name : ss}${popText} · 2020 emissions`;

      const pop = meta ? meta.pop : 0;
      renderStackedBar("aps-bar-pm25", "aps-total-pm25", "pm25", county.pm25 || {}, state.mode, pop);
      renderStackedBar("aps-bar-nox",  "aps-total-nox",  "nox",  county.nox  || {}, state.mode, pop);
      renderStackedBar("aps-bar-voc",  "aps-total-voc",  "voc",  county.voc  || {}, state.mode, pop);
      renderLegend(county, state.mode, pop);
      renderAirQuality(fips5);
    }

    async function selectCounty(fips5) {
      state.currentCounty = fips5;
      state.currentState = fips5.slice(0, 2);
      await render(fips5);
    }

    async function geolocate() {
      try {
        const r = await fetch("/api/geolocate", { cache: "no-store" });
        if (!r.ok) return null;
        return await r.json();
      } catch {
        return null;
      }
    }

    async function reverseGeocodeCounty(lat, lng) {
      try {
        const url = `https://geocoding.geo.census.gov/geocoder/geographies/coordinates?x=${lng}&y=${lat}&benchmark=Public_AR_Current&vintage=Current_Current&format=json&layers=Counties`;
        const r = await fetch(url);
        if (!r.ok) return null;
        const j = await r.json();
        const co = j?.result?.geographies?.["Counties"]?.[0];
        if (!co) return null;
        const ss = String(co.STATE).padStart(2, "0");
        const ccc = String(co.COUNTY).padStart(3, "0");
        return ss + ccc;
      } catch {
        return null;
      }
    }

    function bindControls() {
      document.getElementById("aps-state").addEventListener("change", async (e) => {
        const ss = e.target.value;
        populateCounties(ss);
        const firstFips = (state.counties.counties[ss] || [])[0]?.fips;
        if (firstFips) await selectCounty(firstFips);
      });
      document.getElementById("aps-county").addEventListener("change", async (e) => {
        await selectCounty(e.target.value);
      });
      document.querySelectorAll(".aps-mode-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          const mode = btn.dataset.mode;
          if (mode === state.mode) return;
          state.mode = mode;
          document.querySelectorAll(".aps-mode-btn").forEach(b => {
            b.dataset.active = b.dataset.mode === mode ? "true" : "false";
          });
          if (state.currentCounty) await render(state.currentCounty);
        });
      });
    }

    async function init() {
      if (!document.getElementById("aps-state")) return;
      await Promise.all([loadCounties(), loadStaticExtras()]);
      populateStates();
      bindControls();
      bindHover();

      // Try IP geolocation; fall back to LA
      const geo = await geolocate();
      let targetFips = null;
      if (geo && geo.lat != null && geo.lng != null) {
        targetFips = await reverseGeocodeCounty(geo.lat, geo.lng);
      }
      if (!targetFips) targetFips = FALLBACK_FIPS;

      const ss = targetFips.slice(0, 2);
      const stateExists = state.counties.states.some(s => s.fips === ss);
      const useFips = stateExists ? targetFips : FALLBACK_FIPS;
      const useSS = useFips.slice(0, 2);

      document.getElementById("aps-state").value = useSS;
      populateCounties(useSS, useFips);
      await selectCounty(document.getElementById("aps-county").value);
    }

    document.addEventListener("astro:page-load", init);
  })();
</script>
