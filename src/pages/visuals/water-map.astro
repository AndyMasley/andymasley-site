---
import Base from '@/layouts/Base.astro';
import '../../styles/water-map.css';
import WaterTrends from '@/components/water-map/WaterTrends.astro';
import WaterCounties from '@/components/water-map/WaterCounties.astro';

const description = 'A 3D map of the water the United States withdrew in 2015, county by county, from the rivers, lakes and aquifers it came from to the farms, power plants and cities that used it. Isolate any use, from power plants to data centers, or look underground at the aquifers.';
---

<Base
  title="Where America’s water goes"
  description={description}
  ogImage="/og/page/water-map.png?v=1"
  ogImageAlt="A night map of the United States with streams of colored light running from rivers and aquifers to farms, cities and power plants."
  ogImageWidth={1200}
  ogImageHeight={630}
  activeNav="/visuals"
>
  <article class="wm-page" aria-labelledby="wm-title">
    <header class="wm-heading">
      <p class="wm-eyebrow">Every county, power plant, aquifer and dam</p>
      <h1 id="wm-title">Where America’s water goes</h1>
      <p class="wm-lede">In 2015 the United States withdrew about 322 billion gallons of water a day. This map draws all of it, county by county, from the rivers, lakes, aquifers and sea it came from to the farms, power plants, cities and factories that used it. For crops, golf courses and power plants, which together withdrew more than three quarters of it, the map also shows how much was consumed and how much went back.</p>
      <p class="wm-dek-links"><a href="#story">Read it as a story, scene by scene</a> · <a href="?flat">Flat version of the map</a></p>
    </header>

    <section class="wm" data-wm-root aria-label="Interactive map of water use in the United States">
      <div class="wm-stage" data-wm-stage>
        <canvas class="wm-canvas" data-wm-canvas tabindex="0" role="application" aria-label="3D map of water use in the United States. The panels beside it give the same information as text." aria-describedby="wm-help"></canvas>
        <div class="wm-labels" data-wm-labels aria-hidden="true"></div>
        <div class="wm-loading" data-wm-loading>
          <div class="wm-loading__box">
            <p class="wm-loading__title">Where America’s water goes</p>
            <div class="wm-loading__bar"><i data-wm-load-bar></i></div>
            <p data-wm-load-msg>Loading terrain, land cover, rivers, aquifers and 3,223 counties…</p>
          </div>
        </div>
        <pre class="wm-perf" data-wm-perf hidden></pre>
      </div>
      <noscript><p class="wm-note-line">The map needs JavaScript and WebGL. The sources below describe everything it shows.</p></noscript>
    </section>

    <WaterTrends />

    <WaterCounties />

    <div class="wm-endmatter">
      <details class="wm-details" id="wm-faq">
        <summary>Common questions</summary>
        <div class="wm-details__body">
          <dl>
            <dt>Do power plants use more water than farms?</dt>
            <dd>They withdraw more: 133 billion gallons a day in 2015, against 118 billion for crops and golf courses. Most of a power plant’s water cools it and goes back to the river, lake or sea it came from, warmer. Farms keep most of theirs. Crops and golf courses consumed about 73 billion gallons a day, some 17 times the 4.3 billion consumed by power plants. Switch the map from Withdrawn to Consumed to see the difference.</dd>
            <dt>Why does Brooklyn draw no water for its people?</dt>
            <dd>USGS counts a public water system’s withdrawals in the county where the water is taken, so New York City’s water is counted in the counties that hold its reservoirs, in the Catskill Mountains and the Croton watershed north of the city. On the USGS figures alone the five boroughs withdraw no water for public supply. The map pipes that water to the boroughs along the city’s aqueducts, and does the same for 19 other systems, among them Washington’s, Boston’s and Baltimore’s.</dd>
            <dt>How much water do data centers use?</dt>
            <dd>Lawrence Berkeley National Laboratory estimates that U.S. data centers consumed about 17.4 billion gallons of water on site in 2023, about 48 million gallons a day. Generating their electricity consumed about 83 billion gallons more, at the 0.47 gallons per kilowatt-hour this site uses for power plants. Together that is about 275 million gallons a day. Crops, golf courses and power plants consumed about 77 billion gallons a day in 2015, some 280 times as much.</dd>
            <dt>Is consumed water gone for good?</dt>
            <dd>It is gone from the river or aquifer it was taken from. USGS counts water as consumed when it evaporates, is taken up by crops, goes into products or is otherwise removed from the local water system. Nearly all of it goes up as vapor and falls again as rain or snow, usually far away, so consumption matters most where water is scarce. Color the land by strain on rivers and streams, under Layers, to see where that is.</dd>
            <dt>Why 2015?</dt>
            <dd>It is the latest year for which USGS has estimated the water every county withdrew for every use. Since then USGS has published modeled estimates by small watershed and by month for the three biggest uses (public supply, irrigation and power plants). The map does not draw them yet.</dd>
          </dl>
        </div>
      </details>
      <details class="wm-details" id="wm-help">
        <summary>How to read the map</summary>
        <div class="wm-details__body">
          <p>Every moving streak of light is water. It leaves a river, a lake, an aquifer or the sea and travels to the place where it was used, in the color of that use: orange for power plants, green for crops, gold for public supply, and so on. The more water, the more light. Seen from the whole country, discs mark the 40 places that withdrew the most, each sized by its water and in the color of its use, with a white slice for the share consumed.</p>
          <p>Zoom in and the channels the water runs through are drawn too, all on one scale, so ten times the water draws about four times as wide. A chevron near the end of a wide channel points the way its water goes. A dot marks an intake on a river or lake, a ring marks a well, and a square marks where a utility, factory or fish farm gathers its water. At crops, golf courses and power plants a small pie shows how much of the water was consumed (white) and how much went back (gray). A channel too short to see at the scale of the map is drawn at a minimum length. Point at a channel or a disc to read what it carries. With nothing selected, the panel beside the map sums up the counties in view and changes as you move.</p>
          <p>Some cities’ water travels much farther. New York City’s comes from reservoirs in the Catskills, Washington’s from the Potomac above Great Falls, Boston’s from the Quabbin and Wachusett reservoirs, Houston’s from Lake Livingston on the Trinity River. That water is drawn along the system’s aqueducts and pipelines, from the county where it was withdrawn to the counties it serves.</p>
          <p>Some of that water is consumed, which means it evaporates, goes into crops or products, or otherwise leaves the local water system. It rises as white mist. The rest goes back to rivers and aquifers after it is used, fading to gray. The U.S. Geological Survey estimated consumption only for crops, golf courses and power plants in 2015, so for the other uses the light stops where the water arrives.</p>
          <p>Pick a use from the list over the map to see only its water, with the counties shaded by how much of it they withdrew per square mile and the places that withdrew the most labeled. Click a county, a power plant, a water treatment plant or a golf course to see where its water comes from. Its channels are drawn in the color of each source (blue for rivers and lakes, pale green for groundwater, teal for the sea, violet for reclaimed wastewater, gold for water bought from a utility), as wide as the share of its water they carry, and each source is boxed with its share. Gray dashes are the water it returns to rivers. The panel beside the map gives the same shares as numbers, how strained the county’s rivers and streams are, and its water every five years since 1985. Click a dam or a canal for its own figures and source. Type a ZIP code in the search box to go to your county. Under Layers you can color the land by other measures, among them the strain on each county’s rivers and streams and how its withdrawals changed between 2005 and 2015. Underground shows the aquifers as solid bodies under a glass surface, with wells lifting water out of them, and the High Plains aquifer can show how far its water table has moved since about 1950.</p>
          <p>Drag to move, scroll or pinch to zoom, and right-drag (or twist two fingers) to turn and tilt. With the map selected, the arrow keys move it, N switches between day and night, U goes underground, and Escape steps back.</p>
          <p>There is also a <a href="?flat">flat version of the map</a> with the same county figures. It needs no 3D graphics, works with a keyboard and a screen reader (the arrow keys move from county to county and Enter opens one), and prints.</p>
        </div>
      </details>
      <details class="wm-details" id="wm-about">
        <summary>About the data and its sources</summary>
        <div class="wm-details__body">
          <dl>
            <dt>Water use</dt>
            <dd>The U.S. Geological Survey’s estimate of withdrawals for every county in 2015 (Dieter and others, 2018, county data version 2.0), by use and by source (fresh or saline, surface or ground water). It is the source of every volume on the map and of the national total. USGS reports eight uses. The map shows nine because it splits irrigation into crops and golf courses, as USGS did in 36 states and the District of Columbia; in the other states golf is counted inside crop irrigation.</dd>
            <dt>Consumption</dt>
            <dd>Shown only for crops, golf courses and thermoelectric power, the uses for which USGS estimated consumption in 2015. For the other uses the map shows water arriving and stops there, which does not mean none of it was consumed.</dd>
            <dt>Power plants</dt>
            <dd>The 1,122 plants in the USGS model of thermoelectric water use for 2015 (Harris and Diehl, 2019, data version 1.2). Each county’s thermoelectric estimate is split among its plants in proportion to that model, and each plant’s own model estimate is shown beside it. USGS counts the water of Brunner Island and Peach Bottom, on the York County bank of the Susquehanna, in Lancaster County across the river, so the map splits Lancaster County’s estimate among them.</dd>
            <dt>Aquifers and groundwater</dt>
            <dd>Withdrawals by aquifer are from Lovelace and others (2020), estimated groundwater withdrawals from principal aquifers in 2015, county-level data (USGS). The outlines are the USGS map of principal aquifers, which shows the uppermost principal aquifer at each place, so deeper ones (such as the Floridan aquifer beneath Florida’s surficial aquifer) are hidden. Their outlines come from that map, but every body is drawn at the same depth and thickness, so the depths on the map mean nothing. About 14 billion gallons a day was pumped from glacial, alluvial and other aquifers the map does not outline. Depletion from 1900 to 2008 is from Konikow (2013), and the High Plains aquifer’s recoverable water in storage from McGuire (2017).</dd>
            <dt>Data centers</dt>
            <dd>For scale only, and not part of the 2015 totals. Lawrence Berkeley National Laboratory’s 2024 report estimates U.S. data centers consumed about 66 billion liters (17.4 billion gallons) of water on site in 2023 and used 176 terawatt-hours of electricity. The map counts the water for that electricity at 0.47 gallons per kilowatt-hour, the average consumed by thermoelectric power plants (NREL), which adds about 83 billion gallons a year. LBNL’s own estimate for their electricity, about 800 billion liters, also counts evaporation from hydroelectric reservoirs, which the USGS consumption figures on this map leave out. In the USGS figures the water data centers use on site is counted inside public supply and industry, and the water for their electricity inside power plants, so the map draws no separate flows for them. The locations are data centers mapped in OpenStreetMap, which misses many.</dd>
            <dt>Rivers, lakes and canals</dt>
            <dd>Rivers are HydroRIVERS version 1.0 (Lehner and Grill, 2013). Each reach is drawn by its modeled long-term average natural discharge for 1971 to 2000. Lakes and reservoirs are Natural Earth. Aqueducts and canals are mapped from OpenStreetMap, except where it maps them only in pieces or not at all: the Colorado River Aqueduct, the first Los Angeles Aqueduct, the Delta-Mendota Canal and the State Water Project’s East and West branches are drawn from the USGS National Hydrography Dataset. Where a canal has a flow, it comes from the operator’s or a government report, and clicking the canal shows what was measured (water pumped, diverted, delivered or supplied), for which year and from which report. Not every report covers 2015.</dd>
            <dt>Dams and facilities</dt>
            <dd>Dams are from the U.S. Army Corps of Engineers’ National Inventory of Dams as of October 2026, sized by storage. It lists 92,693 dams, and the map can draw all of them except 164 without coordinates and one in Guam (turn on Every dam under Layers). Water towers, treatment plants, wastewater plants, golf courses and data centers are from OpenStreetMap (© OpenStreetMap contributors, ODbL), which is thorough in some places and patchy in others.</dd>
            <dt>Land and terrain</dt>
            <dd>Land cover is the National Land Cover Database (MRLC): 2021 for the lower 48, 2016 for Alaska and 2001 for Hawaii and Puerto Rico. The city lights at night are painted from its developed land classes. Terrain is NOAA’s ETOPO 2022 at 15 arc-seconds, exaggerated vertically: 24 times for the whole country and about 2 times up close. Up close, fields, center pivots and city blocks are painted patterns placed by the land cover and each county’s irrigated acreage, so individual fields are not real ones.</dd>
            <dt>Water moved between counties</dt>
            <dd>USGS counts a county’s public-supply withdrawals where the water is withdrawn and the people it serves where they live, so on the county figures alone New York City’s boroughs withdraw nothing and the counties holding its reservoirs withdraw a billion gallons a day. For 20 systems that withdraw in one county and deliver in others, among them New York City’s, Washington’s, Boston’s, Baltimore’s, Houston’s, Detroit’s and Tampa Bay Water, the map moves that water to the counties it serves. The volumes are the USGS withdrawals. Where an operator, or USGS for Florida, publishes deliveries by county, the water is divided that way; otherwise each receiving county gets its estimated public-supply use less what it withdraws itself, estimating use as its domestic deliveries times its state’s ratio of public-supply withdrawals to domestic deliveries (both USGS). Clicking a county gives the system, its operator and the source of each figure. Smaller systems that cross county lines stay where USGS put them. The routes follow the aqueducts where OpenStreetMap maps them and otherwise run straight between each system’s main reservoirs, plants and pumping stations.</dd>
            <dt>Imported water in the West</dt>
            <dd>In California and Arizona, USGS counts water brought in through the Colorado River Aqueduct, the State Water Project, the Los Angeles Aqueduct and the Central Arizona Project mostly as surface water withdrawn by the county that receives it. Where a mapped canal or aqueduct runs through a county, the map draws that county’s surface water for farms, towns and industry from it, though farms draw none from the aqueducts built to carry water to cities, such as the Colorado River and Los Angeles aqueducts. In 40 California counties, including Imperial, the USGS figures divide irrigation between groundwater and surface water in the same proportion, about 70 percent groundwater. The map draws them as given. In Imperial County that puts most of the farms’ water in wells, though Reclamation counted 2.46 million acre-feet of Colorado River water diverted for the Imperial Irrigation District in 2015, more than all the irrigation water USGS estimated for the county (2.07 million acre-feet).</dd>
            <dt>Strain on rivers and streams</dt>
            <dd>USGS’s surface water supply and use index, from its National Water Availability Assessment (Stets and others, 2025; data from Miller and others, 2024), for every small watershed (HUC12) and month of water years 2010 to 2020. It is the share of a watershed’s median streamflow for that month that was not available, because the month was dry or because crops, power plants and public water systems consumed it, from 0 to 1. The map averages it over the 132 months and over the watersheds in each county, each weighted by the area it covers there, on the October 2020 watershed boundaries the assessment used. USGS calls watersheds above 0.6 on average chronically imbalanced. It notes that the index leaves out water moved between basins and probably understates the strain in the West, where drought persisted through the period.</dd>
            <dt>Water levels in the High Plains aquifer</dt>
            <dd>The USGS map of the change in water level from about 1950, before heavy pumping began, to 2015 (McGuire, 2017), a grid of 500-meter cells drawn from 3,092 wells measured in both periods and from other published information where wells were few. The map resamples the grid to its own, and the areas the panel quotes are counted on the USGS grid.</dd>
            <dt>Water every five years since 1985</dt>
            <dd>The USGS county estimates for 1985, 1990, 1995, 2000, 2005 and 2010, matched to the 2015 counties by their codes, beside the 2015 figures the map draws. USGS changed what it counted over those years. Before 2000 the totals include self-supplied commercial water, which it then stopped estimating, and the 2000 county file’s own total leaves out part of the water it lists, so the map adds up the uses instead. Counties USGS renamed or merged are carried to their 2015 codes, and a few redrawn Alaska boroughs have no history. The county files differ slightly from the national totals in the chart above, which USGS revised later.</dd>
            <dt>ZIP codes</dt>
            <dd>The Census Bureau’s 2020 ZIP code tabulation areas, which approximate ZIP codes, each matched to the county that holds most of its land (the 2020 ZCTA-to-county relationship file). The lookup runs in your browser and sends nothing anywhere.</dd>
            <dt>Where the flows start and end</dt>
            <dd>Inside a county the map places surface intakes on its largest rivers or lakeshores, or on its canals where it has mapped ones, wells beneath the land they serve, irrigation on cropland, golf on mapped golf courses, utilities through a mapped treatment plant into developed land, and power plants at their reported coordinates. Water for fields runs from each intake to a canal head and branches out from there, and water returned from fields gathers on its way back to the nearest river. The volumes and the shares by source are the estimates. The paths are drawn to show them.</dd>
          </dl>
          <p class="wm-note-line">Sources: <a href="https://www.usgs.gov/data/estimated-use-water-united-states-county-level-data-2015">USGS county water use, 2015</a> · <a href="https://pubs.usgs.gov/publication/cir1441">Dieter and others (2018)</a> · <a href="https://pubs.usgs.gov/publication/sir20195103">Harris and Diehl (2019)</a> · <a href="https://pubs.usgs.gov/publication/cir1464">Lovelace and others (2020)</a> · <a href="https://pubs.usgs.gov/sir/2013/5079/SIR2013-5079.pdf">Konikow (2013)</a> · <a href="https://pubs.usgs.gov/publication/sir20175040">McGuire (2017)</a> · <a href="https://eta-publications.lbl.gov/publications/2024-lbnl-data-center-energy-usage-report">LBNL (2024)</a> · <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">NREL (2003)</a> · <a href="https://www.hydrosheds.org/products/hydrorivers">HydroRIVERS</a> · <a href="https://nid.sec.usace.army.mil/">National Inventory of Dams</a> · <a href="https://www.mrlc.gov/">NLCD</a> · <a href="https://www.ncei.noaa.gov/products/etopo-global-relief-model">ETOPO 2022</a> · <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://www.usbr.gov/lc/region/g4000/4200Rpts/DecreeRpt/2015/2015.pdf">Reclamation, Colorado River 2015</a> · <a href="https://www.naturalearthdata.com/">Natural Earth</a> · <a href="https://doi.org/10.3133/pp1894F">Stets and others (2025)</a> · <a href="https://doi.org/10.5066/P1CFYEHO">Miller and others (2024)</a> · <a href="https://www.sciencebase.gov/catalog/item/58ff75a2e4b006455f2d6327">McGuire (2017), water-level change data</a> · <a href="https://water.usgs.gov/watuse/data/">USGS county water use, 1985–2010</a> · <a href="https://www2.census.gov/geo/docs/maps-data/data/rel2020/zcta520/">Census ZCTA relationship files</a></p>
          <p class="wm-note-line">If you think I’m getting something wrong, <a href="mailto:AndyMasley@gmail.com">email me</a>.</p>
        </div>
      </details>
      <details class="wm-details" id="wm-corrections">
        <summary>Corrections</summary>
        <div class="wm-details__body">
          <p>Every correction to the map’s figures or wording since it went up on October 25, 2026, newest first. If you find an error, <a href="mailto:AndyMasley@gmail.com">email me</a>. The rules of my error bounty are on the <a href="/writing/errors-and-updates">errors and updates</a> page.</p>
          <dl>
            <dt>October 25, 2026</dt>
            <dd>Dropped two systems the map had drawn piping water between counties without a source for how much they move or where: Cobb County’s water from Lake Allatoona and the Raritan basin system in New Jersey. Their water is back in the counties where USGS counts it.</dd>
            <dd>Removed or corrected wording the cited sources did not support: the year of a Baltimore figure, Oklahoma City’s pipeline capacity, an unsourced estimate for Houston, the Tampa Bay and Peace River figures, and notes on Puerto Rico, Minneapolis and Tulsa. Virginia’s ratio of public-supply withdrawals to home deliveries now counts the Washington Aqueduct’s water for Arlington and Falls Church.</dd>
            <dd>The national chart covers 65 years, from 1950 to 2015. Its title said 70, and it now notes that its early years leave out Hawaii in 1955.</dd>
            <dd>Lancaster County, Pennsylvania’s 2.5 billion gallons a day of power-plant water had been credited to its waste-to-energy plant. USGS counts it for Peach Bottom and Brunner Island, which stand across the Susquehanna in York County, and the map now credits it to them.</dd>
            <dd>The All-American Canal’s figure is labeled as the share diverted for the Imperial and Coachella valleys. Data centers’ electricity water uses 0.47 gallons per kilowatt-hour, matching <a href="/visuals/water">How thirsty is AI?</a>. The opening no longer implies the map shows consumption for every use.</dd>
          </dl>
        </div>
      </details>
    </div>
  </article>
</Base>

<script>
  let handle: { dispose(): void } | null = null;
  let preparedRoot: HTMLElement | null = null;
  let starting = false;

  async function prepareWaterMap() {
    const root = document.querySelector<HTMLElement>('[data-wm-root]');
    if (root === preparedRoot) return;
    handle?.dispose(); handle = null; preparedRoot = root;
    if (!root || starting) return;
    starting = true;
    const msg = root.querySelector<HTMLElement>('[data-wm-load-msg]');
    // the flat map: asked for (?flat), or the browser cannot draw the 3D one
    const flat = async (reason: string) => {
      const { startFlatMap } = await import('../../lib/water-map/flat.js');
      if (preparedRoot !== root || !root.isConnected) return;
      handle = await startFlatMap(root, { dataBase: '/water-map/data/', reason });
    };
    const webgl2 = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
    try {
      if (/[?&]flat\b/.test(location.search)) { await flat(''); return; }
      if (!webgl2) { await flat('This browser cannot draw the 3D map, so this is its flat version: the same county figures on a plain map.'); return; }
      const { startWaterMap } = await import('../../lib/water-map/main.js');
      if (preparedRoot !== root || !root.isConnected) return;
      const h = await startWaterMap(root, { dataBase: '/water-map/data/', lite: /[?&]lite\b/.test(location.search) });
      if (preparedRoot !== root || !root.isConnected) h?.dispose();
      else handle = h;
    } catch (error) {
      console.error(error);
      try { await flat(`The 3D map could not start (${error instanceof Error ? error.message : String(error)}), so this is its flat version: the same county figures on a plain map.`); }
      catch (e2) { if (msg) msg.textContent = `The map could not start: ${error instanceof Error ? error.message : String(error)}.`; }
    } finally { starting = false; }
  }

  document.addEventListener('astro:page-load', prepareWaterMap);
  document.addEventListener('astro:before-swap', () => { handle?.dispose(); handle = null; preparedRoot = null; });
</script>
