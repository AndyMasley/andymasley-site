  @keyframes wv-skeleton {
    0% { background-position: -200px 0; }
    100% { background-position: 200px 0; }
  }
  .wv-bars-area:empty,
  .wv-squares-area:empty {
    background-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.03) 40%, rgba(0,0,0,0.05) 50%, rgba(0,0,0,0.03) 60%, transparent 100%);
    background-size: 400px 100%;
    animation: wv-skeleton 1.5s ease-in-out infinite;
  }

  /* Focus states */
  .wv2 *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* #23 Styled scrollbar */
  .wv-toggles-scroll::-webkit-scrollbar {
    width: 3px;
  }
  .wv-toggles-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .wv-toggles-scroll::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.12);
    border-radius: 3px;
  }

  /* #17 Bar gridlines */
  .wv-bars-area {
    background: repeating-linear-gradient(90deg, transparent, transparent calc(25% - 0.5px), rgba(0,0,0,0.04) calc(25% - 0.5px), rgba(0,0,0,0.04) calc(25% + 0.5px));
    position: relative;
  }
  .wv-gridline-labels {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 0;
    pointer-events: none;
  }
  .wv-gridline-label {
    position: absolute;
    top: 0;
    font-size: 0.55rem;
    color: var(--text-secondary);
    opacity: 0.4;
    transform: translateX(-50%);
  }

  /* #3 Two-item ratio callout */
  .wv-ratio-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .wv-ratio-wrap.wv-ratio-visible {
    max-height: 40px;
  }
  .wv-ratio-callout {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-style: italic;
    padding: 2px 16px 4px;
  }

  /* Panel title */
  .wv-panel-title {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    padding: 10px 12px 4px;
    opacity: 0.6;
  }

  /* #8 Clear all button */
  .wv-clear-all {
    font-family: inherit;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 12px 2px;
    transition: color 0.12s;
  }
  .wv-clear-all:hover {
    color: var(--accent);
  }

  /* #19 Mini-bars in panel */
  .wv-mini-bar {
    display: inline-block;
    height: 3px;
    max-width: 30px;
    background: var(--green);
    border-radius: 1.5px;
    opacity: 0.5;
    vertical-align: middle;
    margin-left: 4px;
    transition: width 0.2s;
  }

  /* #11 Hover-to-preview */
  .wv-bar-row.wv-preview-highlight .wv-bar-fill {
    outline: 2px solid rgba(74, 124, 89, 0.6);
    outline-offset: -2px;
    filter: brightness(1.15);
  }
  .wv-sq-item.wv-preview-highlight .wv-sq-box {
    outline: 2px solid rgba(74, 124, 89, 0.6);
    outline-offset: -2px;
    filter: brightness(1.15);
  }

  /* #21 Count pulse animation */
  .wv-count-pulse {
    transition: transform 0.15s ease;
    transform: scale(1.15);
    display: inline-block;
  }

  /* #16 Treated helper text transition */
  .wv-treated-helper {
    transition: opacity 0.2s ease !important;
  }

  /* #5 Projected items dashed border in squares */
  .wv-sq-item.wv-proj-item .wv-sq-box {
    border-style: dashed !important;
  }

  /* #1 Scale reference */
  .wv-scale-ref {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid var(--divider);
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--bg-elevated, #fff);
  }
  [data-theme="dark"] .wv-scale-ref {
    background: var(--bg-elevated, #1c1c1a);
  }
  .wv-scale-ref-box {
    border: 1.5px solid var(--text-secondary);
    opacity: 0.4;
    border-radius: 2px;
  }

  /* Methodology */
  .w-methodology { max-width: 760px; padding-bottom: 3rem; }
  .w-methodology h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.02em; }
  .w-meth-intro { font-size: 0.82rem; color: var(--dim); line-height: 1.6; margin-bottom: 1.5rem; }
  .w-meth-section { border-bottom: 1px solid var(--border); }
  .w-meth-section:last-child { border-bottom: none; }
  .w-meth-section summary { font-size: 0.88rem; font-weight: 600; color: var(--text); cursor: pointer; list-style: none; padding: 0.75rem 0; display: flex; align-items: center; gap: 8px; user-select: none; }
  .w-meth-section summary::-webkit-details-marker { display: none; }
  .w-meth-section summary::before { content: '\25B8'; font-size: 0.65rem; color: var(--dim); transition: transform 0.15s; }
  .w-meth-section[open] summary::before { transform: rotate(90deg); }
  .w-meth-section summary:hover { color: var(--accent); }
  .w-meth-body { padding: 0 0 1.25rem 20px; }
  .w-meth-body p { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .w-meth-body strong { color: var(--text); }
  .w-meth-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .w-meth-body ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .w-meth-body li { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .w-meth-body li strong { color: var(--text); }
  .w-meth-src { font-size: 0.68rem; color: var(--dim); margin-top: 0.15rem; margin-bottom: 0.75rem; }
  .w-meth-src a { font-size: inherit; }
  .w-meth-calc { font-family: var(--font-mono, monospace); font-size: 0.72rem; background: var(--bg-subtle); padding: 8px 12px; border-radius: 4px; margin: 0.35rem 0 0.5rem; color: var(--text); line-height: 1.5; }
  .w-meth-caveat { font-size: 0.72rem; color: var(--dim); font-style: italic; border-left: 2px solid var(--border); padding-left: 10px; margin: 0.35rem 0 0.75rem; line-height: 1.55; }
  .w-meth-caveat a { color: var(--accent); }
  .w-meth-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 0.75rem; font-size: 0.72rem; line-height: 1.4; }
  .w-meth-table th { text-align: left; font-weight: 600; color: var(--text); padding: 4px 8px; border-bottom: 2px solid var(--border); font-size: 0.68rem; }
  .w-meth-table td { padding: 3px 8px; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-variant-numeric: tabular-nums; }

  /* Responsive */
  @media (max-width: 850px) {
    .wv-layout {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .wv-toggles {
      border-right: none;
      border-bottom: 1px solid var(--divider);
      max-height: 400px;
    }
    .wv-bar-name {
      width: 120px;
      font-size: 0.7rem;
    }
    .wv-bar-val {
      width: 70px;
      font-size: 0.65rem;
    }
  }

  @media (max-width: 480px) {
    .wv2 { padding: 0 0 2rem; }
    .wv-bar-name { width: 90px; font-size: 0.65rem; }
    .wv-bar-val { width: 60px; font-size: 0.6rem; }
  }
</style>

<script is:inline>
(function() {
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }
  function fGShort(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T' : g >= 1e9 ? (g/1e9).toFixed(1)+'B' : (g/1e6).toFixed(0)+'M'; }

  var barsArea = document.getElementById('wv-bars');
  var squaresArea = document.getElementById('wv-squares');
  var countEl = document.getElementById('wv-count');
  var treatedHelper = document.getElementById('wv-treated-helper');
  var ratioEl = document.getElementById('wv-ratio');
  var ratioWrap = document.getElementById('wv-ratio-wrap');
  var shareBtn = document.getElementById('wv-share');
  var currentView = 'squares';
  var waterMode = 'all';
  var items = [];
  var lastCount = -1;
  var prevSelectionState = null; // #12 double-click isolate

  // (#4) Mark sub-items (state-level) vs "All US..." items
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var name = row.querySelector('.wv-row-name');
    if (!name) return;
    var txt = name.textContent;
    if (/^All US|^Total US/.test(txt)) {
      row.classList.add('wv-all-item');
    } else {
      var cat = row.closest('.wv-cat');
      if (cat) {
        var hasAllUS = cat.querySelector('.wv-row-name') && Array.prototype.some.call(cat.querySelectorAll('.wv-row-name'), function(n) {
          return /^All US|^Total US/.test(n.textContent);
        });
        if (hasAllUS) {
          row.classList.add('wv-sub-item');
        }
      }
    }
  });

  // (#10) Add tooltip to crossed-out items
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var tg = row.dataset.tgal;
    if (tg === 'null' || tg === '') {
      row.title = 'Uses untreated water \u2014 not shown in treated mode';
    }
  });

  // View toggle with crossfade
  document.querySelectorAll('.wv-view-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var view = btn.dataset.view;
      if (view === currentView) return;
      document.querySelectorAll('.wv-view-btn').forEach(function(b) {
        b.dataset.active = b.dataset.view === view ? 'true' : 'false';
      });
      var outgoing = view === 'bars' ? squaresArea : barsArea;
      var incoming = view === 'bars' ? barsArea : squaresArea;
      outgoing.style.opacity = '0';
      setTimeout(function() {
        outgoing.style.display = 'none';
        currentView = view;
        render();
        incoming.style.opacity = '0';
        incoming.style.display = '';
        requestAnimationFrame(function() {
          incoming.style.opacity = '1';
        });
      }, 150);
    });
  });

  // Water type toggle (all freshwater vs treated only)
  document.querySelectorAll('.wv-water-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var mode = btn.dataset.water;
      if (mode === waterMode) return;
      waterMode = mode;
      document.querySelectorAll('.wv-water-btn').forEach(function(b) {
        b.dataset.active = b.dataset.water === mode ? 'true' : 'false';
      });
      // (#16) Show/hide treated helper text with opacity transition
      if (treatedHelper) {
        if (mode === 'treated') {
          treatedHelper.style.display = '';
          requestAnimationFrame(function() { treatedHelper.style.opacity = '1'; });
        } else {
          treatedHelper.style.opacity = '0';
          setTimeout(function() { treatedHelper.style.display = 'none'; }, 200);
        }
      }
      // Update crossed-out state and values for all items
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        var it = items[idx];
        if (!it) return;
        if (mode === 'treated') {
          var tg = row.dataset.tgal;
          var isCrossed = tg === 'null' || tg === '';
          row.dataset.crossed = isCrossed ? 'true' : 'false';
          if (isCrossed && it.on) {
            it.on = false;
            row.dataset.on = 'false';
          }
          if (!isCrossed) {
            it.gallons = parseFloat(tg);
            it.sub = fG(it.gallons);
            var valEl = row.querySelector('.wv-row-val');
            if (valEl) valEl.textContent = it.sub;
          }
          var chip = row.querySelector('.wv-elec-chip');
          if (chip) {
            var te = row.dataset.telec;
            var elecCrossed = te === 'null' || te === '' || te === undefined;
            chip.dataset.crossed = elecCrossed ? 'true' : 'false';
            if (elecCrossed && it.elecOn) {
              it.elecOn = false;
              it.gallons = it.galBase;
              chip.dataset.elecOn = 'false';
              it.gallons = parseFloat(row.dataset.tgal);
              it.sub = fG(it.gallons);
              var valEl2 = row.querySelector('.wv-row-val');
              if (valEl2) valEl2.textContent = it.sub;
            }
          }
        } else {
          row.dataset.crossed = 'false';
          var chip2 = row.querySelector('.wv-elec-chip');
          if (chip2) chip2.dataset.crossed = 'false';
          if (it.elecOn) {
            it.gallons = it.galElec;
          } else if (it.galBase > 0) {
            it.gallons = it.galBase;
          } else {
            var gi = parseFloat(row.dataset.galIndustry || 0);
            if (gi > 0) it.gallons = gi;
          }
          it.sub = fG(it.gallons);
          var valEl3 = row.querySelector('.wv-row-val');
          if (valEl3) valEl3.textContent = it.sub;
        }
      });
      render();
    });
  });

  // Init all items from DOM
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var idx = parseInt(row.dataset.idx);
    var galBase = parseFloat(row.dataset.galBase || 0);
    var galElec = parseFloat(row.dataset.galElec || 0);
    var galIndustry = parseFloat(row.dataset.galIndustry || 0);
    var gallons = galIndustry > 0 ? galIndustry : galBase;
    var baseName = row.querySelector('.wv-row-name').textContent;

    var cat = row.closest('.wv-cat');
    var catName = cat ? cat.dataset.cat : '';
    var color = '#6B6B60';
    var catColors = {
      dc: '#4A90D9',
      industry: '#D97A4A',
      city: '#5BA4CF',
      farm: '#4CAF78',
      turf: '#6BBF84',
      national: '#8B8FA8'
    };
    color = catColors[catName] || color;

    var tGalRaw = row.dataset.tgal;
    var tGal = (tGalRaw === 'null' || !tGalRaw) ? null : parseFloat(tGalRaw);
    var tElecRaw = row.dataset.telec;
    var tElec = (tElecRaw === 'null' || !tElecRaw) ? null : parseFloat(tElecRaw);

    // (#19) Add mini-bar span to row
    var rowText = row.querySelector('.wv-row-text');
    if (rowText && !rowText.querySelector('.wv-mini-bar')) {
      var miniBar = document.createElement('span');
      miniBar.className = 'wv-mini-bar';
      miniBar.style.width = '0px';
      var valSpan = rowText.querySelector('.wv-row-val');
      if (valSpan) {
        valSpan.appendChild(document.createTextNode(' '));
        valSpan.appendChild(miniBar);
      }
    }

    items[idx] = {
      idx: idx,
      gallons: gallons,
      on: row.dataset.on === 'true',
      color: color,
      name: baseName,
      sub: fG(gallons),
      baseName: baseName,
      elecOn: false,
      galBase: galBase,
      galElec: galElec,
      tGal: tGal,
      tElec: tElec
    };

    row.addEventListener('click', function(e) {
      if (e.target.closest('.wv-elec-chip')) return;
      items[idx].on = !items[idx].on;
      row.dataset.on = items[idx].on ? 'true' : 'false';
      render();
    });

    // (#12) Double-click to isolate
    row.addEventListener('dblclick', function(e) {
      e.preventDefault();
      if (e.target.closest('.wv-elec-chip')) return;
      var it = items[idx];
      // Check if this item is currently the only one on (restore previous state)
      var onCount = 0;
      var onlyThisOn = true;
      for (var ci = 0; ci < items.length; ci++) {
        if (items[ci] && items[ci].on) {
          onCount++;
          if (ci !== idx) onlyThisOn = false;
        }
      }
      if (onCount === 1 && onlyThisOn && prevSelectionState) {
        // Restore previous state
        for (var ri = 0; ri < items.length; ri++) {
          if (items[ri]) {
            items[ri].on = prevSelectionState[ri] || false;
            var rRow = document.querySelector('.wv-toggle-row[data-idx="' + ri + '"]');
            if (rRow) rRow.dataset.on = items[ri].on ? 'true' : 'false';
          }
        }
        prevSelectionState = null;
      } else {
        // Save current state and isolate
        prevSelectionState = {};
        for (var si = 0; si < items.length; si++) {
          if (items[si]) prevSelectionState[si] = items[si].on;
        }
        for (var ti = 0; ti < items.length; ti++) {
          if (items[ti]) {
            items[ti].on = (ti === idx);
            var tRow = document.querySelector('.wv-toggle-row[data-idx="' + ti + '"]');
            if (tRow) tRow.dataset.on = items[ti].on ? 'true' : 'false';
          }
        }
      }
      render();
    });

    // (#11) Hover-to-preview
    row.addEventListener('mouseenter', function() {
      if (items[idx].on) return;
      var barRow = barsArea.querySelector('.wv-bar-row[data-idx="' + idx + '"]');
      if (barRow) barRow.classList.add('wv-preview-highlight');
      var sqItem = squaresArea.querySelector('.wv-sq-item[data-sq-idx="' + idx + '"]');
      if (sqItem) sqItem.classList.add('wv-preview-highlight');
    });
    row.addEventListener('mouseleave', function() {
      var barRow = barsArea.querySelector('.wv-bar-row[data-idx="' + idx + '"]');
      if (barRow) barRow.classList.remove('wv-preview-highlight');
      var sqItem = squaresArea.querySelector('.wv-sq-item[data-sq-idx="' + idx + '"]');
      if (sqItem) sqItem.classList.remove('wv-preview-highlight');
    });
  });

  // Electricity chip handlers
  document.querySelectorAll('.wv-elec-chip').forEach(function(chip) {
    var parentIdx = parseInt(chip.dataset.parentIdx);
    var parentRow = chip.closest('.wv-toggle-row');

    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      if (!parentRow || parentRow.dataset.on !== 'true') return;

      var nowChecked = chip.dataset.elecOn !== 'true';
      chip.dataset.elecOn = nowChecked ? 'true' : 'false';

      var it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.sub = fG(it.gallons);

      // (#7) Update value text with struck-through original
      var valEl = parentRow.querySelector('.wv-row-val');
      if (valEl) {
        // Remove existing mini-bar before rebuilding text
        var existingMini = valEl.querySelector('.wv-mini-bar');
        if (nowChecked) {
          valEl.innerHTML = '<s style="opacity:0.4">' + fGShort(it.galBase) + '</s> ' + it.sub;
        } else {
          valEl.textContent = it.sub;
        }
        // Re-add mini-bar
        if (!valEl.querySelector('.wv-mini-bar')) {
          var mb = document.createElement('span');
          mb.className = 'wv-mini-bar';
          mb.style.width = '0px';
          valEl.appendChild(document.createTextNode(' '));
          valEl.appendChild(mb);
        }
      }
      render();
    });
  });

  // Category header toggle (accordion — only one open at a time)
  document.querySelectorAll('.wv-cat-head').forEach(function(head) {
    head.addEventListener('click', function(e) {
      if (e.target.closest('.wv-cat-toggle')) return;
      var cat = head.closest('.wv-cat');
      var list = cat.querySelector('.wv-cat-list');
      var chevron = head.querySelector('.wv-cat-chevron');
      var isOpen = list.dataset.visible === 'true';

      document.querySelectorAll('.wv-cat').forEach(function(otherCat) {
        if (otherCat === cat) return;
        var otherList = otherCat.querySelector('.wv-cat-list');
        var otherHead = otherCat.querySelector('.wv-cat-head');
        var otherChevron = otherHead.querySelector('.wv-cat-chevron');
        if (otherList.dataset.visible === 'true') {
          otherList.dataset.visible = 'false';
          otherHead.dataset.open = 'false';
          otherChevron.textContent = '\u25B8';
        }
      });

      list.dataset.visible = isOpen ? 'false' : 'true';
      head.dataset.open = isOpen ? 'false' : 'true';
      chevron.textContent = isOpen ? '\u25B8' : '\u25BE';
    });
  });

  // All / None category toggles
  document.querySelectorAll('.wv-cat-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var cat = btn.closest('.wv-cat');
      if (!cat) return;
      var action = btn.dataset.action;
      var newOn = action === 'all';
      cat.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) {
          items[idx].on = newOn;
          row.dataset.on = newOn ? 'true' : 'false';
        }
      });
      render();
    });
  });

  // (#8) Clear all button
  var clearBtn = document.getElementById('wv-clear-all');
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      for (var ci = 0; ci < items.length; ci++) {
        if (items[ci]) {
          items[ci].on = false;
        }
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'false';
      });
      render();
      clearBtn.textContent = 'Cleared!';
      setTimeout(function() { clearBtn.textContent = 'Clear all'; }, 1500);
    });
  }

  // (#22) Share link
  if (shareBtn) {
    shareBtn.addEventListener('click', function() {
      var activeIndices = [];
      for (var si = 0; si < items.length; si++) {
        if (items[si] && items[si].on) activeIndices.push(si);
      }
      var url = window.location.origin + window.location.pathname + '?items=' + activeIndices.join(',');
      navigator.clipboard.writeText(url).then(function() {
        shareBtn.textContent = 'Copied!';
        setTimeout(function() { shareBtn.textContent = 'Copy link'; }, 2000);
      }).catch(function() {
        shareBtn.textContent = 'Failed';
        setTimeout(function() { shareBtn.textContent = 'Copy link'; }, 2000);
      });
    });
  }

  // (#22) On page load, check for ?items= param
  (function() {
    var params = new URLSearchParams(window.location.search);
    var itemsParam = params.get('items');
    if (itemsParam) {
      var indices = itemsParam.split(',').map(function(s) { return parseInt(s); });
      // Turn off all items first
      for (var pi = 0; pi < items.length; pi++) {
        if (items[pi]) items[pi].on = false;
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'false';
      });
      // Turn on specified items
      for (var qi = 0; qi < indices.length; qi++) {
        var idx = indices[qi];
        if (items[idx]) {
          items[idx].on = true;
          var row = document.querySelector('.wv-toggle-row[data-idx="' + idx + '"]');
          if (row) row.dataset.on = 'true';
        }
      }
    }
  })();

  // (#9) Update category active count badges + total gallons
  function updateCategoryBadges() {
    document.querySelectorAll('.wv-cat').forEach(function(cat) {
      var count = 0;
      var totalGal = 0;
      cat.querySelectorAll('.wv-toggle-row[data-on="true"]').forEach(function(row) {
        count++;
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) totalGal += items[idx].gallons;
      });
      var badge = cat.querySelector('.wv-cat-active');
      if (badge) {
        if (count > 0) {
          badge.textContent = '\u00b7 ' + count + ' on \u00b7 ' + fG(totalGal);
        } else {
          badge.textContent = '';
        }
      }
    });
  }

  function render() {
    var active = [];
    for (var i = 0; i < items.length; i++) {
      if (items[i] && items[i].on) active.push(items[i]);
    }

    updateCategoryBadges();

    // (#21) Count pulse animation
    var newCount = active.length;
    if (countEl) {
      countEl.innerHTML = 'Comparing <strong>' + newCount + '</strong> item' + (newCount === 1 ? '' : 's');
      if (lastCount !== -1 && lastCount !== newCount) {
        countEl.classList.add('wv-count-pulse');
        setTimeout(function() { countEl.classList.remove('wv-count-pulse'); }, 150);
      }
      lastCount = newCount;
    }

    // (#3) Two-item ratio callout
    if (ratioEl && ratioWrap) {
      if (active.length === 2) {
        var sorted = active.slice().sort(function(a, b) { return b.gallons - a.gallons; });
        var ratio = (sorted[0].gallons / sorted[1].gallons).toFixed(1);
        ratioEl.textContent = sorted[0].baseName + ' is ' + ratio + '\u00d7 larger than ' + sorted[1].baseName;
        ratioWrap.classList.add('wv-ratio-visible');
      } else {
        ratioWrap.classList.remove('wv-ratio-visible');
      }
    }

    // (#19) Update mini-bars in panel
    var maxGlobal = 0;
    for (var mi = 0; mi < items.length; mi++) {
      if (items[mi] && items[mi].on && items[mi].gallons > maxGlobal) maxGlobal = items[mi].gallons;
    }
    document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
      var mb = row.querySelector('.wv-mini-bar');
      if (!mb) return;
      var idx = parseInt(row.dataset.idx);
      var it = items[idx];
      if (it && it.on && maxGlobal > 0) {
        mb.style.width = Math.round((it.gallons / maxGlobal) * 30) + 'px';
      } else {
        mb.style.width = '0px';
      }
    });

    if (active.length === 0) {
      barsArea.innerHTML = '<div class="wv-bars-empty">Expand a category on the left and click items to add them to the comparison.</div>';
      squaresArea.innerHTML = '<div class="wv-bars-empty">Toggle items on the left to see their water use as proportional squares.</div>';
      return;
    }

    // Sort largest to smallest
    active.sort(function(a, b) { return b.gallons - a.gallons; });
    var maxG = active[0].gallons;

    // ── Bar view ──
    if (currentView === 'bars') {
      var html = '<div class="wv-gridline-labels"><span class="wv-gridline-label" style="left:25%">25%</span><span class="wv-gridline-label" style="left:50%">50%</span><span class="wv-gridline-label" style="left:75%">75%</span></div>';
      for (var j = 0; j < active.length; j++) {
        var it = active[j];
        var pct = maxG > 0 ? (it.gallons / maxG) * 100 : 0;
        var pctRound = Math.round(pct);
        var isProj = it.name.indexOf('2030') >= 0;
        var elecTag = it.elecOn ? ' +elec' : '';
        var prefix = isProj ? '~' : '';
        var val = prefix + it.sub + elecTag;
        // (#2) Append percentage
        var pctText = ' \u00b7 ' + pctRound + '%';
        // (#5) Projected items get striped background
        var fillStyle = 'width:' + pct.toFixed(1) + '%;background:' + it.color;
        if (isProj) {
          fillStyle += ';background-image:repeating-linear-gradient(45deg,transparent,transparent 3px,rgba(0,0,0,0.03) 3px,rgba(0,0,0,0.03) 6px)';
        }
        html += '<div class="wv-bar-row" data-idx="' + it.idx + '" title="' + it.name + ': ' + val + '" style="border-left:3px solid ' + it.color + ';padding-left:8px">';
        html += '<span class="wv-bar-name" title="' + it.name + '">' + it.name + '</span>';
        html += '<div class="wv-bar-track"><div class="wv-bar-fill" style="' + fillStyle + '"></div></div>';
        html += '<span class="wv-bar-val">' + val + '<span class="wv-bar-pct">' + pctText + '</span></span>';
        html += '</div>';
      }
      barsArea.innerHTML = html;
    }

    // ── Square view ──
    if (currentView === 'squares') {
      var panelW = squaresArea.clientWidth - 32;
      var panelH = squaresArea.clientHeight - 32;
      if (panelW < 100) panelW = 600;
      if (panelH < 100) panelH = 500;

      var maxSide = Math.round(Math.min(panelW, panelH) * 0.8);
      var labelH = 32;

      var sized = [];
      for (var k = 0; k < active.length; k++) {
        var sq = active[k];
        var side = Math.max(2, Math.round(maxSide * Math.sqrt(sq.gallons / maxG)));
        var isP = sq.name.indexOf('2030') >= 0;
        var eTag = sq.elecOn ? ' +elec' : '';
        var pre = isP ? '~' : '';
        var v = pre + sq.sub + eTag;
        sized.push({ sq: sq, side: side, val: v });
      }

      var measureCanvas = document.createElement('canvas');
      var ctx = measureCanvas.getContext('2d');
      ctx.font = '500 11px sans-serif';

      var scale = 1;
      var placed, totalH;
      for (var attempt = 0; attempt < 10; attempt++) {
        var gap = Math.max(8, Math.round(14 * scale));
        placed = [];
        var shelfX = 0, shelfY = 0, shelfH = 0;
        for (var s = 0; s < sized.length; s++) {
          var scaledSide = Math.max(2, Math.round(sized[s].side * scale));
          var textW = ctx.measureText(sized[s].sq.name).width + 8;
          var labelBelowPack = scaledSide >= 60;
          var nameW = textW;
          var itemW, itemH;
          if (labelBelowPack) {
            itemW = Math.max(scaledSide, nameW * Math.min(1, scale + 0.3), 36);
            itemH = scaledSide + labelH;
          } else {
            itemW = scaledSide + 6 + nameW;
            itemH = Math.max(scaledSide, 20) + 8;
          }
          if (shelfX + itemW > panelW && shelfX > 0) {
            shelfY += shelfH + gap;
            shelfX = 0;
            shelfH = 0;
          }
          placed.push({ x: shelfX, y: shelfY, w: itemW, h: itemH, scaledSide: scaledSide, data: sized[s] });
          shelfH = Math.max(shelfH, itemH);
          shelfX += itemW + gap;
        }
        totalH = shelfY + shelfH + 16;
        if (totalH <= panelH || scale < 0.15) break;
        scale *= 0.75;
      }
      var fitH = Math.max(totalH, panelH);

      var container = squaresArea.querySelector('.wv-sq-container');
      if (!container) {
        container = document.createElement('div');
        container.className = 'wv-sq-container';
        container.style.position = 'relative';
        container.style.width = '100%';
        squaresArea.innerHTML = '';
        squaresArea.appendChild(container);
      }
      container.style.height = fitH + 'px';

      var existing = {};
      container.querySelectorAll('.wv-sq-item').forEach(function(el) {
        existing[el.dataset.sqIdx] = el;
      });

      var usedKeys = {};

      for (var p = 0; p < placed.length; p++) {
        var pl = placed[p];
        var d = pl.data;
        var ss = pl.scaledSide;
        var key = '' + d.sq.idx;
        usedKeys[key] = true;

        // (#18) Proportional font sizes
        var fontSize = Math.max(9, Math.min(13, ss * 0.12)) + 'px';
        var valSize = Math.max(8, Math.min(11, ss * 0.1)) + 'px';

        var el = existing[key];
        if (!el) {
          el = document.createElement('div');
          el.className = 'wv-sq-item';
          el.dataset.sqIdx = key;
          el.innerHTML = '<div class="wv-sq-box"></div><div class="wv-sq-color-bar"></div><div class="wv-sq-label"><span class="wv-sq-name"></span><span class="wv-sq-val"></span></div>';
          el.style.position = 'absolute';
          el.style.opacity = '0';
          container.appendChild(el);
          el.offsetHeight;
          el.style.opacity = '1';
        }

        // (#5) Projected items: dashed border
        var isProj2030 = d.sq.name.indexOf('2030') >= 0;
        if (isProj2030) {
          el.classList.add('wv-proj-item');
        } else {
          el.classList.remove('wv-proj-item');
        }

        // (#13) Square hover tooltip
        el.title = d.sq.name + ': ' + d.val;

        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        var fillOpacity = isDark ? '0.55' : '0.5';

        var labelBelow = ss >= 60;
        var showName = true;

        if (labelBelow) {
          el.style.flexDirection = 'column';
          el.style.alignItems = 'center';
        } else {
          el.style.flexDirection = 'row';
          el.style.alignItems = 'center';
          el.style.gap = '6px';
        }

        el.style.left = pl.x + 'px';
        el.style.top = pl.y + 'px';
        el.style.width = labelBelow ? pl.w + 'px' : '';
        var box = el.querySelector('.wv-sq-box');
        if (ss < 10) {
          box.style.width = '6px';
          box.style.height = '6px';
          box.style.borderRadius = '50%';
          box.style.background = d.sq.color;
          box.style.opacity = fillOpacity;
          box.style.border = 'none';
          box.style.flexShrink = '0';
        } else {
          box.style.width = ss + 'px';
          box.style.height = ss + 'px';
          box.style.borderRadius = '3px';
          box.style.background = d.sq.color;
          box.style.opacity = fillOpacity;
          box.style.border = '2px solid ' + d.sq.color;
          box.style.borderColor = d.sq.color;
          box.style.flexShrink = '0';
        }
        var colorBar = el.querySelector('.wv-sq-color-bar');
        if (colorBar) {
          colorBar.style.width = '20px';
          colorBar.style.height = '2px';
          colorBar.style.background = d.sq.color;
          colorBar.style.borderRadius = '1px';
          colorBar.style.flexShrink = '0';
        }
        var nameEl = el.querySelector('.wv-sq-name');
        nameEl.textContent = showName ? d.sq.name : '';
        nameEl.title = d.sq.name;
        nameEl.style.fontSize = fontSize;
        nameEl.style.textAlign = labelBelow ? 'center' : 'left';
        var valEl = el.querySelector('.wv-sq-val');
        valEl.textContent = d.val;
        valEl.style.fontSize = valSize;
        valEl.style.textAlign = labelBelow ? 'center' : 'left';
        var labelEl = el.querySelector('.wv-sq-label');
        if (labelEl) {
          labelEl.style.textAlign = labelBelow ? 'center' : 'left';
        }
      }

      // (#1) Scale reference
      var refEl = container.querySelector('.wv-scale-ref');
      if (!refEl) {
        refEl = document.createElement('div');
        refEl.className = 'wv-scale-ref';
        container.appendChild(refEl);
      }
      var refSide = Math.max(2, Math.round(maxSide * scale * Math.sqrt(1e9 / maxG)));
      if (refSide >= 2 && refSide <= 60) {
        refEl.innerHTML = '<div class="wv-scale-ref-box" style="width:' + refSide + 'px;height:' + refSide + 'px"></div> 1B gal/yr';
        refEl.style.display = '';
      } else {
        refEl.style.display = 'none';
      }

      // Remove items no longer active
      for (var eKey in existing) {
        if (!usedKeys[eKey]) {
          var removeEl = existing[eKey];
          removeEl.style.opacity = '0';
          removeEl.style.transition = 'opacity 0.3s ease';
          setTimeout(function(el) { if (el.parentNode) el.parentNode.removeChild(el); }, 350, removeEl);
        }
      }
    }
  }

  // (#13) Click bar rows to toggle items off
  barsArea.addEventListener('click', function(e) {
    var barRow = e.target.closest('.wv-bar-row');
    if (!barRow) return;
    var idx = parseInt(barRow.dataset.idx);
    if (items[idx]) {
      items[idx].on = !items[idx].on;
      var panelRow = document.querySelector('.wv-toggle-row[data-idx="' + idx + '"]');
      if (panelRow) panelRow.dataset.on = items[idx].on ? 'true' : 'false';
      render();
    }
  });

  render();
})();
</script>
</Base>
