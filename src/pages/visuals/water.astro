---
import Base from '@/layouts/Base.astro';

function fG(g: number) {
  return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr';
}

// ChatGPT bounds: all use 2.5B messages/day × 365, electricity at 310 GWh × 1.19 = 369M gal
// Lower: Altman's 0.322 mL/query on-site → 77.6M direct, 447M w/ elec
// Middle: 3× Altman (conservative independent est.) → 233M direct, 602M w/ elec
// Upper: Ren et al. on-site U.S. avg 2.2 mL/query (6.8× Altman) → 528M direct, 897M w/ elec
// tGal = treated water gallons (municipal/potable). null = cross out in treated mode.
// tElec = treated water with electricity. null = cross out.
// DC direct cooling: mostly municipal water, so tGal ≈ base.
// DC electricity: power plants use untreated river water, so tElec = null (cross out).
const dcItems = [
  { name: 'ChatGPT (lower — Altman)', base: 77.6e6, elec: 447e6, tGal: 77.6e6, tElec: null, color: '#7ec8f0', on: false },
  { name: 'ChatGPT (middle — 3× Altman)', base: 233e6, elec: 602e6, tGal: 233e6, tElec: null, color: '#3ba0d8', on: false },
  { name: 'ChatGPT (upper — Ren et al.)', base: 528e6, elec: 897e6, tGal: 528e6, tElec: null, color: '#1a6fa0', on: false },
  { name: 'All US AI workloads (2024)', base: 4e9, elec: 52e9, tGal: 4e9, tElec: null, color: '#4a69aa', on: false },
  { name: 'Microsoft operations (FY23)', base: 2.07e9, elec: 30e9, tGal: 2.07e9, tElec: null, color: '#6a9dc8', on: true },
  { name: 'Google operations (2024)', base: 6e9, elec: 36e9, tGal: 6e9, tElec: null, color: '#5088b8', on: true },
  { name: 'All US data centers (2023)', base: 17.4e9, elec: 227e9, tGal: 17.4e9, tElec: null, color: '#7b72ab', on: true },
  { name: 'ChatGPT 2030 (middle est.)', base: 700e6, elec: 1.8e9, tGal: 700e6, tElec: null, color: '#c4a0e0', on: false },
  { name: 'All US AI 2030 (projected)', base: 17e9, elec: 150e9, tGal: 17e9, tElec: null, color: '#9080c0', on: false },
  { name: 'Microsoft 2030 (projected)', base: 4.8e9, elec: 60e9, tGal: 4.8e9, tElec: null, color: '#a0b8d8', on: false },
  { name: 'Google 2030 (projected)', base: 10e9, elec: 70e9, tGal: 10e9, tElec: null, color: '#88a8c8', on: false },
  { name: 'All US DCs 2030 (projected)', base: 51e9, elec: 560e9, tGal: 51e9, tElec: null, color: '#a888c8', on: false },
];

// Industries: mixed water sources. tGal = fraction from municipal/treated supply.
// Semis: ~95% municipal (need pre-treated baseline for UPW). Food: ~80% (potable required by law).
// Auto: ~65% municipal. Oil/steel/paper: almost entirely self-supplied from rivers.
const industryItems = [
  { name: 'US semiconductor fabs', gal: 9e9, tGal: 8.5e9, color: '#d4825e', on: false },  // ~95% municipal
  { name: 'US auto manufacturing', gal: 12e9, tGal: 7.8e9, color: '#c87450', on: false },  // ~65% municipal
  { name: 'US oil refining', gal: 22e9, tGal: null, color: '#b86844', on: false },          // ~5% — negligible
  { name: 'US steel production', gal: 65e9, tGal: null, color: '#a85c3a', on: false },      // ~4% — negligible
  { name: 'US food & beverage', gal: 150e9, tGal: 120e9, color: '#984e30', on: false },     // ~80% (potable required)
  { name: 'US paper & pulp mills', gal: 175e9, tGal: null, color: '#884228', on: false },   // ~0% — all river water
];

// Agriculture & land use
// Crop rates from USDA 2023 IWMS Table 39 (applied irrigation, national avg):
//   Corn: 1.0 ac-ft/ac = 325,851 gal/ac. Alfalfa: 2.3 ac-ft/ac = 749,457 gal/ac.
//   Berries: ~1.0 ac-ft/ac = 325,851 gal/ac (estimated, varies by type).
// Acreage from USDA 2023 IWMS Table 38.
// Golf: GCSAA Phase 4 (2024), US median 1.1 ac-ft/ac = 358,436 gal/ac, 1.057M irrigated acres.
// Lawns: EPA/NASA, ~800,000 gal/ac (est. 30 in supplemental), ~20M irrigated acres.
// Irrigated farmland — all crops in one category
// Agriculture: untreated irrigation water from wells/rivers. tGal = null (cross out).
const farmItems = [
  { name: 'All US corn (2023)', gal: 3.79e12, tGal: null, color: '#6aaa58', on: true },
  { name: 'Nebraska corn', gal: 1.45e12, tGal: null, color: '#82c06e', on: false },
  { name: 'Kansas corn', gal: 374e9, tGal: null, color: '#82c06e', on: false },
  { name: 'Arkansas corn', gal: 232e9, tGal: null, color: '#82c06e', on: false },
  { name: 'Texas corn', gal: 184e9, tGal: null, color: '#82c06e', on: false },
  { name: 'All US alfalfa (2023)', gal: 4.05e12, tGal: null, color: '#4a8840', on: false },
  { name: 'Idaho alfalfa', gal: 627e9, tGal: null, color: '#5e9c50', on: false },
  { name: 'California alfalfa', gal: 460e9, tGal: null, color: '#5e9c50', on: false },
  { name: 'Montana alfalfa', gal: 419e9, tGal: null, color: '#5e9c50', on: false },
  { name: 'Colorado alfalfa', gal: 399e9, tGal: null, color: '#5e9c50', on: false },
  { name: 'All US berries (2023)', gal: 80e9, tGal: null, color: '#9b59b6', on: false },
  { name: 'California berries', gal: 17e9, tGal: null, color: '#b07cc6', on: false },
  { name: 'Washington berries', gal: 11.3e9, tGal: null, color: '#b07cc6', on: false },
  { name: 'Oregon berries', gal: 8.5e9, tGal: null, color: '#b07cc6', on: false },
  { name: 'Wisconsin berries', gal: 7.6e9, tGal: null, color: '#b07cc6', on: false },
];

// Lawns: EPA says outdoor use = ~30% of residential, residential = ~60% of public supply.
// Total US outdoor residential (all sources): ~2.4T gal/yr (30% × 60% × 13.1T).
// About 70% of that is lawn irrigation specifically = ~1.7T from municipal supply.
// Total from ALL sources (including private wells): ~3T gal/yr.
// State figures scaled proportionally by housing stock + climate.
// Golf: GCSAA data — ~15% municipal potable, ~45% wells, ~25% surface, ~15% reclaimed.
// Arizona golf: ~335 courses × 80 ac × 358,436 gal/ac = 9.6B
const turfItems = [
  { name: 'All US lawn irrigation (est.)', gal: 3e12, tGal: 1.7e12, color: '#27ae60', on: false },
  { name: 'Florida lawns', gal: 350e9, tGal: 175e9, color: '#2ecc71', on: false },
  { name: 'California lawns', gal: 400e9, tGal: 240e9, color: '#2ecc71', on: false },
  { name: 'Texas lawns', gal: 320e9, tGal: 176e9, color: '#2ecc71', on: false },
  { name: 'All US golf courses (2024)', gal: 379e9, tGal: 57e9, color: '#1abc9c', on: false },
  { name: 'Arizona golf courses', gal: 9.6e9, tGal: 960e6, color: '#1abc9c', on: false },
];

// City water systems — base = water delivered; elec = base + water cost of electricity
// for pumping, treatment, and distribution. Electricity intensity varies by city:
// NYC/Chicago: ~1.5 kWh/1000 gal (gravity-fed or lake). LA/Phoenix/Vegas: ~5 kWh/1000 gal
// (long-distance import over mountains or desert pumping). × 1.19 gal water/kWh.
// Cities: 100% treated municipal water. tGal = same as gal.
const cityItems = [
  { name: 'New York City', gal: 364e9, tGal: 364e9, color: '#3498db', on: false },
  { name: 'Chicago metro system', gal: 274e9, tGal: 274e9, color: '#2e86c1', on: false },
  { name: 'Los Angeles', gal: 146e9, tGal: 146e9, color: '#2471a3', on: false },
  { name: 'Phoenix', gal: 95.5e9, tGal: 95.5e9, color: '#1a5276', on: false },
  { name: 'Las Vegas metro (SNWA)', gal: 77e9, tGal: 77e9, color: '#154360', on: false },
];

// National: freshwater withdrawals includes untreated (cross out in treated mode).
// Public water supply IS treated water.
const nationalItems = [
  { name: 'Total US freshwater withdrawals', gal: 102.6e12, tGal: null, color: '#1a3c5e', on: false },
  { name: 'Total US public water supply', gal: 13.1e12, tGal: 13.1e12, color: '#2a5f8f', on: false },
];

let idx = 0;
const dcFlat = dcItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const indFlat = industryItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
const cityFlat = cityItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
const natFlat = nationalItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
const farmFlat = farmItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
const turfFlat = turfItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
---

<Base title="AI Water Usage" description="How much water does AI use?">

  <header>
    <h1>How thirsty is AI?</h1>
    <p style="font-size: 0.85rem; line-height: 1.65; color: var(--text-secondary, #6B6B60); margin-top: 0.75rem; max-width: 640px;">Consumptive water use in gallons per year. Each bar is sized proportionally to annual water consumption — water evaporated, incorporated into products, or otherwise not returned to source. Toggle items to compare.</p>
  </header>

  <article class="wv2" id="wv2">
    <div class="wv-layout">
      <!-- Toggle panel (left) -->
      <div class="wv-toggles">
        <div class="wv-toggles-scroll">
          <div class="wv-panel-title">ITEMS</div>
          <button class="wv-clear-all" id="wv-clear-all">Clear all</button>

          <!-- Data centers -->
          <div class="wv-cat" data-cat="dc">
            <button class="wv-cat-head" data-open="true">
              <span class="wv-cat-chevron">&#9662;</span>
              <span class="wv-cat-title">Data centers</span>
              <span class="wv-cat-count">{dcFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="true">
              {dcFlat.map((d, i) => (
                <div class="wv-dc-group">
                  {i === 7 && <div class="wv-proj-divider">2030 projections</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                    data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                    data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                    data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{i >= 7 ? '~' : ''}{fG(d.base)}</span>
                      <span class="wv-elec-chip" data-parent-idx={d.idx} title="Include water consumed to generate electricity powering this operation (1.19 gal/kWh, LBNL)">+ elec</span>
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Other industries -->
          <div class="wv-cat" data-cat="industry">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>
              <span class="wv-cat-title">Other industries</span>
              <span class="wv-cat-count">{indFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {indFlat.map(d => (
                <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'} data-gal-industry={d.gal} data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}>
                  <span class="wv-dot"></span>
                  <span class="wv-row-text">
                    <span class="wv-row-name">{d.name}</span>
                    <span class="wv-row-val">{d.sub}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- City water systems -->
          <div class="wv-cat" data-cat="city">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>
              <span class="wv-cat-title">City water systems</span>
              <span class="wv-cat-count">{cityFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {cityFlat.map(d => (
                <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'} data-gal-industry={d.gal} data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}>
                  <span class="wv-dot"></span>
                  <span class="wv-row-text">
                    <span class="wv-row-name">{d.name}</span>
                    <span class="wv-row-val">{d.sub}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Irrigated farmland -->
          <div class="wv-cat" data-cat="farm">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>
              <span class="wv-cat-title">Irrigated farmland</span>
              <span class="wv-cat-count">{farmFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {farmFlat.map((d, i) => (
                <div>
                  {i === 1 && <div class="wv-proj-divider">Corn by state</div>}
                  {i === 5 && <div class="wv-proj-divider">Alfalfa (US & states)</div>}
                  {i === 6 && <div class="wv-proj-divider">Alfalfa by state</div>}
                  {i === 10 && <div class="wv-proj-divider">Berries (US & states)</div>}
                  {i === 11 && <div class="wv-proj-divider">Berries by state</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'} data-gal-industry={d.gal} data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{d.sub}</span>
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Lawns & turf -->
          <div class="wv-cat" data-cat="turf">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>
              <span class="wv-cat-title">Lawns & turf</span>
              <span class="wv-cat-count">{turfFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {turfFlat.map((d, i) => (
                <div>
                  {i === 1 && <div class="wv-proj-divider">Lawns by state</div>}
                  {i === 4 && <div class="wv-proj-divider">Golf courses</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'} data-gal-industry={d.gal} data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{d.sub}</span>
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- National totals -->
          <div class="wv-cat" data-cat="national">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>
              <span class="wv-cat-title">National totals</span>
              <span class="wv-cat-count">{natFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {natFlat.map(d => (
                <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'} data-gal-industry={d.gal} data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}>
                  <span class="wv-dot"></span>
                  <span class="wv-row-text">
                    <span class="wv-row-name">{d.name}</span>
                    <span class="wv-row-val">{d.sub}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>

        </div>
      </div>

      <!-- Chart panel (right) -->
      <div class="wv-chart-panel">
        <div class="wv-chart-header">
          <div class="wv-header-left">
            <div style="display:flex;align-items:center;gap:6px"><span class="wv-chart-count" id="wv-count">Comparing 3 items</span><button class="wv-share-btn" id="wv-share" style="font-family:inherit;font-size:0.65rem;color:var(--text-secondary);background:none;border:1px solid var(--divider);border-radius:4px;padding:2px 8px;cursor:pointer;transition:color 0.12s">Copy link</button></div>
            <div class="wv-treated-helper" id="wv-treated-helper" style="display:none;opacity:0">Showing only water from municipal supply. Crossed-out items use untreated sources.</div>
          </div>
          <div class="wv-header-controls">
            <div class="wv-water-toggle">
              <button class="wv-water-btn" data-water="all" data-active="true">All freshwater</button>
              <button class="wv-water-btn" data-water="treated" data-active="false">Treated only</button>
            </div>
            <div class="wv-view-toggle">
              <button class="wv-view-btn" data-view="squares" data-active="true">Squares</button>
              <button class="wv-view-btn" data-view="bars" data-active="false">Bars</button>
            </div>
          </div>
        </div>
        <div class="wv-ratio-wrap" id="wv-ratio-wrap"><div class="wv-ratio-callout" id="wv-ratio"></div></div>
        <div class="wv-bars-area" id="wv-bars" style="display:none">
          <div class="wv-bars-empty">Expand a category on the left and click items to add them to the comparison.</div>
        </div>
        <div class="wv-squares-area" id="wv-squares">
        </div>
      </div>
    </div>
  </article>

  <div class="w-methodology">
    <h2>Methodology</h2>
    <p class="w-meth-intro">All figures represent <strong>consumptive</strong> water use — water evaporated, incorporated into products, or not returned to source. Every figure is year-stamped. This visualization mixes U.S.-only totals (LBNL data centers, USDA crops) with global corporate totals (Microsoft, Google) and global AI-service usage (ChatGPT) — the comparison is useful for scale but is not a geographic like-for-like.</p>

    <details class="w-meth-section" open>
      <summary>Data centers — direct cooling</summary>
      <div class="w-meth-body">
        <p><strong>All US data centers, 2023: 17.4B gal/yr.</strong> LBNL's 2024 report: 66 billion liters direct site water. 66B L ÷ 3.785 = 17.4B gal. This is the strongest number in the visualization.</p>
        <p class="w-meth-src">Source: <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy" target="_blank" rel="noopener">LBNL — 2024 United States Data Center Energy Usage Report</a></p>

        <p><strong>ChatGPT — three bounds.</strong> All use OpenAI's "more than 2.5 billion messages per day" (2025), assuming one message = one query. Electricity for all three uses Altman's 0.34 Wh/query: 310 GWh/yr x 1.19 gal/kWh = 369M gal indirect.</p>
        <table class="w-meth-table">
          <thead><tr><th>Bound</th><th>On-site mL/query</th><th>Direct gal/yr</th><th>+ Electricity</th><th>Total</th></tr></thead>
          <tbody>
            <tr><td>Lower (Altman)</td><td>0.322 mL</td><td>77.6M</td><td>369M</td><td>447M</td></tr>
            <tr><td>Middle (3x Altman)</td><td>~1 mL</td><td>233M</td><td>369M</td><td>602M</td></tr>
            <tr><td>Upper (Ren et al.)</td><td>2.2 mL</td><td>528M</td><td>369M</td><td>897M</td></tr>
          </tbody>
        </table>
        <p><strong>Lower:</strong> Sam Altman's stated 0.000085 gal (0.322 mL) per query — the only official figure.</p>
        <p><strong>Middle:</strong> ~3x Altman. A conservative independent estimate reflecting cooling infrastructure overhead not captured at the per-query level.</p>
        <p><strong>Upper:</strong> Ren et al. (2023) model a medium GPT-3 request at 2.2 mL on-site water (U.S. avg), ~6.8x Altman. Their task (800 words in, 150-300 out) differs from an average ChatGPT query; the paper notes their estimate is conservative.</p>
        <p class="w-meth-src">Sources: <a href="https://samaltman.com/2025/01/10/what-i-wish-someone-had-told-me-about-chatgpt/" target="_blank" rel="noopener">Sam Altman's post</a>, <a href="https://arxiv.org/abs/2304.03271" target="_blank" rel="noopener">Ren et al. 2023 (arXiv)</a></p>

        <p><strong>Microsoft operations, FY23: 2.07B gal/yr.</strong> Microsoft's Environmental Data Fact Sheet reports 7,844 megaliters of total water consumption. Reporting boundary uses operational control and includes <em>global owned and leased real-estate facilities and datacenters</em> — this is company-wide, not datacenter-specific. 7,844 ML x 264.172 gal/kL = 2.07B gal.</p>
        <p class="w-meth-caveat">For datacenter-specific data, Microsoft publishes WUE: 0.30 L/kWh in FY24, 0.27 L/kWh in FY25 (liters used for humidification and cooling per kWh of IT equipment power).</p>
        <p class="w-meth-src">Source: <a href="https://www.microsoft.com/en-us/corporate-responsibility/sustainability/report" target="_blank" rel="noopener">Microsoft Environmental Data Fact Sheet</a></p>

        <p><strong>Google operations, 2024: ~6B gal/yr.</strong> Google's 2025 Environmental Report (covering FY2024 data) reports total operational water consumption. Scope includes data centers and offices. The exact datacenter-only breakout is not published separately.</p>
        <p class="w-meth-src">Source: <a href="https://sustainability.google/reports/" target="_blank" rel="noopener">Google 2025 Environmental Report</a></p>
      </div>
    </details>

    <details class="w-meth-section">
      <summary>Data centers — including electricity generation</summary>
      <div class="w-meth-body">
        <p><strong>Rate: 1.19 gal/kWh</strong> (LBNL's location-based factor for U.S. data-center electricity, computed from county and balancing-authority-specific electricity mixes). This is the mainline factor used throughout.</p>
        <p class="w-meth-caveat">LBNL's factor includes hydroelectric reservoir evaporation. Peer-reviewed literature (Bakken et al., Grubert) shows hydropower water accounting is methodologically unsettled — gross evaporation methods can ignore pre-dam evaporation and multipurpose reservoir allocation. A thermoelectric-only sensitivity case using NREL's 0.47 gal/kWh would reduce all "+ electricity" figures by roughly 60%. We use LBNL's factor as the mainline value because the rest of the visualization is attributional and average-based, and the thermoelectric-only factor reflects a consequential/marginal accounting choice that is inconsistent with that framing.</p>
        <table class="w-meth-table">
          <thead><tr><th></th><th>Electricity</th><th>x 1.19 gal/kWh</th><th>+ Direct</th><th>= Total</th></tr></thead>
          <tbody>
            <tr><td>ChatGPT (lower)</td><td>310 GWh</td><td>369M</td><td>77.6M</td><td>447M gal/yr</td></tr>
            <tr><td>ChatGPT (middle)</td><td>310 GWh</td><td>369M</td><td>233M</td><td>602M gal/yr</td></tr>
            <tr><td>ChatGPT (upper)</td><td>310 GWh</td><td>369M</td><td>528M</td><td>897M gal/yr</td></tr>
            <tr><td>Microsoft ops (FY23)</td><td>23.6 TWh</td><td>28.1B</td><td>2.07B</td><td>30B gal/yr</td></tr>
            <tr><td>Google ops (2024)</td><td>~25.3 TWh</td><td>30.1B</td><td>6B</td><td>36B gal/yr</td></tr>
            <tr><td>All US data centers (2023)</td><td>176 TWh</td><td>209B</td><td>17.4B</td><td>227B gal/yr</td></tr>
          </tbody>
        </table>
        <p class="w-meth-src">Sources: <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy" target="_blank" rel="noopener">LBNL 2024 Report</a> (1.19 gal/kWh derived from ~800B L indirect / 176 TWh)</p>
      </div>
    </details>

    <details class="w-meth-section">
      <summary>Other industries — consumptive use</summary>
      <div class="w-meth-body">
        <p>Industry figures are derived from withdrawal data x sector consumption ratios. USGS does not publish consumption by manufacturing subsector; ratios come from USGS historical studies, DOE/Argonne research, and industry analyses.</p>
        <table class="w-meth-table">
          <thead><tr><th>Industry</th><th>Withdrawal</th><th>Consumption ratio</th><th>Consumed</th></tr></thead>
          <tbody>
            <tr><td>Semiconductor fabs</td><td>~29B gal/yr</td><td>~30%</td><td>9B</td></tr>
            <tr><td>Auto manufacturing</td><td>~50B</td><td>~20%</td><td>12B</td></tr>
            <tr><td>Oil refining</td><td>~100B</td><td>~22%</td><td>22B</td></tr>
            <tr><td>Steel production</td><td>~660B</td><td>~10%</td><td>65B</td></tr>
            <tr><td>Food & beverage</td><td>~700B</td><td>~25%</td><td>150B</td></tr>
            <tr><td>Paper & pulp</td><td>~1,460B</td><td>~12%</td><td>175B</td></tr>
          </tbody>
        </table>
        <p class="w-meth-src">Sources: <a href="https://www.construction-physics.com/p/how-does-the-us-use-water" target="_blank" rel="noopener">Construction Physics</a>, <a href="https://greet.anl.gov/files/refineries-water-2016" target="_blank" rel="noopener">Argonne GREET</a>, <a href="https://pubs.usgs.gov/wsp/1330h/report.pdf" target="_blank" rel="noopener">USGS</a></p>
        <p class="w-meth-caveat">Food & beverage has the widest uncertainty (~100-275B). Semiconductor and auto figures are moderate confidence.</p>
      </div>
    </details>

    <details class="w-meth-section">
      <summary>Agriculture & land use</summary>
      <div class="w-meth-body">
        <p>Crop water = irrigated acres x applied irrigation rate. <strong>Rates from USDA 2023 IWMS Table 39</strong> (national averages of water actually applied by irrigators, not total crop water need):</p>
        <table class="w-meth-table">
          <thead><tr><th>Crop</th><th>Applied rate</th><th>Gal/acre/yr</th><th>US irrigated acres</th><th>Total gal/yr</th></tr></thead>
          <tbody>
            <tr><td>Corn for grain</td><td>1.0 ac-ft/ac</td><td>325,851</td><td>11.64M (Table 38)</td><td>3.79T</td></tr>
            <tr><td>Alfalfa</td><td>2.3 ac-ft/ac</td><td>749,457</td><td>5.41M (Table 38)</td><td>4.05T</td></tr>
            <tr><td>Berries (all types)</td><td>~1.0 ac-ft/ac (est.)</td><td>~325,851</td><td>246K (Table 38)</td><td>~80B</td></tr>
          </tbody>
        </table>
        <p class="w-meth-src">Source: <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/" target="_blank" rel="noopener">USDA NASS 2023 IWMS Tables 38 & 39</a></p>

        <p><strong>Golf courses (2024): 379B gal/yr.</strong> GCSAA Phase 4 water report: U.S. median applied water in 2024 was 1.1 ac-ft/irrigated acre (358,436 gal/ac). Total irrigated golf turf: 1,057,165 acres (2024 projection, down from 1,181,611 in 2005). This is the <em>national median</em>; Southwest median is 3.3 ac-ft/ac. We use the national figure.</p>
        <p class="w-meth-caveat">Golf data comes from an industry survey (GCSAA), not USDA, making it inherently softer than the crop figures. State-level golf breakouts are not included because the source data is less reliable at that granularity.</p>

        <p><strong>Residential lawns (est.): 16T gal/yr.</strong> NASA's Milesi (2005) satellite study estimated ~40M total U.S. turfgrass acres; ~20M are estimated irrigated residential lawns. At ~800,000 gal/acre/yr (~30 in supplemental irrigation, national rough average). State figures are rough proportional estimates — no federal agency tracks irrigated residential lawn area.</p>
        <p class="w-meth-src">Sources: <a href="https://earthobservatory.nasa.gov/features/Lawn" target="_blank" rel="noopener">NASA Earth Observatory — Milesi study</a>, <a href="https://www.epa.gov/watersense/outdoors" target="_blank" rel="noopener">EPA WaterSense</a></p>
      </div>
    </details>

    <details class="w-meth-section">
      <summary>City water systems & national totals</summary>
      <div class="w-meth-body">
        <p>City figures are total annual water delivered by the municipal system (residential + commercial + industrial customers).</p>
        <table class="w-meth-table">
          <thead><tr><th>System</th><th>Annual delivery</th><th>Year</th><th>Source</th></tr></thead>
          <tbody>
            <tr><td>New York City</td><td>364B gal (997 MGD)</td><td>2023</td><td>NYC DEP</td></tr>
            <tr><td>Chicago metro</td><td>274B gal (750 MGD)</td><td>~2023</td><td>City of Chicago (incl. suburbs)</td></tr>
            <tr><td>Los Angeles</td><td>146B gal</td><td>FY 2023-24</td><td>LADWP</td></tr>
            <tr><td>Phoenix</td><td>95.5B gal</td><td>FY 2023-24</td><td>City billing data</td></tr>
            <tr><td>Las Vegas metro</td><td>77B gal</td><td>2024</td><td>SNWA (derived from GPCD)</td></tr>
          </tbody>
        </table>
        <p><strong>US national totals:</strong> Total freshwater withdrawals (all uses): 102.6T gal/yr (USGS 2015, 281 Bgal/d). Total public water supply: 13.1T gal/yr (USGS 2020, 35.9 Bgal/d).</p>
        <p class="w-meth-src">Sources: <a href="https://pubs.usgs.gov/publication/cir1441" target="_blank" rel="noopener">USGS Circular 1441 (2015)</a>, <a href="https://pubs.usgs.gov/publication/pp1894D" target="_blank" rel="noopener">USGS Professional Paper 1894D (2020)</a></p>
      </div>
    </details>

    <details class="w-meth-section">
      <summary>Key caveats</summary>
      <div class="w-meth-body">
        <ul>
          <li><strong>ChatGPT is a lower-bound proxy.</strong> Altman's per-query figure is the only official number. Ren et al.'s modeled estimate is ~6.8x higher for on-site water alone, but models a different task. The true figure is somewhere in between; we label it accordingly.</li>
          <li><strong>Microsoft and Google are global operational totals</strong>, not U.S.-only or datacenter-only. Microsoft's fact sheet covers "global owned and leased real-estate facilities and datacenters." Google's report covers "data centers and offices." These are compared against a U.S.-only LBNL data-center total — the comparison is for scale, not geographic equivalence.</li>
          <li><strong>The electricity-water factor (1.19 gal/kWh) is LBNL's location-based average</strong>, which includes hydroelectric reservoir evaporation. Peer-reviewed literature (Bakken et al., Grubert) shows hydro water accounting is methodologically unsettled. A thermoelectric-only sensitivity case at 0.47 gal/kWh would reduce "+ electricity" figures by ~60%.</li>
          <li><strong>Crop rates use USDA applied irrigation</strong> (Table 39), not total crop water need or extension estimates. This is the water actually applied by irrigators, measured nationally. Regional rates vary significantly.</li>
          <li><strong>"Consumed" vs. "withdrawn" matters for industries.</strong> Paper/pulp withdraws ~1.5T gal but returns 88%. Steel withdraws ~660B but returns 90%. Data centers are unusual: most withdrawal IS consumption (evaporative cooling).</li>
          <li><strong>Year mixing is unavoidable.</strong> This visualization combines 2023 LBNL data, 2023 USDA irrigation data, 2024 corporate metrics, and 2025 AI usage proxies. Every figure is year-stamped in the labels.</li>
        </ul>
      </div>
    </details>
  </div>
</Base>

<style is:global>
  /* Break out of content width */
