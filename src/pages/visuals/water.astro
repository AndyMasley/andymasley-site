---
import Base from '@/layouts/Base.astro';

function fG(g: number) {
  return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr';
}

const dcItems = [
  { name: 'ChatGPT inference', base: 31e6, elec: 93e6, color: '#3ba0d8', on: false },
  { name: 'ChatGPT w/ training', base: 33e6, elec: 118e6, color: '#2a84b8', on: false },
  { name: 'Microsoft', base: 2.06e9, elec: 14e9, color: '#6a9dc8', on: true },
  { name: 'Google', base: 6e9, elec: 18.7e9, color: '#5088b8', on: true },
  { name: 'All US data centers', base: 17e9, elec: 105e9, color: '#7b72ab', on: true },
];

const industryItems = [
  { name: 'US semiconductor fabs', gal: 9e9, color: '#d4825e', on: false },
  { name: 'US auto manufacturing', gal: 12e9, color: '#c87450', on: false },
  { name: 'US oil refining', gal: 22e9, color: '#b86844', on: false },
  { name: 'US steel production', gal: 65e9, color: '#a85c3a', on: false },
  { name: 'US food & beverage', gal: 150e9, color: '#984e30', on: false },
  { name: 'US paper & pulp mills', gal: 175e9, color: '#884228', on: false },
];

let idx = 0;
const dcFlat = dcItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const indFlat = industryItems.map(d => ({ idx: idx++, ...d, sub: fG(d.gal) }));
---

<Base title="AI Water Usage" description="How much water does AI use?">
  <div class="w">
    <div class="w-intro">
      <h1>How thirsty is AI?</h1>
      <p class="w-deck">Consumptive water use in gallons per year</p>
      <p class="w-lede">Each square is sized proportionally to annual water consumption — water evaporated, incorporated into products, or otherwise not returned to source. Toggle items to compare.</p>
    </div>

    <div class="w-section-header">
      <h2>Total water</h2>
      <p class="w-section-desc">All water consumed — cooling towers, process water, and upstream electricity generation.</p>
    </div>

    <div class="w-viz">
      <div class="w-panel">
        <details class="w-cat" open>
          <summary class="w-cat-head">
            <div class="w-cat-pip" style="background:#5b8db8"></div>
            <span class="w-cat-name">Data centers</span>
            <span class="w-cat-arrow"></span>
          </summary>
          <div class="w-cat-list">
            {dcFlat.map(d => (
              <div class="w-dc-group">
                <div class="w-item" data-idx={d.idx} data-on={d.on ? '1' : '0'}
                  data-gal-base={d.base} data-gal-elec={d.elec} data-elec="0">
                  <div class="w-item-dot" style={`background:${d.color}`}></div>
                  <div class="w-item-text">
                    <span class="w-item-name">{d.name}</span>
                    <span class="w-item-val">{fG(d.base)}</span>
                  </div>
                </div>
                <div class="w-sub" data-parent-idx={d.idx}>
                  <span class="w-sub-check"></span>
                  <span class="w-sub-label">+ water cost of electricity</span>
                </div>
              </div>
            ))}
          </div>
        </details>

        <details class="w-cat">
          <summary class="w-cat-head">
            <div class="w-cat-pip" style="background:#d4825e"></div>
            <span class="w-cat-name">Other industries</span>
            <span class="w-cat-arrow"></span>
          </summary>
          <div class="w-cat-list">
            {indFlat.map(d => (
              <div class="w-item" data-idx={d.idx} data-on={d.on ? '1' : '0'} data-gal-industry={d.gal}>
                <div class="w-item-dot" style={`background:${d.color}`}></div>
                <div class="w-item-text">
                  <span class="w-item-name">{d.name}</span>
                  <span class="w-item-val">{d.sub}</span>
                </div>
              </div>
            ))}
          </div>
        </details>
      </div>

      <div class="w-right">
        <div class="w-chart" id="chart">
          <svg id="svg"></svg>
        </div>
      </div>
    </div>

    <div class="w-methodology">
      <h2>Methodology</h2>
      <p class="w-meth-intro">All figures represent <strong>consumptive</strong> water use — water evaporated, incorporated into products, or not returned to source. This is distinct from withdrawal, which includes water returned after use.</p>

      <details class="w-meth-section" open>
        <summary>Data center water — direct cooling</summary>
        <div class="w-meth-body">
          <p><strong>ChatGPT inference: 31 million gal/yr.</strong> Derived from Sam Altman's stated figures: 0.000085 gallons and 0.34 Wh per query, at ~1 billion queries/day.</p>
          <p class="w-meth-calc">0.000085 gal × 1,000,000,000 queries/day × 365 days = 31 million gal/yr</p>
          <p class="w-meth-caveat">Independent researchers estimate per-query water usage 3–6× higher than Altman's figure. ChatGPT query volume has grown to ~2.5B/day as of mid-2025. These numbers should be treated as lower bounds.</p>

          <p><strong>ChatGPT w/ training: 33M gal/yr.</strong> Training GPT-4 consumed ~1.85M gallons, amortized over one year.</p>
          <p class="w-meth-src">Source: <a href="https://www.datacenterdynamics.com/en/news/sam-altman-chatgpt-queries-consume-034-watt-hours-of-electricity-and-0000085-gallons-of-water/" target="_blank" rel="noopener">DCD — Altman's claims</a></p>

          <p><strong>Microsoft: 2.06B gal/yr.</strong> FY2023 report: 7.8M m³ × 264.172 gal/m³.</p>
          <p class="w-meth-src">Source: <a href="https://blogs.microsoft.com/on-the-issues/2024/05/15/microsoft-environmental-sustainability-report-2024/" target="_blank" rel="noopener">Microsoft 2024 Environmental Sustainability Report</a></p>

          <p><strong>Google: 6B gal/yr.</strong> 2024 environmental report: ~22.7B liters.</p>
          <p class="w-meth-src">Source: <a href="https://sustainability.google/reports/google-2024-environmental-report/" target="_blank" rel="noopener">Google 2024 Environmental Report</a></p>

          <p><strong>All US data centers: 17B gal/yr.</strong> LBNL 2024 estimate for on-site cooling.</p>
          <p class="w-meth-src">Source: <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy" target="_blank" rel="noopener">LBNL 2024 Report</a></p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Data center water — including electricity generation</summary>
        <div class="w-meth-body">
          <p><strong>Rate: 0.5 gal/kWh</strong> (NREL thermoelectric-only, excluding hydro reservoir evaporation).</p>
          <p class="w-meth-caveat">LBNL uses 1.2 gal/kWh including hydro evaporation. We exclude it because hydro evaporation occurs regardless of data center demand. At LBNL's rate, figures would be ~2.4× higher.</p>
          <table class="w-meth-table">
            <thead><tr><th></th><th>Electricity</th><th>× 0.5</th><th>+ Direct</th><th>= Total</th></tr></thead>
            <tbody>
              <tr><td>ChatGPT inference</td><td>124 GWh</td><td>62M</td><td>31M</td><td>93M gal/yr</td></tr>
              <tr><td>ChatGPT w/ training</td><td>~174 GWh</td><td>87M</td><td>33M</td><td>118M gal/yr</td></tr>
              <tr><td>Microsoft</td><td>~24 TWh</td><td>12B</td><td>2.06B</td><td>14B gal/yr</td></tr>
              <tr><td>Google</td><td>~25.3 TWh</td><td>12.65B</td><td>6B</td><td>18.7B gal/yr</td></tr>
              <tr><td>All US data centers</td><td>176 TWh</td><td>88B</td><td>17B</td><td>105B gal/yr</td></tr>
            </tbody>
          </table>
          <p class="w-meth-src">Sources: <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf" target="_blank" rel="noopener">NREL</a>, <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water" target="_blank" rel="noopener">Construction Physics</a></p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Other industries — consumptive use</summary>
        <div class="w-meth-body">
          <p>Industry figures are derived by multiplying total withdrawal by the sector's consumption ratio (the fraction of water evaporated or not returned). USGS does not publish consumption breakdowns by manufacturing subsector; these ratios come from USGS historical studies, DOE/Argonne research, and industry analyses.</p>
          <table class="w-meth-table">
            <thead><tr><th>Industry</th><th>Withdrawal</th><th>Consumption ratio</th><th>Consumed</th></tr></thead>
            <tbody>
              <tr><td>Semiconductor fabs</td><td>~29B gal/yr</td><td>~30%</td><td>9B gal/yr</td></tr>
              <tr><td>Auto manufacturing</td><td>~50B</td><td>~20%</td><td>12B</td></tr>
              <tr><td>Oil refining</td><td>~100B</td><td>~22%</td><td>22B</td></tr>
              <tr><td>Steel production</td><td>~660B</td><td>~10%</td><td>65B</td></tr>
              <tr><td>Food & beverage</td><td>~700B</td><td>~25%</td><td>150B</td></tr>
              <tr><td>Paper & pulp</td><td>~1,460B</td><td>~12%</td><td>175B</td></tr>
            </tbody>
          </table>
          <p class="w-meth-src">Sources: <a href="https://www.construction-physics.com/p/how-does-the-us-use-water" target="_blank" rel="noopener">Construction Physics</a>, <a href="https://greet.anl.gov/files/refineries-water-2016" target="_blank" rel="noopener">Argonne GREET</a>, <a href="https://pubs.usgs.gov/wsp/1330h/report.pdf" target="_blank" rel="noopener">USGS</a></p>
          <p class="w-meth-caveat">The food & beverage estimate has the widest uncertainty band (~100–275B). Semiconductor and auto figures are moderate confidence. Steel, oil, and paper/pulp ratios are better documented.</p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Key caveats</summary>
        <div class="w-meth-body">
          <ul>
            <li><strong>ChatGPT figures are lower bounds.</strong> Independent estimates suggest 3–6× higher per-query usage, and query volume has grown to ~2.5B/day.</li>
            <li><strong>The electricity-water rate matters enormously.</strong> At 0.5 gal/kWh (our rate), all US DC indirect water = ~88B gal. At LBNL's 1.2 gal/kWh, it's ~211B gal.</li>
            <li><strong>"Consumed" vs. "withdrawn" is the key distinction.</strong> Paper/pulp withdraws ~1.5 trillion gallons but returns 88%. Steel withdraws ~660B but returns 90%. Data centers are unusual in that most withdrawal IS consumption (evaporative cooling).</li>
            <li><strong>Microsoft and Google figures include all company operations</strong>, not data-center-only.</li>
          </ul>
        </div>
      </details>
    </div>

    <div class="w-divider"></div>

    <div class="w-section-header">
      <h2>Potable water</h2>
      <p class="w-section-desc">Freshwater withdrawn from municipal supply or aquifers — the water that competes directly with drinking water, agriculture, and ecosystems.</p>
    </div>

    <div class="w-potable-placeholder">
      <p>Coming soon — potable water data with the same interactive comparison interface.</p>
    </div>
  </div>

<style is:global>
  .main-content:has(.w) { max-width: 1200px; }
  .w { max-width: 1200px; margin: 0 auto; }
  .w-intro { max-width: 640px; margin-bottom: 2.5rem; }
  .w-intro h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.35rem; }
  .w-deck { color: var(--accent); font-size: 1rem; font-weight: 480; margin-bottom: 0.65rem; }
  .w-lede { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.65; }
  .w-viz { display: flex; gap: 2.5rem; align-items: flex-start; margin-bottom: 3rem; }

  .w-panel { width: 280px; flex-shrink: 0; }
  .w-cat { margin-bottom: 1.5rem; }
  .w-cat:last-child { margin-bottom: 0; }
  .w-cat-head {
    display: flex; align-items: center; gap: 0.5rem;
    padding-bottom: 0.4rem; margin-bottom: 0.25rem;
    border-bottom: 1.5px solid var(--border);
    cursor: pointer; list-style: none; user-select: none;
  }
  .w-cat-head::-webkit-details-marker { display: none; }
  .w-cat-head:hover { opacity: 0.75; }
  .w-cat-pip { width: 10px; height: 10px; border-radius: 2.5px; flex-shrink: 0; }
  .w-cat-name { font-size: 0.68rem; font-weight: 660; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-secondary); flex: 1; }
  .w-cat-arrow { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid var(--dim); flex-shrink: 0; transition: transform 0.2s ease; opacity: 0.5; }
  .w-cat:not([open]) .w-cat-arrow { transform: rotate(-90deg); }
  .w-cat-list { padding-top: 0.15rem; }

  .w-item { display: flex; align-items: center; gap: 0.65rem; padding: 0.4rem 0.55rem; margin: 0 -0.55rem; border-radius: 6px; cursor: pointer; user-select: none; transition: background 0.1s ease; }
  .w-item:hover { background: var(--bg-subtle); }
  .w-item:active { background: var(--accent-subtle); transition: none; }
  .w-item-dot { width: 10px; height: 10px; border-radius: 2.5px; flex-shrink: 0; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease; }
  .w-item[data-on="1"] .w-item-dot { opacity: 1; transform: scale(1); }
  .w-item[data-on="0"] .w-item-dot { opacity: 0.12; transform: scale(0.5); }
  .w-item-text { flex: 1; min-width: 0; transition: opacity 0.15s ease; }
  .w-item[data-on="0"] .w-item-text { opacity: 0.25; }
  .w-item-name { display: block; font-size: 0.82rem; font-weight: 490; color: var(--text); line-height: 1.35; }
  .w-item-val { display: block; font-size: 0.64rem; color: var(--dim); line-height: 1.3; font-variant-numeric: tabular-nums; margin-top: 0.05rem; }

  .w-dc-group { position: relative; }
  .w-sub { display: flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0.55rem 0.35rem 2.15rem; margin: -0.1rem -0.55rem 0; border-radius: 5px; cursor: pointer; user-select: none; transition: background 0.1s ease; }
  .w-sub:hover { background: var(--bg-subtle); }
  .w-sub-check { width: 11px; height: 11px; border-radius: 2.5px; border: 1.5px solid var(--border-strong); flex-shrink: 0; position: relative; transition: border-color 0.15s, background 0.15s; }
  .w-sub[data-checked="1"] .w-sub-check { border-color: var(--accent); background: var(--accent); }
  .w-sub[data-checked="1"] .w-sub-check::after { content: ''; position: absolute; top: 1px; left: 3px; width: 3px; height: 5.5px; border: solid white; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }
  .w-sub-label { font-size: 0.62rem; color: var(--dim); line-height: 1; }
  .w-sub[data-checked="1"] .w-sub-label { color: var(--accent); }
  .w-item[data-on="0"] ~ .w-sub { opacity: 0.25; pointer-events: none; }

  .w-right { flex: 1; min-width: 0; }
  .w-chart { min-width: 0; min-height: 400px; aspect-ratio: 1.3 / 1; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; position: relative; }
  #svg { width: 100%; height: 100%; display: block; }

  /* Section headers */
  .w-section-header { margin-bottom: 1.5rem; }
  .w-section-header h2 { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.25rem; color: var(--text); }
  .w-section-desc { font-size: 0.82rem; color: var(--dim); line-height: 1.6; max-width: 640px; }
  .w-divider { height: 1px; background: var(--border); margin: 3rem 0; }
  .w-potable-placeholder { padding: 2.5rem 2rem; background: var(--bg-subtle); border: 1px dashed var(--border); border-radius: 8px; margin-bottom: 3rem; }
  .w-potable-placeholder p { font-size: 0.88rem; color: var(--dim); font-style: italic; margin: 0; }

  /* Methodology */
  .w-methodology { max-width: 760px; padding-bottom: 3rem; }
  .w-methodology h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.02em; }
  .w-meth-intro { font-size: 0.82rem; color: var(--dim); line-height: 1.6; margin-bottom: 1.5rem; }
  .w-meth-section { border-bottom: 1px solid var(--border); }
  .w-meth-section:last-child { border-bottom: none; }
  .w-meth-section summary { font-size: 0.88rem; font-weight: 600; color: var(--text); cursor: pointer; list-style: none; padding: 0.75rem 0; display: flex; align-items: center; gap: 8px; user-select: none; }
  .w-meth-section summary::-webkit-details-marker { display: none; }
  .w-meth-section summary::before { content: '▸'; font-size: 0.65rem; color: var(--dim); transition: transform 0.15s; }
  .w-meth-section[open] summary::before { transform: rotate(90deg); }
  .w-meth-section summary:hover { color: var(--accent); }
  .w-meth-body { padding: 0 0 1.25rem 20px; }
  .w-meth-body p { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .w-meth-body strong { color: var(--text); }
  .w-meth-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .w-meth-body ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .w-meth-body li { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .w-meth-body li strong { color: var(--text); }
  .w-meth-src { font-size: 0.68rem; color: var(--dim); margin-top: 0.15rem; margin-bottom: 0.75rem; }
  .w-meth-src a { font-size: inherit; }
  .w-meth-calc { font-family: var(--font-mono, monospace); font-size: 0.72rem; background: var(--bg-subtle); padding: 8px 12px; border-radius: 4px; margin: 0.35rem 0 0.5rem; color: var(--text); line-height: 1.5; }
  .w-meth-caveat { font-size: 0.72rem; color: var(--dim); font-style: italic; border-left: 2px solid var(--border); padding-left: 10px; margin: 0.35rem 0 0.75rem; line-height: 1.55; }
  .w-meth-caveat a { color: var(--accent); }
  .w-meth-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 0.75rem; font-size: 0.72rem; line-height: 1.4; }
  .w-meth-table th { text-align: left; font-weight: 600; color: var(--text); padding: 4px 8px; border-bottom: 2px solid var(--border); font-size: 0.68rem; }
  .w-meth-table td { padding: 3px 8px; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-variant-numeric: tabular-nums; }

  @media (max-width: 850px) {
    .w-viz { flex-direction: column; }
    .w-panel { width: 100%; }
    .w-chart { aspect-ratio: 1; }
  }
</style>

<script is:inline>
(function() {
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }

  const chart = document.getElementById('chart');
  const svg = document.getElementById('svg');
  const cur = new Map();
  const tgt = new Map();
  let raf = null;

  const items = [];

  // Init all items from DOM
  document.querySelectorAll('.w-item').forEach(row => {
    const idx = parseInt(row.dataset.idx);
    const dot = row.querySelector('.w-item-dot');
    const baseName = row.querySelector('.w-item-name').textContent;
    const galBase = parseFloat(row.dataset.galBase || 0);
    const galElec = parseFloat(row.dataset.galElec || 0);
    const galIndustry = parseFloat(row.dataset.galIndustry || 0);

    const gallons = galIndustry > 0 ? galIndustry : galBase;

    items[idx] = {
      idx, gallons, on: row.dataset.on === '1',
      color: dot.style.backgroundColor,
      name: baseName,
      sub: row.querySelector('.w-item-val').textContent,
      baseName, elecOn: false, galBase, galElec
    };

    row.addEventListener('click', () => {
      items[idx].on = !items[idx].on;
      row.dataset.on = items[idx].on ? '1' : '0';
      render();
    });
  });

  // Electricity sub-checkboxes
  document.querySelectorAll('.w-sub').forEach(sub => {
    sub.dataset.checked = '0';
    const parentIdx = parseInt(sub.dataset.parentIdx);
    const parentRow = document.querySelector(`.w-item[data-idx="${parentIdx}"]`);

    sub.addEventListener('click', (e) => {
      e.stopPropagation();
      const nowChecked = sub.dataset.checked !== '1';
      sub.dataset.checked = nowChecked ? '1' : '0';
      parentRow.dataset.elec = nowChecked ? '1' : '0';

      const it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.sub = fG(it.gallons);
      const valEl = parentRow.querySelector('.w-item-val');
      if (valEl) valEl.textContent = it.sub;
      render();
    });
  });

  // ── Animation ──────────────────────────────────

  function render() {
    const W = chart.clientWidth, H = chart.clientHeight;
    const pad = 24;
    const maxSide = Math.min(H - pad * 2, W - 200 - pad);
    const active = items.filter(d => d && d.on);
    const maxG = active.reduce((m, d) => Math.max(m, d.gallons), 0);

    tgt.clear();
    if (maxG > 0) active.forEach(d => tgt.set(d.idx, Math.max(2, maxSide * Math.sqrt(d.gallons / maxG))));
    cur.forEach((_, k) => { if (!tgt.has(k)) tgt.set(k, 0); });
    tgt.forEach((_, k) => { if (!cur.has(k)) cur.set(k, 0); });
    if (!raf) raf = requestAnimationFrame(step);
  }

  function step() {
    const W = chart.clientWidth, H = chart.clientHeight, pad = 24;
    let moving = false;
    tgt.forEach((t, k) => {
      const c = cur.get(k) ?? 0, d = t - c;
      if (Math.abs(d) < 0.4) { cur.set(k, t); if (t === 0) cur.delete(k); }
      else { cur.set(k, c + d * 0.14); moving = true; }
    });
    draw(W, H, pad);
    raf = moving ? requestAnimationFrame(step) : null;
  }

  function draw(W, H, pad) {
    const vis = [];
    cur.forEach((s, i) => { if (s > 0.5) vis.push({ idx: i, s }); });
    vis.sort((a, b) => b.s - a.s);

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    if (!vis.length) { svg.innerHTML = `<text x="${W/2}" y="${H/2}" text-anchor="middle" font-family="var(--font-body)" font-size="13" fill="var(--dim)">Select items to compare</text>`; return; }

    const ox = pad, oy = H - pad, p = [];

    vis.forEach(v => {
      const it = items[v.idx], x = ox, y = oy - v.s;
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="${it.color}" fill-opacity=".12"/>`);
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="none" stroke="${it.color}" stroke-width="1.5" stroke-opacity=".55"/>`);
    });

    const bigSide = vis[0]?.s ?? 0, lx = ox + bigSide + 24, labelH = 30;
    const labs = vis.map(v => ({ idx: v.idx, ny: oy - v.s, s: v.s })).sort((a, b) => a.ny - b.ny);
    let cursor = -Infinity;
    const positions = labs.map(l => { const y = Math.max(l.ny, cursor); cursor = y + labelH; return { ...l, y }; });

    const lastBot = positions.length > 0 ? positions[positions.length - 1].y + labelH : 0;
    const topY = positions.length > 0 ? positions[0].ny : pad;
    if (lastBot > H - pad && positions.length > 1) {
      const gap = Math.max(16, ((H - pad) - Math.max(pad, topY)) / positions.length);
      let y = Math.max(pad, topY);
      positions.forEach(p => { p.y = y; y += gap; });
    }

    positions.forEach(r => {
      const it = items[r.idx], ax = ox + r.s, ay = r.ny + 1, ty = r.y + 5;
      if (ty + 14 > H - 4 || ty < 2) return;
      p.push(`<line x1="${ax}" y1="${ay}" x2="${lx-7}" y2="${ty+2}" stroke="${it.color}" stroke-width=".7" opacity=".2"/>`);
      p.push(`<circle cx="${ax}" cy="${ay}" r="2" fill="${it.color}" opacity=".35"/>`);
    });

    positions.forEach(r => {
      const it = items[r.idx], ty = r.y + 5;
      if (ty + 14 > H - 4 || ty < 2) return;
      p.push(`<rect x="${lx-4}" y="${ty-12}" width="${W-lx+4}" height="${labelH}" rx="3" fill="var(--bg-subtle)" fill-opacity=".9"/>`);
      p.push(`<text x="${lx}" y="${ty}" font-family="var(--font-body)" font-size="12" font-weight="550" fill="var(--text)">${it.name}</text>`);
      p.push(`<text x="${lx}" y="${ty+14}" font-family="var(--font-body)" font-size="9.5" fill="var(--dim)">${it.sub}</text>`);
    });

    svg.innerHTML = p.join('\n');
  }

  render();

  let rt;
  new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { cur.clear(); render(); }, 60); }).observe(chart);
})();
</script>
</Base>
