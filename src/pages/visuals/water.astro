---
import Base from '@/layouts/Base.astro';

function fG(g: number) {
  return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr';
}

// ChatGPT: ~3.25B messages/day (scaled from OpenAI July 2025 → Feb 2026 WAU growth).
// Direct on-site: 0.31 mL/msg → ~97M gal/yr. With elec (thermoelectric-only 1.8 L/kWh): ~290M gal/yr total.
// tGal = public-supply potable gallons. null = cross out in potable mode.
// tElec = potable with electricity. null = cross out.
// DC direct cooling: mostly municipal but shifting; tGal shown as upper bound.
// DC electricity: power plants use untreated river water, so tElec = null (cross out).
// Microsoft/Google: global ops, no +elec (US factor on global electricity not defensible).
const dcItems = [
  { name: 'ChatGPT (current est.)', base: 97e6, elec: 290e6, tGal: 97e6, tElec: null, color: '#3ba0d8', on: false },
  { name: 'All US AI workloads (2024)', base: 4e9, elec: 23e9, tGal: 4e9, tElec: null, color: '#4a69aa', on: false },
  { name: 'Microsoft operations (FY24)', base: 1.53e9, elec: 15.5e9, tGal: 1.53e9, tElec: null, color: '#6a9dc8', on: true },   // 5,807 ML = 1.53B gal; ~29.8 TWh global × 0.47 = 14.0B; predominantly municipal
  { name: 'Google operations (2024)', base: 7.03e9, elec: 21.5e9, tGal: 7.03e9, tElec: null, color: '#5088b8', on: true },     // ~30.8 TWh DC electricity × 0.47 = 14.5B; predominantly municipal
  { name: 'All US data centers (2023)', base: 17.4e9, elec: 100e9, tGal: 17.4e9, tElec: null, color: '#7b72ab', on: true },
  { name: 'ChatGPT (2030 est.)', base: 250e6, elec: 830e6, tGal: 250e6, tElec: null, color: '#e8a44a', on: false },          // ~1.24 TWh × 0.47 = 583M
  { name: 'US AI workloads (2030 est.)', base: 45e9, elec: 180e9, tGal: 45e9, tElec: null, color: '#d4893a', on: false },     // ~288 TWh × 0.47 = 135B
  { name: 'All US data centers (2030 est.)', base: 80e9, elec: 315e9, tGal: 80e9, tElec: null, color: '#c07030', on: false }, // ~500 TWh × 0.47 = 235B
];

// Industries: mixed water sources. tGal = fraction from public-supply potable.
// Elec: EIA MECS 2018 net electricity × 0.47 gal/kWh thermoelectric water factor.
// Semis: predominantly municipal but exact % unknown. Food: potable-quality required but not necessarily municipal.
// Oil/paper: almost entirely self-supplied from rivers. Auto/steel: removed (unreliable data).
const industryItems = [
  { name: 'US semiconductor fabs', base: 9e9, elec: 14.6e9, tGal: 9e9, tElec: null, color: '#d4825e', on: false },     // 12 TWh × 0.47 = 5.6B
  { name: 'US oil refining', base: 22e9, elec: 44.8e9, tGal: null, tElec: null, color: '#b86844', on: false },          // 48.5 TWh × 0.47 = 22.8B
  { name: 'US food & beverage', base: 150e9, elec: 200e9, tGal: 150e9, tElec: null, color: '#984e30', on: false },      // 106 TWh × 0.47 = 49.9B; potable share uncertain but shown (food processing requires potable-quality water)
  { name: 'US paper & pulp mills', base: 175e9, elec: 199e9, tGal: null, tElec: null, color: '#884228', on: false },    // 51 TWh net grid × 0.47 = 24B
  { name: 'US meat & poultry processing', base: 179e9, elec: 193.9e9, tGal: 108e9, tElec: null, color: '#c45a3e', on: false },  // EPA 2023 TDD; 31.7 TWh (MECS 3116) × 0.47 = 14.9B; 60% public-supply
  { name: 'US pharmaceutical manufacturing', base: 97.2e9, elec: 102.1e9, tGal: 82.7e9, tElec: null, color: '#a84878', on: false },  // EPA 1998 pharma TDD; 10.4 TWh (MECS 3254) × 0.47 = 4.9B; 85% public-supply
  { name: 'US dairy processing', base: 45e9, elec: 50.4e9, tGal: 31.5e9, tElec: null, color: '#d4a05e', on: false },  // USDA milk × EPA; 11.5 TWh (MECS 3115) × 0.47 = 5.4B; 70% public-supply
  { name: 'US industrial launderers', base: 35e9, elec: 36.2e9, tGal: 33.2e9, tElec: null, color: '#6a8eab', on: false },  // EPA CI water; ~2.5 TWh est × 0.47 = 1.2B
  { name: 'US breweries (modeled)', base: 32e9, elec: 33.6e9, tGal: 24e9, tElec: null, color: '#c49a3e', on: false },  // 5.4B gal beer × 6; ~3.4 TWh est × 0.47 = 1.6B; 75% public-supply
  { name: 'US bottled water mfg (total only)', base: 22.8e9, elec: 23.5e9, tGal: 22.8e9, tElec: null, color: '#5eaab8', on: false },  // 16.4B gal × 1.39; ~1.5 TWh est × 0.47 = 0.7B; all potable-quality water
];

// Agriculture — estimated CONSUMPTIVE use (evapotranspiration from irrigation water)
// Applied irrigation from USDA 2023 IWMS Table 39 × consumptive use ratio:
//   Corn: 1.0 ac-ft/ac applied × 0.75 CU ratio = 0.75 ac-ft/ac consumed. Center-pivot dominant (70-85% efficiency).
//   Alfalfa: 2.3 ac-ft/ac applied × 0.70 CU ratio = 1.6 ac-ft/ac consumed. Flood-irrigated dominant (60-75% efficiency).
// Acreage from USDA 2023 IWMS Table 38.
// Elec: irrigation pumping electricity (~22 TWh US total, proportioned by irrigated acreage share) × 0.47 gal/kWh.
// Agriculture: untreated irrigation water from wells/rivers. tGal = null (cross out).
const farmItems = [
  { name: 'All US corn (2023)', base: 2.84e12, elec: 2.842e12, tGal: null, tElec: null, color: '#6aaa58', on: true },     // 0.75 ac-ft/ac × 11.64M ac; 4.4 TWh × 0.47 = 2.1B
  { name: 'Nebraska corn', base: 1.09e12, elec: null, tGal: null, tElec: null, color: '#82c06e', on: false },              // 38.3% of national
  { name: 'Kansas corn', base: 280e9, elec: null, tGal: null, tElec: null, color: '#82c06e', on: false },                  // 9.9%
  { name: 'Arkansas corn', base: 174e9, elec: null, tGal: null, tElec: null, color: '#82c06e', on: false },                // 6.1%
  { name: 'Texas corn', base: 138e9, elec: null, tGal: null, tElec: null, color: '#82c06e', on: false },                   // 4.9%
  { name: 'All US alfalfa (2023)', base: 2.84e12, elec: 2.841e12, tGal: null, tElec: null, color: '#4a8840', on: false },  // 1.6 ac-ft/ac × 5.41M ac; 2.0 TWh × 0.47 = 940M
  { name: 'Idaho alfalfa', base: 440e9, elec: null, tGal: null, tElec: null, color: '#5e9c50', on: false },                // 15.5%
  { name: 'California alfalfa', base: 323e9, elec: null, tGal: null, tElec: null, color: '#5e9c50', on: false },            // 11.4%
  { name: 'Montana alfalfa', base: 293e9, elec: null, tGal: null, tElec: null, color: '#5e9c50', on: false },               // 10.3%
  { name: 'Colorado alfalfa', base: 280e9, elec: null, tGal: null, tElec: null, color: '#5e9c50', on: false },              // 9.9%
];

// Lawns: EPA landscape irrigation ~9B gal/day = ~3.3T/yr total.
// Municipal lawn: 13.1T × 0.60 × 0.30 × 0.70 = 1.65T from public supply.
// State figures are modeled proportional estimates.
// Elec: lawn ~5 TWh (pump energy), golf ~1.4 TWh (GCSAA), × 0.47 gal/kWh.
// Golf: GCSAA Phase 4 (2024), total 1.63M acre-feet = 531B gal. ~9% municipal (not 15%).
// Arizona golf: SW regional rate 3.3 ac-ft/ac, midpoint estimate 14.4B.
const turfItems = [
  { name: 'All US lawn irrigation (est.)', base: 3e12, elec: 3.002e12, tGal: 1.65e12, tElec: null, color: '#27ae60', on: false },  // ~5 TWh × 0.47 = 2.4B
  { name: 'Florida lawns', base: 350e9, elec: null, tGal: 175e9, tElec: null, color: '#2ecc71', on: false },
  { name: 'California lawns', base: 400e9, elec: null, tGal: 240e9, tElec: null, color: '#2ecc71', on: false },
  { name: 'Texas lawns', base: 320e9, elec: null, tGal: 176e9, tElec: null, color: '#2ecc71', on: false },
  { name: 'All US golf courses (2024)', base: 531e9, elec: 531.7e9, tGal: 48e9, tElec: null, color: '#1abc9c', on: false },     // ~1.4 TWh × 0.47 = 660M
  { name: 'Arizona golf courses', base: 14.4e9, elec: null, tGal: 1e9, tElec: null, color: '#1abc9c', on: false },
];

// City water systems — base = estimated CONSUMPTIVE use (evaporated/not returned).
// Cool/wet cities return ~88% via sewer; hot/dry cities consume 35-50% (landscape evapotranspiration).
// Elec: pumping/treatment electricity × 0.47 gal/kWh thermoelectric water factor.
// Cities: 100% treated municipal water. tGal = same as base.
const cityItems = [
  { name: 'New York City (consumptive est.)', base: 45e9, elec: 45.3e9, tGal: 45e9, tElec: null, color: '#3498db', on: false },                  // ~12% of 364B delivered; 0.55 TWh × 0.47 = 257M
  { name: 'Chicago metro (consumptive est.)', base: 33e9, elec: 33.2e9, tGal: 33e9, tElec: null, color: '#2e86c1', on: false },                   // ~12% of 274B delivered; 0.41 TWh × 0.47 = 193M
  { name: 'Los Angeles (consumptive est.)', base: 51e9, elec: 51.3e9, tGal: 51e9, tElec: null, color: '#2471a3', on: false },                     // ~35% of 146B delivered; 0.73 TWh × 0.47 = 343M
  { name: 'Phoenix (consumptive est.)', base: 48e9, elec: 48.2e9, tGal: 48e9, tElec: null, color: '#1a5276', on: false },                         // ~50% of 95.5B delivered; 0.48 TWh × 0.47 = 224M
  { name: 'Las Vegas metro (SNWA, consumptive)', base: 69e9, elec: 69.2e9, tGal: 69e9, tElec: null, color: '#154360', on: false },                 // SNWA reported net of return-flow credits; 0.39 TWh × 0.47 = 181M
];

// National: consumptive use estimates derived from USGS 1995 sector-level fractions applied to 2015 withdrawals.
// Public water supply IS treated water.
// Elec: freshwater withdrawals ~70 TWh pumping, public supply ~39 TWh (EPRI), × 0.47 gal/kWh.
const nationalItems = [
  { name: 'Total US freshwater (consumptive est.)', base: 30e12, elec: 30e12 + 33e9, tGal: null, tElec: null, color: '#1a3c5e', on: false },  // 102.6T withdrawals × ~30% consumptive (USGS 1995 sector fractions applied to 2015 data); ~70 TWh × 0.47 = 33B
  { name: 'Total US public water supply (consumptive est.)', base: 2.6e12, elec: 2.6e12 + 18.3e9, tGal: 2.6e12, tElec: null, color: '#2a5f8f', on: false },  // 13.1T withdrawals × ~20% consumptive fraction (USGS 1995 methodology); ~39 TWh × 0.47 = 18.3B
];

let idx = 0;
const dcFlat = dcItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const indFlat = industryItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const cityFlat = cityItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const natFlat = nationalItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const farmFlat = farmItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
const turfFlat = turfItems.map(d => ({ idx: idx++, ...d, sub: fG(d.base) }));
---

<Base title="How thirsty is AI?" description="How much water does AI use?" ogTitle="How thirsty is AI?" ogImage="/images/og-water.png">

  <header class="wv-header">
    <h1>How thirsty is AI?</h1>
    <div class="wv-intro-cols">
      <div class="wv-intro-col">
        <p>Select items on the left to compare how much water data centers use relative to farms, cities, industries, and more. Toggle between <strong>squares</strong> (proportional area) and <strong>bars</strong>. All figures show water <strong>consumed</strong> &mdash; evaporated, incorporated into products, or not returned to source. City and farm numbers are also consumptive: e.g., NYC delivers 364B gal/yr but only ~45B is consumed (the rest returns via sewers), and 25&ndash;30% of irrigation water percolates back into aquifers. This is also why lawns loom so large in the graphic: most municipal water gets returned to its source through sewers, but water sprayed on lawns evaporates or soaks into the ground, so lawn irrigation&rsquo;s consumptive footprint dwarfs most other household uses.</p>
      </div>
      <div class="wv-intro-col">
        <p>Use <em>All source water / Public-supply potable</em> to filter by water type &mdash; data centers mostly draw potable municipal water, while farms and power plants use untreated water. The <em>+ elec</em> buttons on data center items add upstream water consumed at power plants generating their electricity &mdash; this upstream water is non-potable.</p>
      </div>
      <div class="wv-intro-col">
        <p>Data center water use is <strong>growing rapidly</strong> &mdash; the data centers category includes both current figures and 2030 projections. All values explained in the <a href="#methodology">methodology</a>. Some of these might be off by orders of magnitude &mdash; if you think I'm getting something wrong, <a href="mailto:AndyMasley@gmail.com">email me</a>. See <a href="/writing/">my blog</a> for more of my work on AI and the environment.</p>
      </div>
    </div>
  </header>

  <article class="wv2" id="wv2">
    <div class="wv-layout">
      <!-- Toggle panel (left) -->
      <div class="wv-toggles" id="wv-toggles">
        <button class="wv-panel-collapse" id="wv-panel-collapse">
          <span class="wv-panel-collapse-text">Items</span>
          <span class="wv-panel-collapse-arrow">&#9662;</span>
        </button>
        <div class="wv-toggles-scroll">
          <div class="wv-panel-title">ITEMS</div>
          <div class="wv-bulk-actions">
            <button class="wv-bulk-btn" id="wv-clear-all">Clear all</button>
            <button class="wv-bulk-btn" id="wv-add-all">Add all</button>
          </div>
          <div class="wv-presets">
            <span class="wv-presets-label">Compare:</span>
            <button class="wv-preset-btn" data-preset="ai-vs-farms">AI vs farms</button>
            <button class="wv-preset-btn" data-preset="ai-vs-cities">AI vs cities</button>
            <button class="wv-preset-btn" data-preset="big-picture">Big picture</button>
          </div>

          <!-- Data centers -->
          <div class="wv-cat" data-cat="dc">
            <button class="wv-cat-head" data-open="true">
              <span class="wv-cat-chevron">&#9662;</span>

              <span class="wv-cat-title">🖥️ Data centers</span>
              <span class="wv-cat-count">{dcFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="true">
              {dcFlat.map((d, i) => (
                <div class="wv-dc-group">
                  {i === 5 && <div class="wv-proj-divider">2030 estimates</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                    data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                    data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                    data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{fG(d.base)}</span>
                      {d.elec !== null && <span class="wv-elec-chip" data-parent-idx={d.idx} title="Include water consumed to generate electricity powering this operation (0.47 gal/kWh thermoelectric, excluding hydro reservoir evaporation)">+ elec</span>}
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Other industries -->
          <div class="wv-cat" data-cat="industry">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>

              <span class="wv-cat-title">🏭 Other industries</span>
              <span class="wv-cat-count">{indFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {indFlat.map((d, i) => (
                <div>
                  {i === 4 && <div class="wv-proj-divider">Treated-water-heavy</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                    data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                    data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                    data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{d.sub}</span>
                      {d.elec !== null && <span class="wv-elec-chip" data-parent-idx={d.idx} title="Include water consumed to generate electricity powering this operation (0.47 gal/kWh thermoelectric)">+ elec</span>}
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- City water systems -->
          <div class="wv-cat" data-cat="city">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>

              <span class="wv-cat-title">🏙️ City water systems</span>
              <span class="wv-cat-count">{cityFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {cityFlat.map(d => (
                <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                  data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                  data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                  data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                  <span class="wv-dot"></span>
                  <span class="wv-row-text">
                    <span class="wv-row-name">{d.name}</span>
                    <span class="wv-row-val">{d.sub}</span>
                    {d.elec !== null && <span class="wv-elec-chip" data-parent-idx={d.idx} title="Include water consumed to generate electricity for pumping and treatment (0.47 gal/kWh thermoelectric)">+ elec</span>}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Irrigated farmland -->
          <div class="wv-cat" data-cat="farm">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>

              <span class="wv-cat-title">🌾 Irrigated farmland</span>
              <span class="wv-cat-count">{farmFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {farmFlat.map((d, i) => (
                <div>
                  {i === 1 && <div class="wv-proj-divider">Corn by state</div>}
                  {i === 5 && <div class="wv-proj-divider">Alfalfa (US & states)</div>}
                  {i === 6 && <div class="wv-proj-divider">Alfalfa by state</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                    data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                    data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                    data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{d.sub}</span>
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Lawns & turf -->
          <div class="wv-cat" data-cat="turf">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>

              <span class="wv-cat-title">⛳ Lawns & turf</span>
              <span class="wv-cat-count">{turfFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {turfFlat.map((d, i) => (
                <div>
                  {i === 1 && <div class="wv-proj-divider">Lawns by state</div>}
                  {i === 4 && <div class="wv-proj-divider">Golf courses</div>}
                  <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                    data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                    data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                    data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                    <span class="wv-dot"></span>
                    <span class="wv-row-text">
                      <span class="wv-row-name">{d.name}</span>
                      <span class="wv-row-val">{d.sub}</span>
                    </span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- National totals -->
          <div class="wv-cat" data-cat="national">
            <button class="wv-cat-head" data-open="false">
              <span class="wv-cat-chevron">&#9656;</span>

              <span class="wv-cat-title">🇺🇸 National totals</span>
              <span class="wv-cat-count">{natFlat.length}</span>
              <span class="wv-cat-active"></span>
              <span class="wv-cat-controls"><span class="wv-cat-toggle" data-action="all">all</span> / <span class="wv-cat-toggle" data-action="none">none</span></span>
            </button>
            <div class="wv-cat-list" data-visible="false">
              {natFlat.map(d => (
                <button class="wv-toggle-row" data-idx={d.idx} data-on={d.on ? 'true' : 'false'}
                  data-gal-base={d.base} data-gal-elec={d.elec} data-elec="false"
                  data-tgal={d.tGal !== null && d.tGal !== undefined ? d.tGal : 'null'}
                  data-telec={d.tElec !== null && d.tElec !== undefined ? d.tElec : 'null'}>
                  <span class="wv-dot"></span>
                  <span class="wv-row-text">
