    overflow: hidden;
  }
  .wv-chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 2px solid var(--divider);
  }
  .wv-header-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .wv-chart-count {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .wv-view-toggle {
    display: flex;
    gap: 2px;
    background: var(--panel);
    border-radius: 6px;
    padding: 2px;
  }
  .wv-view-btn {
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 500;
    padding: 4px 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    background: transparent;
    color: var(--text-secondary);
    transition: all 0.12s;
  }
  .wv-view-btn[data-active="true"] {
    background: var(--bg-elevated, #fff);
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }
  [data-theme="dark"] .wv-view-btn[data-active="true"] {
    background: var(--bg-elevated, #1c1c1a);
  }
  .wv-view-btn:hover:not([data-active="true"]) {
    color: var(--text);
  }
  .wv-bars-area {
    flex: 1;
    overflow-y: auto;
    padding: 12px 16px;
    -webkit-overflow-scrolling: touch;
    transition: opacity 0.15s ease;
  }
  .wv-bars-empty {
    color: var(--text-secondary);
    font-size: 0.85rem;
    padding: 3rem 0;
    text-align: center;
  }

  /* Individual bars */
  .wv-bar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    transition: opacity 0.2s;
  }
  .wv-bar-name {
    width: 240px;
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text);
    text-align: left;
    white-space: normal;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .wv-bar-track {
    flex: 1;
    height: 22px;
    background: var(--bar-track);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .wv-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s ease;
    min-width: 0;
  }
  .wv-bar-val {
    width: 110px;
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .wv-bar-pct {
    opacity: 0.4;
    font-size: 0.6rem;
  }

  /* Bar row hover (#12) */
  .wv-bar-row {
    border-radius: 4px;
    padding: 2px 4px;
    transition: background 0.12s, opacity 0.2s;
  }
  .wv-bar-row:hover {
    background: rgba(0,0,0,0.02);
  }
  [data-theme="dark"] .wv-bar-row:hover {
    background: rgba(255,255,255,0.03);
  }
  .wv-bar-row:hover .wv-bar-fill {
    filter: brightness(1.1);
  }

  /* Water toggle differentiation (#14) */
  .wv-water-btn {
    font-size: 0.8rem !important;
    padding: 6px 18px !important;
  }
  .wv-water-btn[data-active="true"] {
    color: var(--accent) !important;
    font-weight: 600;
  }

  /* Treated helper text (#16) */
  .wv-treated-helper {
    font-size: 0.65rem;
    font-style: italic;
    color: var(--text-secondary);
    padding: 0;
    line-height: 1.4;
  }

  /* Item indentation (#4) */
  .wv-sub-item {
    padding-left: 28px !important;
  }
  .wv-sub-item .wv-row-name {
    font-weight: 400;
    font-size: 0.73rem;
  }
  .wv-toggle-row.wv-all-item .wv-row-name {
    font-weight: 600;
  }

  /* Squares view */
  .wv-squares-area {
    flex: 1;
    overflow: hidden;
    padding: 16px;
    transition: opacity 0.15s ease;
  }
  .wv-sq-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                top 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                opacity 0.3s ease;
  }
  .wv-sq-box {
    border-radius: 0;
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                height 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .wv-sq-label {
    text-align: center;
    max-width: 200px;
  }
  .wv-sq-name {
    display: block;
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.2;
    white-space: normal;
    word-wrap: break-word;
  }
  .wv-sq-val {
    display: block;
    font-size: 0.58rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* Loading skeleton */
  @keyframes wv-skeleton {
    0% { background-position: -200px 0; }
    100% { background-position: 200px 0; }
  }
  .wv-bars-area:empty,
  .wv-squares-area:empty {
    background-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.03) 40%, rgba(0,0,0,0.05) 50%, rgba(0,0,0,0.03) 60%, transparent 100%);
    background-size: 400px 100%;
    animation: wv-skeleton 1.5s ease-in-out infinite;
  }

  /* Focus states */
  .wv2 *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* #23 Styled scrollbar */
  .wv-toggles-scroll::-webkit-scrollbar { width: 2px; }
  .wv-toggles-scroll::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.08); border-radius: 2px; }
  .wv-toggles-scroll::-webkit-scrollbar-track { background: transparent; }
  .wv-cat-list::-webkit-scrollbar { width: 2px; }
  .wv-cat-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.08); border-radius: 2px; }
  .wv-cat-list::-webkit-scrollbar-track { background: transparent; }

  /* #17 Bar area */
  .wv-bars-area {
    position: relative;
  }

  /* #3 Two-item ratio callout */
  .wv-ratio-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .wv-ratio-wrap.wv-ratio-visible {
    max-height: 40px;
  }
  .wv-ratio-callout {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-style: italic;
    padding: 2px 16px 4px;
  }

  /* Panel title */
  .wv-panel-title {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    opacity: 0.4;
    padding: 12px 16px 0;
  }

  /* Bulk action buttons */
  .wv-bulk-actions {
    display: flex;
    gap: 6px;
    padding: 4px 16px 8px;
  }
  .wv-bulk-btn {
    font-family: inherit;
    font-size: 0.65rem;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--divider);
    border-radius: 3px;
    cursor: pointer;
    padding: 3px 10px;
    transition: color 0.12s, border-color 0.12s;
  }
  .wv-bulk-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* #19 Mini-bars in panel — hidden for cleaner look */
  .wv-mini-bar {
    display: none !important;
  }

  /* #11 Hover-to-preview */
  .wv-bar-row.wv-preview-highlight .wv-bar-fill {
    outline: 2px solid rgba(74, 124, 89, 0.6);
    outline-offset: -2px;
    filter: brightness(1.15);
  }
  .wv-sq-item.wv-preview-highlight .wv-sq-box {
    outline: 2px solid rgba(74, 124, 89, 0.6);
    outline-offset: -2px;
    filter: brightness(1.15);
  }

  /* #21 Count pulse animation */
  .wv-count-pulse {
    transition: transform 0.15s ease;
    transform: scale(1.15);
    display: inline-block;
  }

  /* #16 Treated helper text transition */
  .wv-treated-helper {
    transition: opacity 0.2s ease !important;
  }

  /* #5 Projected items dashed border in squares */
  .wv-sq-item.wv-proj-item .wv-sq-box {
    border-style: dashed !important;
  }

  /* #1 Scale reference */
  .wv-scale-ref {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid var(--divider);
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--bg-elevated, #fff);
  }
  [data-theme="dark"] .wv-scale-ref {
    background: var(--bg-elevated, #1c1c1a);
  }
  .wv-scale-ref-box {
    border: 1.5px solid var(--text-secondary);
    opacity: 0.4;
    border-radius: 2px;
  }

  /* Methodology */
  .wv-tooltip {
    position: fixed;
    z-index: 9999;
    max-width: 360px;
    padding: 12px 14px;
    background: var(--bg, #FAF9F7);
    border: 1px solid var(--border, #e5e2df);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--text-secondary, #6B6B60);
    pointer-events: auto;
    overflow-y: auto;
    max-height: calc(100vh - 40px);
  }
  [data-theme="dark"] .wv-tooltip {
    background: var(--bg, #141413);
    border-color: var(--border, #2e2d2b);
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }
  .wv-tooltip strong { color: var(--text, #1A1A18); }
  [data-theme="dark"] .wv-tooltip strong { color: var(--text, #e8e6e1); }
  .wv-tooltip hr { border: none; border-top: 1px solid var(--border, #e5e2df); margin: 8px 0; }
  .wv-tooltip a { color: var(--accent, #8b3a3a); text-decoration: underline; text-underline-offset: 2px; pointer-events: auto; }

  .w-methodology { max-width: 760px; padding-bottom: 3rem; }
  .w-methodology h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.02em; }
  .w-meth-intro { font-size: 0.82rem; color: var(--dim); line-height: 1.6; margin-bottom: 1.5rem; }
  .w-meth-section { border-bottom: 1px solid var(--border); }
  .w-meth-section:last-child { border-bottom: none; }
  .w-meth-section summary { font-size: 0.88rem; font-weight: 600; color: var(--text); cursor: pointer; list-style: none; padding: 0.75rem 0; display: flex; align-items: center; gap: 8px; user-select: none; }
  .w-meth-section summary::-webkit-details-marker { display: none; }
  .w-meth-section summary::before { content: '\25B8'; font-size: 0.65rem; color: var(--dim); transition: transform 0.15s; }
  .w-meth-section[open] summary::before { transform: rotate(90deg); }
  .w-meth-section summary:hover { color: var(--accent); }
  .w-meth-body { padding: 0 0 1.25rem 20px; }
  .w-meth-body p { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .w-meth-body strong { color: var(--text); }
  .w-meth-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .w-meth-body ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .w-meth-body li { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .w-meth-body li strong { color: var(--text); }
  .w-meth-src { font-size: 0.68rem; color: var(--dim); margin-top: 0.15rem; margin-bottom: 0.75rem; }
  .w-meth-src a { font-size: inherit; }
  .w-meth-calc { font-family: var(--font-mono, monospace); font-size: 0.72rem; background: var(--bg-subtle); padding: 8px 12px; border-radius: 4px; margin: 0.35rem 0 0.5rem; color: var(--text); line-height: 1.5; }
  .w-meth-caveat { font-size: 0.72rem; color: var(--dim); font-style: italic; border-left: 2px solid var(--border); padding-left: 10px; margin: 0.35rem 0 0.75rem; line-height: 1.55; }
  .w-meth-caveat a { color: var(--accent); }
  .w-meth-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 0.75rem; font-size: 0.72rem; line-height: 1.4; }
  .w-meth-table th { text-align: left; font-weight: 600; color: var(--text); padding: 4px 8px; border-bottom: 2px solid var(--border); font-size: 0.68rem; }
  .w-meth-table td { padding: 3px 8px; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-variant-numeric: tabular-nums; }

  /* ── Responsive: tablet ── */
  @media (max-width: 850px) {
    .wv-layout {
      grid-template-columns: 1fr;
      height: auto;
      max-height: none;
      min-height: auto;
    }
    .wv-toggles {
      border-right: none;
      border-bottom: 1px solid var(--divider);
      max-height: 300px;
    }
    .wv-chart-panel {
      min-height: 420px;
      height: 60vh;
      max-height: 600px;
    }
    .wv-chart-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .wv-header-controls {
      width: 100%;
      flex-wrap: wrap;
      gap: 6px;
    }
    .wv-bar-name { width: 130px; font-size: 0.66rem; }
    .wv-bar-val { width: 75px; font-size: 0.6rem; }
  }

  /* ── Panel collapse button (mobile only) ── */
  .wv-panel-collapse { display: none; }

  /* ── Responsive: phone ── */
  @media (max-width: 560px) {
    .wv2 { width: calc(100vw - 16px); padding: 0 0 1.5rem; }
    .wv-header { width: calc(100vw - 16px); }

    .wv-layout { height: auto; max-height: none; }

    /* Panel collapse toggle — visible on mobile */
    .wv-panel-collapse {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; padding: 10px 12px;
      border: none; border-bottom: 1px solid var(--divider);
      background: var(--panel); cursor: pointer;
      font-family: inherit; font-size: 0.78rem; font-weight: 600; color: var(--text);
    }
    .wv-panel-collapse-arrow {
      font-size: 0.6rem; color: var(--text-secondary); transition: transform 0.2s;
    }
    .wv-toggles[data-collapsed="true"] .wv-panel-collapse-arrow { transform: rotate(-90deg); }
    .wv-toggles[data-collapsed="true"] .wv-toggles-scroll { display: none; }
    .wv-toggles[data-collapsed="true"] { max-height: none; border-bottom: 1px solid var(--divider); }

    /* Toggle panel: generous height, smooth scroll */
    .wv-toggles { max-height: 55vh; transition: max-height 0.2s; }
    .wv-cat-list[data-visible="true"] { max-height: 250px; }

    /* Chart: fill remaining viewport */
    .wv-chart-panel { min-height: 300px; height: 60vh; max-height: none; }
    .wv-squares-area { padding: 10px; }
    .wv-bars-area { padding: 8px 10px; }

    /* Chart header: stack everything vertically */
    .wv-chart-header {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 8px 10px;
    }
    .wv-header-left { flex-direction: row; justify-content: space-between; align-items: center; }
    .wv-header-controls {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px;
      width: 100%;
    }

    /* Segmented controls: full width water toggle, compact view toggle */
    .wv-water-toggle { flex: 1; }
    .wv-water-btn { flex: 1; text-align: center; font-size: 0.62rem !important; padding: 6px 8px 7px !important; }
    .wv-view-btn { font-size: 0.62rem; padding: 6px 10px 7px; }

    /* Bar chart: ultra compact */
    .wv-bar-row { gap: 6px; margin-bottom: 2px; }
    .wv-bar-name { width: 100px; font-size: 0.62rem; -webkit-line-clamp: 1; white-space: nowrap; }
    .wv-bar-track { height: 14px; }
    .wv-bar-val { width: auto; flex-shrink: 1; font-size: 0.58rem; min-width: 55px; }
    .wv-bar-pct { display: none; }

    /* Toggle rows: proper touch targets */
    .wv-toggle-row { padding: 8px 10px; min-height: 44px; }
    .wv-cat-head { padding: 11px 10px !important; font-size: 0.82rem !important; }
    .wv-dot { width: 12px; height: 12px; }

    /* Bulk actions & presets: more prominent on mobile */
    .wv-bulk-actions { padding: 6px 10px; }
    .wv-panel-title { padding: 10px 10px 2px; }
    .wv-presets { padding: 6px 10px 8px; gap: 6px; }
    .wv-presets-label { font-size: 0.62rem; }
    .wv-preset-btn { padding: 5px 10px; font-size: 0.62rem; border-radius: 4px; }

    /* Category headers: sticky still works */
    .wv-cat-count { font-size: 0.6rem; }
    .wv-cat-active { font-size: 0.58rem; }

    /* Tooltip: full width on mobile */
    .wv-tooltip { max-width: calc(100vw - 24px); left: 12px !important; right: 12px; font-size: 0.72rem; }

    /* Scale ref: bottom-right instead of top-left to not block content */
    .wv-scale-ref { top: auto !important; bottom: 4px; right: 4px; left: auto !important; }

    /* Methodology: tighter */
    .w-methodology { padding-bottom: 1.5rem; }
    .w-meth-section summary { font-size: 0.82rem; padding: 0.65rem 0; }
    .w-meth-body { padding-left: 10px; }
    .w-meth-body p { font-size: 0.74rem; }
    .w-meth-table { font-size: 0.65rem; }
    .w-meth-table th, .w-meth-table td { padding: 3px 5px; }
  }

  /* ── Responsive: very small phone ── */
  @media (max-width: 380px) {
    .wv2 { width: calc(100vw - 8px); }
    .wv-header { width: calc(100vw - 8px); }
    .wv-header h1 { font-size: 1.25rem; }
    .wv-intro-cols { padding: 0.6rem 0.75rem; gap: 0.5rem; font-size: 0.75rem; }
    .wv-bar-name { width: 80px; font-size: 0.58rem; }
    .wv-bar-val { font-size: 0.54rem; min-width: 45px; }
    .wv-toggle-row { padding: 7px 8px; min-height: 42px; }
    .wv-cat-head { font-size: 0.76rem !important; padding: 10px 8px !important; }
    .wv-chart-header { padding: 6px 8px; }
    .wv-bars-area { padding: 6px 8px; }
    .wv-squares-area { padding: 8px; }
    .wv-water-btn { font-size: 0.58rem !important; padding: 5px 6px 6px !important; }
    .wv-view-btn { font-size: 0.58rem; padding: 5px 8px 6px; }
    .wv-presets { padding: 5px 8px 6px; }
    .wv-preset-btn { font-size: 0.58rem; padding: 4px 8px; }
    .wv-panel-collapse { padding: 9px 10px; font-size: 0.74rem; }
  }

  /* ── Intro columns ── */
  .wv-header {
    width: calc(100vw - 48px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    max-width: 1500px;
    margin-bottom: 1.5rem;
  }
  .wv-header h1 { margin-bottom: 0.75rem; }
  .wv-intro-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2.5rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-secondary, #6B6B60);
    padding: 1rem 1.25rem;
    border: 1px solid var(--border, #DDD9D0);
    border-radius: 6px;
    background: #edecea;
  }
  [data-theme="dark"] .wv-intro-cols {
    background: #151413;
    border-color: var(--border, #3A3733);
  }
  .wv-intro-col p { margin: 0; }
  .wv-intro-col strong { color: var(--text, #1A1A18); }
  [data-theme="dark"] .wv-intro-col strong { color: var(--text, #F0EDE6); }
  .wv-intro-col a {
    color: var(--accent, #8b3a3a); text-decoration: underline; text-underline-offset: 2px;
  }
  @media (max-width: 850px) {
    .wv-intro-cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .wv-intro-cols { grid-template-columns: 1fr; gap: 0.75rem; padding: 0.75rem 1rem; font-size: 0.78rem; }
    .wv-header { margin-bottom: 1rem; }
    .wv-header h1 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  }

  /*
   * ── Design system overrides ──
   * Goal: data-journalism aesthetic (Our World in Data, Bloomberg).
   * Every rule here is intentional — no decoration, just hierarchy.
   */

  /* Layout frame */
  .wv-layout { border-radius: 0 !important; box-shadow: none !important; max-height: 720px; }

  /* Left panel */
  .wv-panel-title { display: none; }
  .wv-bulk-actions { padding: 8px 14px 4px; gap: 4px; }
  .wv-bulk-btn { border-radius: 0; font-size: 0.6rem; padding: 3px 8px; letter-spacing: 0; text-transform: none; }

  /* Preset buttons */
  .wv-presets {
    display: flex; align-items: center; gap: 4px; padding: 4px 14px 8px;
    flex-wrap: wrap;
  }
  .wv-presets-label { font-size: 0.58rem; color: var(--text-secondary); opacity: 0.6; margin-right: 2px; }
  .wv-preset-btn {
    font-family: inherit; font-size: 0.58rem; font-weight: 400;
    color: var(--accent, #8b3a3a); background: none;
    border: 1px solid var(--divider); border-radius: 3px;
    padding: 2px 7px; cursor: pointer; transition: all 0.12s;
  }
  .wv-preset-btn:hover { background: var(--bg-elevated, #fff); border-color: var(--accent, #8b3a3a); }
  [data-theme="dark"] .wv-preset-btn:hover { background: var(--bg-elevated, #1c1c1a); }

  /* Category headers: bigger, acts as section label */
  .wv-cat-head {
    font-size: 0.88rem; letter-spacing: 0; text-transform: none; font-weight: 600;
    color: var(--text); padding: 11px 14px; padding-left: 11px;
    background: var(--panel);
    border-left: 3px solid var(--cat-head-color, transparent);
    position: sticky; top: 0; z-index: 2;
  }
  [data-theme="dark"] .wv-cat-head { background: var(--panel); }
  .wv-cat-head:hover { color: var(--text); }
  .wv-cat-head[data-open="true"] { border-bottom: none; }
  [data-cat="dc"] .wv-cat-head { --cat-head-color: #4A90D9; }
  [data-cat="industry"] .wv-cat-head { --cat-head-color: #D97A4A; }
  [data-cat="city"] .wv-cat-head { --cat-head-color: #5BA4CF; }
  [data-cat="farm"] .wv-cat-head { --cat-head-color: #4CAF78; }
  [data-cat="turf"] .wv-cat-head { --cat-head-color: #6BBF84; }
  [data-cat="national"] .wv-cat-head { --cat-head-color: #8B8FA8; }
  .wv-cat-chevron { font-size: 0.55rem; width: 12px; }
  .wv-cat-count { font-size: 0.65rem; opacity: 0.35; }
  .wv-cat-active { font-size: 0.6rem; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--text-secondary); opacity: 0.7; }
  .wv-cat-active:not(:empty) { background: var(--bg-elevated, #fff); padding: 1px 6px; border-radius: 3px; }
  [data-theme="dark"] .wv-cat-active:not(:empty) { background: var(--bg-elevated, #1c1c1a); }
  .wv-cat-controls { font-size: 0.6rem; }

  /* Open category list: white/elevated background */
  .wv-cat-list[data-visible="true"] {
    background: var(--bg-elevated, #fff);
  }
  [data-theme="dark"] .wv-cat-list[data-visible="true"] {
    background: var(--bg-elevated, #1c1c1a);
  }

  /* Toggle rows: on white/elevated background when list is open */
  .wv-toggle-row { padding: 5px 14px; gap: 8px; min-height: auto; align-items: flex-start; background: transparent; }
  .wv-toggle-row[data-on="true"] { border-left: 2px solid var(--cat-color, var(--green)); padding-left: 12px; }
  .wv-toggle-row[data-on="false"] { border-left: 2px solid transparent; padding-left: 12px; }
  .wv-dot { width: 10px; height: 10px; border-radius: 2px; border-width: 1.5px; margin-top: 4px; border-color: var(--text-secondary); opacity: 0.6; }
  .wv-toggle-row[data-on="true"] .wv-dot { opacity: 1; }
  .wv-toggle-row[data-on="false"]:hover .wv-dot { opacity: 0.8; }
  .wv-row-name { font-size: 0.74rem; font-weight: 400; line-height: 1.3; }
  .wv-toggle-row[data-on="true"] .wv-row-name { color: var(--text); font-weight: 500; }
  .wv-toggle-row[data-on="false"] .wv-row-name { color: var(--text); }
  .wv-toggle-row[data-on="false"]:hover .wv-dot { border-color: var(--cat-color, var(--green)); opacity: 0.8; }
  .wv-toggle-row[data-on="false"]:hover { background: rgba(0, 0, 0, 0.04); }
  [data-theme="dark"] .wv-toggle-row[data-on="false"]:hover { background: rgba(255, 255, 255, 0.04); }
  .wv-toggle-row[data-on="false"] .wv-row-val { opacity: 0.6; }
  .wv-toggle-row[data-on="true"] .wv-row-val { opacity: 0.8; }

  /* Elec chip */
  .wv-elec-chip { border-radius: 1px; font-size: 0.5rem; padding: 1px 5px; letter-spacing: 0.04em; margin-top: 2px; }

  /* Section dividers */
  .wv-proj-divider { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; font-style: normal; color: var(--text-secondary); opacity: 0.35; padding: 10px 14px 3px; }

  /* Chart panel header */
  .wv-chart-header { padding: 8px 14px; border-bottom: 1px solid var(--divider); background: var(--panel); }
  [data-theme="dark"] .wv-chart-header { background: var(--panel); }
  .wv-chart-count { font-size: 0.65rem; font-variant-numeric: tabular-nums; }

  /* Segmented controls — underline style instead of pill */
  .wv-view-toggle, .wv-water-toggle {
    background: transparent; border-radius: 0; padding: 0; gap: 0;
    border-bottom: 1px solid var(--divider);
  }
  .wv-view-btn, .wv-water-btn {
    border-radius: 0; font-size: 0.65rem; font-weight: 400;
    padding: 5px 12px 6px; border-bottom: 2px solid transparent;
    margin-bottom: -1px; background: transparent !important;
    box-shadow: none !important; color: var(--text-secondary);
    transition: color 0.1s, border-color 0.1s;
  }
  .wv-view-btn:hover, .wv-water-btn:hover { color: var(--text); }
  .wv-view-btn[data-active="true"], .wv-water-btn[data-active="true"] {
    color: var(--text) !important; font-weight: 600;
    border-bottom-color: var(--text) !important;
  }
  .wv-water-btn { font-size: 0.65rem !important; padding: 5px 12px 6px !important; }
  .wv-water-btn[data-active="true"] { color: var(--text) !important; border-bottom-color: var(--text) !important; }

  /* Bar chart */
  .wv-bar-row { border-radius: 0; margin-bottom: 3px; padding: 2px 0; cursor: pointer; }
  .wv-bar-row:hover { background: transparent; }
  .wv-bar-row:hover .wv-bar-name { color: var(--text); }
  .wv-bar-row:hover .wv-bar-fill { opacity: 0.9; }
  .wv-bar-name { font-size: 0.7rem; font-weight: 400; width: 200px; line-height: 1.25; color: var(--text-secondary); }
  .wv-bar-track { height: 16px; border-radius: 0; background: transparent; border-bottom: 1px solid var(--divider); }
  .wv-bar-fill { border-radius: 0; opacity: 0.75; }
  .wv-bar-val { font-size: 0.65rem; font-weight: 400; width: 145px; }
  .wv-bar-pct { font-size: 0.55rem; opacity: 0.35; margin-left: 4px; }
  [data-theme="dark"] .wv-bar-row:hover { background: transparent; }

  /* Squares: clickable */
  .wv-sq-item { cursor: pointer; }
  .wv-sq-item:hover .wv-sq-box { filter: brightness(1.08); transition: filter 0.1s; }
  .wv-sq-name { font-weight: 400; font-size: 0.62rem !important; }
  .wv-sq-val { font-size: 0.55rem !important; opacity: 0.6; }

  /* Scale reference */
  .wv-scale-ref { border-radius: 0; font-size: 0.52rem; padding: 3px 6px; opacity: 0.6; }
  .wv-scale-ref-box { border-radius: 0 !important; opacity: 0.5; }

  /* Ratio callout */
  .wv-ratio-callout { font-size: 0.68rem; }

  /* Treated helper */
  .wv-treated-helper { font-size: 0.58rem; }

  /* Scrollbars: nearly invisible */
  .wv-toggles-scroll::-webkit-scrollbar { width: 1px; }
  .wv-cat-list::-webkit-scrollbar { width: 1px; }

  /* Tooltip: sharper */
  .wv-tooltip { border-radius: 2px; font-size: 0.7rem; max-width: 340px; padding: 10px 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }

  /* No loading shimmer */
  .wv-bars-area:empty, .wv-squares-area:empty { background-image: none !important; animation: none !important; }

  /* Methodology: tighter, editorial */
  .w-methodology h2 { font-size: 1.2rem; letter-spacing: -0.01em; margin-top: 2rem; }
  .w-meth-section summary { font-size: 0.82rem; }
  .w-meth-section summary::before { font-size: 0.55rem; }
  .w-meth-section summary:hover { color: var(--text); }
  .w-meth-table th { font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .w-meth-calc { border-radius: 0; }
  .w-meth-caveat { border-left-width: 1px; }

  /* Focus: understated */
  .wv2 *:focus-visible { outline: 1px solid var(--text-secondary); outline-offset: 1px; }

  /* Empty state */
  .wv-bars-empty { font-size: 0.78rem; opacity: 0.4; }
</style>

<script is:inline>
(function() {
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }
  function fGShort(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T' : g >= 1e9 ? (g/1e9).toFixed(1)+'B' : (g/1e6).toFixed(0)+'M'; }

  var barsArea = document.getElementById('wv-bars');
  var squaresArea = document.getElementById('wv-squares');
  var countEl = document.getElementById('wv-count');
  var treatedHelper = document.getElementById('wv-treated-helper');
  var ratioEl = document.getElementById('wv-ratio');
  var ratioWrap = document.getElementById('wv-ratio-wrap');
  var shareBtn = document.getElementById('wv-share');
  var currentView = 'squares';
  var waterMode = 'all';
  var items = [];
  var lastCount = -1;

  // (#4) Mark sub-items (state-level) vs "All US..." items
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var name = row.querySelector('.wv-row-name');
    if (!name) return;
    var txt = name.textContent;
    if (/^All US|^Total US/.test(txt)) {
      row.classList.add('wv-all-item');
    } else {
      var cat = row.closest('.wv-cat');
      if (cat) {
        var hasAllUS = cat.querySelector('.wv-row-name') && Array.prototype.some.call(cat.querySelectorAll('.wv-row-name'), function(n) {
          return /^All US|^Total US/.test(n.textContent);
        });
        if (hasAllUS) {
          row.classList.add('wv-sub-item');
        }
      }
    }
  });

  // (#10) Add tooltip to crossed-out items
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var tg = row.dataset.tgal;
    if (tg === 'null' || tg === '') {
      row.title = 'Uses untreated water \u2014 not shown in treated mode';
    }
  });

  // View toggle with crossfade
  document.querySelectorAll('.wv-view-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var view = btn.dataset.view;
      if (view === currentView) return;
      document.querySelectorAll('.wv-view-btn').forEach(function(b) {
        b.dataset.active = b.dataset.view === view ? 'true' : 'false';
      });
      var outgoing = view === 'bars' ? squaresArea : barsArea;
      var incoming = view === 'bars' ? barsArea : squaresArea;
      outgoing.style.opacity = '0';
      setTimeout(function() {
        outgoing.style.display = 'none';
        currentView = view;
        render();
        incoming.style.opacity = '0';
        incoming.style.display = '';
        requestAnimationFrame(function() {
          incoming.style.opacity = '1';
        });
      }, 150);
    });
  });

  // Water type toggle (all freshwater vs treated only)
  document.querySelectorAll('.wv-water-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var mode = btn.dataset.water;
      if (mode === waterMode) return;
      waterMode = mode;
      document.querySelectorAll('.wv-water-btn').forEach(function(b) {
        b.dataset.active = b.dataset.water === mode ? 'true' : 'false';
      });
      // (#16) Show/hide treated helper text with opacity transition
      if (treatedHelper) {
        if (mode === 'treated') {
          treatedHelper.style.display = '';
          requestAnimationFrame(function() { treatedHelper.style.opacity = '1'; });
        } else {
          treatedHelper.style.opacity = '0';
          setTimeout(function() { treatedHelper.style.display = 'none'; }, 200);
        }
      }
      // Update crossed-out state and values for all items
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        var it = items[idx];
        if (!it) return;
        if (mode === 'treated') {
          var tg = row.dataset.tgal;
          var isCrossed = tg === 'null' || tg === '';
          row.dataset.crossed = isCrossed ? 'true' : 'false';
          if (!isCrossed) {
            it.gallons = parseFloat(tg);
            it.name = it.baseName;
            it.squareName = it.baseSquareName;
            it.sub = fG(it.gallons);
            var valEl = row.querySelector('.wv-row-val');
            if (valEl) valEl.textContent = it.sub;
            var nameEl = row.querySelector('.wv-row-name');
            if (nameEl) nameEl.textContent = it.baseName;
          }
          var chip = row.querySelector('.wv-elec-chip');
          if (chip) {
            var te = row.dataset.telec;
            var elecCrossed = te === 'null' || te === '' || te === undefined;
            chip.dataset.crossed = elecCrossed ? 'true' : 'false';
            if (elecCrossed && it.elecOn) {
              it.elecOn = false;
              chip.dataset.elecOn = 'false';
              it.gallons = parseFloat(row.dataset.tgal);
              it.name = it.baseName;
              it.squareName = it.baseSquareName;
              it.sub = fG(it.gallons);
              var valEl2 = row.querySelector('.wv-row-val');
              if (valEl2) valEl2.textContent = it.sub;
              var nameEl2 = row.querySelector('.wv-row-name');
              if (nameEl2) nameEl2.textContent = it.baseName;
            }
          }
        } else {
          row.dataset.crossed = 'false';
          var chip2 = row.querySelector('.wv-elec-chip');
          if (chip2) chip2.dataset.crossed = 'false';
          if (it.elecOn) {
            it.gallons = it.galElec;
          } else if (it.galBase > 0) {
            it.gallons = it.galBase;
          } else {
            var gi = parseFloat(row.dataset.galIndustry || 0);
            if (gi > 0) it.gallons = gi;
          }
          it.sub = fG(it.gallons);
          var valEl3 = row.querySelector('.wv-row-val');
          if (valEl3) valEl3.textContent = it.sub;
        }
      });
      render();
    });
  });

  // Init all items from DOM
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var idx = parseInt(row.dataset.idx);
    var galBase = parseFloat(row.dataset.galBase || 0);
    var galElec = parseFloat(row.dataset.galElec || 0);
    var galIndustry = parseFloat(row.dataset.galIndustry || 0);
    var gallons = galIndustry > 0 ? galIndustry : galBase;
    var baseName = row.querySelector('.wv-row-name').textContent;

    var cat = row.closest('.wv-cat');
    var catName = cat ? cat.dataset.cat : '';
    var color = '#6B6B60';
    var catColors = {
      dc: '#4A90D9',
      industry: '#D97A4A',
      city: '#5BA4CF',
      farm: '#4CAF78',
      turf: '#6BBF84',
      national: '#8B8FA8'
    };
    color = catColors[catName] || color;
    row.style.setProperty('--cat-color', color);

    var tGalRaw = row.dataset.tgal;
    var tGal = (tGalRaw === 'null' || !tGalRaw) ? null : parseFloat(tGalRaw);
    var tElecRaw = row.dataset.telec;
    var tElec = (tElecRaw === 'null' || !tElecRaw) ? null : parseFloat(tElecRaw);

    // (#19) Add mini-bar span to row
    var rowText = row.querySelector('.wv-row-text');
    if (rowText && !rowText.querySelector('.wv-mini-bar')) {
      var miniBar = document.createElement('span');
      miniBar.className = 'wv-mini-bar';
      miniBar.style.width = '0px';
      var valSpan = rowText.querySelector('.wv-row-val');
      if (valSpan) {
        valSpan.appendChild(document.createTextNode(' '));
        valSpan.appendChild(miniBar);
      }
    }

    // For farm items, insert "irrigated" before crop name on square labels (not nav)
    var squareName = baseName;
    if (catName === 'farm' && baseName.indexOf('irrigated') < 0 && baseName.indexOf('Irrigated') < 0) {
      // "All US corn (2023)" → "All US irrigated corn (2023)"
      // "Nebraska corn" → "Nebraska irrigated corn"
      squareName = baseName.replace(/(corn|alfalfa)/, 'irrigated $1');
    }

    items[idx] = {
      idx: idx,
      gallons: gallons,
      on: row.dataset.on === 'true',
      color: color,
      name: baseName,
      squareName: squareName,
      baseSquareName: squareName,
      sub: fG(gallons),
      baseName: baseName,
      elecOn: false,
      galBase: galBase,
      galElec: galElec,
      tGal: tGal,
      tElec: tElec
    };

    row.addEventListener('click', function(e) {
      if (e.target.closest('.wv-elec-chip')) return;
      items[idx].on = !items[idx].on;
      row.dataset.on = items[idx].on ? 'true' : 'false';
      render();
    });

    // (#11) Hover-to-preview
    row.addEventListener('mouseenter', function() {
      if (items[idx].on) return;
      var barRow = barsArea.querySelector('.wv-bar-row[data-idx="' + idx + '"]');
      if (barRow) barRow.classList.add('wv-preview-highlight');
      var sqItem = squaresArea.querySelector('.wv-sq-item[data-sq-idx="' + idx + '"]');
      if (sqItem) sqItem.classList.add('wv-preview-highlight');
    });
    row.addEventListener('mouseleave', function() {
      var barRow = barsArea.querySelector('.wv-bar-row[data-idx="' + idx + '"]');
      if (barRow) barRow.classList.remove('wv-preview-highlight');
      var sqItem = squaresArea.querySelector('.wv-sq-item[data-sq-idx="' + idx + '"]');
      if (sqItem) sqItem.classList.remove('wv-preview-highlight');
    });
  });

  // Electricity chip handlers
  document.querySelectorAll('.wv-elec-chip').forEach(function(chip) {
    var parentIdx = parseInt(chip.dataset.parentIdx);
    var parentRow = chip.closest('.wv-toggle-row');

    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      if (!parentRow || parentRow.dataset.on !== 'true') return;

      var nowChecked = chip.dataset.elecOn !== 'true';
      chip.dataset.elecOn = nowChecked ? 'true' : 'false';

      var it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.squareName = nowChecked ? it.baseSquareName + ' + electricity' : it.baseSquareName;
      it.sub = fG(it.gallons);

      // (#7) Update value text with struck-through original
      var valEl = parentRow.querySelector('.wv-row-val');
      if (valEl) {
        // Remove existing mini-bar before rebuilding text
        var existingMini = valEl.querySelector('.wv-mini-bar');
        if (nowChecked) {
          valEl.innerHTML = '<s style="opacity:0.4">' + fGShort(it.galBase) + '</s> ' + it.sub;
        } else {
          valEl.textContent = it.sub;
        }
        // Re-add mini-bar
        if (!valEl.querySelector('.wv-mini-bar')) {
          var mb = document.createElement('span');
          mb.className = 'wv-mini-bar';
          mb.style.width = '0px';
          valEl.appendChild(document.createTextNode(' '));
          valEl.appendChild(mb);
        }
      }
      render();
    });
  });

  // Category header toggle (accordion — only one open at a time)
  document.querySelectorAll('.wv-cat-head').forEach(function(head) {
    head.addEventListener('click', function(e) {
      if (e.target.closest('.wv-cat-toggle')) return;
      var cat = head.closest('.wv-cat');
      var list = cat.querySelector('.wv-cat-list');
      var chevron = head.querySelector('.wv-cat-chevron');
      var isOpen = list.dataset.visible === 'true';

      document.querySelectorAll('.wv-cat').forEach(function(otherCat) {
        if (otherCat === cat) return;
        var otherList = otherCat.querySelector('.wv-cat-list');
        var otherHead = otherCat.querySelector('.wv-cat-head');
        var otherChevron = otherHead.querySelector('.wv-cat-chevron');
        if (otherList.dataset.visible === 'true') {
          otherList.dataset.visible = 'false';
          otherHead.dataset.open = 'false';
          otherChevron.textContent = '\u25B8';
        }
      });

      list.dataset.visible = isOpen ? 'false' : 'true';
      head.dataset.open = isOpen ? 'false' : 'true';
      chevron.textContent = isOpen ? '\u25B8' : '\u25BE';
    });
  });

  // All / None category toggles
  document.querySelectorAll('.wv-cat-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var cat = btn.closest('.wv-cat');
      if (!cat) return;
      var action = btn.dataset.action;
      var newOn = action === 'all';
      cat.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) {
          items[idx].on = newOn;
          row.dataset.on = newOn ? 'true' : 'false';
        }
      });
      render();
    });
  });

  // (#8) Clear all button
  var clearBtn = document.getElementById('wv-clear-all');
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      for (var ci = 0; ci < items.length; ci++) {
        if (items[ci]) {
          items[ci].on = false;
        }
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'false';
      });
      render();
      clearBtn.textContent = 'Cleared!';
      setTimeout(function() { clearBtn.textContent = 'Clear all'; }, 1500);
    });
  }

  // Add all button
  var addAllBtn = document.getElementById('wv-add-all');
  if (addAllBtn) {
    addAllBtn.addEventListener('click', function() {
      for (var ai = 0; ai < items.length; ai++) {
        if (items[ai]) {
          items[ai].on = true;
        }
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'true';
      });
      render();
      addAllBtn.textContent = 'Added!';
      setTimeout(function() { addAllBtn.textContent = 'Add all'; }, 1500);
    });
  }

  // Preset comparisons
  var presets = {
    'ai-vs-farms': ['ChatGPT (current est.)', 'All US AI workloads (2024)', 'All US data centers (2023)', 'All US corn (2023)', 'All US alfalfa (2023)'],
    'ai-vs-cities': ['ChatGPT (current est.)', 'Microsoft operations (FY24)', 'Google operations (2024)', 'All US data centers (2023)', 'New York City (consumptive est.)', 'Los Angeles (consumptive est.)', 'Phoenix (consumptive est.)'],
    'big-picture': ['All US data centers (2023)', 'All US data centers (2030 est.)', 'All US lawn irrigation (est.)', 'Total US freshwater (consumptive est.)', 'Total US public water supply (consumptive est.)']
  };
  document.querySelectorAll('.wv-preset-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var names = presets[btn.dataset.preset];
      if (!names) return;
      // Clear all first
      for (var pi = 0; pi < items.length; pi++) {
        if (items[pi]) items[pi].on = false;
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'false';
      });
      // Enable matching items
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var nameEl = row.querySelector('.wv-row-name');
        if (nameEl && names.indexOf(nameEl.textContent.trim()) !== -1) {
          var idx = parseInt(row.dataset.idx);
          if (items[idx]) items[idx].on = true;
          row.dataset.on = 'true';
        }
      });
      render();
    });
  });

  // Mobile: panel collapse toggle
  var collapseBtn = document.getElementById('wv-panel-collapse');
  var togglesPanel = document.getElementById('wv-toggles');
  if (collapseBtn && togglesPanel) {
    collapseBtn.addEventListener('click', function() {
      var isCollapsed = togglesPanel.dataset.collapsed === 'true';
      togglesPanel.dataset.collapsed = isCollapsed ? 'false' : 'true';
      collapseBtn.querySelector('.wv-panel-collapse-text').textContent =
        isCollapsed ? 'Items' : 'Items (tap to expand)';
    });
  }

  // Mobile: auto-collapse other categories when one opens
  if (window.innerWidth <= 560) {
    document.querySelectorAll('.wv-cat-head').forEach(function(head) {
      head.addEventListener('click', function() {
        var parentCat = head.closest('.wv-cat');
        var isOpening = head.dataset.open !== 'true';
        if (isOpening) {
          document.querySelectorAll('.wv-cat').forEach(function(otherCat) {
            if (otherCat !== parentCat) {
              var otherHead = otherCat.querySelector('.wv-cat-head');
              var otherList = otherCat.querySelector('.wv-cat-list');
              if (otherHead && otherHead.dataset.open === 'true') {
                otherHead.dataset.open = 'false';
                otherHead.querySelector('.wv-cat-chevron').innerHTML = '&#9656;';
                if (otherList) otherList.dataset.visible = 'false';
              }
            }
          });
        }
      });
    });
  }

  // (#22) Share link
  if (shareBtn) {
    shareBtn.addEventListener('click', function() {
      var activeIndices = [];
      for (var si = 0; si < items.length; si++) {
        if (items[si] && items[si].on) activeIndices.push(si);
      }
      var url = window.location.origin + window.location.pathname + '?items=' + activeIndices.join(',');
      navigator.clipboard.writeText(url).then(function() {
        shareBtn.textContent = 'Copied!';
        setTimeout(function() { shareBtn.textContent = 'Copy link'; }, 2000);
      }).catch(function() {
        shareBtn.textContent = 'Failed';
        setTimeout(function() { shareBtn.textContent = 'Copy link'; }, 2000);
      });
    });
  }

  // (#22) On page load, check for ?items= param
  (function() {
    var params = new URLSearchParams(window.location.search);
    var itemsParam = params.get('items');
    if (itemsParam) {
      var indices = itemsParam.split(',').map(function(s) { return parseInt(s); });
      // Turn off all items first
      for (var pi = 0; pi < items.length; pi++) {
        if (items[pi]) items[pi].on = false;
      }
      document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        row.dataset.on = 'false';
      });
      // Turn on specified items
      for (var qi = 0; qi < indices.length; qi++) {
        var idx = indices[qi];
        if (items[idx]) {
          items[idx].on = true;
          var row = document.querySelector('.wv-toggle-row[data-idx="' + idx + '"]');
          if (row) row.dataset.on = 'true';
        }
      }
    }
  })();

  // (#9) Update category active count badges + total gallons
  function updateCategoryBadges() {
    document.querySelectorAll('.wv-cat').forEach(function(cat) {
      var count = 0;
      var totalGal = 0;
      cat.querySelectorAll('.wv-toggle-row[data-on="true"]').forEach(function(row) {
        count++;
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) totalGal += items[idx].gallons;
      });
      var badge = cat.querySelector('.wv-cat-active');
      if (badge) {
        if (count > 0) {
          badge.textContent = '\u00b7 ' + count + ' on \u00b7 ' + fG(totalGal);
        } else {
          badge.textContent = '';
        }
      }
    });
  }

  function render() {
    var active = [];
    for (var i = 0; i < items.length; i++) {
      if (!items[i] || !items[i].on) continue;
      if (waterMode === 'treated') {
        var row = document.querySelector('.wv-toggle-row[data-idx="' + i + '"]');
        if (row && row.dataset.crossed === 'true') continue;
      }
      active.push(items[i]);
    }

    updateCategoryBadges();

    // (#21) Count pulse animation
    var newCount = active.length;
    if (countEl) {
      countEl.innerHTML = 'Comparing <strong>' + newCount + '</strong> item' + (newCount === 1 ? '' : 's');
      if (lastCount !== -1 && lastCount !== newCount) {
        countEl.classList.add('wv-count-pulse');
        setTimeout(function() { countEl.classList.remove('wv-count-pulse'); }, 150);
      }
      lastCount = newCount;
    }

    // (#3) Two-item ratio callout
    if (ratioEl && ratioWrap) {
      if (active.length === 2) {
        var sorted = active.slice().sort(function(a, b) { return b.gallons - a.gallons; });
        var ratio = (sorted[0].gallons / sorted[1].gallons).toFixed(1);
        ratioEl.textContent = sorted[0].baseName + ' is ' + ratio + '\u00d7 larger than ' + sorted[1].baseName;
        ratioWrap.classList.add('wv-ratio-visible');
      } else {
        ratioWrap.classList.remove('wv-ratio-visible');
      }
    }

    // (#19) Update mini-bars in panel
    var maxGlobal = 0;
    for (var mi = 0; mi < items.length; mi++) {
      if (items[mi] && items[mi].on && items[mi].gallons > maxGlobal) maxGlobal = items[mi].gallons;
    }
    document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
      var mb = row.querySelector('.wv-mini-bar');
      if (!mb) return;
      var idx = parseInt(row.dataset.idx);
      var it = items[idx];
      if (it && it.on && maxGlobal > 0) {
        mb.style.width = Math.round((it.gallons / maxGlobal) * 30) + 'px';
      } else {
        mb.style.width = '0px';
      }
    });

    if (active.length === 0) {
      barsArea.innerHTML = '<div class="wv-bars-empty">Expand a category on the left and click items to add them to the comparison.</div>';
      squaresArea.innerHTML = '<div class="wv-bars-empty">Toggle items on the left to see their water use as proportional squares.</div>';
      return;
    }

    // Sort largest to smallest
    active.sort(function(a, b) { return b.gallons - a.gallons; });
    var maxG = active[0].gallons;

    // ── Bar view ──
    if (currentView === 'bars') {
      var html = '';
      for (var j = 0; j < active.length; j++) {
        var it = active[j];
        var pct = maxG > 0 ? (it.gallons / maxG) * 100 : 0;
        var pctRound = pct >= 1 ? Math.round(pct) : pct >= 0.1 ? Math.round(pct * 10) / 10 : pct >= 0.01 ? Math.round(pct * 100) / 100 : '<0.01';
        var isProj = it.name.indexOf('2030') >= 0;
        var elecTag = it.elecOn ? ' +elec' : '';
        var prefix = isProj ? '~' : '';
        var val = prefix + it.sub + elecTag;
        // (#2) Append percentage
        var pctText = ' \u00b7 ' + pctRound + '%';
        // (#5) Projected items get striped background
        var fillStyle = 'width:' + pct.toFixed(1) + '%;background:' + it.color;
        if (isProj) {
          fillStyle += ';background-image:repeating-linear-gradient(45deg,transparent,transparent 3px,rgba(0,0,0,0.03) 3px,rgba(0,0,0,0.03) 6px)';
        }
        html += '<div class="wv-bar-row" data-idx="' + it.idx + '" title="' + it.squareName + ': ' + val + '" style="border-left:3px solid ' + it.color + ';padding-left:8px">';
        html += '<span class="wv-bar-name" title="' + it.squareName + '">' + it.squareName + '</span>';
        html += '<div class="wv-bar-track"><div class="wv-bar-fill" style="' + fillStyle + '"></div></div>';
        html += '<span class="wv-bar-val">' + val + '<span class="wv-bar-pct">' + pctText + '</span></span>';
        html += '</div>';
      }
      barsArea.innerHTML = html;
    }

    // ── Square view ──
    if (currentView === 'squares') {
      var pad = window.innerWidth < 560 ? 20 : 32;
      var panelW = squaresArea.clientWidth - pad;
      var panelH = squaresArea.clientHeight - pad;
      if (panelW < 50) panelW = Math.min(window.innerWidth - 40, 600);
      if (panelH < 50) panelH = Math.min(window.innerHeight * 0.4, 500);

      var maxSide = Math.round(Math.min(panelW, panelH) * 0.8);
      var labelH = 32;

      var sized = [];
      for (var k = 0; k < active.length; k++) {
        var sq = active[k];
        var side = Math.max(1, Math.round(maxSide * Math.sqrt(sq.gallons / maxG)));
        var isP = sq.name.indexOf('2030') >= 0;
        var eTag = sq.elecOn ? ' +elec' : '';
        var pre = isP ? '~' : '';
        var v = pre + sq.sub + eTag;
        sized.push({ sq: sq, side: side, val: v });
      }

      var measureCanvas = document.createElement('canvas');
      var ctx = measureCanvas.getContext('2d');
      ctx.font = '500 11px sans-serif';

      var scale = 1;
      var placed, totalH;
      for (var attempt = 0; attempt < 10; attempt++) {
        var gap = Math.max(8, Math.round(14 * scale));
        placed = [];
        var shelfX = 0, shelfY = 0, shelfH = 0;
        for (var s = 0; s < sized.length; s++) {
          var scaledSide = Math.max(1, Math.round(sized[s].side * scale));
          var textW = ctx.measureText(sized[s].sq.squareName).width + 8;
          var labelBelowPack = scaledSide >= 60;
          var nameW = textW;
          var itemW, itemH;
          if (labelBelowPack) {
            itemW = Math.max(scaledSide, nameW * Math.min(1, scale + 0.3), 36);
            itemH = scaledSide + labelH;
          } else {
            itemW = scaledSide + 6 + nameW;
            itemH = Math.max(scaledSide, 20) + 8;
          }
          if (shelfX + itemW > panelW && shelfX > 0) {
            shelfY += shelfH + gap;
            shelfX = 0;
            shelfH = 0;
          }
          placed.push({ x: shelfX, y: shelfY, w: itemW, h: itemH, scaledSide: scaledSide, data: sized[s] });
          shelfH = Math.max(shelfH, itemH);
          shelfX += itemW + gap;
        }
        totalH = shelfY + shelfH + 16;
        if (totalH <= panelH || scale < 0.15) break;
        scale *= 0.75;
      }
      var fitH = Math.max(totalH, panelH);

      var container = squaresArea.querySelector('.wv-sq-container');
      if (!container) {
        container = document.createElement('div');
        container.className = 'wv-sq-container';
        container.style.position = 'relative';
        container.style.width = '100%';
        squaresArea.innerHTML = '';
        squaresArea.appendChild(container);
      }
      container.style.height = fitH + 'px';

      var existing = {};
      container.querySelectorAll('.wv-sq-item').forEach(function(el) {
        existing[el.dataset.sqIdx] = el;
      });

      var usedKeys = {};

      for (var p = 0; p < placed.length; p++) {
        var pl = placed[p];
        var d = pl.data;
        var ss = pl.scaledSide;
        var key = '' + d.sq.idx;
        usedKeys[key] = true;

        // (#18) Proportional font sizes
        var fontSize = Math.max(9, Math.min(13, ss * 0.12)) + 'px';
        var valSize = Math.max(8, Math.min(11, ss * 0.1)) + 'px';

        var el = existing[key];
        if (!el) {
          el = document.createElement('div');
          el.className = 'wv-sq-item';
          el.dataset.sqIdx = key;
          el.innerHTML = '<div class="wv-sq-box"></div><div class="wv-sq-color-bar"></div><div class="wv-sq-label"><span class="wv-sq-name"></span><span class="wv-sq-val"></span></div>';
          el.style.position = 'absolute';
          el.style.opacity = '0';
          container.appendChild(el);
          el.offsetHeight;
          el.style.opacity = '1';
        }

        // (#5) Projected items: dashed border
        var isProj2030 = d.sq.name.indexOf('2030') >= 0;
        if (isProj2030) {
          el.classList.add('wv-proj-item');
        } else {
          el.classList.remove('wv-proj-item');
        }

        // (#13) Square hover — handled by rich tooltip system

        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        var fillOpacity = isDark ? '0.55' : '0.5';

        var labelBelow = ss >= 60;
        var showName = true;

        if (labelBelow) {
          el.style.flexDirection = 'column';
          el.style.alignItems = 'center';
        } else {
          el.style.flexDirection = 'row';
          el.style.alignItems = 'center';
          el.style.gap = '6px';
        }

        el.style.left = pl.x + 'px';
        el.style.top = pl.y + 'px';
        el.style.width = labelBelow ? pl.w + 'px' : '';
        var box = el.querySelector('.wv-sq-box');
        box.style.width = ss + 'px';
        box.style.height = ss + 'px';
        box.style.borderRadius = '0';
        box.style.background = d.sq.color;
        box.style.opacity = fillOpacity;
        box.style.border = ss >= 10 ? '2px solid ' + d.sq.color : 'none';
        box.style.borderColor = d.sq.color;
        box.style.flexShrink = '0';
        var colorBar = el.querySelector('.wv-sq-color-bar');
        if (colorBar) {
          colorBar.style.width = '20px';
          colorBar.style.height = '2px';
          colorBar.style.background = d.sq.color;
          colorBar.style.borderRadius = '1px';
          colorBar.style.flexShrink = '0';
        }
        var nameEl = el.querySelector('.wv-sq-name');
        nameEl.textContent = showName ? d.sq.squareName : '';
        nameEl.title = d.sq.squareName;
        nameEl.style.fontSize = fontSize;
        nameEl.style.textAlign = labelBelow ? 'center' : 'left';
        var valEl = el.querySelector('.wv-sq-val');
        valEl.textContent = d.val;
        valEl.style.fontSize = valSize;
        valEl.style.textAlign = labelBelow ? 'center' : 'left';
        var labelEl = el.querySelector('.wv-sq-label');
        if (labelEl) {
          labelEl.style.textAlign = labelBelow ? 'center' : 'left';
        }
      }

      // (#1) Scale reference
      var refEl = container.querySelector('.wv-scale-ref');
      if (!refEl) {
        refEl = document.createElement('div');
        refEl.className = 'wv-scale-ref';
        container.appendChild(refEl);
      }
      var refSide = Math.max(12, Math.round(maxSide * scale * Math.sqrt(1e9 / maxG)));
      if (refSide >= 2 && refSide <= 60) {
        refEl.innerHTML = '<div class="wv-scale-ref-box" style="width:' + refSide + 'px;height:' + refSide + 'px"></div> 1B gal/yr';
        refEl.style.display = '';
      } else {
        refEl.style.display = 'none';
      }

      // Remove items no longer active
      for (var eKey in existing) {
        if (!usedKeys[eKey]) {
          var removeEl = existing[eKey];
          removeEl.style.opacity = '0';
          removeEl.style.transition = 'opacity 0.3s ease';
          setTimeout(function(el) { if (el.parentNode) el.parentNode.removeChild(el); }, 350, removeEl);
        }
      }
    }
  }

  // Click bar rows — tooltip handles this now, no toggle
  barsArea.addEventListener('click', function(e) {
    // Bar clicks are handled by the tooltip click handler above
  });

  // ── Rich tooltips ──────────────────────────────
  var TIPS = {
    'ChatGPT (current est.)': 'ChatGPT runs on <a href="https://azure.microsoft.com/">Azure data centers</a> that consume water primarily through <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy">cooling systems</a> (evaporative cooling, chillers, or hybrid approaches) to dissipate heat from GPU inference. This estimate covers average message serving — not <a href="https://openai.com/index/new-and-improved-embedding-model/">training</a>, API traffic, or heavy multimodal workloads.<hr><strong>Method:</strong> <a href="https://openai.com/global-affairs/new-economic-analysis/">~3.25B messages/day</a> (scaled from <a href="https://openai.com/global-affairs/new-economic-analysis/">700M → 900M weekly active users</a>) × <a href="https://blog.samaltman.com/the-gentle-singularity">0.31 mL/message</a> direct on-site water (triangulated from <a href="https://blog.samaltman.com/the-gentle-singularity">Altman\'s 0.322 mL</a> and <a href="https://sustainability.google/reports/google-2025-environmental-report/">Google Gemini\'s 0.26 mL</a>). Electricity water uses <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">thermoelectric-only factor (0.47 gal/kWh)</a>, <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water">excluding hydro reservoir evaporation</a>.',
    'All US AI workloads (2024)': 'AI-specialized <a href="https://www.nvidia.com/en-us/data-center/">GPU servers</a> require more intensive cooling than traditional compute. This is a share-allocation estimate — it gives AI its share of total fleet-average water, not an AI-specific water intensity measurement.<hr><strong>Method:</strong> <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy">AI servers used ~40 TWh of 176 TWh total</a> US data center electricity (~23%). That share of <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy">17.4B gal total</a> = ~4B gal. Electricity water uses <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">thermoelectric-only factor (0.47 gal/kWh)</a>, <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water">excluding hydro reservoir evaporation</a>.',
    'Microsoft operations (FY24)': 'Microsoft\'s global cloud and data center operations, including <a href="https://azure.microsoft.com/">Azure</a>, Office 365, and AI services. Predominantly municipal water, though some facilities <a href="https://blogs.microsoft.com/on-the-issues/2023/09/21/microsoft-water-positive-2030-water-replenishment/">use recycled water</a>.<hr><strong>Method:</strong> <a href="https://cdn-dynmedia-1.microsoft.com/is/content/microsoftcorp/microsoft/msc/documents/presentations/CSR/2025-Microsoft-Environmental-Data-Fact-Sheet-PDF.pdf">5,807 ML total water consumption</a> from FY24 fact sheet (updated estimation approach; prior years not restated). Electricity: <a href="https://cdn-dynmedia-1.microsoft.com/is/content/microsoftcorp/microsoft/msc/documents/presentations/CSR/2025-Microsoft-Environmental-Data-Fact-Sheet-PDF.pdf">~29.8 TWh</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>. Note: global operations, so the US thermoelectric factor is approximate.',
    'Google operations (2024)': 'Google\'s global <a href="https://www.google.com/about/datacenters/">data center</a> and office operations. Google reports <em>freshwater consumption</em>, which <a href="https://sustainability.google/reports/google-2025-environmental-report/">may differ in boundary</a> from Microsoft\'s <em>total operational water consumption</em>.<hr><strong>Method:</strong> <a href="https://sustainability.google/operations/">4.5B gal replenished = 64% of freshwater consumption</a>, implying 7.03B total. Electricity: <a href="https://sustainability.google/reports/google-2025-environmental-report/">~30.8 TWh DC electricity</a> (<a href="https://sustainability.google/reports/google-2025-environmental-report/">27% YoY increase</a>) × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'All US data centers (2023)': 'U.S. data centers consume water primarily through <a href="https://www.techtarget.com/searchdatacenter/tip/Data-center-cooling-systems-and-technologies-and-how-they-work">cooling systems</a> — evaporative cooling towers, chillers, and increasingly <a href="https://datacenters.lbl.gov/liquid-cooling">liquid cooling</a> for AI workloads. Some newer facilities, like <a href="https://www.microsoft.com/en-us/microsoft-cloud/blog/2024/12/09/sustainable-by-design-next-generation-datacenters-consume-zero-water-for-cooling/">Microsoft\'s next-gen designs</a>, use zero-water closed-loop systems. From <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy">LBNL\'s 2024 survey</a> of the entire US data center industry.<hr><strong>Method:</strong> <a href="https://eta-publications.lbl.gov/sites/default/files/2024-12/lbnl-2024-united-states-data-center-energy-usage-report.pdf">LBNL reports 66 billion liters</a> direct site water consumption at <a href="https://eta-publications.lbl.gov/sites/default/files/2024-12/lbnl-2024-united-states-data-center-energy-usage-report.pdf">176 TWh electricity</a> in 2023. 66B L ÷ 3.785 = 17.4B gal. Electricity water uses <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">thermoelectric-only factor (0.47 gal/kWh)</a>, <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water">excluding hydro reservoir evaporation</a>.',
    'ChatGPT (2030 est.)': 'Projected ChatGPT water if average usage remains text-dominant. Not for a future where the average interaction is a long-running <a href="https://openai.com/index/introducing-chatgpt-pro/">agent</a> or heavy video generation — in that world, the upper end of the range matters more.<hr><strong>Method:</strong> ~10B messages/day (range 5–15B) × ~0.25 mL/message (range 0.15–0.35 mL). Based on <a href="https://openai.com/global-affairs/new-economic-analysis/">OpenAI\'s 5× message growth</a> from July 2024–2025 and efficiency gains implied by <a href="https://blog.samaltman.com/the-gentle-singularity">Altman\'s per-query figures</a>. Range: 70M–500M gal/yr.',
    'US AI workloads (2030 est.)': 'Projected water for all AI workloads in US data centers by 2030.<hr><strong>Method:</strong> ~55–60% AI share of <a href="https://www.epri.com/research/products/000000003002028905">~500 TWh total US DC electricity</a> (from <a href="https://www.epri.com/research/products/000000003002028905">EPRI\'s 380–790 TWh range</a>) = ~288 TWh for AI. Direct water from applying the total DC estimate\'s share. Range: 25–70B gal/yr.',
    'All US data centers (2030 est.)': 'Projected total US data center water. The implied ~0.61 L/kWh WUE is above <a href="https://eta-publications.lbl.gov/sites/default/files/2024-12/lbnl-2024-united-states-data-center-energy-usage-report.pdf">LBNL\'s near-term projected range</a> of 0.45–0.48 L/kWh.<hr><strong>Method:</strong> <a href="https://www.epri.com/research/products/000000003002028905">EPRI projects 380–790 TWh</a> by 2030; <a href="https://www.iea.org/reports/electricity-2025">IEA base case ~425 TWh</a>. Central pairs ~500 TWh with WUE trends. Range: 50–110B gal/yr.',

    'US semiconductor fabs': 'Chip fabrication requires <a href="https://www.semiconductors.org/water-and-semiconductors/">ultra-pure water (UPW)</a> for wafer rinsing — each wafer goes through hundreds of rinse cycles. Predominantly municipal water. The <a href="https://www.semiconductors.org/strengthening-the-global-semiconductor-supply-chain/">US produces about 12% of global semiconductors</a> by revenue.<hr><strong>Method:</strong> <a href="https://www.construction-physics.com/p/how-does-the-us-use-water">~29B gal/yr withdrawal × ~30% consumption ratio</a> = 9B gal consumed. Electricity: <a href="https://www.eia.gov/consumption/manufacturing/data/2018/">~12 TWh (EIA MECS 2018, NAICS 334413)</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'US oil refining': 'Refineries use water for cooling, steam generation, and crude processing. The US refines about <a href="https://www.eia.gov/dnav/pet/pet_pnp_wiup_dcu_nus_w.htm">17 million barrels of crude per day</a>. Almost all refinery water is self-supplied from rivers, not municipal systems.<hr><strong>Method:</strong> <a href="https://greet.anl.gov/files/refineries-water-2016">~100B gal/yr withdrawal × ~22% consumption ratio</a> (Argonne GREET). Electricity: <a href="https://www.eia.gov/consumption/manufacturing/data/2018/">~48.5 TWh (EIA MECS 2018, NAICS 324110)</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'US food & beverage': 'Food processing requires potable-quality water for washing, cooking, cleaning, and as an ingredient. This estimate has wide uncertainty (<a href="https://www.construction-physics.com/p/how-does-the-us-use-water">~100–275B gal range</a>). Municipal vs. self-supplied share is uncertain.<hr><strong>Method:</strong> <a href="https://www.construction-physics.com/p/how-does-the-us-use-water">~700B gal/yr withdrawal × ~25% consumption ratio</a> = ~150B gal consumed. Electricity: <a href="https://www.eia.gov/consumption/manufacturing/data/2018/">~106 TWh (EIA MECS 2018, NAICS 311+312)</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'US paper & pulp mills': 'Paper mills use enormous volumes of water for pulping, washing, and bleaching. Almost entirely <a href="https://www.construction-physics.com/p/how-does-the-us-use-water">self-supplied from rivers</a>. The industry generates <a href="https://www.eia.gov/consumption/manufacturing/data/2018/">~66–75% of its own electricity from biomass</a> (black liquor), so the grid draw is relatively small.<hr><strong>Method:</strong> <a href="https://www.construction-physics.com/p/how-does-the-us-use-water">~1,460B gal/yr withdrawal × ~12% consumption ratio</a> = ~175B gal consumed. Electricity: <a href="https://www.eia.gov/consumption/manufacturing/data/2018/">~51 TWh net grid (EIA MECS 2018, NAICS 322)</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'US meat & poultry processing': 'The US processes about <a href="https://www.epa.gov/eg/meat-and-poultry-products-effluent-guidelines">149B lb of meat (live weight) and 106B lb of poultry</a> per year. Water is used for carcass washing, scalding, chilling, cleaning, and sanitation — all of which must use <a href="https://www.fsis.usda.gov/policy/fsis-directives/7120.1">potable water by FSIS regulation</a>. Most facilities use <a href="https://www.fsis.usda.gov/policy/fsis-directives/7120.1">public water supplies or well water</a>.<hr><strong>Method:</strong> Four segments calculated from <a href="https://www.epa.gov/eg/meat-and-poultry-products-effluent-guidelines">EPA 2023 technical development document</a>: meat first processing (47.6B), meat further processing (49.8B), poultry first processing (68.3B), poultry further processing (13.7B) = 179B total. Public-supply potable: ~60% central estimate (range 45–75%) = 108B. This is a <strong>water-throughput proxy</strong> based on wastewater generation rates, not strict consumptive use.',
    'US pharmaceutical manufacturing': '<a href="https://www.fda.gov/drugs/pharmaceutical-quality-resources/water-pharmaceutical-use">FDA states</a> that pharmaceutical water systems rely on potable feedwater, and large volumes of <a href="https://www.fda.gov/drugs/pharmaceutical-quality-resources/water-pharmaceutical-use">purified water and Water for Injection (WFI)</a> must be generated. Potable water is obtained <a href="https://www.fda.gov/drugs/pharmaceutical-quality-resources/water-pharmaceutical-use">primarily from municipal water systems</a>.<hr><strong>Method:</strong> <a href="https://www.epa.gov/eg/pharmaceutical-manufacturing-effluent-guidelines">EPA 1998 pharmaceutical TDD</a>: 297 facilities generated 266.42 MGD total wastewater = 97.2B gal/yr. Public-supply potable: ~85% central (range 70–95%) = 82.7B, based on FDA\'s "primarily municipal" statement. This is a <strong>wastewater-generated proxy</strong> for freshwater handled.',
    'US dairy processing': 'Dairy plants use water for <a href="https://www.fda.gov/food/guidance-regulation-food-and-dietary-supplements/grade-a-pasteurized-milk-ordinance-pmo">cleaning-in-place (CIP), product contact, and sanitation</a> — all requiring safe/sanitary water under the <a href="https://www.fda.gov/food/guidance-regulation-food-and-dietary-supplements/grade-a-pasteurized-milk-ordinance-pmo">Pasteurized Milk Ordinance</a>. Water can come from <a href="https://www.epa.gov/eg/dairy-products-processing-effluent-guidelines">wells or municipal systems</a>.<hr><strong>Method:</strong> <a href="https://www.nass.usda.gov/Publications/Todays_Reports/reports/mkpr0425.pdf">USDA 2024: 225B lb milk marketed</a> × <a href="https://www.epa.gov/eg/dairy-products-processing-effluent-guidelines">EPA benchmark 200 gal/1000 lb</a> = 45B gal/yr. Public-supply potable: ~70% central (range 50–85%) = 31.5B. This is a <strong>central BOTEC</strong>, not a measured industry census total — real plants vary widely by product mix and water reuse.',
    'US industrial launderers': 'Industrial launderers (uniforms, linens, shop towels) are overwhelmingly connected to <a href="https://www.epa.gov/watersense/commercial-and-institutional-sector">public water and sewer systems</a>. About <a href="https://www.epa.gov/watersense/commercial-and-institutional-sector">84% of water use</a> goes to cleaning and sanitation.<hr><strong>Method:</strong> <a href="https://www.census.gov/naics/?input=812332">1,421 employer establishments (Census, NAICS 812332)</a> × <a href="https://www.epa.gov/watersense/commercial-and-institutional-sector">64,090 gal/day average</a> (EPA commercial water study) × 365 = 33.2B gal/yr public-supply. Total freshwater ~33–37B (slight cushion for any self-supplied sites).',
    'US breweries (modeled)': 'Brewing requires high-quality source water for mashing, lautering, boiling, cooling, and cleaning. Water-to-beer ratios vary from <a href="https://www.epa.gov/sites/default/files/2019-11/documents/nwrap-action-plan-final-2019-11-27.pdf">4 to 12 gallons of water per gallon of beer</a>. Many breweries use municipal water, but some use wells or springs.<hr><strong>Method:</strong> <a href="https://www.brewersassociation.org/statistics-and-data/national-beer-stats/">23.1M barrels craft</a> at <a href="https://www.brewersassociation.org/statistics-and-data/national-beer-stats/">13.3% market share</a> → ~173.7M barrels total → ~5.4B gal beer × 6 gal water/gal beer (central) = 32B gal/yr. Public-supply: ~75% central = 24B. Range: 22–65B.',
    'US bottled water mfg (total only)': 'Bottled water manufacturing uses water as both ingredient and process water. <a href="https://www.fda.gov/food/resources-you-food/bottled-water">FDA requires</a> that bottled water meet specific quality standards. Sources may include <a href="https://www.gao.gov/products/gao-09-610">wells, springs, and public drinking-water systems</a> — the national source mix is not publicly reported.<hr><strong>Method:</strong> <a href="https://bottledwater.org/economics-of-bottled-water/">16.4B gal product volume (2024)</a> × <a href="https://bottledwater.org/economics-of-bottled-water/">1.39 gal water used per gal bottled (IBWA)</a> = 22.8B gal/yr total. <strong>No public-supply split shown</strong> because the national share from municipal vs. self-supplied sources is not defensibly known.',

    'All US corn (2023)': 'Irrigated corn accounts for about <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">20% of total US corn acreage</a> but produces a disproportionate share of yield. The <a href="https://www.usgs.gov/mission-areas/water-resources/science/high-plains-aquifer">Great Plains</a> (especially Nebraska) dominates irrigated corn, drawing heavily from the <a href="https://www.usgs.gov/mission-areas/water-resources/science/high-plains-aquifer">Ogallala Aquifer</a>. This shows estimated <strong>consumptive use</strong> — water consumed via <a href="https://www.ers.usda.gov/topics/farm-practices-management/irrigation-water-use/">evapotranspiration</a>, not total applied irrigation.<hr><strong>Method:</strong> <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">11.64M irrigated acres × 1.0 ac-ft/ac applied</a> (USDA 2023 IWMS Table 39) × <a href="https://extensionpubs.unl.edu/publication/g2345/2023/html/view">0.75 consumptive use ratio</a> (center-pivot efficiency 70–85%) = 2.84T gal consumed.',
    'Nebraska corn': 'Nebraska is the <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">#1 irrigated corn state</a>, with about 38% of all US irrigated corn acreage. Heavily dependent on the <a href="https://www.usgs.gov/mission-areas/water-resources/science/high-plains-aquifer">Ogallala Aquifer</a> for groundwater pumping. This is an <strong>illustrative modeled breakout</strong> using national average irrigation rates.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate (1.0 ac-ft/ac)</a> × <a href="https://extensionpubs.unl.edu/publication/g2345/2023/html/view">0.75 CU ratio</a> from USDA 2023 IWMS.',
    'Kansas corn': 'Kansas is a major irrigated corn state, drawing primarily from the <a href="https://www.usgs.gov/mission-areas/water-resources/science/high-plains-aquifer">declining Ogallala Aquifer</a> in western Kansas. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × <a href="https://extensionpubs.unl.edu/publication/g2345/2023/html/view">0.75 CU ratio</a>.',
    'Arkansas corn': 'Arkansas irrigates corn primarily from the <a href="https://pubs.usgs.gov/publication/sir20195100">Mississippi River alluvial aquifer</a>. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × <a href="https://extensionpubs.unl.edu/publication/g2345/2023/html/view">0.75 CU ratio</a>.',
    'Texas corn': 'Texas irrigated corn draws from the <a href="https://www.usgs.gov/mission-areas/water-resources/science/high-plains-aquifer">Ogallala Aquifer</a> in the Panhandle and from the <a href="https://www.ibwc.gov/">Rio Grande</a>. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × <a href="https://extensionpubs.unl.edu/publication/g2345/2023/html/view">0.75 CU ratio</a>.',
    'All US alfalfa (2023)': 'Alfalfa is one of the thirstiest crops — it needs about <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">2.3× as much applied water per acre as corn</a>. Grown primarily in western states for <a href="https://www.ers.usda.gov/topics/crops/hay/">livestock feed</a>. Almost all irrigation water comes from rivers and wells, not municipal supply. This shows estimated <strong>consumptive use</strong>.<hr><strong>Method:</strong> <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">5.41M irrigated acres × 2.3 ac-ft/ac applied</a> (USDA 2023 IWMS Table 39) × 0.70 consumptive use ratio (<a href="https://alfalfa.ucdavis.edu/sites/g/files/dgvnsk12586/files/media/documents/UCAlfalfa8293Irrigation-reg.pdf">flood irrigation dominant</a> at 60–75% efficiency) = 2.84T gal consumed.',
    'Idaho alfalfa': 'Idaho is a top alfalfa-producing state, with extensive irrigation from the <a href="https://www.usbr.gov/pn/snakeriver/">Snake River system</a>. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × 0.70 CU ratio.',
    'California alfalfa': 'California grows alfalfa primarily in the <a href="https://www.usbr.gov/lc/region/pao/feis/ch3_03.html">Imperial</a> and <a href="https://water.ca.gov/Programs/State-Water-Project">Central Valleys</a> using Colorado River and groundwater. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × 0.70 CU ratio.',
    'Montana alfalfa': 'Montana irrigates alfalfa primarily through <a href="https://alfalfa.ucdavis.edu/sites/g/files/dgvnsk12586/files/media/documents/UCAlfalfa8293Irrigation-reg.pdf">flood irrigation</a> from surface water sources. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × 0.70 CU ratio.',
    'Colorado alfalfa': 'Colorado alfalfa is irrigated primarily from the <a href="https://www.usbr.gov/uc/">Colorado River system</a> and South Platte tributaries. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> State acreage × <a href="https://www.nass.usda.gov/Publications/AgCensus/2022/Online_Resources/Farm_and_Ranch_Irrigation_Survey/">national avg rate</a> × 0.70 CU ratio.',

    'All US lawn irrigation (est.)': 'Residential and commercial landscape irrigation is one of the largest uses of <a href="https://www.epa.gov/watersense/how-we-use-water">treated municipal water</a>. About <a href="https://www.epa.gov/watersense/how-we-use-water">30% of household water goes outdoors</a>, and lawns account for roughly 70% of that. State figures are <strong>illustrative modeled breakouts</strong>.<hr><strong>Method:</strong> <a href="https://www.epa.gov/watersense/how-we-use-water">EPA reports ~9B gal/day</a> landscape irrigation nationally. Municipal portion: <a href="https://pubs.usgs.gov/publication/pp1894D">13.1T total public supply</a> × 0.60 residential × 0.30 outdoor × 0.70 lawn = 1.65T from public supply.',
    'Florida lawns': 'Florida\'s warm, humid climate drives year-round lawn irrigation. <a href="https://edis.ifas.ufl.edu/publication/AE220">High water tables and sandy soils</a> increase irrigation needs. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> Proportional estimate from national lawn total based on <a href="https://www.epa.gov/watersense/how-we-use-water">state outdoor water use</a>.',
    'California lawns': 'California lawns are a major <a href="https://www.ppic.org/publication/water-use-in-california/">water policy issue</a> — <a href="https://www.waterboards.ca.gov/water_issues/programs/conservation_portal/">outdoor water use restrictions</a> have been a key drought response tool. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> Proportional estimate from national lawn total based on <a href="https://www.epa.gov/watersense/how-we-use-water">state outdoor water use</a>.',
    'Texas lawns': 'Texas lawn irrigation peaks in the summer heat, drawing heavily from municipal systems in <a href="https://www.twdb.texas.gov/waterplanning/">metro areas</a>. This is an <strong>illustrative modeled breakout</strong>.<hr><strong>Method:</strong> Proportional estimate from national lawn total based on <a href="https://www.epa.gov/watersense/how-we-use-water">state outdoor water use</a>.',
    'All US golf courses (2024)': 'The US has about <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">15,200 golf facilities</a>. Water sources: <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">~45% wells, ~25% surface water, ~21% reclaimed/recycled, ~9% municipal</a>. Golf course water use has <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">dropped ~31% since 2005</a> due to conservation efforts.<hr><strong>Method:</strong> <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">GCSAA Phase 4 reports 1.63 million acre-feet</a> total = 531B gal. <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">~9% from municipal supply</a> = 48B gal in potable mode. Pumping: ~1.4 TWh × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'Arizona golf courses': 'Arizona golf courses use the <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">Southwest regional irrigation rate of 3.3 ac-ft/acre</a> — about 3× the national median — due to extreme heat and low humidity.<hr><strong>Method:</strong> Midpoint estimate using SW regional rate from <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">GCSAA Phase 4</a>. <a href="https://www.gcsaa.org/docs/default-source/what-we-do/gcep-phase-4-water-report.pdf">~1B gal from municipal supply</a> in potable mode.',

    'New York City (consumptive est.)': 'NYC\'s water is <a href="https://www.nyc.gov/site/dep/water/drinking-water.page">gravity-fed from the Catskill and Delaware watersheds</a> — one of the most efficient municipal systems in the US. <a href="https://www.census.gov/quickfacts/newyorkcitynewyork">Extremely dense housing</a> means minimal outdoor/landscape use. About <a href="https://pubs.usgs.gov/publication/sir20145176">88% of delivered water returns</a> via the combined sewer system.<hr><strong>Method:</strong> <a href="https://www.nyc.gov/site/dep/water/drinking-water.page">364B gal delivered</a> × <a href="https://pubs.usgs.gov/publication/sir20145176">~12% consumed</a> = ~45B gal. Consumption ratio from <a href="https://pubs.usgs.gov/publication/sir20145176">USGS NE Illinois study</a> (13%) and <a href="https://dnr.illinois.gov/waterresources/lakemichiganwaterallocation.html">Illinois official Lake Michigan rate</a> (10%). Electricity: ~1.5 kWh/1000 gal × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'Chicago metro (consumptive est.)': 'Chicago draws from <a href="https://www.chicago.gov/city/en/depts/water.html">Lake Michigan</a> with relatively short distribution distances. Cold climate and moderate density mean modest outdoor water use. The <a href="https://pubs.usgs.gov/publication/sir20145176">USGS field-measured 13% consumption rate</a> in a suburban Chicago sewershed is one of the strongest city-level estimates available.<hr><strong>Method:</strong> 274B gal delivered × <a href="https://pubs.usgs.gov/publication/sir20145176">~12% consumed</a> = ~33B gal. <a href="https://pubs.usgs.gov/publication/sir20145176">USGS mass-balance study</a> measured 13% at Elk Grove Village. <a href="https://dnr.illinois.gov/waterresources/lakemichiganwaterallocation.html">Illinois DNR uses 10%</a> for Lake Michigan diversion accounting.',
    'Los Angeles (consumptive est.)': 'LA imports water over long distances from the <a href="https://www.usbr.gov/lc/region/g4000/4200Rpts/DecreeRpt/2023/2023.pdf">Colorado River</a> and <a href="https://www.ladwp.com/who-we-are/water-system/sources-supply/la-aqueduct">Sierra Nevada</a>, making its water system unusually energy-intensive (~5 kWh/1000 gal). <a href="https://www.sciencedirect.com/science/article/abs/pii/S0169204614000917">UCLA research shows 54% of single-family residential use goes outdoors</a>, though the city-wide average is lower after including apartments and commercial use.<hr><strong>Method:</strong> <a href="https://www.ladwp.com/who-we-are/water-system">146B gal delivered</a> × ~35% consumed = ~51B gal. Outdoor fraction drives consumption: nearly all outdoor water is consumed via evapotranspiration; <a href="https://pubs.usgs.gov/publication/sir20145176">~85–90% of indoor water returns via sewer</a>.',
    'Phoenix (consumptive est.)': 'Phoenix has among the highest outdoor water use fractions of any US city. The <a href="https://www.cap-az.com/">Central Arizona Project</a> pumps Colorado River water uphill ~2,900 feet to reach Phoenix. In extreme summer heat, <a href="https://www.azwater.gov/sites/default/files/2024-09/2019-3073_CityofPhoenix_MultiCityWaterUseStudy_ExecutiveReport.pdf">60–70% of residential water goes to landscape irrigation</a>, and nearly all of it evaporates.<hr><strong>Method:</strong> <a href="https://www.phoenix.gov/water">95.5B gal delivered</a> × ~50% consumed = ~48B gal. <a href="https://www.azwater.gov/sites/default/files/2024-09/2019-3073_CityofPhoenix_MultiCityWaterUseStudy_ExecutiveReport.pdf">ADWR Multi-City Water Use Study</a>: 57–70% of residential use is outdoor.',
    'Las Vegas metro (SNWA, consumptive)': '<a href="https://www.snwa.com/">Las Vegas</a> has the most sophisticated water accounting of any US city. Every gallon used indoors flows through the sewer, gets treated, and is <a href="https://www.snwa.com/water-resources/where-water-comes-from/index.html">returned to Lake Mead</a> — earning a return-flow credit against <a href="https://www.usbr.gov/lc/region/g4000/4200Rpts/DecreeRpt/2023/2023.pdf">Nevada\'s Colorado River allocation</a>. Only outdoor water is truly consumed. <a href="https://www.snwa.com/water-resources/drought-and-shortage/index.html">SNWA has cut per-capita consumption by 47% since 2002</a>.<hr><strong>Method:</strong> <a href="https://www.snwa.com/water-resources/where-water-comes-from/index.html">SNWA 2024: 212,400 acre-feet</a> consumptive use (directly reported net of return-flow credits) = ~69B gal.',

    'Total US freshwater withdrawals': 'All freshwater removed from surface and groundwater sources across all sectors: <a href="https://pubs.usgs.gov/publication/cir1441">thermoelectric power</a> (largest by volume), <a href="https://www.ers.usda.gov/topics/farm-practices-management/irrigation-water-use/">irrigation</a>, <a href="https://pubs.usgs.gov/publication/pp1894D">public supply</a>, industrial, mining, and other. Most withdrawn water is returned — <a href="https://pubs.usgs.gov/publication/cir1441">withdrawals far exceed consumptive use</a>.<hr><strong>Method:</strong> <a href="https://pubs.usgs.gov/publication/cir1441">USGS Circular 1441</a>: 281 Bgal/day in 2015 = ~102.6T gal/yr. Pumping electricity: ~70 TWh × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
    'Total US public water supply': 'All water delivered by municipal and public water systems, serving about <a href="https://pubs.usgs.gov/publication/pp1894D">87% of the US population</a>. Includes residential, commercial, institutional, and industrial use from public supply. Almost all of this is <a href="https://www.epa.gov/sdwa">treated potable water</a>.<hr><strong>Method:</strong> <a href="https://pubs.usgs.gov/publication/pp1894D">USGS PP 1894D (2020)</a>: ~13.1T gal/yr. Pumping/treatment electricity: <a href="https://www.epri.com/research/products/000000003002001433">~39 TWh (EPRI 2013)</a> × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a>.',
  };

  var tooltipEl = document.getElementById('wv-tooltip');
  var tipTimer = null;

  var ELEC_EXPLAINER = '<hr><strong style="color:var(--accent, #8b3a3a)">+ electricity water</strong><br>Generating electricity requires cooling at thermoelectric power plants, which evaporates water from rivers and lakes. This adds the water consumed at those plants to generate the electricity this operation uses. Calculated as total electricity (TWh) × <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf">0.47 gal/kWh</a> (NREL thermoelectric-only factor, excluding <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water">hydro reservoir evaporation</a>). This water is non-potable freshwater drawn directly from rivers and lakes — not from public water supply systems.';

  var tipOpen = false;

  function showTip(item, x, y) {
    var html = TIPS[item.baseName];
    if (!html) return;
    var displayName = item.elecOn ? item.baseName + ' + electricity' : item.baseName;
    var elecHtml = item.elecOn ? ELEC_EXPLAINER : '';
    tooltipEl.innerHTML = '<button class="wv-tip-close" style="position:absolute;top:6px;right:6px;background:none;border:none;cursor:pointer;color:var(--text-secondary);font-size:1.1rem;line-height:1;padding:2px 5px;opacity:0.4">&times;</button><strong style="font-size:0.78rem;display:block;margin-bottom:4px;padding-right:20px">' + displayName + '</strong>' + html + elecHtml;
    tooltipEl.querySelector('.wv-tip-close').addEventListener('click', function(e) { e.stopPropagation(); hideTip(); });
    tooltipEl.style.display = 'block';
    tipOpen = true;

    var vw = window.innerWidth;
    var vh = window.innerHeight;

    // Mobile: pin to bottom
    if (vw < 560) {
      tooltipEl.style.left = '8px';
      tooltipEl.style.right = '8px';
      tooltipEl.style.width = 'auto';
      tooltipEl.style.bottom = '8px';
      tooltipEl.style.top = 'auto';
      tooltipEl.style.maxHeight = '40vh';
    } else {
      // Desktop: position at click point
      tooltipEl.style.right = '';
      tooltipEl.style.width = '';
      tooltipEl.style.bottom = '';
      tooltipEl.style.maxHeight = 'calc(100vh - 40px)';
      // Show first, measure, then position
      var w = tooltipEl.offsetWidth;
      var h = tooltipEl.offsetHeight;
      var left = x;
      var top = y;
      if (left + w > vw - 12) left = vw - w - 12;
      if (left < 12) left = 12;
      if (top + h > vh - 12) top = vh - h - 12;
      if (top < 12) top = 12;
      tooltipEl.style.left = left + 'px';
      tooltipEl.style.top = top + 'px';
    }
  }

  function hideTip() {
    tooltipEl.style.display = 'none';
    tipOpen = false;
  }

  // Click to show tooltip on squares
  squaresArea.addEventListener('click', function(e) {
    // Don't interfere with links inside tooltip
    if (e.target.closest('.wv-tooltip')) return;
    var sqEl = e.target.closest('.wv-sq-item');
    if (!sqEl) return;
    var idx = parseInt(sqEl.dataset.sqIdx);
    var it = items[idx];
    if (it) {
      e.stopPropagation();
      showTip(it, e.clientX, e.clientY);
    }
  });

  // Click to show tooltip on bars
  barsArea.addEventListener('click', function(e) {
    if (e.target.closest('.wv-tooltip')) return;
    var barRow = e.target.closest('.wv-bar-row');
    if (!barRow) return;
    var idx = parseInt(barRow.dataset.idx);
    var it = items[idx];
    if (it) {
      e.stopPropagation();
      showTip(it, e.clientX, e.clientY);
    }
  });

  // Click outside tooltip to dismiss
  document.addEventListener('click', function(e) {
    if (!tipOpen) return;
    // If clicking inside the tooltip (including links), keep it open
    if (e.target.closest('.wv-tooltip')) return;
    // If clicking a square or bar, the handlers above will open a new tip
    if (e.target.closest('.wv-sq-item') || e.target.closest('.wv-bar-row')) return;
    hideTip();
  });

  // Escape to dismiss
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && tipOpen) hideTip();
  });

  // Remove default title tooltips from squares (we handle it now)
  var observer = new MutationObserver(function() {
    squaresArea.querySelectorAll('.wv-sq-item[title]').forEach(function(el) {
      el.removeAttribute('title');
    });
  });
  observer.observe(squaresArea, { childList: true, subtree: true, attributes: true, attributeFilter: ['title'] });

  render();

})();
</script>
</Base>
