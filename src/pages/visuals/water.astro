<script is:inline>
(function() {
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }

  var barsArea = document.getElementById('wv-bars');
  var squaresArea = document.getElementById('wv-squares');
  var countEl = document.getElementById('wv-count');
  var currentView = 'bars';
  var items = [];

  // View toggle
  document.querySelectorAll('.wv-view-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var view = btn.dataset.view;
      if (view === currentView) return;
      currentView = view;
      document.querySelectorAll('.wv-view-btn').forEach(function(b) {
        b.dataset.active = b.dataset.view === view ? 'true' : 'false';
      });
      barsArea.style.display = view === 'bars' ? '' : 'none';
      squaresArea.style.display = view === 'squares' ? '' : 'none';
      render();
    });
  });

  // Init all items from DOM
  document.querySelectorAll('.wv-toggle-row').forEach(function(row) {
    var idx = parseInt(row.dataset.idx);
    var galBase = parseFloat(row.dataset.galBase || 0);
    var galElec = parseFloat(row.dataset.galElec || 0);
    var galIndustry = parseFloat(row.dataset.galIndustry || 0);
    var gallons = galIndustry > 0 ? galIndustry : galBase;
    var baseName = row.querySelector('.wv-row-name').textContent;

    // Find color from category
    var cat = row.closest('.wv-cat');
    var catName = cat ? cat.dataset.cat : '';
    var color = '#6B6B60';

    // Use the item's data color from the server-rendered data
    // We encode it in the frontmatter so grab it from the row
    // Actually, we need to figure out colors. Let's encode as data attributes.
    // For now, use category-based colors
    var catColors = {
      dc: '#4A90D9',
      industry: '#D97A4A',
      city: '#5BA4CF',
      farm: '#4CAF78',
      turf: '#6BBF84',
      national: '#8B8FA8'
    };
    color = catColors[catName] || color;

    items[idx] = {
      idx: idx,
      gallons: gallons,
      on: row.dataset.on === 'true',
      color: color,
      name: baseName,
      sub: fG(gallons),
      baseName: baseName,
      elecOn: false,
      galBase: galBase,
      galElec: galElec
    };

    row.addEventListener('click', function(e) {
      if (e.target.closest('.wv-elec-chip')) return;
      items[idx].on = !items[idx].on;
      row.dataset.on = items[idx].on ? 'true' : 'false';
      render();
    });
  });

  // Electricity chip handlers
  document.querySelectorAll('.wv-elec-chip').forEach(function(chip) {
    var parentIdx = parseInt(chip.dataset.parentIdx);
    var parentRow = chip.closest('.wv-toggle-row');

    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      if (!parentRow || parentRow.dataset.on !== 'true') return;

      var nowChecked = chip.dataset.elecOn !== 'true';
      chip.dataset.elecOn = nowChecked ? 'true' : 'false';

      var it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.sub = fG(it.gallons);
      var valEl = parentRow.querySelector('.wv-row-val');
      if (valEl) valEl.textContent = it.sub;
      render();
    });
  });

  // Category header toggle (expand/collapse)
  document.querySelectorAll('.wv-cat-head').forEach(function(head) {
    head.addEventListener('click', function(e) {
      if (e.target.closest('.wv-cat-toggle')) return;
      var cat = head.closest('.wv-cat');
      var list = cat.querySelector('.wv-cat-list');
      var chevron = head.querySelector('.wv-cat-chevron');
      var isOpen = list.dataset.visible === 'true';
      list.dataset.visible = isOpen ? 'false' : 'true';
      head.dataset.open = isOpen ? 'false' : 'true';
      chevron.innerHTML = isOpen ? '&#9656;' : '&#9662;';
    });
  });

  // All / None category toggles
  document.querySelectorAll('.wv-cat-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var cat = btn.closest('.wv-cat');
      if (!cat) return;
      var action = btn.dataset.action;
      var newOn = action === 'all';
      cat.querySelectorAll('.wv-toggle-row').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) {
          items[idx].on = newOn;
          row.dataset.on = newOn ? 'true' : 'false';
        }
      });
      render();
    });
  });

  function render() {
    var active = [];
    for (var i = 0; i < items.length; i++) {
      if (items[i] && items[i].on) active.push(items[i]);
    }

    // Update count
    if (countEl) {
      countEl.textContent = active.length + ' item' + (active.length === 1 ? '' : 's');
    }

    if (active.length === 0) {
      barsArea.innerHTML = '<div class="wv-bars-empty">Select items to compare</div>';
      squaresArea.innerHTML = '<div class="wv-bars-empty">Select items to compare</div>';
      return;
    }

    // Sort largest to smallest
    active.sort(function(a, b) { return b.gallons - a.gallons; });
    var maxG = active[0].gallons;

    // ── Bar view ──
    if (currentView === 'bars') {
      var html = '';
      for (var j = 0; j < active.length; j++) {
        var it = active[j];
        var pct = maxG > 0 ? (it.gallons / maxG) * 100 : 0;
        var isProj = it.name.indexOf('2030') >= 0;
        var elecTag = it.elecOn ? ' +elec' : '';
        var prefix = isProj ? '~' : '';
        var val = prefix + it.sub + elecTag;
        html += '<div class="wv-bar-row">';
        html += '<span class="wv-bar-name" title="' + it.name + '">' + it.name + '</span>';
        html += '<div class="wv-bar-track"><div class="wv-bar-fill" style="width:' + pct.toFixed(1) + '%;background:' + it.color + '"></div></div>';
        html += '<span class="wv-bar-val">' + val + '</span>';
        html += '</div>';
      }
      barsArea.innerHTML = html;
    }

    // ── Square view ──
    if (currentView === 'squares') {
      // Use the full panel area. Max square fills most of the space.
      var panelW = squaresArea.clientWidth - 32; // padding
      var panelH = squaresArea.clientHeight - 32;
      if (panelW < 100) panelW = 600;
      if (panelH < 100) panelH = 500;

      // Max square side = 70% of the smaller panel dimension
      var maxSide = Math.round(Math.min(panelW, panelH) * 0.7);
      // No minimum — let tiny items be truly tiny (even 1px)
      var labelH = 32; // space for label below each square

      // Compute sizes
      var sized = [];
      for (var k = 0; k < active.length; k++) {
        var sq = active[k];
        var side = Math.max(2, Math.round(maxSide * Math.sqrt(sq.gallons / maxG)));
        var isP = sq.name.indexOf('2030') >= 0;
        var eTag = sq.elecOn ? ' +elec' : '';
        var pre = isP ? '~' : '';
        var v = pre + sq.sub + eTag;
        sized.push({ sq: sq, side: side, val: v });
      }

      // Measure label widths using a hidden canvas
      var measureCanvas = document.createElement('canvas');
      var ctx = measureCanvas.getContext('2d');
      ctx.font = '500 11px sans-serif';

      // Shelf-packing: place squares left-to-right, wrapping to new rows
      var placed = [];
      var shelfX = 0, shelfY = 0, shelfH = 0;
      var gap = 16;
      for (var s = 0; s < sized.length; s++) {
        // Item width = max of square width and label text width
        var textW = ctx.measureText(sized[s].sq.name).width + 8;
        var itemW = Math.max(sized[s].side, textW, 40);
        var itemH = sized[s].side + labelH;
        // Does it fit on current shelf?
        if (shelfX + itemW > panelW && shelfX > 0) {
          shelfY += shelfH + gap;
          shelfX = 0;
          shelfH = 0;
        }
        placed.push({ x: shelfX, y: shelfY, w: itemW, h: itemH, data: sized[s] });
        shelfH = Math.max(shelfH, itemH);
        shelfX += itemW + gap;
      }

      // Render as absolutely positioned divs
      var totalH = shelfY + shelfH + 16;
      var sqHtml = '<div style="position:relative;width:100%;height:' + totalH + 'px">';
      for (var p = 0; p < placed.length; p++) {
        var pl = placed[p];
        var d = pl.data;
        sqHtml += '<div class="wv-sq-item" style="position:absolute;left:' + pl.x + 'px;top:' + pl.y + 'px;width:' + pl.w + 'px">';
        sqHtml += '<div class="wv-sq-box" style="width:' + d.side + 'px;height:' + d.side + 'px;background:' + d.sq.color + ';opacity:0.18;border:1.5px solid ' + d.sq.color + '"></div>';
        sqHtml += '<div class="wv-sq-label">';
        sqHtml += '<span class="wv-sq-name" title="' + d.sq.name + '">' + d.sq.name + '</span>';
        sqHtml += '<span class="wv-sq-val">' + d.val + '</span>';
        sqHtml += '</div></div>';
      }
      sqHtml += '</div>';
      squaresArea.innerHTML = sqHtml;
    }
  }

  render();
})();
</script>
</Base>
