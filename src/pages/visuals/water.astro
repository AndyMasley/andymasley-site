<script is:inline>
(function() {
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }

  const chart = document.getElementById('chart');
  const svg = document.getElementById('svg');
  const cur = new Map();
  const tgt = new Map();
  let raf = null;

  const items = [];

  // Init all items from DOM
  document.querySelectorAll('.w-item').forEach(row => {
    const idx = parseInt(row.dataset.idx);
    const dot = row.querySelector('.w-item-dot');
    const baseName = row.querySelector('.w-item-name').textContent;
    const galBase = parseFloat(row.dataset.galBase || 0);
    const galElec = parseFloat(row.dataset.galElec || 0);
    const galIndustry = parseFloat(row.dataset.galIndustry || 0);

    const gallons = galIndustry > 0 ? galIndustry : galBase;

    items[idx] = {
      idx, gallons, on: row.dataset.on === '1',
      color: dot.style.backgroundColor,
      name: baseName,
      sub: row.querySelector('.w-item-val').textContent,
      baseName, elecOn: false, galBase, galElec
    };

    row.addEventListener('click', function(e) {
      if (e.target.closest('.w-elec-chip')) return;
      items[idx].on = !items[idx].on;
      row.dataset.on = items[idx].on ? '1' : '0';
      render();
    });
  });

  // Electricity sub-checkboxes
  document.querySelectorAll('.w-sub').forEach(sub => {
    sub.dataset.checked = '0';
    const parentIdx = parseInt(sub.dataset.parentIdx);
    const parentRow = document.querySelector(`.w-item[data-idx="${parentIdx}"]`);

    sub.addEventListener('click', (e) => {
      e.stopPropagation();
      const nowChecked = sub.dataset.checked !== '1';
      sub.dataset.checked = nowChecked ? '1' : '0';
      parentRow.dataset.elec = nowChecked ? '1' : '0';

      const it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.sub = fG(it.gallons);
      const valEl = parentRow.querySelector('.w-item-val');
      if (valEl) valEl.textContent = it.sub;
      render();
    });
  });

  // ── Animation ──────────────────────────────────

  function render() {
    const W = chart.clientWidth, H = chart.clientHeight;
    const pad = 24;
    const maxSide = Math.min(H - pad * 2, W - 200 - pad);
    const active = items.filter(d => d && d.on);
    const maxG = active.reduce((m, d) => Math.max(m, d.gallons), 0);

    tgt.clear();
    if (maxG > 0) active.forEach(d => tgt.set(d.idx, Math.max(2, maxSide * Math.sqrt(d.gallons / maxG))));
    cur.forEach((_, k) => { if (!tgt.has(k)) tgt.set(k, 0); });
    tgt.forEach((_, k) => { if (!cur.has(k)) cur.set(k, 0); });
    if (!raf) raf = requestAnimationFrame(step);

    updateStatus();
  }

  function step() {
    const W = chart.clientWidth, H = chart.clientHeight, pad = 24;
    let moving = false;
    tgt.forEach((t, k) => {
      const c = cur.get(k) ?? 0, d = t - c;
      if (Math.abs(d) < 0.4) { cur.set(k, t); if (t === 0) cur.delete(k); }
      else { cur.set(k, c + d * 0.14); moving = true; }
    });
    draw(W, H, pad);
    raf = moving ? requestAnimationFrame(step) : null;
  }

  function draw(W, H, pad) {
    const vis = [];
    cur.forEach((s, i) => { if (s > 0.5) vis.push({ idx: i, s }); });
    vis.sort((a, b) => b.s - a.s);

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    if (!vis.length) { svg.innerHTML = `<text x="${W/2}" y="${H/2}" text-anchor="middle" font-family="var(--font-body)" font-size="13" fill="var(--dim)">Select items to compare</text>`; return; }

    const ox = pad, oy = H - pad, p = [];

    vis.forEach(v => {
      const it = items[v.idx], x = ox, y = oy - v.s;
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="${it.color}" fill-opacity=".12"/>`);
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="none" stroke="${it.color}" stroke-width="1.5" stroke-opacity=".55"/>`);
    });

    // ── Two-tier label system ──
    // Tier 1: boxes > 60px tall → right-column label at box top-edge y
    // Tier 2: boxes ≤ 60px → collected into compact cluster panel
    var TIER_THRESH = 60;
    var labelH = 28, labelGap = 6;
    var labelCol = W - 8; // right-align labels to this x
    var tier1 = [], tier2 = [];

    vis.forEach(function(v) {
      var it = items[v.idx];
      var isProj = (it.name || '').indexOf('2030') >= 0;
      var elecTag = it.elecOn ? ' +elec' : '';
      var prefix = isProj ? '~' : '';
      var valText = prefix + it.sub + elecTag;
      var entry = { idx: v.idx, s: v.s, boxRight: ox + v.s, boxTop: oy - v.s, color: it.color, name: it.name, val: valText, nameOp: isProj ? 0.6 : 0.85 };
      if (v.s > TIER_THRESH) tier1.push(entry);
      else tier2.push(entry);
    });

    // ── Tier 1: collision-resolved right-column labels ──
    tier1.sort(function(a, b) { return a.boxTop - b.boxTop; });

    // Assign y positions greedily
    for (var i = 0; i < tier1.length; i++) {
      tier1[i].labelY = tier1[i].boxTop;
      if (i > 0) {
        var minY = tier1[i - 1].labelY + labelH + labelGap;
        if (tier1[i].labelY < minY) tier1[i].labelY = minY;
      }
      if (tier1[i].labelY < pad) tier1[i].labelY = pad;
    }
    // If overflow bottom, compress
    if (tier1.length > 1) {
      var lastBot = tier1[tier1.length - 1].labelY + labelH;
      if (lastBot > oy) {
        var avail = oy - pad - labelH;
        var gap = Math.max(labelH + 2, avail / (tier1.length - 1));
        for (var j = 0; j < tier1.length; j++) {
          tier1[j].labelY = pad + j * gap;
        }
      }
    }
    // Demote to tier2 if pushed >30px from ideal
    var demoted = [];
    tier1 = tier1.filter(function(t) {
      if (Math.abs(t.labelY - t.boxTop) > 30 && t.labelY + labelH > oy) {
        tier2.push(t);
        return false;
      }
      return true;
    });

    // Render Tier 1 leaders + labels
    tier1.forEach(function(t) {
      var ly = t.labelY;
      var lcy = ly + labelH / 2;
      var nudged = Math.abs(ly - t.boxTop) > 4;
      // Leader: from box right edge to label column
      if (nudged) {
        // Bent leader: horizontal from box, then vertical, then horizontal to label
        var midX = Math.min(t.boxRight + 12, labelCol - 200);
        p.push('<path d="M' + t.boxRight + ',' + t.boxTop + ' L' + midX + ',' + t.boxTop + ' L' + midX + ',' + lcy + ' L' + (labelCol - 196) + ',' + lcy + '" fill="none" stroke="' + t.color + '" stroke-width="0.5" opacity="0.25"/>');
      } else {
        p.push('<line x1="' + t.boxRight + '" y1="' + t.boxTop + '" x2="' + (labelCol - 196) + '" y2="' + lcy + '" stroke="' + t.color + '" stroke-width="0.5" opacity="0.25"/>');
      }
      p.push('<circle cx="' + t.boxRight + '" cy="' + t.boxTop + '" r="1.5" fill="' + t.color + '" opacity="0.4"/>');
      // Label background + text (right-aligned to labelCol)
      var lw = 192;
      var lx = labelCol - lw;
      p.push('<rect x="' + lx + '" y="' + ly + '" width="' + lw + '" height="' + labelH + '" rx="2" fill="rgba(10,14,20,0.75)"/>');
      p.push('<text x="' + (lx + 5) + '" y="' + (ly + 12) + '" font-family="IBM Plex Sans,sans-serif" font-size="11" font-weight="500" fill="rgba(255,255,255,' + t.nameOp + ')">' + t.name + '</text>');
      p.push('<text x="' + (lx + 5) + '" y="' + (ly + 24) + '" font-family="IBM Plex Mono,monospace" font-size="9.5" fill="' + t.color + '" fill-opacity="0.75">' + t.val + '</text>');
    });

    // ── Tier 2: compact cluster panel ──
    if (tier2.length > 0) {
      var rowH = 15, clusterPad = 8;
      var clusterH = tier2.length * rowH + clusterPad * 2;
      var clusterW = 210;
      // Position: upper-right, above tier1 labels if any
      var clusterY = pad;
      var clusterX = W - clusterW - 8;
      // Leader from cluster to small-box region (bottom-left corner area)
      var smallCenterX = ox + 15;
      var smallCenterY = oy - 15;
      p.push('<line x1="' + clusterX + '" y1="' + (clusterY + clusterH / 2) + '" x2="' + smallCenterX + '" y2="' + smallCenterY + '" stroke="rgba(255,255,255,0.1)" stroke-width="0.5" stroke-dasharray="3,3"/>');
      // Cluster background
      p.push('<rect x="' + clusterX + '" y="' + clusterY + '" width="' + clusterW + '" height="' + clusterH + '" rx="3" fill="rgba(10,14,20,0.85)"/>');
      p.push('<line x1="' + clusterX + '" y1="' + (clusterY + 1) + '" x2="' + clusterX + '" y2="' + (clusterY + clusterH - 1) + '" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>');
      // Rows
      tier2.forEach(function(t, i) {
        var ry = clusterY + clusterPad + i * rowH;
        // Color dot
        p.push('<rect x="' + (clusterX + 8) + '" y="' + (ry + 2) + '" width="6" height="6" rx="1" fill="' + t.color + '" fill-opacity="0.7"/>');
        // Name · value
        var isProj = t.name.indexOf('2030') >= 0;
        var nameOp = isProj ? 0.5 : 0.7;
        p.push('<text x="' + (clusterX + 20) + '" y="' + (ry + 10) + '" font-family="IBM Plex Sans,sans-serif" font-size="9.5" fill="rgba(255,255,255,' + nameOp + ')">' + t.name + '</text>');
        p.push('<text x="' + (clusterX + clusterW - 8) + '" y="' + (ry + 10) + '" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="9" fill="' + t.color + '" fill-opacity="0.6">' + t.val + '</text>');
      });
    }

    svg.innerHTML = p.join('\n');
  }

  render();

  let rt;
  new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { cur.clear(); render(); }, 60); }).observe(chart);

  // ── Status bar counter ──
  var statusEl = document.getElementById('w-status');
  function updateStatus() {
    var count = 0;
    document.querySelectorAll('.w-item[data-on="1"]').forEach(function() { count++; });
    if (statusEl) {
      statusEl.textContent = count > 0
        ? 'COMPARING ' + count + ' ITEM' + (count === 1 ? '' : 'S')
        : 'SELECT ITEMS TO COMPARE';
    }
  }
  updateStatus();

  // ── All / None category toggles ──
  document.querySelectorAll('.w-cat-toggle').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var cat = btn.closest('.w-cat');
      if (!cat) return;
      var action = btn.dataset.action;
      var newOn = action === 'all' ? true : false;
      cat.querySelectorAll('.w-item').forEach(function(row) {
        var idx = parseInt(row.dataset.idx);
        if (items[idx]) {
          items[idx].on = newOn;
          row.dataset.on = newOn ? '1' : '0';
        }
      });
      render();
    });
  });

  // ── Electricity chip (replaces sub-checkbox visually) ──
  document.querySelectorAll('.w-elec-chip').forEach(function(chip) {
    var parentIdx = parseInt(chip.dataset.parentIdx);
    var parentRow = chip.closest('.w-item');
    var sub = document.querySelector('.w-sub[data-parent-idx="' + parentIdx + '"]');

    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      if (!parentRow || parentRow.dataset.on !== '1') return;

      // Toggle via the existing sub logic
      var nowChecked = chip.dataset.elecOn !== '1';
      chip.dataset.elecOn = nowChecked ? '1' : '0';

      // Keep sub in sync (the existing handler reads from sub)
      if (sub) {
        sub.dataset.checked = nowChecked ? '1' : '0';
      }
      parentRow.dataset.elec = nowChecked ? '1' : '0';

      var it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.sub = fG(it.gallons);
      var valEl = parentRow.querySelector('.w-item-val');
      if (valEl) valEl.textContent = it.sub;
      render();
    });
  });
})();
</script>
