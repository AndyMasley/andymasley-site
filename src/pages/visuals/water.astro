---
import Base from '@/layouts/Base.astro';

const GAL_CORN = 650_000;
const GAL_ALFALFA = 1_500_000;
const GAL_GOLF = 1_300_000;

function fA(a: number) {
  return a >= 1e6 ? (a/1e6).toFixed(1)+'M acres' : a >= 1e3 ? Math.round(a).toLocaleString()+' acres' : a.toFixed(0)+' acres';
}
function fG(g: number) {
  return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr';
}

const dcItems = [
  // ChatGPT: Altman's 0.000085 gal + 0.34 Wh/query × 1B queries/day × 365
  // Direct: 31M gal/yr. Elec: 124 GWh × 0.5 gal/kWh = 62M. Total w/ elec: 93M.
  { name: 'ChatGPT inference', base: 31e6, elec: 93e6, color: '#3ba0d8', on: false },
  // Training adds ~2M direct (GPT-4 ≈ 1.85M gal) + ~25M elec (est. 50 GWh × 0.5)
  { name: 'ChatGPT w/ training', base: 33e6, elec: 118e6, color: '#2a84b8', on: false },
  // Microsoft FY2023: 7.8M m³ = 2.06B gal. Elec: ~24 TWh × 0.5 = 12B. Total: 14.06B.
  { name: 'Microsoft', base: 2.06e9, elec: 14e9, color: '#6a9dc8', on: true },
  // Google 2024: 6B gal direct. Elec: ~25.3 TWh × 0.5 = 12.65B. Total: 18.65B.
  { name: 'Google', base: 6e9, elec: 18.7e9, color: '#5088b8', on: true },
  // LBNL 2024: 17B direct. Elec: 176 TWh × 0.5 = 88B. Total: 105B.
  { name: 'All US data centers', base: 17e9, elec: 105e9, color: '#7b72ab', on: true },
];

const surfaceItems = [
  { name: 'Manhattan', acres: 14611, color: '#c4a474', on: false },
  { name: 'San Francisco', acres: 29997, color: '#b8976a', on: false },
  { name: 'Washington, D.C.', acres: 39072, color: '#ad8b60', on: false },
  { name: 'Los Angeles', acres: 299949, color: '#a28058', on: false },
  { name: 'Rhode Island', acres: 661639, color: '#8f7350', on: false },
  { name: 'New Jersey', acres: 4706701, color: '#7d6648', on: false },
];

// Per-unit crop data: different top-4 states for each crop
const cropDataAll = {
  corn: [
    { name: 'Texas', acres: 463507, color: '#82c06e', on: false },
    { name: 'Colorado', acres: 470075, color: '#76b562', on: false },
    { name: 'Kansas', acres: 1181420, color: '#6aaa58', on: false },
    { name: 'Nebraska', acres: 4554560, color: '#5e9c50', on: false },
    { name: 'All US irrigated', acres: 11000000, color: '#4a8840', on: true },
  ],
  alfalfa: [
    { name: 'Colorado', acres: 564610, color: '#82c06e', on: false },
    { name: 'Montana', acres: 664411, color: '#76b562', on: false },
    { name: 'California', acres: 868823, color: '#6aaa58', on: false },
    { name: 'Idaho', acres: 870101, color: '#5e9c50', on: false },
    { name: 'All US irrigated', acres: 6000000, color: '#4a8840', on: true },
  ],
  golf: [
    { name: 'New York', acres: 62200, color: '#82c06e', on: false },
    { name: 'Texas', acres: 63300, color: '#76b562', on: false },
    { name: 'California', acres: 68600, color: '#6aaa58', on: false },
    { name: 'Florida', acres: 81400, color: '#5e9c50', on: false },
    { name: 'All US irrigated', acres: 1198000, color: '#4a8840', on: true },
  ],
};

let idx = 0;
const dcFlat = dcItems.map(d => ({ idx: idx++, ...d,
  subBase: fA(d.base/GAL_CORN) + ' · ' + fG(d.base),
  subElec: fA(d.elec/GAL_CORN) + ' · ' + fG(d.elec),
}));
const surfFlat = surfaceItems.map(d => ({ idx: idx++, ...d, sub: fA(d.acres) }));
const cropStartIdx = idx;
const defaultCrop = cropDataAll.corn;
const cropFlat = defaultCrop.map(d => ({ idx: idx++, ...d,
  sub: fA(d.acres) + ' · ' + fG(d.acres * GAL_CORN),
}));
---

<Base title="AI Water Usage" description="How much water does AI use, measured in irrigated corn?">
  <div class="w">
    <div class="w-intro">
      <h1>How thirsty is AI?</h1>
      <p class="w-deck">Water usage measured in acres of irrigated farmland</p>
      <p class="w-lede">Each square is sized by area to its acreage equivalent — how much irrigated farmland would use the same amount of water. Toggle items to compare, and change the crop to see how the unit shifts.</p>
    </div>

    <div class="w-section-header">
      <h2>Total water</h2>
      <p class="w-section-desc">All water consumed — cooling towers, process water, and upstream electricity generation. This is the broadest measure of water impact.</p>
    </div>

    <div class="w-viz">
      <div class="w-panel">
        <details class="w-cat" open>
          <summary class="w-cat-head">
            <div class="w-cat-pip" style="background:#5b8db8"></div>
            <span class="w-cat-name">Data centers</span>
            <span class="w-cat-arrow"></span>
          </summary>
          <div class="w-cat-list">
            {dcFlat.map(d => (
              <div class="w-dc-group">
                <div class="w-item" data-idx={d.idx} data-on={d.on ? '1' : '0'}
                  data-gal-base={d.base} data-gal-elec={d.elec} data-elec="0">
                  <div class="w-item-dot" style={`background:${d.color}`}></div>
                  <div class="w-item-text">
                    <span class="w-item-name">{d.name}</span>
                    <span class="w-item-val">{d.subBase}</span>
                  </div>
                </div>
                <div class="w-sub" data-parent-idx={d.idx}>
                  <span class="w-sub-check"></span>
                  <span class="w-sub-label">+ water cost of electricity</span>
                </div>
              </div>
            ))}
          </div>
        </details>

        <details class="w-cat" open>
          <summary class="w-cat-head">
            <div class="w-cat-pip" style="background:#b89868"></div>
            <span class="w-cat-name">Surface area</span>
            <span class="w-cat-arrow"></span>
          </summary>
          <div class="w-cat-list">
            {surfFlat.map(d => (
              <div class="w-item" data-idx={d.idx} data-on={d.on ? '1' : '0'} data-fixed-acres={d.acres}>
                <div class="w-item-dot" style={`background:${d.color}`}></div>
                <div class="w-item-text">
                  <span class="w-item-name">{d.name}</span>
                  <span class="w-item-val">{d.sub}</span>
                </div>
              </div>
            ))}
          </div>
        </details>

        <details class="w-cat" open>
          <summary class="w-cat-head">
            <div class="w-cat-pip" style="background:#5e9c50"></div>
            <span class="w-cat-name" id="crop-cat-name">Irrigated corn</span>
            <span class="w-cat-arrow"></span>
          </summary>
          <div class="w-cat-list" id="crop-list">
            {cropFlat.map(d => (
              <div class="w-item" data-idx={d.idx} data-on={d.on ? '1' : '0'}>
                <div class="w-item-dot" style={`background:${d.color}`}></div>
                <div class="w-item-text">
                  <span class="w-item-name">{d.name} corn</span>
                  <span class="w-item-val">{d.sub}</span>
                </div>
              </div>
            ))}
          </div>
        </details>
      </div>

      <div class="w-right">
        <div class="w-unit-bar">
          <span class="w-unit-label">Acres of irrigated</span>
          <div class="w-unit-opts">
            <button class="w-unit-btn" data-unit="corn" data-active="1">corn</button>
            <button class="w-unit-btn" data-unit="alfalfa" data-active="0">alfalfa</button>
            <button class="w-unit-btn" data-unit="golf" data-active="0">golf course</button>
          </div>
        </div>
        <div class="w-chart" id="chart">
          <svg id="svg"></svg>
        </div>
      </div>
    </div>

    <div class="w-methodology">
      <h2>Methodology</h2>
      <p class="w-meth-intro">Every number below is sourced and documented. Where estimates involve significant uncertainty, we note the range and our reasoning.</p>

      <details class="w-meth-section" open>
        <summary>Crop water usage rates</summary>
        <div class="w-meth-body">
          <p><strong>Irrigated corn: 650,000 gal/acre/yr.</strong> Corn requires approximately 25 acre-inches of total water (irrigation + rainfall). In the Great Plains (Nebraska, Kansas), where most irrigated corn is grown, typical irrigation application is 1.5–2.0 acre-feet/year. We use 2.0 acre-feet = 651,700 gallons, rounded to 650,000. This represents <em>irrigation water applied</em>, not total crop water need.</p>
          <p class="w-meth-src">Sources: <a href="https://www.ers.usda.gov/topics/farm-practices-management/irrigation-water-use" target="_blank" rel="noopener">USDA ERS — Irrigation & Water Use</a>, <a href="https://www.canr.msu.edu/news/how_much_water_does_corn_use" target="_blank" rel="noopener">MSU Extension</a>, <a href="https://www.pioneer.com/us/agronomy/water-corn-growth.html" target="_blank" rel="noopener">Pioneer Seeds — Water & Corn Growth</a></p>

          <p><strong>Irrigated alfalfa: 1,500,000 gal/acre/yr.</strong> Alfalfa is the most water-intensive major US crop, requiring 3–6 acre-feet/year depending on climate. The western average (where most US alfalfa is grown) is approximately 4–5 acre-feet. We use 4.6 acre-feet ≈ 1.5M gallons. This matches UNR Extension's estimate.</p>
          <p class="w-meth-src">Source: <a href="https://extension.unr.edu/publication.aspx?PubID=2575" target="_blank" rel="noopener">UNR Extension — How Much Water Does Alfalfa Need?</a></p>

          <p><strong>Golf courses: 1,300,000 gal/irrigated acre/yr.</strong> This is a <em>Southwest/arid-region average</em> (~4 acre-feet/irrigated acre/yr), not a national average. The national average is considerably lower (~2–3 acre-feet) because courses in humid regions (Northeast, Southeast) irrigate less. We use the arid-region figure because it provides a more interesting comparison — users should understand this represents high-irrigation conditions.</p>
          <p class="w-meth-src">Source: <a href="https://www.usga.org/content/dam/usga/pdf/Water%20Resource%20Center/how-much-water-does-golf-use.pdf" target="_blank" rel="noopener">USGA — How Much Water Does Golf Use? (PDF)</a></p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Data center water — direct cooling</summary>
        <div class="w-meth-body">
          <p><strong>ChatGPT inference: 31 million gal/yr.</strong> Derived from Sam Altman's stated figures: 0.000085 gallons and 0.34 Wh per query, at approximately 1 billion queries/day.</p>
          <p class="w-meth-calc">0.000085 gal × 1,000,000,000 queries/day × 365 days = 31 million gal/yr</p>
          <p class="w-meth-caveat">Caveat: Independent researchers (notably <a href="https://arxiv.org/abs/2304.03271" target="_blank" rel="noopener">Shaolei Ren et al.</a>) estimate per-query water usage 3–6× higher than Altman's figure. ChatGPT query volume has also grown to ~2.5B/day as of mid-2025. We use Altman's published numbers since they're the only official figures, but actual usage may be substantially higher.</p>

          <p><strong>ChatGPT w/ training: 33 million gal/yr.</strong> Training GPT-3 consumed approximately 185,000 gallons; GPT-4 is estimated at roughly 10× that (~1.85M gallons). Amortized over one year, training adds ~2M gallons to the inference figure.</p>
          <p class="w-meth-src">Source: <a href="https://www.datacenterdynamics.com/en/news/sam-altman-chatgpt-queries-consume-034-watt-hours-of-electricity-and-0000085-gallons-of-water/" target="_blank" rel="noopener">DCD — Altman's claims</a></p>

          <p><strong>Microsoft: 2.06 billion gal/yr.</strong> Microsoft's FY2023 environmental sustainability report states total water consumption of 7.8 million cubic meters. Converting: 7.8M m³ × 264.172 gal/m³ = 2.06 billion gallons. This is total company water consumption; data centers are the dominant component.</p>
          <p class="w-meth-src">Source: <a href="https://blogs.microsoft.com/on-the-issues/2024/05/15/microsoft-environmental-sustainability-report-2024/" target="_blank" rel="noopener">Microsoft 2024 Environmental Sustainability Report</a></p>

          <p><strong>Google: 6 billion gal/yr.</strong> Google's 2024 environmental report states data centers consumed nearly 6 billion gallons (22.7 billion liters) in calendar year 2024, an 8% increase year-over-year.</p>
          <p class="w-meth-src">Source: <a href="https://sustainability.google/reports/google-2024-environmental-report/" target="_blank" rel="noopener">Google 2024 Environmental Report</a></p>

          <p><strong>All US data centers: 17 billion gal/yr.</strong> LBNL's 2024 report estimated US data centers consumed approximately 17 billion gallons of water directly through on-site cooling in 2023.</p>
          <p class="w-meth-src">Source: <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy" target="_blank" rel="noopener">LBNL — 2024 United States Data Center Energy Usage Report</a></p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Data center water — including electricity generation</summary>
        <div class="w-meth-body">
          <p><strong>Electricity-to-water conversion: 0.5 gal/kWh.</strong> Generating electricity requires water — primarily for cooling thermoelectric power plants (coal, gas, nuclear). We use the NREL estimate of 0.47 gal/kWh for thermoelectric generation, rounded to 0.5. This <em>excludes</em> hydroelectric reservoir evaporation.</p>
          <p class="w-meth-caveat">Note: LBNL's 2024 report uses 1.2 gal/kWh, which includes hydroelectric reservoir evaporation (~18 gal/kWh for hydro alone). We exclude hydro evaporation because it occurs regardless of data center demand and is not a marginal water cost. This methodological choice significantly affects the numbers — at LBNL's rate, the figures below would be ~2.4× higher.</p>
          <p class="w-meth-src">Sources: <a href="https://www.nrel.gov/docs/fy04osti/33905.pdf" target="_blank" rel="noopener">NREL — Consumptive Water Use for U.S. Power Production (PDF)</a>, <a href="https://www.construction-physics.com/p/i-was-wrong-about-data-center-water" target="_blank" rel="noopener">Construction Physics analysis</a></p>

          <p>The "+ water cost of electricity" toggle adds indirect water from power generation:</p>
          <table class="w-meth-table">
            <thead>
              <tr><th></th><th>Electricity</th><th>× 0.5 gal/kWh</th><th>+ Direct</th><th>= Total</th></tr>
            </thead>
            <tbody>
              <tr><td>ChatGPT inference</td><td>124 GWh</td><td>62M gal</td><td>31M</td><td>93M gal/yr</td></tr>
              <tr><td>ChatGPT w/ training</td><td>~174 GWh</td><td>87M gal</td><td>33M</td><td>118M gal/yr</td></tr>
              <tr><td>Microsoft</td><td>~24 TWh</td><td>12B gal</td><td>2.06B</td><td>14B gal/yr</td></tr>
              <tr><td>Google</td><td>~25.3 TWh</td><td>12.65B gal</td><td>6B</td><td>18.7B gal/yr</td></tr>
              <tr><td>All US data centers</td><td>176 TWh</td><td>88B gal</td><td>17B</td><td>105B gal/yr</td></tr>
            </tbody>
          </table>
          <p class="w-meth-src">Electricity figures: Microsoft FY2023 report, Google 2024 report, <a href="https://eta.lbl.gov/publications/2024-united-states-data-center-energy" target="_blank" rel="noopener">LBNL 2024</a> (176 TWh for all US DCs)</p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Crop acreage by state</summary>
        <div class="w-meth-body">
          <p>All state-level irrigated crop acreage comes from the <strong>USDA 2022 Census of Agriculture</strong>, accessed via <a href="https://www.nass.usda.gov/Quick_Stats/" target="_blank" rel="noopener">NASS QuickStats</a>.</p>
          <table class="w-meth-table">
            <thead><tr><th>Crop</th><th>State</th><th>Irrigated acres</th><th>Census table</th></tr></thead>
            <tbody>
              <tr><td rowspan="5">Corn</td><td>Texas</td><td>463,507</td><td rowspan="5">Table 28</td></tr>
              <tr><td>Colorado</td><td>470,075</td></tr>
              <tr><td>Kansas</td><td>1,181,420</td></tr>
              <tr><td>Nebraska</td><td>4,554,560</td></tr>
              <tr><td><em>All US</em></td><td><em>11,000,000</em></td></tr>
              <tr><td rowspan="5">Alfalfa</td><td>Colorado</td><td>564,610</td><td rowspan="5">Table 26</td></tr>
              <tr><td>Montana</td><td>664,411</td></tr>
              <tr><td>California</td><td>868,823</td></tr>
              <tr><td>Idaho</td><td>870,101</td></tr>
              <tr><td><em>All US</em></td><td><em>~6,000,000</em></td></tr>
            </tbody>
          </table>
          <p>The US total for corn (11M irrigated acres) is confirmed by <a href="https://www.ers.usda.gov/topics/farm-practices-management/irrigation-water-use" target="_blank" rel="noopener">USDA ERS</a>: "corn grown for grain accounted for the most irrigated acreage in the United States, with more than 11 million irrigated acres harvested" in 2022.</p>

          <p><strong>Golf course acreage</strong> comes from the <a href="https://www.gcsaa.org/docs/default-source/Environment/phase-2-land-use-survey-full-report.pdf" target="_blank" rel="noopener">GCSAA Environmental Profile survey</a>: 1,198,381 irrigated acres nationally (80% of maintained golf turfgrass). State-level figures (FL 81,400; CA 68,600; TX 63,300; NY 62,200) are from the same GCSAA/NGF survey.</p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Surface areas</summary>
        <div class="w-meth-body">
          <p>All surface areas are <strong>land area only</strong> (excluding water bodies), from the US Census Bureau, converted at 640 acres per square mile.</p>
          <table class="w-meth-table">
            <thead><tr><th>Place</th><th>Land area (sq mi)</th><th>Acres</th></tr></thead>
            <tbody>
              <tr><td>Manhattan</td><td>22.83</td><td>14,611</td></tr>
              <tr><td>San Francisco</td><td>46.87</td><td>29,997</td></tr>
              <tr><td>Washington, D.C.</td><td>61.05</td><td>39,072</td></tr>
              <tr><td>Los Angeles</td><td>468.67</td><td>299,949</td></tr>
              <tr><td>Rhode Island</td><td>1,033.81</td><td>661,639</td></tr>
              <tr><td>New Jersey</td><td>7,354.22</td><td>4,706,701</td></tr>
            </tbody>
          </table>
          <p class="w-meth-src">Source: <a href="https://www.census.gov/geographies/reference-files/time-series/geo/gazetteer-files.html" target="_blank" rel="noopener">US Census Bureau Gazetteer Files</a></p>
        </div>
      </details>

      <details class="w-meth-section">
        <summary>Key caveats and limitations</summary>
        <div class="w-meth-body">
          <ul>
            <li><strong>ChatGPT figures are the most uncertain numbers here.</strong> Sam Altman's per-query claims are the only official figures but independent researchers estimate 3–6× higher water usage per query. Query volume has also grown substantially since the 1B/day figure was published.</li>
            <li><strong>The electricity-water rate matters enormously.</strong> At the NREL thermoelectric rate (0.5 gal/kWh), indirect water for all US data centers is ~88B gal. At LBNL's rate including hydro (1.2 gal/kWh), it's ~211B gal — a 2.4× difference. We use the lower rate because hydro evaporation is not a marginal cost of data centers.</li>
            <li><strong>The golf course water rate (1.3M gal/acre) is for arid-region courses</strong>, not a national average. Courses in humid regions use much less. The national average would be roughly 650,000–980,000 gal/acre/yr.</li>
            <li><strong>Crop water varies enormously by region.</strong> The corn figure (650K gal/acre) is representative of Plains states; southern and eastern irrigated corn may use less supplemental water due to higher rainfall.</li>
            <li><strong>"Direct" vs. "with electricity" is a real methodological debate.</strong> Both framings are legitimate. Direct cooling water is what the data center physically consumes. Electricity-generation water is consumed upstream at power plants. Neither is "wrong" — they answer different questions.</li>
          </ul>
        </div>
      </details>
    </div>

    <div class="w-divider"></div>

    <div class="w-section-header">
      <h2>Potable water</h2>
      <p class="w-section-desc">Freshwater withdrawn from municipal supply or aquifers — the water that competes directly with drinking water, agriculture, and ecosystems. A narrower but more locally impactful measure.</p>
    </div>

    <div class="w-potable-placeholder">
      <p>Coming soon — potable water data with the same interactive comparison interface.</p>
    </div>
  </div>

<script is:inline define:vars={{ cropDataAll, cropStartIdx, GAL_CORN, GAL_ALFALFA, GAL_GOLF }}>
  window.__cropDataAll = cropDataAll;
  window.__cropStartIdx = cropStartIdx;
  window.__galRates = { corn: GAL_CORN, alfalfa: GAL_ALFALFA, golf: GAL_GOLF };
</script>

<style is:global>
  .main-content:has(.w) { max-width: 1200px; }
  .w { max-width: 1200px; margin: 0 auto; }
  .w-intro { max-width: 640px; margin-bottom: 2.5rem; }
  .w-intro h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.025em; margin-bottom: 0.35rem; }
  .w-deck { color: var(--accent); font-size: 1rem; font-weight: 480; margin-bottom: 0.65rem; }
  .w-lede { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.65; }
  .w-viz { display: flex; gap: 2.5rem; align-items: flex-start; margin-bottom: 3rem; }

  .w-panel { width: 280px; flex-shrink: 0; }
  .w-cat { margin-bottom: 1.5rem; }
  .w-cat:last-child { margin-bottom: 0; }
  .w-cat-head {
    display: flex; align-items: center; gap: 0.5rem;
    padding-bottom: 0.4rem; margin-bottom: 0.25rem;
    border-bottom: 1.5px solid var(--border);
    cursor: pointer; list-style: none; user-select: none;
  }
  .w-cat-head::-webkit-details-marker { display: none; }
  .w-cat-head:hover { opacity: 0.75; }
  .w-cat-pip { width: 10px; height: 10px; border-radius: 2.5px; flex-shrink: 0; }
  .w-cat-name { font-size: 0.68rem; font-weight: 660; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-secondary); flex: 1; }
  .w-cat-arrow { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid var(--dim); flex-shrink: 0; transition: transform 0.2s ease; opacity: 0.5; }
  .w-cat:not([open]) .w-cat-arrow { transform: rotate(-90deg); }
  .w-cat-list { padding-top: 0.15rem; }

  .w-item { display: flex; align-items: center; gap: 0.65rem; padding: 0.4rem 0.55rem; margin: 0 -0.55rem; border-radius: 6px; cursor: pointer; user-select: none; transition: background 0.1s ease; }
  .w-item:hover { background: var(--bg-subtle); }
  .w-item:active { background: var(--accent-subtle); transition: none; }
  .w-item-dot { width: 10px; height: 10px; border-radius: 2.5px; flex-shrink: 0; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease; }
  .w-item[data-on="1"] .w-item-dot { opacity: 1; transform: scale(1); }
  .w-item[data-on="0"] .w-item-dot { opacity: 0.12; transform: scale(0.5); }
  .w-item-text { flex: 1; min-width: 0; transition: opacity 0.15s ease; }
  .w-item[data-on="0"] .w-item-text { opacity: 0.25; }
  .w-item-name { display: block; font-size: 0.82rem; font-weight: 490; color: var(--text); line-height: 1.35; }
  .w-item-val { display: block; font-size: 0.64rem; color: var(--dim); line-height: 1.3; font-variant-numeric: tabular-nums; margin-top: 0.05rem; }

  .w-dc-group { position: relative; }
  .w-sub { display: flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0.55rem 0.35rem 2.15rem; margin: -0.1rem -0.55rem 0; border-radius: 5px; cursor: pointer; user-select: none; transition: background 0.1s ease; }
  .w-sub:hover { background: var(--bg-subtle); }
  .w-sub-check { width: 11px; height: 11px; border-radius: 2.5px; border: 1.5px solid var(--border-strong); flex-shrink: 0; position: relative; transition: border-color 0.15s, background 0.15s; }
  .w-sub[data-checked="1"] .w-sub-check { border-color: var(--accent); background: var(--accent); }
  .w-sub[data-checked="1"] .w-sub-check::after { content: ''; position: absolute; top: 1px; left: 3px; width: 3px; height: 5.5px; border: solid white; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }
  .w-sub-label { font-size: 0.62rem; color: var(--dim); line-height: 1; }
  .w-sub[data-checked="1"] .w-sub-label { color: var(--accent); }
  .w-item[data-on="0"] ~ .w-sub { opacity: 0.25; pointer-events: none; }

  .w-right { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0; }
  .w-unit-bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.75rem; background: var(--bg-elevated); border: 1px solid var(--border); border-bottom: none; border-radius: 8px 8px 0 0; }
  .w-unit-label { font-size: 0.72rem; font-weight: 550; color: var(--text-secondary); white-space: nowrap; }
  .w-unit-opts { display: flex; gap: 0.3rem; }
  .w-unit-btn { font-family: var(--font-body); font-size: 0.7rem; font-weight: 520; padding: 0.3rem 0.65rem; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--dim); cursor: pointer; transition: all 0.12s ease; }
  .w-unit-btn:hover { background: var(--bg-subtle); color: var(--text); }
  .w-unit-btn[data-active="1"] { background: var(--accent); color: white; border-color: var(--accent); }

  .w-chart { min-width: 0; min-height: 400px; aspect-ratio: 1.3 / 1; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 0 0 8px 8px; overflow: hidden; position: relative; }
  #svg { width: 100%; height: 100%; display: block; }

  /* Section headers */
  .w-section-header { margin-bottom: 1.5rem; }
  .w-section-header h2 {
    font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em;
    margin-bottom: 0.25rem; color: var(--text);
  }
  .w-section-desc {
    font-size: 0.82rem; color: var(--dim); line-height: 1.6; max-width: 640px;
  }

  .w-divider {
    height: 1px; background: var(--border); margin: 3rem 0;
  }

  .w-potable-placeholder {
    padding: 2.5rem 2rem;
    background: var(--bg-subtle);
    border: 1px dashed var(--border);
    border-radius: 8px;
    margin-bottom: 3rem;
  }
  .w-potable-placeholder p {
    font-size: 0.88rem; color: var(--dim); font-style: italic; margin: 0;
  }

  /* Methodology */
  .w-methodology { max-width: 760px; padding-bottom: 3rem; }
  .w-methodology h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.02em; }
  .w-meth-intro { font-size: 0.82rem; color: var(--dim); line-height: 1.6; margin-bottom: 1.5rem; }

  .w-meth-section { border-bottom: 1px solid var(--border); }
  .w-meth-section:last-child { border-bottom: none; }
  .w-meth-section summary {
    font-size: 0.88rem; font-weight: 600; color: var(--text);
    cursor: pointer; list-style: none; padding: 0.75rem 0;
    display: flex; align-items: center; gap: 8px;
    user-select: none;
  }
  .w-meth-section summary::-webkit-details-marker { display: none; }
  .w-meth-section summary::before { content: '▸'; font-size: 0.65rem; color: var(--dim); transition: transform 0.15s; }
  .w-meth-section[open] summary::before { transform: rotate(90deg); }
  .w-meth-section summary:hover { color: var(--accent); }

  .w-meth-body { padding: 0 0 1.25rem 20px; }
  .w-meth-body p { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .w-meth-body strong { color: var(--text); }
  .w-meth-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .w-meth-body ul { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .w-meth-body li { font-size: 0.78rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.4rem; }
  .w-meth-body li strong { color: var(--text); }

  .w-meth-src { font-size: 0.68rem; color: var(--dim); margin-top: 0.15rem; margin-bottom: 0.75rem; }
  .w-meth-src a { font-size: inherit; }

  .w-meth-calc {
    font-family: var(--font-mono, monospace); font-size: 0.72rem;
    background: var(--bg-subtle); padding: 8px 12px; border-radius: 4px;
    margin: 0.35rem 0 0.5rem; color: var(--text); line-height: 1.5;
  }

  .w-meth-caveat {
    font-size: 0.72rem; color: var(--dim); font-style: italic;
    border-left: 2px solid var(--border); padding-left: 10px;
    margin: 0.35rem 0 0.75rem; line-height: 1.55;
  }
  .w-meth-caveat a { color: var(--accent); }

  .w-meth-table {
    width: 100%; border-collapse: collapse; margin: 0.5rem 0 0.75rem;
    font-size: 0.72rem; line-height: 1.4;
  }
  .w-meth-table th {
    text-align: left; font-weight: 600; color: var(--text);
    padding: 4px 8px; border-bottom: 2px solid var(--border);
    font-size: 0.68rem;
  }
  .w-meth-table td {
    padding: 3px 8px; border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary); font-variant-numeric: tabular-nums;
  }
  .w-meth-table em { font-weight: 500; }

  @media (max-width: 850px) {
    .w-viz { flex-direction: column; }
    .w-panel { width: 100%; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem 2.5rem; }
    .w-cat { margin-bottom: 0; }
    .w-chart { aspect-ratio: 1; }
  }
  @media (max-width: 500px) { .w-panel { grid-template-columns: 1fr; } }
</style>

<script is:inline>
(function() {
  const RATES = { corn: 650000, alfalfa: 1500000, golf: 1300000 };
  const CROP_LABELS = { corn: 'corn', alfalfa: 'alfalfa', golf: 'golf course' };
  const cropDataAll = window.__cropDataAll;
  const cropStartIdx = window.__cropStartIdx;
  let activeUnit = 'corn';

  function fA(a) { return a >= 1e6 ? (a/1e6).toFixed(1)+'M acres' : a >= 1e3 ? Math.round(a).toLocaleString()+' acres' : a.toFixed(0)+' acres'; }
  function fG(g) { return g >= 1e12 ? (g/1e12).toFixed(1)+'T gal/yr' : g >= 1e9 ? (g/1e9).toFixed(1)+'B gal/yr' : (g/1e6).toFixed(0)+'M gal/yr'; }

  const items = [];

  // Init non-crop items from server-rendered DOM
  document.querySelectorAll('.w-item').forEach(row => {
    const idx = parseInt(row.dataset.idx);
    const dot = row.querySelector('.w-item-dot');
    const baseName = row.querySelector('.w-item-name').textContent;
    const galBase = parseFloat(row.dataset.galBase || 0);
    const galElec = parseFloat(row.dataset.galElec || 0);
    const fixedAcres = parseFloat(row.dataset.fixedAcres || 0);
    const isFixed = fixedAcres > 0;
    const isCrop = idx >= cropStartIdx;

    let acres, gallons;
    if (isFixed) { acres = fixedAcres; gallons = 0; }
    else if (isCrop) { acres = 0; gallons = 0; } // will be set by rebuildCropItems
    else { gallons = galBase; acres = gallons / RATES[activeUnit]; }

    items[idx] = { idx, acres, on: row.dataset.on === '1', color: dot.style.backgroundColor, name: baseName, sub: row.querySelector('.w-item-val').textContent, gallons, fixedAcres, baseName, elecOn: false, galBase, galElec, isCrop };
    row.dataset.baseName = baseName;

    if (!isCrop) {
      row.addEventListener('click', () => { items[idx].on = !items[idx].on; row.dataset.on = items[idx].on ? '1' : '0'; render(); });
    }
  });

  // Crop list elements (needed by rebuildCropItems)
  const cropList = document.getElementById('crop-list');
  const cropCatName = document.getElementById('crop-cat-name');

  // Init crop items properly
  rebuildCropItems();

  // Sub-checkboxes
  document.querySelectorAll('.w-sub').forEach(sub => {
    sub.dataset.checked = '0';
    const parentIdx = parseInt(sub.dataset.parentIdx);
    const parentRow = document.querySelector(`.w-item[data-idx="${parentIdx}"]`);

    sub.addEventListener('click', (e) => {
      e.stopPropagation();
      const nowChecked = sub.dataset.checked !== '1';
      sub.dataset.checked = nowChecked ? '1' : '0';
      parentRow.dataset.elec = nowChecked ? '1' : '0';

      const it = items[parentIdx];
      it.elecOn = nowChecked;
      it.gallons = nowChecked ? it.galElec : it.galBase;
      it.name = nowChecked ? it.baseName + ' + electricity' : it.baseName;
      it.acres = it.gallons / RATES[activeUnit];
      it.sub = fA(it.acres) + ' · ' + fG(it.gallons);
      const valEl = parentRow.querySelector('.w-item-val');
      if (valEl) valEl.textContent = it.sub;
      render();
    });
  });

  // Crop list rebuild

  function rebuildCropItems() {
    const rate = RATES[activeUnit];
    const label = CROP_LABELS[activeUnit];
    const data = cropDataAll[activeUnit];

    // Turn off old crop items
    for (let i = cropStartIdx; i < cropStartIdx + 5; i++) {
      if (items[i]) items[i].on = false;
    }

    cropList.innerHTML = '';

    data.forEach((d, j) => {
      const idx = cropStartIdx + j;
      const displayName = d.name === 'All US irrigated' ? `All US irrigated ${label}` : `${d.name} ${label}`;
      const gallons = d.acres * rate;
      const sub = fA(d.acres) + ' · ' + fG(gallons);

      items[idx] = { idx, acres: d.acres, on: d.on, color: d.color, name: displayName, sub, gallons, fixedAcres: 0, baseName: d.name, elecOn: false, galBase: 0, galElec: 0, isCrop: true };

      const row = document.createElement('div');
      row.className = 'w-item';
      row.dataset.idx = String(idx);
      row.dataset.on = d.on ? '1' : '0';
      row.innerHTML = `<div class="w-item-dot" style="background:${d.color}"></div><div class="w-item-text"><span class="w-item-name">${displayName}</span><span class="w-item-val">${sub}</span></div>`;

      row.addEventListener('click', () => { items[idx].on = !items[idx].on; row.dataset.on = items[idx].on ? '1' : '0'; render(); });
      cropList.appendChild(row);
    });
  }

  // Unit selector
  const unitBtns = document.querySelectorAll('.w-unit-btn');
  unitBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const unit = btn.dataset.unit;
      if (unit === activeUnit) return;
      activeUnit = unit;
      unitBtns.forEach(b => b.dataset.active = b.dataset.unit === unit ? '1' : '0');
      cropCatName.textContent = `Irrigated ${CROP_LABELS[unit]}`;

      rebuildCropItems();

      // Recalc DC items at new rate
      items.forEach((it, i) => {
        if (!it || it.isCrop || it.fixedAcres > 0) return;
        it.acres = it.gallons / RATES[activeUnit];
        it.sub = fA(it.acres) + ' · ' + fG(it.gallons);
        const row = document.querySelector(`.w-item[data-idx="${i}"]`);
        const valEl = row?.querySelector('.w-item-val');
        if (valEl) valEl.textContent = it.sub;
      });

      render();
    });
  });

  // ── Animation ──────────────────────────────────
  const chart = document.getElementById('chart');
  const svg = document.getElementById('svg');
  const cur = new Map();
  const tgt = new Map();
  let raf = null;

  function render() {
    const W = chart.clientWidth, H = chart.clientHeight;
    const pad = 24;
    const maxSide = Math.min(H - pad * 2, W - 200 - pad);
    const active = items.filter(d => d && d.on);
    const maxA = active.reduce((m, d) => Math.max(m, d.acres), 0);

    tgt.clear();
    if (maxA > 0) active.forEach(d => tgt.set(d.idx, Math.max(2, maxSide * Math.sqrt(d.acres / maxA))));
    cur.forEach((_, k) => { if (!tgt.has(k)) tgt.set(k, 0); });
    tgt.forEach((_, k) => { if (!cur.has(k)) cur.set(k, 0); });
    if (!raf) raf = requestAnimationFrame(step);
  }

  function step() {
    const W = chart.clientWidth, H = chart.clientHeight, pad = 24;
    let moving = false;
    tgt.forEach((t, k) => {
      const c = cur.get(k) ?? 0, d = t - c;
      if (Math.abs(d) < 0.4) { cur.set(k, t); if (t === 0) cur.delete(k); }
      else { cur.set(k, c + d * 0.14); moving = true; }
    });
    draw(W, H, pad);
    raf = moving ? requestAnimationFrame(step) : null;
  }

  function draw(W, H, pad) {
    const vis = [];
    cur.forEach((s, i) => { if (s > 0.5) vis.push({ idx: i, s }); });
    vis.sort((a, b) => b.s - a.s);

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    if (!vis.length) { svg.innerHTML = `<text x="${W/2}" y="${H/2}" text-anchor="middle" font-family="var(--font-body)" font-size="13" fill="var(--dim)">Select items to compare</text>`; return; }

    const ox = pad, oy = H - pad, p = [];

    vis.forEach(v => {
      const it = items[v.idx], x = ox, y = oy - v.s;
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="${it.color}" fill-opacity=".12"/>`);
      p.push(`<rect x="${x}" y="${y}" width="${v.s}" height="${v.s}" rx="3" fill="none" stroke="${it.color}" stroke-width="1.5" stroke-opacity=".55"/>`);
    });

    const bigSide = vis[0]?.s ?? 0, lx = ox + bigSide + 24, labelH = 30;
    const labs = vis.map(v => ({ idx: v.idx, ny: oy - v.s, s: v.s })).sort((a, b) => a.ny - b.ny);
    let cursor = -Infinity;
    const positions = labs.map(l => { const y = Math.max(l.ny, cursor); cursor = y + labelH; return { ...l, y }; });

    const lastBot = positions.length > 0 ? positions[positions.length - 1].y + labelH : 0;
    const topY = positions.length > 0 ? positions[0].ny : pad;
    if (lastBot > H - pad && positions.length > 1) {
      const gap = Math.max(16, ((H - pad) - Math.max(pad, topY)) / positions.length);
      let y = Math.max(pad, topY);
      positions.forEach(p => { p.y = y; y += gap; });
    }

    positions.forEach(r => {
      const it = items[r.idx], ax = ox + r.s, ay = r.ny + 1, ty = r.y + 5;
      if (ty + 14 > H - 4 || ty < 2) return;
      p.push(`<line x1="${ax}" y1="${ay}" x2="${lx-7}" y2="${ty+2}" stroke="${it.color}" stroke-width=".7" opacity=".2"/>`);
      p.push(`<circle cx="${ax}" cy="${ay}" r="2" fill="${it.color}" opacity=".35"/>`);
    });

    positions.forEach(r => {
      const it = items[r.idx], ty = r.y + 5;
      if (ty + 14 > H - 4 || ty < 2) return;
      p.push(`<rect x="${lx-4}" y="${ty-12}" width="${W-lx+4}" height="${labelH}" rx="3" fill="var(--bg-subtle)" fill-opacity=".9"/>`);
      p.push(`<text x="${lx}" y="${ty}" font-family="var(--font-body)" font-size="12" font-weight="550" fill="var(--text)">${it.name}</text>`);
      p.push(`<text x="${lx}" y="${ty+14}" font-family="var(--font-body)" font-size="9.5" fill="var(--dim)">${it.sub}</text>`);
    });

    svg.innerHTML = p.join('\n');
  }

  render();

  let rt;
  new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { cur.clear(); render(); }, 60); }).observe(chart);
})();
</script>
