---
import Base from '@/layouts/Base.astro';
import { AquiferStressExplorer } from '@/components/aquifer/AquiferStressExplorer';
import { loadAquiferBundle } from '@/lib/aquifer/loader';

const data = loadAquiferBundle();
const pageTitle = 'Aquifer stress';
const pageDescription = 'An interactive map of major U.S. aquifer systems, showing groundwater withdrawals, broad sectors, and clearly labeled modeled layers.';
const pageUrl = 'https://andymasley.com/visuals/aquifer-stress';
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageUrl}
  ogTitle="Aquifer stress"
  ogImage="/images/og/og-visuals.png"
  ogImageAlt="Aquifer stress map preview for Andy Masley"
>
  <article class="aqs-page">
    <header class="aqs-hero">
      <p class="aqs-hero-kicker">Groundwater</p>
      <h1 class="aqs-hero-title">Aquifer stress</h1>
      <p class="aqs-hero-copy">
        A national explainer for how groundwater withdrawals concentrate across major aquifer systems. The goal is not false precision. It is to make the source data, uncertainty, and tradeoffs legible.
      </p>
    </header>

    <AquiferStressExplorer data={data} client:load />
  </article>
</Base>

<style is:global>
  .aqs-page {
    width: calc(100vw - 48px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    max-width: 1600px;
    padding-bottom: 4rem;
    --aqs-ink: #163334;
    --aqs-sea: #1f5e61;
    --aqs-moss: #6f8d6d;
    --aqs-sand: #ebe3d4;
    --aqs-panel: #f5f1e8;
    --aqs-border: rgba(22, 51, 52, 0.16);
    --aqs-shadow: 0 24px 50px -36px rgba(22, 51, 52, 0.3);
  }

  [data-theme="dark"] .aqs-page {
    --aqs-ink: #dbe9e2;
    --aqs-sea: #7ac3c4;
    --aqs-moss: #9fb59e;
    --aqs-sand: #2a2f2d;
    --aqs-panel: #1b1f1e;
    --aqs-border: rgba(219, 233, 226, 0.15);
    --aqs-shadow: 0 24px 50px -36px rgba(0, 0, 0, 0.58);
  }

  .aqs-hero {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .aqs-hero-kicker,
  .aqs-eyebrow,
  .aqs-map-kicker,
  .aqs-detail-region {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aqs-sea);
  }

  .aqs-hero-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .aqs-hero-copy,
  .aqs-intro {
    margin: 0;
    max-width: 42rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .aqs-shell {
    background:
      radial-gradient(circle at top left, rgba(111, 141, 109, 0.18), transparent 28%),
      linear-gradient(180deg, rgba(235, 227, 212, 0.85), rgba(245, 241, 232, 0.55));
    border: 1px solid var(--aqs-border);
    box-shadow: var(--aqs-shadow);
    padding: 1.5rem;
  }

  [data-theme="dark"] .aqs-shell {
    background:
      radial-gradient(circle at top left, rgba(122, 195, 196, 0.12), transparent 26%),
      linear-gradient(180deg, rgba(27, 31, 30, 0.96), rgba(19, 23, 22, 0.88));
  }

  .aqs-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: end;
  }

  .aqs-toolbar-copy {
    max-width: 42rem;
  }

  .aqs-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .aqs-toolbar-controls {
    display: grid;
    gap: 1rem;
    min-width: min(100%, 24rem);
  }

  .aqs-search {
    display: grid;
    gap: 0.45rem;
  }

  .aqs-search-label {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .aqs-search-input {
    width: 100%;
    border: 1px solid var(--aqs-border);
    background: var(--bg-elevated);
    color: var(--text);
    padding: 0.85rem 1rem;
    font: inherit;
  }

  .aqs-mode-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .aqs-mode-button,
  .aqs-related-button,
  .aqs-list-item {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.55);
    color: inherit;
    font: inherit;
  }

  [data-theme="dark"] .aqs-mode-button,
  [data-theme="dark"] .aqs-related-button,
  [data-theme="dark"] .aqs-list-item {
    background: rgba(255, 255, 255, 0.03);
  }

  .aqs-mode-button {
    padding: 0.65rem 0.9rem;
  }

  .aqs-mode-button.is-active {
    background: var(--aqs-sea);
    border-color: var(--aqs-sea);
    color: #f8f7f3;
  }

  .aqs-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 18rem) minmax(0, 1.25fr) minmax(19rem, 24rem);
    gap: 1rem;
    align-items: start;
  }

  .aqs-list-panel,
  .aqs-map-panel,
  .aqs-detail-panel {
    background: rgba(250, 249, 247, 0.62);
    border: 1px solid var(--aqs-border);
    min-height: 100%;
  }

  [data-theme="dark"] .aqs-list-panel,
  [data-theme="dark"] .aqs-map-panel,
  [data-theme="dark"] .aqs-detail-panel {
    background: rgba(255, 255, 255, 0.02);
  }

  .aqs-list-panel {
    padding: 0.9rem;
  }

  .aqs-list-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 0.85rem;
  }

  .aqs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .aqs-list-item {
    width: 100%;
    text-align: left;
    padding: 0.8rem;
    display: grid;
    gap: 0.55rem;
    cursor: pointer;
  }

  .aqs-list-item.is-active {
    border-color: var(--aqs-sea);
    box-shadow: inset 0 0 0 1px var(--aqs-sea);
  }

  .aqs-list-item-top,
  .aqs-list-metric {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .aqs-list-name,
  .aqs-stat-value,
  .aqs-detail-title {
    font-family: var(--font-editorial);
  }

  .aqs-list-region,
  .aqs-list-summary,
  .aqs-list-metric span {
    color: var(--text-secondary);
  }

  .aqs-map-panel {
    padding: 1rem;
    position: relative;
  }

  .aqs-map-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 0.8rem;
  }

  .aqs-map-caption,
  .aqs-map-footnote {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .aqs-legend {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .aqs-legend-bar {
    width: 7rem;
    height: 0.7rem;
    background: linear-gradient(90deg, rgb(211, 224, 212), rgb(31, 94, 97));
    border: 1px solid var(--aqs-border);
  }

  .aqs-map-wrap {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.6), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.34), transparent 80%);
    border: 1px solid var(--aqs-border);
    min-height: 32rem;
  }

  .aqs-map {
    display: block;
    width: 100%;
    height: auto;
  }

  .aqs-map-feature {
    stroke: rgba(20, 36, 37, 0.42);
    stroke-width: 1.4;
    transition: opacity 0.18s ease, stroke 0.18s ease, transform 0.18s ease;
    cursor: pointer;
  }

  .aqs-map-feature.is-selected,
  .aqs-map-feature.is-hovered {
    stroke: var(--aqs-ink);
    stroke-width: 2.4;
  }

  .aqs-tooltip {
    position: absolute;
    transform: translate(-50%, -118%);
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.7rem;
    background: rgba(19, 27, 27, 0.92);
    color: #f7f5ef;
    pointer-events: none;
    font-size: 0.82rem;
  }

  .aqs-detail-panel {
    padding: 1rem;
  }

  .aqs-detail-header {
    margin-bottom: 1rem;
  }

  .aqs-detail-title {
    margin: 0 0 0.55rem;
    font-size: 2rem;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .aqs-detail-summary,
  .aqs-source-line span,
  .aqs-badge span,
  .aqs-mode-note p {
    color: var(--text-secondary);
  }

  .aqs-stat {
    border-top: 1px solid var(--aqs-border);
    border-bottom: 1px solid var(--aqs-border);
    padding: 1rem 0;
    display: grid;
    gap: 0.2rem;
  }

  .aqs-stat-label,
  .aqs-stat-subline {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .aqs-stat-value {
    font-size: clamp(2rem, 1.4rem + 1vw, 2.8rem);
    line-height: 0.98;
  }

  .aqs-meta-row {
    display: grid;
    gap: 0.8rem;
    margin: 1rem 0;
  }

  .aqs-badge,
  .aqs-source-line,
  .aqs-mode-note,
  .aqs-empty-state {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.5);
    padding: 0.85rem;
  }

  [data-theme="dark"] .aqs-badge,
  [data-theme="dark"] .aqs-source-line,
  [data-theme="dark"] .aqs-mode-note,
  [data-theme="dark"] .aqs-empty-state {
    background: rgba(255, 255, 255, 0.03);
  }

  .aqs-badge,
  .aqs-source-line {
    display: grid;
    gap: 0.25rem;
  }

  .aqs-section {
    margin-top: 1.2rem;
  }

  .aqs-section-title {
    margin: 0 0 0.7rem;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
  }

  .aqs-bars,
  .aqs-sources,
  .aqs-caveats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .aqs-bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(8rem, auto);
    gap: 0.8rem;
    align-items: center;
  }

  .aqs-bar-copy {
    display: grid;
    gap: 0.15rem;
  }

  .aqs-bar-copy small,
  .aqs-bar-value span,
  .aqs-sources span,
  .aqs-sources small {
    color: var(--text-secondary);
  }

  .aqs-bar-track {
    width: 100%;
    height: 0.7rem;
    background: rgba(22, 51, 52, 0.08);
    border: 1px solid var(--aqs-border);
    position: relative;
  }

  .aqs-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: linear-gradient(90deg, var(--aqs-moss), var(--aqs-sea));
  }

  .aqs-bar-value {
    display: grid;
    justify-items: end;
  }

  .aqs-methodology {
    margin-top: 1.2rem;
    border-top: 1px solid var(--aqs-border);
    padding-top: 1rem;
  }

  .aqs-methodology summary {
    cursor: pointer;
    font-weight: 600;
  }

  .aqs-methodology-copy {
    margin-top: 0.8rem;
    color: var(--text-secondary);
  }

  .aqs-related {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .aqs-related-button {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.8rem;
    text-align: left;
  }

  .aqs-related-button span {
    color: var(--text-secondary);
  }

  .aqs-empty-state {
    display: grid;
    gap: 0.45rem;
  }

  .aqs-empty-state--map,
  .aqs-empty-state--detail {
    min-height: 18rem;
    place-content: center;
  }

  @media (max-width: 1100px) {
    .aqs-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .aqs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .aqs-page {
      width: calc(100vw - 24px);
    }

    .aqs-shell {
      padding: 1rem;
    }

    .aqs-map-meta,
    .aqs-bar-row {
      grid-template-columns: 1fr;
    }

    .aqs-tooltip {
      display: none;
    }
  }
</style>
