---
import Base from '@/layouts/Base.astro';
import { AquiferStressExplorer } from '@/components/aquifer/AquiferStressExplorer';
import { loadAquiferBundle } from '@/lib/aquifer/loader';

const data = loadAquiferBundle();
const pageTitle = 'Aquifer stress';
const pageDescription = 'An interactive conterminous U.S. aquifer map combining 2015 USGS withdrawals with a USGS mean annual natural recharge raster to show recharge-based groundwater stress.';
const pageUrl = 'https://andymasley.com/visuals/aquifer-stress';
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageUrl}
  ogTitle="Aquifer stress"
  ogImage="/images/og/og-visuals.png"
  ogImageAlt="Aquifer stress map preview for Andy Masley"
>
  <article class="aqs-page">
    <header class="aqs-hero">
      <p class="aqs-hero-kicker">Groundwater</p>
      <h1 class="aqs-hero-title">Aquifer stress</h1>
      <p class="aqs-hero-copy">
        A conterminous-U.S. explainer for how direct-source 2015 groundwater withdrawals compare with long-term estimated natural recharge across principal aquifers. The goal is not false precision. It is to make the source data, uncertainty, and tradeoffs legible.
      </p>
    </header>

    <AquiferStressExplorer data={data} client:load />
  </article>
</Base>

<style is:global>
  .aqs-page {
    width: calc(100vw - 48px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    max-width: 1600px;
    padding-bottom: 4rem;
    --aqs-ink: #163334;
    --aqs-sea: #1f5e61;
    --aqs-moss: #6f8d6d;
    --aqs-river: #4b8191;
    --aqs-clay: #a54935;
    --aqs-sand: #ebe3d4;
    --aqs-panel: #f5f1e8;
    --aqs-border: rgba(22, 51, 52, 0.16);
    --aqs-shadow: 0 24px 50px -36px rgba(22, 51, 52, 0.3);
  }

  [data-theme="dark"] .aqs-page {
    --aqs-ink: #dbe9e2;
    --aqs-sea: #7ac3c4;
    --aqs-moss: #9fb59e;
    --aqs-sand: #2a2f2d;
    --aqs-panel: #1b1f1e;
    --aqs-border: rgba(219, 233, 226, 0.15);
    --aqs-shadow: 0 24px 50px -36px rgba(0, 0, 0, 0.58);
  }

  .aqs-hero {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .aqs-hero-kicker,
  .aqs-eyebrow,
  .aqs-map-kicker,
  .aqs-detail-region {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aqs-sea);
  }

  .aqs-hero-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .aqs-hero-copy,
  .aqs-intro {
    margin: 0;
    max-width: 42rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .aqs-shell {
    background:
      radial-gradient(circle at top left, rgba(111, 141, 109, 0.18), transparent 28%),
      linear-gradient(180deg, rgba(235, 227, 212, 0.85), rgba(245, 241, 232, 0.55));
    border: 1px solid var(--aqs-border);
    box-shadow: var(--aqs-shadow);
    padding: 1.5rem;
  }

  [data-theme="dark"] .aqs-shell {
    background:
      radial-gradient(circle at top left, rgba(122, 195, 196, 0.12), transparent 26%),
      linear-gradient(180deg, rgba(27, 31, 30, 0.96), rgba(19, 23, 22, 0.88));
  }

  .aqs-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: end;
  }

  .aqs-toolbar-copy {
    max-width: 42rem;
  }

  .aqs-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .aqs-toolbar-controls {
    display: grid;
    gap: 1rem;
    min-width: min(100%, 24rem);
  }

  .aqs-search {
    display: grid;
    gap: 0.45rem;
  }

  .aqs-search-label {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .aqs-search-input {
    width: 100%;
    border: 1px solid var(--aqs-border);
    background: var(--bg-elevated);
    color: var(--text);
    padding: 0.85rem 1rem;
    font: inherit;
  }

  .aqs-mode-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .aqs-mode-button,
  .aqs-related-button,
  .aqs-list-item {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.55);
    color: inherit;
    font: inherit;
  }

  [data-theme="dark"] .aqs-mode-button,
  [data-theme="dark"] .aqs-related-button,
  [data-theme="dark"] .aqs-list-item {
    background: rgba(255, 255, 255, 0.03);
  }

  .aqs-mode-button {
    padding: 0.65rem 0.9rem;
  }

  .aqs-mode-button.is-active {
    background: var(--aqs-sea);
    border-color: var(--aqs-sea);
    color: #f8f7f3;
  }

  .aqs-grid {
    display: grid;
    grid-template-columns: minmax(21rem, 24rem) minmax(0, 1.15fr) minmax(19rem, 24rem);
    gap: 1rem;
    align-items: start;
  }

  .aqs-list-panel,
  .aqs-map-panel,
  .aqs-detail-panel {
    background: rgba(250, 249, 247, 0.62);
    border: 1px solid var(--aqs-border);
    min-height: 100%;
  }

  [data-theme="dark"] .aqs-list-panel,
  [data-theme="dark"] .aqs-map-panel,
  [data-theme="dark"] .aqs-detail-panel {
    background: rgba(255, 255, 255, 0.02);
  }

  .aqs-list-panel {
    display: grid;
    grid-template-rows: minmax(0, 44%) minmax(0, 56%);
    overflow: hidden;
  }

  .aqs-list-top {
    padding: 0.85rem;
    border-bottom: 1px solid var(--aqs-border);
    background:
      radial-gradient(circle at top left, rgba(122, 195, 196, 0.08), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.28), transparent 92%);
    overflow: hidden;
  }

  .aqs-list-top-grid {
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: 0.7rem;
    align-items: stretch;
  }

  .aqs-list-top-stack {
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 0.55rem;
    align-content: start;
  }

  .aqs-directory-hero {
    display: grid;
    gap: 0.65rem;
    padding: 0.8rem;
    border: 1px solid var(--aqs-border);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.3)),
      radial-gradient(circle at top right, rgba(75, 129, 145, 0.12), transparent 45%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  [data-theme="dark"] .aqs-directory-hero {
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
      radial-gradient(circle at top right, rgba(122, 195, 196, 0.08), transparent 45%);
  }

  .aqs-directory-spotlight {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    align-items: start;
  }

  .aqs-directory-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.68rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aqs-sea);
  }

  .aqs-directory-spotlight-copy h3,
  .aqs-directory-spotlight-copy p {
    margin: 0;
  }

  .aqs-directory-spotlight-copy h3 {
    font-family: var(--font-editorial);
    font-size: 1.18rem;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .aqs-directory-spotlight-copy p {
    margin-top: 0.22rem;
    color: var(--text-secondary);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .aqs-directory-spotlight-stat {
    display: grid;
    justify-items: end;
    gap: 0.16rem;
    text-align: right;
  }

  .aqs-directory-spotlight-stat strong {
    font-family: var(--font-editorial);
    font-size: 1.28rem;
    line-height: 0.95;
  }

  .aqs-directory-spotlight-stat span {
    color: var(--text-secondary);
    font-size: 0.7rem;
    max-width: 6.4rem;
  }

  .aqs-directory-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .aqs-directory-meta-card {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.48);
    padding: 0.52rem 0.6rem;
    display: grid;
    gap: 0.1rem;
  }

  [data-theme="dark"] .aqs-directory-meta-card {
    background: rgba(255, 255, 255, 0.025);
  }

  .aqs-directory-meta-card strong {
    font-family: var(--font-editorial);
    font-size: 0.94rem;
  }

  .aqs-directory-meta-card span {
    color: var(--text-secondary);
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .aqs-list-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  .aqs-list-controls,
  .aqs-control-group {
    display: grid;
    gap: 0.5rem;
  }

  .aqs-list-controls {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.38);
    padding: 0.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  [data-theme="dark"] .aqs-list-controls {
    background: rgba(255, 255, 255, 0.02);
  }

  .aqs-list-note {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.72rem;
    line-height: 1.35;
    padding-inline: 0.05rem;
  }

  .aqs-quick-picks {
    display: grid;
    gap: 0.35rem;
  }

  .aqs-quick-pick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .aqs-quick-pick {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.5);
    color: inherit;
    font: inherit;
    padding: 0.5rem 0.48rem;
    display: grid;
    gap: 0.1rem;
    text-align: left;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }

  .aqs-quick-pick:hover {
    transform: translateY(-1px);
  }

  .aqs-quick-pick.is-active {
    border-color: rgba(31, 94, 97, 0.45);
    background: rgba(31, 94, 97, 0.12);
  }

  .aqs-quick-pick span {
    font-size: 0.68rem;
    color: var(--text-secondary);
    line-height: 1.2;
  }

  .aqs-quick-pick strong {
    font-family: var(--font-editorial);
    font-size: 0.92rem;
    line-height: 0.95;
  }

  .aqs-control-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  .aqs-chip-switch,
  .aqs-list-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .aqs-chip-button,
  .aqs-inline-chip {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.5);
    color: inherit;
    font: inherit;
    font-size: 0.76rem;
  }

  [data-theme="dark"] .aqs-chip-button,
  [data-theme="dark"] .aqs-inline-chip {
    background: rgba(255, 255, 255, 0.03);
  }

  .aqs-chip-button {
    padding: 0.38rem 0.5rem;
    font-size: 0.69rem;
  }

  .aqs-chip-button.is-active {
    background: rgba(31, 94, 97, 0.14);
    border-color: rgba(31, 94, 97, 0.45);
    color: var(--aqs-ink);
  }

  .aqs-inline-chip {
    padding: 0.22rem 0.5rem;
  }

  .aqs-inline-chip.is-fallback {
    border-style: dashed;
  }

  .aqs-directory-scroll {
    overflow: auto;
    display: grid;
    gap: 0.9rem;
    padding: 0.7rem 0.85rem 0.85rem;
  }

  .aqs-directory-section {
    display: grid;
    gap: 0.55rem;
  }

  .aqs-directory-section-header {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin: 0 -0.2rem;
    padding: 0.55rem 0.2rem 0.45rem;
    background:
      linear-gradient(180deg, rgba(245, 241, 232, 1), rgba(245, 241, 232, 0.99)),
      var(--aqs-panel);
    border-bottom: 1px solid rgba(22, 51, 52, 0.08);
    box-shadow: 0 10px 18px -18px rgba(22, 51, 52, 0.5);
  }

  [data-theme="dark"] .aqs-directory-section-header {
    background:
      linear-gradient(180deg, rgba(27, 31, 30, 1), rgba(27, 31, 30, 0.99)),
      var(--aqs-panel);
  }

  .aqs-directory-section-header strong {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--aqs-sea);
  }

  .aqs-directory-section-header span,
  .aqs-directory-section-header small {
    color: var(--text-secondary);
    font-size: 0.74rem;
  }

  .aqs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  .aqs-list-item {
    width: 100%;
    text-align: left;
    padding: 0.7rem 0.74rem 0.68rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    cursor: pointer;
    border-left: none;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .aqs-list-item.is-active {
    border-color: rgba(31, 94, 97, 0.45);
    background:
      linear-gradient(180deg, rgba(31, 94, 97, 0.14), rgba(31, 94, 97, 0.08)),
      rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 28px -24px rgba(22, 51, 52, 0.34);
  }

  .aqs-list-item:hover {
    transform: translateY(-1px);
  }

  .aqs-list-item:focus,
  .aqs-list-item:focus-visible,
  .aqs-mode-button:focus,
  .aqs-mode-button:focus-visible,
  .aqs-chip-button:focus,
  .aqs-chip-button:focus-visible,
  .aqs-related-button:focus,
  .aqs-related-button:focus-visible,
  .aqs-map-feature:focus,
  .aqs-map-feature:focus-visible {
    outline: none;
  }

  .aqs-list-rank {
    min-width: 2rem;
    min-height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(31, 94, 97, 0.2);
    background: rgba(31, 94, 97, 0.08);
    color: var(--aqs-sea);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .aqs-list-body {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .aqs-list-headline,
  .aqs-list-meta-row,
  .aqs-list-subline {
    display: flex;
    justify-content: space-between;
    gap: 0.55rem;
    align-items: center;
  }

  .aqs-list-meta {
    color: var(--text-secondary);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .aqs-list-name,
  .aqs-stat-value,
  .aqs-detail-title {
    font-family: var(--font-editorial);
  }

  .aqs-list-name {
    font-size: 0.94rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .aqs-list-stress {
    border-radius: 999px;
    padding: 0.16rem 0.44rem;
    font-size: 0.66rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .aqs-list-stress--critical {
    background: rgba(165, 73, 53, 0.14);
    color: var(--aqs-clay);
  }

  .aqs-list-stress--pressure {
    background: rgba(193, 119, 84, 0.14);
    color: #a25e41;
  }

  .aqs-list-stress--balanced {
    background: rgba(111, 141, 109, 0.16);
    color: #5f735e;
  }

  .aqs-list-stress--recharge {
    background: rgba(75, 129, 145, 0.14);
    color: var(--aqs-river);
  }

  .aqs-list-track {
    width: 100%;
    height: 0.35rem;
    border-radius: 999px;
    background: rgba(22, 51, 52, 0.08);
    overflow: hidden;
  }

  .aqs-list-track-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
  }

  .aqs-list-track-fill--critical,
  .aqs-list-track-fill--pressure {
    background: linear-gradient(90deg, #d38b6f, var(--aqs-clay));
  }

  .aqs-list-track-fill--balanced {
    background: linear-gradient(90deg, #a3b39e, var(--aqs-moss));
  }

  .aqs-list-track-fill--recharge {
    background: linear-gradient(90deg, #9ec1cd, var(--aqs-river));
  }

  .aqs-list-subline {
    color: var(--text-secondary);
    font-size: 0.68rem;
  }

  .aqs-map-panel {
    padding: 1rem;
    position: relative;
  }

  .aqs-map-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 0.8rem;
  }

  .aqs-map-caption,
  .aqs-map-footnote {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .aqs-legend {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .aqs-map-legend-wrap {
    display: grid;
    gap: 0.55rem;
    justify-items: end;
  }

  .aqs-legend-bar {
    width: 7rem;
    height: 0.7rem;
    background: linear-gradient(90deg, var(--aqs-river), var(--aqs-sand) 50%, var(--aqs-clay));
    border: 1px solid var(--aqs-border);
  }

  .aqs-outline-key {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .aqs-outline-key-line {
    width: 1.8rem;
    border-top: 2px dashed rgba(20, 36, 37, 0.72);
  }

  .aqs-map-wrap {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.6), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.34), transparent 80%);
    border: 1px solid var(--aqs-border);
    min-height: 32rem;
  }

  .aqs-map {
    display: block;
    width: 100%;
    height: auto;
  }

  .aqs-map-feature {
    stroke: rgba(20, 36, 37, 0.42);
    stroke-width: 1.4;
    transition: opacity 0.18s ease, stroke 0.18s ease, transform 0.18s ease, filter 0.18s ease;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .aqs-map-feature.is-fallback {
    stroke-dasharray: 7 4;
  }

  .aqs-map-feature.is-selected,
  .aqs-map-feature.is-hovered,
  .aqs-map-feature:focus-visible {
    stroke: var(--aqs-ink);
    stroke-width: 2.4;
    filter: drop-shadow(0 0 0.45rem rgba(31, 94, 97, 0.32));
  }

  .aqs-tooltip {
    position: absolute;
    transform: translate(-50%, -118%);
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.7rem;
    background: rgba(19, 27, 27, 0.92);
    color: #f7f5ef;
    pointer-events: none;
    font-size: 0.82rem;
  }

  .aqs-tooltip small {
    color: rgba(247, 245, 239, 0.72);
  }

  .aqs-detail-panel {
    padding: 1rem;
  }

  .aqs-detail-header {
    margin-bottom: 1rem;
  }

  .aqs-detail-title {
    margin: 0 0 0.55rem;
    font-size: 2rem;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .aqs-detail-summary,
  .aqs-source-line span,
  .aqs-badge span,
  .aqs-mode-note p {
    color: var(--text-secondary);
  }

  .aqs-stat {
    border-top: 1px solid var(--aqs-border);
    border-bottom: 1px solid var(--aqs-border);
    padding: 1rem 0;
    display: grid;
    gap: 0.2rem;
  }

  .aqs-stat-label,
  .aqs-stat-subline {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .aqs-stat-value {
    font-size: clamp(2rem, 1.4rem + 1vw, 2.8rem);
    line-height: 0.98;
  }

  .aqs-meta-row {
    display: grid;
    gap: 0.8rem;
    margin: 1rem 0;
  }

  .aqs-kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .aqs-kpi-card {
    border: 1px solid var(--aqs-border);
    background: rgba(255, 255, 255, 0.45);
    padding: 0.8rem;
    display: grid;
