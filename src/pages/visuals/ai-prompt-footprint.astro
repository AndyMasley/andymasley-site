  .aipf-step:hover { color: var(--accent); }
  .aipf-count {
    width: 4.5ch; border: none; background: transparent;
    color: var(--text); text-align: center; font-family: var(--font-body); font-size: 0.88rem;
    font-variant-numeric: tabular-nums; padding: 0.1rem 0;
  }
  .aipf-count:focus-visible { outline: none; }

  .aipf-addrow {
    margin: 0.9rem 0 0; background: none; border: none; padding: 0; color: var(--accent);
    font-family: var(--font-body); font-size: 0.82rem; cursor: pointer;
