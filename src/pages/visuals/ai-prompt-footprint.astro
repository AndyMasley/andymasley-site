    const WPM = 238;

    const PRESETS = [
      { id: 'casual', name: 'Casual', rows: [['gemini-3.5-flash', 'chat', 3], ['gpt-5.5', 'chat', 2]] },
      { id: 'daily',  name: 'Daily user', rows: [['gpt-5.5', 'chat', 15], ['claude-sonnet-4-6', 'chat', 8], ['gemini-3.5-flash', 'summary', 4]] },
      { id: 'power',  name: 'Power user', rows: [['gpt-5.5', 'chat', 40], ['claude-opus-4-8', 'report', 5], ['gemini-3.1-pro-preview', 'long', 2]] },
      { id: 'dev',    name: 'Developer', rows: [['claude-opus-4-8', 'agent', 8], ['gpt-5.5', 'report', 6], ['claude-sonnet-4-6', 'chat', 30]] },
      { id: 'worst',  name: "Skeptic's worst case", rows: [['gpt-5.5-pro', 'agent', 5], ['gpt-5.5', 'novel', 1], ['gemini-3.1-pro-preview', 'long', 10]] },
    ];

    // ---- Personal footprint reference data ----
    // Carbon kg CO2e / YEAR; Water US gallons / YEAR; grid g CO2e / kWh.
    const WORLD_GRID = 590.4;
    const LOCATIONS = [
      { id: 'us',    label: 'United States',  c: 11000, w: 91000, grid: 380 },
      { id: 'eu',    label: 'European Union', c: 5000,  w: 55000, grid: 250 },
      { id: 'uk',    label: 'United Kingdom', c: 4500,  w: 47000, grid: 200 },
      { id: 'cn',    label: 'China',          c: 6000,  w: 55000, grid: 540 },
      { id: 'in',    label: 'India',          c: 1600,  w: 44000, grid: 630 },
      { id: 'world', label: 'World average',  c: 3500,  w: 55000, grid: WORLD_GRID },
    ];
    const DIETS = [
      { id: 'heavy', label: 'Heavy meat',          c: 3200, w: 547000 },
      { id: 'avg',   label: 'Average (some meat)',  c: 2500, w: 401000 },
      { id: 'light', label: 'Light meat',           c: 2000, w: 328000 },
      { id: 'pesc',  label: 'Pescatarian',          c: 1700, w: 292000 },
      { id: 'veg',   label: 'Vegetarian',           c: 1500, w: 237000 },
      { id: 'vegan', label: 'Vegan',                c: 1050, w: 164000 },
    ];
    const FLYING = [
      { id: 'never', label: 'Never fly',                  c: 0,    w: 0 },
      { id: 'rare',  label: 'Rarely (1 short flight/yr)', c: 560,  w: 0 },
      { id: 'some',  label: 'Sometimes (a few/yr)',       c: 2300, w: 0 },
      { id: 'often', label: 'Often (monthly flights)',    c: 8000, w: 0 },
    ];

    // Comparison items. carbon kg; water gal.
    const DAILY_ITEMS = [
      { label: 'A cup of coffee',          c: 0.21, w: 35 },
      { label: 'An hour on a PS5',         c: 0.08, w: 0.1 },
      { label: 'A mile in a gas car',      c: 0.40, w: 0.1 },
      { label: 'A 10-minute hot shower',   c: 0.5,  w: 25 },
      { label: 'Printing a 400-page book', c: 2.5,  w: 300 },
      { label: 'A beef burger',            c: 3.0,  w: 460 },
    ];
    const ANNUAL_ITEMS = [
      { label: 'A new pair of jeans',              c: 33,   w: 2110 },
      { label: 'A new smartphone',                 c: 70,   w: 3190 },
      { label: 'Switching to a vegan diet (1 yr)', c: 1450, w: 237000 },
      { label: 'One transatlantic flight',         c: 1760, w: 5 },
      { label: 'A year of driving (12,000 mi)',    c: 4800, w: 50 },
    ];

    const GAL_TO_L = 3.785411784;
    const DAYS = 365;

    // ---- State ----
    let uidSeq = 1;
    const state = {
      rows: [],
      metric: 'carbon',
      loc: 'us', diet: 'avg', fly: 'some',
      preset: 'daily',
    };

    let root = null;
    const getModel = (id) => MODELS.find((m) => m.id === id) || MODELS[0];
    const getLoc = () => LOCATIONS.find((x) => x.id === state.loc) || LOCATIONS[0];
    const gridFactor = () => getLoc().grid / WORLD_GRID;

    // ---- Formatting ----
    function fmtNum(n) {
      if (n >= 100) return Math.round(n).toLocaleString('en-US');
      if (n >= 10) return n.toFixed(1);
      if (n >= 1) return n.toFixed(2);
      if (n >= 0.01) return n.toFixed(3);
      return n > 0 ? n.toPrecision(2) : '0';
    }
    function fmtCarbon(g) {
      if (g >= 1e6) return fmtNum(g / 1e6) + ' t CO₂e';
      if (g >= 1000) return fmtNum(g / 1000) + ' kg CO₂e';
      return fmtNum(g) + ' g CO₂e';
    }
    function fmtWater(l) {
      if (l >= 3785) return fmtNum(l / GAL_TO_L) + ' gal';
      if (l >= 1) return fmtNum(l) + ' L';
      return fmtNum(l * 1000) + ' mL';
    }
    const fmtMetric = (v) => (state.metric === 'carbon' ? fmtCarbon(v) : fmtWater(v));
    const metricWord = () => (state.metric === 'carbon' ? 'carbon' : 'water');
    function fmtEnergy(wh) { return wh >= 1000 ? fmtNum(wh / 1000) + ' kWh' : fmtNum(wh) + ' Wh'; }

    // ---- Math (base units: carbon grams, water liters) ----
    // returns [mean, min, max] in base units for one prompt
    function perPromptTriple(model, size, metric) {
      const s = model.sizes[size];
      if (metric === 'carbon') {
        const gf = gridFactor();
        return [s.g * gf, s.gmin * gf, s.gmax * gf];
      }
      return [s.ml / 1000, s.mlmin / 1000, s.mlmax / 1000];
    }
    function totalPrompts() {
      let n = 0;
      for (const r of state.rows) n += r.count || 0;
      return n;
    }
    function aiDailyTriple(metric) {
      let a = 0, b = 0, c = 0;
      for (const r of state.rows) {
        if (!r.count) continue;
        const t = perPromptTriple(getModel(r.model), r.size, metric);
        a += r.count * t[0]; b += r.count * t[1]; c += r.count * t[2];
      }
      return [a, b, c];
    }
    const aiDaily = (metric) => aiDailyTriple(metric)[0];
    function aiDailyEnergy() {
      let t = 0;
      for (const r of state.rows) if (r.count) t += r.count * getModel(r.model).sizes[r.size].wh;
      return t;
    }
    function dailyFootprint(metric) {
      const loc = getLoc();
      const diet = DIETS.find((x) => x.id === state.diet);
      const fly = FLYING.find((x) => x.id === state.fly);
      if (metric === 'carbon') return ((loc.c + diet.c + fly.c) * 1000) / DAYS;
      return ((loc.w + diet.w + fly.w) * GAL_TO_L) / DAYS;
    }
    function itemBase(item, metric) {
      return metric === 'carbon' ? item.c * 1000 : item.w * GAL_TO_L;
    }
    function dailyWords() {
      let n = 0;
      for (const r of state.rows) if (r.count) n += r.count * (SIZES.find((s) => s.id === r.size) || { w: 0 }).w;
      return n;
    }
    function fmtWords(n) {
      if (n >= 1e6) return fmtNum(n / 1e6) + ' million';
      return Math.round(n).toLocaleString('en-US');
    }
    function fmtReadingTime(minutes) {
      if (minutes < 1) return 'under a minute';
      if (minutes < 90) { const m = Math.round(minutes); return 'about ' + m + ' minute' + (m === 1 ? '' : 's'); }
      const hours = minutes / 60;
      if (hours < 48) return 'about ' + fmtNum(hours) + ' hours';
      const days = hours / 24;
      if (days < 14) return 'about ' + fmtNum(days) + ' days';
      const weeks = days / 7;
      if (weeks < 9) return 'about ' + fmtNum(weeks) + ' weeks';
      const months = days / 30.44;
      if (months < 18) return 'about ' + fmtNum(months) + ' months';
      return 'about ' + fmtNum(days / 365) + ' years';
    }

    // ---- DOM helpers ----
    function el(tag, cls, html) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (html != null) e.innerHTML = html;
      return e;
    }
    function option(value, text, selected) {
      const o = document.createElement('option');
      o.value = value; o.textContent = text;
      if (selected) o.selected = true;
      return o;
    }

    // ---- URL state ----
    function syncURL() {
      try {
        const r = state.rows.map((row) => {
          const mi = MODELS.findIndex((m) => m.id === row.model);
          const si = SIZES.findIndex((s) => s.id === row.size);
          return mi + '-' + si + '-' + (row.count || 0);
        }).join('.');
        const p = new URLSearchParams();
        p.set('k', state.metric); p.set('l', state.loc); p.set('d', state.diet);
        p.set('f', state.fly); p.set('r', r);
        history.replaceState(null, '', '#' + p.toString());
      } catch (e) { /* ignore */ }
    }
    function readURL() {
      try {
        const h = (location.hash || '').replace(/^#/, '');
        if (!h) return false;
        const p = new URLSearchParams(h);
        const k = p.get('k'); if (k === 'carbon' || k === 'water') state.metric = k;
        const l = p.get('l'); if (l && LOCATIONS.some((x) => x.id === l)) state.loc = l;
        const d = p.get('d'); if (d && DIETS.some((x) => x.id === d)) state.diet = d;
        const f = p.get('f'); if (f && FLYING.some((x) => x.id === f)) state.fly = f;
        const r = p.get('r');
        if (r) {
          const rows = [];
          for (const part of r.split('.')) {
            const a = part.split('-').map(Number);
            if (MODELS[a[0]] && SIZES[a[1]] && a[2] >= 0) {
              rows.push({ uid: uidSeq++, model: MODELS[a[0]].id, size: SIZES[a[1]].id, count: Math.min(100000, a[2]) });
            }
          }
          if (rows.length) { state.rows = rows; state.preset = null; }
        }
        return true;
      } catch (e) { return false; }
    }

    // ---- Presets ----
    function applyPreset(id) {
      const p = PRESETS.find((x) => x.id === id);
      if (!p) return;
      state.rows = p.rows.map((r) => ({ uid: uidSeq++, model: r[0], size: r[1], count: r[2] }));
      state.preset = id;
      renderPresets();
      renderRows();
      updateOutputs();
    }
    function renderPresets() {
      const wrap = root.querySelector('#aipf-presets');
      wrap.innerHTML = '';
      wrap.appendChild(el('span', 'aipf-presets-label', 'Start from'));
      for (const p of PRESETS) {
        const b = el('button', 'aipf-preset' + (state.preset === p.id ? ' is-active' : ''), p.name);
        b.type = 'button';
        b.addEventListener('click', () => applyPreset(p.id));
        wrap.appendChild(b);
      }
    }

    // ---- Usage rows ----
    function modelSelect(row) {
      const sel = el('select', 'aipf-row-model');
      sel.setAttribute('aria-label', 'Model');
      const groups = [];
      for (const m of MODELS) {
        let g = groups.find((x) => x.name === m.group);
        if (!g) { g = { name: m.group, items: [] }; groups.push(g); }
        g.items.push(m);
      }
      for (const g of groups) {
        const og = document.createElement('optgroup');
        og.label = g.name;
        for (const m of g.items) og.appendChild(option(m.id, m.name, m.id === row.model));
        sel.appendChild(og);
      }
      sel.addEventListener('change', () => { row.model = sel.value; markCustom(); updateOutputs(); });
      return sel;
    }
    function sizeSelect(row) {
      const sel = el('select', 'aipf-row-size');
      sel.setAttribute('aria-label', 'Typical output length');
      for (const s of SIZES) sel.appendChild(option(s.id, s.label + ' (' + s.words + ')', s.id === row.size));
      sel.addEventListener('change', () => { row.size = sel.value; markCustom(); updateOutputs(); });
      return sel;
    }
    function stepper(row) {
      const ctrl = el('div', 'aipf-stepper');
      const minus = el('button', 'aipf-step', '−'); minus.type = 'button'; minus.setAttribute('aria-label', 'Fewer');
      const input = document.createElement('input');
      input.type = 'text'; input.inputMode = 'numeric'; input.className = 'aipf-count';
      input.value = String(row.count || 0); input.setAttribute('aria-label', 'Per day');
      const plus = el('button', 'aipf-step', '+'); plus.type = 'button'; plus.setAttribute('aria-label', 'More');
      minus.addEventListener('click', () => bump(row, input, -1));
      plus.addEventListener('click', () => bump(row, input, 1));
      input.addEventListener('input', () => {
        row.count = Math.max(0, Math.min(100000, parseInt(input.value.replace(/[^0-9]/g, ''), 10) || 0));
        markCustom(); updateOutputs();
      });
      input.addEventListener('blur', () => { input.value = String(row.count || 0); });
      ctrl.appendChild(minus); ctrl.appendChild(input); ctrl.appendChild(plus);
      return ctrl;
    }
    function bump(row, input, dir) {
      const cur = row.count || 0;
      let step = 1;
      if (cur >= 50) step = 10; else if (cur >= 20) step = 5;
      let next = cur + dir * step;
      if (dir < 0 && cur > 0 && cur <= step) next = 0;
      row.count = Math.max(0, Math.min(100000, next));
      input.value = String(row.count);
      markCustom(); updateOutputs();
    }
    function markCustom() {
      if (state.preset !== null) { state.preset = null; renderPresets(); }
    }

    function renderRows() {
      const wrap = root.querySelector('#aipf-rows');
      wrap.innerHTML = '';
      for (const row of state.rows) {
        const wrapEl = el('div', 'aipf-rowwrap');
        wrapEl.dataset.uid = String(row.uid);
        const r = el('div', 'aipf-row');
        r.appendChild(modelSelect(row));
        r.appendChild(sizeSelect(row));
        r.appendChild(stepper(row));
        const rm = el('button', 'aipf-rowdel', '×');
        rm.type = 'button';
        rm.setAttribute('aria-label', 'Remove this row');
        rm.addEventListener('click', () => {
          state.rows = state.rows.filter((x) => x.uid !== row.uid);
          markCustom();
          renderRows();
          updateOutputs();
        });
        r.appendChild(rm);
        wrapEl.appendChild(r);
        wrapEl.appendChild(el('div', 'aipf-row-meta'));
        wrap.appendChild(wrapEl);
      }
      if (!state.rows.length) {
        wrap.appendChild(el('p', 'aipf-empty', 'No usage yet — pick a profile above or add a kind of use.'));
      }
    }
    function updateRowMeta() {
      const total = aiDaily(state.metric);
      for (const row of state.rows) {
        const wrapEl = root.querySelector('.aipf-rowwrap[data-uid="' + row.uid + '"] .aipf-row-meta');
        if (!wrapEl) continue;
        const per = perPromptTriple(getModel(row.model), row.size, state.metric)[0];
        const contr = (row.count || 0) * per;
        const share = total > 0 ? (contr / total) * 100 : 0;
        const shareStr = share >= 10 ? Math.round(share) : share.toFixed(1);
        wrapEl.textContent = '≈ ' + fmtMetric(per) + ' each → ' + fmtMetric(contr) + '/day · ' + shareStr + '% of your AI ' + metricWord();
      }
    }

    function renderLifeSelects() {
      function fill(id, list, cur) {
        const sel = root.querySelector(id);
        sel.innerHTML = '';
        for (const x of list) sel.appendChild(option(x.id, x.label, x.id === cur));
      }
      fill('#aipf-loc', LOCATIONS, state.loc);
      fill('#aipf-diet', DIETS, state.diet);
      fill('#aipf-fly', FLYING, state.fly);
    }

    // ---- Outputs ----
    function renderRunning() {
      const box = root.querySelector('#aipf-running');
      const n = totalPrompts();
      const cD = aiDaily('carbon'), wD = aiDaily('water'), eD = aiDailyEnergy();
      box.innerHTML =
        '<div class="aipf-running-n">' + n.toLocaleString('en-US') + ' prompt' + (n === 1 ? '' : 's') + ' a day</div>' +
        '<div class="aipf-totals">' +
          totalCol('Per day', eD, cD, wD) +
          totalCol('Per year', eD * DAYS, cD * DAYS, wD * DAYS) +
        '</div>';
    }
    function totalCol(label, wh, c, w) {
      return '<div class="aipf-totcol">' +
        '<div class="aipf-totcol-h">' + label + '</div>' +
        '<div class="aipf-totline"><span>' + fmtEnergy(wh) + '</span><span>energy</span></div>' +
        '<div class="aipf-totline"><span>' + fmtCarbon(c) + '</span><span>carbon</span></div>' +
        '<div class="aipf-totline"><span>' + fmtWater(w) + '</span><span>water</span></div>' +
        '</div>';
    }

    function renderHeadline() {
      const box = root.querySelector('#aipf-headline');
      const t = aiDailyTriple(state.metric);
      const ai = t[0];
      const day = dailyFootprint(state.metric);
      const pct = day > 0 ? (ai / day) * 100 : 0;
      let pctStr;
      if (pct >= 1) pctStr = pct.toFixed(pct >= 10 ? 0 : 1) + '%';
      else if (pct >= 0.01) pctStr = pct.toFixed(2) + '%';
      else if (pct > 0) pctStr = '<0.01%';
      else pctStr = '0%';
      box.innerHTML =
        '<p class="aipf-result-lead">Your daily AI ' + metricWord() + ' — ' + fmtMetric(ai) +
          ' <span class="aipf-range">(range ' + fmtMetric(t[1]) + ' – ' + fmtMetric(t[2]) + ')</span> — is</p>' +
        '<p class="aipf-result-big">' + pctStr + '</p>' +
        '<p class="aipf-result-lead">of your daily ' + metricWord() + ' footprint, ' + fmtMetric(day) + '.</p>' +
        '<div class="aipf-prop"><div class="aipf-prop-fill" style="width:' + Math.max(0.4, Math.min(100, pct)).toFixed(2) + '%"></div></div>' +
        '<p class="aipf-prop-cap">the bar is one day of your life; the fill is your AI use</p>';
    }

    function renderOnePct() {
      const box = root.querySelector('#aipf-onepct');
      const day = dailyFootprint(state.metric);
      const onePct = day * 0.01;
      const n = totalPrompts();
      const ai = aiDaily(state.metric);
      const avgPer = n > 0 ? ai / n : null;
      if (avgPer && avgPer > 0) {
        box.innerHTML =
          '<span class="aipf-onepct-num">' + Math.round(onePct / avgPer).toLocaleString('en-US') +
          '</span> prompts at your current mix would add up to <strong>1%</strong> of your daily ' + metricWord() + ' footprint.';
      } else {
        const m = getModel('gpt-5.5');
        box.innerHTML =
          'Add some use above. For reference, <span class="aipf-onepct-num">' +
          Math.round(onePct / perPromptTriple(m, 'chat', state.metric)[0]).toLocaleString('en-US') +
          '</span> GPT-5.5 chatbot replies would equal <strong>1%</strong> of your daily ' + metricWord() + ' footprint.';
      }
    }

    function renderGridNote() {
      const box = root.querySelector('#aipf-grid-note');
      if (state.metric === 'carbon') {
        box.style.display = '';
        box.textContent = 'AI carbon is estimated on the ' + getLoc().label + ' electricity grid.';
      } else {
        box.style.display = 'none';
      }
    }

    function renderWords() {
      const box = root.querySelector('#aipf-words');
      const wd = dailyWords();
      if (wd <= 0) {
        box.innerHTML = 'Add some use above to see how many words your AI is writing for you.';
        return;
      }
      const wy = wd * DAYS;
      box.innerHTML =
        'Your AI writes about <strong>' + fmtWords(wd) + ' words a day</strong> for you — roughly <strong>' +
        fmtWords(wy) + ' words a year</strong>. Read end to end at the average American pace (' + WPM +
        ' words a minute), that is <strong>' + fmtReadingTime(wd / WPM) + '</strong> of reading a day, or <strong>' +
        fmtReadingTime(wy / WPM) + '</strong> of nonstop reading over a year.';
    }

    function renderBars(targetId, focalLabel, focalVal, items) {
      const rows = [{ label: focalLabel, v: focalVal, focal: true }];
      for (const it of items) rows.push({ label: it.label, v: itemBase(it, state.metric), focal: false });
      rows.sort((a, b) => b.v - a.v);
      const max = Math.max.apply(null, rows.map((r) => r.v).concat([1e-9]));
      const box = root.querySelector(targetId);
      box.innerHTML = '';
      for (const r of rows) {
        const row = el('div', 'aipf-bar-row' + (r.focal ? ' is-focal' : ''));
        row.appendChild(el('div', 'aipf-bar-label', r.label));
        const track = el('div', 'aipf-bar-track');
        const fill = el('div', 'aipf-bar-fill');
        fill.style.width = Math.max(0.4, (r.v / max) * 100).toFixed(2) + '%';
        track.appendChild(fill);
        row.appendChild(track);
        row.appendChild(el('div', 'aipf-bar-val', fmtMetric(r.v)));
        box.appendChild(row);
      }
    }

    function renderDaily() {
      const ai = aiDaily(state.metric);
      root.querySelector('#aipf-daily-sub').innerHTML =
        'A day of your AI use is <strong>' + fmtMetric(ai) + '</strong>. Green is your AI; bars are to scale.';
      renderBars('#aipf-daily-bars', 'Your daily AI use', ai, DAILY_ITEMS);
    }
    function renderAnnual() {
      const aiYr = aiDaily(state.metric) * DAYS;
      root.querySelector('#aipf-annual-sub').innerHTML =
        'A year of your AI use is <strong>' + fmtMetric(aiYr) + '</strong> — set against bigger, less frequent choices.';
      renderBars('#aipf-annual-bars', 'A year of your AI use', aiYr, ANNUAL_ITEMS);
    }

    function updateOutputs() {
      renderRunning();
      updateRowMeta();
      renderHeadline();
      renderOnePct();
      renderGridNote();
      renderWords();
      renderDaily();
      renderAnnual();
      syncURL();
    }

    function renderMetricToggle() {
      root.querySelectorAll('.aipf-metric').forEach((b) => {
        const on = b.dataset.metric === state.metric;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function bindEvents() {
      root.querySelector('#aipf-addrow').addEventListener('click', () => {
        state.rows.push({ uid: uidSeq++, model: 'gpt-5.5', size: 'chat', count: 1 });
        markCustom();
        renderRows();
        updateOutputs();
      });
      root.querySelector('#aipf-reset').addEventListener('click', () => applyPreset('daily'));
      root.querySelector('#aipf-share').addEventListener('click', (e) => {
        const btn = e.currentTarget;
        const done = () => { btn.textContent = 'Link copied'; setTimeout(() => { btn.textContent = 'Copy link to this estimate'; }, 1800); };
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(location.href).then(done, done);
          else done();
        } catch (err) { done(); }
      });
      root.querySelector('#aipf-loc').addEventListener('change', (e) => { state.loc = e.target.value; updateOutputs(); });
      root.querySelector('#aipf-diet').addEventListener('change', (e) => { state.diet = e.target.value; updateOutputs(); });
      root.querySelector('#aipf-fly').addEventListener('change', (e) => { state.fly = e.target.value; updateOutputs(); });
      root.querySelectorAll('.aipf-metric').forEach((b) => {
        b.addEventListener('click', () => {
          state.metric = b.dataset.metric;
          renderMetricToggle();
          updateOutputs();
        });
      });
    }

    function init() {
      root = document.getElementById('aipf');
      if (!root || root.dataset.ready === '1') return;
      root.dataset.ready = '1';
      applyPresetSilently('daily');
      readURL();
      renderPresets();
      renderRows();
      renderLifeSelects();
      renderMetricToggle();
      bindEvents();
      updateOutputs();
    }
    function applyPresetSilently(id) {
      const p = PRESETS.find((x) => x.id === id);
