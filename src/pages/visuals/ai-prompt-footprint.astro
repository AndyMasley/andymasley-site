1724},"report":{"wh":0.3508,"g":0.0316,"ml":2.143}}},{"id":"command-a-plus-05-2026","name":"Command A+","group":"Cohere","sizes":{"tweet":{"wh":0.0857,"g":0.0362,"ml":0.3471},"email":{"wh":0.2835,"g":0.118,"ml":1.1476},"summary":{"wh":0.4153,"g":0.1725,"ml":1.6813},"chat":{"wh":0.6624,"g":0.2748,"ml":2.6819},"report":{"wh":8.2417,"g":3.4118,"ml":33.3677}}}];

    const PROMPT_SIZES = [
      { id: 'tweet', label: 'a tweet', tokens: 50 },
      { id: 'email', label: 'an email', tokens: 170 },
      { id: 'summary', label: 'an article summary', tokens: 250 },
      { id: 'chat', label: 'a chatbot reply', tokens: 400 },
      { id: 'report', label: 'a 5-page report', tokens: 5000 },
    ];

    // ---- Personal footprint reference data ----
    // Carbon in kg CO2e per YEAR. Water in US gallons per YEAR.
    const LOCATIONS = [
      // base = home energy + transport + goods, excludes food & flights
      { id: 'us',    label: 'United States',  c: 11000, w: 91000 },
      { id: 'eu',    label: 'European Union', c: 5000,  w: 55000 },
      { id: 'uk',    label: 'United Kingdom', c: 4500,  w: 47000 },
      { id: 'cn',    label: 'China',          c: 6000,  w: 55000 },
      { id: 'in',    label: 'India',          c: 1600,  w: 44000 },
      { id: 'world', label: 'World average',  c: 3500,  w: 55000 },
    ];
    const DIETS = [
      { id: 'heavy', label: 'Heavy meat',         c: 3200, w: 547000 },
      { id: 'avg',   label: 'Average (some meat)', c: 2500, w: 401000 },
      { id: 'light', label: 'Light meat',          c: 2000, w: 328000 },
      { id: 'pesc',  label: 'Pescatarian',         c: 1700, w: 292000 },
      { id: 'veg',   label: 'Vegetarian',          c: 1500, w: 237000 },
      { id: 'vegan', label: 'Vegan',               c: 1050, w: 164000 },
    ];
    const FLYING = [
      { id: 'never', label: 'Never fly',                  c: 0,    w: 0 },
      { id: 'rare',  label: 'Rarely (1 short flight/yr)', c: 560,  w: 0 },
      { id: 'some',  label: 'Sometimes (a few/yr)',       c: 2300, w: 0 },
      { id: 'often', label: 'Often (monthly flights)',    c: 8000, w: 0 },
    ];

    // Everyday single items. carbon in grams CO2e; water in US gallons.
    const EVERYDAY = {
      carbon: [
        { label: 'A cup of coffee', v: 210 },
        { label: '1 mile in a gas car', v: 400 },
        { label: 'A beef burger', v: 3000 },
      ],
      water: [
        { label: 'A 10-min shower', v: 25 },
        { label: 'A cup of coffee', v: 35 },
        { label: 'A beef burger', v: 460 },
      ],
    };

    const GAL_TO_L = 3.785411784;

    // ---- State ----
    const state = {
      size: 'chat',
      counts: { 'gpt-5.1': 15, 'claude-sonnet-4-6': 8, 'gemini-2.5-flash': 5 },
      metric: 'carbon', // 'carbon' | 'water'
      loc: 'us',
      diet: 'avg',
      fly: 'some',
    };

    let root = null;

    // ---- Formatting ----
    function fmtNum(n) {
      if (n >= 1000) return Math.round(n).toLocaleString('en-US');
      if (n >= 100) return Math.round(n).toLocaleString('en-US');
      if (n >= 10) return n.toFixed(1);
      if (n >= 1) return n.toFixed(2);
      if (n >= 0.01) return n.toFixed(3);
      return n.toPrecision(2);
    }
    // carbon stored in grams -> adaptive
    function fmtCarbon(g) {
      if (g >= 1e6) return fmtNum(g / 1e6) + ' t CO₂e';
      if (g >= 1000) return fmtNum(g / 1000) + ' kg CO₂e';
      return fmtNum(g) + ' g CO₂e';
    }
    // water stored in liters -> adaptive
    function fmtWater(l) {
      if (l >= 3785) return fmtNum(l / GAL_TO_L) + ' gal';
      if (l >= 1) return fmtNum(l) + ' L';
      return fmtNum(l * 1000) + ' mL';
    }
    function fmtMetric(v) {
      return state.metric === 'carbon' ? fmtCarbon(v) : fmtWater(v);
    }
    function metricWord() {
      return state.metric === 'carbon' ? 'carbon' : 'water';
    }

    // ---- Core math (everything in base units: carbon grams, water liters) ----
    function perPrompt(model, metric) {
      const s = model.sizes[state.size];
      if (metric === 'carbon') return s.g;            // grams
      return s.ml / 1000;                              // mL -> liters
    }
    function totalPrompts() {
      let n = 0;
      for (const m of MODELS) n += state.counts[m.id] || 0;
      return n;
    }
    // daily AI total for a metric, in base units
    function aiDaily(metric) {
      let t = 0;
      for (const m of MODELS) {
        const c = state.counts[m.id] || 0;
        if (c) t += c * perPrompt(m, metric);
      }
      return t;
    }
    // personal footprint per DAY, base units
    function dailyFootprint(metric) {
      const loc = LOCATIONS.find((x) => x.id === state.loc);
      const diet = DIETS.find((x) => x.id === state.diet);
      const fly = FLYING.find((x) => x.id === state.fly);
      if (metric === 'carbon') {
        const kgYr = loc.c + diet.c + fly.c;
        return (kgYr * 1000) / 365; // grams/day
      }
      const galYr = loc.w + diet.w + fly.w;
      return (galYr * GAL_TO_L) / 365; // liters/day
    }
    function everydayBase(metric) {
      // returns [{label, v(base units)}]
      if (metric === 'carbon') return EVERYDAY.carbon.map((e) => ({ label: e.label, v: e.v }));
      return EVERYDAY.water.map((e) => ({ label: e.label, v: e.v * GAL_TO_L }));
    }

    // ---- Rendering ----
    function el(tag, cls, html) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (html != null) e.innerHTML = html;
      return e;
    }

    function renderPromptSize() {
      const sel = root.querySelector('#aipf-size');
      sel.innerHTML = '';
      for (const p of PROMPT_SIZES) {
        const o = document.createElement('option');
        o.value = p.id;
        o.textContent = p.label + ' (' + p.tokens.toLocaleString('en-US') + ' words out)';
        if (p.id === state.size) o.selected = true;
        sel.appendChild(o);
      }
    }

    function renderLifeSelects() {
      function fill(id, list, cur) {
        const sel = root.querySelector(id);
        sel.innerHTML = '';
        for (const x of list) {
          const o = document.createElement('option');
          o.value = x.id;
          o.textContent = x.label;
          if (x.id === cur) o.selected = true;
          sel.appendChild(o);
        }
      }
      fill('#aipf-loc', LOCATIONS, state.loc);
      fill('#aipf-diet', DIETS, state.diet);
      fill('#aipf-fly', FLYING, state.fly);
    }

    function renderModelList() {
      const wrap = root.querySelector('#aipf-modellist');
      wrap.innerHTML = '';
      const groups = [];
      for (const m of MODELS) {
        let g = groups.find((x) => x.name === m.group);
        if (!g) { g = { name: m.group, items: [] }; groups.push(g); }
        g.items.push(m);
      }
      for (const g of groups) {
        wrap.appendChild(el('div', 'aipf-group-name', g.name));
        for (const m of g.items) {
          const row = el('div', 'aipf-model-row');
          row.dataset.id = m.id;

          const info = el('div', 'aipf-model-info');
          info.appendChild(el('span', 'aipf-model-name', m.name));
          const pc = m.sizes[state.size].g;
          const pw = m.sizes[state.size].ml;
          info.appendChild(
            el('span', 'aipf-model-per', fmtCarbon(pc) + ' · ' + fmtWater(pw / 1000) + ' each')
          );
          row.appendChild(info);

          const ctrl = el('div', 'aipf-stepper');
          const minus = el('button', 'aipf-step', '−');
          minus.type = 'button';
          minus.setAttribute('aria-label', 'Fewer ' + m.name + ' prompts');
          const input = document.createElement('input');
          input.type = 'text';
          input.inputMode = 'numeric';
          input.className = 'aipf-count';
          input.value = String(state.counts[m.id] || 0);
          input.setAttribute('aria-label', m.name + ' prompts per day');
          const plus = el('button', 'aipf-step', '+');
          plus.type = 'button';
          plus.setAttribute('aria-label', 'More ' + m.name + ' prompts');

          minus.addEventListener('click', () => bump(m.id, -1));
          plus.addEventListener('click', () => bump(m.id, 1));
          input.addEventListener('input', () => {
            const v = Math.max(0, Math.min(100000, parseInt(input.value.replace(/[^0-9]/g, ''), 10) || 0));
            state.counts[m.id] = v;
            updateOutputs();
          });
          input.addEventListener('blur', () => { input.value = String(state.counts[m.id] || 0); });

          ctrl_append(ctrl, minus, input, plus);
          row.appendChild(ctrl);
          wrap.appendChild(row);
        }
      }
    }
    function ctrl_append(ctrl, a, b, c) { ctrl.appendChild(a); ctrl.appendChild(b); ctrl.appendChild(c); }

    function bump(id, dir) {
      const cur = state.counts[id] || 0;
      let step = 1;
      if (cur >= 50) step = 10; else if (cur >= 20) step = 5;
      let next = cur + dir * step;
      if (dir < 0 && cur > 0 && cur <= step) next = 0;
      next = Math.max(0, Math.min(100000, next));
      state.counts[id] = next;
      const row = root.querySelector('.aipf-model-row[data-id="' + cssEsc(id) + '"] .aipf-count');
      if (row) row.value = String(next);
      updateOutputs();
    }
    function cssEsc(s) { return s.replace(/"/g, '\\"'); }

    function updateModelPerLabels() {
      for (const m of MODELS) {
        const row = root.querySelector('.aipf-model-row[data-id="' + cssEsc(m.id) + '"] .aipf-model-per');
        if (row) {
          const pc = m.sizes[state.size].g;
          const pw = m.sizes[state.size].ml;
          row.textContent = fmtCarbon(pc) + ' · ' + fmtWater(pw / 1000) + ' each';
        }
      }
    }

    function renderRunning() {
      const box = root.querySelector('#aipf-running');
      const n = totalPrompts();
      const c = aiDaily('carbon');
      const w = aiDaily('water');
      const wh = (function () { let t = 0; for (const m of MODELS) { const k = state.counts[m.id] || 0; if (k) t += k * m.sizes[state.size].wh; } return t; })();
      box.innerHTML =
        '<div class="aipf-running-n">' + n.toLocaleString('en-US') + ' prompt' + (n === 1 ? '' : 's') + ' a day</div>' +
        '<div class="aipf-running-stats">' +
          '<span><strong>' + fmtNum(wh) + '</strong> Wh</span>' +
          '<span><strong>' + fmtCarbon(c) + '</strong></span>' +
          '<span><strong>' + fmtWater(w) + '</strong></span>' +
        '</div>' +
        '<div class="aipf-running-sub">energy · carbon · water, all your prompts combined, per day</div>';
    }

    function renderHeadline() {
      const box = root.querySelector('#aipf-headline');
      const ai = aiDaily(state.metric);
      const day = dailyFootprint(state.metric);
      const pct = day > 0 ? (ai / day) * 100 : 0;
      let pctStr;
      if (pct >= 1) pctStr = pct.toFixed(pct >= 10 ? 0 : 1) + '%';
      else if (pct >= 0.01) pctStr = pct.toFixed(2) + '%';
      else if (pct > 0) pctStr = '<0.01%';
      else pctStr = '0%';

      box.innerHTML =
        '<p class="aipf-headline-lead">Your daily AI ' + metricWord() + ' is</p>' +
        '<p class="aipf-headline-big">' + pctStr + '</p>' +
        '<p class="aipf-headline-lead">of your daily ' + metricWord() + ' footprint (' + fmtMetric(day) + ').</p>' +
        '<div class="aipf-prop"><div class="aipf-prop-fill" style="width:' + Math.max(0.4, Math.min(100, pct)).toFixed(2) + '%"></div></div>' +
        '<p class="aipf-prop-cap">the full bar is one day of your life; the fill is your AI use</p>';
    }

    function renderOnePct() {
      const box = root.querySelector('#aipf-onepct');
      const day = dailyFootprint(state.metric);
      const onePct = day * 0.01;
      const n = totalPrompts();
      const ai = aiDaily(state.metric);
      const avgPer = n > 0 ? ai / n : null;
      if (avgPer && avgPer > 0) {
        const prompts = onePct / avgPer;
        box.innerHTML =
          '<span class="aipf-onepct-num">' + Math.round(prompts).toLocaleString('en-US') + '</span>' +
          ' prompts at your current mix add up to <strong>1%</strong> of your daily ' + metricWord() + ' footprint.';
        box.style.display = '';
      } else {
        // fall back to an illustrative model
        const m = MODELS.find((x) => x.id === 'gpt-5.1') || MODELS[0];
        const per = perPrompt(m, state.metric);
        const prompts = onePct / per;
        box.innerHTML =
          'Add some prompts above. For reference, <span class="aipf-onepct-num">' +
          Math.round(prompts).toLocaleString('en-US') + '</span> ' + m.name +
          ' prompts would equal <strong>1%</strong> of your daily ' + metricWord() + ' footprint.';
        box.style.display = '';
      }
    }

    function renderBars() {
      const box = root.querySelector('#aipf-bars');
      box.innerHTML = '';
      const ai = aiDaily(state.metric);
      const rows = [{ label: 'Your daily AI use', v: ai, focal: true }];
      for (const e of everydayBase(state.metric)) rows.push({ label: e.label, v: e.v, focal: false });
      rows.sort((a, b) => b.v - a.v);
      const max = Math.max.apply(null, rows.map((r) => r.v).concat([1e-9]));
      for (const r of rows) {
        const row = el('div', 'aipf-bar-row' + (r.focal ? ' is-focal' : ''));
        row.appendChild(el('div', 'aipf-bar-label', r.label));
        const track = el('div', 'aipf-bar-track');
        const fill = el('div', 'aipf-bar-fill');
        fill.style.width = Math.max(0.5, (r.v / max) * 100).toFixed(2) + '%';
        track.appendChild(fill);
        row.appendChild(track);
        row.appendChild(el('div', 'aipf-bar-val', fmtMetric(r.v)));
        box.appendChild(row);
      }
    }

    function updateOutputs() {
      renderRunning();
      renderHeadline();
      renderOnePct();
      renderBars();
    }

    function renderMetricToggle() {
      const btns = root.querySelectorAll('.aipf-metric');
      btns.forEach((b) => {
        const on = b.dataset.metric === state.metric;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function bindEvents() {
      root.querySelector('#aipf-size').addEventListener('change', (e) => {
        state.size = e.target.value;
        updateModelPerLabels();
        updateOutputs();
      });
      root.querySelector('#aipf-loc').addEventListener('change', (e) => { state.loc = e.target.value; updateOutputs(); });
      root.querySelector('#aipf-diet').addEventListener('change', (e) => { state.diet = e.target.value; updateOutputs(); });
      root.querySelector('#aipf-fly').addEventListener('change', (e) => { state.fly = e.target.value; updateOutputs(); });
      root.querySelectorAll('.aipf-metric').forEach((b) => {
        b.addEventListener('click', () => {
          state.metric = b.dataset.metric;
          renderMetricToggle();
          updateOutputs();
        });
      });
      root.querySelector('#aipf-reset').addEventListener('click', () => {
        state.counts = {};
        renderModelList();
        updateOutputs();
      });
    }

    function init() {
      root = document.getElementById('aipf');
      if (!root || root.dataset.ready === '1') return;
      root.dataset.ready = '1';
      renderPromptSize();
      renderLifeSelects();
      renderMetricToggle();
      renderModelList();
      bindEvents();
      updateOutputs();
    }

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

