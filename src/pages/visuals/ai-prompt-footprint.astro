  }
  .aipf-addrow:hover { color: var(--accent-hover); }

  .aipf-running { margin: 1rem 0 0; padding-top: 0.9rem; border-top: 1px solid var(--border); font-size: 0.92rem; line-height: 1.55; color: var(--text-secondary); }
  .aipf-tools { margin: 0.6rem 0 0; font-family: var(--font-body); font-size: 0.78rem; color: var(--dim); }
  .aipf-link { background: none; border: none; padding: 0; font: inherit; color: var(--dim); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
