      if (!row) return;
      const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement;
      if (cb) cb.checked = true;
      if (inputVal !== undefined) {
        const input = row.querySelector('.cfp-act-input') as HTMLInputElement;
        if (input) input.value = String(inputVal);
      }
    }

    function uncheckKey(key: string) {
      const row = grid.querySelector(`.cfp-act[data-key="${key}"]`);
      if (!row) return;
      const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement;
      if (cb) cb.checked = false;
    }

