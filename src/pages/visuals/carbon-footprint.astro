      { key:'transatlantic-flight', cat:'transport', label:'Transatlantic round trip', detail:'e.g. NYC \u2194 London', kgYear:1600, hasInput:true, inputUnit:'flights / yr', inputDefault:1, kgPerUnit:1600, source:'ICAO', sourceNote:'Economy class, ~3,450 mi each way.' },
