    // ── Helpers ──
    function fmt(n: number): string { return Math.round(n).toLocaleString(); }
    function fmtVal(kgYear: number): string {
      const v = mode === 'day' ? kgYear / 365 : kgYear;
      if (Math.abs(v) >= 1000) return fmt(v) + ' kg';
      if (Math.abs(v) >= 1) return v.toFixed(1).replace(/\.0$/, '') + ' kg';
      if (Math.abs(v) >= 0.01) return (v * 1000).toFixed(0) + ' g';
      return '< 1 g';
    }
    function getDayFactor(unit: string): number { if (unit.includes('/ yr')||unit.includes('/ year')) return 365; if (unit.includes('week')) return 7; return 1; }
    function getDayUnit(unit: string): string { return unit.replace('/ yr','/ day').replace('/ year','/ day').replace('per week','/ day'); }
    function getKgYear(key: string): number {
      const a = actMap.get(key)!;
      if ((a as any).hasInput) {
        const input = grid.querySelector(`.cfp-act-input[data-key="${key}"]`) as HTMLInputElement;
        const displayVal = input ? parseFloat(input.value) || 0 : (a as any).inputDefault;
        const dayFactor = getDayFactor((a as any).inputUnit);
        const effectiveVal = mode === 'day' ? displayVal * dayFactor : displayVal;
        return (a as any).kgPerUnit * effectiveVal;
      }
      return a.kgYear;
    }
    function getChecked(): string[] {
      const keys: string[] = [];
      grid.querySelectorAll('.cfp-act').forEach(el => {
        const cb = el.querySelector('input[type="checkbox"]') as HTMLInputElement;
        if (cb?.checked) keys.push((el as HTMLElement).dataset.key!);
      });
      return keys;
    }
    function getCatColor(cat: string): string {
      if (isDark()) {
        const dk: Record<string,string> = { transport:'#C47058', home:'#C4935A', food:'#A07050', purchases:'#B86850', digital:'#C4A08A' };
        return dk[cat] || CAT_COLORS[cat] || '#8B2E2E';
      }
      return CAT_COLORS[cat] || '#8B2E2E';
    }

    // ── Animated number ──
    let animFrame = 0;
    function animateNum(from: number, to: number) {
      cancelAnimationFrame(animFrame);
      const start = performance.now(); const dur = 400;
      function tick(now: number) {
        const t = Math.min((now - start) / dur, 1);
        const ease = 1 - Math.pow(1 - t, 4); // easeOutQuart
        totalNum.textContent = fmt(Math.round(from + (to - from) * ease));
        if (t < 1) animFrame = requestAnimationFrame(tick);
      }
      animFrame = requestAnimationFrame(tick);
    }

    // ── Treemap (squarified) ──
    function renderTreemap(items: { key: string; kg: number; cat: string; label: string }[]) {
      treemapEl.innerHTML = '';
      treemapLegend.innerHTML = '';
      const posItems = items.filter(i => i.kg > 0).sort((a, b) => b.kg - a.kg);
      if (posItems.length === 0) {
        treemapEl.innerHTML = '<div class="cfp-tm-empty">Select activities above to see breakdown</div>';
        return;
      }
      const W = treemapEl.clientWidth || 800;
      const H = treemapEl.clientHeight || 180;
      const total = posItems.reduce((s, i) => s + i.kg, 0);
      const rects = squarify(posItems.map(i => i.kg / total), W, H);

      const catsUsed = new Set<string>();
      posItems.forEach((item, i) => {
        const r = rects[i]; if (!r) return;
        const div = document.createElement('div');
        div.className = 'cfp-tm-rect';
        div.style.left = r.x + 'px'; div.style.top = r.y + 'px';
        div.style.width = r.w + 'px'; div.style.height = r.h + 'px';
        div.style.background = item.kg < 0 ? 'var(--green)' : getCatColor(item.cat);
        if (r.w > 50 && r.h > 30) {
          const n = document.createElement('span'); n.className = 'cfp-tm-name'; n.textContent = item.label;
          const v = document.createElement('span'); v.className = 'cfp-tm-val'; v.textContent = fmtVal(item.kg);
          div.appendChild(n); div.appendChild(v);
        }
        treemapEl.appendChild(div);
        catsUsed.add(item.cat);
      });

      // Legend
      catsUsed.forEach(cat => {
        const le = document.createElement('div'); le.className = 'cfp-legend-item';
        const sw = document.createElement('span'); sw.className = 'cfp-legend-swatch'; sw.style.background = getCatColor(cat);
        le.appendChild(sw); le.appendChild(document.createTextNode(CATS[cat]?.label || cat));
        treemapLegend.appendChild(le);
      });
    }

    function squarify(areas: number[], W: number, H: number): { x: number; y: number; w: number; h: number }[] {
      const result: { x: number; y: number; w: number; h: number }[] = [];
      let x = 0, y = 0, w = W, h = H;
      const sorted = [...areas];
      let i = 0;
      while (i < sorted.length) {
        const vertical = w < h;
        const side = vertical ? h : w;
        let row: number[] = [];
        let rowArea = 0;
        let bestAspect = Infinity;
        for (let j = i; j < sorted.length; j++) {
          const testRow = [...row, sorted[j]];
          const testArea = rowArea + sorted[j];
          const rowSide = testArea * (vertical ? W : H) / (side > 0 ? side : 1);
          let worstAspect = 0;
          for (const a of testRow) {
            const cellSide = rowSide > 0 ? (a / testArea) * side : 0;
            const aspect = rowSide > cellSide ? rowSide / (cellSide || 1) : (cellSide || 1) / (rowSide || 1);
            worstAspect = Math.max(worstAspect, aspect);
          }
          if (worstAspect <= bestAspect || row.length === 0) {
            row = testRow; rowArea = testArea; bestAspect = worstAspect;
          } else break;
          i = j + 1;
        }
        const rowSide = rowArea * (vertical ? W : H) / (side > 0 ? side : 1);
        let offset = 0;
        for (const a of row) {
          const cellSide = rowSide > 0 ? (a / rowArea) * side : 0;
          if (vertical) {
            result.push({ x: x, y: y + offset, w: rowSide, h: cellSide });
          } else {
            result.push({ x: x + offset, y: y, w: cellSide, h: rowSide });
          }
          offset += cellSide;
        }
        if (vertical) { x += rowSide; w -= rowSide; } else { y += rowSide; h -= rowSide; }
      }
      return result;
    }

    // ── Spectrum ──
    function renderSpectrum(totalKg: number) {
      const maxKg = 20000;
      const toX = (kg: number) => Math.min(kg / maxKg, 1) * 800;
      const setMark = (id: string, kg: number) => {
        const g = document.getElementById(id);
        if (g) { g.querySelectorAll('line').forEach(l => { l.setAttribute('x1', String(toX(kg))); l.setAttribute('x2', String(toX(kg))); }); g.querySelector('text')?.setAttribute('x', String(toX(kg))); }
      };
      setMark('spectrum-paris', BENCHMARKS.paris2030);
      setMark('spectrum-global', BENCHMARKS.globalAvg);
      setMark('spectrum-eu', BENCHMARKS.euAvg);
      setMark('spectrum-us', BASELINE.kgPerYear);
      const userCircle = document.getElementById('spectrum-user');
      if (userCircle) userCircle.setAttribute('cx', String(toX(Math.max(0, totalKg))));
    }

    // ── Context sentence & equivalencies ──
    function renderDashboard(totalKg: number) {
      const divisor = mode === 'day' ? 365 : 1;
      const displayVal = totalKg / divisor;
      const ratio = totalKg / BASELINE.kgPerYear;
      const belowParis = totalKg <= BENCHMARKS.paris2030;

      // % line
      if (totalKg === 0) { pctLine.textContent = ''; pctLine.className = 'cfp-pct-line'; }
      else {
        const pctStr = Math.round(ratio * 100) + '% of the average American';
        pctLine.textContent = pctStr;
        pctLine.className = 'cfp-pct-line ' + (belowParis ? 'below-paris' : 'above-paris');
      }

      // Context
      if (totalKg > 0) {
        const miles = Math.round(totalKg / 0.341).toLocaleString();
        const ratioStr = ratio < 1 ? `${(1/ratio).toFixed(1)}\u00d7 below` : ratio > 1 ? `${ratio.toFixed(1)}\u00d7 above` : 'equal to';
        contextLine.textContent = `That\u2019s ${ratioStr} the average American \u2014 equivalent to driving ${miles} miles in a gas car.`;
      } else { contextLine.textContent = ''; }

      // Equivalency chips
      equivChips.innerHTML = '';
      if (totalKg > 0) {
        const chips = [
          { icon: '<path d="M2 9.5l2-4h8l2 4M2 9.5v2h12v-2"/><circle cx="5" cy="11" r="1"/><circle cx="11" cy="11" r="1"/>', text: `${Math.round(totalKg/0.341).toLocaleString()} miles driven` },
          { icon: '<path d="M2 8.5l6-5 6 5"/><path d="M3.5 8v6h9V8"/>', text: `Powers ${(totalKg/7330).toFixed(1)} homes / yr` },
          { icon: '<path d="M3 12h10M8 7v10"/><circle cx="8" cy="4" r="2"/>', text: `${Math.round(totalKg/8.887).toLocaleString()} gallons of gas` },
        ];
        chips.forEach(c => {
          const chip = document.createElement('span'); chip.className = 'cfp-equiv-chip';
          chip.innerHTML = `<svg viewBox="0 0 16 16">${c.icon}</svg>${c.text}`;
          equivChips.appendChild(chip);
        });
      }

      renderSpectrum(totalKg);
    }

    // ── Carbon story ──
    function renderStory(items: { key: string; kg: number; cat: string; label: string }[], totalKg: number) {
      if (items.length === 0 || totalKg === 0) { storyEl.innerHTML = ''; return; }
      const ratio = totalKg / BASELINE.kgPerYear;
      const parts: string[] = [];
      if (ratio < 0.5) parts.push('Your footprint is remarkably low \u2014 roughly half the US average.');
      else if (ratio < 0.8) parts.push('Your footprint is meaningfully below the US average.');
      else if (ratio < 1.2) parts.push('Your footprint is close to the US average.');
      else parts.push('Your footprint exceeds the US average.');

      const byCat: Record<string, number> = {};
      items.forEach(i => { byCat[i.cat] = (byCat[i.cat] || 0) + i.kg; });
      const topCat = Object.entries(byCat).sort((a, b) => b[1] - a[1])[0];
      if (topCat && totalKg > 0) parts.push(`${CATS[topCat[0]]?.label || topCat[0]} is your biggest source, at ${Math.round(topCat[1] / totalKg * 100)}% of your total.`);

      const biggest = items.filter(i => i.kg > 0).sort((a, b) => b.kg - a.kg)[0];
      if (biggest && totalKg > 0) parts.push(`${biggest.label} alone contributes ${Math.round(biggest.kg / totalKg * 100)}%.`);

      if (items.some(i => i.kg < 0)) parts.push('Your reductions are already offsetting some emissions.');
      if (totalKg > BENCHMARKS.paris2030) {
        const excess = totalKg - BENCHMARKS.paris2030;
        parts.push(`To reach the Paris 2030 target, you\u2019d need to cut ${excess.toLocaleString()} kg \u2014 roughly ${Math.round(excess / totalKg * 100)}% of your total.`);
      }
      storyEl.innerHTML = `<p>${parts.join(' ')}</p>`;
    }

    // ── Paris path ──
    const parisPathEl = document.getElementById('cfp-paris-path')!;

    function renderParisPath(checkedKeys: string[], totalKg: number) {
      if (totalKg <= BENCHMARKS.paris2030 || totalKg <= 0) { parisPathEl.innerHTML = ''; return; }
      const gap = totalKg - BENCHMARKS.paris2030;

      const REDUCTIONS = [
        { action: 'Switch to an EV', saves: 2800, requires: 'driving', applies: () => { uncheckKey('driving'); checkKey('ev-driving', 13500); } },
        { action: 'Go vegan', saves: 1450, requires: 'diet-avg', applies: () => { uncheckKey('diet-avg'); checkKey('diet-vegan'); } },
        { action: 'Go vegetarian', saves: 800, requires: 'diet-avg', applies: () => { uncheckKey('diet-avg'); checkKey('diet-vegetarian'); } },
        { action: 'Install solar panels', saves: 1500, requires: null, applies: () => { checkKey('solar'); } },
        { action: 'Add a heat pump', saves: 900, requires: 'gas-heating', applies: () => { checkKey('heat-pump'); } },
        { action: 'One fewer transatlantic flight', saves: 1600, requires: 'transatlantic-flight', applies: () => { uncheckKey('transatlantic-flight'); } },
        { action: 'One fewer domestic flight', saves: 620, requires: 'domestic-flight', applies: () => { uncheckKey('domestic-flight'); } },
      ].filter(r => !r.requires || checkedKeys.includes(r.requires));

      let remaining = gap;
      const plan: typeof REDUCTIONS[number][] & { impact?: number }[] = [];
      for (const r of [...REDUCTIONS].sort((a, b) => b.saves - a.saves)) {
        if (remaining <= 0) break;
        (r as any).impact = Math.min(r.saves, remaining);
        plan.push(r);
        remaining -= r.saves;
      }

      if (plan.length === 0) { parisPathEl.innerHTML = ''; return; }

      const totalSaved = plan.reduce((s, r) => s + (r as any).impact, 0);
      const projected = totalKg - totalSaved;

      let html = `<div class="cfp-paris-path-title">Your path to the Paris target</div>`;
      html += `<div class="cfp-paris-path-gap">You need to cut <strong>${gap.toLocaleString()} kg</strong> more to reach 2,500 kg/yr.</div>`;
      html += `<div class="cfp-paris-path-list">`;
      plan.forEach((r, i) => {
        const barPct = Math.min(((r as any).impact / gap) * 100, 100);
        html += `<div class="cfp-pp-item" data-pp-idx="${i}">
          <span class="cfp-pp-action">${r.action}</span>
          <span class="cfp-pp-saves">\u2212${r.saves.toLocaleString()} kg</span>
          <div class="cfp-pp-bar"><div class="cfp-pp-fill" style="width:${barPct}%"></div></div>
        </div>`;
      });
      html += `</div>`;
      if (projected <= BENCHMARKS.paris2030) {
        html += `<div class="cfp-pp-done">Together these bring you to ~${projected.toLocaleString()} kg/yr \u2014 within the Paris target.</div>`;
      } else {
        html += `<div class="cfp-pp-summary">Together these save ${totalSaved.toLocaleString()} kg, bringing you to ~${projected.toLocaleString()} kg/yr.</div>`;
      }
      parisPathEl.innerHTML = html;

      // Click handlers for applying reductions
      parisPathEl.querySelectorAll('.cfp-pp-item').forEach(el => {
        el.addEventListener('click', () => {
          const idx = parseInt((el as HTMLElement).dataset.ppIdx || '0');
          plan[idx].applies();
          render();
        });
      });
    }

    function checkKey(key: string, inputVal?: number) {
