---
/**
 * Phase 1 — Carbon Footprint Calculator (v2)
 *
 * This page replaces the previous monolithic carbon-footprint.astro.
 * Key structural changes:
 * - Footprint calculator and leverage lab are separate React components
 *   with no shared mutable state
 * - Users start from an inferred baseline, not a blank slate
 * - Seven mutually exclusive emission buckets, no overlap
 * - Every bucket shows its confidence level
 * - A visible residual wedge stays on screen until all buckets are accounted for
 *
 * The previous page mixed personal emission activities (driving, diet) with
 * systemic advocacy claims (nuclear plant advocacy, grid reform) in the same
 * data array, the same render loop, and the same URL hash. This page separates
 * them into distinct product surfaces.
 */
import Base from '@/layouts/Base.astro';
import { Calculator } from '@/components/carbon/Calculator';
---

<Base title="Carbon Footprint Calculator" description="Estimate your carbon footprint from a credible baseline, then explore what systemic actions have the highest expected leverage">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />

  <article class="cfv2" id="cfv2" transition:animate="none">

    <!-- Hero -->
    <header class="cfv2-hero">
      <h1 class="cfv2-title">Carbon Footprint</h1>
    </header>

    <div style="background: var(--bg-subtle, #f5f4f2); border: 1px solid var(--border, #DDD9D0); border-radius: 8px; padding: 12px 16px; margin-bottom: 1.25rem; font-size: 0.82rem; line-height: 1.5; color: var(--text-secondary, #6B6B60);">
      <strong>NOTE:</strong> This is under construction and a lot of the numbers on the right are likely to be wrong. I'll add an update once I'm more confident in them. Right now this page is showing off what the tool can look like.
    </div>

    <!-- Calculator (React island) -->
    <Calculator client:load />

    <!-- Leverage Lab is now inside the Calculator React component -->

  </article>
</Base>

<style is:global>
  /* Use the site's normal background — don't override */

  body:has(.cfv2) .main-content {
    max-width: 100%;
  }

  .cfv2 {
    --text: var(--text-primary, #1A1A18);
    --text-secondary: #6B6B60;
    --accent: #8B2E2E;
    --green: #4A7C59;
    --divider: var(--border, #DDD9D0);
    --panel: var(--bg-subtle, #f5f4f2);
    --bar-track: #D4CFCA;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    padding: 0 16px 3rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .cfv2-hero {
    padding: 1rem 0 0.75rem;
  }

  [data-theme="dark"] .cfv2 {
    --text: var(--text-primary, #F0EDE6);
    --text-secondary: #9A9485;
    --accent: #B85555;
    --divider: var(--border, #3A3733);
    --panel: var(--bg-subtle, #1a1918);
    --bar-track: #3A3733;
  }

  .cfv2-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .cfv2-hero-line {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .cfv2-rule {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 3rem 0;
  }

  /* Section label pattern */
  .cf-section-label {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  /* Sticky total — desktop: top bar */
  .cf-sticky-desktop {
    display: none;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--divider);
    padding: 8px 0;
  }
  [data-theme="dark"] .cf-sticky-desktop {
    background: var(--bg);
  }
  .cf-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cf-sticky-total {
    font-weight: 700;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .cf-sticky-driver {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* Sticky total — mobile: bottom rail */
  .cf-sticky-mobile {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg);
    border-top: 1px solid var(--divider);
    padding: 10px 20px;
    justify-content: space-between;
    align-items: center;
  }
  [data-theme="dark"] .cf-sticky-mobile {
    background: var(--bg);
  }

  @media (min-width: 641px) {
    .cf-sticky-desktop { display: block; }
  }
  @media (max-width: 640px) {
    .cf-sticky-mobile { display: flex; }
    .cfv2 { padding-bottom: 5rem; } /* space for mobile rail */
  }

  .cfv2-section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .cfv2-section-desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .cfv2-leverage-placeholder {
    opacity: 0.6;
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Three-panel + bar layout */
  .cf-impact-layout {
    border: 1px solid var(--divider);
    border-radius: 10px;
    overflow: hidden;
    background: var(--panel);
  }

  .cf-impact-panels {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    height: 520px;
  }

  .cf-impact-col {
    padding: 1.25rem;
    border-right: 1px solid var(--divider);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow: hidden;
  }
  [data-theme="dark"] .cf-impact-col {
    background: var(--bg);
  }

  .cf-impact-scroll {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
  }

  .cf-impact-bars {
    padding: 1.25rem 1.25rem 2rem;
    border-top: 1px solid var(--divider);
    background: var(--bg);
  }
  [data-theme="dark"] .cf-impact-bars {
    background: var(--bg);
  }

  /* Toggle row */
  .cf-toggle-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border: 1.5px solid transparent;
    border-radius: 5px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--text);
    text-align: left;
    transition: all 0.12s;
    min-height: 36px;
    background: transparent;
    width: 100%;
  }
  .cf-toggle-row[data-on="true"] {
    background: rgba(74, 124, 89, 0.08);
    border-color: rgba(74, 124, 89, 0.2);
  }
  .cf-toggle-row:hover {
    background: rgba(74, 124, 89, 0.04);
  }

  @media (max-width: 900px) {
    .cf-impact-panels {
      grid-template-columns: 1fr;
      height: auto;
    }
    .cf-impact-col {
      border-right: none;
      border-bottom: 1px solid var(--divider);
      overflow: visible;
    }
    .cf-impact-scroll {
      overflow: visible;
    }
  }

  /* Focus states */
  .cfv2 *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 480px) {
    .cfv2 { padding: 1.5rem 0 3rem; }
  }
</style>
