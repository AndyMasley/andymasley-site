    const INDIVIDUAL_COMPARATORS = [
      { name:'Eliminate your entire footprint', kg:16000, desc:'Upper bound \u2014 go to zero' },
      { name:'Switch to an EV', kg:2800, desc:'vs. avg American driving' },
      { name:'Go vegan for a year', kg:1450, desc:'vs. avg American diet' },
      { name:'Install home solar', kg:1500, desc:'avg 7 kW system' },
      { name:'Give up flying entirely', kg:2220, desc:'1 domestic + 1 transatlantic/yr' },
    ];

    const SYS_COLORS: Record<string,string> = { political:'var(--c-transport)', infrastructure:'var(--green)', career:'var(--c-purchases)', community:'var(--c-digital)', individual:'var(--bar-ref)' };
    const LOG_MIN = Math.log10(1000);
    const LOG_MAX = Math.log10(1e9);
    function toLogPct(kg: number): number { return Math.max(0, Math.min(100, ((Math.log10(Math.max(kg,1000)) - LOG_MIN) / (LOG_MAX - LOG_MIN)) * 100)); }

    function fmtKgLarge(kg: number): string {
      if (kg >= 1e9) return (kg/1e9).toFixed(1) + 'B kg';
      if (kg >= 1e6) return (kg/1e6).toFixed(1) + 'M kg';
      if (kg >= 1e3) return Math.round(kg/1e3).toLocaleString() + 'k kg';
      return kg.toLocaleString() + ' kg';
    }

    let sysRefMode: 'avg'|'mine' = 'avg';
    const sysChart = document.getElementById('cfp-sys-chart')!;
    const sysToggle = document.getElementById('cfp-sys-toggle')!;

    function renderSystemic(userTotalKg: number) {
      const refKg = sysRefMode === 'mine' && userTotalKg > 0 ? userTotalKg : BASELINE.kgPerYear;
      const refLabel = sysRefMode === 'mine' && userTotalKg > 0 ? 'Your footprint' : 'US avg';
      const refPct = toLogPct(refKg);

      let html = '';

      // Individual comparators
      html += '<div class="cfp-sys-section-label" style="font-size:0.6rem;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:var(--cat);margin-bottom:0.5rem;">Individual lifestyle changes</div>';

      INDIVIDUAL_COMPARATORS.forEach(item => {
        const pct = toLogPct(item.kg);
        const mult = item.kg / refKg;
        const multStr = mult >= 1 ? mult.toFixed(1) + '\u00d7' : (mult * 100).toFixed(0) + '%';
        html += `<div class="cfp-sys-row">
          <div class="cfp-sys-row-info"><span class="cfp-sys-row-name">${item.name}</span><div class="cfp-sys-row-desc">${item.desc}</div></div>
          <div class="cfp-sys-bar-area">
            <div class="cfp-sys-bar" style="width:${pct}%;background:var(--bar-ref)"></div>
            <div class="cfp-sys-refline" style="left:${refPct}%" data-label="${refLabel}"></div>
          </div>
          <div class="cfp-sys-row-annot"><span class="cfp-sys-kg">${fmtKgLarge(item.kg)}</span> <span class="cfp-sys-mult" style="color:var(--text2)">${multStr}</span></div>
        </div>`;
      });

      // Divider
      html += `<div class="cfp-sys-divider"><div class="cfp-sys-divider-line"></div><span class="cfp-sys-divider-arrow">\u2193</span><span>The scale of collective action</span><div class="cfp-sys-divider-line"></div></div>`;

      // Systemic actions sorted by expected value
      const sorted = [...SYSTEMIC_ACTIONS].sort((a, b) => b.expectedKg - a.expectedKg);

      sorted.forEach(action => {
        const pct = toLogPct(action.expectedKg);
        const minPct = toLogPct(action.expectedKg / action.unc);
        const maxPct = toLogPct(action.expectedKg * action.unc);
        const mult = action.expectedKg / refKg;
        const multStr = mult >= 1000 ? Math.round(mult).toLocaleString() + '\u00d7' : mult >= 1 ? mult.toFixed(0) + '\u00d7' : (mult * 100).toFixed(0) + '%';
        const color = SYS_COLORS[action.cat] || 'var(--accent)';

        html += `<div class="cfp-sys-row">
          <div class="cfp-sys-row-info">
            <span class="cfp-sys-row-name">${action.name} <span class="cfp-sys-row-badge cfp-sys-row-badge--${action.cat}">${action.cat}</span></span>
            <div class="cfp-sys-row-desc">${action.desc}</div>
          </div>
          <div class="cfp-sys-bar-area">
            <div class="cfp-sys-uncertainty" style="left:${minPct}%;width:${maxPct - minPct}%;background:${color}"></div>
            <div class="cfp-sys-bar" style="width:${pct}%;background:${color}"></div>
            <div class="cfp-sys-refline" style="left:${refPct}%" data-label="${refLabel}"></div>
          </div>
          <div class="cfp-sys-row-annot">
            <span class="cfp-sys-kg">${fmtKgLarge(action.expectedKg)}</span>
            <span class="cfp-sys-mult" style="color:${color}">${multStr}</span>
          </div>
        </div>`;
      });

      // Log axis
      const LOG_TICKS = [1000, 10000, 100000, 1e6, 1e7, 1e8, 1e9];
      const LOG_LABELS = ['1k', '10k', '100k', '1M', '10M', '100M', '1B kg'];
      html += '<div class="cfp-sys-axis">';
      LOG_TICKS.forEach((val, i) => {
        html += `<div class="cfp-sys-tick" style="left:${toLogPct(val)}%"><div class="cfp-sys-tick-line"></div><div class="cfp-sys-tick-label">${LOG_LABELS[i]}</div></div>`;
      });
      html += '</div>';

      sysChart.innerHTML = html;
    }

    // Systemic toggle
    sysToggle.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.cfp-sys-toggle-btn') as HTMLElement;
      if (!btn) return;
      sysRefMode = btn.dataset.ref as 'avg'|'mine';
      sysToggle.querySelectorAll('.cfp-sys-toggle-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const checked = getChecked();
      const totalKg = checked.reduce((s, k) => s + getKgYear(k), 0);
      renderSystemic(totalKg);
    });

    // ── Main render ──
    function render() {
      const divisor = mode === 'day' ? 365 : 1;
      refVal.textContent = fmtVal(BASELINE.kgPerYear) + ' / ' + (mode === 'day' ? 'day' : 'yr');
      totalUnit.innerHTML = 'kg CO<sub>2</sub>e / ' + (mode === 'day' ? 'day' : 'yr');

      const checked = getChecked();
      const items = checked.map(k => { const a = actMap.get(k)!; return { key: k, kg: getKgYear(k), cat: a.cat, label: a.label }; }).sort((a, b) => Math.abs(b.kg) - Math.abs(a.kg));
      const totalKg = items.reduce((s, i) => s + i.kg, 0);
      const totalDisplay = totalKg / divisor;

      animateNum(prevTotal, totalDisplay);
      prevTotal = totalDisplay;

      userVal.textContent = fmtVal(totalKg) + ' / ' + (mode === 'day' ? 'day' : 'yr');
      const pct = BASELINE.kgPerYear > 0 ? (Math.abs(totalKg) / BASELINE.kgPerYear) * 100 : 0;
      userBar.style.width = Math.max(pct, 0) + '%';

      const isOver = totalKg > BASELINE.kgPerYear;
      const belowParis = totalKg > 0 && totalKg <= BENCHMARKS.paris2030;
      overflowMsg.classList.toggle('visible', isOver);
      parisBadge.classList.toggle('visible', belowParis && !isOver);

      // Segments with category colors
      userBar.innerHTML = '';
      if (items.length > 0) {
        items.forEach(item => {
          if (item.kg === 0) return;
          const segW = BASELINE.kgPerYear > 0 ? (Math.abs(item.kg) / BASELINE.kgPerYear) * 100 : 0;
          const seg = document.createElement('div');
          seg.className = 'cfp-segment';
          seg.style.width = Math.max(segW, 0.3) + '%';
          seg.style.background = item.kg < 0 ? 'var(--green)' : (isOver ? 'var(--accent)' : getCatColor(item.cat));

          // Label inside if wide enough
          if (segW > 8) {
            const lbl = document.createElement('span'); lbl.className = 'cfp-seg-label'; lbl.textContent = item.label;
            seg.appendChild(lbl);
          }
          const pctOfAvg = (Math.abs(item.kg) / BASELINE.kgPerYear * 100);
          const tip = document.createElement('div'); tip.className = 'cfp-seg-tip';
          tip.innerHTML = `<strong>${item.label}</strong><br>${fmtVal(item.kg)} &middot; ${pctOfAvg.toFixed(1)}% of avg American`;
          seg.appendChild(tip);
          userBar.appendChild(seg);
        });
      }

      // Activity rows
      grid.querySelectorAll('.cfp-act').forEach(el => {
        const htmlEl = el as HTMLElement; const key = htmlEl.dataset.key!;
        const cb = el.querySelector('input[type="checkbox"]') as HTMLInputElement;
        const kgEl = el.querySelector('.cfp-act-kg') as HTMLElement;
        const minifill = el.querySelector('.cfp-act-minifill') as HTMLElement;
        htmlEl.classList.toggle('checked', cb.checked);
        const itemKg = getKgYear(key);
        kgEl.textContent = (itemKg < 0 ? '\u2212' : '') + fmtVal(Math.abs(itemKg));
        const miniPct = Math.min(Math.abs(itemKg) / BASELINE.kgPerYear * 100, 100);
        minifill.style.width = miniPct + '%';
        const cat = htmlEl.dataset.cat || 'transport';
        minifill.style.background = itemKg < 0 ? 'var(--green)' : getCatColor(cat);
      });

      renderDashboard(totalKg);
      renderTreemap(items);
      renderStory(items, totalKg);
      renderParisPath(checked, totalKg);
      renderSystemic(totalKg);
      renderCompare();
      saveHash();
    }

    function renderCompare() {
      const preset = compareSelect.value;
      if (!preset || !PRESETS[preset]) { compareRow.hidden = true; return; }
      compareRow.hidden = false;
      const p = PRESETS[preset]; compareName.textContent = p.label;
      let total = 0;
      Object.entries(p.items).forEach(([key, val]) => {
        const a = actMap.get(key); if (!a) return;
        total += (a as any).hasInput && typeof val === 'number' ? (a as any).kgPerUnit * val : a.kgYear;
      });
      compareVal.textContent = fmtVal(total) + ' / ' + (mode === 'day' ? 'day' : 'yr');
      compareBar.style.width = (Math.abs(total) / BASELINE.kgPerYear) * 100 + '%';
    }

    // ── URL hash ──
    function saveHash() {
      const parts: string[] = [mode === 'day' ? 'd' : 'y'];
      grid.querySelectorAll('.cfp-act').forEach(el => {
        const cb = el.querySelector('input[type="checkbox"]') as HTMLInputElement;
        if (!cb.checked) return;
        const key = (el as HTMLElement).dataset.key!;
        const input = el.querySelector('.cfp-act-input') as HTMLInputElement;
        parts.push(input ? key + '=' + input.value : key);
      });
      history.replaceState(null, '', '#' + parts.join('&'));
    }

    function loadHash() {
      const hash = location.hash.slice(1); if (!hash) return false;
      const parts = hash.split('&'); if (!parts.length) return false;
      if (parts[0] === 'd') mode = 'day'; else mode = 'year';
      toggle.querySelectorAll('.cfp-toggle-btn').forEach(b => b.classList.toggle('active', (b as HTMLElement).dataset.mode === mode));
      grid.querySelectorAll('.cfp-act input[type="checkbox"]').forEach(cb => { (cb as HTMLInputElement).checked = false; });
      parts.slice(1).forEach(part => {
        const [key, val] = part.split('=');
        const row = grid.querySelector(`.cfp-act[data-key="${key}"]`); if (!row) return;
        const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement; if (cb) cb.checked = true;
        if (val) { const input = row.querySelector('.cfp-act-input') as HTMLInputElement; if (input) input.value = val; }
      });
      if (mode === 'day') {
        grid.querySelectorAll('.cfp-act').forEach(el => {
          const key = (el as HTMLElement).dataset.key!; const a = actMap.get(key)!;
          if (!(a as any).hasInput) return;
          const unitEl = el.querySelector('.cfp-act-unit') as HTMLElement;
          if (unitEl) unitEl.textContent = getDayUnit((a as any).inputUnit);
        });
      }
      return true;
    }

    function applyPreset(items: Record<string, number|true>) {
      grid.querySelectorAll('.cfp-act input[type="checkbox"]').forEach(cb => { (cb as HTMLInputElement).checked = false; });
      Object.entries(items).forEach(([key, val]) => {
        const row = grid.querySelector(`.cfp-act[data-key="${key}"]`); if (!row) return;
        const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement; if (cb) cb.checked = true;
        if (typeof val === 'number') { const input = row.querySelector('.cfp-act-input') as HTMLInputElement; if (input) input.value = String(val); }
      });
      render();
    }

    // ── Mutual exclusivity groups ──
    // When one item in a group is checked, all others in the same group get unchecked
    const EXCLUSIVE_GROUPS: string[][] = [
      ['driving', 'ev-driving', 'motorcycle'],         // primary vehicle
      ['diet-avg', 'diet-vegetarian', 'diet-vegan'],    // diet type
    ];

    function enforceExclusivity(checkedKey: string) {
      for (const group of EXCLUSIVE_GROUPS) {
        if (!group.includes(checkedKey)) continue;
        for (const otherKey of group) {
          if (otherKey === checkedKey) continue;
          const row = grid.querySelector(`.cfp-act[data-key="${otherKey}"]`);
          if (!row) continue;
          const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement;
          if (cb) cb.checked = false;
        }
      }
    }

    // ── Events ──
    const AVG_BASKET: Record<string, number|true> = { driving:13500, 'home-energy':true, 'diet-avg':true, clothing:65, smartphone:true, streaming:1 };
    const presetNote = document.getElementById('preset-note')!;
    let avgPresetActive = false;

    grid.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.matches('input[type="checkbox"]')) {
        if (avgPresetActive) { avgPresetActive = false; presetNote.hidden = true; }
        // Enforce mutual exclusivity when checking (not unchecking)
        if (target.checked) {
          const row = target.closest('.cfp-act') as HTMLElement;
          if (row?.dataset.key) enforceExclusivity(row.dataset.key);
        }
        render();
      }
    });
    grid.addEventListener('click', (e) => { if ((e.target as HTMLElement).matches('.cfp-act-input')) { e.preventDefault(); e.stopPropagation(); } });
    grid.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.matches('.cfp-act-input')) {
        // Clamp to max if defined
        if (t.max && t.value !== '') {
          const val = parseFloat(t.value);
          const max = parseFloat(t.max);
          if (val > max) t.value = String(max);
        }
        if (avgPresetActive) { avgPresetActive = false; presetNote.hidden = true; }
        render();
      }
    });

    toggle.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.cfp-toggle-btn') as HTMLElement; if (!btn) return;
      const m = btn.dataset.mode as 'year'|'day'; if (m === mode) return;
      const switchingToDay = m === 'day'; mode = m;
      toggle.querySelectorAll('.cfp-toggle-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      grid.querySelectorAll('.cfp-act').forEach(el => {
        const key = (el as HTMLElement).dataset.key!; const a = actMap.get(key)!;
        if (!(a as any).hasInput) return;
        const input = el.querySelector('.cfp-act-input') as HTMLInputElement;
        const unitEl = el.querySelector('.cfp-act-unit') as HTMLElement;
        if (!input || !unitEl) return;
        const origUnit = (a as any).inputUnit as string; const dayFactor = getDayFactor(origUnit);
        if (dayFactor === 1) return;
        const currentVal = parseFloat(input.value) || 0;
        if (switchingToDay) {
          const daily = currentVal / dayFactor;
          input.value = daily < 1 ? daily.toPrecision(3) : daily.toFixed(1).replace(/\.0$/, '');
          if ((a as any).inputMax) input.max = String((a as any).inputMax / dayFactor);
          unitEl.textContent = getDayUnit(origUnit);
        } else {
          input.value = String(Math.round(currentVal * dayFactor));
          if ((a as any).inputMax) input.max = String((a as any).inputMax);
          unitEl.textContent = origUnit;
        }
      });
      prevTotal = switchingToDay ? prevTotal / 365 : prevTotal * 365;
      render();
    });

    document.getElementById('btn-all')!.addEventListener('click', () => { grid.querySelectorAll('.cfp-act input[type="checkbox"]').forEach(cb => { (cb as HTMLInputElement).checked = true; }); avgPresetActive = false; presetNote.hidden = true; render(); });
    document.getElementById('btn-none')!.addEventListener('click', () => { grid.querySelectorAll('.cfp-act input[type="checkbox"]').forEach(cb => { (cb as HTMLInputElement).checked = false; }); avgPresetActive = false; presetNote.hidden = true; render(); });
    document.getElementById('btn-avg')!.addEventListener('click', () => { applyPreset(AVG_BASKET); avgPresetActive = true; presetNote.hidden = false; });
    compareSelect.addEventListener('change', render);

    // Search
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      grid.querySelectorAll('.cfp-act').forEach(el => {
        const name = el.querySelector('.cfp-act-name')?.textContent?.toLowerCase() || '';
        const detail = el.querySelector('.cfp-act-detail')?.textContent?.toLowerCase() || '';
        (el as HTMLElement).classList.toggle('cfp-act--filtered', q.length > 0 && !name.includes(q) && !detail.includes(q));
      });
    });

    // Share
    document.getElementById('share-btn')!.addEventListener('click', () => {
      navigator.clipboard.writeText(location.href).then(() => {
        const confirm = document.getElementById('share-confirm')!;
        confirm.hidden = false;
        setTimeout(() => { confirm.hidden = true; }, 2000);
      });
    });

    // Keyboard
    grid.addEventListener('keydown', (e) => {
      const row = (e.target as HTMLElement).closest('.cfp-act'); if (!row) return;
      if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); const cb = row.querySelector('input[type="checkbox"]') as HTMLInputElement; if (cb) { cb.checked = !cb.checked; render(); } }
    });

    document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(animFrame); }, { once: true });

    // ── Init ──
    const hadHash = loadHash();
    if (!hadHash) { ['driving', 'home-energy', 'diet-avg'].forEach(key => { const row = grid.querySelector(`.cfp-act[data-key="${key}"]`); if (row) { (row.querySelector('input[type="checkbox"]') as HTMLInputElement).checked = true; } }); }
    render();
  }
</script>
