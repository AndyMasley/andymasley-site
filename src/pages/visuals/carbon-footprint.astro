---
/**
 * Phase 1 — Carbon Footprint Calculator (v2)
 *
 * This page replaces the previous monolithic carbon-footprint.astro.
 * Key structural changes:
 * - Footprint calculator and leverage lab are separate React components
 *   with no shared mutable state
 * - Users start from an inferred baseline, not a blank slate
 * - Seven mutually exclusive emission buckets, no overlap
 * - Every bucket shows its confidence level
 * - A visible residual wedge stays on screen until all buckets are accounted for
 *
 * The previous page mixed personal emission activities (driving, diet) with
 * systemic advocacy claims (nuclear plant advocacy, grid reform) in the same
 * data array, the same render loop, and the same URL hash. This page separates
 * them into distinct product surfaces.
 */
import Base from '@/layouts/Base.astro';
import { Calculator } from '@/components/carbon/Calculator';

const pageTitle = 'Carbon Footprint Calculator';
const pageDescription = 'Estimate your personal carbon footprint from a credible baseline, compare diet, driving, flights, EVs, and heat pumps, and see how lifestyle changes compare with cleaning up the grid.';
const pageUrl = 'https://andymasley.com/visuals/carbon-footprint';
const ogImage = 'https://andymasley.com/images/og/og-carbon-footprint.png';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en-US',
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImage,
      width: 1200,
      height: 630,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'Andy Masley',
      url: 'https://andymasley.com',
    },
    author: {
      '@type': 'Person',
      name: 'Andy Masley',
      url: 'https://andymasley.com/',
    },
    about: [
      { '@type': 'Thing', name: 'Carbon footprint' },
      { '@type': 'Thing', name: 'Climate change' },
      { '@type': 'Thing', name: 'Electric grid decarbonization' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://andymasley.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Visuals',
        item: 'https://andymasley.com/visuals',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Carbon Footprint Calculator',
        item: pageUrl,
      },
    ],
  },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageUrl}
  ogTitle={pageTitle}
  ogImage="/images/og/og-carbon-footprint.png"
  ogImageAlt="Social preview for Andy Masley's carbon footprint calculator comparing personal lifestyle cuts with changing the electric grid"
  structuredData={structuredData}
>
  <!-- Hero (outside the breakout container so it aligns with the header) -->
  <header class="cfv2-header">
    <h1 class="cfv2-header-title">Carbon Footprint Calculator</h1>
    <p class="cfv2-header-intro">Estimate your personal carbon footprint from a credible baseline, then compare common lifestyle changes with actions that help clean up the electric grid. The goal is not false precision; it is to make the scale of different climate choices easier to see. Methodology is below.</p>
  </header>

  <article class="cfv2" id="cfv2">
    <!-- Calculator (React island) -->
    <Calculator client:load />

    <!-- Leverage Lab is now inside the Calculator React component -->

  </article>
</Base>

<style is:global>
  /* Break the calculator out of the normal content width without touching .main-content or .header */
  .cfv2 {
    width: calc(100vw - 48px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  .cfv2 {
    --text: var(--text-primary, #1A1A18);
    --text-secondary: #6B6B60;
    --accent: #8B2E2E;
    --green: #4A7C59;
    --divider: var(--border, #DDD9D0);
    --panel: var(--bg-subtle, #f5f4f2);
    --bar-track: #D4CFCA;
    font-family: var(--font-body);
    color: var(--text);
    padding: 0 0 3rem;
    max-width: 1600px;
  }

  .cfv2-header {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .cfv2-header-title {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 1.65rem + 1vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0 0 0.75rem;
  }

  .cfv2-header-intro {
    max-width: 42rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.78;
    color: var(--text-secondary);
  }


  [data-theme="dark"] .cfv2 {
    --text: var(--text-primary, #F0EDE6);
    --text-secondary: #9A9485;
    --accent: #B85555;
    --green: #5A9B6E;
    --divider: var(--border, #3A3733);
    --panel: var(--bg-subtle, #1a1918);
    --bar-track: #3A3733;
  }


  .cfv2-hero-line {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .cfv2-rule {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 3rem 0;
  }

  .cf-explainer a {
    color: var(--accent, #8B2E2E);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cf-explainer a:hover {
    opacity: 0.75;
  }

  /* Section label pattern */
  .cf-section-label {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  /* Sticky total — desktop: top bar */
  .cf-sticky-desktop {
    display: none;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--divider);
    padding: 8px 0;
  }
  [data-theme="dark"] .cf-sticky-desktop {
    background: var(--bg);
  }
  .cf-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cf-sticky-total {
    font-weight: 700;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .cf-sticky-driver {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* Sticky total — mobile: bottom rail */
  .cf-sticky-mobile {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg);
    border-top: 1px solid var(--divider);
    padding: 10px 20px;
    justify-content: space-between;
    align-items: center;
  }
  [data-theme="dark"] .cf-sticky-mobile {
    background: var(--bg);
  }

  @media (min-width: 641px) {
    .cf-sticky-desktop { display: block; }
  }
  @media (max-width: 640px) {
    .cf-sticky-mobile { display: flex; }
    .cfv2 { padding-bottom: 5rem; } /* space for mobile rail */
  }

  .cfv2-section-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .cfv2-section-desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 600px;
  }

  .cfv2-leverage-placeholder {
    opacity: 0.6;
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Three-panel + bar layout */
  .cf-impact-layout {
    border: 1px solid var(--divider);
    border-radius: 0;
    overflow: hidden;
    background: transparent;
  }

  .cf-baseline-form {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem 0.5rem;
  }

  .cf-baseline-field,
  .cf-category-title,
  .cf-category-stats,
  .cf-toggle-label,
  .cf-toggle-meta,
  .cf-toggle-value,
  .cf-bar-row-label,
  .cf-bar-row-value {
    min-width: 0;
  }

  .cf-presets-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 0.75rem;
  }

  .cf-example-formula {
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    vertical-align: top;
  }

  .cf-impact-panels {
    display: grid;
    grid-template-columns: 7fr 5fr 8fr;
    height: 520px;
  }

  .cf-impact-col {
    padding: 1.1rem 1.25rem;
    border-right: 1px solid var(--divider);
    display: flex;
    flex-direction: column;
    background: var(--bg, #faf9f7);
    overflow: hidden;
    min-width: 0;
  }
  [data-theme="dark"] .cf-impact-col {
    background: var(--bg, #141413);
  }

  .cf-impact-scroll {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
  }

  .cf-impact-bars {
    padding: 1.2rem 1.25rem 1.8rem;
    border-top: 1px solid var(--divider);
    background: var(--bg, #faf9f7);
  }
  [data-theme="dark"] .cf-impact-bars {
    background: var(--bg, #141413);
  }

  .cf-reference-label-short {
    display: none;
  }

  /* Toggle row */
  .cf-toggle-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border: none;
    border-bottom: 1px solid var(--divider);
    border-radius: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--text);
    text-align: left;
    transition: color 0.12s, border-color 0.12s;
    min-height: 0;
    background: transparent;
    width: 100%;
  }
  .cf-toggle-row[data-on="true"] {
    background: transparent;
    border-color: var(--accent);
  }
  .cf-toggle-row:hover {
    background: transparent;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .cf-impact-panels {
      grid-template-columns: 1fr;
      height: auto;
    }
    .cf-impact-col {
      border-right: none;
      border-bottom: 1px solid var(--divider);
      overflow: visible;
    }
    .cf-impact-scroll {
      overflow: visible;
    }
  }

  @media (max-width: 640px) {
    .cfv2 {
      width: calc(100vw - 24px);
    }

    .cf-impact-col,
    .cf-impact-bars {
      padding-left: 0.875rem;
      padding-right: 0.875rem;
    }

    .cf-footprint-unit {
      display: block;
      margin-left: 0 !important;
      margin-top: 0.18rem;
      font-size: 0.34em !important;
    }

    .cf-footprint-benchmark {
      flex-wrap: wrap;
    }

    .cf-baseline-form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cf-category-flash {
      flex-wrap: wrap;
      row-gap: 4px;
    }

    .cf-category-stats {
      width: calc(100% - 16px);
      padding-left: 16px;
      order: 3;
      line-height: 1.35;
    }

    .cf-category-progress {
      order: 4;
      margin-left: auto;
    }

    .cf-toggle-row {
      display: grid;
      grid-template-columns: 16px minmax(0, 1fr);
      align-items: start;
      column-gap: 8px;
      row-gap: 4px;
      padding: 10px 0;
    }

    .cf-toggle-row > span:first-child {
      grid-column: 1;
      grid-row: 1 / span 3;
      margin-top: 2px;
    }

    .cf-toggle-label,
    .cf-toggle-meta,
    .cf-toggle-value {
      grid-column: 2;
    }

    .cf-toggle-label {
      line-height: 1.35;
    }

    .cf-toggle-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 3px 6px;
      line-height: 1.35;
    }

    .cf-toggle-value {
      justify-self: end;
      text-align: right;
      line-height: 1.2;
    }

    .cf-bar-row-head {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 4px;
    }

    .cf-bar-row-value {
      width: 100%;
      text-align: right;
      line-height: 1.35;
    }

    .cf-reference-label {
      font-size: 0.5rem !important;
      letter-spacing: 0.01em !important;
    }

    .cf-reference-label-row {
      height: 28px !important;
      margin-bottom: 6px !important;
    }

    .cf-reference-label[data-row="1"] {
      top: 11px;
    }

    .cf-reference-label-full {
      display: none;
    }

    .cf-reference-label-short {
      display: inline;
    }

    .cf-reference-line-layer {
      top: 34px !important;
    }

    .cf-reference-line {
      opacity: 0.45 !important;
    }
  }

  /* Focus states */
  .cfv2 *:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @keyframes cf-flash {
    0% { background-color: rgba(74, 124, 89, 0.15); }
    100% { background-color: transparent; }
  }
  .cf-category-flash {
    animation: cf-flash 0.6s ease-out;
    background: rgba(0, 0, 0, 0.03);
  }
  [data-theme="dark"] .cf-category-flash {
    background: rgba(255, 255, 255, 0.05);
  }
  .cf-category-flash[data-open="true"] {
    background: rgba(74, 124, 89, 0.08);
  }
  [data-theme="dark"] .cf-category-flash[data-open="true"] {
    background: rgba(74, 124, 89, 0.12);
  }

  .cf-preset-pill:hover {
    border-color: var(--accent, #8B2E2E) !important;
  }

  .cf-inline-num:hover {
    border-bottom-style: solid !important;
    border-bottom-color: var(--accent, #8B2E2E) !important;
  }
  .cf-inline-num:focus {
    border-bottom-style: solid !important;
    border-bottom-color: var(--accent, #8B2E2E) !important;
  }

  .cf-impact-panels > .cf-impact-col:nth-child(1) {
    border-top: 2px solid var(--accent, #8B2E2E);
  }
  .cf-impact-panels > .cf-impact-col:nth-child(2) {
    border-top: 2px solid var(--accent, #8B2E2E);
  }
  .cf-impact-panels > .cf-impact-col:nth-child(3) {
    border-top: 2px solid var(--accent, #8B2E2E);
  }

  .cf-impact-layout {
    margin-bottom: 8px;
  }

  .cfv2 a {
    color: var(--accent);
  }
  .cfv2 a:hover {
    color: var(--accent);
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .cfv2 {
      width: calc(100vw - 16px);
      padding: 1.5rem 0 3rem;
    }

    .cf-baseline-form {
      grid-template-columns: 1fr;
    }

    .cf-preset-pill {
      flex: 1 1 calc(50% - 0.4rem);
      white-space: normal !important;
      text-align: center;
    }
  }

</style>
