---
import Base from '@/layouts/Base.astro';
import { PromptEnergySceneOne } from '@/components/prompt-energy/PromptEnergySceneOne';
---

<Base
  title="How an AI prompt uses energy"
  description="A forthcoming visualization about how an AI prompt uses energy."
  activeNav="/visuals"
>
  <article class="pe-page">
    <header class="pe-page__header">
      <h1 class="pe-page__title">How an AI prompt uses energy</h1>
      <p class="pe-page__intro">
        A zoomable story about how one prompt moves through a live AI serving system. This first scene tracks the request from chat box to accelerator handoff and keeps the measurement boundary visible the whole time.
      </p>
    </header>

    <PromptEnergySceneOne client:load />
  </article>
</Base>

<style is:global>
  .pe-page {
    width: 100%;
  }

  .pe-page__header {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .pe-page__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.9rem + 1vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .pe-page__intro {
    max-width: 42rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.78;
    color: var(--text-secondary);
  }

  .pe-scene-one {
    --pe-blue: #5e8dd7;
    --pe-gold: #b8892f;
    --pe-host: #9b7144;
    --pe-reserve: #7f8a8a;
    --pe-overhead: #a8a097;
    --pe-heat: #bf6c4a;
    --pe-cool: #5e9fb0;
    --pe-panel: color-mix(in srgb, var(--bg-subtle) 92%, transparent);
    --pe-shadow: 0 14px 34px -28px rgba(26, 25, 24, 0.35);
  }

  [data-theme="dark"] .pe-scene-one {
    --pe-blue: #8fb4ec;
    --pe-gold: #d4ab57;
    --pe-host: #c38c58;
    --pe-reserve: #8a9797;
    --pe-overhead: #777168;
    --pe-heat: #d48b69;
    --pe-cool: #7abfd1;
    --pe-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.72);
  }

  .pe-scene-one__intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .pe-scene-one__eyebrow,
  .pe-step__meta,
  .pe-node-label,
  .pe-ledger__eyebrow,
  .pe-stage__progress-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--font-body);
  }

  .pe-scene-one__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.55rem + 0.9vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .pe-scene-one__lede {
    max-width: 38rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .pe-scene-one__layout {
    display: grid;
    grid-template-columns: minmax(0, 25rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .pe-scene-one__steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pe-step {
    min-height: 72vh;
    padding: 1.1rem 1rem 1.25rem 0;
    border-top: 1px solid var(--border);
    opacity: 0.5;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .pe-step--active {
    opacity: 1;
    transform: translateX(0);
  }

  .pe-step__title {
    margin: 0.4rem 0 0.65rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 1.2rem + 0.35vw, 1.7rem);
    line-height: 1.16;
    letter-spacing: -0.025em;
  }

  .pe-step__body {
    margin: 0;
    max-width: 27rem;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.76;
    color: var(--text-secondary);
  }

  .pe-scene-one__sticky {
    position: sticky;
    top: 1.25rem;
  }

  .pe-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--pe-panel);
    box-shadow: var(--pe-shadow);
    overflow: hidden;
  }

  .pe-stage__topline {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .pe-stage__progress {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pe-stage__progress-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .pe-stage__progress-dot {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border-strong);
    background: transparent;
  }

  .pe-stage__progress-dot--active {
    background: var(--accent);
    border-color: var(--accent);
  }

  .pe-stage__caption {
    max-width: 26rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pe-stage__map {
    position: relative;
    min-height: 34rem;
    padding: 1rem 0.25rem 0.25rem;
  }

  .pe-stage__connector {
    position: absolute;
    border-top: 1px solid var(--border-strong);
    opacity: 0.55;
  }

  .pe-stage__connector--prompt {
    top: 8.1rem;
    left: 11.6rem;
    width: 5rem;
  }

  .pe-stage__connector--scheduler {
    top: 13.65rem;
    left: 26.2rem;
    width: 7rem;
  }

  .pe-stage__connector--dispatch {
    top: 13.65rem;
    left: 40.1rem;
    width: 4rem;
  }

  .pe-chat,
  .pe-token-tray,
  .pe-scheduler,
  .pe-rack {
    position: absolute;
  }

  .pe-chat {
    top: 1rem;
    left: 0.25rem;
    width: 12rem;
  }

  .pe-chat__bubble {
    margin-top: 0.55rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    box-shadow: none;
  }

  .pe-chat__text {
    display: block;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.55;
  }

  .pe-chat__status {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--dim);
  }

  .pe-token-tray {
    top: 10rem;
    left: 0.25rem;
    width: 15rem;
  }

  .pe-token-tray__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .pe-token-chip,
  .pe-request__token,
  .pe-request__more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.28rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--pe-blue) 55%, var(--border));
    background: color-mix(in srgb, var(--pe-blue) 12%, var(--bg));
    border-radius: 3px;
    color: var(--text);
    font-size: 0.82rem;
    line-height: 1;
  }

  .pe-token-tray__count {
    margin-top: 0.55rem;
    font-size: 0.82rem;
    color: var(--dim);
  }

  .pe-request {
    position: absolute;
    top: 12.05rem;
    left: 13.6rem;
    width: 10.9rem;
    padding: 0.7rem 0.75rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--pe-blue) 30%, var(--border));
    background: color-mix(in srgb, var(--bg) 92%, var(--pe-blue) 8%);
    box-shadow: var(--pe-shadow);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      left 0.55s ease,
      top 0.55s ease,
      opacity 0.35s ease,
      transform 0.35s ease,
      border-color 0.25s ease,
      background 0.25s ease;
    pointer-events: none;
  }

  .pe-request__header,
  .pe-request__footer {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe-request__tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.65rem 0;
  }

  .pe-scheduler {
    top: 9.65rem;
    left: 28.4rem;
    width: 11.5rem;
  }

  .pe-scheduler__lane {
    position: relative;
    min-height: 8.2rem;
    margin-top: 0.55rem;
    border: 1px solid var(--border-strong);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--pe-blue) 7%, transparent), transparent 32%),
      var(--bg);
    overflow: hidden;
  }

  .pe-scheduler__ghost {
    position: absolute;
    left: 0.8rem;
    width: 6.5rem;
    height: 0.75rem;
    background: color-mix(in srgb, var(--pe-blue) 14%, var(--border));
    opacity: 0.35;
  }

  .pe-scheduler__ghost--1 { top: 1.2rem; width: 5.1rem; }
  .pe-scheduler__ghost--2 { top: 3rem; width: 7.2rem; }
  .pe-scheduler__ghost--3 { top: 4.8rem; width: 4.7rem; }

  .pe-scheduler__hint {
    position: absolute;
    right: 0.85rem;
    bottom: 0.75rem;
    max-width: 6rem;
    text-align: right;
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--dim);
  }

  .pe-rack {
    top: 5.55rem;
    right: 0;
    width: 15.4rem;
  }

  .pe-rack__label {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    text-align: right;
    margin-bottom: 0.45rem;
  }

  .pe-rack__frame {
    position: relative;
    min-height: 16.5rem;
    padding: 1rem;
    border: 1px solid var(--border-strong);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--bg-subtle) 92%, transparent), transparent 42%),
      var(--bg);
  }

  .pe-rack__node {
    position: relative;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, var(--border-subtle) 8%);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .pe-rack__node--host {
    margin-bottom: 0.9rem;
    min-height: 5.4rem;
  }

  .pe-rack__node--accelerator {
    min-height: 7.5rem;
  }

  .pe-rack__title {
    margin-top: 0.35rem;
    font-family: var(--font-editorial);
    font-size: 1.12rem;
    line-height: 1.2;
  }

  .pe-rack__copy {
    margin-top: 0.35rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .pe-rack__phase-markers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .pe-rack__phase-markers span {
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--border);
    color: var(--dim);
    background: transparent;
  }

  .pe-rack__zoom-ring {
    position: absolute;
    inset: -0.35rem;
    border: 1px dashed transparent;
    pointer-events: none;
  }

  .pe-ledger {
    align-self: start;
    padding: 0.9rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .pe-ledger__header {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .pe-ledger__phase {
    margin-top: 0.2rem;
    font-family: var(--font-editorial);
    font-size: 1.15rem;
    line-height: 1.16;
  }

  .pe-ledger__boundary-copy {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .pe-ledger__toggle {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 1rem 0;
  }

  .pe-ledger__toggle-button {
    padding: 0.55rem 0.5rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.78rem;
    line-height: 1.25;
    font-family: var(--font-body);
  }

  .pe-ledger__toggle-button--active {
    border-color: var(--accent);
    color: var(--text);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  .pe-ledger__metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  .pe-ledger__metric-label {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe-ledger__metric-value {
    margin-top: 0.22rem;
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    line-height: 1.05;
  }

  .pe-ledger__bar {
    display: flex;
    gap: 0.15rem;
    height: 0.65rem;
    margin: 1rem 0 0.85rem;
    background: color-mix(in srgb, var(--border) 70%, transparent);
  }

  .pe-ledger__segment {
    display: block;
    height: 100%;
  }

  .pe-ledger__segment--chip,
  .pe-ledger__legend-swatch.pe-ledger__segment--chip {
    background: var(--pe-gold);
  }

  .pe-ledger__segment--host,
  .pe-ledger__legend-swatch.pe-ledger__segment--host {
    background: var(--pe-host);
  }

  .pe-ledger__segment--reserve,
  .pe-ledger__legend-swatch.pe-ledger__segment--reserve {
    background: var(--pe-reserve);
  }

  .pe-ledger__segment--overhead,
  .pe-ledger__legend-swatch.pe-ledger__segment--overhead {
    background: var(--pe-overhead);
  }

  .pe-ledger__legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pe-ledger__legend-item {
    display: grid;
    grid-template-columns: 0.7rem 1fr auto;
    gap: 0.55rem;
    align-items: center;
    font-size: 0.82rem;
  }

  .pe-ledger__legend-swatch {
    width: 0.7rem;
    height: 0.7rem;
  }

  .pe-ledger__legend-label {
    color: var(--text-secondary);
  }

  .pe-ledger__legend-value {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .pe-ledger__note {
    margin-top: 0.95rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--dim);
  }

  .pe-scene-one__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  .pe-stage[data-beat="warm"] .pe-chat,
  .pe-stage[data-beat="warm"] .pe-token-tray,
  .pe-stage[data-beat="warm"] .pe-scheduler,
  .pe-stage[data-beat="warm"] .pe-rack__node {
    opacity: 0.72;
  }

  .pe-stage[data-beat="question"] .pe-chat__bubble,
  .pe-stage[data-beat="question"] .pe-chat__text {
    color: var(--text);
    border-color: color-mix(in srgb, var(--pe-blue) 35%, var(--border-strong));
  }

  .pe-stage[data-beat="tokens"] .pe-token-tray,
  .pe-stage[data-beat="tokens"] .pe-token-chip {
    opacity: 1;
  }

  .pe-stage[data-beat="capsule"] .pe-request,
  .pe-stage[data-beat="scheduler"] .pe-request,
  .pe-stage[data-beat="host"] .pe-request,
  .pe-stage[data-beat="accelerator"] .pe-request,
  .pe-stage[data-beat="zoom"] .pe-request {
    opacity: 1;
    transform: translateY(0);
  }

  .pe-stage[data-beat="capsule"] .pe-request {
    left: 15.25rem;
    top: 12rem;
  }

  .pe-stage[data-beat="scheduler"] .pe-request {
    left: 30.2rem;
    top: 11.1rem;
  }

  .pe-stage[data-beat="host"] .pe-request {
    left: 44.7rem;
    top: 7.95rem;
  }

  .pe-stage[data-beat="accelerator"] .pe-request,
  .pe-stage[data-beat="zoom"] .pe-request {
    left: 44.7rem;
    top: 14.1rem;
    border-color: color-mix(in srgb, var(--pe-gold) 42%, var(--border));
    background: color-mix(in srgb, var(--bg) 88%, var(--pe-gold) 12%);
  }

  .pe-stage[data-beat="scheduler"] .pe-scheduler__lane,
  .pe-stage[data-beat="host"] .pe-scheduler__lane,
  .pe-stage[data-beat="accelerator"] .pe-scheduler__lane,
  .pe-stage[data-beat="zoom"] .pe-scheduler__lane {
    border-color: color-mix(in srgb, var(--pe-blue) 40%, var(--border-strong));
  }

  .pe-stage[data-beat="host"] .pe-rack__node--host,
  .pe-stage[data-beat="accelerator"] .pe-rack__node--host,
  .pe-stage[data-beat="zoom"] .pe-rack__node--host {
    border-color: color-mix(in srgb, var(--pe-blue) 35%, var(--border));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pe-blue) 12%, transparent);
  }

  .pe-stage[data-beat="accelerator"] .pe-rack__node--accelerator,
  .pe-stage[data-beat="zoom"] .pe-rack__node--accelerator {
    border-color: color-mix(in srgb, var(--pe-gold) 45%, var(--border));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pe-gold) 16%, transparent);
  }

  .pe-stage[data-beat="zoom"] .pe-rack__zoom-ring {
    border-color: color-mix(in srgb, var(--pe-gold) 65%, transparent);
  }

  @media (max-width: 1120px) {
    .pe-scene-one__layout {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }

    .pe-stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .pe-ledger {
      order: 3;
    }

    .pe-stage__map {
      min-height: 30rem;
    }

    .pe-stage__connector--prompt {
      left: 10.85rem;
      width: 4.2rem;
    }

    .pe-stage__connector--scheduler {
      left: 23.9rem;
      width: 6rem;
    }

    .pe-stage__connector--dispatch {
      left: 35.5rem;
      width: 3.7rem;
    }

    .pe-scheduler {
      left: 25.8rem;
    }

    .pe-rack {
      width: 13.7rem;
    }

    .pe-stage[data-beat="scheduler"] .pe-request {
      left: 27.2rem;
    }

    .pe-stage[data-beat="host"] .pe-request,
    .pe-stage[data-beat="accelerator"] .pe-request,
    .pe-stage[data-beat="zoom"] .pe-request {
      left: 39.6rem;
    }
  }

  @media (max-width: 900px) {
    .pe-scene-one__layout {
      grid-template-columns: 1fr;
    }

    .pe-scene-one__sticky {
      position: static;
    }

    .pe-step {
      min-height: auto;
      padding-right: 0;
    }

    .pe-stage {
      position: sticky;
      top: 0.75rem;
      z-index: 10;
    }
  }

  @media (max-width: 720px) {
    .pe-stage {
      position: static;
    }

    .pe-stage {
      padding: 0.9rem;
    }

    .pe-stage__topline {
      flex-direction: column;
    }

    .pe-stage__map {
      min-height: auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.95rem;
      padding: 0;
    }

    .pe-stage__connector {
      display: none;
    }

    .pe-chat,
    .pe-token-tray,
    .pe-request,
    .pe-scheduler,
    .pe-rack {
      position: static;
      width: auto;
    }

    .pe-request {
      display: block;
      margin: 0;
      opacity: 1;
      transform: none;
      pointer-events: none;
      box-shadow: none;
    }

    .pe-chat__bubble,
    .pe-request,
    .pe-scheduler__lane,
    .pe-rack__frame {
      background: var(--bg);
    }

    .pe-rack__label {
      text-align: left;
    }

    .pe-ledger__toggle {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pe-step,
    .pe-request,
    .pe-rack__node,
    .pe-stage__progress-dot,
    .pe-ledger__toggle-button {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
