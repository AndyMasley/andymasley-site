  .pe4-intro {
    max-width: 42rem;
    margin: 4.6rem 0 2rem;
  }

  .pe4-eyebrow,
  .pe4-step__meta,
  .pe4-stage__progress-label,
  .pe4-ledger__eyebrow,
  .pe4-stage__spotlight-kicker,
  .pe4-stage__handoff-title,
  .pe4-map-pane__title,
  .pe4-sm-pane__title,
  .pe4-layer-stack__eyebrow,
  .pe4-stage__plane-note-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
