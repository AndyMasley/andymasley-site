  .pe7-stack__connector,
  .pe7-stack__die,
  .pe7-stack__hbm,
  .pe7-stack__heat-path,
  .pe7-stack__coolant-path,
  .pe7-stack__airflow,
  .pe7-rack__tray,
  .pe7-rack__compute-zone,
  .pe7-rack__support-zone,
  .pe7-rack__fan-zone,
  .pe7-rack__qd-zone,
  .pe7-rack__rear-frame,
  .pe7-rack__manifold,
  .pe7-rack__busbar,
