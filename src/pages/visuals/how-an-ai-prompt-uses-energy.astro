    position: sticky;
    top: 1.25rem;
    min-width: 0;
  }

  .pe4-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--pe4-panel);
    box-shadow: var(--pe4-shadow);
  }

  .pe4-stage__topline,
  .pe4-stage__legend,
  .pe4-stage__controls,
  .pe4-stage__plane-note,
  .pe4-stage__hardware,
  .pe4-stage__handoff {
    grid-column: 1 / -1;
  }

  .pe4-stage__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 0.8rem;
