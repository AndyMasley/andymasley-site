  @media (max-width: 1500px) {
    .pe3-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pe3-steps {
      max-width: 42rem;
      margin-top: 0.25rem;
    }

    .pe3-sticky {
      order: -1;
    }
  }

  @media (max-width: 1180px) {
    .pe3-stage {
      grid-template-columns: 1fr;
    }

    .pe3-stage__topline,
    .pe3-stage__legend,
    .pe3-stage__controls,
    .pe3-stage__plane-note,
    .pe3-stage__hardware,
    .pe3-stage__spotlight,
    .pe3-stage__handoff,
    .pe3-ledger {
      grid-column: 1 / -1;
    }

    .pe3-ledger {
      grid-row: auto;
    }
  }

  @media (max-width: 900px) {
    .pe3-sticky {
      position: static;
    }

    .pe3-step {
      min-height: auto;
      padding-right: 0;
    }

    .pe3-stage__detail-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .pe3-stage {
      padding: 0.9rem;
    }

    .pe3-stage__topline,
    .pe3-stage__controls {
      flex-direction: column;
      align-items: flex-start;
    }

    .pe3-stage__depth {
      min-width: 100%;
    }

    .pe3-stage__minimap-wrap {
      position: static;
      width: 100%;
      margin-top: 0.8rem;
    }

    .pe3-board {
      min-height: 25rem;
    }

    .pe3-board__compute-board {
      left: 5.6rem;
      right: 6.6rem;
    }

    .pe3-board__label,
    .pe3-cutaway__label {
      font-size: 0.56rem;
    }

    .pe3-board__package-inset {
      position: static;
      width: 100%;
      margin-top: 0.8rem;
    }
  }

  .pe-scene-four {
