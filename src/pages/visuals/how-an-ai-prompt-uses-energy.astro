---
import Base from '@/layouts/Base.astro';
---

<Base
  title="How an AI prompt uses energy"
  description="A forthcoming visualization about how an AI prompt uses energy."
  activeNav="/visuals"
>
  <article class="visual-blank-page">
    <header class="visual-blank-page__header">
      <h1 class="visual-blank-page__title">How an AI prompt uses energy</h1>
    </header>
  </article>
</Base>

<style>
  .visual-blank-page {
    width: 100%;
  }

  .visual-blank-page__header {
    max-width: 44rem;
  }

  .visual-blank-page__title {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.9rem + 1vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
</style>
