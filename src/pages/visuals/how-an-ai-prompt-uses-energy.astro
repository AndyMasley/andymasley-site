    --pe4-gold: #d4ab57;
    --pe4-heat: #d48b69;
    --pe4-memory: #9ca4f3;
    --pe4-ghost: #8a8378;
    --pe4-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.72);
