    opacity: 0.48;
    pointer-events: none;
  }

  .pe5-die {
    position: relative;
    z-index: 1;
    aspect-ratio: 1000 / 450;
    border: 1px solid color-mix(in srgb, var(--pe5-ghost) 18%, var(--border));
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--pe5-blue) 5%, var(--bg-subtle)) 0%, var(--bg-subtle) 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--text-primary) 4%, transparent), transparent 24%);
    overflow: hidden;
