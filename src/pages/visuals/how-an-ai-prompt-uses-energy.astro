  .pe5-die__io,
  .pe5-die__gpc,
  .pe5-die__l2,
  .pe5-die__l2-segment,
  .pe5-die__gateway,
  .pe5-die__footer,
  .pe5-die__path {
    transition: opacity 0.28s ease, fill 0.28s ease, stroke 0.28s ease;
  }

  .pe5-die__slab {
    fill: color-mix(in srgb, var(--bg-subtle) 94%, transparent);
    stroke: color-mix(in srgb, var(--pe5-ghost) 38%, var(--border));
    stroke-width: 1.4;
  }

  .pe5-die__io,
  .pe5-die__footer {
    fill: color-mix(in srgb, var(--pe5-ghost) 14%, transparent);
    stroke: color-mix(in srgb, var(--pe5-ghost) 30%, transparent);
    stroke-width: 1;
  }

  .pe5-die__gpc {
    fill: color-mix(in srgb, var(--pe5-gold) 6%, transparent);
    stroke: color-mix(in srgb, var(--pe5-gold) 24%, transparent);
    stroke-width: 1;
    opacity: 0.44;
  }

  .pe5-die__gpc.is-active {
    fill: color-mix(in srgb, var(--pe5-gold) 16%, transparent);
    opacity: 0.95;
  }

  .pe5-die__l2 {
    fill: color-mix(in srgb, var(--pe5-cache) 8%, transparent);
    stroke: color-mix(in srgb, var(--pe5-cache) 22%, transparent);
    stroke-width: 1;
  }

  .pe5-die__l2.is-active {
    fill: color-mix(in srgb, var(--pe5-cache) 14%, transparent);
  }

  .pe5-die__l2-segment,
  .pe5-die__gateway {
    fill: color-mix(in srgb, var(--pe5-cache) 10%, transparent);
    stroke: color-mix(in srgb, var(--pe5-cache) 30%, transparent);
    stroke-width: 0.8;
    opacity: 0.65;
  }

  .pe5-die__l2-segment.is-active,
  .pe5-die__gateway.is-active {
    fill: color-mix(in srgb, var(--pe5-cache) 22%, transparent);
    opacity: 1;
  }

  .pe5-die__path {
