  }

  .pe2-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .pe2-overlay__frame {
    fill: none;
    stroke: color-mix(in srgb, var(--border) 58%, transparent);
    stroke-width: 1.5;
  }

  .pe2-overlay__frame--ghost {
    stroke-dasharray: 6 6;
  }

  .pe2-overlay__node {
    fill: var(--bg);
    stroke-width: 2;
  }

  .pe2-overlay__node--data {
    stroke: var(--pe2-blue);
  }

  .pe2-overlay__node--coolant {
    stroke: var(--pe2-cool);
  }

  .pe2-overlay__node--control {
    stroke: var(--pe2-air);
  }

  .pe2-overlay__node--power {
    stroke: var(--pe2-gold);
  }

  .pe2-overlay__label {
    font-size: 11px;
    fill: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pe2-overlay__label--right {
    text-anchor: end;
  }

  .pe2-overlay__path {
    fill: none;
    stroke-width: 3;
    opacity: 0.12;
  }

  .pe2-overlay__path.is-active {
    opacity: 0.95;
  }

  .pe2-overlay__path.is-faint {
    opacity: 0.45;
  }

  .pe2-overlay__path--data {
    stroke: var(--pe2-blue);
  }

  .pe2-overlay__path--power {
    stroke: var(--pe2-gold);
  }

  .pe2-overlay__path--coolant {
    stroke: var(--pe2-cool);
  }

  .pe2-overlay__path--air {
    stroke: var(--pe2-air);
  }

  .pe2-overlay__path--control {
    stroke: var(--pe2-air);
    stroke-dasharray: 5 5;
  }

  .pe2-split {
    display: flex;
    gap: 1rem;
    align-items: stretch;
  }

  .pe2-air-compare {
    width: 14.5rem;
    padding: 0.8rem;
    border: 1px solid var(--border);
    background: var(--bg);
    flex-shrink: 0;
  }

  .pe2-air-compare__rack {
    position: relative;
    height: 18.8rem;
    margin-top: 0.55rem;
    border: 1px solid var(--border-strong);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-subtle) 92%, transparent), transparent 42%), var(--bg);
    overflow: hidden;
  }

  .pe2-air-compare__fanwall,
  .pe2-air-compare__server {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }

  .pe2-air-compare__fanwall {
    top: 1rem;
    height: 2.4rem;
  }

  .pe2-air-compare__server {
    top: 4.5rem;
    height: 5.2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    padding: 0.55rem;
  }

  .pe2-air-compare__server--lower {
    top: 10.7rem;
  }

  .pe2-air-compare__server span {
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 82%, transparent);
  }

  .pe2-air-compare__airflow {
    position: absolute;
    inset: 0;
  }

  .pe2-air-compare__airflow span {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    height: 0;
    border-top: 2px dashed color-mix(in srgb, var(--pe2-air) 72%, transparent);
  }

  .pe2-air-compare__airflow span:nth-child(1) { top: 6.6rem; }
  .pe2-air-compare__airflow span:nth-child(2) { top: 8.9rem; }
  .pe2-air-compare__airflow span:nth-child(3) { top: 13rem; }

  .pe2-air-compare__copy {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pe2-stage__spotlight {
    padding: 0.95rem 1rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }

  .pe2-stage__spotlight-title {
    margin-top: 0.25rem;
    font-family: var(--font-editorial);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .pe2-stage__spotlight-copy {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .pe2-ledger__boundary,
  .pe2-ledger__currently,
  .pe2-ledger__metric-copy,
  .pe2-ledger__fact {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pe2-ledger__boundary {
    margin-top: 0.35rem;
  }

  .pe2-ledger__currently {
    margin-top: 0.7rem;
  }

  .pe2-ledger__metrics {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .pe2-ledger__metric-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe2-ledger__metric-value {
    margin-top: 0.18rem;
    font-family: var(--font-editorial);
    font-size: 1.35rem;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .pe2-ledger__metric-copy {
    margin-top: 0.18rem;
  }

  .pe2-ledger__fact {
    margin-top: 0.95rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .pe2-stage__handoff {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.9rem;
    margin-top: 0.3rem;
    border-top: 1px solid var(--border);
  }

  .pe2-stage__handoff-copy {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pe2-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  @media (max-width: 1500px) {
    .pe2-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pe2-steps {
      max-width: 42rem;
      margin-top: 0.25rem;
    }

    .pe2-sticky {
      order: -1;
    }
  }

  @media (max-width: 1180px) {
    .pe2-stage {
      grid-template-columns: 1fr;
    }

    .pe2-stage__topline,
    .pe2-stage__legend,
    .pe2-stage__controls,
    .pe2-stage__plane-note,
    .pe2-stage__map,
    .pe2-stage__spotlight,
    .pe2-stage__handoff,
    .pe2-ledger {
      grid-column: 1 / -1;
    }

    .pe2-ledger {
      grid-row: auto;
    }

    .pe2-rack-shell {
      width: min(100%, 24rem);
    }

    .pe2-stage__hero {
      flex-direction: column;
    }
  }

  @media (max-width: 900px) {
    .pe2-sticky {
      position: static;
    }

    .pe2-step {
      min-height: auto;
      padding-right: 0;
    }
  }

  @media (max-width: 720px) {
    .pe2-stage {
      padding: 0.9rem;
    }

    .pe2-stage__topline,
    .pe2-stage__controls {
      flex-direction: column;
      align-items: flex-start;
    }

    .pe2-stage__controls {
      width: 100%;
    }

    .pe2-stage__legend {
      gap: 0.55rem 0.9rem;
    }

    .pe2-split {
      flex-direction: column;
    }

    .pe2-rack-shell,
    .pe2-rack-shell--compact {
      width: 100%;
      max-width: 21rem;
      height: 34rem;
    }

    .pe2-stage__view-controls {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.2rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .pe2-air-compare {
      width: 100%;
      max-width: 21rem;
    }
  }

  .pe-scene-three {
    --pe3-blue: #5e8dd7;
    --pe3-gold: #b8892f;
    --pe3-heat: #bf6c4a;
    --pe3-cool: #5e9fb0;
    --pe3-air: #b8bbb9;
    --pe3-memory: #8a8eb8;
    --pe3-panel: color-mix(in srgb, var(--bg-subtle) 92%, transparent);
    --pe3-shadow: 0 14px 34px -28px rgba(26, 25, 24, 0.35);
    margin-top: 4rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--border);
  }

  [data-theme="dark"] .pe-scene-three {
    --pe3-blue: #8fb4ec;
    --pe3-gold: #d4ab57;
    --pe3-heat: #d48b69;
    --pe3-cool: #7abfd1;
    --pe3-air: #b2b6b3;
    --pe3-memory: #a5aad8;
    --pe3-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.72);
  }

  .pe3-intro {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .pe3-eyebrow,
  .pe3-step__meta,
  .pe3-stage__progress-label,
  .pe3-ledger__eyebrow,
  .pe3-stage__spotlight-kicker,
  .pe3-stage__handoff-title,
  .pe3-envelope__eyebrow,
  .pe3-minimap__eyebrow,
  .pe3-board-pane__title,
  .pe3-cutaway-pane__title,
  .pe3-stage__plane-note-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--font-body);
  }

  .pe3-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.55rem + 0.9vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .pe3-lede {
    max-width: 40rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .pe3-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 21rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.3vw, 2.5rem);
    align-items: start;
  }

  .pe3-steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pe3-step {
    min-height: 68vh;
    padding: 1.1rem 1rem 1.25rem 0;
    border-top: 1px solid var(--border);
    opacity: 0.52;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .pe3-step--active {
    opacity: 1;
    transform: translateX(0);
  }

  .pe3-step__title {
    margin: 0.4rem 0 0.65rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 1.2rem + 0.35vw, 1.7rem);
    line-height: 1.16;
    letter-spacing: -0.025em;
  }

  .pe3-step__body {
    margin: 0;
    max-width: 27rem;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.76;
    color: var(--text-secondary);
  }

  .pe3-sticky {
    position: sticky;
    top: 1.25rem;
    min-width: 0;
  }

  .pe3-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    background: var(--pe3-panel);
    box-shadow: var(--pe3-shadow);
    overflow: hidden;
  }

  .pe3-stage__topline,
  .pe3-stage__legend,
  .pe3-stage__controls,
  .pe3-stage__plane-note,
  .pe3-stage__hardware,
  .pe3-stage__spotlight,
  .pe3-stage__handoff {
    grid-column: 1 / 2;
  }

  .pe3-ledger {
    grid-column: 2 / 3;
    grid-row: 1 / span 7;
    align-self: start;
    padding: 0.9rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .pe3-stage__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .pe3-stage__progress {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pe3-stage__progress-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .pe3-stage__progress-dot {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--border-strong);
    background: transparent;
  }

  .pe3-stage__progress-dot--active {
    background: var(--accent);
    border-color: var(--accent);
  }

  .pe3-stage__caption {
    max-width: 26rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pe3-stage__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
    padding: 0.85rem 0 0.25rem;
  }

  .pe3-stage__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .pe3-stage__legend-swatch {
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid transparent;
  }

  .pe3-stage__legend-swatch--data {
    background: color-mix(in srgb, var(--pe3-blue) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe3-blue) 65%, transparent);
