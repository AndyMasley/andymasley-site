    border-color: color-mix(in srgb, var(--pe5-cache) 48%, transparent);
  }

  .pe5-grid__cell.is-active,
  .pe5-cache-wall__cell.is-active {
    background: color-mix(in srgb, var(--pe5-gold) 26%, transparent);
    border-color: color-mix(in srgb, var(--pe5-gold) 56%, transparent);
  }

  .pe5-grid__cell.is-cached,
  .pe5-cache-wall__cell.is-cached {
    background: color-mix(in srgb, var(--pe5-ghost) 16%, transparent);
    border-color: color-mix(in srgb, var(--pe5-ghost) 40%, transparent);
  }

  .pe5-grid__output-column {
    grid-column: -2 / -1;
    grid-row: 1 / span 12;
    align-self: stretch;
    justify-self: stretch;
    border: 1px solid color-mix(in srgb, var(--pe5-blue) 42%, var(--border));
    background: color-mix(in srgb, var(--pe5-blue) 12%, transparent);
    position: relative;
  }

  .pe5-grid__output-column span {
    position: absolute;
    left: 0.1rem;
    right: 0.1rem;
    top: 0.1rem;
    bottom: 0.1rem;
    background: color-mix(in srgb, var(--pe5-blue) 22%, transparent);
  }

  .pe5-grid-pane.is-narrowing .pe5-grid__cells {
    opacity: 1;
  }

  .pe5-cache-wall {
    display: grid;
    grid-template-columns: repeat(var(--pe5-cache-cols), minmax(0, 1fr));
    gap: 0.14rem;
  }

  .pe5-inspector.is-expanded {
    box-shadow: 0 10px 24px -20px rgba(0, 0, 0, 0.28);
  }

  .pe5-inspector__ops {
    display: grid;
    gap: 0.45rem;
  }

  .pe5-inspector__op {
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-subtle) 88%, transparent);
  }

  .pe5-inspector__op.is-active {
    border-color: color-mix(in srgb, var(--pe5-cache) 54%, transparent);
    background: color-mix(in srgb, var(--pe5-cache) 10%, transparent);
  }

  .pe5-inspector__op-name {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.12rem;
  }

  .pe5-inspector__op-copy {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .pe5-attention {
    margin-top: 0.9rem;
  }

  .pe5-attention__title {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.45rem;
  }

  .pe5-attention__matrix {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 0.16rem;
    width: 17rem;
    max-width: 100%;
    padding: 0.45rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-subtle) 88%, transparent);
  }

  .pe5-attention__cell {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-subtle) 84%, transparent);
  }

  .pe5-attention__cell.is-allowed {
    background: color-mix(in srgb, var(--pe5-cache) 18%, transparent);
    border-color: color-mix(in srgb, var(--pe5-cache) 40%, transparent);
  }

  .pe5-attention__cell.is-blocked {
    opacity: 0.35;
  }

  .pe5-attention__tile {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--pe5-gold) 60%, transparent);
    background: color-mix(in srgb, var(--pe5-gold) 12%, transparent);
    pointer-events: none;
  }

  .pe5-attention__note {
    margin-top: 0.55rem;
    font-size: 0.82rem;
    line-height: 1.58;
    color: var(--text-secondary);
  }

  .pe5-answer__bubble {
    margin-top: 0.45rem;
    font-family: var(--font-editorial);
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    min-height: 2.2rem;
  }

  .pe5-answer:not(.is-visible) .pe5-answer__bubble {
    color: var(--dim);
  }

  .pe5-stage__spotlight {
    grid-column: 1 / 2;
  }

  .pe5-stage__spotlight-title {
    margin-top: 0.22rem;
    font-size: 1.1rem;
    line-height: 1.24;
  }

  .pe5-ledger__currently {
    margin-top: 0.2rem;
  }

  .pe5-ledger__metrics {
    display: grid;
    gap: 0.8rem;
    margin-top: 0.85rem;
  }

  .pe5-ledger__metric-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe5-ledger__metric-value {
    margin-top: 0.2rem;
    font-family: var(--font-editorial);
    font-size: 1.1rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .pe5-ledger__fact {
    margin-top: 0.85rem;
  }

  .pe5-stage__handoff-copy {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    line-height: 1.46;
  }

  .pe5-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1260px) {
    .pe5-stage {
      grid-template-columns: 1fr;
    }

    .pe5-stage__spotlight,
    .pe5-ledger {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 1080px) {
    .pe5-layout {
      grid-template-columns: 1fr;
    }

    .pe5-steps {
      order: 2;
    }

    .pe5-sticky {
      position: static;
      order: 1;
    }

    .pe5-step {
      min-height: auto;
      padding-right: 0;
    }
  }

  @media (max-width: 900px) {
    .pe5-stage__hardware {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .pe5-stage {
      padding: 0.9rem;
    }

    .pe5-stage__topline,
    .pe5-stage__controls {
      flex-direction: column;
      align-items: flex-start;
    }

    .pe5-grid {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .pe5-attention__matrix {
      width: 100%;
    }
  }

  .pe-scene-six {
    --pe6-blue: #5e8dd7;
    --pe6-gold: #b8892f;
    --pe6-cache: #6c74cb;
    --pe6-ghost: #8c877f;
    --pe6-heat: #c97754;
    --pe6-panel: color-mix(in srgb, var(--bg-subtle) 92%, transparent);
    --pe6-shadow: 0 14px 34px -28px rgba(26, 25, 24, 0.35);
  }

  [data-theme="dark"] .pe-scene-six {
    --pe6-blue: #8fb4ec;
    --pe6-gold: #d4ab57;
    --pe6-cache: #a1aaf4;
    --pe6-ghost: #878175;
    --pe6-heat: #e0916d;
    --pe6-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.72);
  }

  .pe6-intro {
    max-width: 44rem;
    margin: 4rem 0 1.8rem;
  }

  .pe6-eyebrow,
  .pe6-step__meta,
  .pe6-stage__progress-label,
  .pe6-stage__spotlight-kicker,
  .pe6-ledger__eyebrow,
  .pe6-stage__handoff-title,
  .pe6-tbt__eyebrow,
  .pe6-answer-pane__title,
  .pe6-die-pane__title,
  .pe6-cache-pane__title,
  .pe6-physical__title,
  .pe6-scheduler__title,
  .pe6-accel__title,
  .pe6-stage__plane-note-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--font-body);
  }

  .pe6-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.55rem + 0.9vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .pe6-lede {
    max-width: 40rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .pe6-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 21rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.3vw, 2.5rem);
    align-items: start;
  }

  .pe6-steps {
    display: grid;
    gap: 1rem;
  }

  .pe6-step {
    min-height: 60vh;
    padding-right: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    padding-left: 1rem;
    transition: border-color 180ms ease, opacity 180ms ease;
    opacity: 0.68;
  }

  .pe6-step--active {
    opacity: 1;
    border-color: color-mix(in srgb, var(--pe6-cache) 36%, var(--border));
  }

  .pe6-step__title {
    margin: 0.3rem 0 0.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.45rem, 1.2rem + 0.4vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .pe6-step__body {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .pe6-sticky {
    position: sticky;
    top: 5rem;
  }

  .pe6-stage {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    background: var(--pe6-panel);
    box-shadow: var(--pe6-shadow);
    backdrop-filter: blur(12px);
  }

  .pe6-stage__topline,
  .pe6-tbt,
  .pe6-stage__legend,
  .pe6-stage__controls,
  .pe6-stage__plane-note,
  .pe6-stage__hardware,
  .pe6-stage__handoff {
    display: grid;
    gap: 0.75rem;
  }

  .pe6-stage__topline {
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    align-items: end;
    gap: 1rem;
  }

  .pe6-stage__progress {
    display: grid;
    gap: 0.45rem;
  }

  .pe6-stage__progress-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pe6-stage__progress-dot {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pe6-ghost) 26%, transparent);
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .pe6-stage__progress-dot--active {
    transform: scale(1.15);
    background: color-mix(in srgb, var(--pe6-heat) 72%, transparent);
  }

  .pe6-stage__caption,
  .pe6-answer-pane__caption,
  .pe6-die-pane__caption,
  .pe6-cache-pane__caption,
  .pe6-physical__caption,
  .pe6-scheduler__caption,
  .pe6-accel__caption,
  .pe6-stage__plane-note-copy,
  .pe6-stage__spotlight-copy,
  .pe6-ledger__boundary,
  .pe6-ledger__currently,
  .pe6-ledger__metric-copy,
  .pe6-ledger__fact,
  .pe6-stage__handoff-copy,
  .pe6-scheduler__card-note,
  .pe6-answer-pane__history-note,
  .pe6-tbt__status {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pe6-tbt,
  .pe6-answer-pane,
  .pe6-die-pane,
  .pe6-cache-pane,
  .pe6-physical,
  .pe6-scheduler,
  .pe6-accel,
  .pe6-stage__spotlight,
  .pe6-ledger,
  .pe6-stage__plane-note,
  .pe6-stage__handoff {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    padding: 0.9rem;
  }

  .pe6-tbt.is-active,
  .pe6-answer-pane.is-active,
  .pe6-cache-pane.is-active,
  .pe6-physical.is-active,
  .pe6-scheduler.is-active,
  .pe6-accel.is-active {
    border-color: color-mix(in srgb, var(--pe6-cache) 44%, var(--border));
  }

  .pe6-tbt__header,
  .pe6-answer-pane__header,
  .pe6-die-pane__header,
  .pe6-cache-pane__header,
  .pe6-physical__header,
  .pe6-scheduler__header,
  .pe6-accel__header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .pe6-tbt__title,
  .pe6-stage__spotlight-title,
  .pe6-stage__plane-note-title,
  .pe6-stage__handoff-copy {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .pe6-tbt__bar {
    position: relative;
    height: 0.9rem;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--pe6-blue) 22%, var(--border));
    background: color-mix(in srgb, var(--pe6-blue) 8%, transparent);
  }

  .pe6-tbt__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: inherit;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pe6-blue) 50%, transparent), color-mix(in srgb, var(--pe6-gold) 44%, transparent));
    transition: width 240ms ease;
  }

  .pe6-tbt__tick {
    position: absolute;
    top: -0.08rem;
    width: 1px;
    height: 1rem;
    background: color-mix(in srgb, var(--pe6-ghost) 34%, transparent);
  }

  .pe6-tbt__metrics {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .pe6-tbt__metric {
    display: grid;
    gap: 0.2rem;
    padding: 0.65rem 0.7rem;
    border-radius: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 62%, transparent);
  }

  .pe6-tbt__metric span {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe6-tbt__metric strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .pe6-stage__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .pe6-stage__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .pe6-stage__legend-swatch {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.28rem;
    border: 1px solid transparent;
  }

  .pe6-stage__legend-swatch--data {
    background: color-mix(in srgb, var(--pe6-blue) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe6-blue) 60%, transparent);
  }

  .pe6-stage__legend-swatch--power {
    background: color-mix(in srgb, var(--pe6-gold) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe6-gold) 66%, transparent);
  }

  .pe6-stage__legend-swatch--cache {
    background: color-mix(in srgb, var(--pe6-cache) 20%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 58%, transparent);
  }

  .pe6-stage__legend-swatch--heat {
    background: color-mix(in srgb, var(--pe6-heat) 18%, transparent);
    border-color: color-mix(in srgb, var(--pe6-heat) 56%, transparent);
  }

  .pe6-stage__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .pe6-stage__toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .pe6-stage__toggle,
  .pe6-stage__follow {
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 68%, transparent);
    color: var(--text);
    padding: 0.52rem 0.8rem;
    border-radius: 999px;
    font: inherit;
    cursor: pointer;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .pe6-stage__toggle.is-active {
    border-color: color-mix(in srgb, var(--pe6-cache) 56%, var(--border));
    transform: translateY(-1px);
  }

  .pe6-stage__hardware {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.95fr);
    gap: 1rem;
    align-items: start;
  }

  .pe6-stage__main,
  .pe6-stage__side {
    display: grid;
    gap: 1rem;
  }

  .pe6-answer-pane__batch {
    display: grid;
    gap: 0.5rem;
  }

  .pe6-answer-pane__batch-lane {
    display: grid;
    grid-template-columns: 4.8rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
  }

  .pe6-answer-pane__batch-label,
  .pe6-physical__label,
  .pe6-scheduler__card-title,
  .pe6-spec__label {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe6-answer-pane__batch-track {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .pe6-answer-pane__batch-track span,
  .pe6-answer-stream__token,
  .pe6-answer-stream__overflow,
  .pe6-answer-stream__stop,
  .pe6-spec__track span,
  .pe6-spec__window {
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--pe6-blue) 22%, var(--border));
    background: color-mix(in srgb, var(--pe6-blue) 8%, transparent);
    padding: 0.34rem 0.62rem;
    font-size: 0.92rem;
    line-height: 1;
  }

  .pe6-answer-pane__batch-track span.is-live,
  .pe6-answer-stream__token.is-live {
    border-color: color-mix(in srgb, var(--pe6-blue) 48%, var(--border));
    background: color-mix(in srgb, var(--pe6-blue) 18%, transparent);
  }

  .pe6-answer-pane__chooser {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--pe6-gold) 22%, var(--border));
    background: color-mix(in srgb, var(--pe6-gold) 8%, transparent);
  }

  .pe6-answer-pane__chooser span {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe6-answer-pane__chooser strong {
    font-size: 0.94rem;
  }

  .pe6-answer-stream {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .pe6-answer-stream__stop {
    border-color: color-mix(in srgb, var(--pe6-heat) 40%, var(--border));
    background: color-mix(in srgb, var(--pe6-heat) 12%, transparent);
  }

  .pe6-answer-pane__history {
    display: grid;
    gap: 0.45rem;
  }

  .pe6-answer-pane__history-header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .pe6-answer-pane__history-bar {
    height: 0.75rem;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--pe6-cache) 22%, var(--border));
    background: color-mix(in srgb, var(--pe6-cache) 8%, transparent);
  }

  .pe6-answer-pane__history-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pe6-cache) 56%, transparent), color-mix(in srgb, var(--pe6-blue) 38%, transparent));
  }

  .pe6-die-wrap {
    position: relative;
  }

  .pe6-package-ghost {
    position: absolute;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--pe6-ghost) 40%, var(--border));
    background: color-mix(in srgb, var(--pe6-ghost) 10%, transparent);
  }

  .pe6-die {
    position: relative;
    aspect-ratio: 1000 / 450;
    border-radius: 1.05rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--pe6-ghost) 18%, var(--border));
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--pe6-blue) 5%, var(--bg-subtle)) 0%, var(--bg-subtle) 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-subtle) 88%, transparent), color-mix(in srgb, var(--bg) 88%, transparent));
  }

  .pe6-die__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pe6-die__slab,
  .pe6-die__heat,
  .pe6-die__io,
  .pe6-die__gpc,
  .pe6-die__l2,
  .pe6-die__l2-segment,
  .pe6-die__gateway,
  .pe6-die__footer,
  .pe6-die__path {
    transition: opacity 220ms ease, fill 220ms ease, stroke 220ms ease;
  }

  .pe6-die__slab {
    fill: color-mix(in srgb, var(--bg) 88%, transparent);
    stroke: color-mix(in srgb, var(--pe6-ghost) 34%, var(--border));
    stroke-width: 2;
  }

  .pe6-die__heat {
    fill: color-mix(in srgb, var(--pe6-heat) 18%, transparent);
  }

  .pe6-die__io,
  .pe6-die__footer {
    fill: color-mix(in srgb, var(--pe6-ghost) 14%, transparent);
    stroke: color-mix(in srgb, var(--pe6-ghost) 30%, transparent);
    stroke-width: 1.5;
  }

  .pe6-die__gpc {
    fill: color-mix(in srgb, var(--pe6-gold) 5%, transparent);
    stroke: color-mix(in srgb, var(--pe6-gold) 18%, transparent);
    stroke-width: 1.5;
  }

  .pe6-die__gpc.is-active {
    fill: color-mix(in srgb, var(--pe6-gold) 12%, transparent);
  }

  .pe6-die__l2 {
    fill: color-mix(in srgb, var(--pe6-cache) 8%, transparent);
    stroke: color-mix(in srgb, var(--pe6-cache) 26%, transparent);
    stroke-width: 1.5;
  }

  .pe6-die__l2.is-active,
  .pe6-die__l2-segment.is-active,
  .pe6-die__gateway.is-active {
    fill: color-mix(in srgb, var(--pe6-cache) 18%, transparent);
  }

  .pe6-die__l2-segment,
  .pe6-die__gateway {
    fill: color-mix(in srgb, var(--pe6-cache) 10%, transparent);
    stroke: color-mix(in srgb, var(--pe6-cache) 28%, transparent);
    stroke-width: 1.5;
  }

  .pe6-die__path {
    fill: none;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.24;
  }

  .pe6-die__path.is-active {
    opacity: 1;
  }

  .pe6-die__path--compute {
    stroke: color-mix(in srgb, var(--pe6-gold) 70%, transparent);
  }

  .pe6-die__path--cache {
    stroke: color-mix(in srgb, var(--pe6-cache) 72%, transparent);
  }

  .pe6-die__path--memory,
  .pe6-die__path--answer {
    stroke: color-mix(in srgb, var(--pe6-blue) 72%, transparent);
  }

  .pe6-die__path--interconnect {
    stroke: color-mix(in srgb, var(--pe6-ghost) 34%, transparent);
    opacity: 0.18;
  }

  .pe6-zone {
    position: absolute;
    inset: auto;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .pe6-zone.is-active {
    outline: 1px dashed color-mix(in srgb, var(--pe6-blue) 48%, transparent);
    outline-offset: 0.22rem;
    border-radius: 1rem;
  }

  .pe6-zone:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--pe6-blue) 60%, var(--border));
    outline-offset: 0.22rem;
    border-radius: 1rem;
  }

  .pe6-zone--loop { inset: 14% 16% 23% 16%; }
  .pe6-zone--memory { left: 10%; right: 10%; top: 38%; height: 22%; }
  .pe6-zone--heat { left: 5%; right: 5%; top: 7%; bottom: 7%; }

  .pe6-cache-pane__bands {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 13fr);
    gap: 0.55rem;
  }

  .pe6-cache-pane__band {
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: var(--dim);
  }

  .pe6-cache-pane__band--prompt {
    background: color-mix(in srgb, var(--pe6-ghost) 10%, transparent);
  }

  .pe6-cache-pane__band--answer {
    background: color-mix(in srgb, var(--pe6-cache) 10%, transparent);
  }

  .pe6-cache-wall {
    display: grid;
    grid-template-columns: repeat(var(--pe6-cache-cols), minmax(0, 1fr));
    gap: 0.18rem;
  }

  .pe6-cache-wall__cell {
    aspect-ratio: 1 / 1;
    border-radius: 0.24rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 64%, transparent);
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .pe6-cache-wall__cell.is-prompt {
    background: color-mix(in srgb, var(--pe6-cache) 14%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 34%, transparent);
  }

  .pe6-cache-wall__cell.is-shared {
    background: color-mix(in srgb, var(--pe6-ghost) 16%, transparent);
    border-color: color-mix(in srgb, var(--pe6-ghost) 40%, transparent);
  }

  .pe6-cache-wall__cell.is-complete {
    background: color-mix(in srgb, var(--pe6-cache) 24%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 54%, transparent);
  }

  .pe6-cache-wall__cell.is-active {
    background: color-mix(in srgb, var(--pe6-gold) 24%, transparent);
    border-color: color-mix(in srgb, var(--pe6-gold) 52%, transparent);
  }

  .pe6-physical__compare {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.85rem;
  }

  .pe6-physical__panel {
    display: grid;
    gap: 0.55rem;
  }

  .pe6-physical__naive {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.32rem;
  }

  .pe6-physical__naive-block,
  .pe6-physical__block,
  .pe6-physical__logical-anchor {
    border-radius: 0.28rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 60%, transparent);
  }

  .pe6-physical__naive-block {
    aspect-ratio: 1 / 1;
  }

  .pe6-physical__naive-block.is-used {
    background: color-mix(in srgb, var(--pe6-cache) 24%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 52%, transparent);
  }

  .pe6-physical__naive-block.is-reserved {
    background: color-mix(in srgb, var(--pe6-gold) 12%, transparent);
    border-color: color-mix(in srgb, var(--pe6-gold) 34%, transparent);
  }

  .pe6-physical__naive-block.is-hole {
    background: color-mix(in srgb, var(--pe6-heat) 10%, transparent);
    border-color: color-mix(in srgb, var(--pe6-heat) 32%, transparent);
  }

  .pe6-physical__pool {
    position: relative;
    min-height: 10rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 52%, transparent);
    overflow: hidden;
  }

  .pe6-physical__logical-strip {
    position: absolute;
    inset: 0;
  }

  .pe6-physical__logical-anchor {
    position: absolute;
    width: 8%;
    height: 8%;
    transform: translate(-50%, -50%);
    background: color-mix(in srgb, var(--pe6-cache) 18%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 42%, transparent);
  }

  .pe6-physical__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pe6-physical__links line {
    stroke: color-mix(in srgb, var(--pe6-blue) 46%, transparent);
    stroke-width: 0.75;
  }

  .pe6-physical__block {
    position: absolute;
    width: 12%;
    height: 10%;
    transform: translate(-50%, -50%);
  }

  .pe6-physical__block.is-used {
    background: color-mix(in srgb, var(--pe6-cache) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 54%, transparent);
  }

  .pe6-physical__block.is-shared {
    background: color-mix(in srgb, var(--pe6-ghost) 18%, transparent);
    border-color: color-mix(in srgb, var(--pe6-ghost) 44%, transparent);
  }

  .pe6-scheduler__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .pe6-scheduler__card {
    display: grid;
    gap: 0.5rem;
    padding: 0.7rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 54%, transparent);
  }

  .pe6-scheduler__lanes,
  .pe6-scheduler__execution {
    display: grid;
    gap: 0.26rem;
  }

  .pe6-scheduler__lane,
  .pe6-scheduler__execution {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.22rem;
  }

  .pe6-scheduler__lane span,
  .pe6-scheduler__execution span {
    aspect-ratio: 1 / 1;
    border-radius: 0.22rem;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg) 54%, transparent);
  }

  .pe6-scheduler__lane span.is-decode,
  .pe6-scheduler__execution span.is-decode {
    background: color-mix(in srgb, var(--pe6-cache) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe6-cache) 52%, transparent);
  }

  .pe6-scheduler__lane span.is-prefill,
  .pe6-scheduler__execution span.is-prefill {
    background: color-mix(in srgb, var(--pe6-gold) 18%, transparent);
    border-color: color-mix(in srgb, var(--pe6-gold) 44%, transparent);
  }

  .pe6-scheduler__lane span.is-wait,
  .pe6-scheduler__execution span.is-wait {
    background: color-mix(in srgb, var(--pe6-heat) 8%, transparent);
    border-color: color-mix(in srgb, var(--pe6-heat) 24%, transparent);
  }

  .pe6-spec,
  .pe6-medusa {
    display: grid;
    gap: 0.8rem;
  }

  .pe6-spec__lane {
    display: grid;
    gap: 0.45rem;
  }

  .pe6-spec__track {
    display: flex;
    gap: 0.42rem;
    flex-wrap: wrap;
  }

  .pe6-spec__window {
    border-color: color-mix(in srgb, var(--pe6-gold) 44%, var(--border));
    background: color-mix(in srgb, var(--pe6-gold) 14%, transparent);
  }

  .pe6-medusa {
    position: relative;
    min-height: 11rem;
    padding: 0.4rem 0;
  }

  .pe6-medusa__spine {
    position: absolute;
    left: 1.6rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    background: color-mix(in srgb, var(--pe6-cache) 42%, transparent);
  }

  .pe6-medusa__branch {
    position: absolute;
    left: 2.1rem;
    right: 0;
    top: var(--pe6-branch-top);
    display: grid;
    gap: 0.35rem;
    transform: translateY(-50%);
  }

  .pe6-medusa__branch span {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe6-medusa__branch-track {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .pe6-medusa__branch-track span {
    width: 2rem;
    height: 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--pe6-blue) 24%, var(--border));
    background: color-mix(in srgb, var(--pe6-blue) 10%, transparent);
  }

  .pe6-stage__spotlight-title {
    font-family: var(--font-editorial);
    font-size: 1.12rem;
    line-height: 1.18;
  }

  .pe6-ledger__currently {
    margin-top: 0.2rem;
  }

  .pe6-ledger__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 0.7rem;
  }

  .pe6-ledger__metric {
    display: grid;
    gap: 0.18rem;
  }

  .pe6-ledger__metric-label {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pe6-ledger__metric-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .pe6-ledger__fact {
    margin-top: 0.7rem;
  }

  .pe6-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1120px) {
    .pe6-layout {
      grid-template-columns: 1fr;
    }

    .pe6-steps {
      order: 2;
    }

    .pe6-sticky {
      position: static;
      order: 1;
    }

    .pe6-step {
      min-height: auto;
      padding-right: 0;
    }
  }

  @media (max-width: 980px) {
    .pe6-stage__hardware,
    .pe6-physical__compare,
    .pe6-scheduler__cards,
    .pe6-tbt__metrics {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .pe6-stage {
      padding: 0.9rem;
    }

    .pe6-stage__topline,
    .pe6-stage__controls,
    .pe6-answer-pane__header,
    .pe6-die-pane__header,
    .pe6-cache-pane__header,
    .pe6-physical__header,
    .pe6-scheduler__header,
    .pe6-accel__header,
    .pe6-tbt__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .pe6-answer-pane__batch-lane {
      grid-template-columns: 1fr;
    }

    .pe6-ledger__metrics {
      grid-template-columns: 1fr;
    }
  }

  .pe-scene-seven {
    --pe7-heat: #c87954;
    --pe7-coolant: #5f9dc0;
    --pe7-air: #a4b5be;
    --pe7-facility: #7d78b8;
    --pe7-ghost: #8b857b;
    --pe7-panel: color-mix(in srgb, var(--bg-subtle) 92%, transparent);
    --pe7-shadow: 0 14px 34px -28px rgba(26, 25, 24, 0.35);
  }

  [data-theme="dark"] .pe-scene-seven {
    --pe7-heat: #e0906b;
    --pe7-coolant: #86bedc;
    --pe7-air: #bcc9cf;
    --pe7-facility: #a29de6;
    --pe7-ghost: #87806f;
    --pe7-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.72);
  }

  .pe7-intro {
    max-width: 44rem;
    margin: 4rem 0 1.8rem;
  }

  .pe7-eyebrow,
  .pe7-step__meta,
  .pe7-stage__progress-label,
  .pe7-stage__spotlight-kicker,
  .pe7-ledger__eyebrow,
  .pe7-stage__handoff-title,
  .pe7-heatbar__eyebrow,
  .pe7-stack-pane__title,
  .pe7-rack-pane__title,
  .pe7-loop-pane__title,
  .pe7-engineer__title,
  .pe7-fault__title,
  .pe7-stage__plane-note-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    font-family: var(--font-body);
  }

  .pe7-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.55rem + 0.9vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .pe7-lede {
    max-width: 40rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .pe7-layout {
    display: grid;
    grid-template-columns: minmax(16rem, 21rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.3vw, 2.5rem);
    align-items: start;
  }

  .pe7-steps {
    display: grid;
    gap: 1rem;
  }

  .pe7-step {
    min-height: 58vh;
    padding-right: 1rem;
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    opacity: 0.68;
    transition: border-color 180ms ease, opacity 180ms ease;
  }

  .pe7-step--active {
    opacity: 1;
    border-color: color-mix(in srgb, var(--pe7-facility) 34%, var(--border));
  }

  .pe7-step__title {
    margin: 0.3rem 0 0.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.45rem, 1.2rem + 0.4vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .pe7-step__body {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .pe7-sticky {
    position: sticky;
    top: 5rem;
  }

  .pe7-stage {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border-radius: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    background: var(--pe7-panel);
    box-shadow: var(--pe7-shadow);
    backdrop-filter: blur(12px);
  }

  .pe7-stage__topline,
  .pe7-stage__legend,
  .pe7-stage__controls,
  .pe7-stage__plane-note,
  .pe7-stage__hardware,
  .pe7-stage__handoff {
    display: grid;
    gap: 0.75rem;
  }

  .pe7-stage__topline {
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    align-items: end;
    gap: 1rem;
  }

  .pe7-stage__progress {
    display: grid;
    gap: 0.45rem;
  }

  .pe7-stage__progress-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pe7-stage__progress-dot {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pe7-ghost) 26%, transparent);
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .pe7-stage__progress-dot--active {
    transform: scale(1.15);
    background: color-mix(in srgb, var(--pe7-heat) 74%, transparent);
  }

  .pe7-stage__caption,
  .pe7-heatbar__status,
  .pe7-stack-pane__caption,
  .pe7-rack-pane__caption,
  .pe7-loop-pane__caption,
  .pe7-engineer__caption,
  .pe7-fault__caption,
  .pe7-stage__plane-note-copy,
  .pe7-stage__spotlight-copy,
  .pe7-ledger__boundary,
  .pe7-ledger__currently,
  .pe7-ledger__metric-copy,
  .pe7-ledger__fact,
  .pe7-stage__handoff-copy,
  .pe7-heatbar__legend,
  .pe7-answer__note {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pe7-heatbar,
  .pe7-stack-pane,
  .pe7-rack-pane,
  .pe7-loop-pane,
  .pe7-engineer,
  .pe7-fault,
  .pe7-stage__spotlight,
  .pe7-ledger,
  .pe7-stage__plane-note,
  .pe7-stage__handoff {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 78%, transparent);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    padding: 0.9rem;
  }

  .pe7-heatbar.is-active,
  .pe7-engineer.is-active,
  .pe7-fault.is-active {
    border-color: color-mix(in srgb, var(--pe7-facility) 44%, var(--border));
  }

  .pe7-heatbar__header,
  .pe7-stack-pane__header,
  .pe7-rack-pane__header,
  .pe7-loop-pane__header,
  .pe7-engineer__header,
  .pe7-fault__header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .pe7-heatbar__title,
  .pe7-stage__spotlight-title,
  .pe7-stage__plane-note-title,
  .pe7-stage__handoff-copy {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .pe7-heatbar__bar {
    display: flex;
    height: 0.95rem;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 60%, transparent);
  }

  .pe7-heatbar__segment {
    display: block;
    height: 100%;
  }

  .pe7-heatbar__segment--liquid {
    background: color-mix(in srgb, var(--pe7-coolant) 58%, transparent);
  }

  .pe7-heatbar__segment--air {
    background: color-mix(in srgb, var(--pe7-air) 62%, transparent);
  }

  .pe7-heatbar__segment--facility {
    background: color-mix(in srgb, var(--pe7-facility) 56%, transparent);
  }

  .pe7-heatbar__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }

  .pe7-stage__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .pe7-stage__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .pe7-stage__legend-swatch {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.28rem;
    border: 1px solid transparent;
  }

  .pe7-stage__legend-swatch--heat {
    background: color-mix(in srgb, var(--pe7-heat) 20%, transparent);
    border-color: color-mix(in srgb, var(--pe7-heat) 58%, transparent);
  }

  .pe7-stage__legend-swatch--coolant {
    background: color-mix(in srgb, var(--pe7-coolant) 22%, transparent);
    border-color: color-mix(in srgb, var(--pe7-coolant) 58%, transparent);
  }

  .pe7-stage__legend-swatch--air {
    background: color-mix(in srgb, var(--pe7-air) 20%, transparent);
    border-color: color-mix(in srgb, var(--pe7-air) 58%, transparent);
  }

  .pe7-stage__legend-swatch--facility {
    background: color-mix(in srgb, var(--pe7-facility) 20%, transparent);
    border-color: color-mix(in srgb, var(--pe7-facility) 58%, transparent);
  }

  .pe7-stage__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .pe7-stage__toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .pe7-stage__toggle,
  .pe7-stage__follow {
    border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background: color-mix(in srgb, var(--bg-subtle) 68%, transparent);
    color: var(--text);
    padding: 0.52rem 0.8rem;
    border-radius: 999px;
    font: inherit;
    cursor: pointer;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .pe7-stage__toggle.is-active {
    border-color: color-mix(in srgb, var(--pe7-coolant) 58%, var(--border));
    transform: translateY(-1px);
  }

