---
import Base from '@/layouts/Base.astro';
import TrafficComparison from '@/components/traffic/TrafficComparison';
---
<Base title="Traffic deaths & injuries" description="The scale of the U.S. road toll and individually documented AV casualties in 2026. One person per mark, with deaths, injuries, and animals." activeNav="/visuals">
  <article class="traffic-page">
    <header class="traffic-opening">
      <h1>Traffic deaths & injuries</h1>
      <p class="traffic-dates">United States · January 1–September 5, 2026</p>
      <p class="traffic-premise">National estimates alongside reported AV casualties. The national total includes AVs; involvement does not establish fault. <a href="#counting">How counted</a></p>
      <nav class="traffic-jumps" aria-label="Casualty sections"><a href="#deaths">Deaths</a><span>·</span><a href="#injuries">Injuries</a><span>·</span><a href="#animals">Animals</a></nav>
    </header>
    <TrafficComparison client:load />
    <noscript><p>The casualty totals, case accounts and sources are readable without JavaScript. Drawing each individual mark requires JavaScript.</p></noscript>
  </article>
</Base>
<style>
  :global(html:has(.traffic-page)) { scroll-behavior: auto; }
  :global(.main-content:has(.traffic-page) > .header) { margin-bottom: var(--space-xl); }
  .traffic-page { width: min(1040px, calc(100vw - 3rem)); position: relative; left: 50%; transform: translateX(-50%); font-size: var(--text-base); }
  .traffic-opening { margin: 0 0 1.1rem; }
  .traffic-opening h1 { margin: 0 0 0.3rem; font-size: var(--text-2xl); }
  .traffic-dates { margin: 0; color: var(--dim); }
  .traffic-premise { max-width: 700px; margin: 0.6rem 0; line-height: var(--leading-note); }
  .traffic-jumps { display: flex; gap: 0.6rem; align-items: baseline; margin-top: 0.7rem; }
  .traffic-jumps span { color: var(--dim); }
  @media (max-width: 600px) { .traffic-page { width: calc(100vw - 2rem); } .traffic-opening h1 { font-size: var(--text-xl); } }
</style>
