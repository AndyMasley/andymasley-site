<script define:vars={{ modeCopy, cutOptions, grossTotalMmt, population2022 }}>
  document.addEventListener('astro:page-load', initNationalCarbonFootprint);

  function initNationalCarbonFootprint() {
    const root = document.getElementById('ncfp');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const buttons = root.querySelectorAll('.ncfp-toggle-btn');
    const totalLabel = document.getElementById('ncfp-total-label');
    const totalValue = document.getElementById('ncfp-total-value');
    const totalUnit = document.getElementById('ncfp-total-unit');
    const subline = document.getElementById('ncfp-subline');
    const context = document.getElementById('ncfp-context');
    const swapEls = root.querySelectorAll('[data-total][data-percapita]');
    const cutItems = [...root.querySelectorAll('.ncfp-cut-item')];
    const cutSummary = document.getElementById('ncfp-cut-summary');
    const cutTotals = {
      lifestyle: document.getElementById('ncfp-cut-total-lifestyle'),
      systemic: document.getElementById('ncfp-cut-total-systemic'),
    };
    const cutRows = {
      current: {
        remainingText: document.getElementById('ncfp-row-current-remaining'),
        savedText: document.getElementById('ncfp-row-current-saved'),
        remainingBar: document.getElementById('ncfp-bar-current-remaining'),
        savedBar: document.getElementById('ncfp-bar-current-saved'),
      },
      lifestyle: {
        remainingText: document.getElementById('ncfp-row-lifestyle-remaining'),
        savedText: document.getElementById('ncfp-row-lifestyle-saved'),
        remainingBar: document.getElementById('ncfp-bar-lifestyle-remaining'),
        savedBar: document.getElementById('ncfp-bar-lifestyle-saved'),
      },
      systemic: {
        remainingText: document.getElementById('ncfp-row-systemic-remaining'),
        savedText: document.getElementById('ncfp-row-systemic-saved'),
        remainingBar: document.getElementById('ncfp-bar-systemic-remaining'),
        savedBar: document.getElementById('ncfp-bar-systemic-saved'),
      },
      combined: {
        remainingText: document.getElementById('ncfp-row-combined-remaining'),
        savedText: document.getElementById('ncfp-row-combined-saved'),
        remainingBar: document.getElementById('ncfp-bar-combined-remaining'),
        savedBar: document.getElementById('ncfp-bar-combined-saved'),
      },
    };
    let currentMode = 'total';

    function formatScenarioValue(mmt) {
      if (currentMode === 'total') {
        return `${mmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT CO2e / yr`;
      }

      const perCapita = mmt * 1e6 / population2022;
      const digits = perCapita >= 10 ? 1 : 2;
      return `${perCapita.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits })} t CO2e / person / yr`;
    }

    function formatCompactCut(mmt) {
      if (currentMode === 'total') {
        if (mmt >= 1000) return `${(mmt / 1000).toFixed(2)}B tons`;
        return `${mmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT`;
      }

      const perCapita = mmt * 1e6 / population2022;
      const digits = perCapita >= 10 ? 1 : 2;
      return `${perCapita.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits })} t/person`;
    }

    function getSelectedCuts() {
      return cutItems
        .filter((item) => item.querySelector('input[type="checkbox"]')?.checked)
        .map((item) => cutOptions.find((option) => option.key === item.dataset.cutKey))
        .filter(Boolean);
    }

    function updateCutRow(rowKey, remaining, saved) {
      const row = cutRows[rowKey];
      if (!row) return;

      row.remainingText.textContent = formatScenarioValue(remaining);
      row.savedText.textContent = saved > 0 ? `Cut: ${formatCompactCut(saved)}` : 'No cuts yet';
      row.remainingBar.style.width = `${Math.max(remaining / grossTotalMmt * 100, 0)}%`;
      row.savedBar.style.width = `${Math.max(saved / grossTotalMmt * 100, 0)}%`;
    }

    function renderCuts() {
      cutItems.forEach((item) => {
        const checked = item.querySelector('input[type="checkbox"]')?.checked;
        item.classList.toggle('checked', Boolean(checked));
      });

      const selected = getSelectedCuts();
      const lifestyleSaved = selected
        .filter((option) => option.cat === 'lifestyle')
        .reduce((sum, option) => sum + option.totalMmt, 0);
      const systemicSaved = selected
        .filter((option) => option.cat === 'systemic')
        .reduce((sum, option) => sum + option.totalMmt, 0);

      const lifestyleApplied = Math.min(lifestyleSaved, grossTotalMmt);
      const systemicApplied = Math.min(systemicSaved, grossTotalMmt);
      const combinedApplied = Math.min(lifestyleSaved + systemicSaved, grossTotalMmt);

      cutTotals.lifestyle.textContent = lifestyleSaved > 0 ? `Selected: ${formatCompactCut(lifestyleSaved)}` : 'Selected: none';
      cutTotals.systemic.textContent = systemicSaved > 0 ? `Selected: ${formatCompactCut(systemicSaved)}` : 'Selected: none';

      updateCutRow('current', grossTotalMmt, 0);
      cutRows.current.savedText.textContent = 'Reference line';
      updateCutRow('lifestyle', grossTotalMmt - lifestyleApplied, lifestyleApplied);
      updateCutRow('systemic', grossTotalMmt - systemicApplied, systemicApplied);
      updateCutRow('combined', grossTotalMmt - combinedApplied, combinedApplied);

      if (combinedApplied === 0) {
        cutSummary.textContent = 'No cuts selected yet. Check items in either column to compare household-scale change with system-scale change.';
        return;
      }

      cutSummary.textContent = `Selected lifestyle changes cut ${formatCompactCut(lifestyleSaved)}. Selected systemic changes cut ${formatCompactCut(systemicSaved)}. Together they remove ${formatCompactCut(combinedApplied)}, leaving ${formatCompactCut(grossTotalMmt - combinedApplied)} of the national footprint.`;
    }

    function setMode(mode) {
      const copy = modeCopy[mode];
      if (!copy) return;
      currentMode = mode;

      totalLabel.textContent = copy.totalLabel;
      totalValue.textContent = copy.totalValue;
      totalUnit.textContent = copy.totalUnit;
      subline.textContent = copy.subline;
      context.textContent = copy.context;

      swapEls.forEach((el) => {
        el.textContent = mode === 'total' ? el.dataset.total : el.dataset.percapita;
      });

      buttons.forEach((button) => {
        const active = button.dataset.mode === mode;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      renderCuts();
    }

    root.querySelector('.ncfp-toggle')?.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest('.ncfp-toggle-btn');
      if (!button) return;
      setMode(button.dataset.mode);
    });

    root.querySelectorAll('.ncfp-cut-item input[type="checkbox"]').forEach((checkbox) => {
      checkbox.addEventListener('change', renderCuts);
    });

    document.getElementById('ncfp-select-all')?.addEventListener('click', () => {
      root.querySelectorAll('.ncfp-cut-item input[type="checkbox"]').forEach((checkbox) => {
        checkbox.checked = true;
      });
      renderCuts();
    });

    document.getElementById('ncfp-clear-all')?.addEventListener('click', () => {
      root.querySelectorAll('.ncfp-cut-item input[type="checkbox"]').forEach((checkbox) => {
        checkbox.checked = false;
      });
      renderCuts();
    });

    setMode('total');
  }
</script>
