---
import Base from '@/layouts/Base.astro';
import { NationalCarbonExplorer } from '@/components/national/NationalCarbonExplorer';
---

<Base
  title="The national carbon footprint"
  description="An interactive view of the United States' annual carbon footprint, with lifestyle and systemic change paths shown on the same ruler."
  ogImage="/images/og/og-carbon-footprint.png"
>
  <article class="ncfx" id="ncfx">
    <NationalCarbonExplorer client:load />
  </article>
</Base>

<style is:global>
  body:has(.ncfx) {
    background: #f5f2ec !important;
  }

  [data-theme="dark"] body:has(.ncfx) {
    background: #1a1917 !important;
  }

  body:has(.ncfx) .main-content {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  body:has(.ncfx) .main-content > .header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .ncfx {
    --ncfx-bg: #f5f2ec;
    --ncfx-panel: #efe9df;
    --ncfx-panel-strong: #ebe3d6;
    --ncfx-card: rgba(255, 255, 255, 0.35);
    --ncfx-card-strong: rgba(255, 255, 255, 0.5);
    --ncfx-text: #1a1a18;
    --ncfx-text-2: #6b6b60;
    --ncfx-accent: #8b2e2e;
    --ncfx-divider: #d8d1c6;
    --ncfx-bar-track: #d9d1c6;
    --ncfx-remaining: #b4a997;
    --ncfx-current: #8b2e2e;
    --ncfx-lifestyle: #4a7c59;
    --ncfx-systemic: #a0522d;
    --ncfx-transport: #8b2e2e;
    --ncfx-industry: #6b7c3a;
    --ncfx-buildings: #7a5c3a;
    --ncfx-other: #979183;
    width: min(1600px, calc(100vw - 48px));
    margin: 0 auto;
    padding: 2.5rem 0 5rem;
    color: var(--ncfx-text);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }

  [data-theme="dark"] .ncfx {
    --ncfx-bg: #1a1917;
    --ncfx-panel: #23201d;
    --ncfx-panel-strong: #2a2622;
    --ncfx-card: rgba(255, 255, 255, 0.03);
    --ncfx-card-strong: rgba(255, 255, 255, 0.06);
    --ncfx-text: #f0ede6;
    --ncfx-text-2: #a39b8d;
    --ncfx-accent: #ba6059;
    --ncfx-divider: #3a362f;
    --ncfx-bar-track: #37322d;
    --ncfx-remaining: #71675c;
    --ncfx-current: #c47058;
    --ncfx-lifestyle: #5d9b71;
    --ncfx-systemic: #c48a5a;
    --ncfx-transport: #c47058;
    --ncfx-industry: #96a85e;
    --ncfx-buildings: #b18a62;
    --ncfx-other: #8a847a;
  }

  .ncfx,
  .ncfx * {
    box-sizing: border-box;
  }

  .ncfx a {
    color: var(--ncfx-accent);
    text-underline-offset: 2px;
  }

  .ncfx *:focus-visible {
    outline: 2px solid var(--ncfx-accent);
    outline-offset: 3px;
  }

  .ncfx-hero,
  .ncfx-workspace,
  .ncfx-secondary,
  .ncfx-editorial,
  .ncfx-methodology {
    animation: ncfx-fade-up 0.45s ease both;
  }

  .ncfx-workspace {
    animation-delay: 70ms;
  }

  .ncfx-secondary {
    animation-delay: 140ms;
  }

  .ncfx-editorial {
    animation-delay: 180ms;
  }

  .ncfx-methodology {
    animation-delay: 220ms;
  }

  @keyframes ncfx-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ncfx-sticky-desktop {
    display: none;
    position: sticky;
    top: 0;
    z-index: 40;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--ncfx-divider);
    background: color-mix(in srgb, var(--ncfx-bg) 84%, transparent);
    backdrop-filter: blur(14px);
  }

  .ncfx-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
  }

  .ncfx-sticky-mobile {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--ncfx-divider);
    background: color-mix(in srgb, var(--ncfx-bg) 94%, transparent);
    backdrop-filter: blur(16px);
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ncfx-sticky-total {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .ncfx-sticky-detail {
    font-size: 0.76rem;
    color: var(--ncfx-text-2);
    text-align: right;
  }

  .ncfx-construction {
    display: inline-block;
    margin-bottom: 1.15rem;
    padding: 0.48rem 0.75rem 0.42rem;
    border: 1px solid var(--ncfx-accent);
    background: color-mix(in srgb, var(--ncfx-accent) 6%, transparent);
    color: var(--ncfx-accent);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ncfx-hero {
    margin-bottom: 2.75rem;
  }

  .ncfx-kicker,
  .ncfx-section-label,
  .ncfx-mini-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ncfx-text-2);
  }

  .ncfx-kicker {
    margin-bottom: 0.7rem;
  }

  .ncfx-title {
    margin: 0 0 1rem;
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 7vw, 5.8rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .ncfx-intro {
    max-width: 48rem;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1.02rem;
    line-height: 1.82;
    color: var(--ncfx-text-2);
  }

  .ncfx-workspace,
  .ncfx-secondary,
  .ncfx-editorial,
  .ncfx-methodology {
    margin-bottom: 3rem;
  }

  .ncfx-section-title {
    margin: 0.45rem 0 0.8rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .ncfx-section-desc {
    max-width: 48rem;
    margin: 0 0 1.35rem;
    font-size: 0.95rem;
    line-height: 1.78;
    color: var(--ncfx-text-2);
  }

  .ncfx-impact-layout {
    border: 1px solid var(--ncfx-divider);
    background: color-mix(in srgb, var(--ncfx-panel) 84%, transparent);
    overflow: hidden;
  }

  .ncfx-panels {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    min-height: 46rem;
  }

  .ncfx-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.25rem;
    border-right: 1px solid var(--ncfx-divider);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ncfx-panel-strong) 76%, transparent), transparent 22rem),
      color-mix(in srgb, var(--ncfx-panel) 88%, transparent);
  }

  .ncfx-col:last-child {
    border-right: none;
  }

  .ncfx-col--summary {
    border-top: 2px solid var(--ncfx-accent);
  }

  .ncfx-col--lifestyle {
    border-top: 2px solid var(--ncfx-lifestyle);
  }

  .ncfx-col--systemic {
    border-top: 2px solid var(--ncfx-systemic);
  }

  .ncfx-col-head {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .ncfx-col-sub {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--ncfx-text-2);
  }

  .ncfx-summary-total {
    margin-bottom: 1.1rem;
  }

  .ncfx-summary-label {
    margin-bottom: 0.25rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ncfx-text-2);
  }

  .ncfx-summary-number {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: baseline;
    margin-bottom: 0.45rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .ncfx-summary-unit {
    font-family: var(--font-body);
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: normal;
    color: var(--ncfx-text-2);
  }

  .ncfx-summary-subline {
    margin-bottom: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .ncfx-summary-context {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.72;
    color: var(--ncfx-text-2);
  }

  .ncfx-toggle {
    display: inline-flex;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--ncfx-divider);
  }

  .ncfx-toggle-btn {
    margin-right: 1rem;
    padding: 0.55rem 0 0.42rem;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--ncfx-text-2);
    cursor: pointer;
    font: inherit;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .ncfx-toggle-btn:last-child {
    margin-right: 0;
  }

  .ncfx-toggle-btn.active {
    color: var(--ncfx-accent);
    border-bottom-color: var(--ncfx-accent);
  }

  .ncfx-toggle-btn:not(.active):hover {
    color: var(--ncfx-text);
  }

  .ncfx-howto,
  .ncfx-presets {
    margin-bottom: 1rem;
  }

  .ncfx-howto-list {
    margin: 0.55rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.72;
    color: var(--ncfx-text-2);
  }

  .ncfx-howto-list li + li {
    margin-top: 0.28rem;
  }

  .ncfx-preset-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .ncfx-preset-pill,
  .ncfx-panel-btn {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--ncfx-divider);
    background: transparent;
    color: var(--ncfx-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .ncfx-preset-pill:hover,
  .ncfx-panel-btn:hover {
    border-color: var(--ncfx-accent);
    color: var(--ncfx-accent);
  }

  .ncfx-preset-pill.active {
    border-color: var(--ncfx-accent);
    background: color-mix(in srgb, var(--ncfx-accent) 8%, transparent);
    color: var(--ncfx-accent);
  }

  .ncfx-preset-copy {
    margin-top: 0.55rem;
    min-height: 1.2rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--ncfx-text-2);
  }

  .ncfx-stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .ncfx-stat-card {
    min-width: 0;
    padding: 0.8rem 0.85rem;
    border: 1px solid var(--ncfx-divider);
    background: var(--ncfx-card);
  }

  .ncfx-stat-label {
    margin-bottom: 0.32rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ncfx-text-2);
  }

  .ncfx-stat-value {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .ncfx-stat-subline {
    margin-top: 0.18rem;
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--ncfx-text-2);
  }

  .ncfx-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .ncfx-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.58rem;
    border: 1px solid var(--ncfx-divider);
    background: var(--ncfx-card);
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--ncfx-text-2);
  }

  .ncfx-chip strong {
    color: var(--ncfx-text);
  }

  .ncfx-panel-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.85rem;
  }

  .ncfx-panel-total {
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--ncfx-text-2);
  }

  .ncfx-panel-buttons {
    display: inline-flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ncfx-col-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ncfx-cut-list {
    display: grid;
    gap: 0.65rem;
  }

  .ncfx-cut-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    padding: 0.8rem 0.85rem;
    border: 1px solid var(--ncfx-divider);
    background: var(--ncfx-card);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .ncfx-cut-item:hover {
    transform: translateY(-1px);
  }

  .ncfx-cut-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ncfx-cut-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.08rem;
    border: 1px solid var(--ncfx-divider);
    background: transparent;
  }

  .ncfx-cut-check svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    opacity: 0;
  }

  .ncfx-cut-item.checked .ncfx-cut-check svg {
    opacity: 1;
  }

  .ncfx-cut-body {
    min-width: 0;
  }

  .ncfx-cut-top {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.3rem;
  }

  .ncfx-cut-name {
    min-width: 0;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .ncfx-cut-value {
    flex: 0 0 auto;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ncfx-text-2);
    text-align: right;
  }

  .ncfx-cut-detail {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--ncfx-text-2);
  }

  .ncfx-cut-meta {
    display: grid;
    gap: 0.35rem;
  }

  .ncfx-cut-meta-label {
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ncfx-text-2);
  }

  .ncfx-cut-meter {
    display: block;
    height: 0.38rem;
    background: var(--ncfx-bar-track);
    overflow: hidden;
  }

  .ncfx-cut-meter-fill {
    display: block;
    height: 100%;
    background: var(--ncfx-accent);
  }

  .ncfx-cut-item[data-cut-cat="lifestyle"] .ncfx-cut-meter-fill {
    background: var(--ncfx-lifestyle);
  }

  .ncfx-cut-item[data-cut-cat="systemic"] .ncfx-cut-meter-fill {
    background: var(--ncfx-systemic);
  }

  .ncfx-cut-item.checked[data-cut-cat="lifestyle"] {
    border-color: var(--ncfx-lifestyle);
    background: color-mix(in srgb, var(--ncfx-lifestyle) 9%, var(--ncfx-card-strong));
  }

  .ncfx-cut-item.checked[data-cut-cat="systemic"] {
    border-color: var(--ncfx-systemic);
    background: color-mix(in srgb, var(--ncfx-systemic) 9%, var(--ncfx-card-strong));
  }

  .ncfx-cut-item.checked[data-cut-cat="lifestyle"] .ncfx-cut-check {
    border-color: var(--ncfx-lifestyle);
    color: var(--ncfx-lifestyle);
    background: color-mix(in srgb, var(--ncfx-lifestyle) 10%, transparent);
  }

  .ncfx-cut-item.checked[data-cut-cat="systemic"] .ncfx-cut-check {
    border-color: var(--ncfx-systemic);
    color: var(--ncfx-systemic);
    background: color-mix(in srgb, var(--ncfx-systemic) 10%, transparent);
  }

  .ncfx-results {
    padding: 1.25rem 1.25rem 1.5rem;
    border-top: 1px solid var(--ncfx-divider);
    background: color-mix(in srgb, var(--ncfx-panel-strong) 88%, transparent);
  }

  .ncfx-results-head {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .ncfx-results-summary {
    max-width: 58rem;
    font-size: 0.9rem;
    line-height: 1.72;
    color: var(--ncfx-text-2);
  }

  .ncfx-scale-labels {
    position: relative;
    height: 18px;
    margin-bottom: 0.65rem;
  }

  .ncfx-scale-labels span {
    position: absolute;
    transform: translateX(-50%);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ncfx-text-2);
  }

  .ncfx-scale-labels span:first-child {
    transform: none;
  }

  .ncfx-result-row {
    margin-bottom: 1rem;
  }

  .ncfx-result-row:last-child {
    margin-bottom: 0;
  }

  .ncfx-result-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-end;
    margin-bottom: 0.42rem;
  }

  .ncfx-result-copy,
  .ncfx-result-metrics {
    min-width: 0;
  }

  .ncfx-result-copy {
    display: grid;
    gap: 0.12rem;
  }

  .ncfx-result-name {
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .ncfx-result-detail {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--ncfx-text-2);
  }

  .ncfx-result-metrics {
    display: grid;
    gap: 0.12rem;
    text-align: right;
  }

  .ncfx-result-value {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .ncfx-result-saved {
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--ncfx-text-2);
  }

  .ncfx-result-track {
    display: flex;
    height: 1rem;
    background: var(--ncfx-bar-track);
    overflow: hidden;
  }

  .ncfx-result-remaining,
  .ncfx-result-saved-fill,
  .ncfx-breakdown-fill {
    height: 100%;
  }

  .ncfx-result-remaining {
    background: var(--ncfx-remaining);
  }

  .ncfx-result-remaining--current {
    background: var(--ncfx-current);
  }

  .ncfx-result-saved-fill--lifestyle {
    background: var(--ncfx-lifestyle);
  }

  .ncfx-result-saved-fill--systemic {
    background: var(--ncfx-systemic);
  }

  .ncfx-result-saved-fill--combined {
    background: linear-gradient(90deg, var(--ncfx-lifestyle), var(--ncfx-systemic));
  }

  .ncfx-results-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--ncfx-text-2);
  }

  .ncfx-breakdown-card {
    padding: 1.25rem;
    border: 1px solid var(--ncfx-divider);
    background: color-mix(in srgb, var(--ncfx-panel) 88%, transparent);
  }

  .ncfx-breakdown-fill {
    min-width: 0;
  }

  .ncfx-badge {
    display: inline-flex;
    margin-left: 0.45rem;
    padding: 0.08rem 0.35rem;
    border: 1px solid var(--ncfx-divider);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ncfx-text-2);
    vertical-align: middle;
  }

  .ncfx-editorial {
    max-width: 54rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ncfx-divider);
  }

  .ncfx-editorial p,
  .ncfx-methodology p {
    margin: 0.55rem 0 0;
    font-size: 0.92rem;
    line-height: 1.82;
