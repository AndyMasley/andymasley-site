---
import Base from '@/layouts/Base.astro';

const grossTotalMmt = 6343.2;
const netTotalMmt = 5489.0;
const population2022 = 333_287_557;

const dailyGrossMmt = grossTotalMmt / 365;
const perCapitaTotalTonnes = grossTotalMmt * 1e6 / population2022;
const dailyPerCapitaKg = grossTotalMmt * 1e9 / population2022 / 365;
const netSinkOffsetMmt = grossTotalMmt - netTotalMmt;

const baseSectors = [
  {
    key: 'transport',
    label: 'Moving people and freight',
    detail: 'Cars, trucks, buses, aviation, rail, and off-road equipment',
    totalMmt: 1801.5,
    color: 'var(--transport)',
    inferred: false,
  },
  {
    key: 'power',
    label: 'Generating electricity',
    detail: 'Power plants, grid combustion, and the electricity system',
    totalMmt: 1577.5,
    color: 'var(--power)',
    inferred: false,
  },
  {
    key: 'industry',
    label: 'Making materials and goods',
    detail: 'Steel, cement, chemicals, refining, industrial heat, and process emissions',
    totalMmt: 1452.5,
    color: 'var(--industry)',
    inferred: false,
  },
  {
    key: 'buildings',
    label: 'Running homes and businesses',
    detail: 'Heating, cooling, cooking, appliances, buildings, and refrigerants',
    totalMmt: +(grossTotalMmt * 0.13).toFixed(1),
    color: 'var(--buildings)',
    inferred: true,
  },
  {
    key: 'agriculture',
    label: 'Growing food and managing farms',
    detail: 'Livestock methane, agricultural soils, manure, and farm energy use',
    totalMmt: +(grossTotalMmt * 0.094).toFixed(1),
    color: 'var(--agriculture)',
    inferred: true,
  },
];

const otherTotalMmt = +(grossTotalMmt - baseSectors.reduce((sum, sector) => sum + sector.totalMmt, 0)).toFixed(1);

const sectors = [
  ...baseSectors,
  {
    key: 'other',
    label: 'Waste, refrigerants, and smaller sources',
    detail: 'Residual direct sources so the rows sum cleanly to the national total',
    totalMmt: otherTotalMmt,
    color: 'var(--other)',
    inferred: true,
  },
].map((sector) => ({
  ...sector,
  sharePct: +(sector.totalMmt / grossTotalMmt * 100).toFixed(1),
  perCapitaTonnes: +(sector.totalMmt * 1e6 / population2022).toFixed(2),
  totalLabel: `${sector.totalMmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT CO2e / yr`,
  perCapitaLabel: `${(sector.totalMmt * 1e6 / population2022).toFixed(2)} t CO2e / person / yr`,
}));

const biggestSector = sectors.reduce((largest, sector) => sector.totalMmt > largest.totalMmt ? sector : largest, sectors[0]);
const powerAndBuildingsMmt = sectors
  .filter((sector) => sector.key === 'power' || sector.key === 'buildings')
  .reduce((sum, sector) => sum + sector.totalMmt, 0);

const totalBarLabel = `${grossTotalMmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT CO2e / yr`;
const totalPerCapitaLabel = `${perCapitaTotalTonnes.toFixed(1)} t CO2e / person / yr`;

const modeCopy = {
  total: {
    totalLabel: "America's annual footprint",
    totalValue: (grossTotalMmt / 1000).toFixed(2),
    totalUnit: 'billion metric tons CO2e / yr',
    subline: `About ${dailyGrossMmt.toFixed(1)} million metric tons every day.`,
    context: `Gross emissions before subtracting land sinks. EPA reports ${netTotalMmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT net in 2022, so forests and soils offset about ${netSinkOffsetMmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT.`,
  },
  perCapita: {
    totalLabel: 'Per person, per year',
    totalValue: perCapitaTotalTonnes.toFixed(1),
    totalUnit: 'metric tons CO2e / person / yr',
    subline: `About ${dailyPerCapitaKg.toFixed(1)} kg per person per day.`,
    context: `Per-capita mode divides the same 2022 national total by the U.S. Census resident population estimate of ${population2022.toLocaleString()}.`,
  },
};

const cutGroupMeta = {
  lifestyle: {
    label: 'Lifestyle changes',
    intro: 'Millions of household decisions about diets, driving, flying, homes, and purchases.',
    color: 'var(--agriculture)',
  },
  systemic: {
    label: 'Systemic changes',
    intro: 'Grid, industry, transit, methane, and standards that move whole sectors at once.',
    color: 'var(--power)',
  },
} as const;

const cutOptionSeed = [
  {
    key: 'diet-shift',
    cat: 'lifestyle',
    label: 'Eat much less beef and dairy',
    detail: 'A broad dietary shift across households, food service, schools, and grocery demand',
    totalMmt: 260,
  },
  {
    key: 'drive-less',
    cat: 'lifestyle',
    label: 'Drive less and buy smaller cars',
    detail: 'Shorter trips, mode shifts, lighter vehicles, and less fuel burned overall',
    totalMmt: 280,
  },
  {
    key: 'home-electrify',
    cat: 'lifestyle',
    label: 'Electrify homes with heat pumps',
    detail: 'Replace millions of furnaces, boilers, and water heaters with electric equipment',
    totalMmt: 220,
  },
  {
    key: 'fly-less',
    cat: 'lifestyle',
    label: 'Fly less',
    detail: 'Fewer leisure and business flights, especially on short-haul routes',
    totalMmt: 120,
  },
  {
    key: 'food-waste',
    cat: 'lifestyle',
    label: 'Waste less food',
    detail: 'Less spoilage at home, in restaurants, and across the retail chain',
    totalMmt: 100,
  },
  {
    key: 'buy-less',
    cat: 'lifestyle',
    label: 'Buy fewer new goods',
    detail: 'Longer product lifetimes, less turnover, and lower material throughput',
    totalMmt: 180,
  },
  {
    key: 'clean-grid',
    cat: 'systemic',
    label: 'Clean up the grid',
    detail: 'Retire fossil generation and expand clean electricity at national scale',
    totalMmt: 900,
  },
  {
    key: 'industrial-decarb',
    cat: 'systemic',
    label: 'Decarbonize heavy industry',
    detail: 'Cleaner steel, cement, chemicals, industrial heat, and process emissions',
    totalMmt: 450,
  },
  {
    key: 'methane-rules',
    cat: 'systemic',
    label: 'Slash methane and other super-pollutants',
    detail: 'Tighter leak rules, better waste management, and stronger agricultural controls',
    totalMmt: 230,
  },
  {
    key: 'transit-housing',
    cat: 'systemic',
    label: 'Build transit and housing around it',
    detail: 'Land use and transport systems that reduce car dependence for years',
    totalMmt: 180,
  },
  {
    key: 'efficiency-standards',
    cat: 'systemic',
    label: 'Tighten building and appliance standards',
    detail: 'Codes and standards that lock in lower energy use across the stock',
    totalMmt: 160,
  },
  {
    key: 'transmission-storage',
    cat: 'systemic',
    label: 'Build more transmission and storage',
    detail: 'Infrastructure that lets cleaner power displace dirtier generation faster',
    totalMmt: 240,
  },
];

const cutMaxByCat = cutOptionSeed.reduce((acc, option) => {
  acc[option.cat] = Math.max(acc[option.cat] ?? 0, option.totalMmt);
  return acc;
}, {} as Record<string, number>);

const cutOptions = cutOptionSeed.map((option) => ({
  ...option,
  totalLabel: `${option.totalMmt.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 })} MMT CO2e / yr`,
  perCapitaLabel: `${(option.totalMmt * 1e6 / population2022).toFixed(2)} t CO2e / person / yr`,
  meterPct: +(option.totalMmt / cutMaxByCat[option.cat] * 100).toFixed(1),
}));

const cutGroups = (Object.entries(cutGroupMeta) as Array<[keyof typeof cutGroupMeta, (typeof cutGroupMeta)[keyof typeof cutGroupMeta]]>)
  .map(([key, meta]) => ({
    key,
    ...meta,
    options: cutOptions.filter((option) => option.cat === key),
  }));
---

<Base
  title="The national carbon footprint"
  description="A horizontal-bar view of the United States' annual carbon footprint, with total-U.S. and per-person modes."
  ogImage="/images/og/og-carbon-footprint.png"
>
  <article class="ncfp" id="ncfp">
    <header class="ncfp-hero">
      <div class="ncfp-kicker">United States, 2022</div>
      <h1 class="ncfp-title">The national carbon footprint</h1>
      <p class="ncfp-intro">
        A country-scale cousin of the personal carbon footprint visual: the same horizontal graph language, but focused on what the whole United States does in a year. Toggle between the country total and the per-person version of that same footprint.
      </p>

      <div class="ncfp-toggle" role="group" aria-label="Footprint scale">
        <button type="button" class="ncfp-toggle-btn active" data-mode="total" aria-pressed="true">Total U.S.</button>
        <button type="button" class="ncfp-toggle-btn" data-mode="perCapita" aria-pressed="false">Per person</button>
      </div>

      <details class="ncfp-methodology">
        <summary>Sources and methodology</summary>
        <p>
          This page uses EPA's <a href="https://www.epa.gov/ghgemissions/inventory-us-greenhouse-gas-emissions-and-sinks">Inventory of U.S. Greenhouse Gas Emissions and Sinks</a> and its
          <a href="https://www.epa.gov/system/files/documents/2024-04/data-highlights-1990-2022.pdf">2022 data highlights</a>, plus the U.S. Census
          <a href="https://www.census.gov/quickfacts/fact/table/US/PST045224">resident population estimate</a> for July 1, 2022. Units are CO2e because a footprint combines CO2, methane, nitrous oxide,
          and fluorinated gases into one number. Transportation, electric power, industry, gross total, and net total come directly from EPA inventory totals. Buildings and agriculture are inferred from EPA's published sector shares, and the small remainder is grouped as &quot;Other&quot; so the rows sum to the national total.
        </p>
      </details>
    </header>

    <section class="ncfp-dashboard" aria-live="polite">
      <div class="ncfp-total-label" id="ncfp-total-label">{modeCopy.total.totalLabel}</div>
      <div class="ncfp-total">
        <span class="ncfp-total-num" id="ncfp-total-value">{modeCopy.total.totalValue}</span>
        <span class="ncfp-total-unit" id="ncfp-total-unit">{modeCopy.total.totalUnit}</span>
      </div>
      <div class="ncfp-subline" id="ncfp-subline">{modeCopy.total.subline}</div>
      <div class="ncfp-context" id="ncfp-context">{modeCopy.total.context}</div>

      <div class="ncfp-chip-row">
        <span class="ncfp-chip"><strong>{biggestSector.sharePct}%</strong> comes from transport</span>
        <span class="ncfp-chip"><strong>{(powerAndBuildingsMmt / 1000).toFixed(2)}B tons</strong> come from electricity plus buildings</span>
        <span class="ncfp-chip"><strong>{netSinkOffsetMmt.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} MMT</strong> are absorbed by land sinks</span>
      </div>
    </section>

    <section class="ncfp-chart-wrap">
      <div class="ncfp-chart">
        <div class="ncfp-scale-labels">
          <span style="left: 0">0</span>
          <span style="left: 25%">25%</span>
          <span style="left: 50%">50%</span>
          <span style="left: 75%">75%</span>
          <span style="left: 100%">100%</span>
        </div>

        <div class="ncfp-bar-row ncfp-bar-row--total">
          <div class="ncfp-bar-header">
            <div class="ncfp-bar-copy">
              <span class="ncfp-bar-name">Total U.S. footprint</span>
              <span class="ncfp-bar-detail">Gross emissions before land sinks are subtracted</span>
            </div>
            <div class="ncfp-bar-metrics">
              <span class="ncfp-bar-value" data-total={totalBarLabel} data-percapita={totalPerCapitaLabel}>{totalBarLabel}</span>
              <span class="ncfp-bar-share">100% of national total</span>
            </div>
          </div>
          <div class="ncfp-bar-track">
            <div class="ncfp-bar-fill ncfp-bar-fill--total" style="width: 100%"></div>
          </div>
        </div>

        {sectors.map((sector) => (
          <div class="ncfp-bar-row">
            <div class="ncfp-bar-header">
              <div class="ncfp-bar-copy">
                <span class="ncfp-bar-name">
                  {sector.label}
                  {sector.inferred && <span class="ncfp-bar-badge">share-based</span>}
                </span>
                <span class="ncfp-bar-detail">{sector.detail}</span>
              </div>
              <div class="ncfp-bar-metrics">
                <span class="ncfp-bar-value" data-total={sector.totalLabel} data-percapita={sector.perCapitaLabel}>{sector.totalLabel}</span>
                <span class="ncfp-bar-share">{sector.sharePct.toFixed(1)}% of national total</span>
              </div>
            </div>
            <div class="ncfp-bar-track">
              <div class="ncfp-bar-fill" style={`width: ${sector.sharePct}%; background: ${sector.color};`}></div>
            </div>
          </div>
        ))}

        <div class="ncfp-chart-note">
          Bar lengths show each category's share of the national total, so the geometry stays fixed when you switch to per-person mode.
        </div>
      </div>
    </section>

    <section class="ncfp-cut-explorer" aria-labelledby="ncfp-cut-title">
      <div class="ncfp-cut-kicker">Cut explorer</div>
      <h2 class="ncfp-cut-title" id="ncfp-cut-title">Two ways to cut it</h2>
      <p class="ncfp-cut-intro">
        This works like the older checkbox-heavy carbon page, but compressed into two buckets: lifestyle changes and systemic changes. Check any options you want to count, then compare what happens if you do only the lifestyle cuts, only the systemic cuts, or both together.
      </p>

      <div class="ncfp-cut-bars">
        <div class="ncfp-scale-labels">
          <span style="left: 0">0</span>
          <span style="left: 25%">25%</span>
          <span style="left: 50%">50%</span>
          <span style="left: 75%">75%</span>
          <span style="left: 100%">100%</span>
        </div>

        <div class="ncfp-cut-row">
          <div class="ncfp-bar-header">
            <div class="ncfp-bar-copy">
              <span class="ncfp-bar-name">Current U.S. footprint</span>
              <span class="ncfp-bar-detail">Reference line before any selected cuts</span>
            </div>
            <div class="ncfp-bar-metrics">
              <span class="ncfp-bar-value" id="ncfp-row-current-remaining"></span>
              <span class="ncfp-bar-share" id="ncfp-row-current-saved">No cuts yet</span>
            </div>
          </div>
          <div class="ncfp-cut-track">
            <div class="ncfp-cut-track-remaining ncfp-cut-track-remaining--current" id="ncfp-bar-current-remaining"></div>
            <div class="ncfp-cut-track-saved ncfp-cut-track-saved--current" id="ncfp-bar-current-saved"></div>
          </div>
        </div>

        <div class="ncfp-cut-row">
          <div class="ncfp-bar-header">
            <div class="ncfp-bar-copy">
              <span class="ncfp-bar-name">After lifestyle changes</span>
              <span class="ncfp-bar-detail">Only the household-scale cuts checked below</span>
            </div>
            <div class="ncfp-bar-metrics">
              <span class="ncfp-bar-value" id="ncfp-row-lifestyle-remaining"></span>
              <span class="ncfp-bar-share" id="ncfp-row-lifestyle-saved"></span>
            </div>
          </div>
          <div class="ncfp-cut-track">
            <div class="ncfp-cut-track-remaining" id="ncfp-bar-lifestyle-remaining"></div>
            <div class="ncfp-cut-track-saved ncfp-cut-track-saved--lifestyle" id="ncfp-bar-lifestyle-saved"></div>
          </div>
        </div>

        <div class="ncfp-cut-row">
          <div class="ncfp-bar-header">
            <div class="ncfp-bar-copy">
              <span class="ncfp-bar-name">After systemic changes</span>
              <span class="ncfp-bar-detail">Only the system-scale changes checked below</span>
            </div>
            <div class="ncfp-bar-metrics">
              <span class="ncfp-bar-value" id="ncfp-row-systemic-remaining"></span>
              <span class="ncfp-bar-share" id="ncfp-row-systemic-saved"></span>
            </div>
          </div>
          <div class="ncfp-cut-track">
            <div class="ncfp-cut-track-remaining" id="ncfp-bar-systemic-remaining"></div>
            <div class="ncfp-cut-track-saved ncfp-cut-track-saved--systemic" id="ncfp-bar-systemic-saved"></div>
          </div>
        </div>

        <div class="ncfp-cut-row">
          <div class="ncfp-bar-header">
            <div class="ncfp-bar-copy">
              <span class="ncfp-bar-name">After both together</span>
              <span class="ncfp-bar-detail">Lifestyle plus systemic selections, capped at the national total</span>
            </div>
            <div class="ncfp-bar-metrics">
              <span class="ncfp-bar-value" id="ncfp-row-combined-remaining"></span>
              <span class="ncfp-bar-share" id="ncfp-row-combined-saved"></span>
            </div>
          </div>
          <div class="ncfp-cut-track">
            <div class="ncfp-cut-track-remaining" id="ncfp-bar-combined-remaining"></div>
            <div class="ncfp-cut-track-saved ncfp-cut-track-saved--combined" id="ncfp-bar-combined-saved"></div>
          </div>
        </div>
      </div>

      <div class="ncfp-cut-summary" id="ncfp-cut-summary" aria-live="polite"></div>

      <div class="ncfp-cut-toolbar">
        <button type="button" class="ncfp-cut-toolbar-btn" id="ncfp-select-all">All</button>
        <button type="button" class="ncfp-cut-toolbar-btn" id="ncfp-clear-all">None</button>
      </div>

      <div class="ncfp-cut-grid" id="ncfp-cut-grid">
        {cutGroups.map((group) => (
          <section class="ncfp-cut-group" data-cut-cat={group.key}>
            <div class="ncfp-cut-group-header">
              <div>
                <div class="ncfp-cut-group-label">{group.label}</div>
                <p class="ncfp-cut-group-intro">{group.intro}</p>
              </div>
              <div class="ncfp-cut-group-total" id={`ncfp-cut-total-${group.key}`}></div>
            </div>

            <div class="ncfp-cut-list">
              {group.options.map((option) => (
                <label class="ncfp-cut-item" data-cut-key={option.key} data-cut-cat={option.cat}>
                  <input type="checkbox" />
                  <span class="ncfp-cut-check">
                    <svg viewBox="0 0 10 10">
                      <polyline points="1.5,5.5 4,8 8.5,2"></polyline>
                    </svg>
                  </span>
                  <span class="ncfp-cut-body">
                    <span class="ncfp-cut-top">
                      <span class="ncfp-cut-name">{option.label}</span>
                      <span class="ncfp-cut-value" data-total={option.totalLabel} data-percapita={option.perCapitaLabel}>{option.totalLabel}</span>
                    </span>
                    <span class="ncfp-cut-detail">{option.detail}</span>
                    <span class="ncfp-cut-meter">
                      <span class="ncfp-cut-meter-fill" style={`width: ${option.meterPct}%`}></span>
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="ncfp-cut-note">
        These are rough, overlapping scenario cuts anchored to the 2022 national total. They are meant to compare scale, not to function as an exact additive decarbonization plan.
      </p>
    </section>

    <div class="ncfp-story">
      <div class="ncfp-story-label">How to read it</div>
      <p>
        Total mode makes the scale visible. Per-person mode keeps the same proportions, but asks how much of that country-sized footprint the average American effectively carries.
      </p>
    </div>
  </article>
</Base>

<style is:global>
  body:has(.ncfp) {
    background: #f5f2ec !important;
  }

  [data-theme="dark"] body:has(.ncfp) {
    background: #1a1917 !important;
  }

  body:has(.ncfp) .main-content {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  body:has(.ncfp) .main-content > .header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .ncfp {
    --bg: #f5f2ec;
    --panel: #efece5;
    --text: #1a1a18;
    --text2: #6b6b60;
    --accent: #8b2e2e;
    --div: #ddd9d0;
    --transport: #8b2e2e;
    --power: #a0522d;
    --industry: #6b7c3a;
    --buildings: #7a5c3a;
    --agriculture: #4a7c59;
    --other: #9a9a8a;
    color: var(--text);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    margin: 0;
    padding: 3rem 4vw 5rem;
    box-sizing: border-box;
  }

  [data-theme="dark"] .ncfp {
    --bg: #1c1a17;
    --panel: #252320;
    --text: #f0ede6;
    --text2: #9a9485;
    --accent: #b85555;
    --div: #3a3733;
    --transport: #c47058;
    --power: #c4935a;
    --industry: #90a35d;
    --buildings: #a98558;
    --agriculture: #5a9b6e;
    --other: #7e786f;
  }

  .ncfp-hero,
  .ncfp-dashboard,
  .ncfp-chart-wrap,
  .ncfp-cut-explorer,
  .ncfp-story {
    animation: ncfp-fade-up 0.45s ease both;
  }

  .ncfp-dashboard {
    animation-delay: 60ms;
  }

  .ncfp-chart-wrap {
    animation-delay: 120ms;
  }

  .ncfp-story {
    animation-delay: 180ms;
  }

  .ncfp-cut-explorer {
    animation-delay: 160ms;
  }

  @keyframes ncfp-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ncfp-kicker {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text2);
    margin-bottom: 0.65rem;
  }

  .ncfp-title {
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
  }

  .ncfp-intro {
    max-width: 46rem;
    margin: 0 0 1.4rem;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.82;
    color: var(--text2);
  }

  .ncfp-toggle {
    display: inline-flex;
    border-bottom: 1px solid var(--div);
  }

  .ncfp-toggle-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 18px;
    padding: 8px 0 6px;
    color: var(--text2);
    cursor: pointer;
    font: inherit;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .ncfp-toggle-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .ncfp-toggle-btn:not(.active):hover {
    color: var(--text);
  }

  .ncfp-methodology {
    max-width: 46rem;
    margin-top: 1rem;
  }

  .ncfp-methodology summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.74rem;
    font-weight: 700;
