---
import Base from '@/layouts/Base.astro';
---

<Base
  title="PM2.5 exposure by county"
  description="Every U.S. county as a bar — width = population, height = annual mean PM2.5. Hover for the top emission sources, click for the full sector breakdown."
>
  <header class="pm25-hero">
    <div class="pm25-hero-inner">
      <h1 class="pm25-hero-title">US population-weighted PM2.5 exposure, by county</h1>
      <p class="pm25-hero-sub">Each bar is one U.S. county. Bar width is its population; bar height is its annual mean PM<sub>2.5</sub> in µg/m³. Counties are sorted from highest exposure on the left to lowest on the right.</p>
      <p class="pm25-hero-source">PM<sub>2.5</sub>: County Health Rankings 2024 release (CDC EPHT, data year 2019 — a pre-COVID, pre-2020-wildfire-surge baseline). Populations: U.S. Census Bureau Vintage 2019 estimates (as of July 1, 2019). Source breakdown on hover/click: EPA's 2020 National Emissions Inventory.</p>
    </div>
  </header>

  <article class="pm25">
    <section class="pm25-controls" aria-label="Find your county">
      <span class="pm25-controls-label">Find your county</span>
      <label class="pm25-control">
        <span>State</span>
        <select id="pm25-state-select" aria-label="Select state">
          <option value="">— Select —</option>
        </select>
      </label>
      <label class="pm25-control">
        <span>County</span>
        <select id="pm25-county-select" aria-label="Select county" disabled>
          <option value="">— Select —</option>
        </select>
      </label>
      <button id="pm25-clear" type="button" class="pm25-clear" hidden>Clear</button>
    </section>

    <div id="pm25-chart-root">
      <div id="pm25-subtitle"></div>

      <div id="pm25-chart-wrap">
        <svg id="pm25-chart" role="img" aria-label="PM2.5 exposure chart"></svg>
        <div id="pm25-tooltip" class="pm25-tooltip" aria-hidden="true"></div>
      </div>

      <p class="pm25-axis-note">Click any bar for a full source breakdown. The pop-weighted mean line shows what the average American actually breathes.</p>
    </div>

    <section id="pm25-selected" class="pm25-selected" hidden aria-live="polite">
      <header class="pm25-selected-head">
        <h2 id="pm25-selected-name"></h2>
        <div id="pm25-selected-meta"></div>
      </header>
      <p class="pm25-selected-caption">
        Local primary PM<sub>2.5</sub> emissions inside this county, in tons per year (EPA NEI 2020).
        Note: these are sources <em>emitted</em> within the county — not the same as what determines the ambient concentration on the chart above.
      </p>
      <svg id="pm25-selected-chart" role="img" aria-label="Local PM2.5 emission sources"></svg>
    </section>

    <section class="pm25-caveats pm25-prose" aria-labelledby="pm25-cav-title">
      <h3 id="pm25-cav-title">Important caveats</h3>
      <p>The source breakdown shown on hover and click is <strong>primary PM<sub>2.5</sub> emitted inside that county</strong>, in tons per year, from the EPA's National Emissions Inventory. That is <em>not</em> the same as what determines the concentration on the y-axis.</p>
      <ul>
        <li><strong>Secondary PM<sub>2.5</sub></strong> — sulfates, nitrates, and organic aerosols formed in the atmosphere from SO<sub>2</sub>, NO<sub>x</sub>, ammonia, and VOC precursors — is a large share of ambient PM<sub>2.5</sub> across most of the US but doesn't appear in primary-emissions inventories.</li>
        <li><strong>Long-range transport</strong> moves smoke and aerosols across state lines. A county's local emissions can be a minor share of the air people in that county actually breathe.</li>
        <li><strong>Fire/dust years</strong> swing the "Wildfires &amp; prescribed burns" and "Dust" categories enormously year over year. The PM<sub>2.5</sub> values shown are for 2019 — chosen as a pre-COVID, pre-2020-wildfire-surge baseline so the chart reflects typical exposure rather than a single bad smoke year.</li>
        <li><strong>Coverage</strong> is 3,115 of the ~3,144 U.S. counties and county-equivalents. CHR omits a number of sparsely-populated Alaska boroughs and a few other small areas where PM<sub>2.5</sub> monitoring data isn't available — only 4 of Alaska's 29 boroughs and census areas are represented here.</li>
      </ul>
    </section>
  </article>

  <aside id="pm25-panel" class="pm25-panel" aria-hidden="true">
    <button id="pm25-panel-close" aria-label="Close">×</button>
    <h2 id="pm25-panel-county"></h2>
    <div id="pm25-panel-meta"></div>
    <div id="pm25-panel-caption">
      Primary PM<sub>2.5</sub> emissions inside this county, by sector (EPA NEI 2020). These are tons emitted per year — not the same as the source's contribution to the ambient concentration on the y-axis.
    </div>
    <svg id="pm25-panel-chart" role="img" aria-label="Sector emissions chart"></svg>
    <div id="pm25-panel-notes"></div>
  </aside>

  <div id="pm25-panel-backdrop"></div>
</Base>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>

<script is:inline define:vars={{ dataUrl: "/data/pm25-exposure/data.json" }}>
  (function () {
    const SECTOR_NOTES = {
      "Agriculture": "Tilling, livestock dust, and other crop/animal production emissions.",
      "Aircraft, ships, trains": "Aviation, commercial marine, and rail — all diesel- or jet-fuel heavy.",
      "Dust": "Paved-road dust, unpaved-road dust, construction and windblown dust.",
      "Industrial fuel combustion": "Boilers, furnaces, and process heaters at industrial facilities.",
      "Industrial processes": "Chemical manufacturing, metals, petroleum refining, cement, and other industrial processes — separate from combustion.",
      "Off-road equipment": "Construction equipment, agricultural tractors, lawn equipment — mostly diesel.",
      "Oil & gas production": "Drilling, flaring, processing, and storage at oil and gas sites.",
      "On-road vehicles": "Cars, trucks, and buses — tailpipe exhaust plus brake and tire wear.",
      "Other": "Smaller miscellaneous source categories not large enough to break out individually.",
      "Power plants": "Electric utility fuel combustion — overwhelmingly coal (gas combustion contributes little primary PM).",
      "Residential wood heating": "Wood stoves, fireplaces, and outdoor wood boilers — by far the largest residential PM2.5 source. Drives the highest exposures in interior Alaska and the Mountain West. (Also includes a smaller contribution from fuel-oil furnaces.)",
      "Solvents & coatings": "Paint, industrial coatings, solvent use, consumer products.",
      "Wildfires & prescribed burns": "Wildfires, prescribed burns, and agricultural fires. Highly variable year-to-year.",
    };

    const BAR_COLOR = "#4d5a1f";
    const BAR_HOVER = "#7a8c33";
    const BAR_ACTIVE = "#a8b94a";
    const SELECTED_COLOR = "#c0392b";
    const NAAQS_COLOR = "#a83a2c";
    const MEAN_COLOR = "#bd7b1a";

    const STATE_NAMES = {
      AL: "Alabama", AK: "Alaska", AZ: "Arizona", AR: "Arkansas",
      CA: "California", CO: "Colorado", CT: "Connecticut", DE: "Delaware",
      DC: "District of Columbia", FL: "Florida", GA: "Georgia", HI: "Hawaii",
      ID: "Idaho", IL: "Illinois", IN: "Indiana", IA: "Iowa",
      KS: "Kansas", KY: "Kentucky", LA: "Louisiana", ME: "Maine",
      MD: "Maryland", MA: "Massachusetts", MI: "Michigan", MN: "Minnesota",
      MS: "Mississippi", MO: "Missouri", MT: "Montana", NE: "Nebraska",
      NV: "Nevada", NH: "New Hampshire", NJ: "New Jersey", NM: "New Mexico",
      NY: "New York", NC: "North Carolina", ND: "North Dakota", OH: "Ohio",
      OK: "Oklahoma", OR: "Oregon", PA: "Pennsylvania", RI: "Rhode Island",
      SC: "South Carolina", SD: "South Dakota", TN: "Tennessee", TX: "Texas",
      UT: "Utah", VT: "Vermont", VA: "Virginia", WA: "Washington",
      WV: "West Virginia", WI: "Wisconsin", WY: "Wyoming",
      PR: "Puerto Rico", GU: "Guam", VI: "U.S. Virgin Islands",
    };

    const fmtPM = (d) => d.toFixed(1);
    const fmtPop = (d) => d.toLocaleString();
    const fmtTons = (d) => d < 10 ? d.toFixed(1) : Math.round(d).toLocaleString();

    let selectedFips = null;
    let selectedState = null;
    let countiesByFips = new Map();
    let dropdownsInitialized = false;
    let resizeAttached = false;

    function fillForBar(node, d) {
      if (d.fips === selectedFips) return { fill: SELECTED_COLOR, opacity: 1 };
      if (selectedState && d.name.endsWith(", " + selectedState)) {
        return { fill: SELECTED_COLOR, opacity: 0.5 };
      }
      if (node.classList.contains("active")) return { fill: BAR_ACTIVE, opacity: 1 };
      return { fill: BAR_COLOR, opacity: 1 };
    }

    function applyAllBarFills() {
      d3.selectAll(".pm25-bar").each(function (d) {
        const f = fillForBar(this, d);
        d3.select(this).attr("fill", f.fill).attr("opacity", f.opacity);
      });
    }

    const NARROW_BAR_THRESHOLD = 4;

    function updateSelectionMarker() {
      const markerGroup = d3.select(".pm25-marker-group");
      markerGroup.selectAll("*").remove();
      if (!selectedFips) return;
      const barNode = document.querySelector(`.pm25-bar[data-fips="${selectedFips}"]`);
      if (!barNode) return;
      const w = parseFloat(barNode.getAttribute("width"));
      if (w >= NARROW_BAR_THRESHOLD) return;
      const bx = parseFloat(barNode.getAttribute("x"));
      const by = parseFloat(barNode.getAttribute("y"));
      const cx = bx + w / 2;
      const tipY = by - 4;
      const baseY = tipY - 9;

      markerGroup.append("path")
        .attr("class", "pm25-marker-arrow")
        .attr("d", `M ${cx - 4.5} ${baseY} L ${cx + 4.5} ${baseY} L ${cx} ${tipY} Z`)
        .attr("fill", SELECTED_COLOR);
      markerGroup.append("line")
        .attr("class", "pm25-marker-stem")
        .attr("x1", cx).attr("x2", cx)
        .attr("y1", baseY - 6).attr("y2", baseY)
        .attr("stroke", SELECTED_COLOR)
        .attr("stroke-width", 1.4);
    }

    async function render() {
      const data = await d3.json(dataUrl);
      const meta = data.meta;
      const counties = data.counties;

      const svg = d3.select("#pm25-chart");
      const wrapNode = document.getElementById("pm25-chart-wrap");
      const totalW = wrapNode.clientWidth || 1100;
      const W = Math.max(700, totalW);
      const aspect = W >= 1200 ? 0.38 : 0.52;
      const H = Math.round(W * aspect);
      svg.attr("viewBox", `0 0 ${W} ${H}`).attr("preserveAspectRatio", "xMidYMid meet");
      svg.selectAll("*").remove();

      const margin = { top: 20, right: 240, bottom: 50, left: 60 };
      const innerW = W - margin.left - margin.right;
      const innerH = H - margin.top - margin.bottom;

      const totalPopM = meta.total_population / 1e6;
      const maxPM = d3.max(counties, (d) => d.pm25);

      const x = d3.scaleLinear().domain([0, totalPopM]).range([0, innerW]);
      const yMax = Math.max(16, Math.ceil(maxPM));
      const y = d3.scaleLinear().domain([0, yMax]).range([innerH, 0]);

      let cum = 0;
      const bars = counties.map((c) => {
        const x0 = cum;
        cum += c.pop / 1e6;
        return { ...c, x0, x1: cum };
      });

      const g = svg.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

      g.append("g")
        .attr("class", "pm25-grid")
        .call(d3.axisLeft(y).ticks(8).tickSize(-innerW).tickFormat(""))
        .selectAll("line")
        .attr("stroke", "var(--pm25-grid)");
      g.select(".pm25-grid .domain").remove();

      const crosshair = g.append("line")
        .attr("class", "pm25-crosshair")
        .attr("y1", 0).attr("y2", innerH)
        .style("opacity", 0)
        .attr("pointer-events", "none");

      const barG = g.append("g").attr("class", "pm25-bars");
      barG.selectAll("rect")
        .data(bars)
        .enter().append("rect")
        .attr("class", "pm25-bar")
        .attr("x", (d) => x(d.x0))
        .attr("y", (d) => y(d.pm25))
        .attr("width", (d) => Math.max(0.4, x(d.x1) - x(d.x0)))
        .attr("height", (d) => innerH - y(d.pm25))
        .attr("fill", BAR_COLOR)
        .attr("data-fips", (d) => d.fips)
        .on("mouseenter", function (event, d) {
          const f = fillForBar(this, d);
          if (f.fill === BAR_COLOR) {
            d3.select(this).attr("fill", BAR_HOVER);
          }
          d3.select(this).attr("opacity", 1);
          const cx = (x(d.x0) + x(d.x1)) / 2;
          crosshair.attr("x1", cx).attr("x2", cx).style("opacity", 1);
          showTooltip(event, d);
        })
        .on("mousemove", moveTooltip)
        .on("mouseleave", function (event, d) {
          const f = fillForBar(this, d);
          d3.select(this).attr("fill", f.fill).attr("opacity", f.opacity);
          crosshair.style("opacity", 0);
          hideTooltip();
        })
        .on("click", function (event, d) {
          d3.selectAll(".pm25-bar.active").classed("active", false).each(function () {
            const dd = d3.select(this).datum();
            const ff = fillForBar(this, dd);
            d3.select(this).attr("fill", ff.fill).attr("opacity", ff.opacity);
          });
          this.classList.add("active");
          const f = fillForBar(this, d);
          d3.select(this).attr("fill", f.fill).attr("opacity", f.opacity);
          openPanel(d);
        });

      g.append("g").attr("class", "pm25-marker-group");

      const refs = [
        { value: 12, color: NAAQS_COLOR, dash: "3 4", label: "EPA NAAQS · pre-2024", val: "12 µg/m³", focal: false },
        { value: 9, color: NAAQS_COLOR, dash: "6 5", label: "EPA NAAQS · 2024", val: "9 µg/m³", focal: false },
        { value: meta.pop_weighted_mean, color: MEAN_COLOR, dash: null, label: "Pop-weighted mean", val: `${fmtPM(meta.pop_weighted_mean)} µg/m³`, focal: true },
      ].sort((a, b) => b.value - a.value);

      const MIN_GAP = 28;
      const labelYs = refs.map((r) => y(r.value));
      for (let i = 1; i < labelYs.length; i++) {
        if (labelYs[i] - labelYs[i - 1] < MIN_GAP) {
          labelYs[i] = labelYs[i - 1] + MIN_GAP;
        }
      }

      refs.forEach((r, i) => {
        g.append("line")
          .attr("class", "pm25-refline")
          .attr("x1", 0).attr("x2", innerW)
          .attr("y1", y(r.value)).attr("y2", y(r.value))
          .attr("stroke", r.color)
          .attr("stroke-width", r.focal ? 1.4 : 1.1)
          .attr("stroke-dasharray", r.dash || null)
          .attr("opacity", r.focal ? 1 : 0.78);

        const trueY = y(r.value);
        if (Math.abs(trueY - labelYs[i]) > 1) {
          g.append("path")
            .attr("d", `M ${innerW} ${trueY} L ${innerW + 6} ${trueY} L ${innerW + 12} ${labelYs[i]}`)
            .attr("fill", "none")
            .attr("stroke", r.color)
            .attr("stroke-width", 0.7)
            .attr("opacity", 0.55);
        }

        const lg = g.append("g")
          .attr("transform", `translate(${innerW + 16}, ${labelYs[i]})`);
        lg.append("text")
          .attr("class", "pm25-ref-label")
          .attr("dominant-baseline", "middle")
          .attr("dy", -6)
          .attr("fill", r.color)
          .attr("font-weight", r.focal ? 700 : 600)
          .text(r.label);
        lg.append("text")
          .attr("class", "pm25-ref-value")
          .attr("dominant-baseline", "middle")
          .attr("dy", 8)
          .text(r.val);
      });

      const ANNOTATIONS = [
        { fips: "06037", label: "Los Angeles", anchor: "middle" },
        { fips: "17031", label: "Cook County, IL", anchor: "middle" },
      ];
      ANNOTATIONS.forEach((a) => {
        const bar = bars.find((b) => b.fips === a.fips);
        if (!bar) return;
        const cx = (x(bar.x0) + x(bar.x1)) / 2;
        const cy = y(bar.pm25);
        const labelY = Math.max(14, cy - 22);
        const labelX = a.anchor === "start" ? cx + 6 : cx;

        g.append("line")
          .attr("class", "pm25-annotation-leader")
          .attr("x1", cx).attr("y1", cy - 2)
          .attr("x2", cx).attr("y2", labelY + 4);
        g.append("text")
          .attr("class", "pm25-annotation")
          .attr("x", labelX).attr("y", labelY)
          .attr("text-anchor", a.anchor)
          .text(a.label);
      });

      g.append("g").attr("class", "pm25-axis")
        .attr("transform", `translate(0,${innerH})`)
        .call(d3.axisBottom(x).tickSize(4).tickFormat((d) => d === 0 ? "0M" : `${d}M`))
        .call((sel) => sel.select(".domain").remove());
      g.append("g").attr("class", "pm25-axis")
        .call(d3.axisLeft(y).ticks(8).tickSize(4))
        .call((sel) => sel.select(".domain").remove());

      g.append("text")
        .attr("class", "pm25-axis-label")
        .attr("x", innerW / 2).attr("y", innerH + 40)
        .attr("text-anchor", "middle")
        .text("Cumulative US population (millions) — most-exposed at left, least-exposed at right");
      g.append("text")
        .attr("class", "pm25-axis-label")
        .attr("transform", `translate(-44,${innerH / 2}) rotate(-90)`)
        .attr("text-anchor", "middle")
        .text("Annual mean PM₂.₅ (µg/m³)");

      d3.select("#pm25-subtitle").text(
        `${fmtPop(meta.n_counties)} counties · ${Math.round(meta.total_population / 1e6)}M people `
        + `· sorted by PM₂.₅ (highest → lowest) · bar width = county population`
      );

      const tooltip = d3.select("#pm25-tooltip");

      function topSectors(c, n = 3) {
        return Object.entries(c.sectors)
          .filter(([, v]) => v > 0)
          .sort((a, b) => b[1] - a[1])
          .slice(0, n);
      }

      function showTooltip(event, d) {
        const top = topSectors(d);
        const rows = top.map(([k, v]) =>
          `<li><span class="pm25-tt-sector">${k}</span> <span class="pm25-tt-val">${fmtTons(v)} t/yr</span></li>`
        ).join("");
        tooltip.html(
          `<div class="pm25-tt-name">${d.name}</div>`
          + `<div class="pm25-tt-stat"><b>PM₂.₅:</b> ${fmtPM(d.pm25)} µg/m³</div>`
          + `<div class="pm25-tt-stat"><b>Population:</b> ${fmtPop(d.pop)}</div>`
          + `<div class="pm25-tt-stat pm25-tt-sub">Top local sources (primary PM₂.₅, tons/yr):</div>`
          + `<ul class="pm25-tt-list">${rows || "<li>(no data)</li>"}</ul>`
          + `<div class="pm25-tt-hint">Click for full breakdown</div>`
        ).attr("aria-hidden", "false").style("opacity", 1);
        moveTooltip(event);
      }

      function moveTooltip(event) {
        const pad = 14;
        const ttNode = tooltip.node();
        const wrapRect = wrapNode.getBoundingClientRect();
        const xx = event.clientX - wrapRect.left + pad;
        const yy = event.clientY - wrapRect.top + pad;
        const maxX = wrapRect.width - ttNode.offsetWidth - 8;
        const maxY = wrapRect.height - ttNode.offsetHeight - 8;
        tooltip.style("left", Math.min(xx, maxX) + "px")
               .style("top", Math.min(yy, maxY) + "px");
      }

      function hideTooltip() {
        tooltip.style("opacity", 0).attr("aria-hidden", "true");
      }

      const panel = d3.select("#pm25-panel");
      const backdrop = d3.select("#pm25-panel-backdrop");

      function openPanel(d) {
        panel.classed("open", true).attr("aria-hidden", "false");
        backdrop.classed("open", true);
        d3.select("#pm25-panel-county").text(d.name);
        d3.select("#pm25-panel-meta").html(
          `<span><b>PM₂.₅:</b> ${fmtPM(d.pm25)} µg/m³</span>`
          + `<span><b>Population:</b> ${fmtPop(d.pop)}</span>`
          + `<span><b>FIPS:</b> ${d.fips}</span>`
        );
        renderPanelChart(d);
      }

      function closePanel() {
        panel.classed("open", false).attr("aria-hidden", "true");
        backdrop.classed("open", false);
        d3.selectAll(".pm25-bar.active").classed("active", false).attr("fill", BAR_COLOR);
      }

      d3.select("#pm25-panel-close").on("click", closePanel);
      backdrop.on("click", closePanel);
      d3.select("body").on("keyup.pm25", (e) => { if (e.key === "Escape") closePanel(); });

      function renderPanelChart(d) {
        const entries = Object.entries(d.sectors)
          .filter(([, v]) => v > 0)
          .sort((a, b) => b[1] - a[1]);
        const sectorMax = d3.max(entries, (e) => e[1]) || 1;

        const pw = panel.node().clientWidth - 48;
        const rowH = 30;
        const labelW = 170;
        const ph = entries.length * rowH + 10;
        const psvg = d3.select("#pm25-panel-chart")
          .attr("viewBox", `0 0 ${pw} ${ph}`)
          .attr("preserveAspectRatio", "xMidYMid meet")
          .style("height", ph + "px");
        psvg.selectAll("*").remove();

        const px = d3.scaleLinear().domain([0, sectorMax]).range([0, pw - labelW - 80]);

        const rows = psvg.selectAll("g").data(entries).enter().append("g")
          .attr("transform", (_, i) => `translate(0,${i * rowH + 4})`);

        rows.append("text")
          .attr("x", labelW - 8).attr("y", rowH / 2)
          .attr("text-anchor", "end").attr("dominant-baseline", "middle")
          .attr("class", "pm25-panel-row-label")
          .text(([k]) => k);

        rows.append("rect")
          .attr("x", labelW).attr("y", 4)
          .attr("width", ([, v]) => Math.max(0.5, px(v)))
          .attr("height", rowH - 10)
          .attr("fill", BAR_COLOR)
          .append("title").text(([k]) => SECTOR_NOTES[k] || k);

        rows.append("text")
          .attr("x", ([, v]) => labelW + px(v) + 6).attr("y", rowH / 2)
          .attr("dominant-baseline", "middle")
          .attr("class", "pm25-panel-row-val")
          .text(([, v]) => `${fmtTons(v)} t/yr`);
      }

      countiesByFips = new Map(counties.map((c) => [c.fips, c]));

      applyAllBarFills();
      updateSelectionMarker();
      if (selectedFips) {
        const c = countiesByFips.get(selectedFips);
        if (c) renderSelectedBreakdown(c);
      }

      if (!dropdownsInitialized) {
        initDropdowns(counties);
        dropdownsInitialized = true;
      }

      if (!resizeAttached) {
        let resizeTimer;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (document.getElementById("pm25-chart-wrap")) render();
          }, 200);
        });
        resizeAttached = true;
      }
    }

    function start() {
      if (!document.getElementById("pm25-chart")) return;
      if (typeof d3 === "undefined") {
        setTimeout(start, 50);
        return;
      }
      render().catch((err) => {
        console.error("PM2.5 chart failed to render:", err);
      });
    }

    function selectState(state) {
      selectedState = state || null;
      applyAllBarFills();
      updateSelectionMarker();
    }

    function selectCounty(fips) {
      selectedFips = fips || null;
      const panel = document.getElementById("pm25-selected");
      if (!selectedFips) {
        panel.hidden = true;
        applyAllBarFills();
        updateSelectionMarker();
        return;
      }
      const c = countiesByFips.get(selectedFips);
      if (!c) {
        panel.hidden = true;
        applyAllBarFills();
        updateSelectionMarker();
        return;
      }
      renderSelectedBreakdown(c);
      panel.hidden = false;
      applyAllBarFills();
      updateSelectionMarker();
    }

    function renderSelectedBreakdown(c) {
      const panel = document.getElementById("pm25-selected");
      document.getElementById("pm25-selected-name").textContent = c.name;
      document.getElementById("pm25-selected-meta").innerHTML =
        `<span><b>PM₂.₅:</b> ${fmtPM(c.pm25)} µg/m³</span>`
        + `<span><b>Population:</b> ${fmtPop(c.pop)}</span>`
        + `<span><b>FIPS:</b> ${c.fips}</span>`;

      const entries = Object.entries(c.sectors)
        .filter(([, v]) => v > 0)
        .sort((a, b) => b[1] - a[1]);

      const sw = Math.max(360, panel.clientWidth - 48);
      const rowH = 32;
      const labelW = 200;
      const valW = 90;
      const sh = entries.length * rowH + 12;
      const ssvg = d3.select("#pm25-selected-chart")
        .attr("viewBox", `0 0 ${sw} ${sh}`)
        .attr("preserveAspectRatio", "xMidYMid meet")
        .style("height", sh + "px");
      ssvg.selectAll("*").remove();

      const sectorMax = d3.max(entries, (e) => e[1]) || 1;
      const px = d3.scaleLinear().domain([0, sectorMax]).range([0, sw - labelW - valW]);

      const rows = ssvg.selectAll("g").data(entries).enter().append("g")
        .attr("transform", (_, i) => `translate(0,${i * rowH + 6})`);

      rows.append("text")
        .attr("x", labelW - 10).attr("y", rowH / 2)
        .attr("text-anchor", "end").attr("dominant-baseline", "middle")
        .attr("class", "pm25-panel-row-label")
        .text(([k]) => k);

      rows.append("rect")
        .attr("x", labelW).attr("y", 4)
        .attr("width", ([, v]) => Math.max(0.5, px(v)))
        .attr("height", rowH - 12)
        .attr("fill", SELECTED_COLOR)
        .attr("opacity", 0.88)
        .append("title").text(([k]) => SECTOR_NOTES[k] || k);

      rows.append("text")
        .attr("x", ([, v]) => labelW + px(v) + 8).attr("y", rowH / 2)
        .attr("dominant-baseline", "middle")
        .attr("class", "pm25-panel-row-val")
        .text(([, v]) => `${fmtTons(v)} t/yr`);
    }

    function initDropdowns(counties) {
      const stateSel = document.getElementById("pm25-state-select");
      const countySel = document.getElementById("pm25-county-select");
      const clearBtn = document.getElementById("pm25-clear");
      if (!stateSel || !countySel) return;

      const states = Array.from(new Set(
        counties.map((c) => c.name.split(",").pop().trim())
      )).sort((a, b) => (STATE_NAMES[a] || a).localeCompare(STATE_NAMES[b] || b));

      stateSel.innerHTML =
        '<option value="">— Select —</option>'
        + states.map((s) => `<option value="${s}">${STATE_NAMES[s] || s}</option>`).join("");

      function updateClear() {
        clearBtn.hidden = !(stateSel.value || countySel.value);
      }

      stateSel.addEventListener("change", (e) => {
        const state = e.target.value;
        const filtered = state
          ? counties.filter((c) => c.name.endsWith(", " + state))
                    .sort((a, b) => a.name.localeCompare(b.name))
          : [];
        countySel.innerHTML =
          '<option value="">— Select —</option>'
          + filtered.map((c) => {
              const short = c.name.replace(", " + state, "");
              return `<option value="${c.fips}">${short}</option>`;
            }).join("");
        countySel.disabled = filtered.length === 0;
        countySel.value = "";
        selectCounty(null);
        selectState(state || null);
        updateClear();
      });

      countySel.addEventListener("change", (e) => {
        selectCounty(e.target.value || null);
        updateClear();
      });

      clearBtn.addEventListener("click", () => {
        stateSel.value = "";
        countySel.innerHTML = '<option value="">— Select —</option>';
        countySel.disabled = true;
        selectCounty(null);
        selectState(null);
        updateClear();
      });
    }

    document.addEventListener("astro:page-load", start);
    if (document.readyState !== "loading") start();
    else document.addEventListener("DOMContentLoaded", start);
  })();
</script>

