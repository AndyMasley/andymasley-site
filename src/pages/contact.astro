---
import SectionPage from '@/layouts/SectionPage.astro';

const elsewhere = [
  { label: 'Substack', href: 'https://substack.com/@andymasley' },
  { label: 'Twitter', href: 'https://x.com/AndyMasley' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/andymasley.bsky.social' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/andrew-masley/' },
  { label: 'EA Forum', href: 'https://forum.effectivealtruism.org/users/andy-masley' },
];
---

<SectionPage
  title="Contact"
  description="Get in touch with Andy Masley"
  ogImage="/og/page/contact.png"
>
  <p class="page-header__description" slot="lede">
    Email me at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a> if you’d like
    to chat, or leave <a href="https://docs.google.com/forms/d/e/1FAIpQLSfeuR0zagnxjzyNQvh6OkI8pRd9Vtq26D8RzJ2h8WZYlaz8Sw/viewform?usp=send_form" target="_blank" rel="noopener">anonymous feedback</a>.
    I read everything, including the anonymous form.
    If you’re a journalist checking a claim, or you’d like me on a podcast, email me.
    If you’ve found an error in something I wrote, <a href="/writing/errors-and-updates">there’s a $300 bounty</a>.
  </p>

  <p class="contact-elsewhere" aria-label="Elsewhere">
    <span class="contact-elsewhere__label">Elsewhere: </span>
    {elsewhere.map((e, i) => (
      <>
        {i > 0 && <span class="contact-elsewhere__sep"> · </span>}
        <a href={e.href} target="_blank" rel="noopener">{e.label}</a>
      </>
    ))}
  </p>
</SectionPage>

<style>
  .contact-elsewhere {
    margin: 2.2rem 0 0;
  }

  .contact-elsewhere__label {
    color: var(--dim);
  }

  .contact-elsewhere__sep {
    color: var(--border-strong);
  }
</style>
