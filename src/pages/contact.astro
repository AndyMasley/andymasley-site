---
import SectionPage from '@/layouts/SectionPage.astro';
import Elsewhere from '@/components/Elsewhere.astro';
---

<SectionPage
  title="Contact"
  description="Get in touch with Andy Masley"
  ogImage="/og/page/contact.png?v=4"
>
  <p class="page-header__description" slot="lede">
    Email me at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a> if you’d like
    to chat, or leave <a href="https://docs.google.com/forms/d/e/1FAIpQLSfeuR0zagnxjzyNQvh6OkI8pRd9Vtq26D8RzJ2h8WZYlaz8Sw/viewform?usp=send_form" target="_blank" rel="noopener">anonymous feedback</a>.
    I read everything, including the anonymous form.
    If you’re a journalist checking a claim, or you’d like me on a podcast, email me.
    If you’ve found an error in something I wrote, <a href="/writing/errors-and-updates">there’s a $300 bounty</a>.
  </p>

  <div class="contact-elsewhere">
    <Elsewhere />
  </div>

  <section class="contact-press">
    <h2 class="contact-press__label">Press</h2>
    <p class="contact-press__note">
      A <a href="/images/headshot.jpg">headshot</a> and a short bio:
      Andy Masley is an independent writer and researcher covering AI and the
      environment, animal welfare, and effective altruism. His work is funded
      by a grant from Coefficient Giving. Before writing full time he directed
      the effective altruism city group in Washington DC and taught high
      school physics for seven years.
    </p>
  </section>
</SectionPage>

<style>
  .contact-elsewhere {
    margin: 2.2rem 0 0;
  }

  .contact-press {
    margin: 2.6rem 0 0;
  }

  /* Sentence case, matching the Elsewhere line directly above it — that
     line is shared with the homepage, which stopped shouting in Aug 2026,
     and a spaced-caps "PRESS" under a sentence-case "Elsewhere:" was the
     only mismatch left on this page. */
  .contact-press__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--dim);
  }

  .contact-press__note {
    margin: 0;
    max-width: 38rem;
    font-size: var(--text-base);
    line-height: var(--leading-prose);
    color: var(--text-secondary);
  }
</style>
