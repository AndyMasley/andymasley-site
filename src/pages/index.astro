---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts } from '@/lib/substack';
import { getMetaPostSlugs } from '@/lib/meta-posts';

// Fetch recent blog posts from Substack
const allPosts = await fetchSubstackPosts();
const metaSlugs = getMetaPostSlugs();
const recentPosts = allPosts
  .filter(p => !metaSlugs.includes(p.slug))
  .slice(0, 4);

function formatDate(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${month}.${day}`;
}
---

<Base title="Home">
  <div class="home-intro">
    <img
      src="/images/headshot.jpg"
      alt="Andy Masley"
      class="headshot"
    />
    <p>
      I'm an independent writer and researcher funded by a grant from <a href="https://coefficientgiving.org/" target="_blank" rel="noopener">Coefficient Giving</a><sup><a href="#fn1" id="fnref1">1</a></sup> to explore topics in AI and other areas. All my writing is <a href="/writing/">linked here</a>. A lot of it is published on <a href="https://andymasley.substack.com/" target="_blank" rel="noopener">my Substack</a>. Before this I was the director of the <a href="https://www.effectivealtruismdc.org/" target="_blank" rel="noopener">effective altruism city group in Washington DC</a>, and before that I taught <a href="/physics/">high school physics for 7 years</a>. I made animated video lectures for each day of my 2 year IB physics course which I host on my <a href="https://www.youtube.com/@andymasley" target="_blank" rel="noopener">YouTube channel</a>. In college I double majored in philosophy and physics at <a href="https://en.wikipedia.org/wiki/Clark_University" target="_blank" rel="noopener">Clark University in Worcester MA</a>. I've lived in DC for 10 years and grew up in <a href="https://en.wikipedia.org/wiki/Webster,_Massachusetts" target="_blank" rel="noopener">Webster MA</a>.
    </p>
    <p>
      I write from a generally <a href="https://80000hours.org/articles/effective-altruism/" target="_blank" rel="noopener">effective altruist</a> perspective — I discovered EA ideas through Peter Singer in 2009 and EA itself through <a href="https://en.wikipedia.org/wiki/Derek_Parfit" target="_blank" rel="noopener">Derek Parfit</a> in 2013 — but it's one philosophical view among many. I'm also drawn to <a href="https://www.persuasion.community/p/the-unexpected-persistence-of-john" target="_blank" rel="noopener">political liberalism</a>, <a href="https://en.wikipedia.org/wiki/Naturalism_(philosophy)" target="_blank" rel="noopener">philosophical naturalism</a> (especially <a href="https://cspeirce.com/menu/library/bycsp/conseq/cn-main.htm" target="_blank" rel="noopener">Peirce</a>, <a href="https://philarchive.org/archive/VERQOT" target="_blank" rel="noopener">Quine</a>, and <a href="https://web.ics.purdue.edu/~drkelly/DennettQuiningQualia1988.pdf" target="_blank" rel="noopener">Dennett</a>), and (from afar) <a href="https://www.sfu.ca/~decaste/OISE/page2/files/HarawayCyborg.pdf" target="_blank" rel="noopener">continental philosophy of technology</a>.
    </p>
    <p>
      I'm excited to represent and promote EA thinking on major issues, but not everything I say or write will be from an EA perspective or be agreed with by most other people into EA. My favorite resource for people who want to learn more about EA is <a href="https://80000hours.org/foundations/" target="_blank" rel="noopener">the 80,000 Hours series on how they approach problems</a>. My writing style has been influenced a lot by 80,000 Hours problem profiles <a href="https://80000hours.org/problem-profiles/factory-farming/" target="_blank" rel="noopener">like this one</a>. <a href="https://forum.effectivealtruism.org/handbook" target="_blank" rel="noopener">The EA Handbook</a> is also great. <a href="https://www.amazon.com/Precipice-Existential-Risk-Future-Humanity/dp/0316484911" target="_blank" rel="noopener">The Precipice</a> is excellent for EA thinking on x-risk specifically.
    </p>
    <p>
      I <a href="https://x.com/AndyMasley" target="_blank" rel="noopener">tweet</a> a lot. You can follow my full media empire <a href="https://linktr.ee/andymasley" target="_blank" rel="noopener">here</a>.
    </p>
    <p>
      Email me at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a> if you'd like to chat! You can also connect with me on <a href="https://www.linkedin.com/in/andrew-masley/" target="_blank" rel="noopener">LinkedIn</a>. You can leave me anonymous feedback <a href="https://docs.google.com/forms/d/e/1FAIpQLSfeuR0zagnxjzyNQvh6OkI8pRd9Vtq26D8RzJ2h8WZYlaz8Sw/viewform?usp=dialog" target="_blank" rel="noopener">here</a>.
    </p>
    <p class="pronunciation">(It's pronounced May-zlee).</p>
    <aside class="footnote" id="fn1">
      <sup>1</sup> I am not employed by Coefficient Giving and my views don't represent theirs. The grant does not obligate me to write from any specific perspective. The full text description of the grant's purpose reads:
      <blockquote>To support one year of writing and communications work made publicly available on topics related to AI, public policy, and other topics.</blockquote>
      Besides my grant, the only other source of income I get from my writing is individual paid Substack subscribers, one-off speaking fees, and one-off payments for writing in other publications. <a href="#fnref1" class="footnote-return">↩</a>
    </aside>
  </div>

  <div class="divider"><div class="divider-diamond"></div></div>

  <div class="home-recent">
    <div class="label">Recent</div>
    <ul class="content-list">
      {recentPosts.map(post => (
        <li class="content-item post-item">
          <span class="content-item__date">{formatDate(post.date)}</span>
          <a href={`/writing/${post.slug}`} class="content-item__link">
            {post.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="divider"><div class="divider-diamond"></div></div>

  <div class="home-elsewhere">
    <span class="label">Elsewhere: </span>
    <a href="https://substack.com/@andymasley" target="_blank" rel="noopener">Substack</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://x.com/AndyMasley" target="_blank" rel="noopener">Twitter</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://bsky.app/profile/andymasley.bsky.social" target="_blank" rel="noopener">Bluesky</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.linkedin.com/in/andrew-masley/" target="_blank" rel="noopener">LinkedIn</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.youtube.com/@andymasley" target="_blank" rel="noopener">YouTube</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.youtube.com/@Andyonsuno" target="_blank" rel="noopener">AI Songs</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.goodreads.com/andymasley" target="_blank" rel="noopener">Goodreads</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://letterboxd.com/andymasley/" target="_blank" rel="noopener">Letterboxd</a>
    <span class="header__nav-sep"> · </span>
    <a href="/rss.xml">RSS</a>
  </div>
</Base>

<style>
  .home-intro {
    overflow: hidden;
  }

  .headshot {
    float: left;
    width: 120px;
    height: 120px;
    object-fit: cover;
    margin: 0 28px 16px 0;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    border: 2px solid var(--bg-elevated);
    outline: 1px solid var(--border);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .headshot:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-xl);
  }

  .home-elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }

  .home-elsewhere .label {
    margin-bottom: 0;
    margin-right: 8px;
  }

  .home-elsewhere .label::after {
    display: none;
  }

  .pronunciation {
    font-style: italic;
    color: var(--dim);
  }

  .footnote {
    font-size: 0.8rem;
    color: var(--dim);
    border-top: 1px solid var(--border);
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    line-height: 1.5;
  }

  .footnote blockquote {
    margin: var(--space-sm) 0;
    padding-left: 1em;
    border-left: 2px solid var(--border);
    font-style: italic;
  }

  .footnote-return {
    font-style: normal;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }

  .footnote-return:hover {
    opacity: 1;
  }
</style>
