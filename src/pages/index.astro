---
import Base from '@/layouts/Base.astro';
import { fetchSubstackPosts } from '@/lib/substack';
import { getMetaPostSlugs } from '@/lib/meta-posts';
import { formatCompactDate } from '@/lib/format-date';

// Fetch recent blog posts from Substack
const allPosts = await fetchSubstackPosts();
const metaSlugs = getMetaPostSlugs();
const recentPosts = allPosts
  .filter(p => !metaSlugs.includes(p.slug))
  .slice(0, 4);

const RAW_COVER_PREFIX = 'https://substack-post-media.s3.amazonaws.com/public/images/';

function sizedCover(cover: string, width: number): string {
  if (cover.startsWith(RAW_COVER_PREFIX)) {
    return `https://substackcdn.com/image/fetch/w_${width},c_limit,f_auto,q_auto:good/${encodeURIComponent(cover)}`;
  }
  return cover;
}
const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Andy Masley',
    url: 'https://andymasley.com/',
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Andy Masley',
    url: 'https://andymasley.com/',
    image: 'https://andymasley.com/images/headshot.jpg',
    description: 'Writer and researcher exploring AI, the environment, animal welfare, and effective altruism.',
    sameAs: [
      'https://x.com/AndyMasley',
      'https://bsky.app/profile/andymasley.bsky.social',
      'https://www.linkedin.com/in/andrew-masley/',
      'https://www.youtube.com/@andymasley',
      'https://andymasley.substack.com/',
      'https://www.goodreads.com/andymasley',
      'https://letterboxd.com/andymasley/',
    ],
  },
];

---

<Base
  title="Andy Masley"
  ogTitle="Andy Masley"
  description="Writer and researcher exploring AI, the environment, animal welfare, and effective altruism. Former physics teacher turned full-time writer."
  ogImageAlt="Andy Masley — writing, data visualizations, physics lectures, and lists"
  structuredData={homeStructuredData}
>
  <div class="home-intro">
    <div class="home-lede">
      <img
        src="/images/headshot.jpg"
        alt="Andy Masley"
        class="headshot"
      />
      <p>
        I’m an independent writer and researcher funded by a grant from <a href="https://coefficientgiving.org/" target="_blank" rel="noopener">Coefficient Giving</a> to explore topics in AI and other areas. All my writing is <a href="/writing/">linked here</a>. A lot of it is published on <a href="https://andymasley.substack.com/" target="_blank" rel="noopener">my Substack</a>. Before this I was the director of the <a href="https://www.effectivealtruismdc.org/" target="_blank" rel="noopener">effective altruism city group in Washington DC</a>, and before that I taught <a href="/physics/">high school physics for 7 years</a>. I made animated video lectures for each day of my 2 year IB physics course which I host on my <a href="https://www.youtube.com/@andymasley" target="_blank" rel="noopener">YouTube channel</a>. In college I double majored in philosophy and physics at Clark University in Worcester MA. I’ve lived in DC for 10 years and grew up in Webster MA.
      </p>
    </div>
    <details class="grant-note">
      <summary>About the grant</summary>
      <p>I am not employed by Coefficient Giving and my views don’t represent theirs. The grant does not obligate me to write from any specific perspective. The full text description of the grant’s purpose reads:</p>
      <blockquote>To support one year of writing and communications work made publicly available on topics related to AI, public policy, and other topics.</blockquote>
      <p>I do not receive any other funding for my writing besides individual paid Substack subscribers, and one-off payments for writing in other publications.</p>
    </details>
    <p>
      I write from a generally <a href="https://80000hours.org/articles/effective-altruism/" target="_blank" rel="noopener">effective altruist</a> perspective (I discovered EA ideas through Peter Singer in 2009 and EA itself through Derek Parfit in 2013) but it’s one philosophical view among many. I’m also very into political liberalism, philosophical naturalism (especially Peirce, Quine, and Dennett), and (from afar) continental philosophy of technology.
    </p>
    <p>
      I’m excited to promote EA thinking on major issues, though not everything I write will be from an EA perspective or agreed with by most EAs. My favorite resource for someone who wants to learn more about EA is <a href="https://80000hours.org/foundations/" target="_blank" rel="noopener">the 80,000 Hours series on how they approach problems</a>. My writing style has been influenced a lot by 80,000 Hours problem profiles <a href="https://80000hours.org/problem-profiles/factory-farming/" target="_blank" rel="noopener">like this one</a>. <a href="https://forum.effectivealtruism.org/handbook" target="_blank" rel="noopener">The EA Handbook</a> is also great. <a href="https://www.amazon.com/Precipice-Existential-Risk-Future-Humanity/dp/0316484911" target="_blank" rel="noopener">The Precipice</a> is excellent for EA thinking on x-risk specifically.
    </p>
    <p>
      I <a href="https://x.com/AndyMasley" target="_blank" rel="noopener">tweet</a> a lot. For fun I mostly spend time with friends, <a href="/writing/all-my-vegan-fitness-advice-part/">exercise</a>, try to consume a lot of <a href="https://open.spotify.com/user/andymasley?si=bb82448da2bd4805" target="_blank" rel="noopener">music</a>, <a href="https://letterboxd.com/AndyMasley/" target="_blank" rel="noopener">movies</a>, and <a href="https://www.goodreads.com/user/show/107569189-andy-masley" target="_blank" rel="noopener">books</a>, and explore DC’s <a href="/lists/dc-vegan-dining/">amazing vegan-friendly restaurants</a>.
    </p>
    <p>
      Email me at <a href="mailto:AndyMasley@gmail.com">AndyMasley@gmail.com</a> if you’d like to chat! You can also connect with me on <a href="https://www.linkedin.com/in/andrew-masley/" target="_blank" rel="noopener">LinkedIn</a>. You can leave me anonymous feedback <a href="https://docs.google.com/forms/d/e/1FAIpQLSfeuR0zagnxjzyNQvh6OkI8pRd9Vtq26D8RzJ2h8WZYlaz8Sw/viewform?usp=dialog" target="_blank" rel="noopener">here</a>.
    </p>
    <p class="pronunciation">(It’s pronounced May-zlee)</p>
  </div>

  <div class="divider"><div class="divider-diamond"></div></div>

  <div class="home-recent">
    <div class="label">Recent</div>
    <ul class="recent-list">
      {recentPosts.map(post => (
        <li class="recent-item">
          {post.cover_image ? (
            <a href={`/writing/${post.slug}`} class="recent-item__thumblink" tabindex="-1" aria-hidden="true">
              <img
                src={sizedCover(post.cover_image, 200)}
                alt=""
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='/og/${post.slug}.png';`}
              />
            </a>
          ) : (
            <span class="recent-item__thumblink" aria-hidden="true"></span>
          )}
          <div class="recent-item__main">
            <a href={`/writing/${post.slug}`} class="recent-item__link">{post.title}</a>
            <span class="recent-item__date">{formatCompactDate(post.date)}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="divider"><div class="divider-diamond"></div></div>

  <div class="home-elsewhere">
    <span class="label">Elsewhere: </span>
    <a href="https://substack.com/@andymasley" target="_blank" rel="noopener">Substack</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://x.com/AndyMasley" target="_blank" rel="noopener">Twitter</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://bsky.app/profile/andymasley.bsky.social" target="_blank" rel="noopener">Bluesky</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.linkedin.com/in/andrew-masley/" target="_blank" rel="noopener">LinkedIn</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.youtube.com/@andymasley" target="_blank" rel="noopener">YouTube</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://www.goodreads.com/andymasley" target="_blank" rel="noopener">Goodreads</a>
    <span class="header__nav-sep"> · </span>
    <a href="https://letterboxd.com/andymasley/" target="_blank" rel="noopener">Letterboxd</a>
    <span class="header__nav-sep"> · </span>
    <a href="/rss.xml">RSS</a>
  </div>
</Base>

<style>
  .home-lede {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 0 28px;
    align-items: start;
    margin-bottom: 0.4rem;
  }

  .home-lede p {
    margin: 0;
  }

  .headshot {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
    border: 1px solid var(--border-strong);
    outline: 1px solid var(--border-subtle);
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
  }

  .headshot:hover {
    opacity: 0.92;
    border-color: var(--accent);
  }

  .grant-note {
    margin: 0.6rem 0 1.2rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .grant-note summary {
    cursor: pointer;
    color: var(--dim);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .grant-note summary:hover {
    color: var(--accent);
  }

  .grant-note p {
    margin: 0.5rem 0 0;
  }

  .grant-note blockquote {
    margin: 0.5rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--border);
    font-style: italic;
    color: var(--dim);
  }

  .recent-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .recent-item:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .recent-item__thumblink {
    display: block;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .recent-item__thumblink img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recent-item__main {
    min-width: 0;
  }

  .recent-item__link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--border-strong);
  }

  .recent-item:hover .recent-item__link {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .recent-item__link:visited { color: #551a8b; }
  :global([data-theme="dark"]) .recent-item__link:visited { color: #c58af9; }

  .recent-item__date {
    display: block;
    margin-top: 0.14rem;
    font-family: var(--font-label);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @media (max-width: 560px) {
    .home-lede {
      grid-template-columns: 1fr;
      gap: 1rem 0;
    }
  }

  .home-elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }

  .home-elsewhere .label {
    margin-bottom: 0;
    margin-right: 8px;
  }

  .home-elsewhere .label::after {
    display: none;
  }

  .pronunciation {
    font-style: italic;
    color: var(--dim);
  }
</style>
