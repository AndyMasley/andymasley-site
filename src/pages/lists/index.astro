---
import SectionPage from '@/layouts/SectionPage.astro';

// Annotations drafted from each list page's own copy — edit freely.
const lists = [
  {
    title: 'Favorite things',
    href: '/lists/favorite-things',
    note: 'Books, movies, albums, places, quotes, and ideas I come back to, with notes on why.',
  },
  {
    title: 'Product recommendations',
    href: '/lists/product-recommendations',
    note: 'Products that have made my life better, from kitchen gear to software.',
  },
  {
    title: 'Great DC restaurants for vegans',
    href: '/lists/dc-vegan-dining',
    note: 'My favorite vegan food and restaurants in the DC area.',
  },
];
---

<SectionPage
  title="Lists"
  lede="Curated lists: favorite things, product recommendations, and where to eat vegan in DC."
  description="Andy's curated lists — favorite things, product recommendations, and DC vegan dining."
  ogImage="/images/og/og-lists.png"
>
  <ul class="annotated-list">
    {lists.map(l => (
      <li class="annotated-list__item">
        <div class="annotated-list__row">
          <a href={l.href} class="annotated-list__title">{l.title}</a>
        </div>
        <p class="annotated-list__note">{l.note}</p>
      </li>
    ))}
  </ul>
</SectionPage>
