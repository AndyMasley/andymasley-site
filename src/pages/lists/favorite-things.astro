  <script is:inline>
    function initFavoriteThings() {
      // Popout card functionality
      const popoutCard = document.getElementById('popout-card');
      const popoutBody = popoutCard?.querySelector('.popout-body');
      const popoutClose = popoutCard?.querySelector('.popout-close');
      let currentPopoutItem = null;

      function closePopout() {
        if (!popoutCard) return;
        popoutCard.classList.remove('open');
        if (currentPopoutItem) {
          currentPopoutItem.classList.remove('active');
          currentPopoutItem = null;
        }
      }

      function openPopout(item, sublist) {
        if (!popoutCard || !popoutBody || !sublist) return;

        // Close if clicking same item
        if (currentPopoutItem === item) {
          closePopout();
          return;
        }

        // Update active state
        if (currentPopoutItem) {
          currentPopoutItem.classList.remove('active');
        }
        item.classList.add('active');
        currentPopoutItem = item;

        // Convert sub-bullets to paragraphs
        const bullets = sublist.querySelectorAll(':scope > li');
        let html = '';
        bullets.forEach(bullet => {
          html += '<p>' + bullet.innerHTML + '</p>';
        });
        popoutBody.innerHTML = html;

        // Position the card below the item
        const itemRect = item.getBoundingClientRect();
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const isMobile = window.innerWidth <= 600;

        if (isMobile) {
          // Mobile: fixed to bottom
          popoutCard.style.position = 'fixed';
          popoutCard.style.top = 'auto';
          popoutCard.style.bottom = '0';
          popoutCard.style.left = '0';
          popoutCard.style.right = '0';
          popoutCard.classList.add('mobile');
        } else {
          // Desktop: position below item
          popoutCard.style.position = 'absolute';
          popoutCard.style.top = (itemRect.bottom + scrollTop + 8) + 'px';
          popoutCard.style.left = (itemRect.left) + 'px';
          popoutCard.style.bottom = 'auto';
          popoutCard.style.right = 'auto';
          popoutCard.classList.remove('mobile');
        }

        popoutCard.classList.add('open');
      }

      // Find all list items in .has-popouts that have nested <ul>
      document.querySelectorAll('.has-popouts > li').forEach(item => {
        const sublist = item.querySelector(':scope > ul');
        if (!sublist) return;

        // Mark as having popout and hide the sublist
        item.classList.add('has-popout');
        sublist.classList.add('popout-content');

        // Make the text before the sublist clickable
        item.addEventListener('click', (e) => {
          // Don't trigger if clicking inside the sublist or on a link
          if (e.target.closest('.popout-content') || e.target.tagName === 'A') return;
          e.preventDefault();
          e.stopPropagation();
          openPopout(item, sublist);
        });
      });

      // Close button
      popoutClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        closePopout();
      });

      // Click outside to close
      document.addEventListener('click', (e) => {
        if (popoutCard?.classList.contains('open') &&
            !popoutCard.contains(e.target) &&
            !e.target.closest('.has-popout')) {
          closePopout();
        }
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && popoutCard?.classList.contains('open')) {
          closePopout();
        }
      });

      // Handle all expandable sections
      const allExpandables = document.querySelectorAll('.category, .subcategory, .sub-subcategory');

      allExpandables.forEach(item => {
        const titleClass = item.classList.contains('category') ? '.category-title' :
                          item.classList.contains('subcategory') ? '.subcategory-title' :
                          '.sub-subcategory-title';
        const contentClass = item.classList.contains('category') ? '.category-content' :
                            item.classList.contains('subcategory') ? '.subcategory-content' :
                            '.sub-subcategory-content';

        const title = item.querySelector(titleClass);
        const content = item.querySelector(contentClass);

        if (!title || !content) return;

        // Remove existing listeners by cloning
        const newTitle = title.cloneNode(true);
        title.parentNode.replaceChild(newTitle, title);

        newTitle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = item.classList.contains('open');

          if (isOpen) {
            content.style.maxHeight = content.scrollHeight + 'px';
            requestAnimationFrame(() => {
              content.style.maxHeight = '0';
              content.style.opacity = '0';
            });
            item.classList.remove('open');
          } else {
            item.classList.add('open');
            content.style.maxHeight = content.scrollHeight + 'px';
            content.style.opacity = '1';

            content.addEventListener('transitionend', function handler() {
              if (item.classList.contains('open')) {
                content.style.maxHeight = 'none';
              }
              content.removeEventListener('transitionend', handler);
            });
          }
        });
      });
    }

    // Spotify player panel functionality
    // Store all items and panels globally for cross-section clearing
    let allMusicItems = [];
    let allPlayerPanels = [];

    function initSpotifyPanel() {
      // Reset the global arrays on each init
      allMusicItems = [];
      allPlayerPanels = [];

      // Handle Albums
      const albumsLayout = document.querySelector('.albums-layout');
      if (albumsLayout) {
        const panel = albumsLayout.querySelector('.player-panel');
        if (panel) allPlayerPanels.push(panel);
        initMusicSection(albumsLayout.querySelectorAll('.album-item'), panel, 'album');
      }

      // Handle Songs
      const songsPanel = document.querySelector('.songs-player');
      if (songsPanel) {
        allPlayerPanels.push(songsPanel);
        const songsLayout = songsPanel.closest('.music-layout');
        if (songsLayout) {
          initMusicSection(songsLayout.querySelectorAll('.track-item'), songsPanel, 'track');
        }
      }

      // Handle Solos
      const solosPanel = document.querySelector('.solos-player');
      if (solosPanel) {
        allPlayerPanels.push(solosPanel);
        const solosLayout = solosPanel.closest('.music-layout');
        if (solosLayout) {
          initMusicSection(solosLayout.querySelectorAll('.track-item'), solosPanel, 'track');
        }
      }

      // Add close button handlers
      document.querySelectorAll('.player-close').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          // Hide all panels and clear all active states
          allPlayerPanels.forEach(p => {
            p.setAttribute('hidden', '');
            p.querySelector('.player-embed').innerHTML = '';
          });
          allMusicItems.forEach(i => i.classList.remove('active'));
        });
      });
    }

    function initMusicSection(items, playerPanel, type) {
      if (!items || !items.length || !playerPanel) return;

      const playerEmbed = playerPanel.querySelector('.player-embed');
      if (!playerEmbed) return;

      // Add these items to global list
      items.forEach(item => allMusicItems.push(item));

      items.forEach(item => {
        // Skip if already initialized
        if (item.dataset.panelInit) return;
        item.dataset.panelInit = 'true';

        const spotifyId = item.dataset.spotifyId;
        const youtubeId = item.dataset.youtubeId;
        const service = item.dataset.service || (spotifyId ? 'spotify' : null);
        const itemType = item.dataset.type || type;

        // Make clickable if has any playable ID
        if (spotifyId || youtubeId) {
          item.classList.add('has-spotify');
        }

        item.addEventListener('click', (e) => {
          // Don't trigger on popout content clicks
          if (e.target.closest('.popout-content')) return;

          if (!spotifyId && !youtubeId) return;

          // Clear active state from ALL music sections
          allMusicItems.forEach(i => i.classList.remove('active'));
          item.classList.add('active');

          // Hide all other panels, then show this one
          allPlayerPanels.forEach(p => {
            if (p !== playerPanel) {
              p.setAttribute('hidden', '');
              p.querySelector('.player-embed').innerHTML = '';
            }
          });
          playerPanel.removeAttribute('hidden');

          // Create/update iframe based on service
          if (service === 'youtube' && youtubeId) {
            playerEmbed.innerHTML = `
              <iframe
                src="https://www.youtube.com/embed/${youtubeId}"
                width="100%"
                height="352"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                style="border-radius: 0;"
              ></iframe>
            `;
          } else if (spotifyId) {
            playerEmbed.innerHTML = `
              <iframe
                src="https://open.spotify.com/embed/${itemType}/${spotifyId}?utm_source=generator&theme=0"
                width="100%"
                height="352"
                frameborder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                style="border-radius: 0;"
              ></iframe>
            `;
          }
        });
      });
    }

    // Run on initial load and View Transitions
    document.addEventListener('astro:page-load', () => {
      initFavoriteThings();
      initSpotifyPanel();
    });
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initFavoriteThings();
        initSpotifyPanel();
      });
    } else {
      initFavoriteThings();
      initSpotifyPanel();
    }
  </script>
</Base>

