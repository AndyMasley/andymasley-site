<style>
  .page-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.9rem, 1.65rem + 0.5vw, 2.3rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 0.9rem 0;
    color: var(--text);
  }

  .intro {
    max-width: 38rem;
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.78;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .ai-music-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-music-list li {
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .ai-music-list a {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-editorial);
    font-size: 1.02rem;
    line-height: 1.45;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .ai-music-list a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
