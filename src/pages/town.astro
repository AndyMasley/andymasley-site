---
import Base from '../layouts/Base.astro';
import TownRadio from '../components/TownRadio.astro';
import buildingEvidence from '../../data/derived/town/residential-evidence-index.json';
import historicEvidence from '../../data/derived/town/historic-appearance.json';
import { EXPLORE_PLACES } from '../lib/town/explore-places';
import directory from '../../data/derived/town/place-directory.json';
import '../styles/town.css';

const poster = '/town-assets/webster-poster-cinematic.webp';
---

<Base
  title="Webster, Massachusetts"
  description="Take an unhurried drive through a reconstruction of Webster, Massachusetts. Follow the roads, choose your turns, and explore a New England mill town."
  ogImage={poster}
  ogImageAlt="A reconstruction of Main Street in Webster, with brick buildings, summer trees, and a teal car."
  ogImageWidth={1440}
  ogImageHeight={900}
  activeNav="/visuals"
>
  <article class="town-page" aria-labelledby="town-title">
    <header class="town-heading">
      <p class="town-eyebrow">A late-summer drive</p>
      <h1 id="town-title">Webster, Massachusetts</h1>
    </header>

    <section class="town-game town-wide" data-town-root aria-label="Interactive driving game">
      <div class="town-stage">
        <canvas
          class="town-canvas"
          data-town-canvas
          tabindex="0"
          role="application"
          aria-label="Drive through Webster"
          aria-describedby="town-controls-summary town-status"
        >
          This interactive town uses a 3D canvas. Its current road, speed, and turn choices are also shown as text.
        </canvas>

        <div class="town-intro" data-town-intro>
          <img
            class="town-poster"
            src={poster}
            width="1440"
            height="900"
            alt="Main Street in the driving game: a brick church and clocktower, leafy summer trees, and a teal car on the road."
            fetchpriority="high"
            decoding="async"
          />
          <div class="town-intro__content">
            <h2>Find your way through Webster</h2>
            <p>The car follows the road.<br />You choose where it goes.</p>
            <button class="town-play" type="button" data-town-play>
              <span>Play</span>
              <svg aria-hidden="true" width="24" height="18" viewBox="0 0 24 18" fill="none">
                <path d="M2 9h18M13 2l7 7-7 7" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
            <button class="town-resume-drive" type="button" data-town-resume hidden>Resume last drive</button>
            <button class="town-resume-drive" type="button" data-town-reload hidden>Reload updated game</button>
            <p data-town-resume-label hidden></p>
            <p class="town-intro__hint">Arrow keys or touch controls</p>
          </div>
          <span class="town-poster-caption">A late-summer drive through Webster</span>
        </div>

        <div class="town-loading" data-town-loading aria-live="off" hidden>
          Preparing the town…
        </div>

        <div class="town-hud" aria-label="Driving information">
          <div class="town-route">
            <span class="town-hud__label">On the road</span>
            <span class="town-road" data-town-road>Main Street</span>
          </div>
          <div class="town-directions">
            <p data-town-turn>Continue on Main Street</p>
            <div class="town-choices" data-town-choices role="group" aria-label="Available turns"></div>
            <button class="town-clear-turn" type="button" data-town-clear aria-keyshortcuts="S">Clear turn</button>
          </div>
          <div class="town-instruments" aria-label="Speed and distance">
            <div class="town-speed"><span data-town-speed>0</span><span class="town-unit">mph</span></div>
            <div class="town-road-limit"><span class="town-hud__label" data-town-limit-label>Road limit</span><span data-town-limit>25 mph</span></div>
            <div class="town-odometer"><span data-town-distance>0.0 mi</span><span class="town-hud__label">this drive</span></div>
            <span class="town-cruise-state" data-town-cruise>Stopped</span>
          </div>
          <figure class="town-map" aria-label="Local map">
            <canvas data-town-minimap width="360" height="360" aria-label="Your position, nearby roads, water and lettered places. Place names are listed in Explore Webster below."></canvas>
            <figcaption>Webster</figcaption>
          </figure>
        </div>

        <div class="town-recovery" data-town-recovery role="group" aria-label="Drive recovery" hidden>
          <p data-town-recovery-message></p>
          <button type="button" data-town-retry-street>Retry street</button>
          <button type="button" data-town-recovery-reverse>Turn around</button>
          <button type="button" data-town-restart hidden>Restart graphics</button>
          <button type="button" data-town-reload hidden>Reload updated game</button>
          <button type="button" data-town-dismiss-update hidden>Keep driving</button>
        </div>

        <div class="town-touch" aria-label="Touch driving controls">
          <div class="town-touch__turns">
            <button type="button" data-town-input="left" aria-label="Choose a left turn" aria-keyshortcuts="ArrowLeft"><span aria-hidden="true">←</span></button>
            <button type="button" data-town-input="right" aria-label="Choose a right turn" aria-keyshortcuts="ArrowRight"><span aria-hidden="true">→</span></button>
          </div>
          <div class="town-touch__pedals">
            <button type="button" data-town-input="down" aria-label="Brake" aria-keyshortcuts="ArrowDown"><span aria-hidden="true">↓</span><span class="town-touch__label">Brake</span></button>
            <button type="button" data-town-input="up" aria-label="Accelerate" aria-keyshortcuts="ArrowUp"><span aria-hidden="true">↑</span><span class="town-touch__label">Go</span></button>
          </div>
        </div>
      </div>

      <div class="town-toolbar">
        <div class="town-actions" aria-label="Game controls">
          <button type="button" data-town-pause aria-keyshortcuts="Space" disabled>Pause</button>
          <button type="button" data-town-reverse aria-keyshortcuts="R" disabled>Turn around</button>
          <button type="button" data-town-camera aria-keyshortcuts="C" disabled>Camera</button>
          <button type="button" data-town-sound aria-pressed="false" disabled>Engine sound off</button>
          <button type="button" data-town-fullscreen disabled>Full screen</button>
          <button type="button" data-town-mute aria-keyshortcuts="M">Mute all sound</button>
        </div>
        <div class="town-settings">
          <label class="town-setting">
            <span>Start near</span>
            <select data-town-location aria-label="Starting location">
              <option value="DOWNTOWN">Main Street</option>
              <option value="LAKE">Webster Lake</option>
              <option value="BEACH">Memorial Beach</option>
              <option value="RANCH">Indian Ranch</option>
              <option value="BARTLETT">Bartlett</option>
              <option value="SCHOOL">School Street</option>
            </select>
          </label>
          <label class="town-setting">
            <span>Detail</span>
            <select data-town-quality aria-label="Graphics detail">
              <option value="auto">Automatic</option>
              <option value="high">High</option>
              <option value="low">Low</option>
            </select>
          </label>
          <label class="town-setting">
            <span>Motion</span>
            <select data-town-comfort aria-label="Camera comfort">
              <option value="system">Use device preference</option>
              <option value="steady">Steady camera</option>
              <option value="standard">Standard camera</option>
            </select>
          </label>
          <label class="town-setting town-engine-volume"><span>Driving sound</span><input data-town-engine-volume aria-label="Driving sound volume" type="range" min="0" max="100" value="65" /></label>
        </div>
      </div>
      <details class="town-explore" data-town-explore>
        <summary>Explore Webster</summary>
        <div class="town-explore__body">
          <p>Choose a starting place, then take your own turns. Moving to another start resets this drive’s mileage; reloading offers your last saved road position, safely paused.</p>
          <canvas data-town-overview width="800" height="520" aria-label="Town overview showing roads, water and islands, six starting places and sixteen lettered places. All places are listed below."></canvas>
          <div class="town-explore__places">
            {EXPLORE_PLACES.map(place => <div><button type="button" data-town-place={place.key} disabled>{place.title}</button><p>{place.detail}</p></div>)}
          </div>
          <div class="town-directory">
            <h3>Places to look for</h3>
            <p>Select a place to see its part of town. These markers show scenery; use the six starting places above to move the car.</p>
            <p data-town-directory-info role="status" aria-live="polite">Scenery markers come from the game’s building, bridge and shoreline research. Nearby roads are references, not turn-by-turn directions.</p>
            <button type="button" data-town-directory-reset disabled>Show whole town</button>
            <div class="town-directory__list">
              {directory.places.map(place => <div><button type="button" data-town-directory-place={place.id} aria-pressed="false" disabled>{place.label}. {place.title}</button><p>Near {place.nearRoad}. {place.detail}</p></div>)}
            </div>
          </div>
          <p class="town-explore__policy">An unhurried guided drive: cruise does not simulate traffic or enforce stops. Turn around is an instant game assist. Some routes stop at the edge of the mapped town.</p>
          <button type="button" data-town-report disabled>Report this spot</button>
          <div data-town-report-panel hidden>
            <label>Your note <textarea data-town-report-note rows="2" placeholder="What should be different here?"></textarea></label>
            <button type="button" data-town-report-copy>Copy location and note</button>
            <textarea data-town-report-output aria-label="Copyable location report" readonly rows="6"></textarea>
            <p>This copies a local text report. Nothing is sent automatically.</p>
          </div>
        </div>
      </details>
      <TownRadio />
      <div class="town-below-game">
        <p id="town-status" class="town-status" data-town-status role="status" aria-live="polite">Ready when you are.</p>
        <details class="town-help">
          <summary>How to drive</summary>
          <div class="town-help__content" id="town-controls-summary">
            <dl class="town-key-list">
              <div><dt><kbd>↑</kbd> <kbd>↓</kbd></dt><dd>Cruise at the road limit / brake</dd></div>
              <div><dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Choose a turn at a junction</dd></div>
              <div><dt><kbd>Space</kbd></dt><dd>Pause / resume</dd></div>
              <div><dt><kbd>R</kbd></dt><dd>Instantly turn around</dd></div>
              <div><dt><kbd>C</kbd></dt><dd>Change camera</dd></div>
              <div><dt><kbd>S</kbd></dt><dd>Clear a pending turn and follow the road where possible</dd></div>
              <div><dt><kbd>M</kbd></dt><dd>Silence all driving sound and radio</dd></div>
              <div><dt><kbd>1</kbd>–<kbd>6</kbd></dt><dd>Move to the corresponding starting place; resets this drive</dd></div>
          </dl>
            <p>The car stays on the road. Press Up to accelerate smoothly to the road’s speed limit, including 65 mph on I-395. On entrance ramps, speed builds gradually toward the highway limit before merging. Pick a direction as you approach a junction, or click a labeled road option to select that exact branch. Turn around instantly with the button or R. On a touch screen, use the arrows below the road.</p>
            <p>Click the town view to use the keyboard. Tab leaves the driving view for the controls. Leaving the game pauses the drive. Use Resume or Up to continue. Braking reduces your cruise target; press Up again to return to the road limit. Once a turn begins, a new choice applies to the following junction.</p>
            <p>Sound starts only if you turn it on. Pause stops driving sound and leaves the radio available; M or Mute all sound silences both. Radio turns off when you leave the tab. The road limit may be an estimate where the road inventory has no posted value; a ramp target is modeled acceleration toward the highway limit.</p>
            <p>Automatic detail can reduce resolution and shadows to keep the drive responsive. Choose a detail setting again to restore its starting quality. The saved camera, comfort, detail and volume settings return on your next visit; sound still starts off.</p>
          </div>
        </details>
      </div>
      <noscript><p class="town-noscript">JavaScript is needed to drive. The image above shows the town reconstruction.</p></noscript>
    </section>

    <div class="town-endmatter">
      <p class="town-note">A reconstruction of a real place, with room for interpretation.</p>
      <details class="town-sources">
        <summary>About the town and its sources</summary>
        <div class="town-sources__content">
          <p>This town combines mapped roads, building footprints, aerial imagery, and lidar with modeled architecture and vegetation. Its summer palette, materials and light are designed to capture Webster’s character as a driving game.</p>
          <dl class="town-source-list">
            <div><dt>The ground and buildings</dt><dd>MassGIS mapping and spring 2025 aerial imagery establish the town’s layout. USGS lidar collected in 2021 supplies much of its height and roof information.</dd></div>
            <div><dt>The streets</dt><dd>The driving network follows mapped roads, with MassDOT road information informing their appearance. The car follows a guided path with simplified turns. Classified lidar returns establish the Main Street bridge deck height; bridge structures combine published span and construction records with modeled finishes. Railroad-crossing gates and light masts follow the federal inventory, with authored hardware placement.</dd></div>
            <div><dt>The architecture</dt><dd>{buildingEvidence.count.toLocaleString('en-US')} residential profiles use mapped footprints, assessor styles, story counts and elevation evidence. Dated property descriptions inform {buildingEvidence.documentedCount} of those homes; historical inventory descriptions guide materials and frontage treatments for {historicEvidence.count} profiles. Sacred Heart, First Baptist, St. Louis, St. Joseph, Reconciliation, the Kelly Library, the Samuel Slater Experience and the fire station have individually composed building forms. Town Hall and the former school have source-fitted window bays and pale trim. The schools, police and post office use separately composed masses and entrances. Main Street blocks and mill façades use dated architectural records, parcel divisions and roof evidence; ordinary shops and garages have inferred storefront details. Selected landmarks and eleven School Street properties also use public exterior photographs. Roof shapes, opening dimensions, hidden elevations and unrecorded finishes remain interpretations. Historic descriptions and older paint colors are references; present appearance may differ.</dd></div>
            <div><dt>The season</dt><dd>Late-summer grass, foliage, light, and finishes are artistic choices. MassGIS 2016 land cover distinguishes lawns, woods, and paved areas, with mapped roads, buildings, and water refining their boundaries. Woodland forms vary with mapped evergreen, deciduous and wetland habitats; individual tree species are not surveyed. Grass beneath trees near homes is inferred as lawn. Sources come from different dates, so some buildings and streets may differ from Webster today.</dd></div>
            <div><dt>Parking and ground finishes</dt><dd>Reviewed OpenStreetMap outlines and spring 2025 MassGIS aerial views refine paved lots and selected driveways. Parking bay layouts are composed for the game within those boundaries; they do not reproduce surveyed stall counts or accessible-space assignments. Continuous road markings, pavement edges and woodland-floor materials include modeled finishing choices.</dd></div>
            <div><dt>Bridges, memorials and shorelines</dt><dd>Historical surveys guide Memorial Beach’s iron truss and sidewalk posts. The Court of Honor, lawn howitzers, relocated Slater markers and other public memorials use dated records and photographs; small dimensions and placements remain interpretations. Cemetery stones, shoreline plants and dam fragments sit within mapped settings, with anonymous layouts and inferred details. Memorial Beach has its documented double launch and 65-foot flagpole; the DCR Lakeside launch has a single concrete strip with a locally registered water edge. The Indian Princess uses its photographed two-deck riverboat appearance and a berth visible in 2025 imagery; it is a stationary interpretation.</dd></div>
            <div><dt>Roadside details</dt><dd>WRTA boarding-stop coordinates locate bus flags; OpenStreetMap records locate collection boxes and stop controls. Flag and box designs, sign offsets and pole hardware are modeled interpretations. Selected overhead utility runs follow photographed corridor character, with inferred spacing and placement; they are not a surveyed utility map. Matched road-inventory segments distinguish earth, gravel and surface-treated pavement using inferred material tones. The Gore Road plaza’s lake-name sign uses a dated exterior reference. Playing fields and solar-site boundaries receive restrained inferred equipment. Nine aerial-registered wastewater basins preserve the surrounding real buildings; rails and small dimensions are authored.</dd></div>
          </dl>
          <p>Architectural notes and selected public exterior images guide the modeled buildings. Materials include public-domain textures from Poly Haven and ambientCG. This is an exploratory driving game with no traffic simulation.</p>
          <p class="town-source-links"><a href="https://www.mass.gov/orgs/massgis-bureau-of-geographic-information">MassGIS</a><span aria-hidden="true"> · </span><a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a><span aria-hidden="true"> · </span><a href="https://www.usgs.gov/3d-elevation-program">USGS 3D Elevation Program</a><span aria-hidden="true"> · </span><a href="https://www.mass.gov/orgs/massachusetts-department-of-transportation">MassDOT</a><span aria-hidden="true"> · </span><a href="https://mhc-macris.net/">Massachusetts historical inventory</a><span aria-hidden="true"> · </span><a href="https://tile.loc.gov/storage-services/master/pnp/habshaer/ma/ma1400/ma1417/data/ma1417data.pdf">Historic American Engineering Record</a><span aria-hidden="true"> · </span><a href="https://railroads.dot.gov/safety-data/fra-safety-data-reporting/crossing-inventory-data-search">Railroad crossing inventory</a><span aria-hidden="true"> · </span><a href="https://therta.com/routes/">WRTA</a><span aria-hidden="true"> · </span><a href="https://polyhaven.com/license">Poly Haven license</a><span aria-hidden="true"> · </span><a href="https://docs.ambientcg.com/license/">ambientCG license</a></p>
        </div>
      </details>
    </div>
  </article>
</Base>

<script>
  import { mountTownRadio } from '../lib/town/radio';
  import { readSnapshot } from '../lib/town/ux-state';
  import { displayRoadName } from '../lib/town/road-display';
  import release from '../../data/derived/town/release.json';
  import { checkTownUpdate } from '../lib/town/release-recovery';
  let pageCleanup: (() => void) | undefined;
  let preparedRoot: HTMLElement | null = null;

  function prepareTownPage() {
    const root = document.querySelector<HTMLElement>('[data-town-root]');
    // Initial setup runs before window load. A slow poster can delay Astro's
    // page-load until after Play starts importing; do not abort that same root.
    if (root === preparedRoot) return;
    pageCleanup?.();
    pageCleanup = undefined;
    preparedRoot = null;
    if (!root) return;
    const play = root.querySelector<HTMLButtonElement>('[data-town-play]')!;
    const status = root.querySelector<HTMLElement>('[data-town-status]')!;
    const quality = root.querySelector<HTMLSelectElement>('[data-town-quality]')!;
    const resume = root.querySelector<HTMLButtonElement>('[data-town-resume]')!;
    const resumeLabel = root.querySelector<HTMLElement>('[data-town-resume-label]')!;
    const controller = new AbortController();
    const radio = mountTownRadio(root);
    let session: { dispose(): void } | undefined;
    let starting = false;
    try {
      const saved = localStorage.getItem('webster-quality');
      if (saved && ['auto', 'high', 'low'].includes(saved)) quality.value = saved;
      const snapshot = readSnapshot(release.manifestSha256, localStorage);
      if (snapshot) { resume.hidden = false; resumeLabel.hidden = false; resumeLabel.textContent = `Last drive: ${displayRoadName(snapshot.road)} · resumes paused`; }
    } catch {}
    const begin = async (resumeDrive = false) => {
      if (starting || session) return;
      starting = true;
      root.dataset.resumeDrive = String(resumeDrive);
      play.disabled = true;
      resume.disabled = true;
      play.textContent = 'Loading…';
      root.setAttribute('aria-busy', 'true');
      status.textContent = 'Preparing your drive…';
      try {
        const { startTown } = await import('../lib/town/main');
        if (controller.signal.aborted || !root.isConnected) return;
        const current = await startTown(root);
        if (controller.signal.aborted) current.dispose();
        else session = current;
      } catch (error) {
        if (!controller.signal.aborted) {
          status.textContent = error instanceof Error ? error.message : 'The drive could not start. Please try again.';
          play.disabled = false;
          play.textContent = 'Try again';
          resume.disabled = false;
          root.removeAttribute('aria-busy');
          void checkTownUpdate(controller.signal).then(update => {
            if (controller.signal.aborted || session || starting || update !== 'new') return;
            root.querySelectorAll<HTMLButtonElement>('[data-town-intro] [data-town-reload]').forEach(button => { button.hidden = false; });
            status.textContent = 'A newer town is available. Reload updated game, or try this version again.';
          });
        }
      } finally { starting = false; }
    };
    play.addEventListener('click', () => void begin(false), { signal: controller.signal });
    resume.addEventListener('click', () => void begin(true), { signal: controller.signal });
    root.querySelector('[data-town-mute]')!.addEventListener('click', () => root.dispatchEvent(new Event('town:mute')), { signal: controller.signal });
    for (const button of root.querySelectorAll('[data-town-reload]')) button.addEventListener('click', () => {
      root.dispatchEvent(new Event('town:pause')); root.dispatchEvent(new Event('town:mute')); session?.dispose(); location.reload();
    }, { signal: controller.signal });
    root.addEventListener('town:restart', () => {
      if (starting) return;
      root.dispatchEvent(new Event('town:mute'));
      session?.dispose(); session = undefined;
      // A lost WebGL context cannot always be reacquired on the same canvas.
      const old = root.querySelector<HTMLCanvasElement>('[data-town-canvas]')!;
      old.replaceWith(old.cloneNode(false));
      root.querySelector<HTMLElement>('[data-town-intro]')!.hidden = false;
      root.querySelector<HTMLElement>('[data-town-recovery]')!.hidden = true;
      void begin(true);
    }, { signal: controller.signal });
    pageCleanup = () => { controller.abort(); radio.dispose(); session?.dispose(); };
    preparedRoot = root;
  }

  document.addEventListener('astro:page-load', prepareTownPage);
  document.addEventListener('astro:before-swap', () => { pageCleanup?.(); pageCleanup = undefined; preparedRoot = null; });
  prepareTownPage();
</script>
