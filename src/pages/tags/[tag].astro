---
import Base from '@/layouts/Base.astro';
import { getOptionalCollection } from '@/lib/optional-collection';

export async function getStaticPaths() {
  const writing = await getOptionalCollection('writing');
  const notes = await getOptionalCollection('notes');

  // Collect all unique tags
  const allTags = new Set<string>();
  [...writing, ...notes].forEach(item => {
    item.data.tags.forEach(tag => allTags.add(tag));
  });

  return [...allTags].map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

// Get all content with this tag
const writing = await getOptionalCollection('writing', ({ data }) => !data.draft && data.tags.includes(tag));
const notes = await getOptionalCollection('notes', ({ data }) => !data.draft && data.tags.includes(tag));

// Combine and sort by date
const allItems = [
  ...writing.map(item => ({ ...item, type: 'writing', url: `/writing/${item.slug}` })),
  ...notes.map(item => ({ ...item, type: 'notes', url: `/notes/${item.slug}` })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}
---

<Base title={`#${tag}`} description={`All content tagged "${tag}"`}>
  <div class="container container--wide">
    <header class="page-header">
      <h1 class="page-header__title">#{tag}</h1>
      <p class="page-header__subtitle">
        {allItems.length} item{allItems.length === 1 ? '' : 's'}
      </p>
    </header>

    <ul class="content-list stagger-in">
      {allItems.map(item => (
        <li class="content-item">
          <a href={item.url} class="content-item__link">
            <div class="content-item__header">
              <span class="content-type">{item.type}</span>
              <h3 class="content-item__title">{item.data.title}</h3>
            </div>
            <div class="content-item__meta">
              <span>{formatDate(item.data.date)}</span>
            </div>
            {item.data.description && (
              <p class="content-item__description">{item.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .content-item__header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  
  .content-type {
    font-size: var(--font-size-mono);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: none;
    padding: 0 0 1px;
    border-bottom: 1px solid var(--accent);
    border-radius: 0;
    flex-shrink: 0;
  }
</style>
