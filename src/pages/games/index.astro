---
import SectionPage from '@/layouts/SectionPage.astro';
import { games } from '@/data/games';
---

<SectionPage
  title="Games"
  description="Games that play in the browser, on a computer or a phone."
  ogImage="/og/page/games.png?v=4"
>
  <ul class="annotated-list">
    {games.map(g => (
      <li class="annotated-list__item">
        <div class="annotated-list__row">
          {/* each game is its own full-screen page, outside the site's page transitions */}
          <a href={g.href} class="annotated-list__title" data-astro-reload>{g.title}</a>
        </div>
        <p class="annotated-list__note">{g.description}</p>
      </li>
    ))}
  </ul>
</SectionPage>
