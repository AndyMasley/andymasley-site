---
import Base from '@/layouts/Base.astro';
import { fetchPostContent, processPostContent } from '@/lib/substack';
import { CheatSheetExplorer } from '@/components/CheatSheetExplorer';

const slug = 'a-cheat-sheet-for-conversations-about';
const rawContent = await fetchPostContent(slug);
const htmlContent = processPostContent(rawContent, slug);

const text = htmlContent.replace(/<[^>]*>/g, '');
const wordCount = text.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);
---

<Base
  title="A cheat sheet for conversations about ChatGPT's environmental impact"
  description="Every environmental objection to using ChatGPT, answered with data and sources."
>
  <div class="cheat-sheet-page">
    <p class="originally-on">
      Navigable version of the <a href="/writing/a-cheat-sheet-for-conversations-about">original article</a>
    </p>

    <header class="article-header">
      <h1 class="article-header__title">A cheat sheet for conversations about ChatGPT's environmental impact</h1>
      <div class="article-header__meta">
        <span>01.06.2025</span>
        <span>{readingTime} min read</span>
        <span>{Math.round(wordCount / 1000)}k words</span>
      </div>
    </header>

    <CheatSheetExplorer client:load html={htmlContent} />

    <footer class="article-footer">
      <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
    </footer>
  </div>
</Base>

<style>
  /* ═══ Page wrapper ═══ */
  .cheat-sheet-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  /* ═══ Header ═══ */
  .originally-on {
    font-size: 0.78rem;
    color: var(--dim);
    margin-bottom: var(--space-sm);
  }
  .originally-on a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
  .article-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }
  .article-header__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }
  @media (max-width: 600px) {
    .article-header__title { font-size: 1.5rem; }
  }
  .article-header__meta {
    display: flex;
    gap: var(--space-md);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--dim);
  }
  .article-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
  .article-nav__link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* ═══ Top progress bar ═══ */
  :global(.cse-progress-bar) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }
  :global(.cse-progress-fill) {
    height: 100%;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  /* ═══ Mobile toggle ═══ */
  :global(.cse-mobile-toggle) {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1px;
    transition: transform var(--transition-fast);
  }
  :global(.cse-mobile-toggle:active) {
    transform: scale(0.92);
  }
  :global(.cse-mobile-pct) {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
  @media (max-width: 900px) {
    :global(.cse-mobile-toggle) { display: flex; }
  }
  @media (min-width: 901px) {
    :global(.cse-mobile-toggle) { display: none !important; }
  }

  /* ═══ Two-column layout ═══ */
  :global(.cse-layout) {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  @media (max-width: 900px) {
    :global(.cse-layout) {
      grid-template-columns: 1fr;
    }
  }

  /* ═══ Sidebar ═══ */
  :global(.cse-sidebar) {
    position: sticky;
    top: 16px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 16px;
    -webkit-overflow-scrolling: touch;
  }
  :global(.cse-sidebar::-webkit-scrollbar) { width: 2px; }
  :global(.cse-sidebar::-webkit-scrollbar-thumb) { background: var(--border); border-radius: 2px; }
  :global(.cse-sidebar::-webkit-scrollbar-track) { background: transparent; }

  @media (max-width: 900px) {
    :global(.cse-sidebar) {
      display: none;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      max-height: 100vh !important;
      background: var(--bg) !important;
      padding: 24px !important;
      z-index: 998 !important;
      overflow-y: auto !important;
    }
    :global(.cse-sidebar.cse-sidebar--open) {
      display: block;
    }
  }

  :global(.cse-sidebar__header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text);
    padding-bottom: 6px;
    margin-bottom: 4px;
  }
  :global(.cse-sidebar__pct) {
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  :global(.cse-sidebar__progress) {
    height: 2px;
    background: var(--border);
    border-radius: 1px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  :global(.cse-sidebar__progress-fill) {
    height: 100%;
    background: var(--accent);
    border-radius: 1px;
    transition: width 0.1s linear;
  }

  :global(.cse-sidebar__entries) {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  :global(.cse-sidebar__item) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    width: 100%;
    text-align: left;
    padding: 4px 6px;
    border: none;
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--dim);
    line-height: 1.35;
    transition: color 0.1s, background 0.1s;
    /* Two-line clamp */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.cse-sidebar__item:hover) {
    color: var(--text);
    background: rgba(0,0,0,0.02);
  }
  :global(.cse-sidebar__item--active) {
    color: var(--accent) !important;
    font-weight: 600 !important;
    background: var(--accent-subtle);
  }
  :global(.cse-sidebar__item--active .cse-sidebar__dot) {
    background: var(--accent);
  }
  :global(.cse-sidebar__item--open) {
    color: var(--text);
    font-weight: 500;
  }

  :global(.cse-sidebar__dot) {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
    position: relative;
    top: -1px;
  }

  :global(.cse-sidebar__actions) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  :global(.cse-sidebar__action) {
    font-size: 0.62rem;
    color: var(--dim);
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
    transition: color 0.1s;
  }
  :global(.cse-sidebar__action:hover) {
    color: var(--accent);
  }
  :global(.cse-sidebar__action-sep) {
    font-size: 0.55rem;
    color: var(--border);
  }

  :global(.cse-sidebar__back) {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  :global(.cse-sidebar__back a) {
    font-size: 0.65rem;
    color: var(--dim);
    text-decoration: none;
  }
  :global(.cse-sidebar__back a:hover) {
    color: var(--accent);
    text-decoration: underline;
  }
  :global(.cse-sidebar__count) {
    font-size: 0.55rem;
    color: var(--dim);
    background: rgba(0,0,0,0.04);
    padding: 1px 5px;
    border-radius: 6px;
    flex-shrink: 0;
    margin-left: auto;
  }
  :global(.cse-sidebar__subs) {
    padding-left: 16px;
    margin-left: 8px;
    border-left: 1px solid var(--border);
    margin-bottom: 4px;
  }
  :global(.cse-sidebar__subitem) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 2px 6px;
    border: none;
    border-radius: 2px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.6rem;
    color: var(--dim);
    line-height: 1.3;
    transition: color 0.1s;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  :global(.cse-sidebar__subitem:hover) {
    color: var(--text);
  }
  :global(.cse-sidebar__subitem--open) {
    color: var(--accent);
    font-weight: 500;
  }

  /* Mobile sidebar scaling */
  @media (max-width: 900px) {
    :global(.cse-sidebar__header) { font-size: 1rem; padding-bottom: 10px; margin-bottom: 8px; }
    :global(.cse-sidebar__pct) { font-size: 0.85rem; }
    :global(.cse-sidebar__item) { font-size: 0.9rem; padding: 6px 8px; }
    :global(.cse-sidebar__action) { font-size: 0.8rem; }
    :global(.cse-sidebar__back a) { font-size: 0.85rem; }
  }

  /* ═══ Content area ═══ */
  :global(.cse-content) {
    min-width: 0; /* prevent grid blowout */
    max-width: 700px;
  }

  /* ═══ Back to top ═══ */
  :global(.cse-back-to-top) {
    position: fixed;
    bottom: 76px;
    right: 20px;
    z-index: 998;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--dim);
    border: 1px solid var(--border);
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: color 0.1s, border-color 0.1s;
  }
  :global(.cse-back-to-top:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ═══ Intro ═══ */
  :global(.cse-intro) {
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: rgba(0,0,0,0.02);
    border-radius: 6px;
    border-left: 3px solid var(--accent);
  }

  /* ═══ Controls bar ═══ */
  :global(.cse-controls) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) 0;
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }
  :global(.cse-controls__label) {
    font-size: 0.75rem;
    color: var(--dim);
    font-family: var(--font-mono);
  }
  :global(.cse-controls__buttons) {
    display: flex;
    gap: var(--space-sm);
  }
  :global(.cse-controls__btn) {
    font-size: 0.72rem;
    color: var(--dim);
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 10px;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  :global(.cse-controls__btn:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ═══ Chevron ═══ */
  :global(.cse-chevron) {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  :global(.cse-chevron--open) {
    transform: rotate(90deg);
  }

  /* ═══ Section (h1-level) ═══ */
  :global(.cse-section) {
    border-bottom: 1px solid var(--border);
  }
  :global(.cse-section:last-child) {
    border-bottom: none;
  }
  :global(.cse-section--open) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    margin-left: -3px;
  }

  :global(.cse-section__header) {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    text-align: left;
    padding: var(--space-md) 0;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--transition-fast);
  }
  :global(.cse-section__header:hover) {
    color: var(--accent);
  }
  :global(.cse-section__title) {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    flex: 1;
  }
  :global(.cse-section__header:hover .cse-section__title) {
    color: var(--accent);
  }
  :global(.cse-section__badges) {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  :global(.cse-badge) {
    font-size: 0.6rem;
    color: var(--dim);
    background: rgba(0,0,0,0.04);
    padding: 2px 6px;
    border-radius: 8px;
    font-weight: 500;
    white-space: nowrap;
  }
  :global(.cse-section__preview) {
    font-size: 0.82rem;
    color: var(--dim);
    line-height: 1.5;
    padding: 0 0 var(--space-md) 28px;
    opacity: 0.7;
  }

  :global(.cse-section__body) {
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  :global(.cse-section__inner) {
    padding-bottom: var(--space-md);
  }
  :global(.cse-section__intro) {
    margin-bottom: var(--space-md);
  }

  /* ═══ Subsection (h2-level) ═══ */
  :global(.cse-subsection) {
    margin-left: var(--space-sm);
    border-left: 1px solid var(--border);
    padding-left: var(--space-md);
    margin-bottom: 2px;
  }
  :global(.cse-subsection--open) {
    border-left-color: var(--accent);
  }

  :global(.cse-subsection__meta) {
    font-size: 0.58rem;
    color: var(--dim);
    flex-shrink: 0;
    opacity: 0.7;
    margin-left: auto;
  }

  :global(.cse-subsection__header) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: var(--space-sm) 0;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--transition-fast);
  }
  :global(.cse-subsection__header:hover) {
    color: var(--accent);
  }
  :global(.cse-subsection__title) {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }
  :global(.cse-subsection__header:hover .cse-subsection__title) {
    color: var(--accent);
  }

  :global(.cse-subsection__body) {
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  :global(.cse-subsection__content) {
    padding-bottom: var(--space-sm);
  }

  /* ═══ Prose (content styling) ═══ */
  :global(.prose img) { max-width: 100%; height: auto; margin: var(--space-lg) 0; }
  :global(.prose figure) { margin: var(--space-lg) 0; }
  :global(.prose figcaption) { font-size: 0.8125rem; color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  :global(.prose blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    color: var(--dim);
    font-style: italic;
  }
  :global(.prose a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3) {
    /* Headings inside prose are already handled by the section structure,
       but in case any remain (e.g. h3s), style them */
    scroll-margin-top: 20px;
    color: var(--text);
  }
  :global(.prose h3) {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  :global(.prose p) { margin-bottom: var(--space-md); }
  :global(.prose ul),
  :global(.prose ol) { margin-bottom: var(--space-md); padding-left: var(--space-lg); }
  :global(.prose li) { margin-bottom: var(--space-sm); }

  /* Substack-specific */
  :global(.prose .image-link),
  :global(.prose .image2) { display: block; margin: var(--space-lg) 0; }
  :global(.prose .image-link img),
  :global(.prose .image2 img) { max-width: 100%; height: auto; }
  :global(.prose .captioned-image-container) { margin: var(--space-lg) 0; }
  :global(.prose .image-caption) { font-size: 0.8125rem; color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  :global(.prose .subscription-widget-wrap),
  :global(.prose .subscribe-widget),
  :global(.prose .subscription-widget),
  :global(.prose .image-link-expand),
  :global(.prose .icon-container) { display: none !important; }
  :global(.prose .footnote-anchor) { font-size: 0.7em; vertical-align: super; line-height: 0; text-decoration: none; color: var(--accent); }
  :global(.prose .footnote-anchor:hover) { text-decoration: underline; }
  :global(.prose .footnotes),
  :global(.prose .footnote) {
    font-size: 0.8125rem;
    color: var(--dim);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }
  :global(.prose .footnote .footnote-number) { font-size: 0.85em; margin-right: var(--space-sm); color: var(--accent); text-decoration: none; }
  :global(.prose pre) { background: var(--border); padding: var(--space-md); border-radius: 4px; overflow-x: auto; font-family: var(--font-mono); font-size: 0.8125rem; }
  :global(.prose code) { font-family: var(--font-mono); font-size: 0.8125rem; background: var(--border); padding: 0.1em 0.3em; border-radius: 2px; }
  :global(.prose pre code) { background: none; padding: 0; }
</style>
