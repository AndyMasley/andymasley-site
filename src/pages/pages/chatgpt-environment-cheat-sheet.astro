---
import Base from '@/layouts/Base.astro';
import { fetchPostContent, processPostContent } from '@/lib/substack';
import { CheatSheetExplorer } from '@/components/CheatSheetExplorer';

const slug = 'a-cheat-sheet-for-conversations-about';
const rawContent = await fetchPostContent(slug);
const htmlContent = processPostContent(rawContent, slug);

const text = htmlContent.replace(/<[^>]*>/g, '');
const wordCount = text.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);
---

<Base
  title="A cheat sheet for conversations about ChatGPT's environmental impact"
  description="Every environmental objection to using ChatGPT, answered with data and sources."
>
  <div class="cheat-sheet-page">
    <p class="originally-on">
      Navigable version of the <a href="/writing/a-cheat-sheet-for-conversations-about">original article</a>
    </p>

    <header class="article-header">
      <h1 class="article-header__title">A cheat sheet for conversations about ChatGPT's environmental impact</h1>
      <div class="article-header__meta">
        <span>01.06.2025</span>
        <span>{readingTime} min read</span>
        <span>{Math.round(wordCount / 1000)}k words</span>
      </div>
    </header>

    <CheatSheetExplorer client:load html={htmlContent} />

    <footer class="article-footer">
      <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
    </footer>
  </div>
</Base>

<style>
  /* Override the Base layout's narrow container */
  :global(.main-content:has(.cheat-sheet-page)) {
    max-width: 1200px;
    padding-left: 32px;
    padding-right: 32px;
    animation: expandContainer 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes expandContainer {
    from { max-width: 640px; }
    to   { max-width: 1200px; }
  }

  /* ═══ Page wrapper ═══ */
  .cheat-sheet-page {
    max-width: 100%;
  }

  .cheat-sheet-page .originally-on,
  .cheat-sheet-page .article-header,
  .cheat-sheet-page :global(.cse-layout) {
    animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .cheat-sheet-page .originally-on { animation-delay: 0.15s; }
  .cheat-sheet-page .article-header { animation-delay: 0.25s; }
  .cheat-sheet-page :global(.cse-layout) { animation-delay: 0.4s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ═══ Header ═══ */
  .originally-on {
    font-size: 0.78rem;
    color: var(--dim);
    margin-bottom: var(--space-sm);
  }
  .originally-on a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
  .article-header {
    margin-bottom: var(--space-xl);
  }
  .article-header__title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
  }
  @media (max-width: 600px) {
    .article-header__title { font-size: 1.75rem; }
  }
  .article-header__meta {
    display: flex;
    gap: var(--space-md);
    font-size: var(--font-size-mono);
    font-family: var(--font-mono);
    color: var(--dim);
  }
  .article-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
  .article-nav__link {
    font-size: var(--font-size-ui);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* ═══ Progress bar ═══ */
  :global(.cse-progress-bar) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }
  :global(.cse-progress-fill) {
    height: 100%;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  /* ═══ Two-column layout ═══ */
  :global(.cse-layout) {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    :global(.cse-layout) {
      grid-template-columns: 1fr;
    }
  }

  /* ═══ Sidebar ═══ */
  :global(.cse-sidebar) {
    position: sticky;
    top: 16px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 16px;
    -webkit-overflow-scrolling: touch;
  }
  :global(.cse-sidebar::-webkit-scrollbar) { width: 2px; }
  :global(.cse-sidebar::-webkit-scrollbar-thumb) { background: var(--border); border-radius: 2px; }
  :global(.cse-sidebar::-webkit-scrollbar-track) { background: transparent; }

  @media (max-width: 900px) {
    :global(.cse-sidebar) {
      display: none;
    }
  }

  :global(.cse-sidebar__header) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }

  :global(.cse-sidebar__entries) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.cse-sidebar__group) {
    margin-bottom: 2px;
  }

  :global(.cse-sidebar__section) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 5px 8px;
    border: none;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
    transition: color 0.1s, background 0.1s;
  }
  :global(.cse-sidebar__section:hover) {
    background: var(--accent-subtle);
    color: var(--accent);
  }
  :global(.cse-sidebar__section--active) {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  :global(.cse-sidebar__subs) {
    padding-left: 12px;
    margin-left: 6px;
    border-left: 1px solid var(--border);
    margin-bottom: 6px;
  }

  :global(.cse-sidebar__sub) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 3px 6px;
    border: none;
    border-radius: 2px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.62rem;
    color: var(--dim);
    line-height: 1.35;
    transition: color 0.1s;
  }
  :global(.cse-sidebar__sub:hover) {
    color: var(--text);
  }
  :global(.cse-sidebar__sub--active) {
    color: var(--accent);
    font-weight: 600;
  }
  :global(.cse-sidebar__subs .cse-sidebar__sub--active) {
    border-left: none;
  }

  :global(.cse-sidebar__back) {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  :global(.cse-sidebar__back a) {
    font-size: 0.65rem;
    color: var(--dim);
    text-decoration: none;
  }
  :global(.cse-sidebar__back a:hover) {
    color: var(--accent);
    text-decoration: underline;
  }

  /* ═══ Content area ═══ */
  :global(.cse-content) {
    min-width: 0;
    max-width: 780px;
  }

  /* ═══ Intro block ═══ */
  :global(.cse-intro) {
    margin-bottom: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background: var(--accent-subtle);
    border-radius: 8px;
    border-left: 4px solid var(--accent);
  }

  /* ═══ Section (h1-level) ═══ */
  :global(.cse-section) {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 24px;
  }

  :global(.cse-section__label) {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 6px;
    font-family: var(--font-mono);
  }

  :global(.cse-section__title) {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--accent);
  }
  @media (max-width: 600px) {
    :global(.cse-section__title) { font-size: 1.35rem; }
  }

  :global(.cse-section__intro) {
    margin-bottom: var(--space-lg);
  }

  /* ═══ Arguments container ═══ */
  :global(.cse-section__arguments) {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ═══ Individual argument (h2-level) — the key scannable unit ═══ */
  :global(.cse-argument) {
    position: relative;
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    scroll-margin-top: 24px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global(.cse-argument:hover) {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  :global(.cse-argument__number) {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--dim);
    opacity: 0.5;
  }

  :global(.cse-argument__title) {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--accent);
    margin-bottom: var(--space-md);
    padding-right: 2.5rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-subtle);
  }
  @media (max-width: 600px) {
    :global(.cse-argument__title) { font-size: 1rem; }
  }

  :global(.cse-argument__body) {
    font-size: var(--font-size-base);
    line-height: 1.7;
  }

  /* ═══ Back to top ═══ */
  :global(.cse-back-to-top) {
    position: fixed;
    bottom: 76px;
    right: 20px;
    z-index: 998;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--dim);
    border: 1px solid var(--border);
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: color 0.1s, border-color 0.1s;
  }
  :global(.cse-back-to-top:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ═══ Mobile toggle ═══ */
  :global(.cse-mobile-toggle) {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1px;
    transition: transform var(--transition-fast);
  }
  :global(.cse-mobile-toggle:active) {
    transform: scale(0.92);
  }
  :global(.cse-mobile-pct) {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
  @media (max-width: 900px) {
    :global(.cse-mobile-toggle) { display: flex; }
  }
  @media (min-width: 901px) {
    :global(.cse-mobile-toggle) { display: none !important; }
  }

  /* ═══ Mobile TOC overlay ═══ */
  :global(.cse-mobile-overlay) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  :global(.cse-mobile-toc) {
    background: var(--bg);
    border-radius: 16px 16px 0 0;
    width: 100%;
    max-height: 80vh;
    overflow-y: auto;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    -webkit-overflow-scrolling: touch;
  }

  :global(.cse-mobile-toc__header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }

  :global(.cse-mobile-toc__close) {
    background: none;
    border: none;
    color: var(--dim);
    cursor: pointer;
    padding: 4px;
  }

  :global(.cse-mobile-toc__entries) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.cse-mobile-toc__group) {
    margin-bottom: 8px;
  }

  :global(.cse-mobile-toc__section) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
  }
  :global(.cse-mobile-toc__section--active) {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  :global(.cse-mobile-toc__sub) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 5px 10px 5px 20px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--dim);
    line-height: 1.4;
  }
  :global(.cse-mobile-toc__sub--active) {
    color: var(--accent);
    font-weight: 600;
  }

  /* ═══ Prose (content styling) ═══ */
  :global(.prose img) { max-width: 100%; height: auto; margin: var(--space-lg) 0; }
  :global(.prose figure) { margin: var(--space-lg) 0; }
  :global(.prose figcaption) { font-size: 0.8125rem; color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  :global(.prose blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    color: var(--dim);
    font-style: italic;
  }
  :global(.prose a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3) {
    scroll-margin-top: 20px;
    color: var(--text);
  }
  :global(.prose h3) {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  :global(.prose p) { margin-bottom: var(--space-md); }
  :global(.prose ul),
  :global(.prose ol) { margin-bottom: var(--space-md); padding-left: var(--space-lg); }
  :global(.prose li) { margin-bottom: var(--space-sm); }

  /* Substack-specific */
  :global(.prose .image-link),
  :global(.prose .image2) { display: block; margin: var(--space-lg) 0; }
  :global(.prose .image-link img),
  :global(.prose .image2 img) { max-width: 100%; height: auto; }
  :global(.prose .captioned-image-container) { margin: var(--space-lg) 0; }
  :global(.prose .image-caption) { font-size: 0.8125rem; color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  :global(.prose .subscription-widget-wrap),
  :global(.prose .subscribe-widget),
  :global(.prose .subscription-widget),
  :global(.prose .image-link-expand),
  :global(.prose .icon-container) { display: none !important; }
  :global(.prose .footnote-anchor) { font-size: 0.7em; vertical-align: super; line-height: 0; text-decoration: none; color: var(--accent); }
  :global(.prose .footnote-anchor:hover) { text-decoration: underline; }
  :global(.prose .footnotes),
  :global(.prose .footnote) {
    font-size: 0.8125rem;
    color: var(--dim);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }
  :global(.prose .footnote .footnote-number) { font-size: 0.85em; margin-right: var(--space-sm); color: var(--accent); text-decoration: none; }
  :global(.prose pre) { background: var(--border); padding: var(--space-md); border-radius: 4px; overflow-x: auto; font-family: var(--font-mono); font-size: 0.8125rem; }
  :global(.prose code) { font-family: var(--font-mono); font-size: 0.8125rem; background: var(--border); padding: 0.1em 0.3em; border-radius: 2px; }
  :global(.prose pre code) { background: none; padding: 0; }
</style>
