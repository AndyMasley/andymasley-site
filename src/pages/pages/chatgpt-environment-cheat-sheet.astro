---
import Base from '@/layouts/Base.astro';
import { fetchPostContent, processPostContent } from '@/lib/substack';
import { ArticleSidebar } from '@/components/ArticleSidebar';

const slug = 'a-cheat-sheet-for-conversations-about';
const rawContent = await fetchPostContent(slug);
const htmlContent = processPostContent(rawContent, slug);

const text = htmlContent.replace(/<[^>]*>/g, '');
const wordCount = text.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);
---

<Base
  title="A cheat sheet for conversations about ChatGPT's environmental impact"
  description="Every environmental objection to using ChatGPT, answered with data and sources."
>
  <ArticleSidebar client:load />

  <div class="article-with-toc">
    <article class="article-main">
      <p class="originally-on">
        Navigable version of the <a href="/writing/a-cheat-sheet-for-conversations-about">original article</a>
      </p>

      <header class="article-header">
        <h1 class="article-header__title">A cheat sheet for conversations about ChatGPT's environmental impact</h1>
        <div class="article-header__meta">
          <span>01.06.2025</span>
          <span>{readingTime} min read</span>
          <span>{Math.round(wordCount / 1000)}k words</span>
        </div>
      </header>

      <div class="prose" set:html={htmlContent} />

      <footer class="article-footer">
        <a href="/writing" class="article-nav__link">&larr; Back to all writing</a>
      </footer>
    </article>
  </div>
</Base>

<style>
  /* ═══ Layout ═══ */
  .article-with-toc {
    max-width: 1020px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }
  .article-main {
    max-width: 640px;
    margin-left: 280px;
  }
  @media (max-width: 1100px) {
    .article-main {
      margin-left: 0;
      max-width: 100%;
    }
  }

  /* ═══ Header ═══ */
  .originally-on {
    font-size: 0.78rem;
    color: var(--dim);
    margin-bottom: var(--space-sm);
  }
  .originally-on a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
  .article-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }
  .article-header__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }
  @media (max-width: 600px) {
    .article-header__title { font-size: 1.5rem; }
  }
  .article-header__meta {
    display: flex;
    gap: var(--space-md);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--dim);
  }
  .article-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
  .article-nav__link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* ═══ Progress bar ═══ */
  :global(.toc-progress-bar) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }
  :global(.toc-progress-fill) {
    height: 100%;
    background: var(--accent, #8b3a3a);
    transition: width 0.1s linear;
  }

  /* ═══ Mobile toggle ═══ */
  :global(.toc-mobile-toggle) {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent, #8b3a3a);
    color: white;
    border: none;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0,0,0,0.2);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1px;
    transition: transform 0.15s;
  }
  :global(.toc-mobile-toggle:active) {
    transform: scale(0.92);
  }
  :global(.toc-mobile-pct) {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
  @media (max-width: 1100px) {
    :global(.toc-mobile-toggle) {
      display: flex;
    }
  }

  /* ═══ Sidebar ═══ */
  :global(.toc-sidebar) {
    position: fixed;
    top: 60px;
    left: max(calc((100vw - 1020px) / 2 + 16px), 16px);
    width: 240px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 20px;
    -webkit-overflow-scrolling: touch;
  }
  :global(.toc-sidebar::-webkit-scrollbar) { width: 2px; }
  :global(.toc-sidebar::-webkit-scrollbar-thumb) { background: var(--border); border-radius: 2px; }
  :global(.toc-sidebar::-webkit-scrollbar-track) { background: transparent; }

  @media (max-width: 1100px) {
    :global(.toc-sidebar) {
      display: none;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-height: 100vh !important;
      max-width: 100% !important;
      background: var(--bg, #faf9f7) !important;
      padding: 24px !important;
      padding-top: 20px !important;
      z-index: 998 !important;
      overflow-y: auto !important;
    }
    :global(.toc-sidebar.toc-sidebar--open) {
      display: block;
    }
  }

  @media (min-width: 1101px) {
    :global(.toc-mobile-toggle) {
      display: none !important;
    }
  }

  /* ═══ Sidebar inner ═══ */
  :global(.toc-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text, #1a1a18);
    padding-bottom: 6px;
    margin-bottom: 4px;
  }
  :global(.toc-pct) {
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--dim, #999);
    font-variant-numeric: tabular-nums;
  }
  :global(.toc-mini-progress) {
    height: 2px;
    background: var(--border, #ddd);
    border-radius: 1px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  :global(.toc-mini-fill) {
    height: 100%;
    background: var(--accent, #8b3a3a);
    border-radius: 1px;
    transition: width 0.1s linear;
  }

  :global(.toc-entries) {
    /* nothing extra */
  }

  :global(.toc-group) {
    margin-bottom: 1px;
  }
  :global(.toc-group-header) {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }
  :global(.toc-chevron) {
    flex-shrink: 0;
    width: 16px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 0.55rem;
    color: var(--dim, #999);
    padding: 0;
    font-family: inherit;
  }
  :global(.toc-chevron:hover) {
    color: var(--text, #1a1a18);
  }

  :global(.toc-dot) {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border, #ddd);
    margin-right: 6px;
    flex-shrink: 0;
    position: relative;
    top: -1px;
  }

  :global(.toc-item) {
    display: flex;
    align-items: baseline;
    width: 100%;
    text-align: left;
    padding: 3px 6px;
    border: none;
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--dim, #999);
    line-height: 1.35;
    transition: color 0.1s, background 0.1s;
    overflow: hidden;
    text-overflow: ellipsis;
    /* Two lines max then ellipsis */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  :global(.toc-item:hover) {
    color: var(--text, #1a1a18);
    background: rgba(0,0,0,0.02);
  }
  :global(.toc-item--h1) {
    font-weight: 500;
    font-size: 0.72rem;
  }
  :global(.toc-item--group-active) {
    color: var(--text, #1a1a18);
    font-weight: 600;
  }
  :global(.toc-item--active) {
    color: var(--accent, #8b3a3a) !important;
    font-weight: 600 !important;
    background: rgba(139,58,58,0.06);
  }
  :global(.toc-item--active .toc-dot) {
    background: var(--accent, #8b3a3a);
  }

  :global(.toc-children) {
    padding-left: 16px;
    margin-left: 7px;
    border-left: 1px solid var(--border, #ddd);
    margin-bottom: 2px;
  }
  :global(.toc-item--child) {
    font-size: 0.65rem;
    padding: 2px 6px;
  }

  :global(.toc-back) {
    margin-top: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--border, #ddd);
  }
  :global(.toc-back a) {
    font-size: 0.65rem;
    color: var(--dim, #999);
    text-decoration: none;
  }
  :global(.toc-back a:hover) {
    color: var(--accent, #8b3a3a);
    text-decoration: underline;
  }

  /* ═══ Mobile sidebar styles ═══ */
  @media (max-width: 1100px) {
    :global(.toc-header) {
      font-size: 1rem;
      padding-bottom: 10px;
      margin-bottom: 8px;
    }
    :global(.toc-pct) {
      font-size: 0.85rem;
    }
    :global(.toc-item--h1) {
      font-size: 0.9rem;
      padding: 6px 8px;
    }
    :global(.toc-item--child) {
      font-size: 0.8rem;
      padding: 4px 8px;
    }
    :global(.toc-chevron) {
      width: 24px;
      height: 32px;
      font-size: 0.7rem;
    }
    :global(.toc-children) {
      padding-left: 20px;
      margin-left: 11px;
    }
    :global(.toc-back) {
      margin-top: 24px;
      padding-top: 16px;
    }
    :global(.toc-back a) {
      font-size: 0.85rem;
    }
  }

  /* ═══ Prose ═══ */
  .prose :global(img) { max-width: 100%; height: auto; margin: var(--space-lg) 0; }
  .prose :global(figure) { margin: var(--space-lg) 0; }
  .prose :global(figcaption) { font-size: var(--font-size-ui); color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    color: var(--dim);
    font-style: italic;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .prose :global(h1) {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border);
    scroll-margin-top: 20px;
    color: var(--text);
  }
  .prose :global(h1:first-child) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .prose :global(h2) {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 20px;
    color: var(--text);
  }
  .prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 20px;
  }
  .prose :global(p) { margin-bottom: var(--space-md); }
  .prose :global(ul), .prose :global(ol) { margin-bottom: var(--space-md); padding-left: var(--space-lg); }
  .prose :global(li) { margin-bottom: var(--space-sm); }

  /* Substack-specific */
  .prose :global(.image-link), .prose :global(.image2) { display: block; margin: var(--space-lg) 0; }
  .prose :global(.image-link img), .prose :global(.image2 img) { max-width: 100%; height: auto; }
  .prose :global(.captioned-image-container) { margin: var(--space-lg) 0; }
  .prose :global(.image-caption) { font-size: var(--font-size-ui); color: var(--dim); text-align: center; margin-top: var(--space-sm); }
  .prose :global(.subscription-widget-wrap),
  .prose :global(.subscribe-widget),
  .prose :global(.subscription-widget),
  .prose :global(.image-link-expand),
  .prose :global(.icon-container) { display: none !important; }
  .prose :global(.footnote-anchor) { font-size: 0.7em; vertical-align: super; line-height: 0; text-decoration: none; color: var(--accent); }
  .prose :global(.footnote-anchor:hover) { text-decoration: underline; }
  .prose :global(.footnotes), .prose :global(.footnote) {
    font-size: var(--font-size-ui);
    color: var(--dim);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }
  .prose :global(.footnote .footnote-number) { font-size: 0.85em; margin-right: var(--space-sm); color: var(--accent); text-decoration: none; }
  .prose :global(pre) { background: var(--border); padding: var(--space-md); border-radius: 4px; overflow-x: auto; font-family: var(--font-mono); font-size: var(--font-size-mono); }
  .prose :global(code) { font-family: var(--font-mono); font-size: var(--font-size-mono); background: var(--border); padding: 0.1em 0.3em; border-radius: 2px; }
  .prose :global(pre code) { background: none; padding: 0; }
</style>
