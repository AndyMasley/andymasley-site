---
// Shared skeleton for section pages (/lists, /visuals, /appearances,
// /contact): one h1, a one-sentence lede, then the page's annotated list in
// the default slot. Pass lede as a prop for plain text, or use the named
// slot "lede" when the sentence needs markup (links etc.).
import Base from '@/layouts/Base.astro';

interface Props {
  title: string;
  lede?: string;
  description?: string;
  ogImage?: string;
  activeNav?: string;
}

const { title, lede, description = lede, ogImage, activeNav } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage} activeNav={activeNav}>
  <header class="page-header">
    <h1 class="page-header__title">{title}</h1>
    {lede && <p class="page-header__description">{lede}</p>}
    <slot name="lede" />
  </header>
  <slot />
</Base>
