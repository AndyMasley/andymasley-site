---
import '@/styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogImageAlt?: string;
  ogType?: string;
  canonicalUrl?: string;
  robots?: string;
  noindex?: boolean;
  structuredData?: unknown | unknown[];
  activeNav?: string;
  keywords?: string[];
}

const {
  title,
  description = "Andy Masley's personal site — writing, data visualizations, physics lectures, and lists",
  ogImage,
  ogTitle,
  ogImageAlt,
  ogType = 'website',
  canonicalUrl,
  robots,
  noindex = false,
  structuredData,
  activeNav,
  keywords,
} = Astro.props;
const keywordsContent = keywords && keywords.length > 0 ? keywords.join(', ') : null;
const resolvedOgTitle = ogTitle || title;
const siteOrigin = Astro.site || Astro.url.origin;
const currentPath = Astro.url.pathname;
// ?v=2 busts social-platform scrape caches after the 2026 card redesign —
// platforms cache og:image by URL, so a same-URL re-render would show the old
// card indefinitely. Bump the version if the default card is redesigned again.
const resolvedOgImagePath = ogImage || "/og/default.png?v=2";
const resolvedOgImage = new URL(resolvedOgImagePath, siteOrigin).href;
const resolvedOgImageAlt = ogImageAlt || resolvedOgTitle;
const canonicalHref = canonicalUrl
  ? new URL(canonicalUrl, siteOrigin).href
  : new URL(currentPath, siteOrigin).href;
const resolvedRobots = noindex
  ? 'noindex, follow, max-image-preview:large'
  : robots || 'index, follow, max-image-preview:large';
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const isHexagonPage = currentPath === '/hexagon' || currentPath === '/hexagon/';

const navLinks = [
  { href: '/', label: 'home' },
  { href: '/writing', label: 'writing' },
  { href: '/physics', label: 'IB physics' },
  { href: '/lists', label: 'lists' },
  { href: '/visuals', label: 'visuals' },
  { href: '/appearances', label: 'appearances' },
  { href: '/contact', label: 'contact' },
];

function isActive(href: string): boolean {
  if (activeNav) return href === activeNav;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <script is:inline>
    // Initialize theme immediately to prevent flash on navigation. Only an
    // explicit toggle choice persists; readers who never touched the toggle
    // follow their system, including live changes.
    (function() {
      const stored = localStorage.getItem('theme');
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const apply = (theme) => {
        document.documentElement.setAttribute('data-theme', theme);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#121212' : '#ffffff');
      };
      apply(stored || (mq.matches ? 'dark' : 'light'));
      if (!stored) {
        mq.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) apply(e.matches ? 'dark' : 'light');
        });
      }
    })();
  </script>
  <meta name="description" content={description}>
  <meta name="author" content="Andy Masley">
  {keywordsContent && <meta name="keywords" content={keywordsContent}>}
  <meta name="robots" content={resolvedRobots}>
  <link rel="canonical" href={canonicalHref}>
  <meta property="og:title" content={resolvedOgTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Andy Masley">
  <meta property="og:url" content={canonicalHref}>
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:image:alt" content={resolvedOgImageAlt}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@AndyMasley">
  <meta name="twitter:creator" content="@AndyMasley">
  <meta name="twitter:title" content={resolvedOgTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={resolvedOgImage}>
  <meta name="twitter:image:alt" content={resolvedOgImageAlt}>
  <title>{title === "Andy Masley" ? title : `${title} — Andy Masley`}</title>
  <slot name="head" />
  {structuredDataItems.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}

  <ViewTransitions />

  <link rel="alternate" type="application/rss+xml" title="Andy Masley" href="/rss.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="alternate icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script is:inline>
    // Persist theme across View Transitions and tab switches. Readers with
    // no stored choice follow their system, so the swap must re-derive the
    // theme from the media query — head scripts don't re-run on swaps, and
    // leaving data-theme unset would flash system-dark readers to light.
    (function() {
      const effectiveTheme = () => localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      document.addEventListener('astro:before-swap', (e) => {
        const theme = effectiveTheme();
        e.newDocument.documentElement.setAttribute('data-theme', theme);
        const meta = e.newDocument.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#121212' : '#ffffff');
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          document.documentElement.setAttribute('data-theme', effectiveTheme());
        }
      });
    })();
  </script>
</head>
<body>

  <main class="main-content" transition:animate="fade">
    <header class="header">
      <div class="header__inner">
        <div class="header__logo">
          <a href="/hexagon" class="header__hexagon-link" id="header-hexagon" aria-label="hexagon">
            <svg class="logo-hexagon" width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M12 2 L20.66 7 L20.66 17 L12 22 L3.34 17 L3.34 7 Z" />
            </svg>
          </a>
          <a href="/" class="header__name-link">Andy Masley</a>
        </div>

        <div class="header__controls">
          <div class="search-widget" id="search-widget">
            <span class="search-bracket search-bracket--left">[</span>
            <span class="search-inner">
              <span class="search-label" id="search-label"><span class="search-label-prefix">type to&nbsp;</span>search<span class="search-label-suffix">...</span></span>
              <input
                type="text"
                class="search-inline-input"
                id="search-input"
                autocomplete="off"
                spellcheck="false"
              />
            </span>
            <span class="search-bracket search-bracket--right">]</span>
            <div class="search-dropdown" id="search-dropdown">
              <div class="search-results" id="search-results"></div>
            </div>
          </div>
          <button class="dark-toggle" id="theme-toggle">
            [<span id="theme-label">dark</span>]
          </button>
        </div>
      </div>

      <nav class="header__nav">
        {navLinks.map((link, i) => (
          <>
            {i > 0 && <span class="header__nav-sep"> · </span>}
            <a
              href={link.href}
              class:list={[
                'header__nav-link',
                { 'header__nav-link--active': isActive(link.href) }
              ]}
            >
              {link.label}
            </a>
          </>
        ))}
        {isHexagonPage && (
          <span class="nav-hexagon-wrap">
            <span class="header__nav-sep"> · </span>
            <a href="/hexagon" class="nav-hexagon" aria-current="page">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M12 2 L20.66 7 L20.66 17 L12 22 L3.34 17 L3.34 7 Z" stroke="var(--text)" stroke-width="1.5"/>
              </svg>
            </a>
          </span>
        )}
      </nav>
    </header>

    <slot />

    <footer class="footer">
      © Andy Masley · <a href="/rss.xml">RSS</a> · <a href="mailto:AndyMasley@gmail.com">contact</a>
    </footer>
  </main>




  <script>
    // One init path: astro:page-load fires on initial load AND after every
    // View Transitions navigation, so nothing else may call the init
    // functions — the old double-registration stacked duplicate document
    // listeners (a second keydown handler is why Cmd+K opened-then-closed).
    // Document/window-level listeners register through an AbortController
    // aborted before each swap, so navigations add zero net listeners.
    let pageListeners: AbortController | null = null;

    document.addEventListener('astro:before-swap', () => {
      pageListeners?.abort();
    });

    document.addEventListener('astro:page-load', () => {
      pageListeners?.abort();
      pageListeners = new AbortController();
      const signal = pageListeners.signal;
      initThemeToggle();
      initExternalLinks();
      initSearch(signal);
      initHexagonPortalTrigger();
    });

    function initThemeToggle() {
      const themeToggle = document.getElementById('theme-toggle');
      const themeLabel = document.getElementById('theme-label');
      if (!themeToggle) return;

      function updateThemeLabel() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const label = document.getElementById('theme-label');
        if (label) {
          label.textContent = isDark ? 'light' : 'dark';
        }
      }

      updateThemeLabel();

      // Clone to remove any stale event listeners from View Transitions
      const newToggle = themeToggle.cloneNode(true) as HTMLElement;
      themeToggle.parentNode?.replaceChild(newToggle, themeToggle);

      newToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', newTheme === 'dark' ? '#121212' : '#ffffff');
        updateThemeLabel();
      });
    }

    function initExternalLinks() {
      const links = document.querySelectorAll('a[href^="http"]');
      const currentHost = window.location.host;
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (href && !href.includes(currentHost)) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener');
        }
      });
    }

    // Search functionality
    let searchIndex = null;
    let selectedIndex = 0;

    async function loadSearchIndex() {
      if (searchIndex) return searchIndex;
      try {
        const res = await fetch('/search.json');
        searchIndex = await res.json();
        return searchIndex;
      } catch (e) {
        console.error('Failed to load search index:', e);
        return [];
      }
    }

    function initSearch(signal: AbortSignal) {
      const widget = document.getElementById('search-widget');
      const input = document.getElementById('search-input') as HTMLInputElement;
      const label = document.getElementById('search-label');
      const dropdown = document.getElementById('search-dropdown');
      const results = document.getElementById('search-results');

      if (!widget || !input || !dropdown || !results) return;

      function openSearch() {
        // The index loads on first activation, never eagerly.
        loadSearchIndex();
        widget.classList.add('active');
        widget.classList.remove('has-input');
        input.value = '';
        results.innerHTML = '';
        selectedIndex = 0;
        input.focus();
        // Don't show dropdown until there's something to show
        dropdown.classList.remove('active');
      }

      function closeSearch() {
        widget.classList.remove('active');
        widget.classList.remove('has-input');
        dropdown.classList.remove('active');
        results.innerHTML = '';
        input.value = '';
        input.blur();
      }

      function updateHasInput() {
        if (input.value.length > 0) {
          widget.classList.add('has-input');
        } else {
          widget.classList.remove('has-input');
        }
      }

      function showDropdown() {
        dropdown.classList.add('active');
      }

      function hideDropdown() {
        dropdown.classList.remove('active');
      }

      // Click on widget (label or brackets) to open
      widget.addEventListener('click', (e) => {
        if (e.target === input) return; // Don't toggle if clicking input
        if (!widget.classList.contains('active')) {
          openSearch();
        }
      });

      // Tabbing into the input activates the widget too — it was a
      // permanent invisible tab stop before this.
      input.addEventListener('focus', () => {
        if (!widget.classList.contains('active')) {
          openSearch();
        }
      });

      // Click outside to close
      document.addEventListener('click', (e) => {
        if (!widget.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
          if (widget.classList.contains('active')) {
            closeSearch();
          }
        }
      }, { signal });

      function highlightMatch(text, query) {
        if (!query || !text) return text || '';
        const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        return text.replace(regex, '<mark>$1</mark>');
      }

      function getContentSnippet(content, query) {
        if (!content || !query) return '';
        const lower = content.toLowerCase();
        const q = query.toLowerCase();
        const idx = lower.indexOf(q);
        if (idx === -1) return '';

        const start = Math.max(0, idx - 40);
        const end = Math.min(content.length, idx + query.length + 60);
        let snippet = content.slice(start, end);
        if (start > 0) snippet = '...' + snippet;
        if (end < content.length) snippet = snippet + '...';
        return snippet;
      }

      function renderResults(items, query) {
        if (items.length === 0) {
          results.innerHTML = '<div class="search-empty">No results found</div>';
          return;
        }

        results.innerHTML = items.map((item, i) => {
          const contentSnippet = item.contentMatch ? getContentSnippet(item.content, query) : '';
          return `
            <a href="${item.url}" class="search-result ${i === selectedIndex ? 'selected' : ''}" data-index="${i}">
              <div class="search-result-main">
                <span class="search-result-type">${item.type}</span>
                <span class="search-result-title">${highlightMatch(item.title, query)}</span>
              </div>
              ${item.description ? `<div class="search-result-desc">${highlightMatch(item.description, query)}</div>` : ''}
              ${contentSnippet ? `<div class="search-result-content">${highlightMatch(contentSnippet, query)}</div>` : ''}
              ${item.tags && item.tags.length ? `<div class="search-result-tags">${item.tags.map(t => `<span class="search-tag">${t}</span>`).join('')}</div>` : ''}
            </a>
          `;
        }).join('');

        // Add hover handlers
        results.querySelectorAll('.search-result').forEach((el, i) => {
          el.addEventListener('mouseenter', () => {
            selectedIndex = i;
            updateSelection();
          });
        });
      }

      function updateSelection() {
        results.querySelectorAll('.search-result').forEach((el, i) => {
          el.classList.toggle('selected', i === selectedIndex);
        });
        const selected = results.querySelector('.search-result.selected');
        if (selected) {
          selected.scrollIntoView({ block: 'nearest' });
        }
      }

      async function search(query) {
        const index = await loadSearchIndex();
        if (!query.trim()) {
          results.innerHTML = '';
          hideDropdown();
          return;
        }

        // Parse quoted phrases and unquoted words
        const exactPhrases: string[] = [];
        let remaining = query.toLowerCase().trim();

        // Extract quoted phrases (supports both "double" and 'single' quotes)
        const quoteRegex = /["']([^"']+)["']/g;
        let match;
        while ((match = quoteRegex.exec(remaining)) !== null) {
          if (match[1].trim()) {
            exactPhrases.push(match[1].trim());
          }
        }
        // Remove quoted phrases from remaining query
        remaining = remaining.replace(quoteRegex, ' ').trim();

        // Common words to ignore for unquoted terms
        const stopWords = new Set(['a', 'an', 'the', 'is', 'are', 'was', 'were', 'be', 'been', 'being', 'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'could', 'should', 'may', 'might', 'must', 'shall', 'can', 'need', 'dare', 'ought', 'used', 'to', 'of', 'in', 'for', 'on', 'with', 'at', 'by', 'from', 'as', 'into', 'through', 'during', 'before', 'after', 'above', 'below', 'between', 'under', 'again', 'further', 'then', 'once', 'here', 'there', 'when', 'where', 'why', 'how', 'all', 'each', 'few', 'more', 'most', 'other', 'some', 'such', 'no', 'nor', 'not', 'only', 'own', 'same', 'so', 'than', 'too', 'very', 'just', 'and', 'but', 'if', 'or', 'because', 'until', 'while', 'about', 'against', 'this', 'that', 'these', 'those', 'i', 'me', 'my', 'myself', 'we', 'our', 'ours', 'you', 'your', 'yours', 'he', 'him', 'his', 'she', 'her', 'hers', 'it', 'its', 'they', 'them', 'their', 'what', 'which', 'who', 'whom']);

        // Get significant words from remaining unquoted text
        const words = remaining.split(/\s+/).filter(w => w.length > 2 && !stopWords.has(w));

        const scored = index.map(item => {
          let score = 0;
          let contentMatch = false;
          const title = (item.title || '').toLowerCase();
          const desc = (item.description || '').toLowerCase();
          const headers = (item.headers || '').toLowerCase();
          const content = (item.content || '').toLowerCase();
          const tags = (item.tags || []).join(' ').toLowerCase();
          const type = item.type || 'article';
          const allText = title + ' ' + desc + ' ' + headers + ' ' + content + ' ' + tags;

          // EXACT PHRASE MATCHING: All quoted phrases must match exactly
          if (exactPhrases.length > 0) {
            const allPhrasesMatch = exactPhrases.every(phrase => allText.includes(phrase));
            if (!allPhrasesMatch) {
              return { ...item, score: 0, contentMatch: false };
            }
            // Bonus for exact phrase matches
            exactPhrases.forEach(phrase => {
              if (title.includes(phrase)) score += 300;
              else if (desc.includes(phrase)) score += 150;
              else if (headers.includes(phrase)) score += 75;
              else if (content.includes(phrase)) {
                score += 25;
                contentMatch = true;
              }
            });
          }

          // For remaining unquoted multi-word queries, require ALL significant words to match
          if (words.length > 1) {
            const allWordsMatch = words.every(word => allText.includes(word));
            if (!allWordsMatch) {
              return { ...item, score: 0, contentMatch: false };
            }
          }

          // No type bonus - rank purely by relevance

          // Individual word matches for ranking (unquoted terms)
          words.forEach(word => {
            if (title.includes(word)) score += 30;
            if (desc.includes(word)) score += 15;
            if (headers.includes(word)) score += 8;
            if (tags.includes(word)) score += 5;
            if (content.includes(word)) {
              score += 2;
              contentMatch = true;
            }
          });

          // If only exact phrases (no unquoted words), still need minimum score
          if (exactPhrases.length > 0 && words.length === 0 && score === 0) {
            score = 1; // Matched phrases but no type bonus
          }

          return { ...item, score, contentMatch };
        })
        .filter(item => item.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 20);

        selectedIndex = 0;
        renderResults(scored, query);
        showDropdown();
      }

      input.addEventListener('input', (e) => {
        updateHasInput();
        search((e.target as HTMLInputElement).value);
      });

      input.addEventListener('keydown', (e) => {
        const resultElements = results.querySelectorAll('.search-result');
        const count = resultElements.length;

        if (e.key === 'Escape') {
          closeSearch();
        } else if (e.key === 'ArrowDown' && count > 0) {
          e.preventDefault();
          selectedIndex = (selectedIndex + 1) % count;
          updateSelection();
        } else if (e.key === 'ArrowUp' && count > 0) {
          e.preventDefault();
          selectedIndex = (selectedIndex - 1 + count) % count;
          updateSelection();
        } else if (e.key === 'Enter' && count > 0) {
          e.preventDefault();
          const selected = resultElements[selectedIndex];
          if (selected) {
            closeSearch();
            window.location.href = selected.getAttribute('href') || '';
          }
        }
      });

      // Keyboard shortcut: Cmd/Ctrl + K
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (widget.classList.contains('active')) {
            closeSearch();
          } else {
            openSearch();
          }
        }
        if (e.key === 'Escape' && widget.classList.contains('active')) {
          closeSearch();
        }
      }, { signal });
    }

    // Hexagon portal activation - requires clicking BOTH hexes
    function initHexagonPortalTrigger() {
      const headerHexagon = document.getElementById('header-hexagon');
      const navHexagon = document.querySelector('.nav-hexagon');

      const isHexagonPage = window.location.pathname === '/hexagon' || window.location.pathname === '/hexagon/';
      if (!isHexagonPage) return;

      let headerActivated = false;
      let navActivated = false;

      function activateHex(hexElement) {
        if (!hexElement) return;

        // Get current rotation from hover state and freeze it
        const svg = hexElement.querySelector('svg');
        if (svg) {
          const computedStyle = window.getComputedStyle(svg);
          const matrix = computedStyle.transform;
          let currentRotation = 0;
          if (matrix && matrix !== 'none') {
            const values = matrix.split('(')[1]?.split(')')[0]?.split(',');
            if (values) {
              const a = parseFloat(values[0]);
              const b = parseFloat(values[1]);
              currentRotation = Math.atan2(b, a) * (180 / Math.PI);
            }
          }
          svg.style.transform = `rotate(${currentRotation}deg)`;
        }

        hexElement.classList.add('hex-activated');
      }

      function deactivateHex(hexElement) {
        if (!hexElement) return;
        hexElement.classList.remove('hex-activated');
        const svg = hexElement.querySelector('svg');
        if (svg) {
          svg.style.transform = '';
        }
      }

      function handleHexagonClick(e) {
        e.preventDefault();
        const clickedElement = e.currentTarget;
        const isHeader = clickedElement === headerHexagon || clickedElement?.closest('#header-hexagon');

        // Toggle the clicked hex
        if (isHeader) {
          if (headerActivated) {
            headerActivated = false;
            deactivateHex(headerHexagon);
          } else {
            headerActivated = true;
            activateHex(headerHexagon);
          }
        } else {
          if (navActivated) {
            navActivated = false;
            deactivateHex(navHexagon);
          } else {
            navActivated = true;
            activateHex(navHexagon);
          }
        }

        // Notify hexagon page of current state
        if (typeof window.updateHexagonState === 'function') {
          window.updateHexagonState(headerActivated, navActivated);
        }
      }

      if (headerHexagon) {
        headerHexagon.addEventListener('click', handleHexagonClick);
      }
      if (navHexagon) {
        navHexagon.addEventListener('click', handleHexagonClick);
      }
    }

  </script>

</body>
</html>
