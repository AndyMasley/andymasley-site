---
interface Props {
  items: Array<{
    label: string;
    href?: string;
  }>;
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {item.href ? (
        <a href={item.href} class="breadcrumbs__link">{item.label}</a>
      ) : (
        <span class="breadcrumbs__current">{item.label}</span>
      )}
      {i < items.length - 1 && <span class="breadcrumbs__sep">/</span>}
    </>
  ))}
</nav>

<style>
  .breadcrumbs {
    font-size: 0.8rem;
    color: var(--dim);
    margin-bottom: 2rem;
    letter-spacing: 0.01em;
  }

  .breadcrumbs__link {
    color: var(--dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumbs__link:hover {
    color: var(--text);
  }

  .breadcrumbs__sep {
    margin: 0 0.5em;
    opacity: 0.4;
  }

  .breadcrumbs__current {
    color: var(--text);
    font-weight: 450;
  }
</style>
