---
// A hand-picked reading path for new readers. Titles and slugs are written
// out rather than pulled from the Substack feed on purpose: this is an
// editorial selection and an editorial order, not the most recent N.
//
// Rendered as the body of a MarginNote on the homepage, so every box here
// is a span set to block: the note sits inside the host paragraph, where
// block elements (h2, ul) are not valid. List semantics come from ARIA.
const groups = [
  {
    heading: 'AI and the environment',
    posts: [
      { title: 'Toward liberal environmentalism', slug: 'toward-environmental-liberalism' },
      { title: 'What a data center is', slug: 'what-a-data-center-is' },
      { title: 'A simple trick to fix the data center debate', slug: 'a-simple-trick-to-fix-the-data-center' },
      { title: 'Data centers and low social trust', slug: 'data-centers-and-low-social-trust' },
      { title: 'Why I think panic about local impacts of data centers is just a panic', slug: 'why-i-think-panic-about-local-impacts' },
      { title: 'The AI water issue is fake', slug: 'the-ai-water-issue-is-fake' },
      { title: 'Data center land use issues are fake', slug: 'data-center-land-use-issues-are-fake' },
      { title: 'Empire of AI is wildly misleading about AI water use', slug: 'empire-of-ai-is-wildly-misleading' },
    ],
  },
  {
    heading: 'AI in general',
    posts: [
      { title: 'All the ways I want the AI debate to be better', slug: 'all-the-ways-i-want-the-ai-debate' },
    ],
  },
  {
    heading: 'Other',
    posts: [
      { title: 'Animal suffering isn’t pretend', slug: 'animal-suffering-isnt-pretend' },
      { title: 'Strategies for learning', slug: 'strategies-for-learning' },
    ],
  },
];

// Hand-picked appearances (Andy's call, Aug 2026), titles and links
// mirroring src/data/appearances.ts.
const appearances = [
  { title: 'Conspicuous Cognition', href: 'https://open.spotify.com/episode/2E3Yfi24OUyHxz67BtzhHB?si=8110a29fe7034cf5' },
  { title: 'NYT Hard Fork', href: 'https://open.spotify.com/episode/0UaOQ0DcP9c8OG5IfAgfnT?si=5d00e4bce6aa43f0' },
  { title: 'The World Unpacked', href: 'https://www.youtube.com/watch?v=4Q6t2PxZxDE' },
  { title: 'The Cognitive Revolution', href: 'https://open.spotify.com/episode/0RBBVeGb5yfHsFWnKkDgD0?si=15d8b610374544b0' },
];

// Hand-picked visuals, titles and links mirroring src/data/visuals.ts.
const visuals = [
  { title: 'Factory-farmed chickens', href: '/visuals/factory-farmed-chickens' },
  { title: 'Carbon footprint calculator', href: '/visuals/carbon-footprint' },
  { title: 'How thirsty is AI?', href: '/visuals/water' },
  { title: 'What does your AI use cost?', href: '/visuals/ai-prompt-footprint' },
];
---

<span class="start-here" role="group" aria-label="Start here">
  {groups.map(group => (
    <span class="start-here__group">
      <span class="start-here__heading">{group.heading}</span>
      <span class="start-here__list" role="list">
        {group.posts.map(post => (
          <span class="start-here__item" role="listitem"><a href={`/writing/${post.slug}`}>{post.title}</a></span>
        ))}
      </span>
    </span>
  ))}
  <span class="start-here__group">
    <span class="start-here__heading">Appearances</span>
    <span class="start-here__list" role="list">
      {appearances.map(item => (
        <span class="start-here__item" role="listitem"><a href={item.href} target="_blank" rel="noopener">{item.title}</a></span>
      ))}
    </span>
  </span>
  <span class="start-here__group">
    <span class="start-here__heading">Visuals</span>
    <span class="start-here__list" role="list">
      {visuals.map(item => (
        <span class="start-here__item" role="listitem"><a href={item.href}>{item.title}</a></span>
      ))}
    </span>
  </span>
</span>

<style>
  .start-here,
  .start-here__group,
  .start-here__heading,
  .start-here__list,
  .start-here__item {
    display: block;
  }

  .start-here__group + .start-here__group {
    margin-top: var(--space-md);
  }

  /* Label recipe B: sentence case, --text-sm. */
  .start-here__heading {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-heading);
    color: var(--text-secondary);
  }

  /* Same item rhythm the list had as a ul; no bullets, since the margin
     column is 180px and the titles already wrap. */
  .start-here__item {
    line-height: var(--leading-note);
  }

  .start-here__item + .start-here__item {
    margin-top: var(--space-xs);
  }
</style>
