---
import { RADIO_STATIONS, RADIO_CATALOG_CHECKED_AT } from '../lib/town/radio-stations';
const recommended = RADIO_STATIONS.filter((station) => station.recommended);
---

<details class="town-radio" data-town-radio>
  <summary>Car radio <span class="town-radio__summary" data-radio-summary>Off</span></summary>
  <div class="town-radio__body">
    <div class="town-radio__top">
      <div class="town-radio__display">
        <output class="town-radio__frequency" data-radio-frequency>91.3 FM</output>
        <span data-radio-name>Local radio</span>
        <span class="town-radio__muted" data-radio-detail>Webster and the surrounding towns</span>
      </div>
      <div class="town-radio__switches">
        <label>Band <select data-radio-band><option value="fm">FM</option><option value="am">AM</option></select></label>
        <button type="button" data-radio-power aria-pressed="false">Turn radio on</button>
      </div>
    </div>

    <div class="town-radio__tuner">
      <button type="button" data-radio-down aria-label="Tune down one channel">−</button>
      <div class="town-radio__scale">
        <div class="town-radio__markers" data-radio-markers aria-hidden="true"></div>
        <input id="town-radio-dial" data-radio-dial type="range" min="879" max="1079" step="2" value="913" aria-label="Radio frequency" />
        <div class="town-radio__limits"><span data-radio-min>87.9</span><span data-radio-max>107.9 MHz</span></div>
      </div>
      <button type="button" data-radio-up aria-label="Tune up one channel">+</button>
    </div>

    <div class="town-radio__playback">
      <p data-radio-status role="status" aria-live="polite">Off</p>
      <button type="button" data-radio-retry hidden>Retry</button>
      <label class="town-radio__volume">Volume <input data-radio-volume type="range" min="0" max="100" step="1" value="45" aria-label="Radio volume" /></label>
    </div>

    <div class="town-radio__presets" aria-label="Recommended local stations">
      <span class="town-radio__label">Recommended</span>
      <div class="town-radio__preset-buttons">
        {recommended.map((station) => (
          <button type="button" data-radio-station={station.id} aria-pressed="false">
            <span>{station.frequency.toFixed(station.band === 'fm' ? 1 : 0)} {station.band.toUpperCase()} · {station.name}</span>
            <span class="town-radio__muted" data-radio-reception="" hidden></span>
          </button>
        ))}
      </div>
    </div>

    <details class="town-radio__guide">
      <summary>Station guide</summary>
      <p>Live internet radio · Simulated static</p>
      <div class="town-radio__stations">
        {RADIO_STATIONS.map((station) => (
          <div class="town-radio__station">
            <button type="button" data-radio-station={station.id} aria-pressed="false">
              <span>{station.frequency.toFixed(station.band === 'fm' ? 1 : 0)} {station.band.toUpperCase()} · {station.callSign}</span>
              <span class="town-radio__muted" data-radio-reception={station.streamUrl ? '' : 'No stream'} hidden={Boolean(station.streamUrl)}>{station.streamUrl ? '' : 'No stream'}</span>
            </button>
            <div><a href={station.website} target="_blank" rel="noopener noreferrer">{station.name}</a><span class="town-radio__muted">{station.city} · {station.format}</span></div>
          </div>
        ))}
      </div>
      <p>Checked <time datetime={RADIO_CATALOG_CHECKED_AT}>{RADIO_CATALOG_CHECKED_AT}</time></p>
    </details>
    <a class="town-radio__website" data-radio-website href="https://www.wcuw.org/" target="_blank" rel="noopener noreferrer" hidden>Station website ↗</a>
  </div>
</details>
