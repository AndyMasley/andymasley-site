---
// Substack's own subscribe embed. The iframe interior is served by Substack,
// so its type and colors are theirs; only the frame around it is ours.
//
// This is deliberately the embed rather than a form of our own. Two custom
// routes were built and tested first: a Cloudflare Function proxying
// Substack's signup API (Substack answered datacenter traffic with stalls
// and gateway errors), and a browser-side form POST into a hidden iframe
// (worked, but the response is unreadable cross-origin, so the page could
// never confirm a signup actually landed). The embed is the only version
// where Substack owns the whole transaction end to end.
//
// The embed lays itself out to whatever height it is given — 260px is the
// smallest height that shows title, tagline, subscriber count, the email
// field and the terms line without clipping, down to a 330px-wide frame.
const embedSrc = 'https://andymasley.substack.com/embed';
const substackUrl = 'https://andymasley.substack.com/subscribe';
---

<section class="subscribe" aria-labelledby="subscribe-label">
  <div class="label" id="subscribe-label">Subscribe</div>
  <p class="subscribe__blurb">Subscribe to my Substack below or on <a href={substackUrl} target="_blank" rel="noopener">the site itself</a></p>
  <div class="subscribe__frame">
    <iframe
      class="subscribe__embed"
      src={embedSrc}
      title="Subscribe to Andy Masley on Substack"
      height="260"
      loading="lazy"
      scrolling="no"
      frameborder="0"
    ></iframe>
  </div>
</section>

<style>
  .subscribe {
    margin: 0;
  }

  .subscribe__blurb {
    margin: 0 0 var(--space-md);
    font-size: var(--text-sm);
    line-height: var(--leading-note);
    color: var(--text-secondary);
  }

  .subscribe__frame {
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .subscribe__embed {
    display: block;
    width: 100%;
  }

  /* Substack serves one light card in both themes. Inverting the embed is
     the only lever we have on cross-origin content: it puts the card on
     near-black with light ink, and the second rotation returns the green
     Subscribe button to green. The hairline stays on the wrapper so it
     keeps the site's own --border value. */
  :global([data-theme="dark"]) .subscribe__embed {
    filter: invert(1) hue-rotate(180deg) saturate(0.8);
  }
</style>
