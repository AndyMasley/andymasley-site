---
// Every county's 2015 water, as USGS estimated it: a table to sort and search, and the same figures as a CSV. It reads
// the file the map draws from (public/water-map/data/wu.json), so the two always agree.
---

<section class="wc" aria-labelledby="wc-title" data-wc>
  <h2 id="wc-title" class="wt-title">Every county</h2>
  <p class="wt-dek">The figures the map is drawn from, for all 3,223 counties and county equivalents, in million gallons a day. Click a column to sort by it.</p>
  <div class="wc-bar">
    <label class="wc-search"><span class="wc-vh">Find a county or state</span><input type="search" placeholder="Find a county or state" data-wc-q autocomplete="off" spellcheck="false" /></label>
    <button type="button" class="wc-btn" data-wc-csv>Download all of it (CSV)</button>
  </div>
  <div class="wc-scroll" tabindex="0" aria-label="Table of water use by county">
    <table>
      <thead><tr data-wc-head></tr></thead>
      <tbody data-wc-body><tr><td class="wc-load" colspan="11">Loading the county figures…</td></tr></tbody>
    </table>
  </div>
  <p class="wc-foot"><span data-wc-count></span> <button type="button" class="wc-btn wc-more" data-wc-more hidden>Show every county</button></p>
  <p class="wt-src">Source: <a href="https://www.usgs.gov/data/estimated-use-water-united-states-county-level-data-2015">USGS county water use, 2015</a> (Dieter and others, 2018, version 2.0). Crops include golf courses in the states that did not count them apart. Consumed is shown only for the uses USGS estimated it for: crops, golf courses and power plants. Public supply is counted where it was withdrawn, as USGS counts it; the map moves the water of the largest systems that cross county lines to the counties they serve.</p>
</section>

<script>
  type Row = { i: number; fips: string; name: string; st: string; total: number; pt: number; ir: number; go: number; ps: number; in: number; aq: number; mi: number; do: number; li: number; gw: number; cu: number; pop: number };
  const COLS: { k: keyof Row | 'gwShare' | 'perCap' | 'top'; label: string; num?: boolean; csv?: string }[] = [
    { k: 'name', label: 'County' }, { k: 'st', label: 'State' }, { k: 'total', label: 'Withdrawn', num: true },
    { k: 'ps', label: 'Public supply', num: true }, { k: 'ir', label: 'Crops', num: true }, { k: 'pt', label: 'Power plants', num: true },
    { k: 'in', label: 'Industry', num: true }, { k: 'gwShare', label: 'From wells', num: true }, { k: 'cu', label: 'Consumed', num: true },
    { k: 'pop', label: 'Residents', num: true }, { k: 'perCap', label: 'Per resident', num: true },
  ];
  function initCounties() {
    const root = document.querySelector<HTMLElement>('[data-wc]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const head = root.querySelector('[data-wc-head]')!, body = root.querySelector('[data-wc-body]')!;
    const q = root.querySelector<HTMLInputElement>('[data-wc-q]')!, more = root.querySelector<HTMLButtonElement>('[data-wc-more]')!;
    const count = root.querySelector('[data-wc-count]')!, csvBtn = root.querySelector<HTMLButtonElement>('[data-wc-csv]')!;
    let rows: Row[] = [], sortK = 'total', desc = true, all = false;
    const nf = (v: number, d = 0) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const mg = (v: number) => (v >= 100 ? nf(v) : v >= 10 ? nf(v, 1) : v >= 0.1 ? nf(v, 2) : v > 0 ? '<0.1' : '0');
    const val = (r: Row, k: string): number | string => k === 'gwShare' ? (r.total > 0 ? r.gw / r.total : -1) : k === 'perCap' ? (r.pop > 0 ? r.total * 1e6 / (r.pop * 1000) : -1) : (r as any)[k];
    const cell = (r: Row, k: string) => {
      if (k === 'name' || k === 'st') return esc((r as any)[k]);
      if (k === 'gwShare') return r.total > 0 ? `${Math.round(100 * r.gw / r.total)}%` : '–';
      if (k === 'perCap') return r.pop > 0 ? nf(r.total * 1e6 / (r.pop * 1000)) : '–';
      if (k === 'pop') return nf(r.pop * 1000);
      if (k === 'cu') return r.cu > 0 ? mg(r.cu) : '–';
      return mg((r as any)[k]);
    };
    const draw = () => {
      head.innerHTML = COLS.map((c) => `<th scope="col"${c.num ? ' class="n"' : ''} aria-sort="${sortK === c.k ? (desc ? 'descending' : 'ascending') : 'none'}"><button type="button" data-k="${c.k}">${c.label}${sortK === c.k ? (desc ? ' ↓' : ' ↑') : ''}</button></th>`).join('');
      for (const b of head.querySelectorAll<HTMLButtonElement>('button')) b.addEventListener('click', () => { const k = b.dataset.k!; if (sortK === k) desc = !desc; else { sortK = k; desc = k !== 'name' && k !== 'st'; } draw(); });
      const term = q.value.trim().toLowerCase();
      let list = term ? rows.filter((r) => `${r.name}, ${r.st}`.toLowerCase().includes(term) || r.st.toLowerCase() === term) : rows.slice();
      list.sort((a, b) => { const x = val(a, sortK), y = val(b, sortK); const c = typeof x === 'string' ? String(x).localeCompare(String(y)) : (x as number) - (y as number); return desc ? -c : c; });
      const shown = all || term ? list : list.slice(0, 25);
      body.innerHTML = shown.map((r) => `<tr data-i="${r.i}"><th scope="row"><button type="button" class="wc-go" data-i="${r.i}" title="Show it on the map">${esc(r.name)}</button></th>${COLS.slice(1).map((c) => `<td${c.num ? ' class="n"' : ''}>${cell(r, c.k)}</td>`).join('')}</tr>`).join('') || `<tr><td class="wc-load" colspan="${COLS.length}">No county matches “${q.value.replace(/[<>&]/g, '')}”.</td></tr>`;
      count.textContent = term ? `${nf(list.length)} of ${nf(rows.length)} counties.` : all ? `All ${nf(rows.length)} counties.` : `The 25 that ${sortK === 'name' || sortK === 'st' ? 'come first' : 'rank highest'}, of ${nf(rows.length)}.`;
      more.hidden = all || !!term;
      for (const b of body.querySelectorAll<HTMLButtonElement>('.wc-go')) b.addEventListener('click', () => {
        const w = (window as any).__w; if (!w) return;
        document.querySelector('[data-wm-stage]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => w.app.selectCounty(+b.dataset.i!, true), 450);
      });
    };
    q.addEventListener('input', draw);
    more.addEventListener('click', () => { all = true; draw(); });
    csvBtn.addEventListener('click', () => {
      if (!rows.length) return;
      const H = ['fips', 'county', 'state', 'withdrawn_mgd', 'power_plants_mgd', 'crops_mgd', 'golf_courses_mgd', 'public_supply_mgd', 'industry_mgd', 'fish_farms_mgd', 'mining_mgd', 'private_wells_mgd', 'livestock_mgd', 'groundwater_mgd', 'consumed_mgd', 'residents'];
      const lines = [H.join(',')].concat(rows.map((r) => [r.fips, `"${r.name.replace(/"/g, '""')}"`, r.st, r.total, r.pt, r.ir, r.go, r.ps, r.in, r.aq, r.mi, r.do, r.li, r.gw, r.cu || '', Math.round(r.pop * 1000)].map((v) => typeof v === 'number' ? Number(v.toFixed(3)) : v).join(',')));
      const url = URL.createObjectURL(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }));
      const a = document.createElement('a'); a.href = url; a.download = 'usgs-county-water-use-2015.csv'; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    });
    fetch('/water-map/data/wu.json').then((r) => r.json()).then((wu) => {
      const g = (k: string, i: number) => (wu[k] ? wu[k][i] || 0 : 0);
      rows = wu.id.map((fips: string, i: number) => {
        // crops and golf: split where the state reported them apart (as the map does)
        const split = wu.ic_w && wu.ic_w[i] != null;
        const ir = split ? g('ic_sf', i) + g('ic_gf', i) : g('ir_sf', i) + g('ir_gf', i);
        const go = split ? g('ig_sf', i) + g('ig_gf', i) : 0;
        const sum4 = (p: string) => g(`${p}_sf`, i) + g(`${p}_ss`, i) + g(`${p}_gf`, i) + g(`${p}_gs`, i);
        const pt = sum4('po') + sum4('pc'), ps = sum4('ps'), ind = sum4('in'), aq = sum4('aq'), mi = sum4('mi');
        const dom = g('do_sf', i) + g('do_gf', i), li = g('li_sf', i) + g('li_gf', i);
        const total = pt + ir + go + ps + ind + aq + mi + dom + li;
        const gw = ['ps', 'in', 'aq', 'mi'].reduce((a, p) => a + g(`${p}_gf`, i) + g(`${p}_gs`, i), 0) + g('po_gf', i) + g('po_gs', i) + g('pc_gf', i) + g('pc_gs', i)
          + (split ? g('ic_gf', i) + g('ig_gf', i) : g('ir_gf', i)) + g('do_gf', i) + g('li_gf', i);
        const rec = (split ? g('ic_rec', i) + g('ig_rec', i) : g('ir_rec', i));
        const cuIr = split ? Math.min(g('ic_cu', i), g('ic_sf', i) + g('ic_gf', i) + g('ic_rec', i)) + Math.min(g('ig_cu', i), go + g('ig_rec', i)) : Math.min(g('ir_cu', i), ir + rec);
        const cuPt = g('po_cuf', i) + g('po_cus', i) + g('pc_cuf', i) + g('pc_cus', i);
        return { i, fips, name: wu.name[i], st: wu.st[i], total, pt, ir, go, ps, in: ind, aq, mi, do: dom, li, gw, cu: cuIr + cuPt, pop: g('pop', i) };
      });
      draw();
    }).catch(() => { body.innerHTML = `<tr><td class="wc-load" colspan="${COLS.length}">The county figures could not be loaded.</td></tr>`; });
  }
  document.addEventListener('astro:page-load', initCounties);
</script>
