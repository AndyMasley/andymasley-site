# Dependencies
node_modules/

# Build output
dist/
.astro/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build-time API caches. Substack blocks GitHub Actions runner IPs (403),
# so the committed cache is what CI builds fall back to. Refresh it by
# running a build locally (which fetches fresh content) and committing
# the .cache changes.
.cache/*
!.cache/substack
!.cache/eaforum

# Large data caches
data/source/GLHYMPS*

# Versioned town scenery is verified and restored from a fixed release before builds.
/public/town-assets/2026-09*/
/public/town-transfer/
/data/derived/town/asset-validation*.json
/data/derived/town/browser-smoke-*/
